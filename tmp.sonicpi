use_bpm 60

# Define paths to your SSO samples
sso_path = "~/develop/sso/Samples/"
cello_path = sso_path + "Cello/"

# We use a built-in harmonic sample. 
# Try changing this to :elec_piano or :misc_lori to hear it on different sources.
source_buffer = "~/develop/sso/Sonatina Symphonic Orchestra/Samples/Vibraphone/vibraphone-c4.flac"#:ambi_soft_buzz #:ambi_choir 

eval_file  "~/develop/chars/voice_engine.sonicpi"

use_bpm 120

# ==========================================================
# 2. THE SCORES (Strictly 16 steps. Intentionally written.)
# ==========================================================
# Every array has exactly 16 elements. nil = rest.

score_bass  = (ring :c2, nil, nil, nil, :c2, nil, nil, nil, :eb2, nil, nil, nil, :g2, nil, nil, nil)
score_lead  = (ring :c4, nil, :eb4, nil, :g4, nil, :c5, nil, nil, nil, nil, nil, nil, nil, nil, nil)
score_kick  = (ring :c4, nil, :c4, nil, :c4, nil, :eb4, nil, nil, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK (Data Stream)
# ==========================================================
playbook = (ring
  [ [:play_kick, score_kick, 4] ],
  [ [:play_kick, score_kick, 4], [:play_sub,  score_bass, 4] ],
  [ [:play_kick,  score_kick, 8], [:play_sub,   score_bass, 4], 
    [:play_lead,  score_lead, 8], [:play_grain, score_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
