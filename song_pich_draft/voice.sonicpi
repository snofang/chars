# پیچ (The Turn) - Enhanced Bodhrán Groove
# Based on your basic rhythm with bodhrán textures
# 16th notes - 8 beats per bar

use_bpm 80
use_debug false

live_loop :pich do
  # ============================================
  # BEAT 1
  # ============================================
  
  # Kick — pulse, weight
  sample :drum_bass_hard, amp: 0.7, release: 0.08
  sleep 0.25
  
  # Bodhrán rim — sharp, driving (replaces closed hat)
  sample :drum_tom_mid_soft, amp: 0.3, rate: 1.8, release: 0.02
  sleep 0.25
  
  # ============================================
  # BEAT 2
  # ============================================
  
  # Bodhrán thump — backbeat (replaces snare)
  sample :drum_tom_hi_hard, amp: 0.6, rate: 0.7, release: 0.06
  sleep 0.25
  
  # Bodhrán rim
  sample :drum_tom_mid_soft, amp: 0.3, rate: 1.8, release: 0.02
  sleep 0.25
  
  # ============================================
  # BEAT 3
  # ============================================
  
  # Kick — return, cycle
  sample :drum_bass_hard, amp: 0.6, release: 0.08
  sleep 0.25
  
  # Bodhrán rim
  sample :drum_tom_mid_soft, amp: 0.3, rate: 1.8, release: 0.02
  sleep 0.25
  
  # ============================================
  # BEAT 4
  # ============================================
  
  # Bodhrán thump — holding (replaces snare)
  sample :drum_tom_hi_hard, amp: 0.6, rate: 0.7, release: 0.06
  sleep 0.25
  
  # Bodhrán rim
  sample :drum_tom_mid_soft, amp: 0.3, rate: 1.8, release: 0.02
  sleep 0.25
  
  # ============================================
  # BEAT 5
  # ============================================
  
  # Kick — weight remains
  sample :drum_bass_hard, amp: 0.6, release: 0.08
  sleep 0.25
  
  # Bodhrán rim — softer
  sample :drum_tom_mid_soft, amp: 0.2, rate: 1.8, release: 0.02
  sleep 0.25
  
  # ============================================
  # BEAT 6
  # ============================================
  
  # Bodhrán roll — ghost, subtle (replaces snare soft)
  sample :drum_tom_lo_hard, amp: 0.25, rate: 1.3, release: 0.03
  sleep 0.25
  
  # Bodhrán rim — softer
  sample :drum_tom_mid_soft, amp: 0.2, rate: 1.8, release: 0.02
  sleep 0.25
  
  # ============================================
  # BEAT 7
  # ============================================
  
  # Kick — center
  sample :drum_bass_hard, amp: 0.7, release: 0.08
  sleep 0.25
  
  # Bodhrán rim
  sample :drum_tom_mid_soft, amp: 0.3, rate: 1.8, release: 0.02
  sleep 0.25
  
  # ============================================
  # BEAT 8
  # ============================================
  
  # Bodhrán thump — final hold (replaces snare)
  sample :drum_tom_hi_hard, amp: 0.6, rate: 0.7, release: 0.06
  sleep 0.25
  
  # Open bodhrán — resonant release (replaces open hat)
  sample :drum_tom_hi_soft, amp: 0.25, rate: 0.5, release: 0.12
  sleep 0.25
end

# ============================================
# CONTROLS
# ============================================

# set_volume! :pich, 0.9
