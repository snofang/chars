# ==========================================================
# VOICE SONIC PI ENGINE - FULLY OPTIMIZED (with Data Helpers)
# ==========================================================

# ----------------------------------------------------------
# 1. DATA HELPERS (DRY Sequencing & Parameter Parsing)
# ----------------------------------------------------------

# Generates a 16-step ring from a binary string ("x...x...") and an array of data.
# Guarantees exactly 16 steps, eliminating manual `nil` counting.
define :gen_score do |pattern, data|
  data = [nil] if data.nil? || data.empty?
  idx = 0
  # Pad pattern to exactly 16 characters
  p_str = pattern.to_s.ljust(16, '.')[0...16]
  
  p_str.chars.map do |char|
    if char == 'x' || char == 'X'
      val = data[idx % data.length]
      idx += 1
      val
    else
      nil
    end
  end.ring
end

# ----------------------------------------------------------
# 2. PARAMETER PARSER (Bulletproof + Cached)
# ----------------------------------------------------------
@parse_cache = {}

define :parse_step do |step, defaults|
  return nil, nil unless step
  
  # Simple cache key
  key = [step, defaults]
  return @parse_cache[key] if @parse_cache.key?(key)
  
  # Original logic unchanged
  if step.is_a?(Hash)
    note = step[:note]
    opts = defaults.merge(step)
    opts.delete(:note)
  else
    note = step
    opts = defaults
  end
  
  if note.is_a?(Array)
    note = note.compact
    return nil, opts if note.empty?
  end
  
  result = [note, opts]
  @parse_cache[key] = result
  result
end

# ----------------------------------------------------------
# 3. NOTE CACHE
# ----------------------------------------------------------
@note_cache = {}

define :note_cached do |pitch|
  return nil unless pitch
  @note_cache[pitch] ||= note(pitch)
end

# ----------------------------------------------------------
# 4. GLOBAL FX BUSES & QUEUES
# ----------------------------------------------------------

# Queues for FX-wrapped instruments
@lead_notes = []
@snare_notes = []

# Lead echo processor (sync'd with conductor)
live_loop :lead_fx do
  sync :conductor_step
  if @lead_notes.any?
    note, opts = @lead_notes.shift
    with_fx :echo, phase: 0.375, decay: 4, mix: 0.3 do
      use_synth :prophet
      play note, **opts
    end
  end
end

# Snare reverb processor
live_loop :snare_fx do
  sync :conductor_step
  if @snare_notes.any?
    note, opts = @snare_notes.shift
    with_fx :reverb, room: 0.9, mix: 0.5 do
      sample :sn_dolf, pitch: (note_cached(note) - note_cached(:c4)), **opts
    end
  end
end

# ----------------------------------------------------------
# 5. THE SYNTHESIZERS
# ----------------------------------------------------------

# 1. SUBTRACTIVE BASS
define :play_sub do |n|
  use_synth :dsaw
  note, opts = parse_step(n, {release: 0.25, amp: 1.5, cutoff: 80})
  play note, **opts if note
end

# 2. SUBTRACTIVE LEAD (FX moved to global bus)
define :play_lead do |n|
  note, opts = parse_step(n, {release: 0.2, amp: 1.0, cutoff: rrand(80, 110)})
  @lead_notes << [note, opts] if note
end

# 3. WARM CHORDS / NEO-SOUL PAD
define :play_chords do |n|
  use_synth :blade
  note, opts = parse_step(n, {release: 1.5, amp: 0.7, attack: 0.2, cutoff: 80})
  play note, **opts if note
end

# 4. GRANULAR CLOUD (Runtime optimized - just pushes to queue)
@grain_events = {}

define :play_grain do |n|
  # Does nothing at runtime - all grains pre-expanded at boot
  # This function exists only for API compatibility
end

# 5. FM BELL
define :play_fm do |n|
  use_synth :fm
  note, opts = parse_step(n, {release: 0.3, amp: 0.8, divisor: 2.0, depth: 3})
  play note, **opts if note
end

# 6. PHYSICAL MODELING (Pluck)
define :play_pluck do |n|
  use_synth :pluck
  note, opts = parse_step(n, {release: 0.3, amp: 0.8, coef: rrand(0.3, 0.7)})
  play note, **opts if note
end

# 7. DARK AMBIENT PAD
define :play_pad do |n|
  use_synth :dark_ambience
  note, opts = parse_step(n, {release: 1.5, amp: 0.6, attack: 0.5})
  play note, **opts if note
end

# 8. PITCHED KICK
define :play_kick do |n|
  note, opts = parse_step(n, {amp: 1.5})
  sample :bd_haus, pitch: (note_cached(note) - note_cached(:c4)), **opts if note
end

# 9. PITCHED SNARE (FX moved to global bus)
define :play_snare do |n|
  note, opts = parse_step(n, {amp: 0.8})
  @snare_notes << [note, opts] if note
end

# 10. MICRO-TIMED HI-HATS
define :play_hats do |n|
  note, opts = parse_step(n, {amp: 0.3})
  if note
    at [0, 0.125, 0.375] do
      sample :drum_cymbal_closed, rate: 1.2, pan: rrand(-0.5, 0.5), **opts
    end
  end
end

# ----------------------------------------------------------
# 6. GRAIN PRE-EXPANSION HELPER (Preserves Randomness)
# ----------------------------------------------------------
define :expand_grain_events do |raw|
  events = []
  
  note, opts = parse_step(raw, {amp: 0.5})
  return events unless note
  
  density = opts[:density] || 4
  pitch_shift = note_cached(note) - note_cached(:c4)
  interval = 0.25 / density
  size = opts[:size] || 0.05
  buffer = opts[:buffer] || :ambi_choir
  amp = opts[:amp] || 0.5
  pos = opts[:pos] || rrand(0.3, 0.5)  # ← Random once per step
  
  density.times do |i|
    # Organic randomness preserved - each grain gets its own rrand
    grain_start = pos + rrand(-0.01, 0.01)
    
    events << {
      time_offset: i * interval,
      buffer: buffer,
      pitch: pitch_shift,
      start: grain_start,
      finish: grain_start + size,
      pan: rrand(-0.8, 0.8),  # ← Random per grain
      attack: size / 2,
      release: size / 2,
      amp: amp
    }
  end
  
  events
end

# ----------------------------------------------------------
# 7. VALIDATION & ENGINE BOOT
# ----------------------------------------------------------
define :start_engine do |playbook|
  # 1. Strict schema validation
  playbook.to_a.flatten(1).each do |task|
    inst, score, bars = task
    unless score.length == 16
      raise ArgumentError, "#{inst} score must have exactly 16 steps, but got #{score.length}."
    end
  end
  
  # 2. Pre-expand all grain events (with randomness captured at boot)
  @grain_schedule = {}
  
  playbook.each do |inst, score, bars|
    next unless inst == :play_grain
    
    bars.times do |bar|
      16.times do |step|
        idx = bar * 16 + step
        raw = score[step]
        next unless raw
        
        events = expand_grain_events(raw)
        @grain_schedule[idx] = events if events.any?
      end
    end
  end
  
  # 3. The Conductor
  live_loop :conductor do
    scene = playbook.tick(:conductor)
    max_bars = scene.map { |task| task[2] }.max || 1
    total_steps = max_bars * 16
    
    # 4. Step-by-step sequencing
    total_steps.times do |step|
      # Play grains for this step (ONE 'at' call per step with grains)
      if @grain_schedule.key?(step)
        at 0 do
          events = @grain_schedule[step]
          events.each_with_index do |grain, i|
            # Sleep to the correct offset
            if i > 0
              sleep grain[:time_offset] - events[i-1][:time_offset]
            else
              sleep grain[:time_offset]
            end
            
            sample grain[:buffer],
              pitch: grain[:pitch],
              start: grain[:start],
              finish: grain[:finish],
              pan: grain[:pan],
              attack: grain[:attack],
              release: grain[:release],
              amp: grain[:amp]
          end
        end
      end
      
      # Play normal instruments
      scene.each do |task|
        inst, score, bars = task
        next if inst == :play_grain  # Already handled above
        
        if step < (bars * 16)
          send(inst, score[step % 16])
        end
      end
      
      # Trigger FX processors after scheduling notes
      cue :conductor_step
      
      # The single master sleep for all instruments
      sleep 0.25
    end
  end
end
