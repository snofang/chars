# ==========================================================
# VOICE SONIC PI ENGINE - OPTIMIZED (Full Instrument Set)
# ==========================================================

# ----------------------------------------------------------
# 1. PARAMETER PARSER (Bulletproof + Cached)
# ----------------------------------------------------------
@parse_cache = {}

define :parse_step do |step, defaults|
  return nil, nil unless step
  
  # Simple cache key
  key = [step, defaults]
  return @parse_cache[key] if @parse_cache.key?(key)
  
  # Original logic unchanged
  if step.is_a?(Hash)
    note = step[:note]
    opts = defaults.merge(step)
    opts.delete(:note)
  else
    note = step
    opts = defaults
  end
  
  if note.is_a?(Array)
    note = note.compact
    return nil, opts if note.empty?
  end
  
  result = [note, opts]
  @parse_cache[key] = result
  result
end

# ----------------------------------------------------------
# 2. NOTE CACHE
# ----------------------------------------------------------
@note_cache = {}

define :note_cached do |pitch|
  return nil unless pitch
  @note_cache[pitch] ||= note(pitch)
end

# ----------------------------------------------------------
# 3. GLOBAL FX BUSES & QUEUES
# ----------------------------------------------------------

# Queues for FX-wrapped instruments
@lead_notes = []
@snare_notes = []

# Lead echo processor (sync'd with conductor)
live_loop :lead_fx do
  sync :conductor_step
  if @lead_notes.any?
    note, opts = @lead_notes.shift
    with_fx :echo, phase: 0.375, decay: 4, mix: 0.3 do
      use_synth :prophet
      play note, **opts
    end
  end
end

# Snare reverb processor
live_loop :snare_fx do
  sync :conductor_step
  if @snare_notes.any?
    note, opts = @snare_notes.shift
    with_fx :reverb, room: 0.9, mix: 0.5 do
      sample :sn_dolf, pitch: (note_cached(note) - note_cached(:c4)), **opts
    end
  end
end

# ----------------------------------------------------------
# 4. THE SYNTHESIZERS (Full Instrument Set)
# ----------------------------------------------------------

# 1. SUBTRACTIVE BASS
define :play_sub do |n|
  use_synth :dsaw
  note, opts = parse_step(n, {release: 0.25, amp: 1.5, cutoff: 80})
  play note, **opts if note
end

# 2. SUB BASS (Pure sine - CLEAN LOW END)
define :play_subbass do |n|
  use_synth :sine
  note, opts = parse_step(n, {release: 0.5, amp: 0.8})
  play note, **opts if note
end

# 3. SUBTRACTIVE LEAD (FX moved to global bus)
define :play_lead do |n|
  note, opts = parse_step(n, {release: 0.2, amp: 1.0, cutoff: rrand(80, 110)})
  @lead_notes << [note, opts] if note
end

# 4. WARM CHORDS / NEO-SOUL PAD
define :play_chords do |n|
  use_synth :blade
  note, opts = parse_step(n, {release: 1.5, amp: 0.7, attack: 0.2, cutoff: 80})
  play note, **opts if note
end

# 5. DARK AMBIENT PAD
define :play_pad do |n|
  use_synth :dark_ambience
  note, opts = parse_step(n, {release: 1.5, amp: 0.6, attack: 0.5})
  play note, **opts if note
end

# 6. FM BELL
define :play_fm do |n|
  use_synth :fm
  note, opts = parse_step(n, {release: 0.3, amp: 0.8, divisor: 2.0, depth: 3})
  play note, **opts if note
end

# 7. PHYSICAL MODELING (Pluck)
define :play_pluck do |n|
  use_synth :pluck
  note, opts = parse_step(n, {release: 0.3, amp: 0.8, coef: rrand(0.3, 0.7)})
  play note, **opts if note
end

# 8. GRANULAR CLOUD (with note cache)
define :play_grain do |n|
  return unless n
  note, opts = parse_step(n, {amp: 0.5})
  
  density = opts[:density] || 4
  pos     = opts[:pos] || rrand(0.3, 0.5)
  size    = opts[:size] || 0.05
  buffer  = opts[:buffer] || :ambi_choir
  
  opts.delete(:density); opts.delete(:pos); opts.delete(:size); opts.delete(:buffer)
  
  pitch_shift = note_cached(note) - note_cached(:c4)
  interval = 0.25 / density
  
  at density.times.map { |i| i * interval } do
    grain_start = pos + rrand(-0.01, 0.01)
    grain_finish = grain_start + size
    
    sample buffer, 
      pitch: pitch_shift, 
      start: grain_start, 
      finish: grain_finish, 
      pan: rrand(-0.8, 0.8), 
      attack: size / 2,
      release: size / 2, 
      **opts
  end
end

# 9. SAMPLE PLAYER (Trigger any sample with pitch)
define :play_sample do |n|
  note, opts = parse_step(n, {amp: 0.8})
  if note && opts[:sample]
    sample opts[:sample], 
      pitch: (note_cached(note) - note_cached(:c4)), 
      **opts
  end
end

# 10. FILTERED NOISE (For transitions & FX)
define :play_noise do |n|
  note, opts = parse_step(n, {amp: 0.5, release: 0.3, cutoff: 60})
  use_synth :noise
  # Note controls filter cutoff
  play :c4, cutoff: note_cached(note) - note_cached(:c4) + 60, **opts if note
end

# 11. PITCHED KICK (with note cache)
define :play_kick do |n|
  note, opts = parse_step(n, {amp: 1.5})
  sample :bd_haus, pitch: (note_cached(note) - note_cached(:c4)), **opts if note
end

# 12. PITCHED SNARE (FX moved to global bus + note cache)
define :play_snare do |n|
  note, opts = parse_step(n, {amp: 0.8})
  @snare_notes << [note, opts] if note
end

# 13. MICRO-TIMED HI-HATS
define :play_hats do |n|
  note, opts = parse_step(n, {amp: 0.3})
  if note
    at [0, 0.125, 0.375] do
      sample :drum_cymbal_closed, rate: 1.2, pan: rrand(-0.5, 0.5), **opts
    end
  end
end

# ----------------------------------------------------------
# 5. VALIDATION & ENGINE BOOT (The Single Master Clock)
# ----------------------------------------------------------
define :start_engine do |playbook|
  # 1. Strict schema validation
  playbook.to_a.flatten(1).each do |task|
    inst, score, bars = task
    unless score.length == 16
      raise ArgumentError, "#{inst} score must have exactly 16 steps, but got #{score.length}."
    end
  end
  
  # 2. The Conductor
  live_loop :conductor do
    scene = playbook.tick(:conductor)
    max_bars = scene.map { |task| task[2] }.max || 1
    total_steps = max_bars * 16
    
    # 3. Step-by-step sequencing
    total_steps.times do |step|
      scene.each do |task|
        inst, score, bars = task
        
        # Only trigger if the instrument's duration hasn't expired
        if step < (bars * 16)
          send(inst, score[step % 16])
        end
      end
      
      # Trigger FX processors after scheduling notes
      cue :conductor_step
      
      # The single master sleep for all instruments
      sleep 0.25
    end
  end
end
