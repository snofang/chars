# ==========================================================
# PLAYBOOK: BASSLINE / UK NICHE
# Bouncy, Wobbly, Heavy Northern Energy
# ==========================================================
# [WHY THIS GENRE?]
# Bassline (T2, DJ Q) pushes the bass to the absolute front
# of the mix, using wobbly LFO filters and frantic R&B vocal
# chops. This playbook captures that bouncy, heavy, Northern
# England sound.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 138 BPM
# Key: F# minor (bouncy, heavy)
# Rhythm: 4/4 kick, clap on 2/4, off‑beat hats, continuous
# 16th wobble bass with alternating cutoff, off‑beat minor
# 9th chords, bouncy R&B melody, frantic diva vocal chops.
# Timbre: Driving kick (bd_haus), heavy dry clap (sn_dolf),
# off‑beat hats (cymbal_closed), wobble bass (dsaw with
# alternating cutoff), lush minor chords (blade), sharp FM
# lead (divisor 2, depth 2), granular diva vocal stutters.
# Arrangement: Groove (kick+hats+bass) → Vibe (add clap+
# chords) → Drop (add melody+vocal).
# ==========================================================

use_bpm 138

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Driving 4‑on‑the‑floor kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy dry clap on beats 2 and 4 (steps 4 and 12)
s_clap = gen_score("....x.......x...", [:c4])

# Off‑beat hats (steps 2,6,10,14) with alternating amps
s_hats = gen_score("..x..x..x..x....",
  [{note: :c4, amp: 0.4}, {note: :c4, amp: 0.3}])

# Wobble bass – alternating cutoff (60/120) on every 16th step
bass_data = [
  {note: :fs2, cutoff: 60}, {note: :fs2, cutoff: 120},
  {note: :fs2, cutoff: 60}, {note: :fs2, cutoff: 120},
  {note: :a2,  cutoff: 60}, {note: :a2,  cutoff: 120},
  {note: :a2,  cutoff: 60}, {note: :a2,  cutoff: 120},
  {note: :c3,  cutoff: 60}, {note: :c3,  cutoff: 120},
  {note: :c3,  cutoff: 60}, {note: :c3,  cutoff: 120},
  {note: :e2,  cutoff: 60}, {note: :e2,  cutoff: 120},
  {note: :e2,  cutoff: 60}, {note: :e2,  cutoff: 120}
]
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Lush minor 9th chords on off‑beats (steps 2,6,10,14)
s_chords = gen_score("..x..x..x..x....",
  [[:fs3, :a3, :c4, :e4],
   [:fs3, :a3, :c4, :e4],
   [:cs3, :e3, :g3, :b3],
   [:cs3, :e3, :g3, :b3]])

# Bouncy R&B melody – sharp, plasticky FM lead
s_fm = gen_score("x..x..x.x..x..x.",
  [{note: :fs5, amp: 0.6, divisor: 2, depth: 2, release: 0.1},
   {note: :a5,  amp: 0.5, divisor: 2, depth: 2, release: 0.1},
   {note: :c6,  amp: 0.6, divisor: 2, depth: 2, release: 0.1},
   {note: :e6,  amp: 0.5, divisor: 2, depth: 2, release: 0.1},
   {note: :c6,  amp: 0.6, divisor: 2, depth: 2, release: 0.1},
   {note: :a5,  amp: 0.5, divisor: 2, depth: 2, release: 0.1}])

# Frantic diva vocal chops – granular stutters
s_vocal = gen_score("....x.....x...x.",
  [{note: :fs4, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.04, amp: 0.6},
   {note: :a4,  buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.04, amp: 0.6},
   {note: :fs4, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.04, amp: 0.6}])

# Playbook
playbook = (ring
  # Scene 1: Groove – Kick, Hats, Bass
  [ [:play_kick, s_kick, 4], [:play_hats, s_hats, 4],
    [:play_sub, s_bass, 4] ],

  # Scene 2: Vibe – Add Clap and Chords
  [ [:play_kick, s_kick, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_snare, s_clap, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3: Drop – Add Melody and Vocal Chops
  [ [:play_kick, s_kick, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_snare, s_clap, 8],
    [:play_chords, s_chords, 8], [:play_lead, s_fm, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Data‑driven LFO: alternating cutoff (60/120) on every 16th
#   step simulates a fast filter wobble without an LFO oscillator.
# - The Niche bounce: bass, hats, and chords all hit on the
#   off‑beats (2,6,10,14) – the engine locks them at 138 BPM.
# - Diva vocals: pitched‑up granular shards (size 0.04) create
#   a sugary R&B stutter that dances on top of the wobble bass.
# ==========================================================
