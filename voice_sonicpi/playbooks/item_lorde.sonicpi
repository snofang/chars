# ==========================================================
# PLAYBOOK: LORDE - "ROYALS" (2013)
# ==========================================================

use_bpm 85

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!)

# ==========================================================
# 2. THE SCORES (D Minor / B Minor - Stark, Booming, & Minimalist)
# ==========================================================

# The "Booming" 808 Kick. 
# A heavy, syncopated, slow bounce. (4 x's, 4 elements)
s_kick = gen_score("x.....x.x.....x.", [
  :c4, {note: :c4, amp: 0.8}, :c4, {note: :c4, amp: 0.9}
])

# Crisp, dry snare/snap strictly on beats 2 and 4. (2 x's, 2 elements)
s_snare = gen_score("....x.......x...", [:c4, :c4])

# Very sparse, ticking 8th hats. (4 x's, 4 elements)
s_hats = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.15}, 
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.15}
])

# Deep, massive "Sub-Bass" (D Minor).
# Plays a slow, syncopated, booming line. 
# Extreme low cutoff (40) and massive release (3.0) create a deep, 
# continuous, suffocating rumble. (2 x's, 2 elements)
s_bass = gen_score("x.......x.......", [
  {note: :d1, release: 3.0, cutoff: 40, amp: 1.2}, 
  {note: :g1, release: 3.0, cutoff: 40, amp: 1.0}
])

# Lush, "Synth Pad" Chords (Dm to G).
# Hit on the downbeats. The slow 2.0-beat attack and massive 4.0-beat release 
# blur the chords together into a continuous, cinematic, dark wave. (2 x's, 2 elements)
s_chords = gen_score("x.......x.......", [
  {note: [:d3, :f3, :a3], cutoff: 60, attack: 2.0, release: 4.0, amp: 0.4},
  {note: [:g2, :b2, :d3], cutoff: 60, attack: 2.0, release: 4.0, amp: 0.4}
])

# Piercing, "Echoing" FM Pluck Lead (D Minor Pentatonic).
# Uses :play_fm with a high divisor (3) and low depth (2) to create a pristine, 
# glassy, digital tone. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:d5, :c5, :a4, :g4, :f4, :d4]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 2, release: 0.5} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Royals" Vocal Stutter (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched DOWN.
# High density, tiny size = a sharp, percussive, moody vocal skip. (2 x's, 2 elements)
s_vocal = gen_score("....x.......x...", [
  {note: :d3, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.04, amp: 0.7},
  {note: :f3, buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the deep sub-bass, sweeping pad, and vocal chops (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Verse - Add the slow, booming 808 drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chorus - The piercing, echoing FM pluck drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN MINIMALIST POP]
# 
# 1. The Booming 808 Bass: Look at `s_bass`. The `:play_sub` synth is given 
#    an extreme low `cutoff` (40) and a massive `release` (3.0). This creates 
#    a deep, round, and warm low-end that rings out for over three beats, 
#    providing the immense, suffocating weight that defined the 2010s 
#    alternative-pop sound.
#
# 2. The Cinematic Swell: Look at `s_chords`. The Hashes specify an `attack` 
#    of `2.0` and a `release` of `4.0`. Because the engine reads these 
#    Hashes, the chords don't just hit; they slowly swell into the mix and 
#    fade away over six whole beats, creating a continuous, blurred wave 
#    of warm harmony that perfectly mimics the lush, dark, cinematic pads 
#    of the track.
#
# 3. The Echoing Pluck: The `s_lead` sequence uses `divisor: 3` and `depth: 2`. 
#    This gentle harmonic ratio produces a pristine, glassy, digital tone. 
#    Because it's routed through the global tape echo bus, the sparse notes 
#    smear into a soaring, echoing melody that cuts perfectly through the 
#    heavy sub-bass.
# ==========================================================
