# ==========================================================
# PLAYBOOK: 80s GO-GO / WASHINGTON D.C. FUNK
# Funky, Driving, Live Band Pocket
# ==========================================================
# [WHY THIS GENRE?]
# Go‑Go (Chuck Brown, Trouble Funk) is a distinct live‑band
# fusion of funk, hip‑hop, and early dance music from D.C. It
# relies on a relentless 4/4 pocket, heavy conga percussion,
# call‑and‑response vocals, and a melodic syncopated bassline.
# This playbook captures that unstoppable, lopsided groove.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 112 BPM
# Key: E Dorian (funky, driving)
# Rhythm: Syncopated kick (0,3,4,8,11,12), snare with ghost
# (4,7,12), driving 16th hats with alternating amps, syncopated
# FM congas, walking bass, off‑beat horn stabs, vocal chants.
# Timbre: Live kick (bd_haus), crisp snare (sn_dolf), robotic
# hats (cymbal_closed), woody congas (fm, divisor 4, short
# release), warm bass (dsaw, low cutoff), staccato chords
# (blade), granular vocal chants (ambi_choir).
# Arrangement: Pocket (drums+bass+congas) → Vibe (add horn
# stabs) → Drop (add vocal chants).
# ==========================================================

use_bpm 112

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Go‑Go pocket kick – syncopated march (steps 0,3,4,8,11,12)
s_kick = gen_score("x..xx...x..xx...",
  [:c4,
   {note: :c4, amp: 0.6},
   :c4,
   :c4,
   {note: :c4, amp: 0.6},
   :c4])

# Crisp live snare with ghost on step 7 (steps 4,7,12)
s_snare = gen_score("....x..x....x...",
  [{note: :c4, amp: 0.9},
   {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.9}])

# Driving 16th hats with alternating amplitudes
hat_amps = [0.3, 0.15, 0.3, 0.15, 0.3, 0.15, 0.3, 0.15,
            0.3, 0.15, 0.3, 0.15, 0.3, 0.15, 0.3, 0.15]
s_hats = gen_score("xxxxxxxxxxxxxxxx",
  hat_amps.map { |a| {note: :c4, amp: a} })

# Live conga loop – FM with divisor 4, woody thwack (steps 0,2,3,4,6,7,8,10,11,12,14,15)
s_fm = gen_score("x.xxx.xxx.xxx.xx",
  [{note: :e4, amp: 0.5, divisor: 4, depth: 1, release: 0.05},
   {note: :e4, amp: 0.3, divisor: 4, depth: 1, release: 0.05},
   {note: :b4, amp: 0.6, divisor: 4, depth: 1, release: 0.05},
   {note: :e4, amp: 0.5, divisor: 4, depth: 1, release: 0.05},
   {note: :e4, amp: 0.3, divisor: 4, depth: 1, release: 0.05},
   {note: :b4, amp: 0.6, divisor: 4, depth: 1, release: 0.05},
   {note: :e4, amp: 0.5, divisor: 4, depth: 1, release: 0.05},
   {note: :e4, amp: 0.3, divisor: 4, depth: 1, release: 0.05},
   {note: :a4, amp: 0.6, divisor: 4, depth: 1, release: 0.05},
   {note: :e4, amp: 0.5, divisor: 4, depth: 1, release: 0.05},
   {note: :e4, amp: 0.3, divisor: 4, depth: 1, release: 0.05},
   {note: :b4, amp: 0.6, divisor: 4, depth: 1, release: 0.05}])

# Deep melodic bass – warm, syncopated (steps 0,3,5,7,9,11,13,15)
s_bass = gen_score("x..x.x.x.x.x.x.x",
  [{note: :e2, release: 0.2, cutoff: 70},
   {note: :e2, release: 0.2, cutoff: 70},
   {note: :g2, release: 0.2, cutoff: 70},
   {note: :a2, release: 0.2, cutoff: 70},
   {note: :g2, release: 0.2, cutoff: 70},
   {note: :e2, release: 0.2, cutoff: 70},
   {note: :d2, release: 0.2, cutoff: 70},
   {note: :e2, release: 0.2, cutoff: 70}])

# Staccato horn/clav stabs (steps 2,6,10,14)
s_chords = gen_score("..x...x...x...x.",
  [[:e3, :g3, :b3],
   [:e3, :g3, :b3],
   [:a3, :c4, :e4],
   [:d3, :fs3, :a3]])

# Call‑and‑response vocal chants (steps 4 and 12)
s_vocal = gen_score("....x.......x...",
  [{note: :e4, buffer: :ambi_choir, pos: 0.1, density: 2, size: 0.05, amp: 0.6},
   {note: :e4, buffer: :ambi_choir, pos: 0.1, density: 2, size: 0.05, amp: 0.6}])

# Playbook
playbook = (ring
  # Scene 1: Pocket – Drums, Bass, Congas
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4],
    [:play_hats, s_hats, 4], [:play_sub, s_bass, 4],
    [:play_fm, s_fm, 4] ],

  # Scene 2: Vibe – Add Horn Stabs
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_fm, s_fm, 8], [:play_chords, s_chords, 8] ],

  # Scene 3: Drop – Add Vocal Chants
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_fm, s_fm, 8], [:play_chords, s_chords, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - FM as congas: divisor 4 and release 0.05 create a hollow,
#   woody thwack – the engine's grid locks the polyrhythmic loop.
# - Go‑Go pocket: syncopated kick on 0,3,4,8,11,12 – the lopsided
#   march drives the live band feel.
# - Call‑and‑response: granular vocal chops on 2 and 4 create the
#   signature repetitive chant structure.
# ==========================================================
