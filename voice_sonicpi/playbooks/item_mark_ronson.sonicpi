# ==========================================================
# PLAYBOOK: MARK RONSON ft. BRUNO MARS - "UPTOWN FUNK" (2014)
# ==========================================================

use_bpm 115

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Dorian - Funky, Punchy, & Relentless)
# ==========================================================

# Driving 4/4 funk kick. (4 x's, 4 elements)
s_kick = gen_score("x...x...x...x...", [:c4, :c4, :c4, :c4])

# Heavy, organic disco clap strictly on beats 2 and 4, with a ghost note. 
# (3 x's, 3 elements)
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.4}, {note: :c4, amp: 1.0}
])

# Rigid, driving 16th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Uptown Funk" Bass (D Dorian).
# Plays the iconic, syncopated, octave-jumping riff. 
# High cutoff (110) and microscopic release (0.08) create a punchy, 
# aggressive "thwack" that mimics a slapped synth bass. (8 x's, 8 elements)
bass_notes = [:d2, :d2, :c2, :b1, :a1, :b1, :d2, :b1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 110, release: 0.08, amp: 1.0} }
s_bass = gen_score("x..x.x..x..x.x..", bass_data)

# Stark, "Brass Section" Stabs (Dm7 to Gm7).
# Uses :play_fm with a low divisor (2) and mid depth (4) to create a harsh, 
# brassy, staccato hit. Hit strictly on the off-beats. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:d3, :f3, :a3, :c4], divisor: 2, depth: 4, release: 0.08, amp: 0.6},
  {note: [:d3, :f3, :a3, :c4], divisor: 2, depth: 4, release: 0.08, amp: 0.6},
  {note: [:g3, :bb3, :d4, :f4], divisor: 2, depth: 4, release: 0.08, amp: 0.6},
  {note: [:g3, :bb3, :d4, :f4], divisor: 2, depth: 4, release: 0.08, amp: 0.6}
])

# Piercing, "Trumpet" Lead (D Dorian).
# Uses :play_fm with a high divisor (3) and mid depth (3) to create a sharp, 
# brassy tone. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:d5, :f5, :d5, :c5, :a4, :d5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, divisor: 3, depth: 3, release: 0.15} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Hoo!" Vocal Stutter (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched UP.
# High density, tiny size = a sharp, percussive vocal skip. (2 x's, 2 elements)
s_vocal = gen_score("....x.......x...", [
  {note: :d4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.7},
  {note: :a4, buffer: :ambi_choir, pos: 0.3, density: 3, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the iconic bass, brass stabs, and vocal chops (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Verse - Add the driving 4/4 funk drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chorus - The piercing trumpet melody drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN MODERN FUNK]
# 
# 1. The Dorian Riff: Look at `s_bass`. The `:play_sub` synth plays the iconic 
#    D-D-C-B-A-B-D-B riff in D Dorian. By using a high `cutoff` (110) and a 
#    microscopic `release` (0.08), the engine turns the detuned sawtooth into a 
#    punchy, aggressive "thwack" that perfectly mimics the legendary synth bass 
#    sound of "Uptown Funk".
#
# 2. FM as a Brass Section: Look at `s_chords`. The `:play_fm` synth is given 
#    a `divisor` of `2` and a `depth` of `4`, with a microscopic `release` 
#    (0.08). This forces the FM synth to produce a harsh, brassy, staccato 
#    "hit" that perfectly mimics a live horn section locking in with the 
#    rhythm section on the off-beats.
#
# 3. The Off-Beat Groove: Look at `s_hats` and `s_chords`. They ALL hit strictly 
#    on steps 2, 6, 10, and 14. In a 16-step grid, these are the exact midpoints 
#    between the kicks. The engine's strict master clock locks these together 
#    perfectly, creating a massive, bouncing "boom-cha" groove that forces 
#    you to dance.
# ==========================================================
