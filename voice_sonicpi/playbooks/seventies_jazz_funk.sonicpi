# ==========================================================
# PLAYBOOK: 70s JAZZ FUNK / FUSION
# (Pioneered by Herbie Hancock, The Crusaders, and Weather Report)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 70s Jazz Funk.
# We have explored P-Funk and Motown, but Jazz Funk is the sound of 
# 70s virtuosity and groove. It fuses complex, syncopated jazz drumming 
# with deep, round Moog basslines, stark, staccato clavinet stabs, 
# and soaring, improvisational synth solos. 
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create a highly syncopated, live-band groove. By using the `:play_fm` 
# synth to simulate a Hohner Clavinet and the `:play_sub` synth to create 
# a round, melodic bass, the engine creates a sophisticated, deeply funky 
# atmosphere that feels like a smoke-filled 70s jazz club.
# ==========================================================

use_bpm 100

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Dorian - Groovy, Syncopated, & Virtuosic)
# ==========================================================

# The "Jazz Funk" Kick. 
# Highly syncopated. Hits on step 0, the 'and' of 2 (step 6), and beat 3 (step 8).
s_kick = gen_score("x.....x.x.......", [:c4, {note: :c4, amp: 0.8}, :c4])

# Crisp, live snare on beats 2 and 4, with a syncopated ghost note 
# on the 'e' of 3 (step 10).
s_snare = gen_score("....x...x.x.....", [:c4, {note: :c4, amp: 0.4}, {note: :c4, amp: 0.9}])

# Swung, bouncing 16th shaker.
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.1}, 
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Round Moog" Bass (D Dorian).
# Plays a syncopated, melodic line. Low cutoff (70) and medium release (0.2) 
# to create a warm, bouncy undercurrent.
bass_notes = [:d1, :d1, :f1, :d1, :a1, :a1, :g1, :a1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 70, release: 0.2, amp: 1.2} }
s_bass = gen_score("x.....x.x.....x.", bass_data)

# Stark, "Clavinet" Stabs (Dm9 to Gm9).
# Uses :play_fm with a low divisor (2) and mid depth (3) to create a sharp, 
# buzzy staccato hit that mimics a Hohner Clavinet.
chord_notes = [
  {note: [:d3, :f3, :a3, :c4]}, {note: [:d3, :f3, :a3, :c4]}, 
  {note: [:g2, :bb2, :d3, :f3]}, {note: [:g2, :bb2, :d3, :f3]}
]
chord_data = chord_notes.map { |c| c.merge({divisor: 2, depth: 3, release: 0.1, amp: 0.6}) }
s_chords = gen_score("..x...x...x...x.", chord_data)

# Soaring, "Synth Sax" Lead (D Dorian Pentatonic).
# Uses :play_fm with a high divisor (3) and low depth (2) to create a clean, 
# piercing tone. Routed through the engine's tape echo for a cavernous smear.
lead_notes = [:d5, :f5, :a5, :d6, :c6, :a5, :g5, :f5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 2, release: 0.3} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# Soft, "Room Ambience" drone (Granular Synth).
# Long size (0.2) and low density (1) creates a slow, evolving background 
# texture that sounds like the ambient hum of a live club.
s_grain = gen_score("x...............", [
  {note: :d4, buffer: :misc_lori, pos: 0.3, density: 1, size: 0.2, amp: 0.3}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the syncopated drums, Moog bass, and clavinet (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_fm, s_chords, 4] ],
  
  # Scene 2: The Vibe - Add the room ambience (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_grain, 8] ],
    
  # Scene 3: The Solo - The soaring synth sax lead drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN JAZZ FUNK]
# 
# 1. FM as a Clavinet: Look at `s_chords`. The `:play_fm` synth is given a 
#    `divisor` of `2` and a `depth` of `3`, with a microscopic `release` 
#    (0.1). This forces the FM synth to produce a sharp, buzzy, staccato 
#    "thwack" that perfectly mimics a Hohner Clavinet, locking perfectly 
#    into the off-beats of the 16-step grid.
#
# 2. The Dorian Mode: Look at `s_bass` and `s_lead`. The melody uses D, E, 
#    F, G, A, B, C. The minor 3rd (F) and major 6th (B) create the smooth, 
#    sophisticated, "cool" sound that defines 70s jazz funk. The engine's 
#    strict 16-step grid ensures this complex, syncopated melody fires 
#    flawlessly over the groovy rhythm section.
#
# 3. The Round Moog Bass: Look at `s_bass`. The `:play_sub` synth is given a 
#    `release` of `0.2` and a low `cutoff` of `70`. This creates a deep, 
#    round, and warm low-end that carries the melody, providing immense 
#    weight without muddying the pristine high-end of the clavinet and shaker.
# ==========================================================
