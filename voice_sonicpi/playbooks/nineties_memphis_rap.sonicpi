# ==========================================================
# PLAYBOOK: 90s MEMPHIS RAP / HORRORCORE
# (Pioneered by Three 6 Mafia, Tommy Wright III, and DJ Paul)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Memphis Rap.
# We have explored modern Phonk and dark Trap, but 90s Memphis Rap is the 
# raw, eerie origin of it all. Emerging from the underground in the early 
# 90s, it was made on cheap cassette 4-track recorders. It relies on a 
# slow, dragging tempo (70 BPM), lo-fi 808 bass, eerie synth melodies, 
# and heavily pitched-down, demonic horrorcore vocal samples.
#
# This playbook perfectly demonstrates how to use extreme negative space 
# and low `cutoff` values to create a gritty, lo-fi atmosphere. By using 
# the Granular Synthesizer to pitch a vocal *down* into a demonic, 
# time-stretched drone, the engine creates a chilling, 90s underground 
# horror atmosphere.
# ==========================================================

use_bpm 70

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Minor - Dark, Gritty, & Eerie)
# ==========================================================

# Slow, dragging 808 kick. 
# Hits on step 0, the 'and' of 2 (step 6), beat 3 (step 8), 
# and the 'a' of 4 (step 14).
s_kick  = (ring :c4, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, {:note => :c4, :amp => 1.0}, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.6}, nil)

# Crisp, lo-fi snare strictly on beats 2 and 4 (steps 4 and 12).
s_snare = (ring nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil)

# Triplet-feel hi-hat rolls.
s_hats  = (ring {:note => :c4, :amp => 0.2}, nil, nil, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, nil, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.5})

# Deep, rumbling 808 Bass (F# Minor).
# Massive release (1.0) allows the bass to ring out and carry the dark melody.
s_bass  = (ring {:note => :fs1, :release => 1.0, :cutoff => 60, :amp => 1.2}, nil, nil, nil, nil, nil, nil, nil, {:note => :a1, :release => 1.0, :cutoff => 60, :amp => 1.0}, nil, nil, nil, nil, nil, nil, nil)

# Dark, sparse minor chord stabs (F#m to Am).
# Hit sparingly on the downbeats. Low cutoff (70) gives them a muffled, 
# lo-fi cassette tape feel.
s_chords= (ring {:note => [:fs3, :a3, :c4], :cutoff => 70, :release => 0.5, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil, {:note => [:a3, :c4, :e4], :cutoff => 70, :release => 0.5, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil)

# Eerie, "Horrorcore" Synth Melody (F# Minor Pentatonic).
# Uses :play_fm with a low divisor (2) and depth (3) to create a sharp, 
# buzzy square wave. Routed through the engine's tape echo for a cavernous smear.
s_fm    = (ring {:note => :fs5, :amp => 0.5, :divisor => 2, :depth => 3, :release => 0.5}, nil, nil, {:note => :a5, :amp => 0.4, :divisor => 2, :depth => 3, :release => 0.5}, nil, {:note => :c6, :amp => 0.5, :divisor => 2, :depth => 3, :release => 0.5}, nil, nil, {:note => :b5, :amp => 0.4, :divisor => 2, :depth => 3, :release => 0.5}, nil, nil, {:note => :a5, :amp => 0.5, :divisor => 2, :depth => 3, :release => 0.5}, nil, {:note => :fs5, :amp => 0.6, :divisor => 2, :depth => 3, :release => 0.5}, nil, nil)

# Pitched-down, demonic "Horrorcore" vocal drone (Granular Synth).
# Pitched DOWN to :fs3. Long size (0.2) and low density (1) creates a 
# slow, haunting background texture that sounds like a demonic voice.
s_vocal = (ring {:note => :fs3, :buffer => :ambi_choir, :pos => 0.2, :density => 1, :size => 0.2, :amp => 0.6}, nil, nil, nil, nil, nil, nil, nil, {:note => :a3, :buffer => :ambi_choir, :pos => 0.4, :density => 1, :size => 0.2, :amp => 0.6}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Shadows - Just the massive bass, eerie chords, and vocal drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Groove - Add the slow, dragging drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Drop - The eerie horrorcore synth melody drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN LO-FI DREAD]
# 
# 1. Demonic Granular: Look at `s_vocal`. The granular engine is given a 
#    low `note` (:fs3) and a long `size` (0.2). By pitching the vocal 
#    DOWN and using sparse, long grains, the engine time-stretches the 
#    sample into a slow, haunting drone that sounds like a demonic voice 
#    echoing in a dark room, perfectly mimicking 90s Memphis horrorcore.
#
# 2. The Dragging 808: Look at `s_bass`. The `:play_sub` synth is given a 
#    `release` of `1.0` (a whole beat) and a very low `cutoff` of `60`. 
#    Because the BPM is 70, that low F# note rings out for almost a second, 
#    creating a massive, rumbling low-end that carries the dark melody.
#
# 3. Extreme Negative Space: 90s Memphis Rap relies on what you *don't* play. 
#    80% of the `s_kick`, `s_chords`, and `s_fm` grids are `nil`. The engine 
#    honors these rests perfectly, letting the massive 808 bass and the 
#    eerie tape echo tails ring out into the void, creating a slow, 
#    suffocating atmosphere of dread.
# ==========================================================
