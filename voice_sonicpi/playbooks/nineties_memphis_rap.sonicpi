# ==========================================================
# PLAYBOOK: 90s MEMPHIS RAP / HORRORCORE
# (Pioneered by Three 6 Mafia, Tommy Wright III, and DJ Paul)
# ==========================================================
# 
# [WHY THIS GENRE?]
# Memphis Rap is the raw, eerie origin of modern Phonk – slow,
# lo‑fi 808 bass, sparse drums, and pitched‑down horrorcore
# vocals. This playbook uses extreme negative space, low‑cutoff
# bass, and granular time‑stretching to create a chilling,
# 90s underground atmosphere.
# ==========================================================

use_bpm 70

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x.....x.x.....x.", [
  :c4,
  {note: :c4, amp: 0.8},
  {note: :c4, amp: 1.0},
  {note: :c4, amp: 0.6}
])

s_snare = gen_score("....x.......x...", [
  {note: :c4, amp: 0.8},
  {note: :c4, amp: 0.8}
])

s_hats  = gen_score("x..xx.xx.xx.xxxx", [
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.5}
])

s_bass  = gen_score("x.......x.......", [
  {note: :fs1, release: 1.0, cutoff: 60, amp: 1.2},
  {note: :a1,  release: 1.0, cutoff: 60, amp: 1.0}
])

s_chords = gen_score("x.......x.......", [
  {note: [:fs3, :a3, :c4], cutoff: 70, release: 0.5, amp: 0.5},
  {note: [:a3,  :c4, :e4], cutoff: 70, release: 0.5, amp: 0.5}
])

s_fm    = gen_score("x..x.x..x..x.x..", [
  {note: :fs5, amp: 0.5, divisor: 2, depth: 3, release: 0.5},
  {note: :a5,  amp: 0.4, divisor: 2, depth: 3, release: 0.5},
  {note: :c6,  amp: 0.5, divisor: 2, depth: 3, release: 0.5},
  {note: :b5,  amp: 0.4, divisor: 2, depth: 3, release: 0.5},
  {note: :a5,  amp: 0.5, divisor: 2, depth: 3, release: 0.5},
  {note: :fs5, amp: 0.6, divisor: 2, depth: 3, release: 0.5}
])

s_vocal = gen_score("x.......x.......", [
  {note: :fs3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.2, amp: 0.6},
  {note: :a3,  buffer: :ambi_choir, pos: 0.4, density: 1, size: 0.2, amp: 0.6}
])

# Playbook
playbook = (ring
  # Scene 1: The Shadows – bass, chords, vocal drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Groove – add slow, dragging drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Drop – eerie horrorcore synth melody (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The granular vocal is pitched down and time‑stretched
#   (size 0.2) to create a demonic, haunting drone.
# - Bass uses cutoff 60 and release 1.0, rumbling for nearly
#   a full second at 70 BPM, carrying the dark melody.
# - 80% of the grid is rests, letting echoes ring into the
#   void for a suffocating atmosphere of dread.
# ==========================================================
