# ==========================================================
# PLAYBOOK: 90s/2000s TEEN POP / MAX MARTIN STYLE
# (Pioneered by Backstreet Boys, Britney Spears, and *NSYNC)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s/2000s Teen Pop.
# We have explored modern Synthpop and 90s Eurodance, but the Max Martin 
# / Cheiron Studios sound is the absolute pinnacle of pristine, late-90s 
# pop production. It fuses a relentless, driving 4/4 beat with the famous 
# "Dennis Pop" bass (a continuous, staccato 16th-note synth bass), massive 
# wide vocal stabs, and pristine, echoing triangle/square arpeggios. 
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create unstoppable, radio-ready momentum. By locking a continuous, 
# high-cutoff bassline to a rigid 4/4 beat, the engine creates a 
# high-energy, meticulously polished pop atmosphere.
# ==========================================================

use_bpm 120

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (C# Minor - Pristine, Bouncy, & Melodic)
# ==========================================================

# Relentless, driving 4/4 kick.
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, pristine snare strictly on beats 2 and 4.
s_snare = gen_score("....x.......x...", [:c4])

# Rigid, driving 16th hats.
s_hats = gen_score("x.x.x.x.x.x.x.x.", [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}])

# The "Dennis Pop" Bass (C# Minor).
# Plays continuous 16th notes. High cutoff (110) and very short release (0.1) 
# create a relentless, bouncy, staccato "thwack" that drives the track.
bass_notes = [:cs2, :cs2, :cs3, :cs2, :cs2, :cs2, :cs3, :cs2, 
              :ab1, :ab1, :ab2, :ab1, :bb1, :bb1, :bb2, :bb1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 110, release: 0.1, amp: 1.0} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Massive, "Supersaw" Chord Stabs (C#m to Abm to Bbm).
# Hit strictly on the off-beats. High cutoff (110) and short release (0.2) 
# create a sharp, pristine wall of sound.
chord_notes = [
  {note: [:cs3, :e3, :gs3]}, {note: [:cs3, :e3, :gs3]}, 
  {note: [:gs2, :b2, :ds3]}, {note: [:bb2, :cs3, :f3]}
]
chord_data = chord_notes.map { |c| c.merge({cutoff: 110, release: 0.2, amp: 0.6}) }
s_chords = gen_score("..x...x...x...x.", chord_data)

# Piercing, "Triangle/Square" Arpeggio (C# Minor Pentatonic).
# Uses :play_fm with a high divisor (3) and low depth (1) to create a clean, 
# glassy, pristine sine-like wave. Routed through the tape echo.
lead_notes = [:cs5, :gs4, :bb4, :cs5, :eb5, :cs5, :bb4, :gs4]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 1, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# Choppy, "Diva" vocal stutter (Granular Synth).
# Pitched UP to :cs4 and :eb4. High density, tiny size = a sharp, pristine vocal skip.
s_vocal = gen_score("....x.......x...", [
  {note: :cs4, buffer: :misc_lori, pos: 0.2, density: 3, size: 0.04, amp: 0.6},
  {note: :eb4, buffer: :misc_lori, pos: 0.4, density: 3, size: 0.04, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the driving beat and staccato bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_hats, s_hats, 4] ],
  
  # Scene 2: The Vibe - Add the heavy snare, supersaw stabs, and vocals (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8], 
    [:play_snare, s_snare, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drop - The piercing arpeggio melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8], 
    [:play_snare, s_snare, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN POP MOMENTUM]
# 
# 1. The "Dennis Pop" Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step, alternating between the low octave (:cs2) and the 
#    high octave (:cs3). By using a high `cutoff` (110) and a very short 
#    `release` (0.1), the engine turns the detuned sawtooth into a relentless, 
#    bouncy, staccato "thwack" that perfectly mimics the famous Dennis Pop 
#    basslines of Cheiron Studios.
#
# 2. Pristine Off-Beat Stabs: Look at `s_chords`. The massive 3-note chords 
#    hit strictly on steps 2, 6, 10, and 14. In a 16-step grid, these are the 
#    exact midpoints between the kicks. The engine's strict master clock locks 
#    these stabs perfectly between the continuous 16th-note bass, creating a 
#    massive, bouncing "boom-cha" groove.
#
# 3. Glassy FM Arpeggios: The `s_lead` sequence uses `divisor: 3` and `depth: 1`. 
#    This gentle harmonic ratio produces a clean, glassy, sine-like wave that 
#    perfectly mimics the pristine triangle/square arpeggios of late 90s pop. 
#    Routed through the tape echo, the sparse notes cascade across the empty 
#    space, creating a high-energy, radio-ready soundscape.
# ==========================================================
