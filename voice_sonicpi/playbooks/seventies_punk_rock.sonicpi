# ==========================================================
# PLAYBOOK: 70s PUNK ROCK / 77 UK STYLE
# (Pioneered by The Ramones, Sex Pistols, and The Clash)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 70s Punk Rock.
# We have explored heavy metal and stadium rock, but 70s Punk is the 
# sound of raw, rebellious minimalism. It strips away all technical 
# virtuosity and relies on a frantic, driving 4/4 beat, continuous 8th-note 
# "root-only" bass, and buzzsaw power chords played at blistering speeds. 
#
# This playbook perfectly demonstrates how to use a purely electronic 
# engine to simulate a raw, live punk rock trio. By using the `:play_fm` 
# synth with extreme `depth` to simulate a distorted guitar, and the 
# `:play_sub` synth to play driving, continuous 8th notes, the engine 
# creates a high-energy, chaotic, and undeniably catchy punk atmosphere.
# ==========================================================

use_bpm 180

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Major - Fast, Raw, & Aggressive)
# =========================================================

# Frantic, driving 4/4 punk kick. Hits on 1, 2, 3, and 4.
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, dry snare strictly on beats 2 and 4.
s_snare = gen_score("....x.......x...", [:c4])

# Fast, driving 8th hats. 
s_hats = gen_score("x.x.x.x.x.x.x.x.", [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}])

# The "Root-Only" Bass (A Major).
# Plays continuous, driving 8th notes. High cutoff (100) and short release (0.1) 
# create a punchy, aggressive picked bass.
bass_notes = [:a1, :a1, :a1, :a1, :d1, :d1, :d1, :d1, 
              :e1, :e1, :e1, :e1, :d1, :d1, :d1, :d1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 100, release: 0.1, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# The "Buzzsaw" Power Chords (A5 to D5 to E5).
# Uses :play_fm with a low divisor (2) and extreme depth (5) to create a 
# sharp, buzzy square wave that mimics a heavily distorted electric guitar.
# Hits only on beats 1 and 3 to let the bass drive the rhythm.
s_chords = gen_score("x.......x.......", [
  {note: [:a3, :e4], divisor: 2, depth: 5, release: 0.3, amp: 0.7},
  {note: [:e3, :b3], divisor: 2, depth: 5, release: 0.3, amp: 0.7}
])

# Piercing, "Lead Guitar Lick" (A Major Pentatonic).
# Uses :play_fm with a high divisor (3) and extreme depth (4) to create a 
# piercing, distorted lead that cuts through the heavy mix.
lead_notes = [:a4, :b4, :cs5, :e5, :cs5, :b4, :a4, :e4]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 4, release: 0.1} }
s_lead = gen_score("x.x.x.x.x.x.x.x.", lead_data)

# Raw, "Shouted" Vocal (Granular Synth).
# Long size (0.08) and low density (1) creates a raw, repetitive vocal hit 
# that mimics a gang shout.
s_vocal = gen_score("........x.......", [
  {note: :a3, buffer: :misc_lori, pos: 0.2, density: 1, size: 0.08, amp: 0.8}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Jam - Just the frantic drums, driving bass, and power chords (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_fm, s_chords, 4] ],
  
  # Scene 2: The Vibe - Add the raw shouted vocals (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Solo - The piercing lead guitar lick drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN RAW ENERGY]
# 
# 1. FM as a Buzzsaw Amp: Look at `s_chords`. The `:play_fm` synth is given 
#    a `divisor` of `2` and an extreme `depth` of `5`. This harsh harmonic 
#    ratio forces the FM modulator to shatter the carrier wave, creating a 
#    piercing, buzzy square wave that perfectly mimics a heavily distorted 
#    electric guitar playing power chords.
#
# 2. The "Root-Only" Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    every 8th note, mapping out a simple, root-only line. By using a high 
#    `cutoff` (100) and a very short `release` (0.1), the engine turns the 
#    detuned sawtooth into a punchy, aggressive "thwack" that perfectly 
#    mimics a picked electric bass guitar driving the rhythm, a hallmark of 
#    70s punk rock.
#
# 3. The 8th-Note Drive: 70s Punk relies on a stark, driving rhythm section. 
#    The `s_hats` play straight 8th notes, and the `s_kick` hits on every beat 
#    (steps 0, 4, 8, 12). The engine's strict master clock ensures this rigid, 
#    mechanical momentum locks perfectly with the continuous 8th-note bassline, 
#    creating a high-energy, forward-driving punk groove.
# ==========================================================
