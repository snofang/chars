# ==========================================================
# PLAYBOOK: 90s SHIBUYA-KEI / JAPANESE INDIE POP
# (Pioneered by Cornelius, Pizzicato Five, and Flipper's Guitar)
# ==========================================================
# 
# [WHY THIS GENRE?]
# We have explored City Pop (which is laid-back and pristine) and 16-Bit JRPGs 
# (which are epic and melodic). Shibuya-Kei is the sound of 90s Tokyo's trendiest 
# district. It is a highly eclectic, stylish fusion of 60s pop, bossa nova, jazz, 
# and electronic sampling. It relies on a driving, live 4/4 beat, a walking 
# upright bass, lush, jazzy electric piano chords, and bright, plucky 
# marimba/celesta counter-melodies that feel like browsing through a brightly lit 
# vintage record store.
#
# [THE CAREFULLY DESCRIBED DNA]
# 1. Tempo: 118 BPM. A driving, upbeat, and stylish pace.
# 2. Harmonic Center: F Major. Warm, jazzy, and sophisticated.
# 3. Rhythmic Skeleton: A driving, live 4/4 pop kick. Crisp, dry snare on 2 
#    and 4. Fast, bouncing 16th hats.
# 4. Timbral Palette:
#    - Bass: "Walking" upright bass (mid cutoff, short percussive release).
#    - Chords: Lush, jazzy electric piano (FM, high divisor, low depth).
#    - Lead: Bright, "marimba/celesta" counter-melody (FM, high divisor, low depth).
#    - Texture: "Ahh" vocal sample (Granular, pitched up, tiny size).
# 5. Arrangement: Intro (Bass/Chords) -> Verse (Drums) -> Chorus (Marimba).
# ==========================================================

use_bpm 118

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F Major - Jazzy, Bright, & Eclectic)
# ==========================================================

# Driving, live 4/4 pop kick. (4 x's, 4 elements)
s_kick = gen_score("x...x...x...x...", [:c4, :c4, :c4, :c4])

# Crisp, dry snare strictly on beats 2 and 4. (2 x's, 2 elements)
s_snare = gen_score("....x.......x...", [:c4, :c4])

# Fast, bouncing 16th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.15}
])

# The "Walking" Upright Bass (F Major).
# Plays a fast, melodic, walking line. 
# Mid cutoff (80) and short release (0.15) create a warm, percussive "thwack".
# (8 x's, 8 elements)
bass_notes = [:f1, :a1, :c2, :f1, :bb1, :a1, :g1, :c2]
bass_data = bass_notes.map { |n| {note: n, cutoff: 80, release: 0.15, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# Lush, "Electric Piano" Chords (Fmaj9 to Gm9).
# Hit strictly on the off-beats. The slow 0.2-beat attack and massive 1.5-beat 
# release blur the chords together into a continuous, warm, jazzy wave. 
# (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:f3, :a3, :c4, :e4], divisor: 3, depth: 2, attack: 0.2, release: 1.5, amp: 0.5},
  {note: [:f3, :a3, :c4, :e4], divisor: 3, depth: 2, attack: 0.2, release: 1.5, amp: 0.5},
  {note: [:g2, :bb2, :d4, :f4], divisor: 3, depth: 2, attack: 0.2, release: 1.5, amp: 0.5},
  {note: [:g2, :bb2, :d4, :f4], divisor: 3, depth: 2, attack: 0.2, release: 1.5, amp: 0.5}
])

# Bright, "Marimba/Celesta" Counter-Melody (F Major Pentatonic).
# Uses :play_fm with a high divisor (4) and low depth (2) to create a pristine, 
# glassy, sine-like wave. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:f5, :a5, :c6, :d6, :c6, :a5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 4, depth: 2, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Ahh" Vocal Sample (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched UP.
# High density, tiny size = a sharp, sugary, pristine vocal skip. (1 x, 1 element)
s_vocal = gen_score("........x.......", [
  {note: :f4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Jam - Just the walking bass, lush chords, and vocal skip (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Vibe - Add the driving, live 4/4 pop drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Solo - The bright marimba counter-melody drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN JAZZ-POP SOPHISTICATION]
# 
# 1. FM as a Marimba: Look at `s_lead`. The `:play_fm` synth is given a high 
#    `divisor` (4) and a low `depth` (2). This gentle harmonic ratio produces a 
#    pristine, glassy, sine-like wave that perfectly mimics a marimba or celesta. 
#    Routed through the tape echo, the sparse notes cascade across the empty 
#    space, creating a bright, eclectic hook that defined the Shibuya-Kei sound.
#
# 2. The Walking Upright Bass: Look at `s_bass`. The `:play_sub` synth plays 
#    on every 8th note, mapping out a fast, walking line. By using a mid-range 
#    `cutoff` (80) and a short `release` (0.15), the engine turns the detuned 
#    sawtooth into a warm, percussive "thwack" that perfectly mimics a plucked 
#    upright bass driving the rhythm.
#
# 3. Lush Jazzy Harmony: Look at `s_chords`. The arrays form lush 4-note major 9th 
#    and minor 9th chords. By hitting strictly on the off-beats (steps 2, 6, 10, 14) 
#    with a slow `attack` (0.2), the engine turns the `:blade` synth into a warm, 
#    muffled electric piano that perfectly mimics the lush, wide-stereo 
#    arrangements of 90s Japanese indie pop.
# ==========================================================
