# ==========================================================
# PLAYBOOK: 80s JAPANESE AMBIENT / KANKYO ONGAKU
# (Pioneered by Hiroshi Yoshimura, Midori Takada, and Satoshi Ashikawa)
# ==========================================================
# 
# [WHY THIS GENRE?]
# We have explored fast, chaotic extremes (Grindcore, Extratone) and dense, 
# atmospheric extremes (Dark Ambient, Drone Metal). Kankyo Ongaku 
# ("Environmental Music") is the sound of 80s Japanese minimalism. It was 
# designed to blend with nature. It relies on extreme negative space, soft, 
# glassy FM bells (like the Yamaha DX7), and massive, slow-attacking granular 
# textures. The engine captures a feeling of stepping into an empty, pristine 
# zen garden.
#
# [THE CAREFULLY DESCRIBED DNA]
# 1. Tempo: 60 BPM. Glacial, breathing, and still.
# 2. Harmonic Center: D Major. Calm, pristine, and spacious.
# 3. Rhythmic Skeleton: Ultra-sparse. A soft kick once per bar. A shaker 
#    occasionally. The grid is mostly empty (`nil`).
# 4. Timbral Palette:
#    - Bass: Deep, warm drone bass (extreme low cutoff, massive release).
#    - Chords: Slow-attacking, lush string pads (extreme attack/release).
#    - Lead: Pristine, glassy "water droplet" FM bells (high divisor, long release).
#    - Texture: Granular "garden" texture (long grain size, low density).
# 5. Arrangement: Intro (Bass/Texture) -> Verse (Sparse Drums) -> Chorus (Bells).
# ==========================================================

use_bpm 60

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Major - Calm, Pristine, & Spacious)
# ==========================================================

# Ultra-sparse, soft kick. Hits only once per bar on step 0. (1 x, 1 element)
s_kick = gen_score("x...............", [
  {note: :c4, amp: 0.5}
])

# Very sparse, organic shaker. (2 x's, 2 elements)
s_hats = gen_score("......x.......x.", [
  {note: :c4, amp: 0.1}, {note: :c4, amp: 0.15}
])

# Deep, warm drone bass (D Major).
# Hits once and rings out for the entire scene (8 bars = 32 beats).
# Extreme low cutoff (60) and massive release (32.0) create a heavy, 
# continuous undercurrent. (1 x, 1 element)
s_bass = gen_score("x...............", [
  {note: :d1, release: 32.0, cutoff: 60, amp: 0.8}
])

# Massive, slow-attacking "String Synth" Chords (Dmaj9 to Amaj7).
# Hit on the downbeats. The slow 2.0-beat attack and massive 4.0-beat release 
# blur the chords together into a continuous, warm wave. (2 x's, 2 elements)
s_chords = gen_score("x.......x.......", [
  {note: [:d3, :f3, :a3, :e4], cutoff: 80, attack: 2.0, release: 4.0, amp: 0.4},
  {note: [:a2, :c3, :e3, :b3], cutoff: 80, attack: 2.0, release: 4.0, amp: 0.4}
])

# Soft, "Water Droplet" FM Bells (D Major Pentatonic).
# Uses :play_fm with a high divisor (3) and low depth (1) to create a soft, 
# glassy, sine-like wave. Routed through the global tape echo. (3 x's, 3 elements)
s_fm = gen_score("..x.....x.....x.", [
  {note: :d5, amp: 0.4, divisor: 3, depth: 1, release: 4.0}, 
  {note: :a4, amp: 0.3, divisor: 3, depth: 1, release: 4.0}, 
  {note: :f4, amp: 0.3, divisor: 3, depth: 1, release: 4.0}
])

# Lush, granular "Garden" texture (using :ambi_choir buffer).
# Massive size (0.5s) and low density (1) time-stretches the sample into a 
# slow, evolving background drone that sounds like wind chimes or water.
# (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :d4, buffer: :ambi_choir, pos: 0.1, density: 1, size: 0.5, amp: 0.4}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Garden - Just the drone bass, sweeping chords, and texture (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Rain - Add the ultra-sparse, organic drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Stillness - The water droplet FM bells drop (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_hats, s_hats, 8], 
    [:play_fm, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN TRANQUILITY]
# 
# 1. Extreme Negative Space: Kankyo Ongaku relies on what you *don't* play. 
#    90% of the `s_kick`, `s_hats`, and `s_fm` grids are `nil`. The engine 
#    honors these rests perfectly, letting the massive release tails of the 
#    chords and bass ring out into the void, creating a slow, breathing 
#    atmosphere that feels like stepping into an empty zen garden.
#
# 2. Data-Driven Swells: Look at `s_chords`. The Hashes specify an `attack` 
#    of `2.0` and a `release` of `4.0`. Because the engine reads these 
#    Hashes, the chords don't just hit; they slowly swell into the mix and 
#    fade away over six whole beats, creating a continuous, blurred wave 
#    of warm harmony.
#
# 3. Granular Water: The `s_grain` sequence uses a massive `size` of `0.5` 
#    (500 milliseconds). By time-stretching the `:ambi_choir` sample to half a 
#    second per grain, the engine turns the sample into a slow, evolving drone 
#    that sounds more like wind chimes or flowing water than a synthesizer, 
#    perfectly anchoring the track's environmental aesthetic.
# ==========================================================
