# ==========================================================
# PLAYBOOK: 2000s SYMPHONIC METAL / GOTHIC METAL
# (Pioneered by Nightwish, Within Temptation, and Epica)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 2000s Symphonic Metal.
# We have explored Speed Metal and Black Metal, but Symphonic Metal is the 
# sound of high-fantasy, classical grandeur fused with heavy metal aggression. 
# It relies on a blistering, "galloping" double-kick drum beat, a driving, 
# continuous 8th-note bass, massive, distorted power chords, and lush, 
# slow-attacking "string section" chords that swell like a cinematic orchestra.
#
# This playbook perfectly demonstrates how to combine extreme rhythmic 
# aggression with lush, cinematic atmosphere. By using the `:play_fm` synth 
# with extreme `depth` for distorted chords, and pairing it with massive 
# `attack`/`release` Hashes on the `:play_chords` synth, the engine creates 
# a massive, theatrical, and deeply epic atmosphere.
# ==========================================================

use_bpm 140

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Epic, Driving, & Cinematic)
# ==========================================================

# The "Double Kick" Drum. 
# A blistering, syncopated 16th-note gallop. (5 x's, 5 elements)
s_kick = gen_score("x..x..x.x..x....", [
  :c4, :c4, :c4, {note: :c4, amp: 0.7}, :c4
])

# Heavy, echoing snare strictly on beats 2 and 4. (2 x's, 1 element)
s_snare = gen_score("....x.......x...", [:c4])

# Fast, driving 16th hats to add to the chaotic wall of sound. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Galloping" Bass (A Minor).
# Plays continuous, driving 8th notes. High cutoff (100) and short release (0.1) 
# create a punchy, aggressive "thwack" that mimics a picked electric bass. (8 x's, 8 elements)
bass_notes = [:a1, :a1, :a1, :a1, :f1, :f1, :g1, :g1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 100, release: 0.1, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# Massive, "Distorted" Power Chords (A5 to F5 to G5).
# Uses :play_fm with a low divisor (2) and extreme depth (6) to create a harsh, 
# grinding hit. Plays a classic, palm-muted metal riff. (3 x's, 3 elements)
s_chords = gen_score("x.....x...x.....", [
  {note: [:a3, :e4], divisor: 2, depth: 6, release: 0.15, amp: 0.7},
  {note: [:f3, :c4], divisor: 2, depth: 6, release: 0.15, amp: 0.7},
  {note: [:g3, :d4], divisor: 2, depth: 6, release: 0.15, amp: 0.7}
])

# Lush, "String Section" Chords (Am to Fmaj to Gmaj).
# Hit on the downbeats. The slow 1.0-beat attack and massive 3.0-beat release 
# blur the chords together into a continuous, cinematic orchestral wave. 
# (2 x's, 2 elements)
s_strings = gen_score("x.......x.......", [
  {note: [:a3, :c4, :e4, :g4], cutoff: 80, attack: 1.0, release: 3.0, amp: 0.5},
  {note: [:g3, :bb3, :d4, :f4], cutoff: 80, attack: 1.0, release: 3.0, amp: 0.5}
])

# Piercing, "Shredding" Guitar Solo (A Minor Pentatonic).
# Uses :play_lead routed through the global tape echo bus. The long release (0.2) 
# and rapid, 8th-note melody create a soaring, virtuosic solo. (6 x's, 6 elements)
lead_notes = [:a5, :c6, :e6, :g6, :e6, :c6]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, cutoff: 110, release: 0.2} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# Ethereal, "Choir" vocal drone (Granular Synth).
# Pitched UP to :a4. Long size (0.4) and low density (1) creates a slow, 
# evolving background texture that mimics a massive classical choir. (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :a4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.4, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Overture - Just the galloping bass, strings, and choir (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_strings, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Battle - Add the double kick drums and power chords (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_strings, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_fm, s_chords, 8] ],
    
  # Scene 3: The Climax - The piercing shredding guitar solo drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_strings, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_fm, s_chords, 8], [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN CINEMATIC METAL]
# 
# 1. The Orchestral Swell: Look at `s_strings`. The Hashes specify an `attack` 
#    of `1.0` and a `release` of `3.0`. Because the engine reads these 
#    Hashes, the chords don't just hit; they slowly swell into the mix and 
#    fade away over four whole beats, creating a continuous, blurred wave 
#    of warm harmony that perfectly mimics a lush, cinematic string section 
#    soaring over a heavy metal band.
#
# 2. FM as a Distorted Amp: Look at `s_chords`. The `:play_fm` synth is 
#    given a `divisor` of `2` and an extreme `depth` of `6`. This harsh 
#    harmonic ratio forces the FM modulator to grind the carrier wave, 
#    creating a harsh, distorted square wave. By playing a palm-muted, 
#    galloping riff, the engine perfectly mimics the aggressive rhythm 
#    guitars of Symphonic Metal.
#
# 3. The Double Kick Gallop: Look at `s_kick`. It plays a blistering, 
#    syncopated 16th-note pattern that perfectly mimics the legendary 
#    "double kick" drumming of extreme metal. The engine's strict master 
#    clock ensures this chaotic rhythm lands with absolute mathematical 
#    precision, creating a massive, mechanical wall of percussion that 
#    anchors the soaring orchestra.
# ==========================================================
