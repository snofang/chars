# ==========================================================
# PLAYBOOK: 2000s KUDURO / ANGOLAN ELECTRONIC
# (Pioneered by Buraka Som Sistema, DJ Znobia, and M.I.A.)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 2000s Kuduro.
# We have explored Singeli and Gqom, but Kuduro is the sound of 
# 2000s Luanda, Angola. It translates to "hard ass" and is a relentless, 
# chaotic, and highly energetic fusion of traditional African percussion, 
# rigid 4/4 techno, and heavy Caribbean rhythms. It relies on a frantic, 
# syncopated drum machine pattern, massive, booming carnival bass, and 
# high-pitched, piercing "siren" synth leads. 
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create a massive, polyrhythmic carnival atmosphere. By locking a 
# syncopated kick and snare to a continuous, rapid 16th-note synth lead, 
# the engine creates a high-energy, unstoppable dancefloor groove.
# ==========================================================

use_bpm 140

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Frantic, Carnival, & Booming)
# ==========================================================

# The "Kuduro" Kick. 
# Highly syncopated, rapid-fire 808 pattern.
s_kick = gen_score("x..x..x.x..x..x.", [
  :c4, {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.8}, :c4, {note: :c4, amp: 0.6}
])

# Heavy, dry snare on beats 2 and 4, with a frantic roll on the 'and' of 3.
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.4}, {note: :c4, amp: 0.9}
])

# Fast, relentless 16th shaker to drive the momentum.
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}, 
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2}
])

# Massive, booming "Carnival" Bass (A Minor).
# Plays a driving, syncopated line. Low cutoff (60) and massive release (0.5) 
# to create a deep, rumbling undercurrent.
s_bass = gen_score("x.....x...x.....", [
  {note: :a1, release: 0.5, cutoff: 60, amp: 1.2}, 
  {note: :g1, release: 0.5, cutoff: 60, amp: 1.0}, 
  {note: :f1, release: 0.5, cutoff: 60, amp: 1.0}
])

# Stark, "Brass/Synth" Stabs (Am to G).
# Uses :play_fm with a low divisor (2) and mid depth (3) to create a sharp, 
# aggressive hit that cuts through the heavy mix.
s_chords = gen_score("..x.....x.....x.", [
  {note: [:a3, :c4, :e4], divisor: 2, depth: 3, release: 0.15, amp: 0.5},
  {note: [:g3, :bb3, :d4], divisor: 2, depth: 3, release: 0.15, amp: 0.5}
])

# Piercing, "Siren" Synth Lead (A Minor Pentatonic).
# Uses :play_fm with a high divisor (4) and low depth (2) to create a clean, 
# piercing tone. Plays a rapid, continuous 16th-note melody.
lead_notes = [:a5, :e5, :c6, :e5, :a5, :g5, :e5, :c5, 
              :a5, :e5, :c6, :e5, :a5, :g5, :e5, :c5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 4, depth: 2, release: 0.08} }
s_lead = gen_score("x.x.x.x.x.x.x.x.", lead_data)

# Pitched-up, "Carnival" vocal chant (Granular Synth).
# High density, tiny size = a sharp, sugary vocal skip.
s_vocal = gen_score("....x.......x...", [
  {note: :a4, buffer: :misc_lori, pos: 0.1, density: 3, size: 0.04, amp: 0.6},
  {note: :c5, buffer: :misc_lori, pos: 0.3, density: 3, size: 0.04, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Streets - Just the syncopated drums and carnival bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Parade - Add the brass stabs and vocal chants (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drop - The piercing siren lead drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN CARNIVAL CHAOS]
# 
# 1. The Syncopated 808: Look at `s_kick`. It completely avoids landing on 
#    a standard 4/4 pulse. By hitting on rapid, syncopated steps (0, 3, 6, 8, 11, 14), 
#    the engine creates a lopsided, frantic groove that feels like a live 
#    percussionist playing a traditional Angolan carnival rhythm. The engine's 
#    strict master clock ensures this complex rhythm lands with absolute precision.
#
# 2. FM as a Siren: The `s_lead` sequence uses `divisor: 4` and `depth: 2`. 
#    This harmonic ratio produces a piercing, glassy tone. By playing a rapid, 
#    continuous 16th-note melody, the engine creates a frantic, high-energy hook 
#    that cuts through the massive bass and drums like a police siren.
#
# 3. Booming Carnival Bass: Look at `s_bass`. The `:play_sub` synth is given a 
#    `release` of `0.5` and a very low `cutoff` of `60`. This creates a deep, 
#    rumbling low-end that carries the melody, providing immense weight without 
#    muddying the pristine high-end of the shaker and siren lead.
# ==========================================================
