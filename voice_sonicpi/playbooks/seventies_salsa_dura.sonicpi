# ==========================================================
# PLAYBOOK: 70s SALSA DURA / FANIA RECORDS
# (Pioneered by Willie Colón, Héctor Lavoe, and Eddie Palmieri)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# Salsa Dura is built on interlocking Afro‑Cuban percussion
# (Clave, Congas, Cowbell) and a syncopated piano “Montuno”.
# This playbook uses FM synthesis to simulate live cowbell
# and congas, maps the 3‑2 Son Clave to the 16‑step grid,
# and pairs it with a Tumbao bass to create a relentless,
# high‑energy Latin dance groove.
# ==========================================================

use_bpm 100

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores

# Tumbao Bass – hits on the 'and' of 2 (step 6) and beat 4 (step 12)
s_bass = gen_score("......x.....x...", [
  {note: :c2, release: 0.2, cutoff: 70, amp: 0.9},
  {note: :g1, release: 0.2, cutoff: 70, amp: 0.9}
])

# Campana (Cowbell) – steady 8th‑note pattern with dynamic accents
s_cowbell = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c5, amp: 0.5, divisor: 4, depth: 1, release: 0.05},
  {note: :c5, amp: 0.3, divisor: 4, depth: 1, release: 0.05},
  {note: :c5, amp: 0.5, divisor: 4, depth: 1, release: 0.05},
  {note: :c5, amp: 0.3, divisor: 4, depth: 1, release: 0.05},
  {note: :c5, amp: 0.5, divisor: 4, depth: 1, release: 0.05},
  {note: :c5, amp: 0.3, divisor: 4, depth: 1, release: 0.05},
  {note: :c5, amp: 0.5, divisor: 4, depth: 1, release: 0.05},
  {note: :c5, amp: 0.3, divisor: 4, depth: 1, release: 0.05}
])

# Congas – woody hits on the downbeats of each group of 4
s_congas = gen_score("x...x...x...x...", [
  {note: :c4, amp: 0.6, divisor: 4, depth: 2, release: 0.1},
  {note: :e4, amp: 0.5, divisor: 4, depth: 2, release: 0.1},
  {note: :g4, amp: 0.7, divisor: 4, depth: 2, release: 0.1},
  {note: :e4, amp: 0.5, divisor: 4, depth: 2, release: 0.1}
])

# Maracas/Güiro – continuous shaking rhythm with varying dynamics
s_shaker = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.3}
])

# Montuno Piano – syncopated stabs (Cm, Cm, Fm, Fm)
s_chords = gen_score(".x..x....x..x...", [
  [:c3, :eb3, :g3],
  [:c3, :eb3, :g3],
  [:f3, :ab3, :c4],
  [:f3, :ab3, :c4]
])

# Vocal Soneo – improvised phrasing on the off‑beats
s_vocal = gen_score("........x.....x.", [
  {note: :c4, buffer: :ambi_choir, pos: 0.1, density: 2, size: 0.05, amp: 0.6},
  {note: :eb4, buffer: :ambi_choir, pos: 0.3, density: 2, size: 0.05, amp: 0.6}
])

# Playbook
playbook = (ring
  # Scene 1: The Descarga – interlocking percussion and bass (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_cowbell, 4], [:play_fm, s_congas, 4], [:play_hats, s_shaker, 4] ],
  
  # Scene 2: The Montuno – add syncopated piano (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_cowbell, 8], [:play_fm, s_congas, 8], [:play_hats, s_shaker, 8],
    [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Soneo – lead vocal improvisation drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_cowbell, 8], [:play_fm, s_congas, 8], [:play_hats, s_shaker, 8],
    [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - FM with divisor 4 and tiny release turns the synth into a
#   sharp, metallic cowbell and hollow, woody congas.
# - The Tumbao bass hits only on the ‘and’ of 2 and beat 4,
#   creating the signature syncopated swing of Salsa.
# - The Montuno piano weaves stabs on steps 1,4,9,12 – locking
#   with the clave and driving the relentless Afro‑Cuban groove.
# ==========================================================
