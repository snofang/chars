# ==========================================================
# PLAYBOOK: 90s BLEEP & BASS / YORKSHIRE TECHNO
# (Pioneered by LFO, Unique 3, and Sweet Exorcist)
# ==========================================================
# [WHY THIS GENRE?]
# Bleep & Bass bridges Detroit Techno and UK Rave – massive
# wobbling "Reese" sub‑bass with high‑pitched 8‑bit FM bleeps.
# This playbook uses a continuous low‑end anchor and cold,
# digital square‑wave melodies reminiscent of Commodore 64.
# [DNA: 120 BPM, E minor, 4/4 kick, off‑beat hats, Reese bass,
#  8‑bit FM bleeps, stark chords, robotic granular vocal chants]
# ==========================================================

use_bpm 120

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# ----------------------------------------------------------
# SCORES – Normalized with gen_score – behavior identical to original
# ----------------------------------------------------------

# Relentless 4/4 kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy 909 clap on beats 2 and 4
s_clap = gen_score("....x.......x...", [:c4])

# Rigid off‑beat open hats – steps 2,6,10,14
s_hats = gen_score("..x...x...x...x.",
  [{note: :c4, amp: 0.4}, {note: :c4, amp: 0.5},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}])

# Reese bass – massive continuous rumble, low cutoff, long release
s_bass = gen_score("x.......x.......",
  [{note: :e1, release: 1.0, cutoff: 60},
   {note: :g1, release: 1.0, cutoff: 60}])

# 8‑bit bleep melody – piercing hollow square wave (divisor 4, depth 1)
s_fm = gen_score("..x...x...x...x.",
  [{note: :e5, amp: 0.6, divisor: 4, depth: 1, release: 0.1},
   {note: :b4, amp: 0.5, divisor: 4, depth: 1, release: 0.1},
   {note: :g5, amp: 0.6, divisor: 4, depth: 1, release: 0.1},
   {note: :a5, amp: 0.5, divisor: 4, depth: 1, release: 0.1}])

# Stark minor chords – off‑beats (same pattern as hats)
s_chords = gen_score("..x...x...x...x.",
  [[:e3, :g3, :b3],
   [:e3, :g3, :b3],
   [:e3, :g3, :b3],
   [:e3, :g3, :b3]])

# Robotic vocal chant – pitched down, percussive granular hits
s_vocal = gen_score("x.......x.......",
  [{note: :e3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.04, amp: 0.7},
   {note: :e3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.04, amp: 0.7}])

# ----------------------------------------------------------
# PLAYBOOK – In‑line and readable
# ----------------------------------------------------------
playbook = (ring
  # Scene 1 – The Void: kick, Reese bass, and 8‑bit bleeps (4 bars)
  [ [:play_kick, s_kick, 4],
    [:play_sub, s_bass, 4],
    [:play_fm, s_fm, 4] ],

  # Scene 2 – The Groove: add claps, hats, and chords (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_sub, s_bass, 8],
    [:play_fm, s_fm, 8],
    [:play_snare, s_clap, 8],
    [:play_hats, s_hats, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3 – The Drop: robotic vocal chants enter (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_sub, s_bass, 8],
    [:play_fm, s_fm, 8],
    [:play_snare, s_clap, 8],
    [:play_hats, s_hats, 8],
    [:play_chords, s_chords, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# 1. Reese Bass – release 1.0 and cutoff 60 create a continuous
#    low‑end rumble that anchors the track behind the bleeps.
# 2. 8‑Bit Bleep – divisor 4, depth 1 produce a hollow square
#    wave, the signature sound of Commodore 64 and the genre.
# 3. Robotic Granular – pitching down and using tiny size (0.04)
#    turns vocals into sharp, percussive chants that lock with the kick.
# ==========================================================
