# ==========================================================
# PLAYBOOK: 2010s CHILLWAVE / GLO-FI
# (Pioneered by Washed Out, Neon Indian, and Toro y Moi)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose Chillwave / Glo-Fi.
# We have explored pristine pop and heavy bass music. Chillwave is the 
# sound of warped cassette tapes and hazy summer nostalgia. It takes the 
# 16-step grid, slows it down, heavily muffles the synths (low `cutoff`), 
# and uses slow, swelling chords and echoing, lo-fi drum machines.
#
# This playbook perfectly demonstrates how to simulate tape saturation 
# and lo-fi warmth purely via data. By using low `cutoff` values and long 
# `attack`/`release` times, the engine creates a warm, hazy wall of sound 
# that feels like listening to a dream through a busted boombox.
# ==========================================================

use_bpm 95

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (E Major - Warm, Hazy, & Nostalgic)
# ==========================================================

# Soft, muffled 4/4 kick. Lower amplitude for a gentle pulse.
s_kick  = (ring {:note => :c4, :amp => 0.7}, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil, {:note => :c4, :amp => 0.7}, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil)

# Crisp, lo-fi snare strictly on beats 2 and 4 (steps 4 and 12).
s_snare = (ring nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil)

# Slow, echoing 8th hats. Notice the low amplitudes.
s_hats  = (ring {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.25}, nil, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.25}, nil, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.25}, nil, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.25}, nil)

# Warm, muffled sub-bass (E Major).
# Very low cutoff (70) and medium release to create a hazy undercurrent.
s_bass  = (ring {:note => :e2, :cutoff => 70, :release => 0.4}, nil, nil, nil, nil, nil, nil, nil, {:note => :a2, :cutoff => 70, :release => 0.4}, nil, nil, nil, nil, nil, nil, nil)

# Lush, swelling Major 9th chords (Emaj9 to Amaj7).
# Hit on the downbeats. The low cutoff (75) and slow 0.5-beat attack 
# blur the chords together into a continuous, warm wave.
s_chords= (ring {:note => [:e3, :g3, :b3, :d4], :cutoff => 75, :attack => 0.5, :release => 2.0, :amp => 0.7}, nil, nil, nil, nil, nil, nil, nil, {:note => [:a2, :c3, :e3, :g3], :cutoff => 75, :attack => 0.5, :release => 2.0, :amp => 0.7}, nil, nil, nil, nil, nil, nil, nil)

# Soft, wobbly "Analogue" Melody (E Major Pentatonic).
# Uses :play_fm with a low divisor (2) and depth (1) to create a soft, 
# sine-like wave. Routed through the engine's tape echo for a cascading smear.
s_fm    = (ring nil, nil, nil, nil, {:note => :e5, :amp => 0.5, :divisor => 2, :depth => 1, :release => 0.8}, nil, nil, nil, nil, nil, nil, nil, {:note => :g5, :amp => 0.4, :divisor => 2, :depth => 1, :release => 0.8}, nil, nil, nil)

# Warped, granular vocal "Ahh" (using :ambi_choir).
# Long size (0.3) and low density (1) creates a slow, evolving background 
# texture that sounds like a distant memory.
s_grain = (ring {:note => :e4, :buffer => :ambi_choir, :pos => 0.4, :density => 1, :size => 0.3, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil, {:note => :a4, :buffer => :ambi_choir, :pos => 0.6, :density => 1, :size => 0.3, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Dream - Just the swelling chords, bass, and vocal pad (4 bars)
  [ [:play_chords, s_chords, 4], [:play_sub, s_bass, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Pulse - Add the muffled lo-fi drums (8 bars)
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Memory - The wobbly analog melody drops (8 bars)
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN HAZY WARMTH]
# 
# 1. Data-Driven Saturation: Look at `s_chords` and `s_bass`. Both 
#    sequences use very low `cutoff` values (70 and 75). In Sonic Pi, 
#    pushing the filter down this hard on a `:dsaw` or `:blade` synth 
#    strips away all the high-frequency harshness, leaving only a warm, 
#    muffled mid-range. This makes the track sound like it is playing 
#    from a worn-out cassette tape.
#
# 2. Swelling Waves: Look at `s_chords`. The Hashes specify an `attack` 
#    of `0.5` and a `release` of `2.0`. Because the engine reads these 
#    Hashes, the chords don't just hit; they slowly swell into the mix 
#    and fade away, creating a continuous, blurred wave of warmth.
#
# 3. Soft FM Bells: The `s_fm` sequence uses `divisor: 2` and `depth: 1`. 
#    This gentle ratio produces a soft, sine-like wave that mimics an 
#    old analog synth. Routed through the tape echo, the sparse notes 
#    cascade across the empty space, perfectly anchoring the track's 
#    nostalgic, dreamlike atmosphere.
# ==========================================================
