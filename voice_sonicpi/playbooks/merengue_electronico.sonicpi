# ==========================================================
# PLAYBOOK: 90s MERENGUE ELECTRÓNICO / "MAMBO"
# (Pioneered by Wilfrido Vargas, Oro Sólido, and Elvis Crespo)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Merengue Electrónico.
# We have explored Salsa and Cumbia, but Merengue Electrónico is the sound 
# of the 90s Dominican Republic club scene. It fuses the blistering, 
# high-speed tempo of traditional merengue (130 BPM) with electronic 
# synthesizers. It relies on a relentless, continuous 16th-note "Güira" 
# (metal scraper) pattern, a syncopated "Tambora" drum beat, deep, walking 
# bass, and a piercing, rapid-fire alto sax or synth lead.
#
# This playbook perfectly demonstrates how to push the engine's master 
# clock to create a frantic, relentless groove. By locking a continuous 
# 16th-note shaker to a syncopated kick and a rapid, 8th-note synth lead, 
# the engine creates a massive, high-energy Latin dance atmosphere.
# ==========================================================

use_bpm 130

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Minor - Festive, Fast, & Relentless)
# ==========================================================

# The "Tambora" Kick. 
# A syncopated, marching pulse. Hits on step 0, the 'a' of 1 (step 3), 
# beat 3 (step 8), and the 'a' of 3 (step 11).
s_kick = gen_score("x..x....x..x....", [:c4, {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.6}])

# Heavy, dry "Tambora" snare strictly on beats 2 and 4, with a syncopated 
# ghost note on the 'and' of 2 (step 7).
s_snare = gen_score("....x...x.x.....", [:c4, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.9}])

# The "Güira" Shaker.
# Plays continuous 16th notes with heavy amplitude manipulation to simulate 
# the rapid, metallic scraping of a güira.
s_hats = gen_score("xxxxxxxxxxxxxxxx", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}, 
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2}
])

# The "Walking Synth" Bass (D Minor).
# Plays a driving, melodic line. Mid cutoff (90) and short release (0.15) 
# mimic a fast, picked electric bass.
bass_notes = [:d1, :d1, :f1, :d1, :a1, :a1, :g1, :a1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 90, release: 0.15, amp: 1.2} }
s_bass = gen_score("x..x..x.x..x..x.", bass_data)

# Stark, "Brass Section" Stabs (Dm to Gm to A).
# Uses :play_fm with a low divisor (2) and mid depth (3) to create a warm, 
# brassy staccato hit that mimics a live horn section.
s_chords = gen_score("..x.....x.....x.", [
  {note: [:d3, :f3, :a3], divisor: 2, depth: 3, release: 0.15, amp: 0.5},
  {note: [:g2, :bb2, :d3], divisor: 2, depth: 3, release: 0.15, amp: 0.5},
  {note: [:a2, :cs3, :e3], divisor: 2, depth: 3, release: 0.15, amp: 0.5}
])

# Piercing, "Alto Sax" Lead (D Minor Pentatonic).
# Uses :play_fm with a high divisor (4) and low depth (2) to create a clean, 
# piercing tone. Plays a rapid, continuous 8th-note melody.
lead_notes = [:d5, :f5, :a5, :d6, :c6, :a5, :f5, :d5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 4, depth: 2, release: 0.1} }
s_lead = gen_score("x.x.x.x.x.x.x.x.", lead_data)

# "Group Vocals" shout (Granular Synth).
# Long size (0.08) and low density (1) creates a raw, repetitive vocal hit 
# that mimics a crowd shouting "Mambo!".
s_vocal = gen_score("........x.......", [
  {note: :d3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.08, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the Tambora, Güira, and bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Mambo - Add the brass stabs and group vocals (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Solo - The piercing alto sax melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN LATIN MOMENTUM]
# 
# 1. The Güira Illusion: Look at `s_hats`. The hats play continuous 16th 
#    notes at 130 BPM, but the amplitudes swing wildly between 0.15, 0.3, 
#    and 0.4. By emphasizing the off-beats, the engine simulates the rapid, 
#    metallic scraping of a güira, creating a relentless, buzzing wall of 
#    high-frequency energy that drives the track forward unstoppably.
#
# 2. FM as an Alto Sax: The `s_lead` sequence uses `divisor: 4` and `depth: 2`. 
#    This harmonic ratio produces a clean, piercing tone that mimics an 
#    alto saxophone. By playing a rapid, continuous 8th-note melody, the 
#    engine creates a frantic, high-energy hook that perfectly anchors the 
#    fast tempo.
#
# 3. The Tambora Syncopation: Look at `s_kick` and `s_snare`. They completely 
#    avoid landing on a standard 4/4 pulse. By hitting on syncopated, galloping 
#    steps (0, 3, 8, 11), the engine creates a lopsided, marching groove that 
#    feels like a live drummer playing a traditional Dominican tambora, 
#    perfectly bridging the gap between acoustic folk and electronic dance music.
# ==========================================================
