# ==========================================================
# PLAYBOOK: BALLROOM / VOGUE HOUSE
# Fierce, Bouncy, Runway‑Ready Energy
# ==========================================================
# [WHY THIS GENRE?]
# Ballroom / Vogue House (MikeQ, Vjuan Allure) takes the 4/4 grid
# and injects extreme energy – relentless 16th hats, massive claps
# on 2 and 4, syncopated bass, and chopped "Ha" vocal stabs as
# percussion. This playbook captures that fierce, underground
# New York runway vibe.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 128 BPM
# Key: A minor (dark, fierce)
# Rhythm: 4/4 kick with syncopated hit on 'a' of 4, massive clap
# on 2/4, relentless 16th hats with alternating amplitudes for a
# 32nd‑note buzz, syncopated bass, off‑beat minor 9th chords,
# sharp FM lead, percussive granular vocal stabs.
# Timbre: Driving kick (bd_haus with accent), heavy runway clap
# (sn_dolf), buzzing hats (cymbal_closed with amp layers), round
# sub‑bass (dsaw, low cutoff, short release), lush minor chords
# (blade), piercing FM lead (divisor 3, tape echo), percussive
# "Ha" vocal stabs (ambi_choir, high density, tiny size).
# Arrangement: Groove (drums+bass+chords) → Runway (add FM lead)
# → Performance (add vocal chops).
# ==========================================================

use_bpm 128

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Driving kick with a syncopated 16th hit on the 'a' of 4 (step 14)
s_kick = gen_score("x...x...x...x.x.",
  [:c4, :c4, :c4, :c4, {note: :c4, amp: 0.7}])

# Massive runway clap on beats 2 and 4 (steps 4 and 12)
s_clap = gen_score("....x.......x...",
  [{note: :c4, amp: 1.1}, {note: :c4, amp: 1.1}])

# Relentless 16th hats – alternating amplitudes create a 32nd‑note buzz
hat_data = 16.times.map do |i|
  amp = (i.even?) ? 0.3 : 0.15
  # Make the 2nd and 6th? Actually pattern: 0.3,0.15,0.4,0.15 repeat
  # Original: 0.3,0.15,0.4,0.15... so we can create a cycle of 4
  cycle = (i % 4)
  amp = case cycle
        when 0 then 0.3
        when 1 then 0.15
        when 2 then 0.4
        when 3 then 0.15
        end
  {note: :c4, amp: amp}
end
s_hats = gen_score("xxxxxxxxxxxxxxxx", hat_data)

# Syncopated sub‑bass – weaves between kick and clap
s_bass = gen_score("x..x..x.x..x..x.",
  [{note: :a1, release: 0.2, cutoff: 70},
   {note: :a1, release: 0.2, cutoff: 70},
   {note: :c2, release: 0.2, cutoff: 70},
   {note: :e2, release: 0.2, cutoff: 70},
   {note: :e2, release: 0.2, cutoff: 70},
   {note: :g1, release: 0.2, cutoff: 70}])

# Lush minor 9th chord stabs on off‑beats (steps 2,6,10,14)
s_chords = gen_score("..x..x..x..x....",
  [[:a3, :c4, :e4, :g4],
   [:a3, :c4, :e4, :g4],
   [:g3, :bb3, :d4, :f4],
   [:g3, :bb3, :d4, :f4]])

# Piercing FM lead – Vogue synth, routed through tape echo
s_fm = gen_score("x...x.x.....x...",
  [{note: :a5, amp: 0.6, divisor: 3, depth: 2, release: 0.2},
   {note: :e5, amp: 0.5, divisor: 3, depth: 2, release: 0.2},
   {note: :c6, amp: 0.6, divisor: 3, depth: 2, release: 0.2},
   {note: :a5, amp: 0.7, divisor: 3, depth: 2, release: 0.2}])

# Percussive "Ha" vocal stabs – granular as raw percussion
s_vocal = gen_score("x..x...x..x..x..",
  [{note: :a4, buffer: :ambi_choir, pos: 0.1, density: 2, size: 0.03, amp: 0.7},
   {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 2, size: 0.03, amp: 0.5},
   {note: :c5, buffer: :ambi_choir, pos: 0.3, density: 2, size: 0.03, amp: 0.7},
   {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 2, size: 0.03, amp: 0.5},
   {note: :e4, buffer: :ambi_choir, pos: 0.5, density: 2, size: 0.03, amp: 0.7}])

# Playbook
playbook = (ring
  # Scene 1: Groove – Drums, Bass, Chords
  [ [:play_kick, s_kick, 4], [:play_snare, s_clap, 4],
    [:play_hats, s_hats, 4], [:play_sub, s_bass, 4],
    [:play_chords, s_chords, 4] ],

  # Scene 2: Runway – Add FM Lead
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8], [:play_lead, s_fm, 8] ],

  # Scene 3: Performance – Add Vocal Chops
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8], [:play_lead, s_fm, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Percussive vocals: granular stabs (size 0.03, density 2) act
#   as a raw "Ha" percussion – the engine turns vocal samples into
#   rhythmic runway energy.
# - 32nd‑note buzz: alternating hat amplitudes (0.3/0.15/0.4/0.15)
#   create a furious buzzing texture that drives the track.
# - Syncopated pocket: bass weaves between kick and clap, with low
#   cutoff (70) and short release (0.2) for a round, punchy feel.
# ==========================================================
