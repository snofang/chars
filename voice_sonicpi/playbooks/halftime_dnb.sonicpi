# ==========================================================
# PLAYBOOK: 2010s HALFTIME DnB / 170 TRAP (CORRECTED)
# (Pioneered by Spectrasoul, Ivy Lab, and Noisia)
# ==========================================================

use_bpm 170

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Minor - Deep, Atmospheric, & Modern)
# ==========================================================

# The "Half-Time" Kick. 
s_kick = gen_score("x.....x.x.....x.", [
  :c4, {note: :c4, amp: 0.8}, {note: :c4, amp: 0.9}
])

# Crisp, dry snare strictly on beat 3 (step 8).
s_snare = gen_score("........x.......", [:c4])

# Frantic, rolling Trap hats with rising amplitudes.
s_hats = gen_score("x..x..x..x.x.x.x", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3}, 
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}, {note: :c4, amp: 0.3}, 
  {note: :c4, amp: 0.6}, {note: :c4, amp: 0.7}
])

# Deep, "Reese" Sub-Bass (F# Minor).
s_bass = gen_score("x.......x.....x.", [
  {note: :fs1, release: 2.0, cutoff: 50, amp: 1.2}, 
  {note: :a1, release: 1.5, cutoff: 50, amp: 1.0}, 
  {note: :fs1, release: 1.5, cutoff: 50, amp: 1.0}
])

# Stark, "Synth String" Stabs (F#m to Am).
s_chords = gen_score("..x.....x.x.....", [
  {note: [:fs3, :a3, :c4], cutoff: 100, release: 0.15, amp: 0.5},
  {note: [:fs3, :a3, :c4], cutoff: 100, release: 0.15, amp: 0.5},
  {note: [:a3, :c4, :e4], cutoff: 100, release: 0.15, amp: 0.5},
  {note: [:a3, :c4, :e4], cutoff: 100, release: 0.15, amp: 0.5}
])

# Piercing, "Synth Flute" Lead (F# Minor Pentatonic).
lead_notes = [:fs5, :a5, :c6, :a5, :g5, :fs5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, cutoff: 100, release: 0.5} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# Pitched-down, Vocal Stutter (Granular Synth)
# FIXED: Using :ambi_choir instead of :ambi_choir
s_vocal = gen_score("........x.......", [
  {note: :fs3, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Vibe - Just the Reese bass, string stabs, and flute (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_lead, s_lead, 4], 
    [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Groove - Add the half-time trap drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_lead, s_lead, 8], 
    [:play_grain, s_vocal, 8], [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], 
    [:play_hats, s_hats, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
