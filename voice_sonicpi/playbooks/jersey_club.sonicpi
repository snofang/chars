# ==========================================================
# PLAYBOOK: JERSEY CLUB
# Bouncy, Kinetic, Vocal‑Chop Energy
# ==========================================================
# [WHY THIS GENRE?]
# Jersey Club is built on a bouncy, syncopated kick pattern,
# heavy claps, fast swinging hats, booming sub‑bass, staccato
# chords, and signature vocal chops. This playbook captures
# that kinetic, dancefloor energy.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 130 BPM
# Key: G minor (bouncy, kinetic)
# Rhythm: Bouncing kick (0,6,8,14), clap on 2/4, swinging
# 16th hats with dynamic amps, booming bass on downbeats,
# staccato chord stabs, granular vocal chops.
# Timbre: Kick (bd_haus with accents), heavy clap (sn_dolf),
# swinging hats (cymbal_closed with amp layers), sub‑bass
# (dsaw, short release), staccato chords (blade), granular
# vocal chops (ambi_choir).
# Arrangement: Drums+Chords (foundation) → Bass (add booming
# sub) → Vocal (add chopped hook).
# ==========================================================

use_bpm 130

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (G Minor - Bouncy & Kinetic)
# ==========================================================

# The "Bouncing" Kick – hits on 0, 6, 8, 14
s_kick = gen_score("x.....x.x.....x.",
  [ {note: :c4, amp: 1.0},
    {note: :c4, amp: 0.7},
    {note: :c4, amp: 1.0},
    {note: :c4, amp: 0.8} ])

# Heavy clap strictly on beats 2 and 4 (steps 4 and 12)
s_clap = gen_score("....x.......x...", [:c4])

# Fast, swinging 16th hats with dynamic amps
s_hats = gen_score("x.x.x.x.x.x.x.x.",
  [ {note: :c4, amp: 0.3},
    {note: :c4, amp: 0.2},
    {note: :c4, amp: 0.4},
    {note: :c4, amp: 0.3},
    {note: :c4, amp: 0.2},
    {note: :c4, amp: 0.4},
    {note: :c4, amp: 0.3},
    {note: :c4, amp: 0.2} ])

# Booming, punchy sub‑bass – hits on 0, 4, 8, 12
bass_base = {release: 0.3}
bass_notes = [:g1, :g1, :bb1, :d1]
s_bass = gen_score("x...x...x...x...",
  bass_notes.map { |n| bass_base.merge(note: n) })

# Staccato chord stabs (steps 1,6,9,14)
s_chords = gen_score(".x....x..x....x.",
  [ [:g3, :bb3, :d4],
    [:g3, :bb3, :d4],
    [:bb3, :db4, :f4],
    [:d3, :f3, :a3] ])

# Signature vocal chop – steps 2,7,11
s_vocal = gen_score("..x....x..x.....",
  [ {note: :g4, buffer: :ambi_choir, pos: 0.3, density: 3, size: 0.04},
    {note: :bb4, buffer: :ambi_choir, pos: 0.5, density: 3, size: 0.04},
    {note: :d5, buffer: :ambi_choir, pos: 0.7, density: 3, size: 0.04} ])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Drums + Chords (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_clap, 4],
    [:play_hats, s_hats, 4], [:play_chords, s_chords, 4] ],

  # Scene 2: Add Booming Bass (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8],
    [:play_hats, s_hats, 8], [:play_chords, s_chords, 8],
    [:play_sub, s_bass, 8] ],

  # Scene 3: Add Vocal Hook (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8],
    [:play_hats, s_hats, 8], [:play_chords, s_chords, 8],
    [:play_sub, s_bass, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Bouncing kick: off‑beat hits on 6,8,14 create the signature
#   Jersey Club lurch.
# - Swinging hats: dynamic amps (0.3/0.2/0.4) add a kinetic,
#   human feel.
# - Booming bass: short release (0.3) keeps it punchy.
# - Granular vocal chops: short grains (size 0.04) on 2,7,11
#   create the rhythmic vocal stutter.
# ==========================================================
