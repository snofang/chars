# ==========================================================
# PLAYBOOK: MINIMALIST DRONE / PULSATING TEXTURES
# Layered Arpeggios, Syncopated Counterpoint, Deep Foundation
# ==========================================================
# [WHY THIS GENRE?]
# Minimalist Drone builds from repeating patterns – a fast
# arpeggio pulse, a massive underlying drone, and a syncopated
# counter‑melody that weaves between. This playbook captures
# that hypnotic, meditative, evolving tension.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 65 BPM (slow, spacious)
# Key: C major (bright, open)
# Rhythm: Fast arpeggio on every 16th, sparse syncopated layer,
# long sustained pad.
# Timbre: Pluck synth (physical modelling), dark pad
# (dark_ambience), additional pluck layer.
# Arrangement: Pulse (fast arpeggio) → Foundation (add pad)
# → Counterpoint (add syncopated pluck).
# ==========================================================

use_bpm 65

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Fast arpeggio pulse – repeats every 16 steps
s_pluck = gen_score("xxxxxxxxxxxxxxxx", [:c4, :e4, :g4, :c5])

# Syncopated counter‑melody – sparse triggers on steps 4, 8, 12
s_pluck2 = gen_score("....x...x...x...", [:e4, :g4, :e4])

# Massive underlying drone – sustained on step 0
s_pad = gen_score("x...............", [:c3])

# Playbook
playbook = (ring
  # Scene 1: Pulse – Just the fast arpeggio
  [ [:play_pluck, s_pluck, 4] ],

  # Scene 2: Foundation – Add the massive drone
  [ [:play_pluck, s_pluck, 8], [:play_pad, s_pad, 8] ],

  # Scene 3: Counterpoint – Add the syncopated layer
  [ [:play_pluck, s_pluck, 8], [:play_pad, s_pad, 8],
    [:play_pluck, s_pluck2, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The fast arpeggio: repeating every 16th step creates a
#   hypnotic, pulsating foundation that drives the piece.
# - The massive drone: a single sustained C3 provides a deep
#   harmonic anchor, grounding the busy arpeggio.
# - The syncopated counter‑layer: sparse notes on steps 4,8,12
#   create a polyrhythmic tension against the steady pulse.
# - Scene‑based layering: each scene adds a new element,
#   building texture without changing the core material.
# ==========================================================
