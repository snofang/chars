use_bpm 120

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (C Minor - Disco Groove)
# ==========================================================

# Rigid 4-on-the-floor
s_kick  = (ring :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil)

# Clap on the 2 and 4 (steps 4 and 12)
s_clap  = (ring nil, nil, nil, nil, :c4, nil, nil, nil, nil, nil, nil, nil, :c4, nil, nil, nil)

# Open hats on the off-beats
s_hats  = (ring nil, nil, {:note => :c4, :amp => 0.4}, nil, nil, nil, {:note => :c4, :amp => 0.5}, nil, 
           nil, nil, {:note => :c4, :amp => 0.4}, nil, nil, nil, {:note => :c4, :amp => 0.5}, nil)

# The "Pumping" French House Bass. 
# It plays on every 16th step, but notice the 'amp' values in the Hashes!
# The volume dips when the kick hits (steps 0, 4, 8, 12) and swells in between.
# This simulates sidechain compression purely via data!
s_bass  = (ring {:note => :c2, :amp => 0.2}, {:note => :c2, :amp => 0.6}, {:note => :c2, :amp => 1.0}, {:note => :c2, :amp => 0.8}, 
           {:note => :c2, :amp => 0.2}, {:note => :c2, :amp => 0.6}, {:note => :eb2, :amp => 1.0}, {:note => :eb2, :amp => 0.8}, 
           {:note => :eb2, :amp => 0.2}, {:note => :eb2, :amp => 0.6}, {:note => :g2, :amp => 1.0}, {:note => :g2, :amp => 0.8}, 
           {:note => :g2, :amp => 0.2}, {:note => :g2, :amp => 0.6}, {:note => :eb2, :amp => 1.0}, {:note => :eb2, :amp => 0.8})

# Classic disco minor 9th chord stabs on the off-beats
s_chords= (ring nil, nil, nil, nil, [:c3, :eb4, :g4, :bb4], nil, nil, nil, 
           nil, nil, nil, nil, [:f3, :ab4, :c5, :eb5], nil, nil, nil)

# Chopped, funky vocal hook (Granular Synth)
# Using :misc_lori, short size, high density = funky stutter
s_vocal = (ring nil, nil, nil, nil, nil, nil, nil, nil, 
           {:note => :c5, :buffer => :misc_lori, :pos => 0.3, :density => 3, :size => 0.04}, nil, nil, nil, 
           nil, nil, {:note => :eb5, :buffer => :misc_lori, :pos => 0.5, :density => 3, :size => 0.04}, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the drums and the pumping bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_clap, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: Add the disco chord stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The vocal chop drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
