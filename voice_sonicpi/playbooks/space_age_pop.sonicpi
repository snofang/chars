# ==========================================================
# PLAYBOOK: SPACE AGE POP / EXOTICA
# (Pioneered by Martin Denny, Juan García Esquivel, and Les Baxter)
# ==========================================================
# 
# [WHY THIS GENRE?]
# We have explored dark, heavy, and degraded textures (Power Electronics, 
# Grindcore, Lo-Fi House). Space Age Pop is the exact opposite. It is the 
# sound of post-war optimism, cocktail lounges, and imaginary tropical 
# paradises. It relies on a bouncy, syncopated Latin drum beat, a warm, 
# walking upright bass, lush, wide major 9th chords, and the iconic, glassy 
# sound of the vibraphone and marimba.
#
# [THE CAREFULLY DESCRIBED DNA]
# 1. Tempo: 115 BPM. Bouncy, sophisticated, and laid-back.
# 2. Harmonic Center: D Major. Bright, lush, and exotic.
# 3. Rhythmic Skeleton: A syncopated Latin "bossa nova" clave. Kicks on 1 
#    and the 'and' of 2. Cross-stick snares on 2 and 4. Swung shakers.
# 4. Timbral Palette:
#    - Bass: "Walking" upright bass (mid cutoff, short percussive release).
#    - Chords: Lush, wide-stereo Major 9th piano/organ stabs (high cutoff).
#    - Lead: Pristine, glassy vibraphone/marimba melody (high FM divisor).
#    - Texture: Ambient "tiki bird" or room noise (granular, long size).
# 5. Arrangement: Intro (Bass/Chords) -> Groove (Latin Drums) -> Solo (Vibes).
# ==========================================================

use_bpm 115

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Major - Bright, Lush, & Sophisticated)
# ==========================================================

# The "Exotica" Kick. 
# A bouncy, syncopated Latin march. (3 x's, 3 elements)
s_kick = gen_score("x.....x.x.......", [
  :c4, {note: :c4, amp: 0.8}, :c4
])

# Crisp, tight cross-stick/rimshot strictly on beats 2 and 4. (2 x's, 2 elements)
s_snare = gen_score("....x.......x...", [:c4, :c4])

# Swung, bouncing 16th shaker. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.1}
])

# The "Walking" Upright Bass (D Major).
# Plays a bouncy, melodic, root-fifth line. 
# Mid cutoff (80) and short release (0.15) create a warm, percussive "thwack".
# (8 x's, 8 elements)
bass_notes = [:d2, :d2, :e2, :f2, :a2, :a2, :g2, :f2]
bass_data = bass_notes.map { |n| {note: n, cutoff: 80, release: 0.15, amp: 1.0} }
s_bass = gen_score("x...x.x.x.x.....", bass_data)

# Lush, "Lounge Piano" Stabs (Dmaj9 to Gmaj9).
# Hit strictly on the off-beats. High cutoff (100) and short release (0.2) 
# create a sharp, staccato, sophisticated wall of sound. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:d3, :f3, :a3, :e4], cutoff: 100, release: 0.2, amp: 0.5},
  {note: [:d3, :f3, :a3, :e4], cutoff: 100, release: 0.2, amp: 0.5},
  {note: [:g2, :b2, :d3, :a3], cutoff: 100, release: 0.2, amp: 0.5},
  {note: [:g2, :b2, :d3, :a3], cutoff: 100, release: 0.2, amp: 0.5}
])

# Bright, "Vibraphone/Marimba" Lead (D Major Pentatonic).
# Uses :play_fm with a high divisor (4) and low depth (2) to create a pristine, 
# glassy, sine-like wave. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:d5, :a4, :d5, :e5, :fs5, :e5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 4, depth: 2, release: 0.3} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Tiki Bird" / Ambient Room Noise (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched UP.
# Long size (0.2) and low density (1) creates a slow, evolving, exotic background 
# texture that sounds like a distant bird in a tropical lounge. (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :d4, buffer: :ambi_choir, pos: 0.3, density: 1, size: 0.2, amp: 0.4}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Lounge - Just the walking bass, lush chords, and room noise (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Groove - Add the syncopated Latin drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Solo - The bright vibraphone melody drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN LOUNGE SOPHISTICATION]
# 
# 1. FM as a Vibraphone: Look at `s_lead`. The `:play_fm` synth is given a 
#    high `divisor` (4) and a low `depth` (2). This gentle harmonic ratio 
#    produces a pristine, glassy, sine-like wave that perfectly mimics the 
#    iconic, echoing tones of a vibraphone or marimba. Routed through the 
#    tape echo, the sparse notes cascade across the empty space, creating a 
#    joyful, 1950s cocktail atmosphere.
#
# 2. The Walking Upright Bass: Look at `s_bass`. The `:play_sub` synth is 
#    given a mid-range `cutoff` (80) and a short `release` (0.15). This 
#    strips away the sub-frequencies and cuts the note off cleanly, turning 
#    the detuned sawtooth into a warm, bouncy "thwack" that perfectly mimics 
#    a plucked upright bass walking a melodic line.
#
# 3. Lush Major 9th Harmony: Look at `s_chords`. The arrays form massive 
#    4-note major 9th chords. By hitting strictly on the off-beats (steps 2, 6, 
#    10, 14) with a high `cutoff` (100), the engine turns the `:blade` synth 
#    into a sharp, sophisticated piano stab that perfectly mimics the lush, 
#    wide-stereo arrangements of 50s Space Age Pop.
# ==========================================================
