# ==========================================================
# PLAYBOOK: 70s TROPICÁLIA / BRAZILIAN PSYCHEDELIC ROCK
# (Pioneered by Os Mutantes, Caetano Veloso, and Gilberto Gil)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 70s Tropicália.
# We have explored Psychedelic Rock and Bollywood Funk, but Tropicália is 
# the sound of the late 60s/early 70s Brazilian counterculture. It fuses 
# the fuzz-drenched, distorted guitars of Western psychedelic rock with 
# traditional Brazilian rhythms, lush, orchestral string sections, and 
# quirky, avant-garde pop melodies. It relies on a driving, syncopated 
# drum beat, a massive, continuous fuzz bass, jagged, staccato guitar 
# stabs, and a piercing, echoing solo that feels like a sun-drenched, 
# surreal carnival.
#
# This playbook perfectly demonstrates how to combine a relentless, 
# distorted fuzz bass with lush, cinematic strings and jagged stabs. By 
# using the `:play_sub` synth with an extreme `cutoff` for the fuzz bass, 
# and massive `attack`/`release` Hashes on the `:play_chords` synth to 
# simulate an orchestral string section, the engine creates a massive, 
# surreal, and deeply nostalgic atmosphere.
# ==========================================================

use_bpm 115

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Dorian - Psychedelic, Fuzz, & Orchestral)
# ==========================================================

# The "Tropicália" Kick. 
# A driving, syncopated rock march. (4 x's, 4 elements)
s_kick = gen_score("x..x..x.x..x....", [
  :c4, {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.6}
])

# Crisp, organic snare on beats 2 and 4, with a syncopated ghost note. (3 x's, 3 elements)
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.9}
])

# Fast, driving 16th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Fuzz" Bass (A Dorian).
# Plays continuous, driving 8th notes. 
# Extreme cutoff (120) and short release (0.1) create a massive, grinding, 
# distorted churn that mimics a vintage fuzz bass guitar. (8 x's, 8 elements)
bass_notes = [:a1, :a1, :a1, :a1, :g1, :g1, :a1, :a1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 120, release: 0.1, amp: 1.2} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# Lush, "String Section" Chords (Am7 to Gmaj7).
# Hit on the downbeats. The slow 1.0-beat attack and massive 3.0-beat release 
# blur the chords together into a continuous, cinematic orchestral wave. 
# (2 x's, 2 elements)
s_strings = gen_score("x.......x.......", [
  {note: [:a3, :c4, :e4, :g4], cutoff: 80, attack: 1.0, release: 3.0, amp: 0.5},
  {note: [:g3, :b3, :d4, :fs4], cutoff: 80, attack: 1.0, release: 3.0, amp: 0.5}
])

# Stark, "Jaguar" Guitar Stabs (A to G).
# Uses :play_fm with a low divisor (2) and extreme depth (5) to create a harsh, 
# jagged, distorted hit. Hit strictly on the off-beats. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:a3, :e4], divisor: 2, depth: 5, release: 0.1, amp: 0.6},
  {note: [:a3, :e4], divisor: 2, depth: 5, release: 0.1, amp: 0.6},
  {note: [:g3, :d4], divisor: 2, depth: 5, release: 0.1, amp: 0.6},
  {note: [:g3, :d4], divisor: 2, depth: 5, release: 0.1, amp: 0.6}
])

# Piercing, "Psychedelic" Lead (A Dorian).
# Uses :play_lead routed through the global tape echo bus. The long release (0.4) 
# creates a soaring, echoing, surreal solo. (6 x's, 6 elements)
lead_notes = [:a5, :c6, :e6, :d6, :c6, :a5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, cutoff: 110, release: 0.4} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Ahh" Drone (Granular Synth).
# Using the built-in :ambi_choir sample.
# Long size (0.4) and low density (1) creates a lush, evolving background texture. 
# (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :a3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.4, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Trip - Just the fuzz bass, strings, and jagged stabs (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_strings, 4], [:play_fm, s_chords, 4], 
    [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Groove - Add the syncopated drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_strings, 8], [:play_fm, s_chords, 8], 
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], 
    [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Solo - The piercing psychedelic lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_strings, 8], [:play_fm, s_chords, 8], 
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], 
    [:play_hats, s_hats, 8], [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN SURREAL FUNK]
# 
# 1. The Fuzz Bass: Look at `s_bass`. The `:play_sub` synth plays continuous, 
#    driving 8th notes. By using an extreme `cutoff` (120) and a short `release` 
#    (0.1), the engine turns the detuned sawtooth into a massive, grinding, 
#    distorted churn that perfectly mimics the legendary fuzz bass tones used 
#    by Os Mutantes and the Tropicália movement.
#
# 2. The Orchestral Swell: Look at `s_strings`. The Hashes specify an `attack` 
#    of `1.0` and a `release` of `3.0`. Because the engine reads these 
#    Hashes, the chords don't just hit; they slowly swell into the mix and 
#    fade away over four whole beats, creating a continuous, blurred wave 
#    of warm harmony that perfectly mimics the lush, cinematic string 
#    arrangements that contrasted with the heavy fuzz bass in Tropicália.
#
# 3. The Dorian Mode: Look at `s_bass` and `s_lead`. The melody uses A, B, C, 
#    D, E, F#, G. The major 6th (F#) creates the bright, "psychedelic" sound 
#    that defines the genre. The engine's strict 16-step grid ensures this 
#    rapid, melodic lead fires flawlessly over the driving rhythm section.
# ==========================================================
