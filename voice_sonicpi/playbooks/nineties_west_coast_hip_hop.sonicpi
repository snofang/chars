# ==========================================================
# PLAYBOOK: 90s WEST COAST HIP-HOP / G-FUNK
# (Pioneered by Dr. Dre, Warren G, and Snoop Dogg)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s West Coast G-Funk.
# We have explored East Coast Boom-Bap and Crunk, but G-Funk is the sound 
# of 90s California. It fuses the heavy, laid-back groove of funk with 
# high-pitched, whining synth leads (often a Moog or Prophet), deep, 
# melodic basslines, and sparse, swinging drum beats.
#
# This playbook perfectly demonstrates how to use the `gen_score` helper 
# to create a "laid-back" groove. By pushing the kick and snare slightly 
# late in the 16-step grid, and routing a high-pitched FM lead through 
# the global tape echo, the engine creates a slow, swaggering, and deeply 
# nostalgic West Coast atmosphere.
# ==========================================================

use_bpm 95

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Minor - Laid-Back, Whiny, & Bouncy)
# ==========================================================

# The "Laid-Back" Kick. 
# Hits on step 0, the 'and' of 2 (step 6), beat 3 (step 8), and the 'and' of 4 (step 14).
# This specific placement creates that heavy, leaning, "lowrider" bounce.
# (4 x's, 4 elements)
s_kick = gen_score("x.....x.x.....x.", [
  :c4, {note: :c4, amp: 0.8}, :c4, {note: :c4, amp: 0.6}
])

# Heavy, funk clap strictly on beats 2 and 4, pushed slightly late. 
# (2 x's, 2 elements)
s_snare = gen_score("....x.......x...", [:c4, :c4])

# Swung, bouncing 16th hats. Notice the heavy velocity manipulation.
# (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# Deep, melodic Moog-style bass (F# Minor).
# Walks a bouncy line. Low cutoff (70) and medium release (0.2) 
# to create a warm, muffled undercurrent.
# (4 x's, 4 elements)
s_bass = gen_score("x.....x.x.....x.", [
  {note: :fs1, release: 0.2, cutoff: 70, amp: 1.2}, 
  {note: :fs1, release: 0.2, cutoff: 70, amp: 1.0}, 
  {note: :a1, release: 0.2, cutoff: 70, amp: 1.0}, 
  {note: :c2, release: 0.2, cutoff: 70, amp: 1.0}
])

# Lush, sustained minor 9th chords (F#m9 to C#m9).
# Hit on the downbeats. The slow 0.5-beat attack and massive 2.0-beat release 
# blur the chords together into a continuous, warm funk pad.
# (2 x's, 2 elements)
s_chords = gen_score("x.......x.......", [
  {note: [:fs3, :a3, :c4, :eb4], cutoff: 80, attack: 0.5, release: 2.0, amp: 0.4},
  {note: [:cs3, :e3, :g3, :b3], cutoff: 80, attack: 0.5, release: 2.0, amp: 0.4}
])

# High-pitched, "Whiny" G-Funk Lead (F# Minor Pentatonic).
# Uses :play_fm with a low divisor (2) and depth (4) to create a sharp, 
# buzzy square wave. Routed through the global tape echo for a cinematic smear.
# (6 x's, 6 elements)
lead_notes = [:fs5, :a5, :c6, :bb5, :a5, :fs5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 4, release: 0.2} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# Distant, "Siren" vocal wail (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched UP to :f4.
# Long size (0.15) creates a mournful, echoing cry.
# (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :f4, buffer: :ambi_choir, pos: 0.6, density: 1, size: 0.15, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Vibe - Just the laid-back drums, Moog bass, and chords (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_chords, s_chords, 4] ],
  
  # Scene 2: The Cruise - Add the distant vocal wail (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8] ],
    
  # Scene 3: The Drop - The high-pitched whining G-Funk lead drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN WEST COAST SWAGGER]
# 
# 1. The "Laid-Back" Push: Look at `s_kick`. Instead of hitting on step 4 
#    (beat 2), it hits on step 6 (the 'and' of beat 2). In West Coast hip-hop, 
#    drummers physically play slightly behind the beat. Because the engine's 
#    grid is mathematically perfect, pushing the kick just one 16th note late 
#    creates that heavy, leaning, "lowrider" bounce.
#
# 2. The Whiny FM Lead: The `s_lead` sequence uses `divisor: 2` and `depth: 4`. 
#    This harmonic ratio produces a sharp, buzzy square wave. Because it plays 
#    in the upper register (:fs5, :c6) and is routed through the global tape 
#    echo, the notes smear into a high-pitched, whining melody that perfectly 
#    mimics the iconic Moog leads of 90s G-Funk.
#
# 3. Swelling Funk Pads: Look at `s_chords`. The Hashes specify an `attack` 
#    of `0.5` and a `release` of `2.0`. Because the engine reads these 
#    Hashes, the chords don't just hit; they slowly swell into the mix and 
#    fade away, creating a continuous, warm wave of harmony that perfectly 
#    anchors the track's laid-back, cinematic atmosphere.
# ==========================================================
