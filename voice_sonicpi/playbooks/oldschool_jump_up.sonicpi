# ==========================================================
# PLAYBOOK: 90s AMBIENT TECHNO / IDM
# Lush, Deep, Melancholic, Hypnotic Textures
# ==========================================================
# [WHY THIS GENRE?]
# Ambient Techno / IDM (Global Communication, Aphex Twin) fuses
# soft, gentle rhythms with evolving filter sweeps, lush chords,
# and ethereal textures. This playbook captures that warm,
# introspective, hypnotic atmosphere – music for deep listening.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 110 BPM
# Key: A minor (melancholic, warm)
# Rhythm: Soft 4/4 kick, sparse metallic percussion on off‑beats,
# slow 8th hats, continuous rolling bass with filter sweep,
# lush chords on downbeats.
# Timbre: Gentle kick (bd_haus, low amp), metallic snare
# (sn_dolf, sparse), soft hats (cymbal_closed), evolving bass
# (dsaw with gradual cutoff sweep), warm chords (blade, long
# attack/release), Rhodes‑like FM (divisor 3, depth 1), ethereal
# granular vocal pad (ambi_choir, long size).
# Arrangement: Void (chords+grain) → Pulse (add drums+bass)
# → Journey (add Rhodes melody).
# ==========================================================

use_bpm 110

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Soft driving 4/4 kick with gentle amplitude variation
s_kick = gen_score("x...x...x...x...",
  [{note: :c4, amp: 0.7}, {note: :c4, amp: 0.8}])

# Sparse metallic percussion on off‑beats (steps 6 and 12)
s_snare = gen_score("......x...x.....",
  [{note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}])

# Slow echoing 8th hats
s_hats = gen_score("x.x.x.x.x.x.x.x.",
  [{note: :c4, amp: 0.15}, {note: :c4, amp: 0.2}])

# Evolving filter sweep bass – cutoff opens and closes across 16 steps
bass_cutoffs = [60, 65, 70, 75, 80, 85, 90, 95, 100, 110, 105, 100, 95, 90, 85, 80]
bass_notes = [:a1, :a1, :a2, :a1, :a1, :a1, :a2, :a1,
              :a1, :a1, :a2, :a1, :g1, :g1, :g2, :g1]
bass_data = 16.times.map do |i|
  {note: bass_notes[i], cutoff: bass_cutoffs[i]}
end
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Lush minor 9th chords – slow attack and release for blur
s_chords = gen_score("x.......x.......",
  [{note: [:a3, :c4, :e4, :g4], cutoff: 90, release: 2.0, attack: 0.5, amp: 0.5},
   {note: [:g3, :b3, :d4, :fs4], cutoff: 90, release: 2.0, attack: 0.5, amp: 0.5}])

# Soft Rhodes‑like FM melody – routed through tape echo
s_fm = gen_score("........x......x",
  [{note: :e5, amp: 0.4, divisor: 3, depth: 1, release: 1.5},
   {note: :c5, amp: 0.3, divisor: 3, depth: 1, release: 1.5}])

# Ethereal granular vocal pad – long size for drifting texture
s_grain = gen_score("x.......x.......",
  [{note: :a4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.4, amp: 0.5},
   {note: :g4, buffer: :ambi_choir, pos: 0.6, density: 1, size: 0.4, amp: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Void – Chords + Grain
  [ [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],

  # Scene 2: Pulse – Add Drums and Bass
  [ [:play_chords, s_chords, 8], [:play_grain, s_grain, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8] ],

  # Scene 3: Journey – Add Rhodes Melody
  [ [:play_chords, s_chords, 8], [:play_grain, s_grain, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_fm, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The 16‑step filter sweep: cutoff opens from 60 to 110 and
#   closes back down, giving a static bassline constant evolution.
# - Swelling chords: attack 0.5 and release 2.0 blur chords into
#   a warm, continuous wave of sound.
# - Soft FM bells: divisor 3 and depth 1 produce a Rhodes‑like
#   tone – sparse notes cascade through the tape echo.
# ==========================================================
