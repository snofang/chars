# ==========================================================
# PLAYBOOK: FOLKTRONICA / ORGANIC ELECTRONICA
# (Pioneered by Bonobo, Four Tet, and Caribou)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose Folktronica.
# We have explored heavy, aggressive bass music (Brostep) and rigid, 
# clinical genres (Minimal Techno). Folktronica is the sound of nature 
# meeting the machine. It blends warm, organic acoustic samples (like 
# chopped guitars and vocal hums) with intricate, syncopated electronic 
# percussion and deep, round sub-bass.
#
# This playbook perfectly demonstrates how to use the Granular 
# Synthesizer to chop an acoustic guitar sample (`:guit_harmonics`) 
# into a rhythmic, melodic loop. It also showcases how the `:play_fm` 
# synth can be tuned to sound like an organic Kalimba or Marimba.
# ==========================================================

use_bpm 115

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Major - Warm, Organic, & Melodic)
# ==========================================================

# Soft, syncopated acoustic-style kick (steps 0, 6, 8).
s_kick = gen_score("x.....x.x.......",
  [ :c4,
    {note: :c4, amp: 0.6},
    {note: :c4, amp: 0.9} ])

# Crisp, organic rimshot/snare with ghosts (steps 4, 7, 12, 14).
s_snare = gen_score("....x..x....x.x.",
  [ {note: :c4, amp: 0.8},
    {note: :c4, amp: 0.3},
    {note: :c4, amp: 0.8},
    {note: :c4, amp: 0.4} ])

# Intricate, swinging organic shaker (steps 0,2,3,4,5,7,8,10,11,12,13,15).
hat_amps = [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}
]
s_hats = gen_score("x.xx.xx.x.x.xx.x", hat_amps)

# Warm, round sub-bass walking (steps 0,6,8,12).
bass_data = [
  {note: :d2, release: 0.4, cutoff: 75},
  {note: :f2, release: 0.4, cutoff: 75},
  {note: :a2, release: 0.4, cutoff: 75},
  {note: :g2, release: 0.4, cutoff: 75}
]
s_bass = gen_score("x.....x.x...x...", bass_data)

# Lush Major 9th chords (steps 0 and 8).
s_chords = gen_score("x.......x.......",
  [ {note: [:d3, :fs3, :a3, :e4], cutoff: 90, release: 1.0, attack: 0.2, amp: 0.6},
    {note: [:a2, :cs3, :e3, :b3], cutoff: 90, release: 1.0, attack: 0.2, amp: 0.6} ])

# Kalimba/Marimba melody (steps 1,4,6,9,12).
fm_notes = [
  {note: :d5, amp: 0.6, divisor: 3, depth: 2, release: 0.5},
  {note: :a4, amp: 0.5, divisor: 3, depth: 2, release: 0.5},
  {note: :fs5, amp: 0.6, divisor: 3, depth: 2, release: 0.5},
  {note: :a5, amp: 0.5, divisor: 3, depth: 2, release: 0.5},
  {note: :e5, amp: 0.6, divisor: 3, depth: 2, release: 0.5}
]
s_fm = gen_score(".x..x.x..x..x...", fm_notes)

# Chopped acoustic guitar loop (steps 4,9,12).
s_vocal = gen_score("....x....x..x...",
  [ {note: :d4, buffer: :guit_harmonics, pos: 0.2, density: 2, size: 0.05, amp: 0.6},
    {note: :a4, buffer: :guit_harmonics, pos: 0.4, density: 2, size: 0.05, amp: 0.6},
    {note: :fs4, buffer: :guit_harmonics, pos: 0.6, density: 2, size: 0.05, amp: 0.6} ])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Vibe - Just the chopped guitar, bass, and chords (4 bars)
  [ [:play_grain, s_vocal, 4], [:play_sub, s_bass, 4], [:play_chords, s_chords, 4] ],
  
  # Scene 2: The Groove - Add the syncopated organic drums (8 bars)
  [ [:play_grain, s_vocal, 8], [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Melody - The wooden Kalimba melody drops (8 bars)
  [ [:play_grain, s_vocal, 8], [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_fm, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN ORGANIC ELECTRONICA]
# 
# 1. Granular Guitar Chops: Look at `s_vocal`. The granular engine is 
#    given the `:guit_harmonics` buffer. By using a small `size` (0.05) 
#    and a `density` of 2, the engine chops the acoustic guitar into a 
#    rhythmic, melodic loop that sounds like Four Tet slicing up a vinyl 
#    record. The engine's strict master clock ensures these chops land 
#    perfectly between the kick drums.
#
# 2. FM as Wood: The `s_fm` sequence uses `divisor: 3` and `depth: 2`. 
#    This narrows the harmonic ratio so that the sine waves cancel out 
#    their digital overtones, leaving a hollow, woody thunk that perfectly 
#    mimics an African Kalimba or Marimba.
#
# 3. Warmth and Space: Folktronica relies on leaving massive room for the 
#    acoustic textures. The `s_bass` uses a low `cutoff` (75) to keep it 
#    round and warm, while the `s_chords` use a slow `attack` (0.2) to 
#    fade in softly. The engine's strict 16-step grid ensures these lush, 
#    slow elements never clash with the intricate, syncopated drum pattern.
# ==========================================================
