# ==========================================================
# PLAYBOOK: ELECTRO TANGO / NUEVO TANGO
# (Pioneered by Gotan Project, Bajofondo, and Tanghetto)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose Electro Tango.
# We have explored Latin genres like Reggaeton and Cumbia, but Electro 
# Tango is the sound of modern Buenos Aires and Paris. It fuses the 
# traditional, dramatic 2/4 Habanera rhythm of Argentine tango with 
# modern electronic production, deep walking basses, and the iconic, 
# melancholic sound of the Bandoneon (a type of concertina).
#
# This playbook perfectly demonstrates how to use the `:play_fm` synth 
# to simulate a Bandoneon. By passing arrays of notes (chords) to the 
# FM synth with specific `divisor` and `depth` Hashes, the engine 
# creates a rich, reedy, acoustic timbre that weaves perfectly over 
# the 3-3-2 Habanera pulse.
# ==========================================================

use_bpm 115

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Dramatic, Melancholic, & Swaggering)
# ==========================================================

# The "Habanera" Kick. 
# A 3-3-2 syncopated pulse. Hits on step 0, the 'a' of 1 (step 3), 
# the 'and' of 2 (step 6), beat 3 (step 8), and the 'a' of 3 (step 11).
# FIXED: Exactly 16 steps.
s_kick  = (ring {:note => :c4, :amp => 1.0}, nil, nil, {:note => :c4, :amp => 0.7}, nil, nil, {:note => :c4, :amp => 1.0}, nil, {:note => :c4, :amp => 1.0}, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil, nil)

# Crisp, modern electronic snare strictly on beats 2 and 4 (steps 4 and 12).
s_snare = (ring nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil)

# Swung, organic shaker. 
# Notice the gaps (nil) and amplitude manipulation to create a human, swagger feel.
s_hats  = (ring {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, nil)

# The "Walking Double Bass" (A Minor).
# Plays a staccato, melodic line. High cutoff (90) and very short release 
# (0.15) mimic a plucked upright double bass.
s_bass  = (ring {:note => :a2, :release => 0.15, :cutoff => 90}, nil, nil, {:note => :a2, :release => 0.15, :cutoff => 90}, nil, {:note => :c3, :release => 0.15, :cutoff => 90}, nil, {:note => :e3, :release => 0.15, :cutoff => 90}, nil, {:note => :e3, :release => 0.15, :cutoff => 90}, nil, {:note => :a2, :release => 0.15, :cutoff => 90}, nil, {:note => :g2, :release => 0.15, :cutoff => 90}, nil, nil)

# The "Bandoneon" Chords (Am to E).
# Uses :play_fm with a low divisor (2) and depth (3) to create a rich, 
# reedy, acoustic timbre. Passing arrays of notes to the FM synth perfectly 
# mimics the traditional Argentine concertina.
s_chords= (ring nil, nil, {:note => [:a3, :c4, :e4], :divisor => 2, :depth => 3, :release => 0.2, :amp => 0.6}, nil, nil, nil, {:note => [:a3, :c4, :e4], :divisor => 2, :depth => 3, :release => 0.2, :amp => 0.6}, nil, nil, nil, {:note => [:e3, :g3, :b3], :divisor => 2, :depth => 3, :release => 0.2, :amp => 0.6}, nil, nil, nil, {:note => [:e3, :g3, :b3], :divisor => 2, :depth => 3, :release => 0.2, :amp => 0.6}, nil)

# Melancholic, soaring "Bandoneon" Lead (A Harmonic Minor).
# Uses :play_fm with a low divisor (2) and depth (3) to create a sharp, 
# reedy melody that cuts through the mix. Routed through the tape echo.
s_fm    = (ring {:note => :a4, :amp => 0.6, :divisor => 2, :depth => 3, :release => 0.3}, nil, nil, {:note => :c5, :amp => 0.5, :divisor => 2, :depth => 3, :release => 0.3}, nil, {:note => :b4, :amp => 0.6, :divisor => 2, :depth => 3, :release => 0.3}, nil, {:note => :a4, :amp => 0.5, :divisor => 2, :depth => 3, :release => 0.3}, nil, nil, {:note => :e5, :amp => 0.7, :divisor => 2, :depth => 3, :release => 0.3}, nil, {:note => :d5, :amp => 0.5, :divisor => 2, :depth => 3, :release => 0.3}, nil, {:note => :c5, :amp => 0.6, :divisor => 2, :depth => 3, :release => 0.3}, nil)

# Dramatic, ambient string/vocal "Sigh" (Granular Synth).
# Long size (0.3) and low density (1) creates a slow, evolving background 
# texture that sounds like a distant singer in a smoky Buenos Aires café.
s_grain = (ring {:note => :a3, :buffer => :misc_lori, :pos => 0.1, :density => 1, :size => 0.3, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Shadows - Just the walking bass, Bandoneon chords, and vocal sigh (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Dance - Add the Habanera drums and shaker (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Passion - The soaring Bandoneon lead melody drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN CULTURAL FUSION]
# 
# 1. The Habanera Pulse: Look at `s_kick`. It hits on steps 0, 3, 6, 8, 
#    and 11. This specific 3-3-2 syncopation is the absolute genetic code 
#    of Tango and the Cuban Habanera. By avoiding the standard 4/4 pulse, 
#    the engine creates a lopsided, swaggering groove that feels distinctly 
#    traditional and romantic.
#
# 2. FM as a Bandoneon: Look at `s_chords` and `s_fm`. The `:play_fm` synth 
#    is given a `divisor` of `2` and a `depth` of `3`. In Sonic Pi, the `:fm` 
#    synth natively accepts arrays, playing multiple oscillators at once. 
#    This harmonic ratio produces a rich, reedy, buzzing timbre that perfectly 
#    mimics the iconic Argentine Bandoneon, bridging the gap between acoustic 
#    folk and electronic music.
#
# 3. The Walking Double Bass: Look at `s_bass`. The `:play_sub` synth is 
#    given a `cutoff` of `90` and a `release` of `0.15`. This strips away the 
#    sub-frequencies and cuts the note off instantly, turning the detuned 
#    sawtooth into an aggressive, staccato "thwack" that perfectly mimics a 
#    plucked upright double bass walking the traditional tango harmony.
# ==========================================================
