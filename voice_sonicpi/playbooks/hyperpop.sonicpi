# ==========================================================
# PLAYBOOK: HYPERPOP / BUBBLEGUM BASS
# (Pioneered by SOPHIE, A. G. Cook, and 100 Gecs)
# ==========================================================
# 
# [WHY THIS GENRE?]
# We have explored pristine 80s pop and aggressive rave genres. Hyperpop pushes 
# digital synthesis to absolute, clinical extremes. It takes trap-style drums, 
# massive metallic FM bass clanks (the "SOPHIE" kick), and vocals that are 
# pitched up into chipmunk-range stutters. It relies on hyper-quantized grids, 
# extreme FM depth to create plastic/metal textures, and microscopic grain 
# sizes to shatter vocals into sugary glitches.
#
# [THE CAREFULLY DESCRIBED DNA]
# 1. Tempo: 160 BPM. Frantic, hyper-quantized, and bouncy.
# 2. Harmonic Center: F# Major. Sugary, bright, but aggressive.
# 3. Rhythmic Skeleton: Half-time trap-style kicks and snares. Hyper-quantized, 
#    rolling 16th hi-hats with rising amplitude rolls.
# 4. Timbral Palette:
#    - Bass: "Plastic/Metallic" FM bass clank (extreme depth, short release).
#    - Chords: Bright, icy, wide major chords (high cutoff, staccato).
#    - Lead: Piercing, high-pitched digital FM arpeggio.
#    - Texture: "Chipmunk" vocal glitch (pitched UP, extreme density, tiny size).
# 5. Arrangement: Intro (Bass/Hats) -> Vibe (Chords) -> Drop (Lead/Vocals).
# ==========================================================

use_bpm 160

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Major - Sugary, Bright, & Aggressive)
# ==========================================================

# Half-time, syncopated trap kick. 
# Hits on step 0, and a ghost kick on the 'a' of 3 (step 14). (2 x's, 2 elements)
s_kick = gen_score("x.............x.", [
  {note: :c4, amp: 1.2}, {note: :c4, amp: 0.6}
])

# Rigid, metallic clap strictly on beat 3 (step 8). (1 x, 1 element)
s_clap = gen_score("........x.......", [:c4])

# Frantic, hyper-quantized Trap Hats.
# Notice the rising amplitudes at the end of the bar to simulate a machine-gun roll.
# (8 x's, 8 elements)
s_hats = gen_score("x.x.x.x.x.x.x.xx", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.4}, 
  {note: :c4, amp: 0.5}, {note: :c4, amp: 0.6}, {note: :c4, amp: 0.7}, {note: :c4, amp: 0.8}
])

# The "Plastic" FM Bass (F# Minor/Major fusion).
# Uses :play_fm with extreme depth (8) to create a metallic, industrial clank.
# Hits on the off-beats. (4 x's, 4 elements)
s_bass = gen_score("..x...x...x...x.", [
  {note: :fs2, divisor: 2, depth: 8, release: 0.12, amp: 1.0}, 
  {note: :fs2, divisor: 2, depth: 8, release: 0.12, amp: 0.8}, 
  {note: :a2, divisor: 2, depth: 8, release: 0.12, amp: 1.0}, 
  {note: :g2, divisor: 2, depth: 8, release: 0.12, amp: 0.8}
])

# Bright, icy Major chord stabs (F# Major 9).
# Hit strictly on the downbeats. High cutoff (120) for a piercing wall of sound.
# (2 x's, 2 elements)
s_chords = gen_score("x.......x.......", [
  {note: [:fs3, :a3, :c4, :e4], cutoff: 120, release: 0.15, amp: 0.6},
  {note: [:a3, :c4, :e4, :g4], cutoff: 120, release: 0.15, amp: 0.6}
])

# Piercing, high-pitched digital arpeggio (F# Major Pentatonic).
# Uses :play_fm with a high divisor (3) and extreme depth (4) for a robotic tone.
# Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:fs6, :a6, :c7, :a6, :fs6, :e6]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, divisor: 3, depth: 4, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# The "Chipmunk" Vocal Glitch (Granular Synth).
# Pitched UP to :fs5 and :c6. Extreme density (5) and tiny size (0.02) 
# creates a sugary, robotic stutter. (2 x's, 2 elements)
s_vocal = gen_score("....x.......x...", [
  {note: :fs5, buffer: :ambi_choir, pos: 0.2, density: 5, size: 0.02, amp: 0.7},
  {note: :c6, buffer: :ambi_choir, pos: 0.4, density: 5, size: 0.02, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The sterile intro - Just the metallic bass and trap hats (4 bars)
  [ [:play_fm, s_bass, 4], [:play_hats, s_hats, 4], [:play_kick, s_kick, 4] ],
  
  # Scene 2: The icy vibe - Add the bright chords and metallic claps (8 bars)
  [ [:play_fm, s_bass, 8], [:play_hats, s_hats, 8], [:play_kick, s_kick, 8], 
    [:play_chords, s_chords, 8], [:play_snare, s_clap, 8] ],
    
  # Scene 3: The hyper-pop drop - Piercing lead and chipmunk vocals (8 bars)
  [ [:play_fm, s_bass, 8], [:play_hats, s_hats, 8], [:play_kick, s_kick, 8], 
    [:play_chords, s_chords, 8], [:play_snare, s_clap, 8], 
    [:play_lead, s_lead, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN DIGITAL EXTREMES]
# 
# 1. FM as Plastic: Look at `s_bass`. The `:play_fm` synth is given a 
#    `depth` of `8`. This extreme ratio forces the FM modulator to shatter 
#    the carrier wave, creating a metallic, "clanking" sound that perfectly 
#    mimics the famous latex/plastic basses designed by SOPHIE.
#
# 2. The Hyper-Roll: Look at `s_hats`. The amplitudes in the Hashes rise 
#    linearly from 0.3 to 0.8 twice per bar. Because the engine fires these 
#    on the strict 16-step grid, it creates a machine-gun roll that feels 
#    mathematically perfect and intensely digital.
#
# 3. Sugary Granularization: The `s_vocal` sequence uses the granular engine 
#    to chop a vocal into microscopic shards (`size: 0.02`). By pitching them 
#    up to the `:c6` range, the vocal loses all human breath and becomes a 
#    bright, sugary, robotic glitch that defines the Hyperpop aesthetic.
# ==========================================================
