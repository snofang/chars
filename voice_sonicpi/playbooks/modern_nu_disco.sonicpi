# ==========================================================
# PLAYBOOK: MODERN NU-DISCO / DISCO-POP REVIVAL
# (Pioneered by Dua Lipa, Jessie Ware, and The Weeknd)
# ==========================================================
# [WHY THIS GENRE?]
# The 2020s Disco‑Pop Revival polishes 70s grooves to a pristine,
# high‑energy sheen – driving 4/4, syncopated slap bass, and wide
# chord stabs. This playbook turns the sub‑bass into a funky slap
# bass and uses the lead synth for soaring, echo‑laden melodies.
# [DNA: 118 BPM, F# minor, 4/4 kick with syncopation, slap bass,
#  off‑beat strings, FM pluck arpeggio, vocal stutter, pop lead]
# ==========================================================

use_bpm 118

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# ----------------------------------------------------------
# SCORES – Normalized with gen_score – behavior identical to original
# ----------------------------------------------------------

# Driving 4/4 kick with a syncopated 16th hit on the 'a' of 4 (step 14)
s_kick = gen_score("x...x...x...x.x.",
  [:c4, :c4, :c4, :c4, {note: :c4, amp: 0.6}])

# Crisp snare on beats 2 and 4 (steps 4,12)
s_snare = gen_score("....x.......x...",
  [{note: :c4, amp: 0.9}, {note: :c4, amp: 0.9}])

# Nu‑Disco swing hats – alternating amplitudes on every 16th
s_hats = gen_score("x.x.x.x.x.x.x.x.",
  [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, {note: :c4, amp: 0.4},
   {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2}])

# Slap bass – continuous syncopated line, high cutoff & short release
s_bass = gen_score("x..xx.xx.x..xx.x.",
  [{note: :fs2, cutoff: 110, release: 0.1},
   {note: :fs2, cutoff: 110, release: 0.1},
   {note: :a2,  cutoff: 110, release: 0.1},
   {note: :a2,  cutoff: 110, release: 0.1},
   {note: :c3,  cutoff: 110, release: 0.1},
   {note: :c3,  cutoff: 110, release: 0.1},
   {note: :e2,  cutoff: 110, release: 0.1},
   {note: :fs2, cutoff: 110, release: 0.1}])

# Lush wide string chords – off‑beats (steps 2,6,10,14)
s_chords = gen_score("..x...x...x...x.",
  [[:fs3, :a3, :c4, :e4],
   [:fs3, :a3, :c4, :e4],
   [:a3,  :c4, :e4, :g4],
   [:e3,  :g3, :b3, :d4]])

# Bouncing FM pluck arpeggio – divisor 3 for organic tone
s_fm = gen_score("x.x.x.x.x.x.x...",
  [{note: :fs5, amp: 0.5, divisor: 3, depth: 2, release: 0.1},
   {note: :a5,  amp: 0.4, divisor: 3, depth: 2, release: 0.1},
   {note: :c6,  amp: 0.5, divisor: 3, depth: 2, release: 0.1},
   {note: :e6,  amp: 0.4, divisor: 3, depth: 2, release: 0.1},
   {note: :c6,  amp: 0.5, divisor: 3, depth: 2, release: 0.1},
   {note: :a5,  amp: 0.4, divisor: 3, depth: 2, release: 0.1},
   {note: :fs5, amp: 0.6, divisor: 3, depth: 2, release: 0.1}])

# Soaring pop lead – routed through global echo, long release
s_lead = gen_score("....x.x.x...x.x.",
  [{note: :fs5, amp: 0.6, release: 0.5},
   {note: :a5,  amp: 0.5, release: 0.5},
   {note: :c6,  amp: 0.7, release: 0.8},
   {note: :b5,  amp: 0.5, release: 0.5},
   {note: :a5,  amp: 0.6, release: 0.5}])

# Choppy diva vocal stutter – granular, high density, tiny grains
s_vocal = gen_score("....x.....x.x...",
  [{note: :fs4, buffer: :ambi_choir, pos: 0.3, density: 2, size: 0.04, amp: 0.5},
   {note: :a4,  buffer: :ambi_choir, pos: 0.5, density: 2, size: 0.04, amp: 0.5},
   {note: :c4,  buffer: :ambi_choir, pos: 0.7, density: 2, size: 0.04, amp: 0.6}])

# ----------------------------------------------------------
# PLAYBOOK – In‑line and readable
# ----------------------------------------------------------
playbook = (ring
  # Scene 1 – The Groove: drums, slap bass, and strings (4 bars)
  [ [:play_kick, s_kick, 4],
    [:play_snare, s_snare, 4],
    [:play_hats, s_hats, 4],
    [:play_sub, s_bass, 4],
    [:play_chords, s_chords, 4] ],

  # Scene 2 – The Vibe: add arpeggio and vocal chops (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8],
    [:play_fm, s_fm, 8],
    [:play_grain, s_vocal, 8] ],

  # Scene 3 – The Drop: soaring pop lead enters (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8],
    [:play_fm, s_fm, 8],
    [:play_grain, s_vocal, 8],
    [:play_lead, s_lead, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# 1. Slap Bass Illusion – cutoff 110 and release 0.1 strip sub‑
#    frequencies and shorten the note, turning the sub synth into
#    an aggressive, percussive “thwack” that mimics slap bass.
# 2. Off‑Beat Pocket – chords on steps 2,6,10,14 lock between the
#    kick and bass, creating the signature “boom‑cha” Nu‑Disco groove.
# 3. Cascading Echoes – the lead leaves massive gaps; the global
#    tape echo fills them with delay tails, building a shimmering
#    stadium soundscape.
# ==========================================================
