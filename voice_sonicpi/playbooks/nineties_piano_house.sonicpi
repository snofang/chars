# ==========================================================
# PLAYBOOK: 90s PIANO HOUSE / HANDBAG HOUSE
# (Pioneered by Black Box, K‑Klass, and Robin S)
# ==========================================================
# 
# [WHY THIS GENRE?]
# Piano House injects the rigid 4/4 grid with massive Korg M1
# piano stabs, soaring diva vocals, and an off‑beat bouncing
# bass. This playbook uses high‑cutoff chords, syncopated
# percussion, and granulated vocal chops to recreate the
# euphoric energy of a 90s warehouse rave.
# ==========================================================

use_bpm 124

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x...x...x...x...", [:c4])

s_clap  = gen_score("....x.......x...", [:c4])

s_hats  = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.5},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.5}
])

s_bass  = gen_score("..x...x...x...x.", [
  {note: :g1,  release: 0.15},
  {note: :g1,  release: 0.15},
  {note: :bb1, release: 0.15},
  {note: :d2,  release: 0.15}
])

s_chords = gen_score("..x...x...x...x.", [
  [:g3, :bb3, :d4, :f4],
  [:g3, :bb3, :d4, :f4],
  [:bb3, :db4, :f4, :ab4],
  [:d3,  :f3,  :a3, :c4]
])

s_fm    = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :g5,  amp: 0.6, divisor: 2, depth: 3, release: 0.1},
  {note: :d5,  amp: 0.5, divisor: 2, depth: 3, release: 0.1},
  {note: :bb5, amp: 0.6, divisor: 2, depth: 3, release: 0.1},
  {note: :d6,  amp: 0.7, divisor: 2, depth: 3, release: 0.1},
  {note: :g5,  amp: 0.6, divisor: 2, depth: 3, release: 0.1},
  {note: :f5,  amp: 0.5, divisor: 2, depth: 3, release: 0.1},
  {note: :d5,  amp: 0.6, divisor: 2, depth: 3, release: 0.1},
  {note: :g5,  amp: 0.7, divisor: 2, depth: 3, release: 0.1}
])

s_vocal = gen_score("....x.....x...x.", [
  {note: :g4,  buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.04, amp: 0.6},
  {note: :bb4, buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.04, amp: 0.6},
  {note: :d5,  buffer: :ambi_choir, pos: 0.5, density: 3, size: 0.04, amp: 0.6}
])

# Playbook
playbook = (ring
  # Scene 1: The Groove – kick, off‑beat bass, and hats (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_hats, s_hats, 4] ],
  
  # Scene 2: The Vibe – add claps and massive piano stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8],
    [:play_snare, s_clap, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Drop – piercing synth lead and diva vocals (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8],
    [:play_snare, s_clap, 8], [:play_chords, s_chords, 8],
    [:play_lead, s_fm, 8], [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Bass, hats, and piano all lock on off‑beats (steps 2,6,10,14)
#   to create the signature “boom‑cha” pump at 124 BPM.
# - The chord stabs (no explicit cutoff) use the engine’s
#   default :blade synth, but the high‑register 4‑note chords
#   naturally cut through like the classic Korg M1 “Organ 2”.
# - Granular vocal chops (density 3, size 0.04) pitched up to
#   :g4 and :d5 deliver soaring, sugary diva stutters that
#   define the handbag house aesthetic.
# ==========================================================
