# ==========================================================
# PLAYBOOK: 80s GOTHIC ROCK / SECOND WAVE GOTH
# (Pioneered by The Cure, Siouxsie and the Banshees, and Sisters of Mercy)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 80s Gothic Rock.
# We have explored Darkwave and Post-Punk, but Gothic Rock is the sound 
# of pure, cavernous melancholy. It relies on a heavy, tribal, reverb-drenched 
# drum machine, a deep, driving "chorused" bass guitar that carries the 
# melody, and lush, slow-attacking synth pads that feel like wandering 
# through a foggy, ruined cathedral.
#
# This playbook perfectly demonstrates how to use a purely electronic 
# engine to simulate a live 80s goth band. By using the `:play_sub` synth 
# as a driving, high-cutoff bass and the `:play_chords` synth with massive 
# `attack`/`release` Hashes, the engine creates a massive, dark, and deeply 
# atmospheric groove.
# ==========================================================

use_bpm 110

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Tribal, Cavernous, & Melancholic)
# ==========================================================

# The "Tribal" Kick. 
# A heavy, cavernous march. (4 x's, 4 elements)
s_kick = gen_score("x.....x.x.....x.", [
  :c4, {note: :c4, amp: 0.8}, :c4, {note: :c4, amp: 0.7}
])

# Massive, echoing snare strictly on beats 2 and 4. (2 x's, 2 elements)
s_snare = gen_score("....x.......x...", [
  {note: :c4, amp: 1.1}, {note: :c4, amp: 1.0}
])

# Rigid, driving 8th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.1}
])

# The "Chorused" Bass Guitar (A Minor).
# Plays continuous, driving 8th notes. High cutoff (100) and short release (0.15) 
# create a punchy, "thwack" that mimics a chorused electric bass driving the melody. 
# (8 x's, 8 elements)
bass_notes = [:a1, :a1, :e1, :a1, :f1, :f1, :c2, :f1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 100, release: 0.15, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# Lush, "String Synth" Chords (Am9 to Fmaj9).
# Hit on the downbeats. The slow 1.5-beat attack and massive 3.0-beat release 
# blur the chords together into a continuous, cinematic wave. (2 x's, 2 elements)
s_chords = gen_score("x.......x.......", [
  {note: [:a3, :c4, :e4, :g4], cutoff: 70, attack: 1.5, release: 3.0, amp: 0.5},
  {note: [:f2, :a3, :c4, :e4], cutoff: 70, attack: 1.5, release: 3.0, amp: 0.5}
])

# Clean, "Chiming" Guitar Lead (A Minor Pentatonic).
# Uses :play_lead routed through the global tape echo bus. The long release (0.4) 
# creates a soaring, echoing melody. (6 x's, 6 elements)
lead_notes = [:a5, :c6, :e6, :d6, :c6, :a5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, cutoff: 90, release: 0.4} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Angelic Choir" Drone (Granular Synth).
# Using the built-in :ambi_choir sample.
# Long size (0.4) and low density (1) creates a slow, evolving background texture 
# that mimics a distant, ghostly choir. (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :a3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.4, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Shadows - Just the chorused bass, sweeping strings, and choir (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The March - Add the heavy, tribal drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Dawn - The chiming guitar lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN GOTHIC ATMOSPHERE]
# 
# 1. The Chorused Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    every 8th note, mapping out a driving, melodic line. By using a high 
#    `cutoff` (100) and a short `release` (0.15), the engine turns the detuned 
#    sawtooth into a punchy, bright "thwack" that perfectly mimics the 
#    chorused Fender Bass VI used by goth bands like The Cure and Bauhaus.
#
# 2. The Orchestral Swell: Look at `s_chords`. The Hashes specify an `attack` 
#    of `1.5` and a `release` of `3.0`. Because the engine reads these 
#    Hashes, the chords don't just hit; they slowly swell into the mix and 
#    fade away over four whole beats, creating a continuous, blurred wave 
#    of warm harmony that perfectly mimics the lush, wide-stereo string pads 
#    of 80s Gothic Rock.
#
# 3. The Tribal Groove: Look at `s_kick`. It completely avoids landing on a 
#    standard 4/4 pulse. By hitting on syncopated, tribal steps (0, 6, 8, 14), 
#    the engine creates a heavy, cavernous groove that feels like a live 
#    drummer playing a massive, echoing drum kit in a cathedral.
# ==========================================================
