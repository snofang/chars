# ==========================================================
# PLAYBOOK: 80s JAPANESE TECHNO POP / YMO
# (Pioneered by Yellow Magic Orchestra, Ryuichi Sakamoto, and YMO)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 80s Japanese Techno Pop.
# We have explored City Pop (which is laid-back) and 8-Bit Chiptune (which 
# is gaming-focused). Japanese Techno Pop is the sound of the late 70s/early 
# 80s avant-garde. Pioneered by Yellow Magic Orchestra, it relied on the 
# world's first programmable step sequencers (like the Roland MC-8). 
# It is rigid, robotic, mathematical, and heavily influenced by exotica.
#
# This playbook perfectly demonstrates how to create a tightly locked, 
# mechanical groove. By using continuous 16th-note bass, stark staccato 
# chords, and an exotic, pentatonic FM lead, the engine creates a futuristic, 
# precise soundscape that feels like a supercomputer playing pop music.
# ==========================================================

use_bpm 120

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Robotic, Exotic, & Mathematical)
# ==========================================================

# Relentless, driving 4/4 kick.
s_kick  = (ring :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil)

# Crisp, robotic 808 snare strictly on beats 2 and 4 (steps 4 and 12).
s_snare = (ring nil, nil, nil, nil, :c4, nil, nil, nil, nil, nil, nil, nil, :c4, nil, nil, nil)

# Rigid, alternating 16th hats. 
# Notice the amplitude difference (0.3 vs 0.2) that creates a robotic march.
s_hats  = (ring {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2})

# The "Synth-Bass" (A Minor).
# Plays continuous 16th notes, alternating octaves (:a2, :a3). 
# High cutoff (100) and short release (0.1) create a relentless, robotic pulse.
s_bass  = (ring {:note => :a2, :cutoff => 100, :release => 0.1}, {:note => :a2, :cutoff => 100, :release => 0.1}, {:note => :a3, :cutoff => 100, :release => 0.1}, {:note => :a2, :cutoff => 100, :release => 0.1}, 
           {:note => :a2, :cutoff => 100, :release => 0.1}, {:note => :a2, :cutoff => 100, :release => 0.1}, {:note => :g2, :cutoff => 100, :release => 0.1}, {:note => :g2, :cutoff => 100, :release => 0.1}, 
           {:note => :f2, :cutoff => 100, :release => 0.1}, {:note => :f2, :cutoff => 100, :release => 0.1}, {:note => :f3, :cutoff => 100, :release => 0.1}, {:note => :f2, :cutoff => 100, :release => 0.1}, 
           {:note => :e2, :cutoff => 100, :release => 0.1}, {:note => :e2, :cutoff => 100, :release => 0.1}, {:note => :g2, :cutoff => 100, :release => 0.1}, {:note => :a2, :cutoff => 100, :release => 0.1})

# Stark, staccato minor chord stabs (Am to F to E).
# Hit strictly on the off-beats (steps 2, 6, 10, 14) to leave maximum room for the bass.
s_chords= (ring nil, nil, [:a3, :c4, :e4], nil, nil, nil, [:a3, :c4, :e4], nil, nil, nil, [:f3, :a3, :c4], nil, nil, nil, [:e3, :g3, :b3], nil)

# Exotic, "Eastern" FM Melody (A Minor Pentatonic).
# Uses :play_fm with a high divisor (3) and depth (2) to create a sharp, 
# glassy square wave. Routed through the engine's tape echo for a smear.
s_fm    = (ring {:note => :a5, :amp => 0.6, :divisor => 3, :depth => 2, :release => 0.1}, nil, {:note => :c6, :amp => 0.5, :divisor => 3, :depth => 2, :release => 0.1}, nil, 
           {:note => :e6, :amp => 0.6, :divisor => 3, :depth => 2, :release => 0.1}, nil, {:note => :a5, :amp => 0.5, :divisor => 3, :depth => 2, :release => 0.1}, nil, 
           {:note => :g5, :amp => 0.6, :divisor => 3, :depth => 2, :release => 0.1}, nil, {:note => :e5, :amp => 0.5, :divisor => 3, :depth => 2, :release => 0.1}, nil, 
           {:note => :f5, :amp => 0.6, :divisor => 3, :depth => 2, :release => 0.1}, nil, {:note => :a5, :amp => 0.7, :divisor => 3, :depth => 2, :release => 0.1}, nil)

# Ethereal, granular "Computer" drone (using :ambi_choir).
# Long size (0.2) and low density (1) creates a slow, evolving background 
# texture that sounds like a supercomputer humming in the background.
s_grain = (ring {:note => :a4, :buffer => :ambi_choir, :pos => 0.2, :density => 1, :size => 0.2, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil, {:note => :e4, :buffer => :ambi_choir, :pos => 0.6, :density => 1, :size => 0.2, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Supercomputer - Just the relentless bass, chords, and drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Groove - Add the robotic 4/4 drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Melody - The exotic FM lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN ROBOTIC POP]
# 
# 1. The MC-8 Pulse: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step, alternating between the low octave (:a2) and 
#    the high octave (:a3). By using a high `cutoff` (100) and a very short 
#    `release` (0.1), the engine turns the detuned sawtooth into a relentless, 
#    buzzing "chug" that perfectly mimics the early digital sequencers used 
#    by Yellow Magic Orchestra.
#
# 2. Mathematical Staccato: Look at `s_chords` and `s_fm`. Both sequences 
#    leave massive gaps (`nil`) on the downbeats. The engine's strict master 
#    clock ensures these sparse, staccato hits land with absolute mathematical 
#    precision, creating a groove that feels less like a human drummer and 
#    more like a machine executing code.
#
# 3. Exotic FM: The `s_fm` sequence uses `divisor: 3` and `depth: 2`. This 
#    harmonic ratio produces a sharp, glassy square wave. By playing an A 
#    minor pentatonic scale, the engine creates an "Eastern" sounding melody 
#    that perfectly mimics the exotic, Orientalist synthesizer lines that 
#    defined 80s Japanese Techno Pop.
# ==========================================================
