# ==========================================================
# PLAYBOOK: 60s MOTOWN / NORTHERN SOUL
# (Pioneered by The Temptations, Marvin Gaye, and The Supremes)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 60s Motown.
# We have explored 70s Funk and 90s Neo-Soul, but Motown is the absolute 
# genesis of modern pop and soul music. It relies on a driving, live 4/4 
# drum beat with a busy, syncopated tambourine, a highly melodic, walking 
# electric bass (pioneered by James Jamerson), and tight, staccato horn 
# and guitar stabs. 
#
# This playbook perfectly demonstrates how to use a purely electronic 
# engine to simulate a live 60s soul band. By using the `:play_sub` synth 
# as a fast, melodic walking bass and the `:play_fm` synth to simulate 
# tight horn stabs, the engine creates a joyful, driving groove that feels 
# like a spinning vinyl record in 1965 Detroit.
# ==========================================================

use_bpm 120

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (Eb Major - Joyful, Driving, & Melodic)
# ==========================================================

# Driving, live 4/4 kick.
s_kick = gen_score("x...x...x...x...", [:c4])

# Crisp, live snare on beats 2 and 4, with a syncopated ghost note 
# on the 'e' of 3 (step 10).
s_snare = gen_score("....x...x.x.....", [:c4, {note: :c4, amp: 0.4}])

# Relentless, driving 16th tambourine.
# Notice the heavy amplitude manipulation to simulate a human shaking it.
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}, 
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2}
])

# The "Jamerson" Walking Bass (Eb Major).
# Plays continuous, melodic 8th notes. Mid cutoff (90) and short release (0.15) 
# mimic a picked, upright/electric bass.
bass_notes = [:eb2, :eb2, :f2, :g2, :ab2, :ab2, :bb2, :ab2, 
              :g2, :g2, :f2, :eb2, :bb1, :bb1, :bb2, :bb2]
bass_data = bass_notes.map { |n| {note: n, cutoff: 90, release: 0.15, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# Tight, "Horn Section" Stabs (EbMaj7 to Bb7).
# Uses :play_fm with a low divisor (2) and depth (3) to create a warm, brassy 
# staccato hit that mimics a live horn section.
s_chords = gen_score("..x.....x.....x.", [
  {note: [:eb3, :g3, :bb3, :d4], divisor: 2, depth: 3, release: 0.15, amp: 0.5},
  {note: [:bb2, :d3, :f3, :a3], divisor: 2, depth: 3, release: 0.15, amp: 0.5}
])

# Soaring, "Lead Vocal" Melody (Eb Major Pentatonic).
# Uses :play_fm with a high divisor (3) and low depth (1) to create a clean, 
# glassy tone that mimics a lead singer. Routed through the tape echo.
lead_notes = [:eb4, :g4, :bb4, :eb5, :d5, :bb4, :g4, :eb4]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 1, release: 0.4} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# Pitched-up, "Backing Vocals" stutter (Granular Synth).
# High density, small size = a sharp, sugary vocal skip.
s_vocal = gen_score("....x.......x...", [
  {note: :eb4, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.04, amp: 0.5},
  {note: :bb3, buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.04, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the driving drums, tambourine, and walking bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Vibe - Add the tight horn stabs and backing vocals (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drop - The soaring lead vocal melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN SOUL MOMENTUM]
# 
# 1. The Jamerson Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    every 8th note, mapping out a fast, melodic walking line. By using a 
#    mid-range `cutoff` (90) and a short `release` (0.15), the engine turns 
#    the detuned sawtooth into a punchy, agile "thwack" that perfectly 
#    mimics the legendary, busy electric basslines of James Jamerson that 
#    drove the Motown sound.
#
# 2. FM as a Horn Section: Look at `s_chords`. The `:play_fm` synth is given 
#    a `divisor` of `2` and a `depth` of `3`, with a microscopic `release` 
#    of `0.15`. This forces the FM synth to produce a warm, brassy, staccato 
#    "hit" that perfectly mimics a live horn section locking in with the 
#    rhythm section.
#
# 3. The Tambourine Drive: 60s Soul relies heavily on a relentless 16th-note 
#    tambourine to maintain high-energy momentum. The `s_hats` play 
#    continuous 16th notes with heavily manipulated amplitudes. The engine's 
#    strict master clock ensures this shaker locks perfectly with the walking 
#    bass, creating a joyful, unstoppable groove.
# ==========================================================
