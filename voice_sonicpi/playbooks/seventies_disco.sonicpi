# ==========================================================
# PLAYBOOK: 70s DISCO / NU-DISCO
# (Pioneered by Giorgio Moroder, Chic, and Daft Punk)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# 70s Disco relies on a rigid 4/4 kick, syncopated 16th hats,
# a melodic walking bassline, and lush staccato string/horn stabs.
# This playbook uses high‑cutoff bass for a picked electric tone
# and FM synthesis for a funky clavinet/guitar riff.
# ==========================================================

use_bpm 120

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x...x...x...x...", [:c4])

s_snare = gen_score("....x..x....x.x.", [
  {note: :c4, amp: 0.9},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.9},
  {note: :c4, amp: 0.3}
])

s_hats  = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.5},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.5},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.5},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.5}
])

s_bass  = gen_score("x..x.x.x.x.x..x.", [
  {note: :fs2, cutoff: 100, release: 0.15},
  {note: :fs2, cutoff: 100, release: 0.15},
  {note: :a2,  cutoff: 100, release: 0.15},
  {note: :c3,  cutoff: 100, release: 0.15},
  {note: :a2,  cutoff: 100, release: 0.15},
  {note: :fs2, cutoff: 100, release: 0.15},
  {note: :e2,  cutoff: 100, release: 0.15}
])

s_chords = gen_score("..x...x...x...x.", [
  [:fs3, :a3, :c4],
  [:fs3, :a3, :c4],
  [:a3,  :c4, :e4],
  [:e3,  :g3, :b3]
])

s_fm    = gen_score("x..x.x.x..x.x.x.", [
  {note: :fs5, amp: 0.6, divisor: 2, depth: 2, release: 0.1},
  {note: :a5,  amp: 0.5, divisor: 2, depth: 2, release: 0.1},
  {note: :c6,  amp: 0.6, divisor: 2, depth: 2, release: 0.1},
  {note: :e5,  amp: 0.5, divisor: 2, depth: 2, release: 0.1},
  {note: :fs5, amp: 0.6, divisor: 2, depth: 2, release: 0.1},
  {note: :a5,  amp: 0.5, divisor: 2, depth: 2, release: 0.1},
  {note: :c6,  amp: 0.6, divisor: 2, depth: 2, release: 0.1}
])

s_vocal = gen_score("......x.....x...", [
  {note: :fs4, buffer: :ambi_choir, pos: 0.1, density: 2, size: 0.04, amp: 0.6},
  {note: :a4,  buffer: :ambi_choir, pos: 0.3, density: 2, size: 0.04, amp: 0.6}
])

# Playbook
playbook = (ring
  # Scene 1: The Groove – 4/4 beat, walking bass, hats (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4],
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Vibe – add lush string stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Drop – funky clavinet and diva vocals (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8],
    [:play_lead, s_fm, 8], [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The bass uses cutoff 100 and release 0.15 to mimic a picked
#   electric guitar “thwack” – funky and aggressive.
# - The kick is rigid 4‑on‑the‑floor (steps 0,4,8,12) while the
#   hats and chords hit off‑beats (2,6,10,14) for the bounce.
# - FM with divisor 2 and depth 2 creates a sharp clavinet‑like
#   riff that weaves between the bass and stabs.
# ==========================================================
