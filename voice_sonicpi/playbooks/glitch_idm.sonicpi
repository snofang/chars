use_bpm 135

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (Chaotic but locked A Minor)
# ==========================================================
s_kick   = (ring :c4, nil, nil, nil, :c4, nil, :c4, nil, nil, nil, :c4, nil, :c4, nil, nil, nil)
s_hats   = (ring :c4, :c4, nil, :c4, nil, :c4, :c4, nil, :c4, nil, :c4, :c4, nil, :c4, nil, :c4)
s_fm     = (ring nil, :a5, nil, :c6, nil, nil, :e5, nil, :a5, nil, nil, :g5, nil, :e5, nil, nil)
s_pluck  = (ring :a3, nil, :a3, nil, :e3, nil, :e3, nil, :g3, nil, :g3, nil, :a3, nil, :c4, nil)
s_bass   = (ring :a1, :a1, nil, :a1, nil, nil, :a1, :a1, nil, :a1, nil, nil, :g1, nil, nil, :g1)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Erratic percussion (2 bars)
  [ [:play_kick, s_kick, 2], [:play_hats, s_hats, 2] ],
  
  # Scene 2: Add manic bass and plucks (4 bars)
  [ [:play_kick, s_kick, 4], [:play_hats, s_hats, 4], 
    [:play_pluck, s_pluck, 4], [:play_sub, s_bass, 4] ],
    
  # Scene 3: Full glitch meltdown (4 bars)
  [ [:play_kick, s_kick, 4], [:play_hats, s_hats, 4], 
    [:play_pluck, s_pluck, 4], [:play_sub, s_bass, 4], 
    [:play_fm, s_fm, 4] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
