use_bpm 78

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (Jazzy Cm7 - Fm7 - Dm7b5 - G7)
# ==========================================================
# Chords are just arrays of notes placed inside the ring!
s_chords = (ring [:c3, :eb4, :g4, :bb4], nil, nil, nil, nil, nil, nil, nil, 
            [:f3, :ab4, :c5, :eb5], nil, nil, nil, nil, nil, nil, nil)
            
s_bass   = (ring :c2, nil, nil, nil, nil, nil, :c2, nil, :f2, nil, nil, nil, nil, nil, :g2, nil)
s_kick   = (ring :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil)
s_snare  = (ring nil, nil, nil, nil, :c4, nil, nil, nil, nil, nil, nil, nil, :c4, nil, nil, nil)
s_hats   = (ring :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the groove (2 bars)
  [ [:play_kick, s_kick, 2], [:play_snare, s_snare, 2], 
    [:play_hats, s_hats, 2], [:play_chords, s_chords, 2] ],
    
  # Scene 2: Add the bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], 
    [:play_hats, s_hats, 4], [:play_chords, s_chords, 4], 
    [:play_sub, s_bass, 4] ],
    
  # Scene 3: Mellow out - drums drop, bass and chords remain (2 bars)
  [ [:play_chords, s_chords, 2], [:play_sub, s_bass, 2] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
