# ==========================================================
# PLAYBOOK: 80s ART POP / NEW WAVE
# Polished, Emotional, Studio‑Perfect Production
# ==========================================================
# [WHY THIS GENRE?]
# 80s Art Pop (Peter Gabriel, Tears for Fears) is defined
# by the LinnDrum's swing, massive gated snares, deep analog
# Prophet synths, and pristine DX7 FM bells. This playbook
# captures that cinematic, deeply emotional, high‑end studio
# sound.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 112 BPM
# Key: D minor (polished, emotional)
# Rhythm: Syncopated LinnDrum kick (0,3,8,11), gated snare
# on 2/4 with ghost, swung hats with alternating amplitudes,
# analog Moog bass, lush synth stabs on off‑beats, DX7 FM
# bells, ethereal granular vocal pad.
# Timbre: LinnDrum kick (bd_haus with accents), gated snare
# (sn_dolf with reverb), swung hats (cymbal_closed with amp
# layers), Moog bass (dsaw, low cutoff), Prophet stabs
# (blade, high cutoff), DX7 bells (fm, divisor 3, depth 2,
# tape echo), granular vocal pad (ambi_choir).
# Arrangement: Atmosphere (chords+bass+pad) → Groove (add
# drums) → Melody (add DX7 bells).
# ==========================================================

use_bpm 112

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# LinnDrum kick – syncopated hits on steps 0,3,8,11
s_kick = gen_score("x..x....x..x....",
  [{note: :c4, amp: 1.0},
   {note: :c4, amp: 0.7},
   {note: :c4, amp: 1.0},
   {note: :c4, amp: 0.7}])

# Massive gated snare – hits on steps 4,7,12
s_snare = gen_score("....x..x....x...",
  [{note: :c4, amp: 1.2},
   {note: :c4, amp: 0.3},
   {note: :c4, amp: 1.2}])

# LinnDrum swing hats – alternating amps, gaps for 60% swing
s_hats = gen_score("x.xx.xx.xx.xx.xx",
  [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.15},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.15}, {note: :c4, amp: 0.4},
   {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.15}, {note: :c4, amp: 0.4}])

# Deep Moog bass – walking melodic line (steps 0,5,7,9,12)
s_bass = gen_score("x....x.x.x...x..",
  [{note: :d2, release: 0.2, cutoff: 85},
   {note: :d2, release: 0.2, cutoff: 85},
   {note: :f2, release: 0.2, cutoff: 85},
   {note: :a2, release: 0.2, cutoff: 85},
   {note: :g2, release: 0.2, cutoff: 85}])

# Lush Prophet stabs – on off‑beats (steps 2,6,10,14)
s_chords = gen_score("..x...x...x...x.",
  [{note: [:d3, :f3, :a3], cutoff: 110, release: 0.2, amp: 0.7},
   {note: [:d3, :f3, :a3], cutoff: 110, release: 0.2, amp: 0.7},
   {note: [:g3, :bb3, :d4], cutoff: 110, release: 0.2, amp: 0.7},
   {note: [:a3, :c4, :e4], cutoff: 110, release: 0.2, amp: 0.7}])

# Pristine DX7 FM bells – tape echo (steps 4,6,8,12)
s_fm = gen_score("....x.x.x...x...",
  [{note: :d5, amp: 0.6, divisor: 3, depth: 2, release: 0.5},
   {note: :f5, amp: 0.5, divisor: 3, depth: 2, release: 0.5},
   {note: :a5, amp: 0.6, divisor: 3, depth: 2, release: 0.5},
   {note: :g5, amp: 0.5, divisor: 3, depth: 2, release: 0.5}])

# Ethereal vocal pad – slow evolving texture (step 8)
s_vocal = gen_score("........x.......",
  [{note: :a4, buffer: :ambi_choir, pos: 0.3, density: 1, size: 0.2, amp: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Atmosphere – Chords, Bass, Vocal Pad
  [ [:play_chords, s_chords, 4], [:play_sub, s_bass, 4],
    [:play_grain, s_vocal, 4] ],

  # Scene 2: Groove – Add Swung LinnDrum
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_vocal, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],

  # Scene 3: Melody – Add DX7 Bells
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_vocal, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The LinnDrum swing: alternating amplitudes (0.15–0.4) and
#   gaps create the famous 60% swing quantization.
# - Gated snare: massive amplitude (1.2) with hall reverb
#   creates the iconic Phil Collins/Peter Gabriel sound.
# - FM as digital glass: divisor 3 and depth 2 produce the
#   pristine DX7 bell tone; tape echo cascades it across space.
# ==========================================================
