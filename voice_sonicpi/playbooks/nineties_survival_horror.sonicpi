# ==========================================================
# PLAYBOOK: 90s SURVIVAL HORROR / RESIDENT EVIL STYLE
# (Pioneered by Capcom Sound Team, Masami Ueda, and Akari Kaida)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Survival Horror.
# We have explored Giallo and Ambient, but 90s Survival Horror is the sound 
# of pure, clautrophobic dread. It fuses the eerie, echoing atmospheres of 
# industrial music with the dissonant, avant-garde harmony of 20th-century 
# classical music. It relies on extreme negative space, a sparse, ticking 
# "heartbeat" drum pattern, deep, booming sub-bass, stark, dissonant cluster 
# chords, and a piercing, echoing "music box" or "celesta" melody that feels 
# like wandering through a deserted, blood-stained mansion.
#
# This playbook perfectly demonstrates how to use extreme `attack`/`release` 
# Hashes and dissonant intervals to create immense psychological tension. 
# By using the `:play_fm` synth for a piercing music box and routing it 
# through the global tape echo, the engine creates a terrifying, cinematic 
# atmosphere.
# ==========================================================

use_bpm 75

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (C Minor / Dissonant - Sparse, Creepy, & Tense)
# ==========================================================

# The "Heartbeat" Kick. 
# A slow, heavy, sparse pulse. (2 x's, 2 elements)
s_kick = gen_score("x.......x.......", [
  {note: :c4, amp: 0.8}, {note: :c4, amp: 0.6}
])

# Soft, echoing snare strictly on beat 3 (step 8). (1 x, 1 element)
s_snare = gen_score("........x.......", [:c4])

# Very sparse, "Ticking Clock" hats. (4 x's, 4 elements)
s_hats = gen_score("x...x...x...x...", [
  {note: :c4, amp: 0.15}, {note: :c4, amp: 0.1}, 
  {note: :c4, amp: 0.15}, {note: :c4, amp: 0.1}
])

# Deep, massive "Sub-Bass" Drone (C Minor).
# Massive release (4.0) and extreme low cutoff (40) create a deep, continuous, 
# suffocating rumble. (1 x, 1 element)
s_bass = gen_score("x...............", [
  {note: :c1, release: 4.0, cutoff: 40, amp: 1.2}
])

# Stark, "Dissonant Cluster" Chords (Cm + Tritone).
# Hit on the downbeats. The slow 1.0-beat attack and massive 4.0-beat release 
# blur the chords together into a continuous, terrifying wave. Uses a tritone 
# (C and Gb) for maximum horror tension. (2 x's, 2 elements)
s_chords = gen_score("x.......x.......", [
  {note: [:c3, :eb3, :gb3], cutoff: 70, attack: 1.0, release: 4.0, amp: 0.5},
  {note: [:bb2, :db3, :e3], cutoff: 70, attack: 1.0, release: 4.0, amp: 0.5}
])

# Piercing, "Music Box" Lead (C Minor Pentatonic).
# Uses :play_fm with a high divisor (3) and low depth (1) to create a pristine, 
# glassy, child-like tone. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:c5, :eb5, :g5, :ab5, :g5, :eb5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 1, release: 0.8} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Whisper / Wind" Drone (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched DOWN.
# Massive size (0.5s) and low density (1) creates a slow, evolving, terrifying 
# background texture. (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :c3, buffer: :ambi_choir, pos: 0.4, density: 1, size: 0.5, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Mansion - Just the sub-bass, dissonant chords, and wind (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Hallway - Add the sparse, heartbeat drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Reveal - The piercing music box melody drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN PSYCHOLOGICAL DREAD]
# 
# 1. Dissonant Harmony: Look at `s_chords`. The arrays use a diminished 5th 
#    (tritone) interval (e.g., :c3 and :gb3). This creates a harsh, dissonant, 
#    and evil sound that perfectly anchors the track's terrifying atmosphere. 
#    The `:play_chords` synth with a slow `attack` (1.0) and massive `release` 
#    (4.0) blurs the chords together into a continuous, suffocating wave.
#
# 2. The Heartbeat Groove: Look at `s_kick` and `s_hats`. The kick hits only 
#    twice per bar, like a slow, heavy heartbeat, while the hats tick like a 
#    clock. 80% of the 16-step grid is `nil`. The engine honors these massive 
#    rests perfectly, letting the reverb tails of the snare and the delay tails 
#    of the music box ring out into the void, creating a spacious, claustrophobic 
#    atmosphere.
#
# 3. The Music Box: The `s_lead` sequence uses `divisor: 3` and `depth: 1`. 
#    This gentle harmonic ratio produces a pristine, glassy, sine-like wave 
#    that mimics a child's music box. By routing it through the global tape 
#    echo bus, the sparse notes cascade across the empty space, creating a 
#    deeply unsettling, lullaby-like melody that contrasts perfectly with the 
#    dissonant chords and sub-bass.
# ==========================================================
