# ==========================================================
# PLAYBOOK: BASS HOUSE / HEAVY BASS
# Aggressive, Wonky, Mainstage Energy
# ==========================================================
# [WHY THIS GENRE?]
# Bass House (Jauz, Joyryde) injects the rigid 4/4 house grid
# with massive, aggressive, "wonky" FM basslines that sound
# like robots fighting. This playbook captures that heavy,
# mainstage underground energy.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 125 BPM
# Key: G minor (heavy, aggressive)
# Rhythm: 4/4 kick, clap on 2/4, off‑beat hats, wonky FM bass
# with double‑hit bounce on off‑beats, staccato chord stabs,
# echoing pluck melody, chopped vocal stutters.
# Timbre: Driving kick (bd_haus), heavy dry clap (sn_dolf),
# rigid hats (cymbal_closed with amp layers), wonky FM bass
# (fm with changing divisor/depth), staccato minor chords
# (blade), high pluck (fm, tape echo), granular vocal chops.
# Arrangement: Groove (kick+hats+bass) → Vibe (add clap+
# chords) → Drop (add pluck+vocal).
# ==========================================================

use_bpm 125

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Relentless 4‑on‑the‑floor kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy dry clap on beats 2 and 4 (steps 4 and 12)
s_clap = gen_score("....x.......x...", [:c4])

# Off‑beat hats (steps 2,6,10,14) with alternating amps
s_hats = gen_score("..x..x..x..x....",
  [{note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}])

# Wonky FM bass – double‑hit bounce on off‑beats with changing divisor/depth
bass_data = [
  {note: :g1, divisor: 2, depth: 4, release: 0.12, amp: 1.0},
  {note: :g1, divisor: 3, depth: 5, release: 0.12, amp: 0.8},
  {note: :bb1, divisor: 2, depth: 4, release: 0.12, amp: 1.0},
  {note: :bb1, divisor: 4, depth: 6, release: 0.12, amp: 0.8},
  {note: :d2, divisor: 2, depth: 4, release: 0.12, amp: 1.0},
  {note: :d2, divisor: 3, depth: 5, release: 0.12, amp: 0.8},
  {note: :f1, divisor: 2, depth: 4, release: 0.12, amp: 1.0},
  {note: :f1, divisor: 4, depth: 6, release: 0.12, amp: 0.8}
]
s_bass = gen_score("..xx..xx..xx..xx.", bass_data)

# Staccato minor chord stabs (steps 4,9,14)
chord_data = [
  {note: [:g3, :bb3, :d4], cutoff: 100, release: 0.15, amp: 0.6},
  {note: [:bb3, :db4, :f4], cutoff: 100, release: 0.15, amp: 0.6},
  {note: [:d3, :f3, :a3], cutoff: 100, release: 0.15, amp: 0.6}
]
s_chords = gen_score("....x....x....x.", chord_data)

# High echoing pluck melody – routed through tape echo
s_fm = gen_score("x..x.x..x..x....",
  [{note: :g5, amp: 0.6, divisor: 3, depth: 2, release: 0.2},
   {note: :d5, amp: 0.5, divisor: 3, depth: 2, release: 0.2},
   {note: :bb5, amp: 0.6, divisor: 3, depth: 2, release: 0.2},
   {note: :a5, amp: 0.5, divisor: 3, depth: 2, release: 0.2},
   {note: :g5, amp: 0.7, divisor: 3, depth: 2, release: 0.2}])

# Choppy vocal stutters – granular chops (steps 4 and 10)
s_vocal = gen_score("....x.....x.....",
  [{note: :g4, buffer: :ambi_choir, pos: 0.2, density: 2, size: 0.03, amp: 0.6},
   {note: :bb4, buffer: :ambi_choir, pos: 0.4, density: 2, size: 0.03, amp: 0.6}])

# Playbook
playbook = (ring
  # Scene 1: Groove – Kick, Hats, Bass
  [ [:play_kick, s_kick, 4], [:play_hats, s_hats, 4],
    [:play_fm, s_bass, 4] ],

  # Scene 2: Vibe – Add Clap and Chords
  [ [:play_kick, s_kick, 8], [:play_hats, s_hats, 8],
    [:play_fm, s_bass, 8], [:play_snare, s_clap, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3: Drop – Add Pluck and Vocal
  [ [:play_kick, s_kick, 8], [:play_hats, s_hats, 8],
    [:play_fm, s_bass, 8], [:play_snare, s_clap, 8],
    [:play_chords, s_chords, 8], [:play_lead, s_fm, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The wonky FM bass: double‑hit bounce on off‑beats (steps
#   2‑3, 6‑7, 10‑11, 14‑15) with changing divisor/depth creates
#   a thick, squelching, "talking" sound.
# - Off‑beat pocket: bass, hats, and chords all hit on the
#   midpoints between kicks – the engine locks them for a
#   massive "boom‑cha" momentum.
# - Pristine mix: high FM pluck cuts through the heavy bass,
#   while granular vocal chops add texture without muddying
#   the low end.
# ==========================================================
