# ==========================================================
# PLAYBOOK: COMPLEXTRO / ELECTRO HOUSE
# Morphing Bass, 8‑Bit Blips, Supersaw Stabs
# ==========================================================
# [WHY THIS GENRE?]
# Complextro (Porter Robinson, Wolfgang Gartner) is the sound
# of 2010s EDM at its most technical – rapidly switching synth
# patches on every 16th note to create a morphing bassline that
# sounds like multiple instruments fighting for space. This
# playbook uses changing divisor/depth hashes to reshape the
# FM waveform on every step.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 128 BPM
# Key: E minor (bouncy, technical)
# Rhythm: 4/4 kick, clap on 2/4, off‑beat hats, morphing bass
# on every 16th, supersaw stabs on off‑beats, 8‑bit blips,
# chopped vocal stutter.
# Timbre: Relentless kick (bd_haus), heavy clap (sn_dolf),
# off‑beat hats (cymbal_closed), FM bass with changing
# divisor/depth (fm), supersaw chords (blade, high cutoff),
# 8‑bit blips (fm, high divisor), granular vocal chops.
# Arrangement: Groove (kick+hats+bass) → Vibe (add clap+chords)
# → Drop (add blips+vocal).
# ==========================================================

use_bpm 128

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Relentless 4‑on‑the‑floor kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy festival‑style clap on beats 2 and 4
s_clap = gen_score("....x.......x...", [:c4])

# Off‑beat open hats – exactly on steps 2,6,10,14
s_hats = gen_score("..x...x...x...x.",
  [{note: :c4, amp: 0.4}, {note: :c4, amp: 0.5},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}])

# Morphing Complextro bass – changing divisor/depth on every 16th step
bass_data = [
  {note: :e2, divisor: 2, depth: 3, release: 0.1},
  {note: :e2, divisor: 4, depth: 6, release: 0.1},
  {note: :e3, divisor: 3, depth: 2, release: 0.1},
  {note: :e2, divisor: 2, depth: 8, release: 0.1},
  {note: :g2, divisor: 4, depth: 1, release: 0.1},
  {note: :g2, divisor: 3, depth: 5, release: 0.1},
  {note: :e2, divisor: 2, depth: 2, release: 0.1},
  {note: :e2, divisor: 4, depth: 7, release: 0.1},
  {note: :b2, divisor: 3, depth: 4, release: 0.1},
  {note: :b2, divisor: 2, depth: 1, release: 0.1},
  {note: :e3, divisor: 4, depth: 6, release: 0.1},
  {note: :e2, divisor: 3, depth: 3, release: 0.1},
  {note: :g2, divisor: 2, depth: 8, release: 0.1},
  {note: :g2, divisor: 4, depth: 2, release: 0.1},
  {note: :e2, divisor: 3, depth: 5, release: 0.1},
  {note: :e2, divisor: 2, depth: 1, release: 0.1}
]
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Massive supersaw stabs – also on steps 2,6,10,14
chord_data = [
  {note: [:e3, :g3, :b3], cutoff: 120, release: 0.2, amp: 0.6},
  {note: [:e3, :g3, :b3], cutoff: 120, release: 0.2, amp: 0.6},
  {note: [:c3, :e3, :g3], cutoff: 120, release: 0.2, amp: 0.6},
  {note: [:d3, :fs3, :a3], cutoff: 120, release: 0.2, amp: 0.6}
]
s_chords = gen_score("..x...x...x...x.", chord_data)

# Piercing 8‑bit blips – every even step (0,2,4,6,8,10,12,14)
blip_data = [
  {note: :e5, amp: 0.6, divisor: 4, depth: 2},
  {note: :b5, amp: 0.5, divisor: 4, depth: 2},
  {note: :g5, amp: 0.6, divisor: 4, depth: 2},
  {note: :e6, amp: 0.7, divisor: 4, depth: 2},
  {note: :e5, amp: 0.6, divisor: 4, depth: 2},
  {note: :c6, amp: 0.5, divisor: 4, depth: 2},
  {note: :d6, amp: 0.6, divisor: 4, depth: 2},
  {note: :b5, amp: 0.7, divisor: 4, depth: 2}
]
s_fm = gen_score("x.x.x.x.x.x.x.x.", blip_data)

# Rapid chopped vocal stutters – steps 3,7,11,15
vocal_data = [
  {note: :e4, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.03, amp: 0.5},
  {note: :g4, buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.03, amp: 0.5},
  {note: :b4, buffer: :ambi_choir, pos: 0.6, density: 3, size: 0.03, amp: 0.5},
  {note: :e5, buffer: :ambi_choir, pos: 0.8, density: 3, size: 0.03, amp: 0.5}
]
s_vocal = gen_score("...x...x...x...x", vocal_data)

# Playbook
playbook = (ring
  # Scene 1: Groove – Kick, Hats, Morphing Bass
  [ [:play_kick, s_kick, 4], [:play_hats, s_hats, 4],
    [:play_fm, s_bass, 4] ],

  # Scene 2: Vibe – Add Clap and Supersaw Stabs
  [ [:play_kick, s_kick, 8], [:play_hats, s_hats, 8],
    [:play_fm, s_bass, 8], [:play_snare, s_clap, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3: Drop – Add Blips and Vocal Chops
  [ [:play_kick, s_kick, 8], [:play_hats, s_hats, 8],
    [:play_fm, s_bass, 8], [:play_snare, s_clap, 8],
    [:play_chords, s_chords, 8], [:play_lead, s_fm, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The morphing bass: changing divisor/depth (e.g., from
#   2→3 to 4→6) on every 16th step reshapes the FM waveform
#   into 16 different patches in sequence – the essence of Complextro.
# - Off‑beat supersaw: chords on steps 2,6,10,14 with high
#   cutoff (120) cut through the dense bassline.
# - Extreme density: every grid position is filled by some
#   element – the engine's precision keeps it tight.
# ==========================================================
