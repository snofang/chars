# ==========================================================
# PLAYBOOK: SPACE DISCO / COSMIC DISCO
# (Pioneered by Lindstrøm, Daniele Baldelli, and Giorgio Moroder)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# Space Disco stretches the 4/4 grid with relentless rolling
# 16th‑note analog basslines, evolving filter sweeps, and
# echoing arpeggios. This playbook uses parameter hashes
# (cutoff) to create a hypnotic, breathing pulse that drives
# the track forward like a journey through a nebula.
# ==========================================================

use_bpm 115

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x...x...x...x...", [:c4])

s_clap  = gen_score("....x.......x...", [:c4])

s_hats  = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4}
])

s_bass  = gen_score("xxxxxxxxxxxxxxxx", [
  {note: :g2, cutoff: 60},
  {note: :g3, cutoff: 70},
  {note: :g2, cutoff: 80},
  {note: :g3, cutoff: 90},
  {note: :g2, cutoff: 100},
  {note: :g3, cutoff: 110},
  {note: :g2, cutoff: 120},
  {note: :g3, cutoff: 130},
  {note: :g2, cutoff: 120},
  {note: :g3, cutoff: 110},
  {note: :g2, cutoff: 100},
  {note: :g3, cutoff: 90},
  {note: :c3, cutoff: 80},
  {note: :c4, cutoff: 70},
  {note: :c3, cutoff: 60},
  {note: :c4, cutoff: 60}
])

s_chords = gen_score("x.......x.......", [
  {note: [:g3, :bb3, :d4, :f4], cutoff: 100, release: 1.0, amp: 0.6},
  {note: [:c3, :eb3, :g3, :bb3], cutoff: 100, release: 1.0, amp: 0.6}
])

s_fm    = gen_score("x...x...x...x...", [
  {note: :g5, amp: 0.6, divisor: 3, depth: 2, release: 0.3},
  {note: :d5, amp: 0.5, divisor: 3, depth: 2, release: 0.3},
  {note: :f5, amp: 0.6, divisor: 3, depth: 2, release: 0.3},
  {note: :g5, amp: 0.5, divisor: 3, depth: 2, release: 0.3}
])

s_grain = gen_score("x.......x.......", [
  {note: :g4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.4, amp: 0.5},
  {note: :c4, buffer: :ambi_choir, pos: 0.6, density: 1, size: 0.4, amp: 0.5}
])

# Playbook
playbook = (ring
  # Scene 1: The Orbit – cosmic drone and sweeping bass (4 bars)
  [ [:play_grain, s_grain, 4], [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Flight – relentless 4/4 drums and lush chords (8 bars)
  [ [:play_grain, s_grain, 8], [:play_sub, s_bass, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8],
    [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Stars – echoing nebula arpeggio drops (8 bars)
  [ [:play_grain, s_grain, 8], [:play_sub, s_bass, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8],
    [:play_chords, s_chords, 8], [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The 16‑step filter sweep in s_bass opens and closes the
#   cutoff from 60 to 130 and back, creating hypnotic breath.
# - Alternating octaves (:g2/:g3) on every 16th builds a
#   relentless rolling pulse (the Moroder gallop).
# - The FM arpeggio uses sparse hits (4 per 16) with long
#   release and tape echo – the empty steps let the delay
#   tails create a massive, shimmering soundscape.
# ==========================================================
