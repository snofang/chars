# ==========================================================
# PLAYBOOK: LO‑FI / JAZZY DRUNKEN GROOVE
# Wonky Kick, Late Snare, Swung Hats, Granular Piano Glitch
# ==========================================================
# [WHY THIS GENRE?]
# This playbook captures a lopsided, drunken feel with kick
# on off‑grid positions, snare hitting late (J Dilla style),
# rolling triplet‑feel hats, sparse bass, jazzy chord stabs,
# and granular piano glitches. It's a laid‑back, head‑nodding
# groove with a lo‑fi, experimental texture.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 90 BPM
# Key: F major (warm, jazzy)
# Rhythm: Syncopated kick (3,8,11), late snare (5,13), triplet‑
# feel hats with dynamic accents, sparse bass on downbeats,
# chord stabs on off‑beats, granular piano glitch.
# Timbre: Punchy kick (bd_haus), snare (sn_dolf), hats
# (cymbal_closed with dynamics), sub‑bass (dsaw), jazzy chords
# (blade), granular piano (elec_piano, high density, tiny size).
# Arrangement: Groove (drums) → Chords+Bass (add harmony) →
# Glitch (add granular stutters).
# ==========================================================

use_bpm 90

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F Major Jazzy)
# ==========================================================

# Lopsided, drunken kick pattern. Hits on step 3, 8, 11.
s_kick = gen_score("...x....x..x....",
  [ {note: :c4, amp: 1.2},
    {note: :c4, amp: 1.0},
    {note: :c4, amp: 0.7} ])

# Snare hits late (step 5 and 13 – the classic Dilla "lag")
s_snare = gen_score(".....x.......x..",
  [ {note: :c4, amp: 0.9},
    {note: :c4, amp: 0.8} ])

# Rolling, triplet‑feel hats with dynamic accents
hat_data = [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2}
]
s_hats = gen_score("x.xxx.x.x.xxx.xx", hat_data)

# Deep, sparse bass – hits on step 0 and 8
s_bass = gen_score("x.......x.......",
  [ :f2, {note: :a2, amp: 0.8} ])

# Jazzy chord stabs – on steps 4 and 12
s_chords = gen_score("....x.......x...",
  [ [:f3, :a4, :c5, :e5],
    [:d3, :f4, :a4, :c5] ])

# Granular piano glitch – tiny, high‑density grain on step 8
s_grain = gen_score("........x.......",
  [ {note: :f4, buffer: :elec_piano, pos: 0.6, density: 8, size: 0.03} ])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the wonky groove (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4],
    [:play_hats, s_hats, 4] ],

  # Scene 2: Add chords and bass (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_chords, s_chords, 8],
    [:play_sub, s_bass, 8] ],

  # Scene 3: Add granular piano stutters (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_chords, s_chords, 8],
    [:play_grain, s_grain, 4] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Wonky kick: hits on 3,8,11 create a lopsided, drunken feel.
# - Late snare: snare on 5 and 13 (not 4,12) gives the "Dilla lag".
# - Triplet‑feel hats: dynamic accents (0.2–0.4) and pattern
#   shape a rolling, swung texture.
# - Sparse bass: root and fifth anchor the harmony.
# - Jazzy chords: rich extensions on off‑beats add colour.
# - Granular glitch: tiny, dense grains create a rhythmic
#   piano stutter.
# ==========================================================
