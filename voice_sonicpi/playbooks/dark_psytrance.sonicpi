# ==========================================================
# PLAYBOOK: DARK PSYTRANCE / FOREST PSYTRANCE
# (Pioneered by Kindzadza, Parasense, and Highko)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose Dark Psytrance.
# We have explored Goa Trance (which is melodic and alien) and Peak-Time 
# Techno (which is rigid and dark). Dark Psytrance is the sound of a 
# nightmarish, high-speed alien forest. It operates at 148 BPM and relies 
# on a relentless 4/4 kick, an off-beat rolling bass, and squelchy, 
# modulating FM synth lines that sound like insects or liquid metal.
#
# This playbook perfectly demonstrates how to push the `:play_fm` synth 
# to create aggressive, squelching sound design. By using a high `depth` 
# and `divisor` on the off-beats, the engine creates a frantic, dark, 
# and hypnotic atmosphere that feels like a psychedelic trip.
# ==========================================================

use_bpm 148

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Dark, Frantic, & Hypnotic)
# ==========================================================

# Relentless, driving 4-on-the-floor kick.
s_kick  = (ring :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil)

# Deep, analog clap strictly on beats 2 and 4 (steps 4 and 12).
s_clap  = (ring nil, nil, nil, nil, :c4, nil, nil, nil, nil, nil, nil, nil, :c4, nil, nil, nil)

# Frantic, rolling 16th hats to drive the momentum.
s_hats  = (ring {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil)

# The "Rolling" Off-Beat Bass (A Minor).
# Hits strictly on the off-beats (steps 2, 6, 10, 14). Very short release (0.1) 
# creates a relentless, hypnotic "pump" that drives the track forward.
s_bass  = (ring nil, nil, {:note => :a1, :release => 0.1}, nil, nil, nil, {:note => :a1, :release => 0.1}, nil, nil, nil, {:note => :a1, :release => 0.1}, nil, nil, nil, {:note => :a1, :release => 0.1}, nil)

# Dark, sparse minor chord stabs (Am to Gm).
# Hit sparingly on the downbeats to anchor the frantic percussion.
s_chords= (ring nil, nil, nil, nil, [:a3, :c4, :e4], nil, nil, nil, nil, nil, nil, nil, [:g3, :bb3, :d4], nil, nil, nil)

# The "Squelchy" FM Lead (A Minor Pentatonic).
# Uses :play_fm with a high divisor (3) and extreme depth (6) to create 
# a sharp, squelchy, "liquid metal" sound that dances over the bassline.
s_fm    = (ring {:note => :a2, :divisor => 3, :depth => 6, :release => 0.1}, nil, nil, {:note => :a2, :divisor => 3, :depth => 6, :release => 0.1}, nil, nil, {:note => :c3, :divisor => 3, :depth => 6, :release => 0.1}, nil, nil, {:note => :e3, :divisor => 3, :depth => 6, :release => 0.1}, nil, nil, {:note => :a2, :divisor => 3, :depth => 6, :release => 0.1}, nil, nil, nil)

# Sinister, metallic granular texture (using :elec_piano).
# High density, tiny size = industrial, machine-like static.
s_grain = (ring {:note => :a3, :buffer => :elec_piano, :pos => 0.8, :density => 4, :size => 0.02, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil, {:note => :a3, :buffer => :elec_piano, :pos => 0.8, :density => 4, :size => 0.02, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Hypnosis - Just the kick, rolling bass, and granular static (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Tension - Add the claps, hats, and dark chords (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], 
    [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Trip - The squelchy FM lead drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], 
    [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8], 
    [:play_lead, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN DARK SOUND DESIGN]
# 
# 1. FM Squelch: Look at `s_fm`. The `:play_fm` synth is given a `divisor` 
#    of `3` and an extreme `depth` of `6`. This forces the FM modulator 
#    to radically reshape the carrier wave, creating a sharp, squelchy 
#    "liquid metal" sound that perfectly mimics the modular synth sound 
#    design of Dark Psytrance.
#
# 2. The Off-Beat Pump: Look at `s_bass`. It hits strictly on steps 2, 6, 
#    10, and 14—the exact midpoints between the kicks. By using a very 
#    short `release` (0.1), the engine creates a relentless, hypnotic 
#    "pump" that drives the track forward unstoppably.
#
# 3. Industrial Granular Space: The `s_grain` sequence uses a tiny `size` 
#    (`0.02`) and high `density` (`4`). By targeting the very end of the 
#    electric piano buffer (`pos: 0.8`), the engine shatters the sample 
#    into metallic, machine-like static that sits perfectly in the 
#    background of a dark forest rave.
# ==========================================================
