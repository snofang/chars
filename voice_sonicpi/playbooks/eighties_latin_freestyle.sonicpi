# ==========================================================
# PLAYBOOK: 80s LATIN FREESTYLE / MIAMI FREESTYLE
# (Pioneered by Shannon, Stevie B, and Exposé)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 80s Latin Freestyle.
# We have explored Electro-Funk and Miami Bass, but Freestyle is the 
# sound of 80s New York and Miami club culture. It fuses the syncopated 
# 808 electro grooves with lush, romantic Latin minor chords, a driving, 
# off-beat synth bass, and high-pitched, emotional vocal stutters. 
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create the signature "Freestyle" bounce. By locking a syncopated 808 
# kick to an off-beat bass and lush off-beat chords, the engine creates 
# a massive, dancing groove that feels like an 80s roller rink.
# ==========================================================

use_bpm 120

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Romantic, Bouncy, & Syncopated)
# ==========================================================

# The "Freestyle" Kick. 
# Highly syncopated. Hits on step 0, the 'a' of 1 (step 3), beat 3 (step 8), 
# and the 'a' of 3 (step 11).
s_kick = gen_score("x..x....x..x....", [
  :c4, {note: :c4, amp: 0.8}, :c4, {note: :c4, amp: 0.7}
])

# Crisp, 808 snare strictly on beats 2 and 4.
s_snare = gen_score("....x.......x...", [:c4])

# Rigid, driving 16th hats.
s_hats = gen_score("x.x.x.x.x.x.x.x.", [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}])

# The "Off-Beat" Synth Bass (A Minor).
# Hits strictly on the off-beats. High cutoff (90) and short release (0.15) 
# create a bouncy, "pumping" undercurrent.
bass_notes = [:a1, :a1, :g1, :a1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 90, release: 0.15, amp: 1.0} }
s_bass = gen_score("..x...x...x...x.", bass_data)

# Lush, "Romantic" Minor Chords (Am to G).
# Hit strictly on the off-beats in sync with the bass. High cutoff (100) 
# and short release (0.2) create a sharp, staccato wall of sound.
chord_notes = [
  {note: [:a3, :c4, :e4]}, {note: [:a3, :c4, :e4]}, 
  {note: [:g3, :bb3, :d4]}, {note: [:g3, :bb3, :d4]}
]
chord_data = chord_notes.map { |c| c.merge({cutoff: 100, release: 0.2, amp: 0.6}) }
s_chords = gen_score("..x...x...x...x.", chord_data)

# Piercing, "Emotional" Synth Lead (A Minor Pentatonic).
# Uses :play_fm with a low divisor (2) and depth (3) to create a sharp, 
# buzzy square wave. Routed through the global tape echo for a cinematic smear.
lead_notes = [:a5, :e5, :c6, :e6, :d6, :c6, :a5, :g5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 3, release: 0.2} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# High-pitched, "Diva" Vocal Chops (Granular Synth).
# Pitched UP to :a4 and :c5. High density, tiny size = a sharp, sugary vocal skip.
vocal_notes = [:a4, :c5]
vocal_data = vocal_notes.map { |n| {note: n, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.6} }
s_vocal = gen_score("....x.......x...", vocal_data)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the syncopated 808s, off-beat bass, and hats (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Vibe - Add the lush romantic chords and diva vocals (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drop - The piercing emotional synth lead drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN 80S BOUNCE]
# 
# 1. The Freestyle Syncopation: Look at `s_kick`. It completely avoids 
#    landing on the standard 4/4 pulse. By hitting on steps 0, 3, 8, and 11, 
#    the engine creates a lopsided, "dancing" groove that feels distinctly 
#    Latin. The engine's strict master clock ensures this complex rhythm 
#    lands with absolute precision, creating the signature Freestyle bounce.
#
# 2. The Off-Beat Wall: Look at `s_bass` and `s_chords`. They ALL hit 
#    strictly on steps 2, 6, 10, and 14. In a 16-step grid, these are the 
#    exact midpoints between the kicks. The engine's strict master clock 
#    locks these together perfectly, creating a massive, bouncing "boom-cha" 
#    momentum that forces you to dance.
#
# 3. Euphoric Granular Vocals: The `s_vocal` sequence uses the granular 
#    engine to chop a vocal into microscopic shards (`size: 0.04`). By 
#    pitching them UP to `:a4` and `:c5`, the vocal loses its dark tone 
#    and becomes a soaring, sugary diva stutter that defines 80s Freestyle.
# ==========================================================
