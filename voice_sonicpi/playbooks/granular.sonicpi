use_bpm 90

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (Granular Experiments)
# ==========================================================

# 1. SCRUBBING: Manually moving the playhead through a vocal sample.
# We use :ambi_choir (a built-in Sonic Pi vocal sample).
# Notice how 'pos' slowly moves from 0.3 to 0.6, scanning through the audio file.
s_scrub = (ring 
  {note: :c4, buffer: :ambi_choir, pos: 0.3, density: 8, size: 0.08}, nil, nil, nil,
  {note: :c4, buffer: :ambi_choir, pos: 0.4, density: 8, size: 0.08}, nil, nil, nil,
  {note: :c4, buffer: :ambi_choir, pos: 0.5, density: 8, size: 0.08}, nil, nil, nil,
  {note: :eb4, buffer: :ambi_choir, pos: 0.6, density: 8, size: 0.08}, nil, nil, nil
)

# 2. FREEZING & DENSITY: Holding a single position, but changing grain size.
# Long grains (0.2) sound like a slow ambient pad. Short grains (0.01) sound like glittering static.
s_freeze = (ring 
  {note: :g3, buffer: :elec_piano, pos: 0.5, density: 2, size: 0.2}, nil, nil, nil, nil, nil, nil, nil,
  {note: :g3, buffer: :elec_piano, pos: 0.5, density: 6, size: 0.05}, nil, nil, nil, nil, nil, nil, nil
)

# 3. A simple beat to anchor it
s_kick = (ring :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil)
s_hats = (ring :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Scrubbing through a vocal (4 bars)
  [ [:play_grain, s_scrub, 4], [:play_kick, s_kick, 4], [:play_hats, s_hats, 4] ],
  
  # Scene 2: Freezing an electric piano, morphing grain size (4 bars)
  [ [:play_grain, s_freeze, 4], [:play_kick, s_kick, 4], [:play_hats, s_hats, 4] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
