use_bpm 60

# ==========================================================
# 1. REQUIRE ENGINE & GENERATIVE HELPER
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Generative blips (High density, random C minor)
define :gen_melody do |scale_notes, density = 0.5|
  16.times.map do
    if rand < density then scale_notes.choose else nil end
  end.ring
end

# ==========================================================
# 2. THE SCORES (C Minor Dread)
# ==========================================================
# Relentless 16th-note sub-bass pulse. 
# Notice how the amp grows from 0.3 to 1.5 over the 16 steps!
s_bass  = (ring {note: :c2, amp: 0.3}, {note: :c2, amp: 0.4}, {note: :c2, amp: 0.5}, {note: :c2, amp: 0.6},
           {note: :c2, amp: 0.7}, {note: :c2, amp: 0.8}, {note: :c2, amp: 0.9}, {note: :c2, amp: 1.0},
           {note: :c2, amp: 1.1}, {note: :c2, amp: 1.2}, {note: :c2, amp: 1.3}, {note: :c2, amp: 1.4},
           {note: :c2, amp: 1.5}, {note: :c2, amp: 1.5}, {note: :c2, amp: 1.5}, {note: :c2, amp: 1.5})
           
# Generative system failure blips
s_fm    = gen_melody((scale :c6, :minor), 0.2)

# Huge impacts on beat 1
s_kick  = (ring :c4, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil)

# Massive dark drone
s_pad   = (ring :c3, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the drone and impacts (4 bars)
  [ [:play_pad, s_pad, 4], [:play_kick, s_kick, 4] ],
  
  # Scene 2: The pulse begins (8 bars)
  [ [:play_pad, s_pad, 8], [:play_kick, s_kick, 8], 
    [:play_sub, s_bass, 8] ],
    
  # Scene 3: System failure - generative blips enter (8 bars)
  [ [:play_pad, s_pad, 8], [:play_kick, s_kick, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
