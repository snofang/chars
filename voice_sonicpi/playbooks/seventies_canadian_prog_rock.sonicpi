# ==========================================================
# PLAYBOOK: 70s CANADIAN PROG ROCK / RUSH STYLE
# (Pioneered by Rush, Yes, and Genesis)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 70s Prog Rock.
# We have explored Doom Metal and Stadium Rock, but Prog Rock is the sound 
# of technical virtuosity and complex, odd-time signatures. It fuses the 
# heavy, driving grooves of 70s hard rock with the intricate, sweeping 
# arrangements of classical music. It relies on a blistering, "galloping" 
# bassline, massive, distorted power chords, and a piercing, rapid-fire 
# "hammer-on" guitar solo that feels like a high-speed technical exercise.
#
# This playbook perfectly demonstrates how to push the engine's master 
# clock to a high tempo (160 BPM) while maintaining complex, melodic 
# precision. By using the `:play_fm` synth with an extreme `depth` for 
# distorted chords, and the `:play_lead` synth for a rapid, shredding solo, 
# the engine creates a massive, technical, and deeply energetic atmosphere.
# ==========================================================

use_bpm 160

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (E Minor - Fast, Technical, & Melodic)
# =========================================================

# The "Galloping" Kick. 
# A blistering, syncopated 16th-note gallop. (5 x's, 5 elements)
s_kick = gen_score("x..x..x.x..x....", [
  :c4, {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.6}, :c4
])

# Heavy, echoing snare strictly on beats 2 and 4. (2 x's, 1 element)
s_snare = gen_score("....x.......x...", [:c4])

# Fast, driving 16th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Galloping" Bass (E Minor).
# Plays continuous, driving 8th notes. High cutoff (100) and short release (0.1) 
# create a punchy, aggressive "thwack" that mimics a picked electric bass. (8 x's, 8 elements)
bass_notes = [:e1, :e1, :e1, :e1, :g1, :g1, :a1, :a1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 100, release: 0.1, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# Massive, "Distorted" Power Chords (E5 to G5 to A5).
# Uses :play_fm with a low divisor (2) and extreme depth (6) to create a 
# harsh, grinding hit. Plays a classic, palm-muted metal riff. (3 x's, 3 elements)
s_chords = gen_score("x.....x...x.....", [
  {note: [:e3, :b3], divisor: 2, depth: 6, release: 0.15, amp: 0.7},
  {note: [:g3, :d4], divisor: 2, depth: 6, release: 0.15, amp: 0.7},
  {note: [:a3, :e4], divisor: 2, depth: 6, release: 0.15, amp: 0.7}
])

# Piercing, "Hammer-On" Guitar Solo (E Minor Pentatonic).
# Uses :play_lead routed through the global tape echo bus. The long release (0.2) 
# and rapid, 8th-note melody create a soaring, virtuosic solo. (8 x's, 8 elements)
lead_notes = [:e5, :g5, :a5, :b5, :a5, :g5, :e5, :d5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, cutoff: 110, release: 0.2} }
s_lead = gen_score("x.x.x.x.x.x.x.x.", lead_data)

# "Battle Cry" Vocal Shout (Granular Synth).
# Using the built-in :ambi_choir sample.
# Long size (0.1) creates a raw, repetitive vocal hit. (1 x, 1 element)
s_grain = gen_score("........x.......", [
  {note: :e3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.1, amp: 0.8}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Charge - Just the galloping bass, power chords, and crowd (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Battle - Add the blistering galloping drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Solo - The piercing hammer-on guitar solo drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN TECHNICAL ROCK]
# 
# 1. The Galloping Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    every 8th note, mapping out a fast, driving line. By using a high 
#    `cutoff` (100) and a very short `release` (0.1), the engine turns the 
#    detuned sawtooth into a punchy, aggressive "thwack" that perfectly mimics 
#    the legendary, driving basslines of players like Geddy Lee.
#
# 2. FM as a Distorted Amp: Look at `s_chords`. The `:play_fm` synth is 
#    given a `divisor` of `2` and an extreme `depth` of `6`. This harsh 
#    harmonic ratio forces the FM modulator to grind the carrier wave, 
#    creating a harsh, distorted square wave. By playing palm-muted, galloping 
#    riffs, the engine perfectly mimics the aggressive rhythm guitars of 70s 
#    Prog Rock.
#
# 3. The Hammer-On Solo: The `s_lead` sequence uses the Prophet synth with 
#    a high `cutoff` (110) and a long `release` (0.2). Because it's routed 
#    through the global tape echo bus, the rapid, 8th-note notes smear into 
#    a soaring, cascading guitar solo that feels like a virtuosic, "hammer-on" 
#    run, perfectly anchoring the track's high-energy, technical atmosphere.
# ==========================================================
