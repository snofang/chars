# ==========================================================
# PLAYBOOK: PSYBIENT / PSYCHILL
# Mystical, Organic, Psychedelic Soundscapes
# ==========================================================
# [WHY THIS GENRE?]
# Psybient blends tribal percussion, massive time‑stretched
# granular textures, squelchy FM synths, and hypnotic basslines.
# This playbook captures a festival‑ready, psychedelic,
# meditative atmosphere with D Phrygian tonality and a 95 BPM
# tribal groove.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 95 BPM
# Key: D Phrygian (D, Eb, F, G, A, Bb, C)
# Rhythm: Tribal kick with ghost hits, tabla‑style snare with
# syncopation, swung shakers, rolling hypnotic bass.
# Timbre: Organic drums, deep bass with long release, lush
# swelling minor chords, liquid FM blips, cosmic granular drone
# (elec_piano time‑stretched), echoing pluck (sitar‑like).
# Arrangement: Void (drone+bass) → Ritual (add drums+chords)
# → Trip (add FM blips+pluck).
# ==========================================================

use_bpm 95

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x......x.x......", [
  :c4,
  {note: :c4, amp: 0.7},
  {note: :c4, amp: 1.0}
])

s_snare = gen_score("....x.....x.x....", [
  {note: :c4, amp: 0.5},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.6}
])

s_hats  = gen_score("x.xxx.x.x.xxx.x.", [
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3}
])

s_bass  = gen_score("x.....x.x.....x.", [
  {note: :d1,  release: 0.5},
  {note: :d1,  release: 0.5},
  {note: :eb1, release: 0.5},
  {note: :c1,  release: 0.5}
])

s_chords = gen_score("....x.........x..", [
  {note: [:d3, :f3, :a3, :c4], attack: 0.5, release: 1.5, amp: 0.7},
  {note: [:eb3, :g3, :bb3, :d4], attack: 0.5, release: 1.5, amp: 0.7}
])

s_fm     = gen_score("..x...x..x.....x.", [
  {note: :a4,  amp: 0.6, depth: 5, divisor: 3, release: 0.3},
  {note: :d5,  amp: 0.5, depth: 5, divisor: 3, release: 0.3},
  {note: :eb5, amp: 0.7, depth: 5, divisor: 3, release: 0.3},
  {note: :d5,  amp: 0.5, depth: 5, divisor: 3, release: 0.3}
])

s_grain = gen_score("x.......x.......", [
  {note: :d3, buffer: :elec_piano, pos: 0.2, density: 2, size: 0.4, amp: 0.6},
  {note: :c3, buffer: :elec_piano, pos: 0.5, density: 2, size: 0.4, amp: 0.6}
])

s_pluck = gen_score("......x........x.", [
  {note: :d5,  amp: 0.5, release: 1.0},
  {note: :eb5, amp: 0.4, release: 1.0}
])

# Playbook
playbook = (ring
  # Scene 1: The Void – cosmic drone and hypnotic bass (4 bars)
  [ [:play_grain, s_grain, 4], [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Ritual – add tribal drums and swelling chords (8 bars)
  [ [:play_grain, s_grain, 8], [:play_sub, s_bass, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Trip – liquid FM blips and echoing sitar drop (8 bars)
  [ [:play_grain, s_grain, 8], [:play_sub, s_bass, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_chords, s_chords, 8],
    [:play_fm, s_fm, 8], [:play_pluck, s_pluck, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Granular time‑stretching: size 0.4 and density 2 on
#   s_grain turn the electric piano into a massive, evolving
#   cosmic drone – 10x longer than glitchy stutters.
# - FM as liquid: depth 5 and divisor 3 produce dissonant,
#   squelchy "drips" that sound organic and psychedelic.
# - Organic swells: attack 0.5 and release 1.5 on chords
#   create a breathing, swelling atmosphere that contrasts
#   with the rigid grid.
# ==========================================================
