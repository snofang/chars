# ==========================================================
# PLAYBOOK: CINEMATIC TRAP / "ASTROWORLD" ERA
# Dark, Massive, Psychedelic Stadium Energy
# ==========================================================
# [WHY THIS GENRE?]
# Cinematic Trap (Travis Scott, Don Toliver) takes the half‑time
# 75 BPM grid and injects it with booming 808s, dark sweeping
# pads, and echoing autotuned flute melodies. This playbook
# captures that slow, suffocating, stadium‑sized atmosphere.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 75 BPM
# Key: F minor (dark, massive)
# Rhythm: Half‑time kick with syncopated ghosts (1, 'e' of 3,
# 'a' of 4), snare on beat 3, frantic trap hats with rolls,
# booming 808 on downbeats, lush chords on downbeats,
# echoing flute melody, ghostly vocal drone.
# Timbre: Heavy kick (bd_haus with accents), massive snare
# (sn_dolf), frantic hats (cymbal_closed with rolls), booming
# 808 (dsaw, long release, low cutoff), dark minor 9th chords
# (blade, slow attack, long release), autotuned flute FM
# (divisor 3, depth 1, tape echo), granular vocal drone.
# Arrangement: Void (chords+808+grain) → Groove (add drums)
# → Trip (add flute melody).
# ==========================================================

use_bpm 75

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Half‑time kick with syncopated ghosts (steps 0, 10, 14)
s_kick = gen_score("x.........x..x.",
  [{note: :c4, amp: 1.0},
   {note: :c4, amp: 0.8},
   {note: :c4, amp: 0.6}])

# Massive echoing snare on beat 3 (step 8)
s_snare = gen_score("........x.......",
  [{note: :c4, amp: 1.0}])

# Frantic trap hats with rising rolls (steps 0,3,4,5,8,11,12,13,14)
s_hats = gen_score("x..xxxx..x..xxxx",
  [{note: :c4, amp: 0.2},
   {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.4},
   {note: :c4, amp: 0.5},
   {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.4},
   {note: :c4, amp: 0.5},
   {note: :c4, amp: 0.6}])

# Booming 808 bass – long release, low cutoff (steps 0, 10, 14)
s_bass = gen_score("x.........x..x.",
  [{note: :f1, release: 1.5, cutoff: 70, amp: 1.2},
   {note: :ab1, release: 1.5, cutoff: 70, amp: 1.0},
   {note: :c2, release: 1.5, cutoff: 70, amp: 1.0}])

# Dark lush minor 9th chords – slow attack, long release (steps 0, 8)
s_chords = gen_score("x.......x.......",
  [{note: [:f3, :ab3, :c4, :eb4], cutoff: 90, attack: 0.5, release: 2.5, amp: 0.6},
   {note: [:ab3, :cb4, :eb4, :gb4], cutoff: 90, attack: 0.5, release: 2.5, amp: 0.6}])

# Echoing autotuned flute melody – tape echo (steps 4, 8, 12)
s_fm = gen_score("....x...x...x...",
  [{note: :f5, amp: 0.5, divisor: 3, depth: 1, release: 1.0},
   {note: :ab5, amp: 0.4, divisor: 3, depth: 1, release: 1.0},
   {note: :c6, amp: 0.5, divisor: 3, depth: 1, release: 1.0}])

# Ghostly vocal drone – slow evolving grain (steps 0, 8)
s_grain = gen_score("x.......x.......",
  [{note: :f3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.3, amp: 0.6},
   {note: :c3, buffer: :ambi_choir, pos: 0.4, density: 1, size: 0.3, amp: 0.6}])

# Playbook
playbook = (ring
  # Scene 1: Void – Chords + 808 + Grain
  [ [:play_chords, s_chords, 4], [:play_sub, s_bass, 4],
    [:play_grain, s_grain, 4] ],

  # Scene 2: Groove – Add Drums
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],

  # Scene 3: Trip – Add Flute Melody
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The 808 weight: release 1.5 and cutoff 70 create a booming,
#   suffocating low‑end that carries the dark melody.
# - Swelling psychedelia: attack 0.5 and release 2.5 turn chords
#   into blurred waves of dark harmony – the engine's grid
#   locks them with precision.
# - Echoing space: sparse patterns with gaps let reverb and
#   delay tails ring into the void, creating a larger‑than‑life
#   cinematic atmosphere.
# ==========================================================
