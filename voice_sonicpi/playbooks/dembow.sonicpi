use_bpm 95

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Latin / Modal)
# ==========================================================

# The "Dembow" Kick. A 3-3-2 pulse (steps 0, 3, 6, 8, 11).
s_kick  = (ring :c4, nil, nil, :c4, nil, nil, :c4, nil, :c4, nil, nil, :c4, nil, nil, nil, nil)

# The "Dembow" Snare/Woodblock. Fills the off-beats (steps 2, 5, 7, 10, 13, 15).
s_snare = (ring nil, nil, :c4, nil, nil, :c4, nil, :c4, nil, nil, :c4, nil, nil, :c4, nil, {:note => :c4, :amp => 0.6})

# Steady 8th-note hats with a slight roll at the end of the bar
s_hats  = (ring {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, 
           {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, 
           {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, 
           {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.2}, nil)

# Massive, sliding 808 bass. Long release to anchor the harmony.
s_bass  = (ring {:note => :a1, :release => 1.0}, nil, nil, nil, nil, nil, nil, nil, 
           {:note => :g1, :release => 1.0}, nil, nil, nil, nil, nil, nil, nil)

# Syncopated, Latin-style chord stabs (Am and G)
s_chords= (ring nil, [:a3, :c4, :e4], nil, nil, nil, nil, nil, [:a3, :c4, :e4], 
           nil, [:g3, :bb3, :d4], nil, nil, nil, nil, nil, [:g3, :bb3, :d4])

# Chopped, rhythmic vocal chant (Granular Synth)
s_vocal = (ring nil, nil, nil, nil, {:note => :a4, :buffer => :misc_lori, :pos => 0.4, :density => 3, :size => 0.05}, nil, nil, nil, 
           nil, nil, nil, nil, {:note => :c5, :buffer => :misc_lori, :pos => 0.6, :density => 3, :size => 0.05}, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the hypnotic Dembow rhythm (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4] ],
  
  # Scene 2: Add the massive 808 bass and guitar stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: Add the chopped vocal chants (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
