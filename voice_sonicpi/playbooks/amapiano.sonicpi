# ==========================================================
# PLAYBOOK: AMAPIANO
# Jazzy, Deep, Laid‑Back South African Groove
# ==========================================================
# [WHY THIS GENRE?]
# Amapiano (South Africa) is built on laid‑back syncopated
# kicks, dry snares, continuous shakers with rolls, punchy
# log drum bass, soulful jazzy chords, and ethereal pads.
# This playbook captures that warm, soulful, dancefloor vibe.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 115 BPM
# Key: Ab minor (jazzy, deep)
# Rhythm: Laid‑back kick (1, 'a' of 3), snare/clap on
# off‑beats (5 and 13), signature shaker with rising rolls
# on steps 5‑7 and 13‑15, log drum bass with percussive
# short release, off‑beat minor 9th chords, ethereal pad.
# Timbre: Dynamic kick (bd_haus with accents), dry snare/clap
# (sn_dolf), accented shaker (cymbal_closed with velocity rolls),
# log drum bass (dsaw, short release), soulful chords (blade),
# ethereal pad (dark_ambience).
# Arrangement: Atmosphere (pad+chords+shaker) → Beat (add
# kick+snare) → Bass (add log drum bass).
# ==========================================================

use_bpm 115

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (Ab Minor - Jazzy & Deep)
# ==========================================================

# Laid‑back kick: hits on step 0 and step 10 (syncopated)
s_kick = (
  ring :c4, nil, nil, nil, nil, nil, nil, nil, nil, nil,
       {note: :c4, amp: 0.8}, nil, nil, nil, nil, nil
)

# Dry snare/clap on heavy off‑beats (steps 5 and 13)
s_snare = (
  ring nil, nil, nil, nil, nil, {note: :c4, amp: 0.9}, nil, nil,
       nil, nil, nil, nil, nil, {note: :c4, amp: 0.8}, nil, nil
)

# Signature Amapiano shaker – continuous 16ths with rolls
s_hats = (
  ring {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15},
       {note: :c4, amp: 0.4}, {note: :c4, amp: 0.15},
       {note: :c4, amp: 0.3}, {note: :c4, amp: 0.5},
       {note: :c4, amp: 0.6}, {note: :c4, amp: 0.15},
       {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15},
       {note: :c4, amp: 0.4}, {note: :c4, amp: 0.15},
       {note: :c4, amp: 0.3}, {note: :c4, amp: 0.5},
       {note: :c4, amp: 0.6}, {note: :c4, amp: 0.7}
)

# Log drum bass – short, punchy release
s_bass = (
  ring {note: :ab1, release: 0.2}, nil, nil, nil, nil, nil,
       {note: :ab1, release: 0.2}, nil,
       nil, nil, {note: :eb1, release: 0.2}, nil, nil, nil,
       {note: :db1, release: 0.2}, nil
)

# Soulful jazzy minor 9th chords (off‑beats steps 4 and 12)
s_chords = (
  ring nil, nil, nil, nil,
       [:ab3, :c4, :eb4, :gb4], nil, nil, nil,
       nil, nil, nil, nil,
       [:db3, :f4, :ab4, :cb4], nil, nil, nil
)

# Ethereal pad – sustained drone
s_pad = (
  ring :ab2, nil, nil, nil, nil, nil, nil, nil,
       nil, nil, nil, nil, nil, nil, nil, nil
)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Atmosphere – Pad, Chords, Shaker
  [ [:play_pad, s_pad, 4], [:play_chords, s_chords, 4],
    [:play_hats, s_hats, 4] ],

  # Scene 2: Beat – Add Kick and Snare
  [ [:play_pad, s_pad, 8], [:play_chords, s_chords, 8],
    [:play_hats, s_hats, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8] ],

  # Scene 3: Bass – Add Log Drum Bass
  [ [:play_pad, s_pad, 8], [:play_chords, s_chords, 8],
    [:play_hats, s_hats, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_sub, s_bass, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The shaker rolls: rising amplitudes on steps 5‑7 and 13‑15
#   create the signature Amapiano bounce.
# - Log drum bass: short release (0.2) gives a percussive,
#   punchy feel that drives the rhythm.
# - Off‑beat chords: hitting on steps 4 and 12 (syncopated)
#   creates a soulful, jazzy harmonic pocket.
# - The pad: a sustained drone that fills the space and anchors
#   the harmonic centre.
# - Syncopated kick: the hit on step 10 (the 'a' of 3) adds
#   the characteristic laid‑back swing.
# ==========================================================
