# ==========================================================
# PLAYBOOK: 90s BUBBLEGUM DANCE / EURO-POP
# (Pioneered by Aqua, Toy-Box, and Hit'n'Hide)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Bubblegum Dance.
# We have explored 90s Eurodance and Happy Hardcore, but Bubblegum Dance 
# is the sound of pure, sugary 90s pop. It takes the relentless 4/4 grid 
# of Eurodance, adds a highly bouncy, off-beat "square wave" bass, massive 
# polka-like synth stabs, and high-pitched, cartoonish vocal chops. 
#
# This playbook perfectly demonstrates how to use the `:play_fm` synth 
# to create a bouncy, square-wave bass. By hitting strictly on the off-beats 
# with a high `cutoff`, the engine creates a relentless, sugary momentum 
# that defined late 90s European pop charts.
# ==========================================================

use_bpm 135

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (C Major - Bouncy, Bright, & Sugary)
# ==========================================================

# Relentless, driving 4-on-the-floor kick.
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, dry rave clap strictly on beats 2 and 4.
s_clap = gen_score("....x.......x...", [:c4])

# Off-beat open hats to drive the momentum.
s_hats = gen_score("..x...x...x...x.", [{note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}])

# The "Bubblegum" Bounce Bass (C Major).
# Hits strictly on the off-beats. High cutoff (100) and very short release (0.15) 
# create a relentless, bouncy, square-wave-like "pump".
bass_notes = [:c2, :c2, :g1, :c2, :c2, :c2, :g1, :c2]
bass_data = bass_notes.map { |n| {note: n, release: 0.15, cutoff: 100, amp: 1.0} }
s_bass = gen_score("..x...x...x...x.", bass_data)

# Massive, "Polka/Horn" Synth Stabs (C to G).
# Hit strictly on the off-beats in sync with the bass. High cutoff (110) 
# and short release (0.2) give them a piercing, festival-sized wall of sound.
chord_notes = [
  {note: [:c3, :e3, :g3]}, {note: [:c3, :e3, :g3]}, 
  {note: [:g2, :b2, :d3]}, {note: [:c3, :e3, :g3]}
]
chord_data = chord_notes.map { |c| c.merge({cutoff: 110, release: 0.2, amp: 0.6}) }
s_chords = gen_score("..x...x...x...x.", chord_data)

# Catchy, "Cartoon" Synth Lead (C Major Pentatonic).
# Uses :play_fm with a low divisor (2) and depth (3) to create a sharp, 
# buzzy square wave that plays a rapid, 16th-note melody.
lead_notes = [:c5, :e5, :g5, :e5, :c5, :d5, :g4, :c5, 
              :c5, :e5, :g5, :c6, :b5, :g5, :e5, :d5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 3, release: 0.1} }
s_lead = gen_score("x.x.x.x.x.x.x.x.", lead_data)

# High-pitched, "Sugary" vocal stutter (Granular Synth).
# Pitched UP to :c5 and :g4. High density, tiny size = a sharp, sugary vocal skip.
vocal_notes = [:c5, :g4]
vocal_data = vocal_notes.map { |n| {note: n, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.6} }
s_vocal = gen_score("....x.......x...", vocal_data)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the kick, bounce bass, and hats (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_hats, s_hats, 4] ],
  
  # Scene 2: The Vibe - Add the heavy claps and massive synth stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8], 
    [:play_snare, s_clap, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Drop - The catchy cartoon lead and vocal chops drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8], 
    [:play_snare, s_clap, 8], [:play_chords, s_chords, 8], 
    [:play_lead, s_lead, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN SUGARY POP]
# 
# 1. The Off-Beat Bounce: Look at `s_bass`, `s_hats`, and `s_chords`. They 
#    ALL hit strictly on steps 2, 6, 10, and 14. In a 16-step grid, these 
#    are the exact midpoints between the kicks. The engine's strict master 
#    clock locks these together perfectly at 135 BPM, creating a massive, 
#    bouncing "boom-cha" momentum that forces you to dance.
#
# 2. The Square-Wave Bass: Look at `s_bass`. The `:play_sub` synth is given 
#    a high `cutoff` (100) and a very short `release` (0.15). This strips 
#    away the sub-frequencies and cuts the note off instantly, turning the 
#    detuned sawtooth into a sharp, bouncy "thwack" that perfectly mimics 
#    the cheap, square-wave bass presets of 90s Bubblegum Dance.
#
# 3. Cartoonish FM: The `s_lead` sequence uses `divisor: 2` and `depth: 3`. 
#    This harmonic ratio produces a sharp, buzzy square wave that plays a 
#    rapid, 16th-note melody. By routing it through the tape echo, the 
#    engine creates a catchy, cascading soundscape that perfectly mimics 
#    the cartoonish, high-energy synth leads of acts like Aqua and Toy-Box.
# ==========================================================
