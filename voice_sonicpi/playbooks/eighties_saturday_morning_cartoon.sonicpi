# ==========================================================
# PLAYBOOK: 80s SATURDAY MORNING CARTOON / ACTION HERO
# (Pioneered by Shuki Levy, Haim Saban, and Udi Harpaz)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose the 80s Saturday Morning Cartoon theme.
# We have explored 80s Synth-Rock and 16-Bit Platformers, but the 80s Cartoon Theme 
# is the sound of pure, unadulterated childhood adrenaline. It fuses the driving, 
# galloping rock beats of arena metal with bright, piercing synthesizer arpeggios, 
# massive "brass" synth stabs, and a soaring, echoing "heroic" guitar solo that 
# feels like transforming into a superhero and flying into battle.
#
# This playbook perfectly demonstrates how to push the engine to create a massive, 
# high-energy, and deeply nostalgic rock-pop atmosphere. By using a relentless, 
# octave-jumping 16th-note bass and routing a piercing FM lead through the global 
# tape echo, the engine creates a massive, heroic, and undeniably 80s groove.
# ==========================================================

use_bpm 140

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (E Minor - Fast, Heroic, & Driving)
# ==========================================================

# Driving rock kick. Hits on 1, 2, 3, and 4. (4 x's, 4 elements)
s_kick = gen_score("x...x...x...x...", [:c4, :c4, :c4, :c4])

# Heavy, echoing snare strictly on beats 2 and 4, with a 16th roll at the end. 
# (4 x's, 4 elements)
s_snare = gen_score("....x.......x.xx", [
  :c4, :c4, {note: :c4, amp: 0.5}, {note: :c4, amp: 0.7}
])

# Fast, driving 16th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Octave-Jumping" Bass (E Minor).
# Plays continuous 16th notes, alternating octaves. 
# High cutoff (110) and microscopic release (0.06) create a relentless, 
# driving, bouncy churn. (16 x's, 16 elements)
bass_notes = [:e1, :e1, :e2, :e1, :e1, :e1, :e2, :e1, 
              :c2, :c2, :c3, :c2, :d2, :d2, :d3, :d2]
bass_data = bass_notes.map { |n| {note: n, cutoff: 110, release: 0.06, amp: 1.0} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Stark, "Brass Section" Stabs (Em to C to D).
# Uses :play_fm with a low divisor (2) and extreme depth (5) to create a 
# harsh, brassy hit. Hit strictly on the off-beats. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:e3, :g3, :b3], divisor: 2, depth: 5, release: 0.15, amp: 0.6},
  {note: [:e3, :g3, :b3], divisor: 2, depth: 5, release: 0.15, amp: 0.6},
  {note: [:c3, :e3, :g3], divisor: 2, depth: 5, release: 0.15, amp: 0.6},
  {note: [:d3, :fs3, :a3], divisor: 2, depth: 5, release: 0.15, amp: 0.6}
])

# Piercing, "Heroic" Lead (E Minor Pentatonic).
# Uses :play_lead routed through the global tape echo bus. The long release (0.2) 
# creates a soaring, echoing, heroic melody. (8 x's, 8 elements)
lead_notes = [:e5, :g5, :a5, :b5, :a5, :g5, :e5, :d5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, cutoff: 110, release: 0.2} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Ahh" Vocal Drone (Granular Synth).
# Using the built-in :ambi_choir sample.
# High density, tiny size = a sharp, pristine vocal skip. (1 x, 1 element)
s_vocal = gen_score("........x.......", [
  {note: :e4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the octave bass, brass stabs, and vocal (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Verse - Add the driving rock drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chorus - The piercing heroic lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN CHILDHOOD ADRENALINE]
# 
# 1. Algorithmic Octave Bass: Look at `s_bass`. Instead of typing 16 
#    repetitive Hashes, we define an array `bass_notes` that alternates 
#    between the low octave (:e1) and the high octave (:e2). We then use 
#    `.map` to inject the default parameters into every step. This creates 
#    the relentless, driving 16th-note "gallop" that defines high-energy 
#    80s cartoon themes, with zero repetitive code.
#
# 2. FM as a Brass Section: The `s_chords` sequence uses `divisor: 2` and 
#    `depth: 5`. This harsh harmonic ratio produces a bright, brassy, 
#    saw-like wave that cuts through the heavy mix. By hitting strictly on 
#    the off-beats, the engine perfectly mimics the massive synth-brass 
#    stabs used in shows like *Transformers* and *ThunderCats*.
#
# 3. The Heroic Solo: The `s_lead` sequence uses the Prophet synth with 
#    a high `cutoff` (110) and a long `release` (0.2). Because it's routed 
#    through the global tape echo bus, the sparse notes smear into a soaring, 
#    cascading guitar solo that feels like the hero arriving to save the day, 
#    perfectly anchoring the track's massive, nostalgic atmosphere.
# ==========================================================
