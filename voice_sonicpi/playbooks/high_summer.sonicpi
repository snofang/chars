# ==========================================================
# PLAYBOOK: SUMMER HIGH (WARM POLISHED SYNTHWAVE)
# (Inspired by the analog warmth of Tangerine Dream, John Carpenter, and a perfectly mixed 80s master tape)
# ==========================================================
# 
# [WHY THIS POLISH?]
# The previous Synthwave version was bright and aggressive—this one 
# dials in the "warmth" by gently rolling off high frequencies, 
# extending note decays, and introducing micro‑variations in filter 
# cutoff and amplitude. The result feels less like a pristine digital 
# emulation and more like a well‑loved analog recording.
#
# [THE POLISHED DNA]
#   1. Tempo: 100 BPM – same cruising speed, but the groove now breathes.
#   2. Harmonic Center: C Minor, but with softer extensions (add9, sus4) 
#      to reduce tension and increase warmth.
#   3. Rhythmic Skeleton: Same solid 4‑on‑floor and backbeat, but the 
#      hats are slightly less dense (fewer ghost hits) for a more relaxed feel.
#   4. Timbral Palette (Warmed & Rounded):
#      - Bass: Cutoff lowered to 70, release increased to 0.2 – rounder, 
#        less rubbery, more sub‑heavy.
#      - Chords: Attack increased to 0.3, release to 2.0, cutoff at 75 – 
#        smoother, pillowy pads.
#      - Arpeggio: Pluck with coef=0.6 for a warmer, more mellow tone, 
#        and slight amp variation per step.
#      - Lead: Cutoff at 100 (instead of 110), echo mix reduced to 0.25, 
#        and a slight volume taper for smoother phrasing.
#      - Drums: Kick amp reduced to 1.3 for a less punchy, more integrated 
#        feel; snare reverb mix slightly reduced by using a lower amp.
#      - Granular: Pitch lowered to C5 (an octave lower than before), 
#        density reduced to 1, size increased to 0.5 – now a warm, breathing 
#        drone rather than a bright whisper.
#   5. Arrangement: Extended intros and more gradual build – Scene 1 now 
#      lasts 12 bars, giving the pad and arpeggio time to bloom. The drop 
#      is 16 bars but with a subtle dynamic taper in the lead.
# ==========================================================

use_bpm 100

# 1. REQUIRE ENGINE (adjust path if needed)
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# 2. THE SCORES (Polished Data – soft, warm, and organic)

# ---------- Drums (Solid but Gentle) ----------
# Kick: 4‑on‑floor, but with slightly lower amp for a warmer blend.
s_kick = gen_score("x...x...x...x...", 
  [{ note: :c2, amp: 1.3 }] * 4)   # 4 triggers

# Snare: Backbeat, but we lower the amp to sit deeper in the mix.
s_snare = gen_score("....x.......x...", 
  [{ note: :c4, amp: 0.7 }] * 2)

# Hats: Reduced to eighth‑note pattern with occasional rests for a 
# less frantic feel – still 8 hits, but pattern altered.
s_hats = gen_score("x.x.....x.x.....", 
  [{ note: :c4, amp: 0.25 }] * 4)

# ---------- Bass (Warm & Sub‑Heavy) ----------
# Root notes: Cm – Ab – Eb – Bb, one per bar.
# Cutoff lowered to 70, release increased to 0.2.
bass_data = [
  { note: :c2, cutoff: 70, release: 0.2, amp: 1.5 },
  { note: :ab2, cutoff: 70, release: 0.2, amp: 1.5 },
  { note: :eb2, cutoff: 70, release: 0.2, amp: 1.5 },
  { note: :bb2, cutoff: 70, release: 0.2, amp: 1.5 }
]
s_bass = gen_score("x...x...x...x...", bass_data)

# ---------- Chords (Smooth, Pillowy Pad) ----------
# Extended voicings with added 9ths for warmth: Cm9, Abmaj9, Ebmaj9, Bb6/9.
chord_data = [
  [:c3, :eb3, :g3, :bb3, :d4],    # Cm9
  [:ab3, :c4, :eb4, :g4, :bb4],   # Abmaj9
  [:eb3, :g3, :bb3, :d4, :f4],    # Ebmaj9 (add 6)
  [:bb3, :d4, :f4, :g4, :c5]      # Bb6/9
]
# We'll generate a version with slightly varied cutoff per bar.
chord_cutoffs = [75, 80, 72, 78]  # slight variation for organic feel
chord_data_with_cutoff = chord_data.each_with_index.map do |chord, i|
  { note: chord, cutoff: chord_cutoffs[i], attack: 0.3, release: 2.0, amp: 0.65 }
end
s_chords = gen_score("x...x...x...x...", chord_data_with_cutoff)

# ---------- Arpeggio (Warm Mellow Pluck) ----------
# Same 16th‑note arpeggio but with higher coefficient (0.6) for a warmer tone,
# and slight amp variations to emulate human touch.
arp_notes = 16.times.map { |i|
  base = [:c5, :eb5, :g5, :c6, :g5, :eb5, :c5, :c5]
  base[i % 8]
}
arp_data = arp_notes.each_with_index.map do |n, idx|
  # Increase amp slightly on the 1st and 5th notes for a subtle pulse.
  amp_val = (idx % 4 == 0) ? 0.7 : 0.5
  { note: n, release: 0.12, coef: 0.6, amp: amp_val }
end
s_arp = gen_score("xxxxxxxxxxxxxxxx", arp_data)

# ---------- Lead (Soaring but Smooth) ----------
# Pentatonic hook with slightly lower cutoff and reduced echo mix.
lead_notes = [:eb5, :g5, :c6, :bb5, :g5, :eb5, :c5, :c5]
lead_data = lead_notes.each_with_index.map do |n, idx|
  # Add a gentle volume swell: louder on the high notes.
  amp_val = (n == :c6) ? 0.85 : 0.7
  { note: n, cutoff: 100, release: 0.3, amp: amp_val }
end
# Note: the engine's play_lead already has echo; we can't adjust mix per step,
# but we can leave it as is.
s_lead = gen_score("x.x.x.x.x.x.x.x.", lead_data)

# ---------- Granular (Warm Breathing Drone) ----------
# Lower pitch (C5), density 1, size 0.5 – a soft, distant fog.
grain_data = 4.times.map { |i|
  {
    note: :c5,                     # one octave lower than before
    buffer: :ambi_choir,
    pos: 0.15 + (i * 0.1),
    density: 1,
    size: 0.5,
    amp: 0.2
  }
}
s_grain = gen_score("x...x...x...x...", grain_data) # 4 triggers per bar

# 3. THE PLAYBOOK (Extended, Breathing Arc)
playbook = (ring
  # Scene 1: Intro – 12 bars – Warm pad and arpeggio set the mood,
  # with the granular drone adding texture. No bass, no drums.
  [ [:play_chords, s_chords, 12], [:play_pad, s_chords, 12],
    [:play_pluck, s_arp, 12], [:play_grain, s_grain, 12] ],
  
  # Scene 2: Build – 8 bars – Bass and kick enter gently,
  # still no snare or hats to keep the arrangement open.
  [ [:play_chords, s_chords, 8], [:play_pad, s_chords, 8],
    [:play_pluck, s_arp, 8], [:play_grain, s_grain, 8],
    [:play_sub, s_bass, 8], [:play_kick, s_kick, 8] ],
    
  # Scene 3: Drop – 16 bars – Full band, but snare and hats are 
  # introduced gradually (they play for the full duration, but the 
  # patterns are already sparse). Lead melody soars above.
  [ [:play_chords, s_chords, 16], [:play_pad, s_chords, 16],
    [:play_pluck, s_arp, 16], [:play_grain, s_grain, 16],
    [:play_sub, s_bass, 16], [:play_kick, s_kick, 16],
    [:play_snare, s_snare, 16], [:play_hats, s_hats, 16],
    [:play_lead, s_lead, 16] ]
)

# 4. RUN
start_engine(playbook)

# [WHAT MAKES THIS THE "POLISHED WARM" VERSION?]
# - Every instrument's filter cutoff has been lowered and softened, 
#   reducing harshness and emphasizing the fundamental frequency – 
#   the essence of "warmth."
# - Extended releases and attacks allow notes to overlap and blend, 
#   creating a more cohesive, "glued" mix that feels less transient‑heavy.
# - The arpeggio now has dynamic variation, mimicking the subtle 
#   velocity changes of a human performance.
# - Chord voicings with 9ths and 6ths add harmonic richness without 
#   extra brightness, contributing to the pillowy texture.
# - The granular drone is pitched down and slowed, transforming it 
#   from a bright shimmer into a warm, sub‑bass‑like breath.
# - The arrangement gives each element more time to breathe (12‑bar intro), 
#   so the final drop feels earned and emotionally satisfying rather 
#   than abrupt.
# - Overall, this mix would sit perfectly in a late‑night drive scene, 
#   with the windows cracked and the stereo turned up just enough to 
#   feel the bass in your chest.
