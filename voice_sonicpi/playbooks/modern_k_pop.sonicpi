# ==========================================================
# PLAYBOOK: MODERN K-POP / EDM DANCE BREAK
# (Pioneered by BLACKPINK, BTS, and EXO)
# ==========================================================
# [WHY THIS GENRE?]
# K‑Pop fuses heavy Trap/Bass with massive Supersaws and pristine
# vocal stutters. This playbook delivers a stadium‑sized drop
# with a rhythmic 808 bass, off‑beat supersaw chords, and a rising
# hi‑hat roll that builds festival‑ready energy.
# [DNA: 120 BPM, F# minor, 4/4 kick, rhythmic 808, off‑beat
#  supersaws, piercing FM lead, vocal stutter, dynamic hat roll]
# ==========================================================

use_bpm 120

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# ----------------------------------------------------------
# SCORES – Normalized with gen_score & DRY parameters
# ----------------------------------------------------------

# Driving 4/4 kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy pop clap on beats 2 and 4
s_clap = gen_score("....x.......x...", [:c4])

# Rising hi‑hat roll – amplitudes increase toward the end
hat_amps = [0.3, 0.2, 0.3, 0.4, 0.3, 0.2, 0.5, 0.6, 0.7, 0.8]
s_hats  = gen_score("x.xx.xx.xx.xxxxx",
  hat_amps.map { |amp| {note: :c4, amp: amp} })

# Rhythmic 808 bass – syncopated melody with short release
bass_notes = [:fs1, :fs1, :a1, :fs1, :fs1, :e1]
s_bass = gen_score("x..x..x.x..x..x.",
  bass_notes.map { |n| {note: n, release: 0.3} })

# Wide off‑beat supersaw chords (F#m – A – E) – high cutoff
chord_prog = [[:fs3, :a3, :c4],
              [:fs3, :a3, :c4],
              [:a3,  :c4, :e4],
              [:e3,  :g3, :b3]]
s_chords = gen_score("..x...x...x...x.",
  chord_prog.map { |c| {note: c, cutoff: 110, release: 0.5, amp: 0.6} })

# Bright FM lead (square wave) – low divisor, medium depth
fm_notes = [:fs5, :a5, :c6, :fs5, :e5, :d5, :c5]
fm_defaults = {divisor: 2, depth: 3, release: 0.1}
s_fm = gen_score("x..x.x..x..x.x.x",
  fm_notes.map { |n| {note: n, amp: 0.6, **fm_defaults} })

# Pristine vocal stutter – high density, tiny grains
vocal_hits = [{note: :fs4, pos: 0.2},
              {note: :a4,  pos: 0.4}]
s_vocal = gen_score("....x.......x..",
  vocal_hits.map { |h| {note: h[:note], buffer: :ambi_choir,
                        pos: h[:pos], density: 3, size: 0.03, amp: 0.6} })

# ----------------------------------------------------------
# PLAYBOOK – In‑line and readable
# ----------------------------------------------------------
playbook = (ring
  # Scene 1 – The Build: kick, bass, and vocal chops (4 bars)
  [ [:play_kick, s_kick, 4],
    [:play_sub, s_bass, 4],
    [:play_grain, s_vocal, 4] ],

  # Scene 2 – The Vibe: add claps and rolling hats (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_sub, s_bass, 8],
    [:play_grain, s_vocal, 8],
    [:play_snare, s_clap, 8],
    [:play_hats, s_hats, 8] ],

  # Scene 3 – The Drop: massive supersaws and FM lead (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_sub, s_bass, 8],
    [:play_grain, s_vocal, 8],
    [:play_snare, s_clap, 8],
    [:play_hats, s_hats, 8],
    [:play_chords, s_chords, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# 1. Dance Break Roll – amplitudes in the hat pattern rise from
#    0.2 to 0.8, creating a machine‑gun roll that builds tension.
# 2. Supersaw Wall – off‑beat chords with cutoff 110 produce a
#    bright, soaring contrast to the deep 808 bass.
# 3. Rhythmic 808s – the bass plays a syncopated melody with a
#    short release (0.3), locking tightly with the kick for a
#    heavy, bouncing low‑end that defines modern pop/trap.
# ==========================================================
