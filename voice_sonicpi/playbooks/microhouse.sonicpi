# ==========================================================
# PLAYBOOK: MICROHOUSE / CLICKS & CUTS
# (Pioneered by Ricardo Villalobos, Akufen, and Pantytec)
# ==========================================================
# 
# [WHY THIS GENRE?]
# We have explored massive, dense walls of sound (Hyperpop, Drone Metal, 
# Shoegaze). Microhouse does the exact opposite. It strips away all 
# conventional melody and weight, leaving behind only microscopic audio 
# "glitches," ultra-clean sine waves, and massive, suffocating sub-bass. 
# It relies on extreme sparsity, ultra-low amplitudes, and granular textures 
# that sound like digital dust ticking in a sterile, empty room.
#
# [THE CAREFULLY DESCRIBED DNA]
# 1. Tempo: 125 BPM. A standard house tempo, but feels slower due to sparsity.
# 2. Harmonic Center: A Minor. Clinical, cold, and pristine.
# 3. Rhythmic Skeleton: A soft 4/4 kick. The groove is carried by tiny, 
#    erratic "micro-clicks" and glitching hi-hats at very low volumes.
# 4. Timbral Palette:
#    - Bass: Deep, round, continuous Moog-style sub-bass (extreme low cutoff).
#    - Chords: Stark, dissonant 2-note clusters, very low amplitude.
#    - Lead: Pure, pristine sine-wave FM bleeps.
#    - Texture: Granular "digital dust" (extreme density, microscopic size).
# 5. Arrangement: Intro (Sub-bass/Texture) -> Verse (Sparse Drums) -> Chorus (Bleeps).
# ==========================================================

use_bpm 125

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Clinical, Sparse, & Microscopic)
# ==========================================================

# The "Accent" Kick. 
# Ultra-sparse, low amplitude. Just a pulse in the digital void. (2 x's, 2 elements)
s_kick = gen_score("x.......x.......", [
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.3}
])

# The "Micro-Clicks" (Hi-Hats).
# Amplitudes are pushed down to 0.05 to simulate digital dust. (6 x's, 6 elements)
s_hats = gen_score("x..x.x..x..x.x..", [
  {note: :c4, amp: 0.05}, {note: :c4, amp: 0.08}, {note: :c4, amp: 0.04}, 
  {note: :c4, amp: 0.06}, {note: :c4, amp: 0.05}, {note: :c4, amp: 0.07}
])

# Deep, massive "Sub-Bass" Drone (A Minor).
# Massive release (4.0) and extreme low cutoff (40) create a deep, 
# continuous, suffocating rumble. (1 x, 1 element)
s_bass = gen_score("x...............", [
  {note: :a1, release: 4.0, cutoff: 40, amp: 1.0}
])

# Stark, "Digital" Chords (A Dorian).
# Hit on the downbeats. Very low amplitude and microscopic release.
# (2 x's, 2 elements)
s_chords = gen_score("x.......x.......", [
  {note: [:a4, :bb4], cutoff: 100, release: 0.05, amp: 0.2},
  {note: [:e4, :f4], cutoff: 100, release: 0.05, amp: 0.2}
])

# Piercing, "Sine" Bleeps (A Minor Pentatonic).
# Uses :play_fm with a low divisor (1) and zero depth (0) to create a pure, 
# pristine sine wave. Microscopic release (0.02) makes them sound like radar pings.
# (3 x's, 3 elements)
s_fm = gen_score("..x.....x.....x.", [
  {note: :a6, amp: 0.4, divisor: 1, depth: 0, release: 0.02}, 
  {note: :e6, amp: 0.3, divisor: 1, depth: 0, release: 0.02}, 
  {note: :c6, amp: 0.4, divisor: 1, depth: 0, release: 0.02}
])

# "Digital Dust" Texture (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched UP.
# Extreme density (8) and microscopic size (0.01) shatter the sample into 
# high-frequency, digital static. (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :a5, buffer: :ambi_choir, pos: 0.9, density: 8, size: 0.01, amp: 0.2}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Void - Just the sub-bass drone, digital chords, and dust (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Matrix - Add the sparse, microscopic drum clicks (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Signal - The pure sine-wave bleeps drop (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_hats, s_hats, 8], 
    [:play_fm, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN MINIMALISM]
# 
# 1. Microscopic Dynamics: Look at `s_hats`. The amplitudes are incredibly 
#    low (0.05 to 0.08). Because the engine's strict master clock fires these 
#    tiny hits with absolute precision, they don't sound like a drum beat; 
#    they sound like digital dust or static clicking in the background of a 
#    hard drive.
#
# 2. Pure Sine Waves: Look at `s_fm`. The `:play_fm` synth is given a 
#    `divisor` of `1` and a `depth` of `0`. This strips away all harmonic 
#    overtones, leaving only a pristine, mathematical sine wave. By using a 
#    microscopic `release` (0.02), the engine creates cold, clinical radar 
#    pings that cut through the sub-bass.
#
# 3. Extreme Sub-Weight: Look at `s_bass`. The `:play_sub` synth is given a 
#    massive `release` of `4.0` (four whole beats) and an extreme low `cutoff` 
#    of `40`. This creates a continuous, suffocating rumble that anchors the 
#    erratic, microscopic high-frequency clicks, perfectly mimicking the 
#    Ricardo Villalobos / Akufen aesthetic.
# ==========================================================
