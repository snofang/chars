# ==========================================================
# PLAYBOOK: 90s SHOEGAZE / DREAM POP
# Ethereal Walls of Sound, Driving Motorik Beats
# ==========================================================
# [WHY THIS GENRE?]
# Shoegaze (My Bloody Valentine, Slowdive) blends massive,
# sustained guitar distortion with rigid, repetitive rhythms.
# This playbook captures that cavernous, dreamlike wash.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 120 BPM
# Key: C# Major (bright, ethereal)
# Rhythm: Motorik 4/4 kick, snare on 2/4, relentless 16th hats,
# continuous 16th bass.
# Timbre: Swelling chords (blade, long attack/release), picked
# bass (dsaw, high cutoff), clean guitar (fm, divisor 2),
# vocal drone (grain, long size).
# Arrangement: Dream (chords+bass+grain) → Drive (drums enter)
# → Melody (clean guitar enters).
# ==========================================================

use_bpm 120

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores

# Motorik 4/4 kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy snare on beats 2 and 4
s_snare = gen_score("....x.......x...", [:c4])

# Relentless 16th hats with velocity accents
s_hats = gen_score("x.x.x.x.x.x.x.x.",
  [{note: :c4, amp: 0.2}, {note: :c4, amp: 0.15},
   {note: :c4, amp: 0.25}, {note: :c4, amp: 0.15}])

# Driving picked bass – 16th notes, high cutoff for attack
bass_notes = [:cs2, :cs2, :cs3, :cs2, :cs2, :cs2, :e2, :cs2,
              :a1, :a1, :a2, :a1, :b1, :b1, :e2, :b1]
s_bass = gen_score("xxxxxxxxxxxxxxxx",
  bass_notes.map { |n| {note: n, cutoff: 100, release: 0.1} })

# Wall of sound chords – only two trigger positions, data has two elements
chord_data = [
  {note: [:cs3, :e3, :gs3, :b3], attack: 0.5, release: 2.0, cutoff: 110, amp: 0.7},
  {note: [:a2, :cs3, :e3, :gs3], attack: 0.5, release: 2.0, cutoff: 110, amp: 0.7}
]
s_chords = gen_score("x.......x.......", chord_data)

# Clean guitar melody – FM with low divisor, routed through echo
s_fm = gen_score("......x......x.",
  [{note: :gs4, amp: 0.5, divisor: 2, depth: 1, release: 1.0},
   {note: :e4, amp: 0.4, divisor: 2, depth: 1, release: 1.0}])

# Vocal drone – long grain, slow evolution
s_grain = gen_score("x.......x.......",
  [{note: :cs4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.4, amp: 0.5},
   {note: :a4, buffer: :ambi_choir, pos: 0.6, density: 1, size: 0.4, amp: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Dream – Chords, Bass, Grain
  [ [:play_chords, s_chords, 4], [:play_sub, s_bass, 4],
    [:play_grain, s_grain, 4] ],

  # Scene 2: Drive – Drums enter
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],

  # Scene 3: Melody – Clean guitar enters
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_fm, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The long attack (0.5) and release (2.0) on s_chords blur
#   the chords into a continuous, swelling wave – the "Wall
#   of Sound" that defines shoegaze.
# - The rigid 16th bass and drums anchor the ethereal textures,
#   creating the signature motorik drive.
# - The grain drone with density 1 and size 0.4 time‑stretches
#   the choir into a distant, cathedral‑like ambient tail.
# ==========================================================
