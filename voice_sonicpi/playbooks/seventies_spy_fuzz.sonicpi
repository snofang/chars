# ==========================================================
# PLAYBOOK: 70s SPY FUZZ / CRIME CINEMA
# (Pioneered by Lalo Schifrin, Isaac Hayes, and John Barry)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 70s Spy Fuzz.
# We have explored Funk and Outlaw Country, but Spy Fuzz is the sound 
# of 1970s crime cinema and secret agents. It relies on a tense, 
# driving 16th-note bassline, tight, staccato brass/horn stabs, 
# syncopated "limo" drums, and a piercing, echoing guitar twang 
# drenched in spring reverb.
#
# This playbook perfectly demonstrates how to use the `gen_score` helper 
# to algorithmically generate a continuous, tense 16th-note bassline, 
# and how to use the `:play_lead` synth routed through the global tape 
# echo to simulate the cavernous, twangy guitar of a 70s spy thriller.
# ==========================================================

use_bpm 115

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (E Minor - Tense, Driving, & Cinematic)
# ==========================================================

# The "Limo" Kick. 
# Syncopated, driving march. Hits on step 0, the 'and' of 2 (step 6), and beat 3 (step 8).
s_kick = gen_score("x.....x.x.......", [:c4, {note: :c4, amp: 0.8}, :c4])

# Crisp, tight snare/rimshot strictly on beats 2 and 4, with a ghost note.
s_snare = gen_score("....x.....x.x...", [:c4, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.9}])

# Rigid, driving 16th hats.
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}, 
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.1}
])

# The "Tense" Bass (E Minor).
# Plays continuous 16th notes, alternating octaves. 
# High cutoff (100) and microscopic release (0.08) create a relentless, 
# aggressive churn that drives the scene forward.
bass_notes = [:e1, :e2, :e1, :e2, :e1, :e2, :e1, :e2, 
              :d1, :d2, :d1, :d2, :c1, :c2, :b0, :b1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 100, release: 0.08, amp: 1.2} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Tight, "Brass Section" Stabs (Em to Cmaj to B).
# Uses :play_fm with a low divisor (2) and extreme depth (4) to create a sharp, 
# buzzy staccato hit that mimics a live horn section.
chord_notes = [
  {note: [:e3, :g3, :b3]}, {note: [:e3, :g3, :b3]}, 
  {note: [:c3, :e3, :g3]}, {note: [:b2, :d3, :fs3]}
]
chord_data = chord_notes.map { |c| c.merge({divisor: 2, depth: 4, release: 0.1, amp: 0.6}) }
s_chords = gen_score("..x.....x.....x.", chord_data)

# Piercing, "Twangy Guitar" Lead (E Minor Pentatonic).
# Uses :play_lead routed through the global tape echo. The long release (0.4) 
# and massive gaps (`nil`) create a tense, cavernous melody that mimics a 
# echoing electric guitar.
lead_notes = [:e5, :d5, :e5, :b4, :a4, :g4, :a4, :b4]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, cutoff: 90, release: 0.4} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# Ominous, "Suspense" drone (Granular Synth).
# Long size (0.4) and low density (1) creates a slow, evolving background 
# texture that sounds like a distant, echoing cavern.
s_grain = gen_score("x...............", [
  {note: :e3, buffer: :ambi_choir, pos: 0.4, density: 1, size: 0.4, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Stakeout - Just the tense bass, brass stabs, and drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Getaway - Add the syncopated limo drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Confrontation - The piercing twangy guitar lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN CINEMATIC TENSION]
# 
# 1. The Relentless Churn: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step, alternating between the low octave (:e1) and the 
#    high octave (:e2). By using a high `cutoff` (100) and a microscopic 
#    `release` (0.08), the engine turns the detuned sawtooth into a relentless, 
#    aggressive churn that perfectly mimics the driving, tension-filled basslines 
#    of 70s crime cinema.
#
# 2. FM as a Horn Section: Look at `s_chords`. The `:play_fm` synth is given 
#    a `divisor` of `2` and an extreme `depth` of `4`, with a microscopic 
#    `release` (0.1). This forces the FM synth to produce a sharp, buzzy, 
#    staccato "hit" that perfectly mimics a live brass section punching through 
#    the mix on the off-beats.
#
# 3. Echoing Suspense: The `s_lead` sequence plays a simple E minor pentatonic 
#    melody, but leaves massive gaps (`nil`) between the notes. Because the 
#    engine routes the `:play_lead` synth through the global tape echo, those 
#    empty spaces are filled by delay tails, creating a cavernous, echoing 
#    soundscape that feels like walking down a dark, empty alleyway.
# ==========================================================
