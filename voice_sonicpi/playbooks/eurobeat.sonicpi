# ==========================================================
# PLAYBOOK: 90s/2000s EUROBEAT / INITIAL D
# (Pioneered by Dave Rodgers, Maurizio De Jorio, and SEB)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s/2000s Eurobeat.
# We have explored Eurodance and Hi-NRG, but Eurobeat is the sound of 
# high-speed Japanese street racing. It pushes the tempo to a frantic 155 BPM 
# and relies on a relentless, driving 4/4 beat, a continuous, octave-jumping 
# 16th-note "gallop" bass, massive off-beat synth brass stabs, and rapid, 
# piercing FM arpeggios that feel like drifting a Toyota AE86 around a hairpin turn.
#
# This playbook perfectly demonstrates the sheer speed and momentum possible 
# with the DRY `gen_score` helper. By algorithmically generating an octave-jumping 
# 16th-note bassline with Ruby's `.map`, the engine creates an unstoppable, 
# high-energy wall of sound with zero repetitive code.
# ==========================================================

use_bpm 155

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Fast, Driving, & High Energy)
# ==========================================================

# Relentless, driving 4-on-the-floor kick.
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, dry snare strictly on beats 2 and 4.
s_snare = gen_score("....x.......x...", [:c4])

# Off-beat open hats to drive the momentum.
s_hats = gen_score("..x...x...x...x.", [{note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}])

# The "Gallop" Bass (A Minor).
# DRY: Generate 16 continuous 16th notes with alternating octaves automatically.
bass_cycle = [:a1, :a2, :a1, :a2, :a1, :a2, :e1, :e2, 
              :g1, :g2, :g1, :g2, :a1, :a2, :e1, :e2]
bass_data = bass_cycle.map { |n| {note: n, cutoff: 100, release: 0.1, amp: 1.0} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Massive, "Synth Brass" Stabs (Am to G to F to G).
# Hit strictly on the off-beats. High cutoff (120) and short release (0.15) 
# create a sharp, aggressive wall of sound.
chord_notes = [
  {note: [:a3, :c4, :e4]}, {note: [:g3, :bb3, :d4]}, 
  {note: [:f3, :a3, :c4]}, {note: [:g3, :bb3, :d4]}
]
chord_data = chord_notes.map { |c| c.merge({cutoff: 120, release: 0.15, amp: 0.6}) }
s_chords = gen_score("..x...x...x...x.", chord_data)

# Piercing, "Speed" Arpeggio Lead (A Minor Pentatonic).
# DRY: Define just the notes, merge default opts automatically.
lead_notes = [:a5, :e5, :c6, :e5, :a5, :e5, :c6, :e5, 
              :g5, :d5, :bb5, :d5, :g5, :d5, :bb5, :d5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 2, release: 0.08} }
s_lead = gen_score("x.x.x.x.x.x.x.x.", lead_data)

# High-pitched, "Diva" Vocal Stutter (Granular Synth).
# Pitched UP to :a4 and :c5. High density, tiny size = a sharp, sugary vocal skip.
vocal_notes = [:a4, :c5]
vocal_data = vocal_notes.map { |n| {note: n, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.6} }
s_vocal = gen_score("....x.......x...", vocal_data)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Start - Just the kick, gallop bass, and hats (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_hats, s_hats, 4] ],
  
  # Scene 2: The Race - Add the snares, brass stabs, and vocals (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8], 
    [:play_snare, s_snare, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drift - The piercing speed arpeggio drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8], 
    [:play_snare, s_snare, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN HIGH-SPEED MOMENTUM]
# 
# 1. Algorithmic Octave Bass: Look at `s_bass`. Instead of typing 16 
#    repetitive Hashes, we define an array `bass_cycle` that alternates 
#    between the low octave (:a1) and the high octave (:a2). We then use 
#    `.map` to inject the default parameters (`cutoff`, `release`, `amp`) 
#    into every step. This creates the relentless, driving, 16th-note 
#    "gallop" that defines Eurobeat, with zero repetitive code.
#
# 2. The Off-Beat Wall: Look at `s_hats`, `s_chords`, and `s_vocal`. They 
#    ALL hit strictly on steps 2, 6, 10, and 14. In a 16-step grid, these 
#    are the exact midpoints between the kicks. The engine's strict master 
#    clock locks these together perfectly at 155 BPM, creating a massive, 
#    bouncing "boom-cha" momentum that forces you to drive faster.
#
# 3. Pristine FM Contrast: Eurobeat relies on the stark contrast between 
#    the massive, dark sub-bass and high-pitched, pristine elements. The 
#    `s_lead` sequence uses a high `divisor` (3) and a microscopic `release` 
#    (0.08) to create a rapid, piercing arpeggio that cuts through the heavy 
#    brass and bass like a high-performance engine redlining.
# ==========================================================
