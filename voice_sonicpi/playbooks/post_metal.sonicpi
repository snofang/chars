# ==========================================================
# PLAYBOOK: 2010s BLACKGAZE / POST-METAL
# (Pioneered by Deafheaven, Alcest, and Liturgy)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 2010s Blackgaze.
# We have explored heavy genres (Gabber, Industrial) and atmospheric genres 
# (Ambient, Shoegaze). Blackgaze is the extreme fusion of Black Metal and 
# Shoegaze. It relies on a relentless "blast beat" (continuous 16th notes 
# on the snare and hats), a distorted, continuous 16th-note tremolo bass, 
# and massive, sweeping, lush major chords that feel like a blizzard of 
# sound. 
#
# This playbook perfectly demonstrates how to push the engine to its 
# absolute rhythmic and textural limit. By filling almost every 16-step 
# grid with rapid hits and pairing it with slow, swelling chords, the 
# engine creates a massive, cinematic wall of sound.
# ==========================================================

use_bpm 140

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (C# Minor - Massive, Blistering, & Lush)
# ==========================================================

# Relentless, driving 4/4 kick.
s_kick  = (ring :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil)

# The "Blast Beat" Snare.
# Plays continuous 16th notes alongside the hats to create a blistering wall of percussion.
s_snare = (ring {:note => :c4, :amp => 0.8}, {:note => :c4, :amp => 0.5}, {:note => :c4, :amp => 0.8}, {:note => :c4, :amp => 0.5}, {:note => :c4, :amp => 0.8}, {:note => :c4, :amp => 0.5}, {:note => :c4, :amp => 0.8}, {:note => :c4, :amp => 0.5}, {:note => :c4, :amp => 0.8}, {:note => :c4, :amp => 0.5}, {:note => :c4, :amp => 0.8}, {:note => :c4, :amp => 0.5}, {:note => :c4, :amp => 0.8}, {:note => :c4, :amp => 0.5}, {:note => :c4, :amp => 0.8}, {:note => :c4, :amp => 0.5})

# The "Blast Beat" Hats.
# Plays continuous 16th notes with alternating amplitudes to drive the momentum.
s_hats  = (ring {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2})

# The "Tremolo" Bass (C# Minor).
# Plays continuous 16th notes, alternating octaves (:cs1, :cs2). 
# Extreme cutoff (120) and short release (0.1) create a grinding, distorted churn.
s_bass  = (ring {:note => :cs1, :cutoff => 120, :release => 0.1}, {:note => :cs2, :cutoff => 120, :release => 0.1}, {:note => :cs1, :cutoff => 120, :release => 0.1}, {:note => :cs2, :cutoff => 120, :release => 0.1}, 
           {:note => :cs1, :cutoff => 120, :release => 0.1}, {:note => :cs2, :cutoff => 120, :release => 0.1}, {:note => :e1, :cutoff => 120, :release => 0.1}, {:note => :e2, :cutoff => 120, :release => 0.1}, 
           {:note => :cs1, :cutoff => 120, :release => 0.1}, {:note => :cs2, :cutoff => 120, :release => 0.1}, {:note => :cs1, :cutoff => 120, :release => 0.1}, {:note => :cs2, :cutoff => 120, :release => 0.1}, 
           {:note => :b1, :cutoff => 120, :release => 0.1}, {:note => :b2, :cutoff => 120, :release => 0.1}, {:note => :a1, :cutoff => 120, :release => 0.1}, {:note => :gs1, :cutoff => 120, :release => 0.1})

# Massive, sweeping "Shoegaze" Chords (C#m to E to A).
# Hit sparingly on the downbeats. The slow 1.0-beat attack and massive 3.0-beat 
# release blur the chords together into a continuous, lush wave.
s_chords= (ring {:note => [:cs3, :e3, :gs3, :b3], :cutoff => 110, :attack => 1.0, :release => 3.0, :amp => 0.6}, nil, nil, nil, nil, nil, nil, nil, {:note => [:e3, :gs3, :b3, :d4], :cutoff => 110, :attack => 1.0, :release => 3.0, :amp => 0.6}, nil, nil, nil, nil, nil, nil, nil)

# Piercing, echoing "Tremolo Lead" (C# Minor Pentatonic).
# Uses :play_fm with a low divisor (2) and depth (3) to create a sharp, 
# buzzy square wave. Routed through the engine's tape echo for a cavernous smear.
s_fm    = (ring {:note => :cs5, :amp => 0.5, :divisor => 2, :depth => 3, :release => 0.2}, nil, nil, nil, {:note => :e5, :amp => 0.4, :divisor => 2, :depth => 3, :release => 0.2}, nil, nil, nil, {:note => :gs5, :amp => 0.5, :divisor => 2, :depth => 3, :release => 0.2}, nil, nil, nil, {:note => :a5, :amp => 0.4, :divisor => 2, :depth => 3, :release => 0.2}, nil, nil, nil)

# Ethereal, granular "Blizzard" texture (using :ambi_choir).
# Long size (0.3) and low density (1) creates a slow, evolving background 
# texture that drifts behind the blast beat like a cold wind.
s_grain = (ring {:note => :cs4, :buffer => :ambi_choir, :pos => 0.2, :density => 1, :size => 0.3, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil, {:note => :a4, :buffer => :ambi_choir, :pos => 0.6, :density => 1, :size => 0.3, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Blizzard - Just the blast beat, tremolo bass, and drone (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Wall - Add the massive, sweeping shoegaze chords (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Peak - The echoing tremolo lead drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], [:play_chords, s_chords, 8], 
    [:play_lead, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN EXTREME TEXTURE]
# 
# 1. The Blast Beat Illusion: Look at `s_snare` and `s_hats`. They play 
#    continuous 16th notes at 140 BPM. The engine's strict master clock 
#    ensures these rapid hits fire with absolute mathematical precision, 
#    creating a blistering wall of percussion that perfectly mimics a 
#    live black metal drummer playing a blast beat.
#
# 2. The Tremolo Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step, alternating octaves. By using an extreme 
#    `cutoff` (120), the engine turns the detuned sawtooth into a relentless, 
#    grinding churn that perfectly mimics a heavily distorted electric guitar 
#    playing tremolo picked 16th notes.
#
# 3. Extreme Dynamic Contrast: Blackgaze relies on the stark contrast between 
#    the aggressive, high-speed rhythm section and the slow, lush, sweeping 
#    chords. The `s_chords` sequence uses a slow `attack` (1.0) and massive 
#    `release` (3.0) to blur the chords together into a continuous, warm wave 
#    of sound that floats above the blistering beat.
# ==========================================================
