# ==========================================================
# PLAYBOOK: 2010s BLACKGAZE / POST-METAL
# Blistering Blast Beats, Tremolo Distortion, Lush Shoegaze Walls
# ==========================================================
# [WHY THIS GENRE?]
# Blackgaze (Deafheaven, Alcest) fuses black metal's relentless
# blast beats and tremolo picking with shoegaze's sweeping,
# major‑key chords and ethereal textures. This playbook captures
# that extreme dynamic contrast: a blizzard of percussion and
# distorted bass against slow, swelling harmonic waves.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 140 BPM
# Key: C# minor (dark, but with major lifts)
# Rhythm: 4/4 kick, blast‑beat snare and hats (continuous 16ths),
# tremolo bass (16ths, octave jumps), sparse chord swells,
# sparse lead melodies.
# Timbre: Grinding bass (dsaw, high cutoff, short release),
# blast percussion (kick, snare, hats with velocity layers),
# lush chords (blade, long attack/release), piercing square‑wave
# lead (fm, divisor 2, depth 3), granular blizzard drone.
# Arrangement: Blizzard (blast beat + bass + drone) →
# Wall (add sweeping chords) → Peak (add tremolo lead).
# ==========================================================

use_bpm 140

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Relentless 4/4 kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Blast‑beat snare – continuous 16ths with alternating amplitudes
snare_data = 16.times.map { |i| {note: :c4, amp: (i.even? ? 0.8 : 0.5)} }
s_snare = gen_score("xxxxxxxxxxxxxxxx", snare_data)

# Blast‑beat hats – continuous 16ths with alternating amplitudes
hats_data = 16.times.map { |i| {note: :c4, amp: (i.even? ? 0.3 : 0.2)} }
s_hats = gen_score("xxxxxxxxxxxxxxxx", hats_data)

# Tremolo bass – continuous 16ths, alternating octaves and notes
bass_notes = [
  :cs1, :cs2, :cs1, :cs2,
  :cs1, :cs2, :e1,  :e2,
  :cs1, :cs2, :cs1, :cs2,
  :b1,  :b2,  :a1,  :gs1
]
bass_data = bass_notes.map { |n| {note: n, cutoff: 120, release: 0.1} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Massive sweeping chords – sparse, with long attack/release
chord_data = [
  {note: [:cs3, :e3, :gs3, :b3], cutoff: 110, attack: 1.0, release: 3.0, amp: 0.6},
  {note: [:e3,  :gs3, :b3,  :d4], cutoff: 110, attack: 1.0, release: 3.0, amp: 0.6}
]
s_chords = gen_score("x.......x.......", chord_data)

# Piercing tremolo lead – sparse, routed through tape echo
lead_data = [
  {note: :cs5, amp: 0.5, divisor: 2, depth: 3, release: 0.2},
  {note: :e5,  amp: 0.4, divisor: 2, depth: 3, release: 0.2},
  {note: :gs5, amp: 0.5, divisor: 2, depth: 3, release: 0.2},
  {note: :a5,  amp: 0.4, divisor: 2, depth: 3, release: 0.2}
]
s_fm = gen_score("x...x...x...x...", lead_data)

# Ethereal granular "blizzard" drone – slow evolving texture
grain_data = [
  {note: :cs4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.3, amp: 0.5},
  {note: :a4,  buffer: :ambi_choir, pos: 0.6, density: 1, size: 0.3, amp: 0.5}
]
s_grain = gen_score("x.......x.......", grain_data)

# Playbook
playbook = (ring
  # Scene 1: Blizzard – Blast beat, bass, drone
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4],
    [:play_hats, s_hats, 4], [:play_sub, s_bass, 4],
    [:play_grain, s_grain, 4] ],

  # Scene 2: Wall – Add sweeping chords
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8], [:play_chords, s_chords, 8] ],

  # Scene 3: Peak – Add tremolo lead
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8], [:play_chords, s_chords, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The blast beat: continuous 16ths on snare and hats at 140 BPM
#   create a blistering, mathematically precise wall of percussion.
# - Tremolo bass: every 16th step with alternating octaves and
#   extreme cutoff (120) gives a grinding, distorted churn.
# - Dynamic contrast: the slow attack (1.0) and massive release
#   (3.0) on chords blur them into a warm, continuous wave
#   floating above the aggressive rhythm.
# ==========================================================
