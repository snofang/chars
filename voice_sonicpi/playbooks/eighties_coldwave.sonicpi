# ==========================================================
# PLAYBOOK: 80s COLDWAVE / MINIMAL SYNTH
# (Pioneered by Martin Dupont, Kas Product, and Sisters of Mercy)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 80s Coldwave / Minimal Synth.
# We have explored Darkwave and EBM, but Coldwave is the sound of the cold, 
# melancholic French/European underground. It fuses the stark, mechanical 
# drum machines of post-punk with minimal, aggressive synth basslines, 
# stark, dissonant chord stabs, and a bleak, suffocating atmosphere.
#
# This playbook perfectly demonstrates how to use the `:play_sub` synth 
# as a driving, continuous 16th-note bassline, and how to use the 
# `:play_fm` synth to create stark, dissonant, metallic stabs, creating 
# a cold, mechanical, and deeply atmospheric 80s groove.
# ==========================================================

use_bpm 120

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Stark, Cold, & Mechanical)
# ==========================================================

# Relentless, driving 4/4 drum machine kick. (4 x's, 4 elements)
s_kick = gen_score("x...x...x...x...", [:c4, :c4, :c4, :c4])

# Heavy, dry snare strictly on beats 2 and 4. (2 x's, 2 elements)
s_snare = gen_score("....x.......x...", [:c4, :c4])

# Rigid, alternating 16th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Minimal Synth" Bass (A Minor).
# Plays continuous 16th notes, alternating octaves. 
# High cutoff (100) and short release (0.08) create a relentless, 
# aggressive, buzzing churn. (16 x's, 16 elements)
bass_cycle = [:a1, :a2, :a1, :a2, :a1, :a2, :a1, :a2, 
              :g1, :g2, :g1, :g2, :a1, :a2, :a1, :a2]
bass_data = bass_cycle.map { |n| {note: n, cutoff: 100, release: 0.08, amp: 1.0} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Stark, "Dissonant" Synth Stabs (Am to G).
# Uses :play_fm with a low divisor (2) and mid depth (4) to create a harsh, 
# metallic, dissonant hit. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:a3, :c4, :eb4], divisor: 2, depth: 4, release: 0.1, amp: 0.6},
  {note: [:a3, :c4, :eb4], divisor: 2, depth: 4, release: 0.1, amp: 0.6},
  {note: [:g3, :bb3, :db4], divisor: 2, depth: 4, release: 0.1, amp: 0.6},
  {note: [:g3, :bb3, :db4], divisor: 2, depth: 4, release: 0.1, amp: 0.6}
])

# Piercing, "Cold" Lead (A Minor Pentatonic).
# Uses :play_fm with a high divisor (4) and low depth (2) to create a piercing, 
# glassy, computer-like tone. Routed through the global tape echo. (8 x's, 8 elements)
lead_notes = [:a5, :e5, :c6, :e5, :a5, :g5, :e5, :c6]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 4, depth: 2, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# Pitched-down, "French" vocal drone (Granular Synth).
# Long size (0.15) and low density (1) creates a dark, repetitive vocal hit. 
# (2 x's, 2 elements)
s_vocal = gen_score("....x.......x...", [
  {note: :a3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.15, amp: 0.6},
  {note: :g3, buffer: :ambi_choir, pos: 0.4, density: 1, size: 0.15, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Cold - Just the relentless bass, dissonant stabs, and vocals (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Machine - Add the rigid 4/4 drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Void - The piercing cold lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN COLD MINIMALISM]
# 
# 1. The Minimal Synth Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step, alternating octaves. By using a high `cutoff` 
#    (100) and a microscopic `release` (0.08), the engine turns the detuned 
#    sawtooth into a relentless, aggressive, buzzing churn. This perfectly 
#    mimics the early analog sequencer basslines of 80s Coldwave.
#
# 2. FM as a Weapon: Look at `s_chords` and `s_lead`. The `:play_fm` synth is 
#    given an extreme `depth` (4) and a high `divisor` (4). This harsh harmonic 
#    ratio produces dissonant, metallic, and piercing tones that cut through 
#    the heavy mix, perfectly mimicking the stark, cold synthesizer sounds of 
#    the French and European underground.
#
# 3. Rigid Negative Space: Look at `s_chords`. The stark, dissonant chords hit 
#    only on the off-beats (steps 2, 6, 10, 14). The engine's strict master 
#    clock ensures these stabs land with absolute mathematical precision, 
#    leaving massive gaps (`nil`) that let the relentless 16th-note bass drive 
#    the track forward into the void.
# ==========================================================
