# ==========================================================
# PLAYBOOK: INDUSTRIAL / POWER NOISE
# (Pioneered by Combichrist, Noisuf-X, and Nachtmahr)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose Industrial / Power Noise.
# We have explored heavy genres (Gabber, Breakcore) and dark genres 
# (Darkwave, Witch House). Industrial / Power Noise is the sound of the 
# dystopian factory floor. It takes the rigid 4/4 grid and replaces all 
# traditional melodies with rhythmic, distorted bass pulses, metallic 
# clangs, and hammering, clean sub-bass.
#
# This playbook perfectly demonstrates how to use the core 10 instruments 
# to create an industrial wall of sound. By pushing the `:play_sub` synth 
# to a high `cutoff` (120), we create a buzzing pulse. By rapidly alternating 
# the `divisor` on the `:play_fm` synth, we simulate rhythmic, metallic noise 
# chops without needing a dedicated noise synthesizer.
# ==========================================================

use_bpm 130

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Minor - Aggressive, Metallic, & Rhythmic)
# ==========================================================

# Relentless, hammering 4/4 kick.
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, dry industrial snare strictly on beats 2 and 4 (steps 4 and 12).
s_snare = gen_score("....x.......x...", [:c4])

# Rigid, off-beat open hats to drive the momentum.
s_hats = gen_score("..x..x..x..x....",
  [ {note: :c4, amp: 0.4},
    {note: :c4, amp: 0.5},
    {note: :c4, amp: 0.4},
    {note: :c4, amp: 0.5} ])

# The "Industrial Pulse" Bass (F# Minor) – continuous 16ths, extreme cutoff.
bass_notes = [
  :fs1, :fs1, :fs2, :fs1, :fs1, :fs1, :a1, :a1,
  :a1, :a1, :a2, :a1, :e1, :e1, :fs1, :e1
]
bass_params = {cutoff: 120, release: 0.1}
s_bass = gen_score("xxxxxxxxxxxxxxxx",
  bass_notes.map { |n| bass_params.merge(note: n) })

# Stark, minor chord stabs (F#m to A to E) on off‑beats (steps 2,6,10,14).
s_chords = gen_score("..x..x..x..x....",
  [ [:fs3, :a3, :c4],
    [:fs3, :a3, :c4],
    [:a3, :c4, :e4],
    [:e3, :g3, :b3] ])

# The "Metallic Noise" Chopper – alternating low/high notes to create rhythmic metal.
# Define two FM templates: low (click) and high (piercing).
low_fm  = {amp: 0.4, divisor: 4, depth: 5, release: 0.05}
high_fm = {amp: 0.6, divisor: 2, depth: 2, release: 0.05}

# Build a 16‑step sequence: 4 repeats of (fs3, fs5), then 2 repeats of (a3, a5), then 4 repeats of (fs3, fs5).
fs_pair = [{note: :fs3}.merge(low_fm), {note: :fs5}.merge(high_fm)]
a_pair  = [{note: :a3}.merge(low_fm),  {note: :a5}.merge(high_fm)]
fm_data = (fs_pair * 4) + (a_pair * 2) + (fs_pair * 4)
s_fm = gen_score("xxxxxxxxxxxxxxxx", fm_data)

# The "Grinding" Granular FX – metallic static using elec_piano.
grain_notes = [:fs3, :a3, :fs3, :e3]
grain_base  = {buffer: :elec_piano, pos: 0.8, density: 6, size: 0.02, amp: 0.4}
s_grain = gen_score("x...x...x...x...",
  grain_notes.map { |n| grain_base.merge(note: n) })

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Factory - Just the kick, pulse bass, and metallic chops (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_fm, s_fm, 4] ],
  
  # Scene 2: The Machine - Add the snares, hats, and stark chords (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_fm, s_fm, 8], 
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Meltdown - The grinding granular FX drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_fm, s_fm, 8], 
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8], 
    [:play_grain, s_grain, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN INDUSTRIAL NOISE]
# 
# 1. Data-Driven Noise Chops: Look at `s_fm`. By passing alternating 
#    low/high notes (:fs3 vs :fs5) and rapidly changing the `divisor` 
#    (from 4 to 2), the engine forces the FM synth to jump between 
#    a hollow click and a piercing square wave. This creates a rhythmic, 
#    stuttering metallic noise effect that sounds like a factory machine 
#    churning, purely via data.
#
# 2. The Distorted Pulse: Look at `s_bass`. The `:play_sub` synth is given 
#    an extreme `cutoff` of `120` on every single 16th step. This leaves 
#    the filter wide open, letting all the harsh, high-frequency harmonics 
#    of the detuned sawtooth through. This creates a relentless, buzzing 
#    "chug" that perfectly mimics the classic industrial EBM pulse.
#
# 3. Grinding Granular Metal: The `s_grain` sequence uses a tiny `size` 
#    (`0.02`) and high `density` (`6`). By targeting the very end of the 
#    electric piano buffer (`pos: 0.8`), the engine shatters the sample 
#    into metallic, machine-like static that sits perfectly in the 
#    background of a dark warehouse.
# ==========================================================
