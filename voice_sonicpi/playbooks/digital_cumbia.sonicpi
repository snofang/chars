# ==========================================================
# PLAYBOOK: DIGITAL CUMBIA / TROPICAL BASS
# Festive, Hypnotic, Tropical Groove
# ==========================================================
# [WHY THIS GENRE?]
# Digital Cumbia (Selena, Bomba Estéreo) is built on the
# hypnotic "chucu-chucu" rhythm – a syncopated scraper pattern
# that drives the groove. This playbook uses FM synthesis to
# simulate the guacharaca scraper, paired with syncopated kicks,
# warm bass, accordion stabs, and brassy melodies.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 100 BPM
# Key: D minor (festive, hypnotic)
# Rhythm: Syncopated tambora kick (0, 'and' of 2, beat 3),
# snare on 2/4, guacharaca scraper on every 16th with alternating
# amps, walking tumbao bass, accordion stabs on off‑beats,
# brassy melody, pitched vocal chants.
# Timbre: Tambora kick (bd_haus), snare (sn_dolf), FM scraper
# (divisor 4, depth 1, short release), round bass (dsaw, low
# cutoff), accordion chords (blade), brassy lead (fm, divisor 2),
# granular vocal chants (ambi_choir).
# Arrangement: Groove (drums+scraper) → Vibe (add bass+chords)
# → Drop (add melody+vocal).
# ==========================================================

use_bpm 100

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Tambora kick – syncopated 3‑3‑2 feel (steps 0,6,8)
s_kick = gen_score("x.....x.x.......",
  [:c4, {note: :c4, amp: 0.8}, {note: :c4, amp: 1.0}])

# Heavy marching snare on beats 2 and 4 (steps 4 and 12)
s_snare = gen_score("....x.......x...",
  [{note: :c4, amp: 0.9}, {note: :c4, amp: 0.9}])

# Guacharaca scraper – continuous 16ths with alternating amps
scrape_data = 16.times.map do |i|
  amp = (i.even?) ? 0.3 : 0.15
  {note: :d4, amp: amp, divisor: 4, depth: 1, release: 0.03}
end
s_scrape = gen_score("xxxxxxxxxxxxxxxx", scrape_data)

# Deep tumbao bass – walking melodic line (steps 0,3,8,11)
s_bass = gen_score("x..x....x..x....",
  [{note: :d2, release: 0.3, cutoff: 75},
   {note: :d2, release: 0.3, cutoff: 75},
   {note: :f2, release: 0.3, cutoff: 75},
   {note: :f2, release: 0.3, cutoff: 75}])

# Accordion/organ chord stabs on off‑beats (steps 2,6,10,14)
s_chords = gen_score("..x..x..x..x....",
  [[:d3, :f3, :a3],
   [:d3, :f3, :a3],
   [:f3, :a3, :c4],
   [:c3, :e3, :g3]])

# Bright brassy melody (steps 4,6,14)
s_fm = gen_score("....x.x.......x.",
  [{note: :d5, amp: 0.6, divisor: 2, depth: 2, release: 0.3},
   {note: :f5, amp: 0.5, divisor: 2, depth: 2, release: 0.3},
   {note: :a4, amp: 0.6, divisor: 2, depth: 2, release: 0.3}])

# Rhythmic festival vocal chants (steps 5 and 12)
s_vocal = gen_score(".....x......x...",
  [{note: :d4, buffer: :ambi_choir, pos: 0.2, density: 2, size: 0.04, amp: 0.6},
   {note: :f4, buffer: :ambi_choir, pos: 0.4, density: 2, size: 0.04, amp: 0.6}])

# Playbook
playbook = (ring
  # Scene 1: Groove – Kick, Snare, Scraper
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4],
    [:play_fm, s_scrape, 4] ],

  # Scene 2: Vibe – Add Bass and Chords
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_fm, s_scrape, 8], [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3: Drop – Add Melody and Vocal Chants
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_fm, s_scrape, 8], [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8], [:play_lead, s_fm, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The guacharaca illusion: FM with divisor 4 and release 0.03
#   produces a sharp woody click; alternating amps (0.3/0.15)
#   create the hypnotic "chucu-chucu" rhythm.
# - Tambora kick: hits on steps 0,6,8 – avoiding the 4/4 pulse
#   creates a lopsided, swaggering Latin groove.
# - Accordion stabs: chord hits on steps 2,6,10,14 – the engine
#   locks them between the scraper and bass.
# - Brassy melody: FM with divisor 2 creates a warm, brassy tone
#   that cuts through the tropical mix.
# ==========================================================
