# ==========================================================
# PLAYBOOK: DIGITAL CUMBIA / TROPIAL BASS
# (Pioneered by Selena, Los Angeles Azules, and Bomba Estéreo)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose Digital Cumbia.
# We have explored European and North American electronic genres 
# extensively, but Cumbia is a massive global success story originating 
# in Colombia and Mexico. It is famous for a specific, hypnotic rhythm 
# known as the "chucu-chucu"—a syncopated, scrubbing pattern usually 
# played on a guacharaca (scraper) or accordion.
#
# This playbook perfectly demonstrates how to simulate a physical 
# percussion scraper using the `:play_fm` synth. By playing continuous 
# 16th notes with a very high `divisor` and alternating amplitudes, 
# the engine creates a relentless, bouncing groove that drives the track.
# ==========================================================

use_bpm 100

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Minor - Festive, Hypnotic, & Tropical)
# ==========================================================

# The "Tambora" Kick. 
# Syncopated 3-3-2 feel. Hits on step 0, the 'and' of 2 (step 6), and beat 3 (step 8).
s_kick  = (ring :c4, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, {:note => :c4, :amp => 1.0}, nil, nil, nil, nil, nil, nil, nil)

# Heavy, marching band-style snare strictly on beats 2 and 4 (steps 4 and 12).
s_snare = (ring nil, nil, nil, nil, {:note => :c4, :amp => 0.9}, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.9}, nil, nil, nil)

# The "Guacharaca" Scraper (D Minor).
# Plays continuous 16th notes. The high divisor (4) and tiny release (0.03) 
# turn the FM synth into a sharp, woody "scrape". The alternating amplitudes 
# (0.3 vs 0.15) create the signature "chucu-chucu" bounce.
s_scrape= (ring {:note => :d4, :amp => 0.3, :divisor => 4, :depth => 1, :release => 0.03}, {:note => :d4, :amp => 0.15, :divisor => 4, :depth => 1, :release => 0.03}, {:note => :d4, :amp => 0.3, :divisor => 4, :depth => 1, :release => 0.03}, {:note => :d4, :amp => 0.15, :divisor => 4, :depth => 1, :release => 0.03}, 
           {:note => :d4, :amp => 0.3, :divisor => 4, :depth => 1, :release => 0.03}, {:note => :d4, :amp => 0.15, :divisor => 4, :depth => 1, :release => 0.03}, {:note => :d4, :amp => 0.3, :divisor => 4, :depth => 1, :release => 0.03}, {:note => :d4, :amp => 0.15, :divisor => 4, :depth => 1, :release => 0.03}, 
           {:note => :d4, :amp => 0.3, :divisor => 4, :depth => 1, :release => 0.03}, {:note => :d4, :amp => 0.15, :divisor => 4, :depth => 1, :release => 0.03}, {:note => :d4, :amp => 0.3, :divisor => 4, :depth => 1, :release => 0.03}, {:note => :d4, :amp => 0.15, :divisor => 4, :depth => 1, :release => 0.03}, 
           {:note => :d4, :amp => 0.3, :divisor => 4, :depth => 1, :release => 0.03}, {:note => :d4, :amp => 0.15, :divisor => 4, :depth => 1, :release => 0.03}, {:note => :d4, :amp => 0.3, :divisor => 4, :depth => 1, :release => 0.03}, {:note => :d4, :amp => 0.15, :divisor => 4, :depth => 1, :release => 0.03})

# Deep, round Tumbao Bass (D Minor).
# Walks a melodic line. Low cutoff (75) and medium release keep it warm.
s_bass  = (ring {:note => :d2, :release => 0.3, :cutoff => 75}, nil, nil, {:note => :d2, :release => 0.3, :cutoff => 75}, nil, nil, nil, nil, {:note => :f2, :release => 0.3, :cutoff => 75}, nil, nil, {:note => :f2, :release => 0.3, :cutoff => 75}, nil, nil, nil, nil)

# Lush, "Accordion/Organ" chord stabs (Dm to F to C).
# Hit on the off-beats to leave maximum room for the scraper and bass.
s_chords= (ring nil, nil, [:d3, :f3, :a3], nil, nil, nil, [:d3, :f3, :a3], nil, nil, nil, [:f3, :a3, :c4], nil, nil, nil, [:c3, :e3, :g3], nil)

# Bright, echoing "Brass/Accordion" Melody (D Minor Pentatonic).
# Uses :play_fm with a low divisor (2) to create a warm, brassy riff.
s_fm    = (ring nil, nil, nil, nil, {:note => :d5, :amp => 0.6, :divisor => 2, :depth => 2, :release => 0.3}, nil, {:note => :f5, :amp => 0.5, :divisor => 2, :depth => 2, :release => 0.3}, nil, nil, nil, nil, nil, nil, nil, {:note => :a4, :amp => 0.6, :divisor => 2, :depth => 2, :release => 0.3}, nil)

# Rhythmic, pitched "Festival" vocal chant (Granular Synth).
# High density, small size = a sharp, percussive vocal skip.
s_vocal = (ring nil, nil, nil, nil, nil, {:note => :d4, :buffer => :misc_lori, :pos => 0.2, :density => 2, :size => 0.04, :amp => 0.6}, nil, nil, nil, nil, nil, nil, {:note => :f4, :buffer => :misc_lori, :pos => 0.4, :density => 2, :size => 0.04, :amp => 0.6}, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the kick, snare, and guacharaca scraper (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_fm, s_scrape, 4] ],
  
  # Scene 2: The Vibe - Add the warm bass and accordion stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_fm, s_scrape, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Drop - The brassy melody and vocal chops drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_fm, s_scrape, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], 
    [:play_lead, s_fm, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN TROPICAL GROOVE]
# 
# 1. The Guacharaca Illusion: Look at `s_scrape`. The `:play_fm` synth is 
#    given a `divisor` of `4` and a `release` of `0.03`. This extreme 
#    harmonic ratio and tiny decay force the FM synth to produce a sharp, 
#    woody "click". By playing continuous 16th notes with alternating 
#    amplitudes (0.3 vs 0.15), the engine perfectly mimics a physical 
#    guacharaca scraper, creating the hypnotic "chucu-chucu" rhythm that 
#    is the absolute genetic code of Cumbia.
#
# 2. The Tambora Kick: Look at `s_kick`. It hits on steps 0, 6, and 8. 
#    By avoiding the standard 4/4 pulse and hitting on the "and" of beat 2, 
#    the engine creates a lopsided, swaggering groove that feels distinctly 
#    Latin, pushing the dancer to move their hips rather than just jump.
#
# 3. Accordion Stabs: The `s_chords` hit strictly on steps 2, 6, 10, and 14. 
#    By using the `:play_chords` synth with a sharp attack, the engine turns 
#    the normally warm `:blade` synth into a punchy, staccato accordion stab 
#    that locks perfectly between the relentless scraper and the deep bass.
# ==========================================================
