
# 4. GRANULAR CLOUD (with note cache)
define :play_grain do |n|
  return unless n
  note, opts = parse_step(n, {amp: 0.5})
  
  density = opts[:density] || 4
  pos     = opts[:pos] || rrand(0.3, 0.5)
  size    = opts[:size] || 0.05
  buffer  = opts[:buffer] || :ambi_choir
  
  opts.delete(:density); opts.delete(:pos); opts.delete(:size); opts.delete(:buffer)
  
  pitch_shift = note_cached(note) - note_cached(:c4)
  interval = 0.25 / density
  
  at density.times.map { |i| i * interval } do
    grain_start = pos + rrand(-0.01, 0.01)
    grain_finish = grain_start + size
    
    sample buffer, 
      pitch: pitch_shift, 
      start: grain_start, 
      finish: grain_finish, 
      pan: rrand(-0.8, 0.8), 
      attack: size / 2,
      release: size / 2, 
      **opts
  end
end
