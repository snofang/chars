# ==========================================================
# PLAYBOOK: DANCE FLOOR
# A Euphoric, Pumping, Movement-Driven Experience
# ==========================================================
#
# WHAT IS "DANCE FLOOR"?
# This is the sound of a packed room, lasers cutting through 
# smoke, and bodies moving as one. It's 4-on-the-floor, 
# hands-in-the-air, peak-time energy. No breaks, no breathing – 
# just pure, unstoppable momentum.
#
# DNA:
#   1. Tempo: 126 BPM – the sweet spot for house and techno.
#   2. Harmonic Center: A minor – dark but euphoric, with 
#      a relentless drive.
#   3. Rhythmic Skeleton:
#      - Kick: solid 4-on-the-floor – the heartbeat.
#      - Snare/Clap: on 2 and 4, crisp and punchy.
#      - Hats: rolling 16th notes with swing – the engine.
#   4. Timbral Palette:
#      - Bass: a deep, rolling saw – with a filter that opens 
#        and closes like breathing.
#      - Lead: a bright, staccato arpeggio – hypnotic and uplifting.
#      - Chords: a lush, sustained pad – the emotional core.
#      - Pluck: rhythmic accent – adds texture and movement.
#      - Grain: vocal chops – like a crowd singing.
#      - Drums: punchy, with tight reverb and compression.
#   5. Arrangement:
#      - Scene 1 (Intro): Kick + Bass (4 bars) – "the pulse"
#      - Scene 2 (Build): Add Hats + Chords (8 bars) – "the rise"
#      - Scene 3 (Drop): Full ensemble + Lead + Grain (8 bars) – "release"
# ==========================================================

use_bpm 126

# ---------- ENGINE (inline – unchanged) ----------
define :gen_score do |pattern, data|
  data = [nil] if data.nil? || data.empty?
  idx = 0
  p_str = pattern.to_s.ljust(16, '.')[0...16]
  p_str.chars.map do |char|
    if char == 'x' || char == 'X'
      val = data[idx % data.length]
      idx += 1
      val
    else
      nil
    end
  end.ring
end

define :parse_step do |step, defaults|
  return nil, nil unless step
  if step.is_a?(Hash)
    note = step[:note]
    opts = defaults.merge(step)
    opts.delete(:note)
  else
    note = step
    opts = defaults
  end
  if note.is_a?(Array)
    note = note.compact
    return nil, opts if note.empty?
  end
  return note, opts
end

define :play_sub do |n|
  use_synth :dsaw
  note, opts = parse_step(n, {release: 0.15, amp: 1.3, cutoff: 70})
  play note, **opts if note
end

define :play_lead do |n|
  use_synth :prophet
  note, opts = parse_step(n, {release: 0.1, amp: 0.8, cutoff: rrand(100,130)})
  with_fx :echo, phase: 0.125, decay: 2, mix: 0.15 do
    play note, **opts if note
  end
end

define :play_chords do |n|
  use_synth :blade
  note, opts = parse_step(n, {release: 1.5, amp: 0.5, attack: 0.1, cutoff: 80})
  play note, **opts if note
end

define :play_grain do |n|
  return unless n
  note, opts = parse_step(n, {amp: 0.4})
  density = (opts[:density] || 6).to_i
  pos     = opts[:pos] || rrand(0.2,0.5)
  size    = opts[:size] || 0.025
  buffer  = opts[:buffer] || :ambi_choir
  opts.delete(:density); opts.delete(:pos); opts.delete(:size); opts.delete(:buffer)
  pitch_shift = note(note) - note(:c4)
  interval = 0.25 / density
  at density.times.map { |i| i * interval } do
    grain_start = pos + rrand(-0.005,0.005)
    grain_finish = grain_start + size
    sample buffer, pitch: pitch_shift, start: grain_start, finish: grain_finish,
      pan: rrand(-0.5,0.5), attack: size/2, release: size/2, **opts
  end
end

define :play_fm do |n|
  use_synth :fm
  note, opts = parse_step(n, {release: 0.2, amp: 0.6, divisor: 2, depth: 3})
  play note, **opts if note
end

define :play_pluck do |n|
  use_synth :pluck
  note, opts = parse_step(n, {release: 0.15, amp: 0.6, coef: rrand(0.4,0.6)})
  play note, **opts if note
end

define :play_pad do |n|
  use_synth :dark_ambience
  note, opts = parse_step(n, {release: 1.0, amp: 0.3, attack: 0.2})
  play note, **opts if note
end

define :play_kick do |n|
  note, opts = parse_step(n, {amp: 1.8})
  sample :bd_haus, pitch: (note(note) - note(:c4)), **opts if note
end

define :play_snare do |n|
  note, opts = parse_step(n, {amp: 0.9})
  with_fx :reverb, room: 0.5, mix: 0.2 do
    sample :sn_dolf, pitch: (note(note) - note(:c4)), **opts if note
  end
end

define :play_hats do |n|
  note, opts = parse_step(n, {amp: 0.3})
  if note
    # Tight, rolling hi-hats – the engine of the track
    at [0, 0.125, 0.25, 0.375] do
      sample :drum_cymbal_closed, rate: 1.0, pan: rrand(-0.2,0.2), **opts
    end
  end
end

define :start_engine do |playbook|
  playbook.to_a.flatten(1).each do |task|
    inst, score, bars = task
    unless score.length == 16
      raise ArgumentError, "#{inst} score must have exactly 16 steps, but got #{score.length}."
    end
  end
  live_loop :conductor do
    scene = playbook.tick(:conductor)
    max_bars = scene.map { |task| task[2] }.max || 1
    total_steps = max_bars * 16
    total_steps.times do |step|
      scene.each do |task|
        inst, score, bars = task
        if step < (bars * 16)
          send(inst, score[step % 16])
        end
      end
      sleep 0.25
    end
  end
end
# ---------- ENGINE (end) ----------

# ---------- SCORES (DANCE FLOOR) ----------
# Kick: 4‑on‑the‑floor – the heartbeat
s_kick = gen_score("x...x...x...x...", 
  [{note: :a2, amp: 1.8}, {note: :a2, amp: 1.5}])

# Snare: on 2 and 4, crisp and punchy
s_snare = gen_score("...x...x...x...x", 
  [{note: :e3, amp: 0.9}, {note: :e3, amp: 0.7}])

# Hats: rolling 16th notes – the engine
hat_notes = 16.times.map { |i| 
  amp = (i % 2 == 0) ? 0.35 : 0.2
  {note: :a3, amp: amp}
}
s_hats = gen_score("x.x.x.x.x.x.x.x.", hat_notes)

# Bass: deep, rolling saw with a filter that opens and closes
bass_data = 16.times.map { |i| 
  cutoff_val = 50 + (i % 16) * 3  # 50→98→50 over 16 steps
  {note: :a2, cutoff: cutoff_val, release: 0.15, amp: 1.3}
}
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Chords: Am – F – G – E (i – VI – VII – V) – euphoric progression
chords = [
  [:a3, :c4, :e4],  # Am
  [:a3, :c4, :e4],
  [:f3, :a3, :c4],  # F
  [:f3, :a3, :c4],
  [:g3, :b3, :d4],  # G
  [:g3, :b3, :d4],
  [:e3, :g3, :b3],  # E
  [:e3, :g3, :b3],
  [:a3, :c4, :e4],
  [:a3, :c4, :e4],
  [:f3, :a3, :c4],
  [:f3, :a3, :c4],
  [:g3, :b3, :d4],
  [:g3, :b3, :d4],
  [:e3, :g3, :b3],
  [:e3, :g3, :b3]
]
s_chords = gen_score("xxxxxxxxxxxxxxxx", chords.map { |ch| {note: ch, cutoff: 80, release: 1.5, amp: 0.5} })

# Lead: a bright, hypnotic arpeggio – hands in the air
lead_notes = [
  :a4, :c5, :e5, :g5,
  :a4, :c5, :e5, :g5,
  :f4, :a4, :c5, :e5,
  :f4, :a4, :c5, :e5
]
s_lead = gen_score("x..x..x..x..x...", lead_notes.map { |n| {note: n, amp: 0.7, cutoff: rrand(110,140)} })

# Pluck: rhythmic accent – a percussive counterpoint
pluck_notes = [
  :e4, :g4, :c5, :b4,
  :e4, :g4, :c5, :b4,
  :d4, :f4, :a4, :g4,
  :d4, :f4, :a4, :g4
]
s_pluck = gen_score("x...x...x...x...", pluck_notes.map { |n| {note: n, amp: 0.5, coef: rrand(0.5,0.7)} })

# Grain: vocal chops – like a crowd singing
grain_data = 16.times.map { |i| 
  pos = 0.1 + (i % 8) * 0.05
  {note: :c5, buffer: :ambi_choir, pos: pos, density: 4 + (i % 3), size: 0.02, amp: 0.25}
}
s_grain = gen_score("x..x..x..x..x...", grain_data)

# ---------- PLAYBOOK (DANCE FLOOR ARC) ----------
playbook = (ring
  # Scene 1: Intro – Kick + Bass (4 bars) – the pulse
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4] ],
  
  # Scene 2: Build – Hats + Chords enter (8 bars) – the rise
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], 
    [:play_hats, s_hats, 8], [:play_chords, s_chords, 8],
    [:play_snare, s_snare, 8] ],
    
  # Scene 3: Drop – Full ensemble + Lead + Grain (8 bars) – release
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], 
    [:play_hats, s_hats, 8], [:play_snare, s_snare, 8],
    [:play_chords, s_chords, 8], [:play_pluck, s_pluck, 8],
    [:play_lead, s_lead, 8], [:play_grain, s_grain, 8] ]
)

# ---------- RUN ----------
start_engine(playbook)

# ==========================================================
# WHAT MAKES THIS A DANCE FLOOR DESTROYER?
# - 126 BPM – the perfect house/techno tempo.
# - Solid 4‑on‑the‑floor kick – hypnotic and driving.
# - Rolling hi‑hats – the engine that never stops.
# - Filter‑opening bass – like breathing with the track.
# - Euphoric chord progression – Am → F → G → E.
# - Bright, arpeggiated lead – hands in the air.
# - Vocal grain chops – the crowd becomes part of the music.
# - Three‑scene arc: Pulse → Rise → Release.
# ==========================================================
