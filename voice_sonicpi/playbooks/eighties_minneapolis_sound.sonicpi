# ==========================================================
# PLAYBOOK: 80s MINNEAPOLIS SOUND / SYNTH-FUNK
# (Pioneered by Prince, The Time, and Sheila E.)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose the 80s Minneapolis Sound.
# We have explored 80s Synth-Funk and Boogie, but the Minneapolis Sound is a 
# highly distinct, staccato, and aggressive subgenre. It fuses the heavy, 
# swinging LinnDrum machine with thick, fast "slap" synth bass, stark, 
# staccato rhythmic guitar chops, and piercing, soaring electric guitar solos. 
#
# This playbook perfectly demonstrates how to simulate the famous "LinnDrum 
# Swing" on a rigid 16-step sequencer. By leaving specific gaps in the hi-hats 
# and pushing the kick late, the engine creates a bouncy, staccato, and deeply 
# funky atmosphere that defined 80s Minneapolis funk.
# ==========================================================

use_bpm 112

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Bouncy, Staccato, & Funky)
# ==========================================================

# The "Minneapolis" Kick. 
# Highly syncopated and "laid back". Hits on step 0, the 'a' of 1 (step 3), 
# the 'and' of 2 (step 6), and beat 3 (step 8).
# (4 x's, 4 elements)
s_kick = gen_score("x..x..x.x.......", [
  :c4, {note: :c4, amp: 0.8}, :c4, :c4
])

# Crisp, LinnDrum snare strictly on beats 2 and 4, with a ghost note. (3 x's, 3 elements)
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.9}
])

# The "LinnDrum Swing" Hi-Hats.
# Notice the gaps (nil) and alternating amplitudes to simulate the 54% swing.
# (8 x's, 8 elements)
s_hats = gen_score("x..x.x.x.x.x.x.x", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}, {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2}, 
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}, {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2}
])

# The "Slap" Synth Bass (A Minor).
# Plays a syncopated, bouncy line. High cutoff (100) and very short release (0.1) 
# create a punchy, aggressive "thwack" that mimics a slapped synth bass. 
# (6 x's, 6 elements)
s_bass = gen_score("x..x.x.x..x.x...", [
  {note: :a1, release: 0.1, cutoff: 100, amp: 1.0}, 
  {note: :a1, release: 0.1, cutoff: 100, amp: 0.8}, 
  {note: :a1, release: 0.1, cutoff: 100, amp: 1.0}, 
  {note: :g1, release: 0.1, cutoff: 100, amp: 0.8}, 
  {note: :g1, release: 0.1, cutoff: 100, amp: 1.0}, 
  {note: :a1, release: 0.1, cutoff: 100, amp: 0.8}
])

# Stark, "Staccato" Guitar Chops (Am to G).
# Uses :play_fm with a high divisor (3) and low depth (2) to create a clean, 
# plucky, staccato hit. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:a3, :e4], divisor: 3, depth: 2, release: 0.08, amp: 0.6},
  {note: [:a3, :e4], divisor: 3, depth: 2, release: 0.08, amp: 0.6},
  {note: [:g3, :d4], divisor: 3, depth: 2, release: 0.08, amp: 0.6},
  {note: [:g3, :d4], divisor: 3, depth: 2, release: 0.08, amp: 0.6}
])

# Soaring, "Electric Guitar" Solo (A Minor Pentatonic).
# Uses :play_lead routed through the global tape echo bus. The long release (0.3) 
# creates a soaring, echoing solo that cuts through the heavy mix. (6 x's, 6 elements)
lead_notes = [:a5, :c6, :d6, :e6, :d6, :c6]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, cutoff: 110, release: 0.3} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Party" Vocal Drone (Granular Synth).
# Using the built-in :ambi_choir sample.
# High density, tiny size = a sharp, pristine vocal skip. (1 x, 1 element)
s_vocal = gen_score("........x.......", [
  {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the LinnDrum beat, slap bass, and guitar chops (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_fm, s_chords, 4] ],
  
  # Scene 2: The Vibe - Add the party vocal chops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Solo - The soaring electric guitar solo drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN STACCATO FUNK]
# 
# 1. The LinnDrum Swing: Look at `s_hats`. The hats don't just play straight 
#    16th notes; they leave gaps (`nil`) on the downbeats and have alternating 
#    amplitudes. By emphasizing the off-beats, the engine simulates the famous 
#    LinnDrum 54% swing quantize that gave Minneapolis funk its bouncy, 
#    staccato feel.
#
# 2. The Slap Synth Bass: Look at `s_bass`. The `:play_sub` synth plays a 
#    syncopated, bouncy line. By using a high `cutoff` (100) and a very short 
#    `release` (0.1), the engine turns the detuned sawtooth into a punchy, 
#    aggressive "thwack" that perfectly mimics the thick, fast slap basslines 
#    used by Prince and The Time.
#
# 3. FM as a Staccato Guitar: Look at `s_chords`. The `:play_fm` synth is 
#    given a high `divisor` (3) and a low `depth` (2), with a microscopic 
#    `release` (0.08). This forces the FM synth to produce a clean, plucky, 
#    staccato "hit" that perfectly mimics the rhythmic, funk guitar chops 
#    that defined the Minneapolis Sound.
# ==========================================================
