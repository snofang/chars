# ==========================================================
# PLAYBOOK: WHITNEY HOUSTON - "I WANNA DANCE WITH SOMEBODY" (1987)
# ==========================================================

use_bpm 119

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (G# Minor - Joyful, Driving, & Pristine)
# ==========================================================

# Relentless, driving 4/4 LinnDrum kick. (4 x's, 1 element)
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, organic 909 clap strictly on beats 2 and 4, with a ghost note. (3 x's, 3 elements)
s_clap = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.4}, {note: :c4, amp: 1.0}
])

# Rigid, driving 16th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Octave-Jumping" Synth Bass (G# Minor).
# Plays a syncopated, driving line, alternating octaves. 
# High cutoff (100) and short release (0.1) create a warm, punchy "thwack".
# (8 x's, 8 elements)
bass_notes = [:gs1, :gs2, :cs2, :cs3, :ds2, :ds3, :cs2, :cs3]
bass_data = bass_notes.map { |n| {note: n, cutoff: 100, release: 0.1, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# Massive, "Synth Brass" Stabs (G#m to F# to E to D#m).
# Uses :play_fm with a low divisor (2) and mid depth (4) to create a harsh, 
# brassy, staccato hit. Hit strictly on the off-beats. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:gs3, :b3, :ds4], divisor: 2, depth: 4, release: 0.15, amp: 0.6},
  {note: [:fs3, :as3, :cs4], divisor: 2, depth: 4, release: 0.15, amp: 0.6},
  {note: [:e3, :g3, :b3], divisor: 2, depth: 4, release: 0.15, amp: 0.6},
  {note: [:ds3, :fs3, :as3], divisor: 2, depth: 4, release: 0.15, amp: 0.6}
])

# Piercing, "Catchy" Synth Lead (G# Minor).
# Uses :play_fm with a high divisor (3) and mid depth (3) to create a sharp, 
# glassy, digital tone. Routed through the global tape echo. (8 x's, 8 elements)
lead_notes = [:gs4, :as4, :b4, :cs5, :ds5, :cs5, :b4, :as4]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, divisor: 3, depth: 3, release: 0.2} }
s_lead = gen_score("x.x.x.x.x.x.x.x.", lead_data)

# "Oh" Vocal Stutter (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched UP.
# High density, tiny size = a sharp, sugary, pristine vocal skip. (2 x's, 2 elements)
s_vocal = gen_score("....x.......x...", [
  {note: :gs4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.7},
  {note: :b4, buffer: :ambi_choir, pos: 0.3, density: 3, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the driving bass, synth brass stabs, and vocal chops (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Verse - Add the relentless 4/4 LinnDrum beat (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chorus - The piercing catchy synth lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN 80S DANCE-POP]
# 
# 1. The Octave-Jumping Bass: Look at `s_bass`. The `:play_sub` synth plays a 
#    syncopated line, jumping between the low octave (:gs1) and the high octave 
#    (:gs2). By using a high `cutoff` (100) and a short `release` (0.1), the 
#    engine turns the detuned sawtooth into a warm, punchy "thwack" that perfectly 
#    mimics the driving, danceable synth bass of the track.
#
# 2. FM as a Synth Brass: Look at `s_chords`. The `:play_fm` synth is given a 
#    `divisor` of `2` and a `depth` of `4`, with a microscopic `release` (0.15). 
#    This forces the FM synth to produce a harsh, brassy, staccato "hit" that 
#    perfectly mimics the massive synth-brass section stabs that define the song's 
#    upbeat, joyful atmosphere.
#
# 3. The Off-Beat Groove: Look at `s_hats` and `s_chords`. They ALL hit strictly 
#    on steps 2, 6, 10, and 14. In a 16-step grid, these are the exact midpoints 
#    between the kicks. The engine's strict master clock locks these together 
#    perfectly, creating a massive, bouncing "boom-cha" groove that forces you 
#    to dance.
# ==========================================================
