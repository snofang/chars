# ==========================================================
# PLAYBOOK: 70s CINEMATIC FUNK / BLAXPLOITATION
# (Pioneered by Isaac Hayes, Curtis Mayfield, and Bobby Womack)
# ==========================================================
# 
# [WHY THIS GENRE?]
# Cinematic Funk is the sound of 1970s Blaxploitation films –
# bouncy syncopated breaks, deep melodic bass, wah‑wah guitar
# stabs, and sweeping orchestral drones. This playbook uses
# FM synthesis to simulate the wah‑wah guitar/clavinet and
# granular processing for lush cinematic strings.
# ==========================================================

use_bpm 95

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x.....x.x.x....", [
  :c4,
  {note: :c4, amp: 0.8},
  {note: :c4, amp: 1.0},
  {note: :c4, amp: 0.6}
])

s_snare = gen_score("....x..x....x...", [
  {note: :c4, amp: 0.9},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.9}
])

s_hats  = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3}
])

s_bass  = gen_score("x...x.x.x...x...", [
  {note: :f2,  release: 0.3, cutoff: 70},
  {note: :f2,  release: 0.3, cutoff: 70},
  {note: :ab2, release: 0.3, cutoff: 70},
  {note: :c3,  release: 0.3, cutoff: 70},
  {note: :bb2, release: 0.3, cutoff: 70}
])

s_chords = gen_score("..x...x...x.....", [
  {note: [:f3, :ab3, :c4], divisor: 2, depth: 3, release: 0.1, amp: 0.5},
  {note: [:f3, :ab3, :c4], divisor: 2, depth: 3, release: 0.1, amp: 0.5},
  {note: [:eb3, :g3, :bb3], divisor: 2, depth: 3, release: 0.1, amp: 0.5}
])

s_fm    = gen_score("x...x.x..x.x....", [
  {note: :f5,  amp: 0.6, divisor: 2, depth: 4, release: 0.2},
  {note: :ab5, amp: 0.5, divisor: 2, depth: 4, release: 0.2},
  {note: :c6,  amp: 0.6, divisor: 2, depth: 4, release: 0.2},
  {note: :bb5, amp: 0.5, divisor: 2, depth: 4, release: 0.2},
  {note: :ab5, amp: 0.6, divisor: 2, depth: 4, release: 0.2}
])

s_grain = gen_score("x.......x.......", [
  {note: :f3,  buffer: :ambi_choir, pos: 0.3, density: 1, size: 0.3, amp: 0.5},
  {note: :eb3, buffer: :ambi_choir, pos: 0.6, density: 1, size: 0.3, amp: 0.5}
])

# Playbook
playbook = (ring
  # Scene 1: The Street – funky drums, bass, and wah‑wah chords (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4],
    [:play_sub, s_bass, 4], [:play_fm, s_chords, 4] ],
  
  # Scene 2: The Vibe – add cinematic string drone (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_grain, 8] ],
    
  # Scene 3: The Chase – piercing wah‑wah melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_grain, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - FM with divisor 2 and depth 3/4 produces a sharp, staccato
#   “wah‑wah” guitar/clavinet tone that cuts through the mix.
# - The kick syncopation (steps 0,6,8,10) creates a lopsided
#   “Funky Drummer” groove that bridges hip‑hop and soul.
# - Granular size 0.3 time‑stretches the choir into a lush,
#   cinematic string drone that contrasts with the gritty rhythm.
# ==========================================================
