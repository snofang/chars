# ==========================================================
# PLAYBOOK: PLUGG / OPIUM
# Dark, Atmospheric, Distorted Modern Trap
# ==========================================================
# [WHY THIS GENRE?]
# Plugg / Opium (Playboi Carti, Ken Carson) takes the half‑time
# 140 BPM trap grid and replaces bouncy 808s with massive,
# distorted rumbling basses, paired with airy synth plucks
# and relentless hi‑hat rolls. This is the underground,
# modern face of trap.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 140 BPM
# Key: C# minor (dark, atmospheric)
# Rhythm: Half‑time syncopated kick, snare on beat 3,
# fast trap hats with rolls, sparse bass hits.
# Timbre: Distorted 808 bass (dsaw, high cutoff, long release),
# dark FM plucks (divisor 2, depth 2), ethereal pad
# (dark_ambience, long attack/release), granular vocal drone.
# Arrangement: Vibe (pad+plucks+bass) → Groove (add drums)
# → Drop (add granular vocal).
# ==========================================================

use_bpm 140

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Half‑time syncopated kick – hits on step 0 and step 14
s_kick = gen_score("x.............x.",
  [:c4, {note: :c4, amp: 0.7}])

# Heavy metallic snare on beat 3 (step 8)
s_snare = gen_score("........x.......", [:c4])

# Fast trap hats with rising amplitude rolls
hat_data = [
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3}
]
s_hats = gen_score("x.xxx..x.x.xxx.x", hat_data)

# Distorted 808 bass – long release, high cutoff for rumble
s_bass = gen_score("x.......x.......",
  [{note: :cs1, release: 1.5, cutoff: 110, amp: 1.0},
   {note: :e1,  release: 1.5, cutoff: 110, amp: 1.0}])

# Dark airy FM plucks – haunting arpeggio
pluck_data = [
  {note: :cs4, divisor: 2, depth: 2, release: 0.3, amp: 0.6},
  {note: :e4,  divisor: 2, depth: 2, release: 0.3, amp: 0.5},
  {note: :fs4, divisor: 2, depth: 2, release: 0.3, amp: 0.6},
  {note: :gs4, divisor: 2, depth: 2, release: 0.3, amp: 0.5},
  {note: :e4,  divisor: 2, depth: 2, release: 0.3, amp: 0.6},
  {note: :cs4, divisor: 2, depth: 2, release: 0.3, amp: 0.5}
]
s_plucks = gen_score("x..x.x.x..x.x...", pluck_data)

# Ethereal dark pad – long attack/release for drone
s_pad = gen_score("x.......x.......",
  [{note: :cs5, amp: 0.5, attack: 1.0, release: 3.0},
   {note: :e5,  amp: 0.5, attack: 1.0, release: 3.0}])

# Haunting granular vocal drone
s_vocal = gen_score("....x.......x...",
  [{note: :cs4, buffer: :ambi_choir, pos: 0.3, density: 2, size: 0.1, amp: 0.5},
   {note: :e4,  buffer: :ambi_choir, pos: 0.5, density: 2, size: 0.1, amp: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Vibe – Pad, Plucks, Bass
  [ [:play_pad, s_pad, 4], [:play_fm, s_plucks, 4],
    [:play_sub, s_bass, 4] ],

  # Scene 2: Groove – Add Drums
  [ [:play_pad, s_pad, 8], [:play_fm, s_plucks, 8],
    [:play_sub, s_bass, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],

  # Scene 3: Drop – Add Granular Vocal
  [ [:play_pad, s_pad, 8], [:play_fm, s_plucks, 8],
    [:play_sub, s_bass, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Distorted 808: cutoff 110 and release 1.5 on dsaw lets
#   harsh harmonics through, creating a roaring, distorted
#   bass that rings for a bar and a half – the Opium signature.
# - Airy FM plucks: divisor 2 and depth 2 create soft, sine‑like
#   waves that float over the heavy 808s.
# - Extreme contrast: fast 16th hats at 140 BPM against slow,
#   massive bass – the grid locks them together with precision.
# ==========================================================
