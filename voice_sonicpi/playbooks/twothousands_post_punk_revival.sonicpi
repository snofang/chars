# ==========================================================
# PLAYBOOK: 2000s POST-PUNK REVIVAL / INDIE ROCK
# (Pioneered by Interpol, The Strokes, and Franz Ferdinand)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 2000s Post-Punk Revival.
# We have explored 80s Post-Punk (which is stark and cold) and 90s Madchester 
# (which is psychedelic). The 2000s Indie Rock revival is the sound of 
# punchy, studio-perfect garage rock. It relies on a driving 16th-note bass 
# (played with a pick), straight 8th-note drums, and clean, chiming, 
# delayed guitar arpeggios that lock perfectly with the bassline.
#
# This playbook perfectly demonstrates how to use the `:play_sub` synth 
# as a driving, melodic picked bass, and how to use `:play_fm` to create 
# a clean, echoing guitar riff that weaves perfectly through the rhythm.
# ==========================================================

use_bpm 120

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Minor - Punchy, Melancholic, & Driving)
# ==========================================================

# Driving rock kick. Hits on 1, the 'and' of 2, and 3.
s_kick = gen_score("x.....x.x.......", [:c4, {note: :c4, amp: 0.8}, :c4])

# Crisp, dry snare strictly on beats 2 and 4.
s_snare = gen_score("....x.......x...", [:c4])

# Straight, rigid 8th hats to drive the momentum.
s_hats = gen_score("x.x.x.x.x.x.x.x.", [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}])

# The "Picked" Driving Bass (F# Minor).
# Plays continuous 16th notes, mimicking a picked bass guitar. 
# Mid cutoff (90) and very short release (0.1) create a punchy, aggressive churn.
bass_notes = [:fs2, :fs2, :fs2, :e2, :fs2, :fs2, :fs2, :d2, 
              :fs2, :fs2, :fs2, :e2, :fs2, :fs2, :fs2, :d2]
bass_data = bass_notes.map { |n| {note: n, cutoff: 90, release: 0.1, amp: 1.0} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Clean, "Chiming" Guitar Arpeggio (F# Minor).
# Uses :play_fm with a high divisor (3) and low depth (2) to create a clean, 
# glassy guitar tone. Routed through the engine's tape echo for a smear.
guitar_notes = [:fs4, :a4, :c5, :e5, :c5, :a4, :fs4, :e4]
guitar_data = guitar_notes.map { |n| {note: n, amp: 0.5, divisor: 3, depth: 2, release: 0.2} }
s_guitar = gen_score("x..x..x..x..x..x", guitar_data)

# Sweeping, dark "Synth Pad" (F#m to Dmaj7).
# Hit on the downbeats. Slow attack (1.0) and massive release (3.0) 
# blur the chords into a continuous, moody background wave.
s_chords = gen_score("x...............", [
  {note: [:fs3, :a3, :c4, :e4], cutoff: 80, attack: 1.0, release: 3.0, amp: 0.4}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Garage - Just the driving drums, bass, and guitar (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_fm, s_guitar, 4] ],
  
  # Scene 2: The Vibe - Add the sweeping synth pad (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_guitar, 8], [:play_chords, s_chords, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN INDIE ROCK MOMENTUM]
# 
# 1. The Picked Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step, mapping out a melodic line. By using a mid-range 
#    `cutoff` (90) and a very short `release` (0.1), the engine turns the 
#    detuned sawtooth into a punchy, aggressive "thwack" that perfectly 
#    mimics a picked electric bass guitar driving the rhythm, a hallmark 
#    of bands like Interpol and Franz Ferdinand.
#
# 2. The Chiming Guitar: The `s_guitar` sequence uses `divisor: 3` and 
#    `depth: 2`. This harmonic ratio produces a clean, glassy tone that 
#    mimics a chiming electric guitar. Because it's routed through the 
#    engine's tape echo, the sparse notes cascade across the empty space, 
#    perfectly anchoring the track's melancholic, 2000s indie atmosphere.
#
# 3. Rigid 8th-Note Drive: 2000s Post-Punk Revival relies on a stark, 
#    driving rhythm section. The `s_hats` play straight 8th notes, and 
#    the `s_kick` avoids complex syncopation. The engine's strict master 
#    clock ensures this rigid, mechanical momentum locks perfectly with 
#    the continuous 16th-note bassline.
# ==========================================================
