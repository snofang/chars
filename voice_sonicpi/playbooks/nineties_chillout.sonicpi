# ==========================================================
# PLAYBOOK: 90s CHILLOUT / DOWNTEMPO
# (Pioneered by Thievery Corporation, Zero 7, and Bonobo)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# 90s Chillout pairs a slow hip‑hop drum grid with warm acoustic
# bass, lush electric piano chords, and organic percussion.
# This playbook uses FM synthesis for a Rhodes tone and granular
# texture for a distant vocal sigh that drifts over the beat.
# ==========================================================

use_bpm 85

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x......x..x.....", [
  {note: :c4, amp: 0.8},
  {note: :c4, amp: 0.6},
  {note: :c4, amp: 1.0}
])

s_snare = gen_score("....x..x....x..x", [
  {note: :c4, amp: 0.8},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.8},
  {note: :c4, amp: 0.3}
])

s_hats  = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3}
])

s_bass  = gen_score("x.....x..x....x.", [
  {note: :f2, release: 0.4, cutoff: 70},
  {note: :f2, release: 0.4, cutoff: 70},
  {note: :ab2, release: 0.4, cutoff: 70},
  {note: :c3, release: 0.4, cutoff: 70}
])

s_chords = gen_score("x.......x.......", [
  {note: [:f3, :ab3, :c4, :eb4], cutoff: 85, release: 1.0, amp: 0.6},
  {note: [:db3, :e3, :ab3, :b3], cutoff: 85, release: 1.0, amp: 0.6}
])

s_fm    = gen_score("....x.....x.....", [
  {note: :c5, amp: 0.5, divisor: 3, depth: 1, release: 1.0},
  {note: :ab4, amp: 0.4, divisor: 3, depth: 1, release: 1.0}
])

s_grain = gen_score("x...............", [
  {note: :f4, buffer: :ambi_choir, pos: 0.4, density: 1, size: 0.2, amp: 0.5}
])

# Playbook
playbook = (ring
  # Scene 1: The Vibe – chords, bass, vocal sigh (4 bars)
  [ [:play_chords, s_chords, 4], [:play_sub, s_bass, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Groove – add swung organic drums (8 bars)
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Late Night – echoing Rhodes melody drops (8 bars)
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The FM melody uses divisor 3 & depth 1 to emulate a warm
#   Fender Rhodes electric piano through tape echo.
# - Hi‑hats leave gaps and vary amplitude (0.2–0.4) to create
#   a relaxed, human swing feel.
# - Bass and chords use low cutoff (70 & 85) for a muffled,
#   round warmth that pairs perfectly with the organic drums.
# ==========================================================
