# ==========================================================
# PLAYBOOK: DONNA SUMMER - "I FEEL LOVE" (1977)
# ==========================================================

use_bpm 128

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (C Minor - Hypnotic, Electronic, & Driving)
# ==========================================================

# Relentless, driving 4/4 kick. (4 x's, 1 element)
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, organic clap strictly on beats 2 and 4. (2 x's, 1 element)
s_clap = gen_score("....x.......x...", [:c4])

# Off-beat open hats to drive the momentum. (4 x's, 4 elements)
s_hats = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, 
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}
])

# The "Moroder" Sequencer Bass (C Minor).
# Plays continuous, driving 16th notes. 
# High cutoff (100) and microscopic release (0.05) create a relentless, 
# hypnotic, buzzing Moog-like churn. (16 x's, 16 elements)
bass_notes = [:c2, :c2, :c2, :c2, :eb2, :eb2, :eb2, :eb2, 
              :g2, :g2, :g2, :g2, :f2, :f2, :f2, :f2]
bass_data = bass_notes.map { |n| {note: n, cutoff: 100, release: 0.05, amp: 1.0} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Lush, "Synth Pad" Chords (Cm to Ab to Eb to G).
# Hit on the downbeats. The slow 1.0-beat attack and massive 3.0-beat release 
# blur the chords together into a continuous, cinematic wave. (4 x's, 4 elements)
s_chords = gen_score("x...x...x...x...", [
  {note: [:c3, :eb3, :g3], cutoff: 80, attack: 1.0, release: 3.0, amp: 0.4},
  {note: [:ab2, :c3, :eb3], cutoff: 80, attack: 1.0, release: 3.0, amp: 0.4},
  {note: [:eb3, :g3, :bb3], cutoff: 80, attack: 1.0, release: 3.0, amp: 0.4},
  {note: [:g3, :bb3, :d4], cutoff: 80, attack: 1.0, release: 3.0, amp: 0.4}
])

# Piercing, "Catchy" Synth Lead (C Minor Pentatonic).
# Uses :play_fm with a high divisor (3) and mid depth (3) to create a sharp, 
# glassy, digital tone. Routed through the global tape echo. (8 x's, 8 elements)
lead_notes = [:c5, :eb5, :g5, :c6, :bb5, :g5, :eb5, :c5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 3, release: 0.15} }
s_lead = gen_score("x.x.x.x.x.x.x.x.", lead_data)

# "Ahh" Vocal Drone (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched UP.
# Long size (0.4) and low density (1) creates a slow, evolving, ethereal texture. (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :c4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.4, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the sequencer bass, sweeping pads, and drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Verse - Add the relentless 4/4 drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chorus - The piercing synth lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN ELECTRONIC POP]
# 
# 1. The Moroder Sequencer: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step, mapping out a driving, root-note progression. By 
#    using a high `cutoff` (100) and a microscopic `release` (0.05), the engine 
#    creates a relentless, hypnotic, buzzing churn that perfectly mimics the 
#    legendary Moog sequencer bassline that birthed modern dance music.
#
# 2. The Cinematic Swell: Look at `s_chords`. The Hashes specify an `attack` 
#    of `1.0` and a `release` of `3.0`. Because the engine reads these 
#    Hashes, the chords don't just hit; they slowly swell into the mix and 
#    fade away over four whole beats, creating a continuous, blurred wave 
#    of warm harmony that perfectly mimics the lush, wide-stereo synth pads 
#    of the late 70s.
#
# 3. The Off-Beat Groove: Look at `s_hats` and `s_clap`. The hats hit strictly 
#    on steps 2, 6, 10, and 14, while the clap hits on 4 and 12. The engine's 
#    strict master clock locks these together perfectly, creating the massive, 
#    bouncing "boom-cha" groove that became the blueprint for decades of pop 
#    and dance music to follow.
# ==========================================================
