# ==========================================================
# PLAYBOOK: MELODIC TECHNO / AFTERLIFE
# ==========================================================
# Hypnotic techno with rolling basslines and emotional cinematic progressions.
# DNA: 125 BPM | Key A Minor | Rhythm: 4-on-the-floor with 16th-note roll | Timbre: Bright, driving, cinematic | Arrangement: Hypnosis → Tension → Release
# ==========================================================

use_bpm 125

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# ==========================================================
# DRUM PATTERNS
# ==========================================================

# Relentless 4-on-the-floor kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Deep analog clap on beats 2 and 4
s_clap = gen_score("....x.......x...", [:c4])

# Off-beat open hats
s_hats = gen_score("..x...x...x...x.", [
  {amp: 0.3},
  {amp: 0.4}
])

# ==========================================================
# ROLLING BASS WITH FILTER SWEEP
# ==========================================================

# Hypnotic bassline on every 16th note with evolving cutoff
# Creates a "breathing" modular filter envelope
s_bass = gen_score("xxxxxxxxxxxxxxxx", [
  {note: :a1, cutoff: 70},
  {note: :a2, cutoff: 75},
  {note: :a1, cutoff: 80},
  {note: :a2, cutoff: 85},
  {note: :a1, cutoff: 90},
  {note: :a2, cutoff: 95},
  {note: :a1, cutoff: 100},
  {note: :a2, cutoff: 105},
  {note: :f1, cutoff: 100},
  {note: :f2, cutoff: 95},
  {note: :f1, cutoff: 90},
  {note: :f2, cutoff: 85},
  {note: :g1, cutoff: 80},
  {note: :g2, cutoff: 75},
  {note: :g1, cutoff: 70},
  {note: :g2, cutoff: 65}
])

# ==========================================================
# HARMONIC & MELODIC ELEMENTS
# ==========================================================

# Emotional off-beat supersaw chords (Am → F → G)
s_chords = gen_score("..x..x..x..x..x.", [
  {note: [:a3, :c4, :e4], cutoff: 110, release: 1.0, amp: 0.6},
  {note: [:f3, :a3, :c4], cutoff: 110, release: 1.0, amp: 0.6},
  {note: [:g3, :bb3, :d4], cutoff: 110, release: 1.0, amp: 0.6}
])

# Echoing modular pluck arpeggio (A minor)
s_fm = gen_score("x.x.x.x.x.x.x.x.", [
  :a4,
  :e5,
  :c5,
  :e5,
  :a4,
  :e5,
  :g4,
  :d5
])

# Ethereal granular vocal drone
s_grain = gen_score("x.......x.......", [
  {note: :a3, buffer: :ambi_choir, pos: 0.2, density: 2, size: 0.2, amp: 0.5},
  {note: :f3, buffer: :ambi_choir, pos: 0.5, density: 2, size: 0.2, amp: 0.5}
])

# ==========================================================
# PLAYBOOK STRUCTURE
# ==========================================================

playbook = (ring
  
  # Scene 1: The Hypnosis (4 bars)
  # Foundation: Kick, rolling bass, and vocal drone
  [
    [:play_kick,  s_kick, 4],
    [:play_sub,   s_bass, 4],
    [:play_grain, s_grain, 4]
  ],
  
  # Scene 2: The Tension (8 bars)
  # Add claps, hats, and emotional chords
  [
    [:play_kick,   s_kick, 8],
    [:play_sub,    s_bass, 8],
    [:play_grain,  s_grain, 8],
    [:play_snare,  s_clap, 8],
    [:play_hats,   s_hats, 8],
    [:play_chords, s_chords, 8]
  ],
  
  # Scene 3: The Release (8 bars)
  # Modular pluck arpeggio completes the arrangement
  [
    [:play_kick,   s_kick, 8],
    [:play_sub,    s_bass, 8],
    [:play_grain,  s_grain, 8],
    [:play_snare,  s_clap, 8],
    [:play_hats,   s_hats, 8],
    [:play_chords, s_chords, 8],
    [:play_fm,     s_fm, 8]
  ]
)

# ==========================================================
# RUN
# ==========================================================

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - 16-step bassline with evolving cutoff creates hypnotic filter sweep
# - Off-beat chord stabs sync with hats for driving momentum
# - Echo delays fill arpeggio gaps for cinematic shimmer
# - Vocal drone adds ethereal texture throughout
# - Alternating octaves in bassline creates rolling movement
# ==========================================================
