# ==========================================================
# PLAYBOOK: 90s GANGSTA RAP / NY BOOM-BAP
# (Pioneered by Mobb Deep, Wu-Tang Clan, and Nas)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Gangsta Rap / NY Boom-Bap.
# We have explored West Coast G-Funk and modern Trap, but 90s NY Boom-Bap 
# is the sound of grimy, underground New York City. It relies on a heavily 
# swung, dusty drum break, a haunting, repetitive 2-note piano or horn loop, 
# deep, rumbling sub-bass, and extreme, suffocating negative space. 
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create a dark, hypnotic, and menacing atmosphere. By using the `:play_fm` 
# synth to simulate a haunting piano loop and leaving massive gaps (`nil`) 
# in the grid, the engine creates a stark, cinematic soundscape that feels 
# like walking through a 1990s Brooklyn project hallway.
# ==========================================================

use_bpm 85

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (C# Minor - Dark, Gritty, & Hypnotic)
# ==========================================================

# The "Boom-Bap" Kick. 
# Heavily swung. Hits on step 0, the 'and' of 2 (step 6), and beat 3 (step 8).
s_kick = gen_score("x.....x.x.......", [:c4, {note: :c4, amp: 0.8}, :c4])

# Crisp, dusty snare strictly on beats 2 and 4.
s_snare = gen_score("....x.......x...", [:c4])

# Swung, lazy 16th hats. Notice the heavy velocity manipulation.
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.1}, 
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# Deep, rumbling sub-bass (C# Minor).
# Massive release (1.0) allows the bass to ring out and carry the dark melody.
s_bass = gen_score("x.......x.......", [
  {note: :cs1, release: 1.0, cutoff: 60, amp: 1.2}, 
  {note: :g1, release: 1.0, cutoff: 60, amp: 1.0}
])

# Haunting, "Piano Loop" Stabs (C#m to Gm).
# Uses :play_fm with a low divisor (2) and mid depth (3) to create a warm, 
# slightly dissonant, staccato hit that mimics a dusty vinyl piano sample.
s_chords = gen_score("x.......x.......", [
  {note: [:cs3, :e3], divisor: 2, depth: 3, release: 0.8, amp: 0.5},
  {note: [:g2, :bb2], divisor: 2, depth: 3, release: 0.8, amp: 0.5}
])

# Eerie, "High-Pitched" Sine Lead (C# Minor Pentatonic).
# Uses :play_fm with a high divisor (4) and low depth (1) to create a clean, 
# piercing sine wave that cuts through the heavy mix.
lead_notes = [:cs5, :g4, :bb4, :cs5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.5, divisor: 4, depth: 1, release: 0.5} }
s_lead = gen_score("x...x...x...x...", lead_data)

# Pitched-down, "Street" vocal grunt (Granular Synth).
# Low density, small size = a dark, percussive vocal hit.
s_vocal = gen_score("........x.......", [
  {note: :cs3, buffer: :misc_lori, pos: 0.1, density: 1, size: 0.05, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Alley - Just the haunting piano, sub-bass, and vocal grunt (4 bars)
  [ [:play_fm, s_chords, 4], [:play_sub, s_bass, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Groove - Add the swung boom-bap drums (8 bars)
  [ [:play_fm, s_chords, 8], [:play_sub, s_bass, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Drop - The eerie high-pitched sine lead drops (8 bars)
  [ [:play_fm, s_chords, 8], [:play_sub, s_bass, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN GRITTY ATMOSPHERE]
# 
# 1. The Haunting Piano Loop: Look at `s_chords`. The `:play_fm` synth is 
#    given a `divisor` of `2` and a `depth` of `3`, playing only 2 notes 
#    at a time. This creates a stark, slightly dissonant, staccato hit that 
#    perfectly mimics the haunting, repetitive piano loops sampled from 
#    dusty vinyl records by 90s NY producers like Havoc (Mobb Deep) and RZA.
#
# 2. The Boom-Bap Swing: Look at `s_kick`. Instead of hitting on step 4 
#    (beat 2), it hits on step 6 (the 'and' of beat 2). This pushes the 
#    groove late, creating that heavy, leaning, "boom-bap" swing. The 
#    engine's strict master clock ensures this swung rhythm locks perfectly 
#    with the lazy, heavily manipulated hi-hats.
#
# 3. Extreme Negative Space: 90s Gangsta Rap relies on what you *don't* play. 
#    80% of the `s_kick` and `s_chords` grids are `nil`. The engine honors 
#    these rests perfectly, letting the massive sub-bass and the reverb 
#    tails of the snare ring out into the void, creating a slow, suffocating 
#    atmosphere of dread.
# ==========================================================
