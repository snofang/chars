# ==========================================================
# PLAYBOOK: MIDTEMPO BASS / INDUSTRIAL BASS
# ==========================================================
# Dark, swaggering half-time groove with metallic FM bass and eerie atmospheres.
# DNA: 105 BPM | Key G# Minor | Rhythm: Half-time with syncopation | Timbre: Metallic, dark, eerie | Arrangement: Void → Groove → Drop
# ==========================================================

use_bpm 105

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# ==========================================================
# DRUM PATTERNS
# ==========================================================

# Syncopated half-time kick with accents
s_kick = gen_score("x......xx......x", [
  {amp: 1.2},
  {amp: 0.8},
  {amp: 1.0},
  {amp: 0.6}
])

# Heavy snare on beat 3 with ghost note
s_snare = gen_score("........x...x...", [
  {amp: 0.9},
  {amp: 0.4}
])

# Swung hats with triplet feel
s_hats = gen_score("x..x.x..x..xx.xx.", [
  {amp: 0.3},
  {amp: 0.4},
  {amp: 0.2},
  {amp: 0.3},
  {amp: 0.5},
  {amp: 0.3},
  {amp: 0.2}
])

# ==========================================================
# BASS WITH SIDECHAIN SIMULATION
# ==========================================================

# Metallic FM bass with amp modulation
# Amp dips when kick hits (steps 0, 7, 8, 15) and pumps between
s_bass = gen_score("x..x..x.xx..x..x.", [
  {note: :gs1, divisor: 2, depth: 6, release: 0.2, amp: 0.2},
  {note: :gs1, divisor: 2, depth: 6, release: 0.2, amp: 0.9},
  {note: :gs1, divisor: 2, depth: 6, release: 0.2, amp: 0.2},
  {note: :gs1, divisor: 2, depth: 6, release: 0.2, amp: 0.2},
  {note: :cs2, divisor: 2, depth: 6, release: 0.2, amp: 0.9},
  {note: :ds2, divisor: 2, depth: 6, release: 0.2, amp: 0.2}
])

# ==========================================================
# HARMONIC & MELODIC ELEMENTS
# ==========================================================

# Dark minor chords (G#m → C#m) on off-beats
s_chords = gen_score("..x.....x.......", [
  {note: [:gs3, :b3, :eb4], cutoff: 90, release: 1.0, amp: 0.5},
  {note: [:cs3, :e3, :gs3], cutoff: 90, release: 1.0, amp: 0.5}
])

# Piercing alien FM blips (G# minor pentatonic)
s_fm = gen_score("....x.......x...", [
  {note: :gs5, amp: 0.6, divisor: 4, depth: 4},
  {note: :ds5, amp: 0.5, divisor: 4, depth: 4}
])

# Eerie time-stretched vocal drone
s_grain = gen_score("x...............", [
  {note: :gs3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.15, amp: 0.5}
])

# ==========================================================
# PLAYBOOK STRUCTURE
# ==========================================================

playbook = (ring
  
  # Scene 1: The Void (4 bars)
  # Eerie drone and metallic bass establish the dark atmosphere
  [
    [:play_grain, s_grain, 4],
    [:play_fm,    s_bass, 4]
  ],
  
  # Scene 2: The Groove (8 bars)
  # Half-time drums and dark chords enter
  [
    [:play_grain,  s_grain, 8],
    [:play_fm,     s_bass, 8],
    [:play_kick,   s_kick, 8],
    [:play_snare,  s_snare, 8],
    [:play_hats,   s_hats, 8],
    [:play_chords, s_chords, 8]
  ],
  
  # Scene 3: The Drop (8 bars)
  # Piercing FM blips complete the arrangement
  [
    [:play_grain,  s_grain, 8],
    [:play_fm,     s_bass, 8],
    [:play_kick,   s_kick, 8],
    [:play_snare,  s_snare, 8],
    [:play_hats,   s_hats, 8],
    [:play_chords, s_chords, 8],
    [:play_lead,   s_fm, 8]
  ]
)

# ==========================================================
# RUN
# ==========================================================

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Amp modulation simulates sidechain compression on bass
# - Extreme FM ratio (divisor 2, depth 6) creates metallic clank
# - Time-stretched vocal drone adds ghostly atmosphere
# - Syncopated kick pattern defines the swaggering half-time groove
# - Sparse chords on off-beats create sense of dread
# ==========================================================
