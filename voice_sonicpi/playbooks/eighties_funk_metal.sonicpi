# ==========================================================
# PLAYBOOK: 80s FUNK METAL / ALTERNATIVE FUNK
# (Pioneered by Faith No More, Red Hot Chili Peppers, and Infectious Grooves)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 80s Funk Metal.
# We have explored Funk Rock and Thrash Metal, but Funk Metal is the sound 
# of the late 80s alternative crossover. It fuses the aggressive, syncopated 
# grooves of funk with the heavy, distorted riffs of metal. It relies on 
# a driving, "slap" bassline that acts as the lead instrument, massive, 
# distorted power chords, and a piercing, echoing clean guitar that floats 
# over the heavy rhythm section.
#
# This playbook perfectly demonstrates how to use the `:play_sub` synth 
# as a continuous, driving slap bass, and how to use the `:play_fm` synth 
# with an extreme `depth` to simulate a heavily distorted electric guitar.
# ==========================================================

use_bpm 115

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (E Dorian - Aggressive, Funky, & Heavy)
# ==========================================================

# The "Funk Metal" Kick. 
# A syncopated, driving rock march. (5 x's, 5 elements)
s_kick = gen_score("x..x..x.x..x....", [
  :c4, {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.6}, :c4
])

# Heavy, dry snare strictly on beats 2 and 4, with a ghost note. (3 x's, 3 elements)
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.3}, {note: :c4, amp: 1.0}
])

# Fast, driving 16th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Slap" Bass (E Dorian).
# Plays continuous, driving 16th notes. High cutoff (100) and short release (0.1) 
# create a punchy, aggressive "thwack" that mimics a slapped electric bass. 
# (16 x's, 16 elements)
bass_notes = [:e1, :e1, :e2, :e1, :e1, :e1, :e2, :e1, 
              :g1, :g1, :g2, :g1, :a1, :a1, :a2, :a1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 100, release: 0.1, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# Massive, "Distorted" Power Chords (E5 to G5 to A5).
# Uses :play_fm with a low divisor (2) and extreme depth (6) to create a 
# harsh, grinding hit. Plays a classic, palm-muted metal riff. (3 x's, 3 elements)
s_chords = gen_score("x.....x...x.....", [
  {note: [:e3, :b3], divisor: 2, depth: 6, release: 0.15, amp: 0.7},
  {note: [:g3, :d4], divisor: 2, depth: 6, release: 0.15, amp: 0.7},
  {note: [:a3, :e4], divisor: 2, depth: 6, release: 0.15, amp: 0.7}
])

# Clean, "Chiming" Guitar Arpeggio (E Dorian).
# Uses :play_pluck. Plays continuous, rhythmic 16th notes to build tension. 
# (16 x's, 16 elements)
guitar_notes = [:e3, :b3, :e4, :b3, :e3, :b3, :e4, :b3, 
                :g3, :d4, :g4, :d4, :a3, :e4, :a4, :e4]
guitar_data = guitar_notes.map { |n| {note: n, amp: 0.5, release: 0.15, coef: 0.6} }
s_guitar = gen_score("x.x.x.x.x.x.x.x.", guitar_data)

# Piercing, "Psychedelic" Lead Solo (E Minor Pentatonic).
# Uses :play_lead routed through the global tape echo bus. The long release (0.3) 
# creates a soaring, echoing solo that cuts through the heavy mix. (6 x's, 6 elements)
lead_notes = [:e5, :g5, :a5, :b5, :a5, :g5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, cutoff: 110, release: 0.3} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Shouted" Vocal (Granular Synth).
# Using the built-in :ambi_choir sample.
# Long size (0.08) creates a raw, repetitive vocal hit. (1 x, 1 element)
s_grain = gen_score("........x.......", [
  {note: :e3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.08, amp: 0.8}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the slap bass, power chords, and clean guitar (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_chords, 4], [:play_pluck, s_guitar, 4], 
    [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Heavy - Add the syncopated drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_pluck, s_guitar, 8], 
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], 
    [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Solo - The piercing psychedelic lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_pluck, s_guitar, 8], 
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], 
    [:play_hats, s_hats, 8], [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN FUNK METAL FUSION]
# 
# 1. The Slap Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step, alternating between the low octave (:e1) and the 
#    high octave (:e2). By using a high `cutoff` (100) and a very short 
#    `release` (0.1), the engine turns the detuned sawtooth into a punchy, 
#    aggressive "thwack" that perfectly mimics the legendary slap basslines 
#    of players like Flea and Les Claypool.
#
# 2. FM as a Distorted Amp: Look at `s_chords`. The `:play_fm` synth is 
#    given a `divisor` of `2` and an extreme `depth` of `6`. This harsh 
#    harmonic ratio forces the FM modulator to grind the carrier wave, 
#    creating a harsh, distorted square wave. By playing palm-muted, syncopated 
#    riffs, the engine perfectly mimics the aggressive rhythm guitars of 80s 
#    Funk Metal.
#
# 3. The Clean Contrast: Funk Metal relies on the stark contrast between the 
#    aggressive, distorted rhythm section and clean, chiming guitar arpeggios. 
#    The `s_guitar` sequence uses the `:play_pluck` synth with a mid `coef` (0.6) 
#    and a short `release` (0.15), creating a sharp, rhythmic, clean guitar 
#    texture that perfectly anchors the track's heavy, funky atmosphere.
# ==========================================================
