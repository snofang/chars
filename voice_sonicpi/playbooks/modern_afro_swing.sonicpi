# ==========================================================
# PLAYBOOK: MODERN AFRO SWING / UK AFROBASHMENT
# (Pioneered by J Hus, NSG, and Burna Boy)
# ==========================================================
# [WHY THIS GENRE?]
# Afro Swing fuses syncopated Dancehall/Afrobeats rhythms with
# UK rap, deep sub‑bass, and warm plucked loops. This playbook
# demonstrates a highly syncopated “dancing” drum grid, a round
# sub‑bass, and off‑beat chords that create an infectious modern
# groove.
# [DNA: 105 BPM, F# minor, syncopated kick & off‑beat skank,
#  warm/muffled bass, glassy FM lead, granular vocal chops]
# ==========================================================

use_bpm 105

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# ----------------------------------------------------------
# SCORES – Normalized with gen_score
# ----------------------------------------------------------

# Syncopated kick – hits on steps 0, 6, 8, 12
s_kick = gen_score("x.....x.x...x...",
  [:c4,
   {note: :c4, amp: 0.8},
   {note: :c4, amp: 1.0},
   {note: :c4, amp: 0.7}])

# Snare on beats 2 and 4 (steps 4 and 12)
s_snare = gen_score("....x.......x...",
  [{note: :c4, amp: 0.9},
   {note: :c4, amp: 0.9}])

# Swung 16th hi‑hats – busy and bouncy
s_hats = gen_score(".x.x.xx..x.x.xx.",
  [{note: :c4, amp: 0.2},
   {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.4}])

# Deep, round sub‑bass – F# minor walking line, low cutoff
s_bass = gen_score("x..x.x..x..x.x..",
  [{note: :fs1, release: 0.3, cutoff: 65},
   {note: :fs1, release: 0.3, cutoff: 65},
   {note: :a1,  release: 0.3, cutoff: 65},
   {note: :fs1, release: 0.3, cutoff: 65},
   {note: :b1,  release: 0.3, cutoff: 65},
   {note: :a1,  release: 0.3, cutoff: 65}])

# Off‑beat plucked guitar chords (F#m – A – B)
s_chords = gen_score("..x...x...x...x.",
  [[:fs3, :a3, :c4],
   [:a3, :c4, :e4],
   [:fs3, :a3, :c4],
   [:b2, :d3, :fs3]])

# Bright marimba/flute melody (F# minor pentatonic) – via FM
s_fm = gen_score(".x..x.x...x..x.x",
  [{note: :fs5, amp: 0.6, divisor: 2, depth: 2, release: 0.2},
   {note: :a5,  amp: 0.5, divisor: 2, depth: 2, release: 0.2},
   {note: :c6,  amp: 0.6, divisor: 2, depth: 2, release: 0.2},
   {note: :b5,  amp: 0.5, divisor: 2, depth: 2, release: 0.2},
   {note: :a5,  amp: 0.6, divisor: 2, depth: 2, release: 0.2},
   {note: :fs5, amp: 0.7, divisor: 2, depth: 2, release: 0.2}])

# Rhythmic vocal chops – granular cloud, sharp and sugary
s_vocal = gen_score("..x...x....x....",
  [{note: :fs4, buffer: :ambi_choir, pos: 0.2, density: 2, size: 0.05, amp: 0.5},
   {note: :a4,  buffer: :ambi_choir, pos: 0.4, density: 2, size: 0.05, amp: 0.5},
   {note: :c4,  buffer: :ambi_choir, pos: 0.6, density: 2, size: 0.05, amp: 0.5}])

# ----------------------------------------------------------
# PLAYBOOK
# ----------------------------------------------------------
playbook = (ring
  # Scene 1 – The Vibe: drums, bass, and off‑beat pluck (4 bars)
  [ [:play_kick, s_kick, 4],
    [:play_snare, s_snare, 4],
    [:play_hats, s_hats, 4],
    [:play_sub, s_bass, 4],
    [:play_pluck, s_chords, 4] ],

  # Scene 2 – The Groove: add vocal chops (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8],
    [:play_pluck, s_chords, 8],
    [:play_grain, s_vocal, 8] ],

  # Scene 3 – The Drop: bright marimba melody enters (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8],
    [:play_pluck, s_chords, 8],
    [:play_grain, s_vocal, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# 1. Afro Swing Syncopation – The kick avoids the 4/4 pulse
#    (steps 0,6,8,12), creating a “dancing” lopsided groove.
# 2. Off‑Beat Skank – The plucked chords hit exactly on steps
#    2,6,10,14, locking between the kicks for that signature bounce.
# 3. Deep Harmonic Warmth – Sub‑bass uses a low cutoff (65) and
#    the FM lead uses a low divisor (2) for a woody, organic tone.
# ==========================================================
