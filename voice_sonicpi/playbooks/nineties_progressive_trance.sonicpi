# ==========================================================
# PLAYBOOK: 90s PROGRESSIVE TRANCE / EPIC TRANCE
# Driving, Emotional, Sidechained Festival Energy
# ==========================================================
# [WHY THIS GENRE?]
# Progressive Trance (Paul van Dyk, Tiësto) builds tension
# through a continuous 16th-note bassline with sidechain
# pump, massive off‑beat supersaw chords, and echoing
# arpeggios. This playbook captures that classic 90s
# festival‑anthem momentum.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 134 BPM
# Key: A minor (emotional, driving)
# Rhythm: 4/4 kick, clap on 2/4, off‑beat hats and chords,
# rolling 16th bass with amplitude ducking (sidechain sim),
# arpeggios with gaps, sparse granular pad.
# Timbre: Punchy kick (bd_haus), analog clap (sn_dolf),
# off‑beat hats (cymbal_closed), sidechained bass (dsaw with
# amp modulation), supersaw chords (blade, high cutoff,
# long release), FM pluck arpeggio (fm, tape echo), ethereal
# granular pad (ambi_choir).
# Arrangement: Hypnosis (kick+bass+pad) → Build (add claps+
# hats+arpeggio) → Anthem (add supersaw chords).
# ==========================================================

use_bpm 134

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Relentless 4‑on‑the‑floor kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Deep analog clap on beats 2 and 4
s_clap = gen_score("....x.......x...", [:c4])

# Off‑beat open hats (steps 2,6,10,14) with alternating amplitude
s_hats = gen_score("..x...x...x...x.",
  [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.4}])

# Sidechained rolling bass – amplitude ducks on kick steps (0,4,8,12)
bass_data = [
  {note: :a1, amp: 0.3}, {note: :a1, amp: 1.0}, {note: :a1, amp: 0.3}, {note: :a1, amp: 1.0},
  {note: :a1, amp: 0.3}, {note: :a1, amp: 1.0}, {note: :a1, amp: 0.3}, {note: :a1, amp: 1.0},
  {note: :f1, amp: 0.3}, {note: :f1, amp: 1.0}, {note: :f1, amp: 0.3}, {note: :f1, amp: 1.0},
  {note: :g1, amp: 0.3}, {note: :g1, amp: 1.0}, {note: :g1, amp: 0.3}, {note: :g1, amp: 1.0}
]
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Massive off‑beat supersaw chords (steps 2,6,10,14)
chord_data = [
  {note: [:a3, :c4, :e4], cutoff: 110, release: 1.5, amp: 0.6},
  {note: [:a3, :c4, :e4], cutoff: 110, release: 1.5, amp: 0.6},
  {note: [:f3, :a3, :c4], cutoff: 110, release: 1.5, amp: 0.6},
  {note: [:g3, :bb3, :d4], cutoff: 110, release: 1.5, amp: 0.6}
]
s_chords = gen_score("..x...x...x...x.", chord_data)

# Modular pluck arpeggio – sparse, routed through tape echo
fm_notes = [:a4, :c5, :e5, :c5, :a4, :c5, :e5, :g4]
s_fm = gen_score("x.x.x.x.x.x.x.x.", fm_notes)

# Ethereal granular pad – slow evolving texture
s_grain = gen_score("x.......x.......",
  [{note: :a3, buffer: :ambi_choir, pos: 0.2, density: 2, size: 0.2, amp: 0.5},
   {note: :f3, buffer: :ambi_choir, pos: 0.5, density: 2, size: 0.2, amp: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Hypnosis – Kick, Bass, Pad
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4],
    [:play_grain, s_grain, 4] ],

  # Scene 2: Build – Add Claps, Hats, Arpeggio
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8], [:play_snare, s_clap, 8],
    [:play_hats, s_hats, 8], [:play_fm, s_fm, 8] ],

  # Scene 3: Anthem – Add Supersaw Chords
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8], [:play_snare, s_clap, 8],
    [:play_hats, s_hats, 8], [:play_fm, s_fm, 8],
    [:play_chords, s_chords, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Data‑driven sidechain: bass amp drops to 0.3 on kick steps
#   (0,4,8,12) and jumps to 1.0 between – pure data simulation.
# - Off‑beat supersaw: chords on steps 2,6,10,14 with high
#   cutoff (110) and long release (1.5) create soaring brightness.
# - Echoing arpeggio: sparse notes with gaps; tape echo fills
#   the space, creating a massive cascading festival feel.
# ==========================================================
