# ==========================================================
# PLAYBOOK: 90s PROGRESSIVE TRANCE / EPIC TRANCE
# (Pioneered by Paul van Dyk, Tiësto, and Sasha)
# ==========================================================
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Progressive 
# Trance. We have explored rolling techno basslines and euphoric hardcore, 
# but classic Trance is the absolute masterclass in building tension over 
# a rigid 16-step grid. It relies on a continuous 16th-note bassline that 
# "pumps" via sidechain compression, massive, wide supersaw chords that 
# hit on the off-beats, and echoing arpeggios that slowly evolve.
#
# This playbook perfectly demonstrates how to use the Parameter Hashes 
# (`amp`) to simulate sidechain compression purely via data. By making 
# the bassline volume dip on every kick drum hit, the engine creates 
# that massive, breathing, festival-anthem momentum.
# ==========================================================

use_bpm 134

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Driving & Emotional)
# ==========================================================

# Relentless, driving 4-on-the-floor kick.
s_kick  = (ring :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil)

# Deep, analog clap strictly on beats 2 and 4 (steps 4 and 12).
s_clap  = (ring nil, nil, nil, nil, :c4, nil, nil, nil, nil, nil, nil, nil, :c4, nil, nil, nil)

# Off-beat open hats to drive the momentum.
s_hats  = (ring nil, nil, {:note => :c4, :amp => 0.4}, nil, nil, nil, {:note => :c4, :amp => 0.5}, nil, 
           nil, nil, {:note => :c4, :amp => 0.4}, nil, nil, nil, {:note => :c4, :amp => 0.5}, nil)

# The "Sidechained" Rolling Bass (A Minor).
# Plays on EVERY 16th step. The 'amp' Hashes dip the volume to 0.3 when 
# the kick hits (steps 0, 4, 8, 12) and spike it to 1.0 in between.
# This simulates sidechain compression purely via data!
s_bass  = (ring {:note => :a1, :amp => 0.3}, {:note => :a1, :amp => 1.0}, {:note => :a1, :amp => 0.3}, {:note => :a1, :amp => 1.0}, 
           {:note => :a1, :amp => 0.3}, {:note => :a1, :amp => 1.0}, {:note => :a1, :amp => 0.3}, {:note => :a1, :amp => 1.0}, 
           {:note => :f1, :amp => 0.3}, {:note => :f1, :amp => 1.0}, {:note => :f1, :amp => 0.3}, {:note => :f1, :amp => 1.0}, 
           {:note => :g1, :amp => 0.3}, {:note => :g1, :amp => 1.0}, {:note => :g1, :amp => 0.3}, {:note => :g1, :amp => 1.0})

# Massive, emotional off-beat supersaw chords (Am to F to G).
# Hit strictly on the off-beats (steps 2, 6, 10, 14) in sync with the hats.
s_chords= (ring nil, nil, {:note => [:a3, :c4, :e4], :cutoff => 110, :release => 1.5, :amp => 0.6}, nil, 
           nil, nil, {:note => [:a3, :c4, :e4], :cutoff => 110, :release => 1.5, :amp => 0.6}, nil, 
           nil, nil, {:note => [:f3, :a3, :c4], :cutoff => 110, :release => 1.5, :amp => 0.6}, nil, 
           nil, nil, {:note => [:g3, :bb3, :d4], :cutoff => 110, :release => 1.5, :amp => 0.6}, nil)

# The "Modular" Pluck Arpeggio (A Minor).
# Uses :play_fm to create a sharp, organic pluck.
# Routed through the engine's tape echo for a cinematic, cascading smear.
s_fm    = (ring :a4, nil, :c5, nil, :e5, nil, :c5, nil, 
           :a4, nil, :c5, nil, :e5, nil, :g4, nil)

# Ethereal, granular vocal pad (using :ambi_choir).
# Long size (0.2) and low density (2) creates a slow, evolving atmospheric texture.
s_grain = (ring {:note => :a3, :buffer => :ambi_choir, :pos => 0.2, :density => 2, :size => 0.2, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil, 
           {:note => :f3, :buffer => :ambi_choir, :pos => 0.5, :density => 2, :size => 0.2, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Hypnosis - Just the kick, sidechained bass, and pad (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Build - Add claps, hats, and the pluck arpeggio (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], 
    [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], [:play_fm, s_fm, 8] ],
    
  # Scene 3: The Anthem - The massive supersaw chords drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], 
    [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], [:play_fm, s_fm, 8], 
    [:play_chords, s_chords, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN TENSION & RELEASE]
# 
# 1. Data-Driven Sidechain: Look at `s_bass`. A real Trance track uses a 
#    sidechain compressor to make the bass "duck" when the kick hits. 
#    Because our engine reads Parameter Hashes, we can simulate this 
#    perfectly by just setting the bass `amp` to `0.3` on steps 0, 4, 8, 
#    and 12 (where the kick hits), and `1.0` on the steps in between. 
#    The engine handles the rest, creating that massive, breathing groove.
#
# 2. The Off-Beat Supersaw: Look at `s_chords`. The chords hit strictly 
#    on the off-beats (steps 2, 6, 10, 14) in sync with the open hats. 
#    By using the `:play_chords` synth with a high `cutoff` (110) and a 
#    long `release` (1.5), the engine turns the normally warm `:blade` 
#    synth into a bright, soaring wall of sound that cuts through the 
#    rolling bass.
#
# 3. Echoing Arpeggios: The `s_fm` sequence plays a simple A minor 
#    arpeggio, but leaves a `nil` between every note. Because the engine 
#    routes the `:play_fm` synth through a tape echo, those empty spaces 
#    are filled by delay tails, creating a massive, cascading soundscape 
#    that feels like looking up at a massive LED screen at a 90s festival.
# ==========================================================
