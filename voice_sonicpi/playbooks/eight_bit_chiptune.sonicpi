# ==========================================================
# PLAYBOOK: 8-BIT CHIPTUNE / NES
# (Pioneered by Koji Kondo, Hirokazu Tanaka, and Yuzo Koshiro)
# ==========================================================
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 8-Bit Chiptune.
# We have explored massive, stadium-sized genres (EDM, Hardstyle) and
# deep, organic grooves (Afro House, Dub). Chiptune takes us back to
# the absolute roots of the 16-step grid: the hardware sound chips of
# the 80s (like the NES Ricoh 2A03 or the Game Boy).
#
# It is rigid, fast, and entirely devoid of acoustic reverb. It relies
# on rapid, 16th-note arpeggios to simulate chords, and piercing, 
# square-wave leads. This playbook perfectly demonstrates how the 
# `:play_fm` synth can be tuned to sound like a classic video game
# sound chip, and how the 16-step grid handles frantic, action-packed
# video game music (like a boss battle).
# ==========================================================

use_bpm 140

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Frantic & Heroic)
# ==========================================================

# Driving, rigid 8-bit kick. Hits on step 0, 6, 8, and 14.
s_kick  = (ring :c4, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, {:note => :c4, :amp => 1.0}, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil)

# Dry, noise-channel snare strictly on beats 2 and 4 (steps 4 and 12).
s_snare = (ring nil, nil, nil, nil, {:note => :c4, :amp => 0.7}, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.7}, nil, nil, nil)

# Rigid, high-pitched 8-bit hi-hats.
s_hats  = (ring nil, nil, {:note => :c4, :amp => 0.3}, nil, nil, nil, {:note => :c4, :amp => 0.3}, nil, nil, nil, {:note => :c4, :amp => 0.3}, nil, nil, nil, {:note => :c4, :amp => 0.3}, nil)

# The 8-Bit Pulse Bass.
# Fast, 16th-note triplets (emulated via grid placement) to create a driving rumble.
s_bass  = (ring :a2, nil, :a2, nil, :a2, nil, :a2, nil, :g2, nil, :g2, nil, :e2, nil, :e2, nil)

# The "Arpeggio" (Simulating a chord on a sound chip).
# Plays rapid 16th notes (A4, E5, C5, E5) to create the illusion of a chord.
# Uses :play_fm with a high divisor to create a hollow, square-wave tone.
s_fm    = (ring {:note => :a4, :amp => 0.5, :divisor => 2, :depth => 1}, {:note => :e5, :amp => 0.4, :divisor => 2, :depth => 1}, {:note => :c5, :amp => 0.5, :divisor => 2, :depth => 1}, {:note => :e5, :amp => 0.4, :divisor => 2, :depth => 1}, 
           {:note => :a4, :amp => 0.5, :divisor => 2, :depth => 1}, {:note => :e5, :amp => 0.4, :divisor => 2, :depth => 1}, {:note => :c5, :amp => 0.5, :divisor => 2, :depth => 1}, {:note => :e5, :amp => 0.4, :divisor => 2, :depth => 1}, 
           {:note => :g4, :amp => 0.5, :divisor => 2, :depth => 1}, {:note => :d5, :amp => 0.4, :divisor => 2, :depth => 1}, {:note => :bb4, :amp => 0.5, :divisor => 2, :depth => 1}, {:note => :d5, :amp => 0.4, :divisor => 2, :depth => 1}, 
           {:note => :e4, :amp => 0.5, :divisor => 2, :depth => 1}, {:note => :b4, :amp => 0.4, :divisor => 2, :depth => 1}, {:note => :g4, :amp => 0.5, :divisor => 2, :depth => 1}, {:note => :b4, :amp => 0.4, :divisor => 2, :depth => 1})

# The piercing, echoing Boss Battle melody (A Harmonic Minor).
s_lead  = (ring nil, nil, nil, nil, {:note => :a5, :amp => 0.7}, nil, {:note => :b5, :amp => 0.6}, nil, {:note => :c6, :amp => 0.8}, nil, nil, nil, {:note => :b5, :amp => 0.6}, nil, {:note => :a5, :amp => 0.7}, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Underworld - Just the driving bass and drums (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Action - Add the rapid arpeggio (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_fm, 8] ],
    
  # Scene 3: The Boss Battle - The piercing lead melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_fm, 8], [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN 8-BIT SEQUENCING]
# 
# 1. The Arpeggio Illusion: Look at `s_fm`. It plays on EVERY SINGLE 16th
#    step, cycling through A4, E5, C5, and E5. Because early sound chips
#    could only play one note at a time per channel, composers used rapid
#    arpeggios to simulate chords. The engine's strict master clock
#    ensures these 16 notes fire with robotic, sound-chip precision.
#
# 2. FM as a Pulse Wave: The `:play_fm` synth is given `divisor: 2` and 
#    `depth: 1` in the Hashes. This narrows the harmonic ratio so much 
#    that the sine waves collapse into a hollow, piercing square wave, 
#    perfectly mimicking the Ricoh 2A03 chip found in the NES.
#
# 3. Rigid, Reverb-less Space: Notice that there are zero granular drones
#    or pads in this playbook. Chiptune relies on absolute clarity and 
#    separation. By leaving the grid sparse and using short, dry releases, 
#    the engine makes the synths sound like they are coming straight out 
#    of a CRT television speaker.
# ==========================================================
