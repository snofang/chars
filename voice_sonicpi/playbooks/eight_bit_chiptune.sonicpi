# ==========================================================
# PLAYBOOK: 8-BIT CHIPTUNE / NES
# Frantic, Heroic, Sound‑Chip Energy
# ==========================================================
# [WHY THIS GENRE?]
# 8‑Bit Chiptune (Koji Kondo, Hirokazu Tanaka) is the sound of
# classic NES and Game Boy sound chips. It uses rapid arpeggios
# to simulate chords, piercing square‑wave leads, and rigid,
# reverb‑less percussion. This playbook captures that action‑
# packed, boss‑battle energy.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 140 BPM
# Key: A minor (frantic, heroic)
# Rhythm: Driving 8‑bit kick on 0,6,8,14; dry snare on 2/4;
# rigid hi‑hats on off‑beats; pulse bass on even 16ths;
# arpeggio on every 16th simulating chords; piercing lead
# melody with sparse stabs.
# Timbre: 8‑bit kick (bd_haus with accents), noise snare
# (sn_dolf), high‑pitched hats (cymbal_closed), pulse bass
# (dsaw), FM arpeggio (divisor 2, depth 1 for square‑wave),
# boss melody (fm with square wave).
# Arrangement: Underworld (bass+drums) → Action (add arpeggio)
# → Boss Battle (add lead melody).
# ==========================================================

use_bpm 140

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Driving, rigid 8‑bit kick – hits on steps 0,6,8,14
s_kick = gen_score("x.....x.x.....x.",
  [:c4,
   {note: :c4, amp: 0.8},
   {note: :c4, amp: 1.0},
   {note: :c4, amp: 0.8}])

# Dry, noise‑channel snare – hits on steps 4 and 12
s_snare = gen_score("....x.......x...",
  [{note: :c4, amp: 0.7}, {note: :c4, amp: 0.7}])

# Rigid high‑pitched hi‑hats – hits on steps 2,6,10,14
s_hats = gen_score("..x...x...x...x.",
  [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.3}, {note: :c4, amp: 0.3}])

# 8‑bit pulse bass – continuous 16ths on even steps (0,2,4,6,8,10,12,14)
s_bass = gen_score("x.x.x.x.x.x.x.x.",
  [:a2, :a2, :a2, :a2, :g2, :g2, :e2, :e2])

# The arpeggio – simulates a chord on a single‑voice sound chip (every 16th)
s_fm = gen_score("xxxxxxxxxxxxxxxx",
  [{note: :a4, amp: 0.5, divisor: 2, depth: 1},
   {note: :e5, amp: 0.4, divisor: 2, depth: 1},
   {note: :c5, amp: 0.5, divisor: 2, depth: 1},
   {note: :e5, amp: 0.4, divisor: 2, depth: 1},
   {note: :a4, amp: 0.5, divisor: 2, depth: 1},
   {note: :e5, amp: 0.4, divisor: 2, depth: 1},
   {note: :c5, amp: 0.5, divisor: 2, depth: 1},
   {note: :e5, amp: 0.4, divisor: 2, depth: 1},
   {note: :g4, amp: 0.5, divisor: 2, depth: 1},
   {note: :d5, amp: 0.4, divisor: 2, depth: 1},
   {note: :bb4, amp: 0.5, divisor: 2, depth: 1},
   {note: :d5, amp: 0.4, divisor: 2, depth: 1},
   {note: :e4, amp: 0.5, divisor: 2, depth: 1},
   {note: :b4, amp: 0.4, divisor: 2, depth: 1},
   {note: :g4, amp: 0.5, divisor: 2, depth: 1},
   {note: :b4, amp: 0.4, divisor: 2, depth: 1}])

# Piercing boss battle melody (A Harmonic Minor) – sparse stabs
s_lead = gen_score("....x.x.x...x.x.",
  [{note: :a5, amp: 0.7},
   {note: :b5, amp: 0.6},
   {note: :c6, amp: 0.8},
   {note: :b5, amp: 0.6},
   {note: :a5, amp: 0.7}])

# Playbook
playbook = (ring
  # Scene 1: The Underworld – Bass + Drums
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4],
    [:play_hats, s_hats, 4], [:play_sub, s_bass, 4] ],

  # Scene 2: The Action – Add Arpeggio
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_fm, s_fm, 8] ],

  # Scene 3: Boss Battle – Add Lead Melody
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_fm, s_fm, 8], [:play_lead, s_lead, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The arpeggio illusion: rapid cycling of A4, E5, C5, E5 on every
#   16th creates a chord – the engine's grid locks it with robotic
#   sound‑chip precision.
# - FM as pulse wave: divisor 2 and depth 1 collapse the sine into
#   a hollow, piercing square wave, mimicking the NES Ricoh 2A03.
# - Rigid, reverb‑less space: short, dry releases and no pads keep
#   the sound crisp and separate, like a CRT TV speaker.
# ==========================================================
