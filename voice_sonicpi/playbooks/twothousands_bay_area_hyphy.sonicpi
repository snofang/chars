# ==========================================================
# PLAYBOOK: 2000s BAY AREA HYPHY / YAY AREA
# (Pioneered by Mac Dre, E‑40, and Keak da Sneak)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# Hyphy fuses syncopated drum patterns with massive sliding
# 808 bass, erratic high‑pitched “zap” leads, and a hypnotic
# party energy. This playbook uses extreme FM parameters for
# a piercing whiny lead, a deep 808 with long release, and a
# syncopated “drunken” groove that defines the Yay Area sound.
# ==========================================================

use_bpm 102

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores

# Syncopated kick: steps 0, 6, 8, 14
s_kick = gen_score("x.....x.x.....x.", [
  :c4,
  {note: :c4, amp: 0.8},
  {note: :c4, amp: 1.0},
  {note: :c4, amp: 0.6}
])

# Snare on beats 2 and 4 (steps 4, 12)
s_snare = gen_score("....x.......x...", [
  {note: :c4, amp: 0.9},
  {note: :c4, amp: 0.9}
])

# Rolling hats with dynamic accents
s_hats = gen_score("x..x..xx.x..x..xx", [
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.5},
  {note: :c4, amp: 0.6}
])

# Deep sliding 808 bass (F# Minor)
s_bass = gen_score("x.......x.......", [
  {note: :fs1, release: 1.0, cutoff: 70, amp: 1.2},
  {note: :a1,  release: 1.0, cutoff: 70, amp: 1.0}
])

# Dark minor chord stabs (F#m → Am)
s_chords = gen_score("x.......x.......", [
  {note: [:fs3, :a3, :c4], cutoff: 80, release: 0.3, amp: 0.5},
  {note: [:a3,  :c4, :e4], cutoff: 80, release: 0.3, amp: 0.5}
])

# Whiny zap lead – extreme upper register, divisor 2, depth 5
s_fm = gen_score("x...x.x..x.x....", [
  {note: :fs6, amp: 0.6, divisor: 2, depth: 5, release: 0.1},
  {note: :a6,  amp: 0.5, divisor: 2, depth: 5, release: 0.1},
  {note: :c7,  amp: 0.6, divisor: 2, depth: 5, release: 0.1},
  {note: :a6,  amp: 0.5, divisor: 2, depth: 5, release: 0.1},
  {note: :fs6, amp: 0.6, divisor: 2, depth: 5, release: 0.1}
])

# Hypnotic “Thizz” vocal drone
s_vocal = gen_score("x.......x.......", [
  {note: :fs3, buffer: :ambi_choir, pos: 0.3, density: 1, size: 0.15, amp: 0.5},
  {note: :a3,  buffer: :ambi_choir, pos: 0.5, density: 1, size: 0.15, amp: 0.5}
])

# Playbook
playbook = (ring
  # Scene 1: The Vibe – 808, chords, and vocal drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Groove – add syncopated drums and rolling hats (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Drop – whiny zap lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The zap lead uses divisor 2 and depth 5 in the extreme
#   upper register (fs6‑c7) to create a piercing, whiny buzz.
# - The 808 bass has a full‑beat release (1.0) and low cutoff,
#   giving it massive weight and a natural decay.
# - The kick syncopation (steps 0,6,8,14) creates a lopsided,
#   “drunken” groove that locks with the sliding bass and lead.
# ==========================================================
