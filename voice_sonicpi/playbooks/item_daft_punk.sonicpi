# ==========================================================
# PLAYBOOK: DAFT PUNK - "GET LUCKY" (2010s)
# ==========================================================

use_bpm 116

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (B Dorian - Funky, Clean, & Groovy)
# ==========================================================

# Relentless, driving 4/4 disco kick. (4 x's, 1 element)
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, organic disco clap strictly on beats 2 and 4. (2 x's, 1 element)
s_clap = gen_score("....x.......x...", [:c4])

# Swung, bouncing 16th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Disco Bass" (B Dorian).
# Plays a syncopated, melodic line. High cutoff (90) and short release (0.15) 
# create a warm, punchy "thwack". (8 x's, 8 elements)
s_bass = gen_score("x..x..x..x..x..x.", [
  {note: :b1, release: 0.15, cutoff: 90, amp: 1.0}, 
  {note: :b1, release: 0.15, cutoff: 90, amp: 0.8}, 
  {note: :d2, release: 0.15, cutoff: 90, amp: 1.0}, 
  {note: :b1, release: 0.15, cutoff: 90, amp: 0.8}, 
  {note: :e2, release: 0.15, cutoff: 90, amp: 1.0}, 
  {note: :b1, release: 0.15, cutoff: 90, amp: 0.8}, 
  {note: :fs2, release: 0.15, cutoff: 90, amp: 1.0}, 
  {note: :b1, release: 0.15, cutoff: 90, amp: 0.8}
])

# Clean, "Rhythm Guitar" Chops (Bm7 to Dmaj7).
# Uses :play_pluck. Hits strictly on the off-beats to mimic funky strumming. 
# (4 x's, 4 elements)
s_guitar = gen_score("..x...x...x...x.", [
  {note: [:b3, :fs4, :a4], amp: 0.6, release: 0.08, coef: 0.4}, 
  {note: [:b3, :fs4, :a4], amp: 0.6, release: 0.08, coef: 0.4}, 
  {note: [:d3, :a3, :cs4], amp: 0.6, release: 0.08, coef: 0.4}, 
  {note: [:d3, :a3, :cs4], amp: 0.6, release: 0.08, coef: 0.4}
])

# Lush, "Synth Pad" Chords (Bm7 to Dmaj7).
# Hit on the downbeats. The slow 1.0-beat attack and massive 4.0-beat release 
# blur the chords together into a continuous, cinematic wave. (2 x's, 2 elements)
s_chords = gen_score("x.......x.......", [
  {note: [:b3, :d4, :fs4, :a4], cutoff: 70, attack: 1.0, release: 4.0, amp: 0.4},
  {note: [:d3, :fs3, :a3, :cs4], cutoff: 70, attack: 1.0, release: 4.0, amp: 0.4}
])

# Piercing, "Synth Brass" Lead (B Dorian).
# Uses :play_fm with a low divisor (2) and mid depth (3) to create a warm, 
# brassy tone. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:b5, :d6, :fs6, :e6, :d6, :b5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 3, release: 0.3} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Ahh" Vocal Drone (Granular Synth).
# Using the built-in :ambi_choir sample.
# Long size (0.4) and low density (1) creates a slow, evolving background texture. (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :b3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.4, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the disco bass, rhythm guitar, and synth pad (4 bars)
  [ [:play_sub, s_bass, 4], [:play_pluck, s_guitar, 4], [:play_chords, s_chords, 4], 
    [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Verse - Add the driving 4/4 disco drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_pluck, s_guitar, 8], [:play_chords, s_chords, 8], 
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], 
    [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chorus - The piercing synth brass melody drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_pluck, s_guitar, 8], [:play_chords, s_chords, 8], 
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], 
    [:play_hats, s_hats, 8], [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
