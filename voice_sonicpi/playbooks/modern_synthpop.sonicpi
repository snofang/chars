# ==========================================================
# PLAYBOOK: MODERN SYNTHPOP / ELECTROPOP
# (Pioneered by The Weeknd, Dua Lipa, and Robyn)
# ==========================================================
# [WHY THIS GENRE?]
# Modern Synthpop drives with continuous 16th‑note bass, wide
# supersaw chords on off‑beats, and pristine vocal stutters.
# This playbook creates a relentless, festival‑ready momentum
# using octave‑jumping bass and echo‑laden arpeggios.
# [DNA: 118 BPM, F# minor, 4/4 kick, off‑beat hats & chords,
#  rolling bass, FM arpeggio, granular vocal chops]
# ==========================================================

use_bpm 118

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# ----------------------------------------------------------
# SCORES – Normalized with gen_score – behavior identical to original
# ----------------------------------------------------------

# Driving 4/4 kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy clap on beats 2 and 4
s_clap = gen_score("....x.......x...", [:c4])

# Off‑beat open hats – steps 2,6,10,14 with varying amplitude
s_hats = gen_score("..x...x...x...x.",
  [{note: :c4, amp: 0.4}, {note: :c4, amp: 0.5},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}])

# Continuous 16th‑note bass – alternating octaves, high cutoff
bass_notes = [:fs2, :fs2, :fs3, :fs2,
              :fs2, :fs2, :a2,  :a2,
              :a2,  :a2,  :a3,  :a2,
              :e2,  :e2,  :d2,  :c2]
s_bass = gen_score("xxxxxxxxxxxxxxxx",
  bass_notes.map { |n| {note: n, cutoff: 90, release: 0.1} })

# Wide supersaw chords – off‑beats (steps 2,6,10,14)
s_chords = gen_score("..x...x...x...x.",
  [[:fs3, :a3, :c4], [:fs3, :a3, :c4],
   [:a3,  :c4, :e4], [:d3,  :f3, :a3]])

# Bright FM arpeggio – every 16th, with rest between each note
s_fm = gen_score("x.x.x.x.x.x.x.x.",
  [{note: :fs5, amp: 0.6, divisor: 3, depth: 2, release: 0.2},
   {note: :c5,  amp: 0.5, divisor: 3, depth: 2, release: 0.2},
   {note: :e5,  amp: 0.6, divisor: 3, depth: 2, release: 0.2},
   {note: :fs5, amp: 0.7, divisor: 3, depth: 2, release: 0.2},
   {note: :a5,  amp: 0.5, divisor: 3, depth: 2, release: 0.2},
   {note: :e5,  amp: 0.6, divisor: 3, depth: 2, release: 0.2},
   {note: :d5,  amp: 0.5, divisor: 3, depth: 2, release: 0.2},
   {note: :c5,  amp: 0.6, divisor: 3, depth: 2, release: 0.2}])

# Pop vocal stutter – triggers on steps 8 and 14
s_vocal = gen_score("........x.....x.",
  [{note: :fs4, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.04, amp: 0.6},
   {note: :a4,  buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.04, amp: 0.6}])

# ----------------------------------------------------------
# PLAYBOOK – In‑line and readable
# ----------------------------------------------------------
playbook = (ring
  # Scene 1 – The Drive: kick, hats, and rolling bass (4 bars)
  [ [:play_kick, s_kick, 4],
    [:play_hats, s_hats, 4],
    [:play_sub, s_bass, 4] ],

  # Scene 2 – The Vibe: add claps and supersaw chords (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8],
    [:play_snare, s_clap, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3 – The Drop: arpeggio and vocal chops enter (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8],
    [:play_snare, s_clap, 8],
    [:play_chords, s_chords, 8],
    [:play_lead, s_fm, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# 1. Relentless 16th Roll – the bass fires on every step,
#    alternating octaves to create a continuous, driving pulse.
# 2. Off‑Beat Pocket – chords and hats hit on steps 2,6,10,14,
#    locking together for a bouncing “boom‑cha” groove.
# 3. Cascading FM Echoes – the arpeggio leaves rests between
#    notes; the tape echo fills the gaps with shimmering tails.
# ==========================================================
