# ==========================================================
# PLAYBOOK: 2020s STUTTER HOUSE / UK GARAGE REVIVAL
# Chopped Vocal Melodies, Swung 2‑Step, Nostalgic Chords
# ==========================================================
# [WHY THIS GENRE?]
# Stutter House (Fred again.., PinkPantheress) fuses the
# bouncy 130 BPM 2‑step drum grid with massive, emotional
# chopped vocal stutters and lush, nostalgic major chords.
# This playbook captures that viral, contemporary, deeply
# emotional internet‑era sound.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 130 BPM
# Key: Eb Major (nostalgic, warm, emotional)
# Rhythm: Swung 2‑step kick (1, 'a' of 2, beat 3), snare on
# beat 2 with ghost on 'a' of 4, syncopated hats, sparse bass
# and chords, chopped granular vocals as main melody.
# Timbre: Punchy kick (bd_haus with accents), tight metallic
# snare (sn_dolf), bouncing hats (cymbal_closed), warm Reese
# bass (dsaw, low cutoff, long release), lush major 9th chords
# (blade, long attack/release), vocal granular stutters
# (ambi_choir, high density, tiny size), music box FM
# (divisor 3, depth 1, tape echo).
# Arrangement: Memory (chords+bass+vocal) → Groove (add drums+
# music box).
# ==========================================================

use_bpm 130

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Swung 2‑step kick – hits on 1, 'a' of 2, and beat 3
s_kick = gen_score("x......xx......",
  [:c4, {note: :c4, amp: 0.7}, {note: :c4, amp: 0.9}])

# Tight snare on beat 2 with ghost on 'a' of 4
s_snare = gen_score("....x........x.",
  [{note: :c4, amp: 0.9}, {note: :c4, amp: 0.3}])

# Bouncing syncopated 16th hats
s_hats = gen_score("x.x.x.x.x.x.x.x.",
  [{note: :c4, amp: 0.2}, {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2}])

# Deep warm Reese bass – low cutoff, long release
s_bass = gen_score("x.......x.......",
  [{note: :eb1, release: 1.5, cutoff: 60},
   {note: :ab1, release: 1.5, cutoff: 60}])

# Lush nostalgic major 9th chords – slow attack for swelling
s_chords = gen_score("x.......x.......",
  [{note: [:eb3, :g3, :bb3, :d4], cutoff: 90, attack: 0.5, release: 2.0, amp: 0.6},
   {note: [:ab2, :c3, :eb3, :g3], cutoff: 90, attack: 0.5, release: 2.0, amp: 0.6}])

# Chopped vocal melody – granular as main hook (6 triggers)
s_vocal = gen_score("x.x.x...x.x.x...",
  [{note: :eb4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.7},
   {note: :bb4, buffer: :ambi_choir, pos: 0.3, density: 3, size: 0.04, amp: 0.7},
   {note: :eb5, buffer: :ambi_choir, pos: 0.5, density: 3, size: 0.04, amp: 0.7},
   {note: :g4, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.04, amp: 0.7},
   {note: :ab4, buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.04, amp: 0.7},
   {note: :c5, buffer: :ambi_choir, pos: 0.6, density: 3, size: 0.04, amp: 0.7}])

# Music box counter‑melody – routed through tape echo
s_fm = gen_score("...x.....x....x.",
  [{note: :eb5, amp: 0.5, divisor: 3, depth: 1, release: 0.5},
   {note: :c5, amp: 0.4, divisor: 3, depth: 1, release: 0.5},
   {note: :bb4, amp: 0.5, divisor: 3, depth: 1, release: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Memory – Chords, Bass, Vocal Chops
  [ [:play_chords, s_chords, 4], [:play_sub, s_bass, 4],
    [:play_grain, s_vocal, 4] ],

  # Scene 2: Groove – Add Drums and Music Box
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_vocal, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_fm, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Granular as lead: pitched‑up vocal stutters (size 0.04,
#   density 3) become the main melodic hook – the signature
#   "Fred again.." chopped vocal style.
# - Swung 2‑step: kick on step 0, 7, and 8 creates a lopsided,
#   "drunken" groove that feels human and nostalgic.
# - Swelling emotion: attack 0.5 and release 2.0 on chords
#   creates a blurred, nostalgic wave that anchors the
#   frantic vocal chops.
# ==========================================================
