# ==========================================================
# PLAYBOOK: 90s NEW ORLEANS BOUNCE
# (Pioneered by DJ Jimi, Magnolia Shorty, and Katey Red)
# ==========================================================
# 
# [WHY THIS GENRE?]
# New Orleans Bounce is the origin of deep Southern hip‑hop,
# featuring the syncopated “Triggerman” beat, booming 808 bass,
# call‑and‑response vocal chants, and relentless party energy.
# This playbook uses interlocking kicks, pitched vocal grains,
# and a bright synth whistle to recreate a raw NOLA block party.
# ==========================================================

use_bpm 100

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x.x...x.x..x....", [
  :c4,
  :c4,
  {note: :c4, amp: 0.8},
  {note: :c4, amp: 1.0},
  {note: :c4, amp: 0.7}
])

s_snare = gen_score("....x.......x.x.", [
  {note: :c4, amp: 0.9},
  {note: :c4, amp: 0.9},
  {note: :c4, amp: 0.3}
])

s_hats  = gen_score("x.xxx.xxx.xxx.xx", [
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.4}
])

s_bass  = gen_score("x.....x.x...x...", [
  {note: :fs1, release: 0.5, cutoff: 70, amp: 1.2},
  {note: :fs1, release: 0.5, cutoff: 70, amp: 1.0},
  {note: :a1,  release: 0.5, cutoff: 70, amp: 1.2},
  {note: :a1,  release: 0.5, cutoff: 70, amp: 1.0}
])

s_chords = gen_score("....x.......x...", [
  [:fs3, :a3, :c4],
  [:a3,  :c4, :e4]
])

s_fm    = gen_score("x...x.x.x...x...", [
  {note: :fs5, amp: 0.6, divisor: 3, depth: 2, release: 0.2},
  {note: :a5,  amp: 0.5, divisor: 3, depth: 2, release: 0.2},
  {note: :c6,  amp: 0.6, divisor: 3, depth: 2, release: 0.2},
  {note: :fs5, amp: 0.5, divisor: 3, depth: 2, release: 0.2},
  {note: :e5,  amp: 0.6, divisor: 3, depth: 2, release: 0.2}
])

s_vocal = gen_score("....x.....x...x.", [
  {note: :fs4, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.04, amp: 0.6},
  {note: :a4,  buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.04, amp: 0.6},
  {note: :fs4, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.04, amp: 0.6}
])

# Playbook
playbook = (ring
  # Scene 1: The Block – syncopated drums and booming 808 (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4],
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Party – add brass stabs and vocal chants (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drop – whistling synth melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The “Triggerman” kick syncopation (steps 0,2,6,8,11) creates
#   a relentless, lopsided groove that defines NOLA Bounce.
# - The 808 bass uses release 0.5 and cutoff 70 to boom and ring
#   out, providing massive weight against the fast drums.
# - Granulated vocal chants (density 3, size 0.04) are scattered
#   on off‑beats to mimic call‑and‑response party energy.
# ==========================================================
