# ==========================================================
# PLAYBOOK: 80s SPACESYNTH / SPACEDISCO
# (Pioneered by Koto, Laserdance, and Hipnosis)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 80s Spacesynth.
# We have explored Synthwave and Italo Disco, but Spacesynth is the sound 
# of pure, futuristic 80s sci-fi. It relies on a relentless, driving 4/4 
# beat, a continuous, octave-jumping 16th-note "galloping" bass, massive, 
# sweeping synth pads, and rapid, piercing 16th-note arpeggios that feel 
# like flying a starship through a neon galaxy.
#
# This playbook perfectly demonstrates how to use the `gen_score` helper 
# and Ruby's `.map` function to algorithmically generate a continuous, 
# octave-jumping 16th-note bassline and a rapid, 16th-note arpeggio with 
# zero repetitive code.
# ==========================================================

use_bpm 125

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Futuristic, Driving, & Sci-Fi)
# ==========================================================

# Relentless, driving 4/4 kick.
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, dry snare strictly on beats 2 and 4.
s_snare = gen_score("....x.......x...", [:c4])

# Off-beat open hats to drive the momentum.
s_hats = gen_score("..x...x...x...x.", [{note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}])

# The "Gallop" Bass (A Minor).
# Generate 16 continuous 16th notes with alternating octaves automatically.
bass_cycle = [:a1, :a2, :a1, :a2, :a1, :a2, :a1, :a2, 
              :f1, :f2, :f1, :f2, :g1, :g2, :g1, :g2]
bass_data = bass_cycle.map { |n| {note: n, cutoff: 100, release: 0.08, amp: 1.0} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Lush, "String Synth" Chords (Am to F to G).
# Hit on the downbeats. The slow 0.5-beat attack and massive 3.0-beat release 
# blur the chords together into a continuous, cinematic wave.
s_chords = gen_score("x.......x.......", [
  {note: [:a3, :c4, :e4], cutoff: 80, attack: 0.5, release: 3.0, amp: 0.5},
  {note: [:g3, :bb3, :d4], cutoff: 80, attack: 0.5, release: 3.0, amp: 0.5}
])

# Piercing, "Starship" Arpeggio (A Minor).
# Uses :play_fm with a low divisor (2) and extreme depth (4) to create a 
# sharp, buzzy square wave. Plays a rapid, continuous 16th-note melody.
lead_notes = [:a5, :e5, :c6, :e5, :a5, :e5, :c6, :e5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 4, release: 0.08} }
s_lead = gen_score("x.x.x.x.x.x.x.x.", lead_data)

# Pitched-up, "Computer" vocal stutter (Granular Synth).
# High density, tiny size = a sharp, robotic vocal skip.
s_vocal = gen_score("....x.......x...", [
  {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.6},
  {note: :c5, buffer: :ambi_choir, pos: 0.3, density: 3, size: 0.04, amp: 0.6}
])

# Ethereal, "Cosmos" drone (Granular Synth).
# Long size (0.4) and low density (1) creates a slow, evolving background 
# texture that drifts behind the relentless beat like a nebula.
s_grain = gen_score("x...............", [
  {note: :a4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.4, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Orbit - Just the gallop bass, sweeping chords, and cosmos drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Flight - Add the driving 4/4 drums and vocal stutters (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_grain, s_vocal, 8] ],
    
  # Scene 3: Hyperspace - The piercing starship arpeggio drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_grain, s_vocal, 8], [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN SCI-FI MOMENTUM]
# 
# 1. The Gallop Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step, alternating between the low octave (:a1) and the 
#    high octave (:a2). By using a high `cutoff` (100) and a microscopic 
#    `release` (0.08), the engine turns the detuned sawtooth into a relentless, 
#    driving "gallop" that perfectly mimics the fast, sequenced basslines of 
#    80s Spacesynth.
#
# 2. FM as a Starship: The `s_lead` sequence uses `divisor: 2` and an extreme 
#    `depth` of `4`. This harsh harmonic ratio produces a piercing, buzzy 
#    square wave. By playing a rapid, continuous 16th-note arpeggio, the 
#    engine creates a frantic, high-energy hook that cuts through the heavy 
#    bass and drums, perfectly mimicking the sci-fi synth leads of Koto and 
#    Laserdance.
#
# 3. The Cinematic Swell: Look at `s_chords`. The Hashes specify an `attack` 
#    of `0.5` and a `release` of `3.0`. Because the engine reads these 
#    Hashes, the chords don't just hit; they slowly swell into the mix and 
#    fade away over three whole beats, creating a continuous, blurred wave 
#    of warm harmony that perfectly anchors the track's futuristic atmosphere.
# ==========================================================
