# ==========================================================
# PLAYBOOK: BEE GEES - "STAYIN' ALIVE" (1977)
# ==========================================================

use_bpm 104

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Minor - Funky, Driving, & Falsetto)
# ==========================================================

# Relentless, driving 4/4 disco kick. (4 x's, 1 element)
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, organic disco snare strictly on beats 2 and 4. (2 x's, 1 element)
s_snare = gen_score("....x.......x...", [:c4])

# Continuous, driving 16th hats with alternating amplitudes for the disco bounce. 
# (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Walking" Disco Bass (F# Minor).
# Plays a driving, descending/ascending line. 
# High cutoff (90) and short release (0.15) create a warm, punchy "thwack".
# (8 x's, 8 elements)
bass_notes = [:fs1, :fs1, :e1, :e1, :d1, :d1, :cs1, :cs1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 90, release: 0.15, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# The "Chicken-Scratch" Guitar Chops (F#m).
# Uses :play_pluck. Hits strictly on the off-beats to mimic funky, 16th-note strumming. 
# (4 x's, 4 elements)
s_guitar = gen_score("..x...x...x...x.", [
  {note: [:fs3, :a3, :cs4], amp: 0.6, release: 0.08, coef: 0.3}, 
  {note: [:fs3, :a3, :cs4], amp: 0.6, release: 0.08, coef: 0.3}, 
  {note: [:fs3, :a3, :cs4], amp: 0.6, release: 0.08, coef: 0.3}, 
  {note: [:fs3, :a3, :cs4], amp: 0.6, release: 0.08, coef: 0.3}
])

# Stark, "String Section" Stabs (F#m to D to C#).
# Uses :play_fm with a low divisor (2) and mid depth (4) to create a warm, 
# brassy, staccato hit. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:fs3, :a3, :cs4], divisor: 2, depth: 4, release: 0.15, amp: 0.5},
  {note: [:d3, :fs3, :a3], divisor: 2, depth: 4, release: 0.15, amp: 0.5},
  {note: [:cs3, :e3, :g3], divisor: 2, depth: 4, release: 0.15, amp: 0.5},
  {note: [:d3, :fs3, :a3], divisor: 2, depth: 4, release: 0.15, amp: 0.5}
])

# Piercing, "Falsetto" Synth Lead (F# Minor).
# Uses :play_fm with a high divisor (3) and low depth (2) to create a pristine, 
# glassy, soaring tone that mimics the iconic Bee Gees falsetto. 
# Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:fs5, :a5, :c6, :b5, :a5, :fs5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, divisor: 3, depth: 2, release: 0.3} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Ah, ha, ha, ha" Vocal Stutter (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched UP.
# High density, tiny size = a sharp, sugary, disco-pop vocal skip. (2 x's, 2 elements)
s_vocal = gen_score("....x.......x...", [
  {note: :fs4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.7},
  {note: :a4, buffer: :ambi_choir, pos: 0.3, density: 3, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the walking bass, chicken-scratch guitar, and string stabs (4 bars)
  [ [:play_sub, s_bass, 4], [:play_pluck, s_guitar, 4], [:play_fm, s_chords, 4] ],
  
  # Scene 2: The Verse - Add the relentless 4/4 disco drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_pluck, s_guitar, 8], [:play_fm, s_chords, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chorus - The piercing falsetto lead and vocal chops drop (8 bars)
  [ [:play_sub, s_bass, 8], [:play_pluck, s_guitar, 8], [:play_fm, s_chords, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN DISCO POP]
# 
# 1. The Walking Bass: Look at `s_bass`. The `:play_sub` synth plays a driving, 
#    descending line (F#-E-D-C#) on continuous 8th notes. By using a high `cutoff` 
#    (90) and a short `release` (0.15), the engine turns the detuned sawtooth into 
#    a warm, punchy "thwack" that perfectly mimics the iconic, walking disco bassline.
#
# 2. The Chicken-Scratch Guitar: Look at `s_guitar`. The `:play_pluck` synth hits 
#    strictly on the off-beats (steps 2, 6, 10, 14). By using a microscopic `release` 
#    (0.08) and a very low `coef` (0.3), the engine turns the pluck into a sharp, 
#    percussive "chuka" that perfectly mimics the funky, 16th-note rhythm guitar 
#    that defines the groove.
#
# 3. The Falsetto Lead: The `s_lead` sequence uses `divisor: 3` and `depth: 2`. 
#    This gentle harmonic ratio produces a pristine, glassy, sine-like wave. 
#    Because it's routed through the global tape echo bus, the sparse notes smear 
#    into a soaring, cascading melody that perfectly mimics the legendary Bee Gees 
#    falsetto harmonies.
# ==========================================================
