# ==========================================================
# PLAYBOOK: 80s NEW BEAT / BELGIAN DANCE
# (Pioneered by A Split-Second, Lords of Acid, and Confetti's)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 80s New Beat.
# We have explored EBM (which is aggressive) and Italo Disco (which 
# is fast). New Beat is a strange, historical anomaly that originated 
# in Belgium in 1987. It was created when DJs accidentally played 
# EBM records at 33 RPM instead of 45. The result is a slow (105 BPM), 
# heavy, hypnotic, and slightly sleazy groove that bridges the gap 
# between Industrial and House music.
#
# This playbook perfectly demonstrates how to use the `play_noise` 
# instrument for slow, hypnotic filter sweeps, and the `play_subbass` 
# for massive, clean low-end. By combining a relentless 16th-note 
# pulse with dark, stark chords, the engine creates a slow, grinding 
# dancefloor atmosphere.
# ==========================================================

use_bpm 105

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Slow, Heavy, & Hypnotic)
# ==========================================================

# Relentless, heavy 4/4 kick.
s_kick  = (ring :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil)

# Heavy, dry industrial snare strictly on beats 2 and 4 (steps 4 and 12).
s_snare = (ring nil, nil, nil, nil, :c4, nil, nil, nil, nil, nil, nil, nil, :c4, nil, nil, nil)

# Rigid, off-beat open hats to drive the momentum.
s_hats  = (ring nil, nil, {:note => :c4, :amp => 0.4}, nil, nil, nil, {:note => :c4, :amp => 0.3}, nil, nil, nil, {:note => :c4, :amp => 0.4}, nil, nil, nil, {:note => :c4, :amp => 0.3}, nil)

# The "New Beat" Pulse Bass (A Minor).
# Plays continuous 16th notes, alternating octaves (:a1, :a2). 
# High cutoff (100) and short release (0.1) create a relentless, buzzing churn.
s_bass  = (ring {:note => :a1, :cutoff => 100, :release => 0.1}, {:note => :a2, :cutoff => 100, :release => 0.1}, {:note => :a1, :cutoff => 100, :release => 0.1}, {:note => :a2, :cutoff => 100, :release => 0.1}, 
           {:note => :a1, :cutoff => 100, :release => 0.1}, {:note => :a2, :cutoff => 100, :release => 0.1}, {:note => :f1, :cutoff => 100, :release => 0.1}, {:note => :f2, :cutoff => 100, :release => 0.1}, 
           {:note => :a1, :cutoff => 100, :release => 0.1}, {:note => :a2, :cutoff => 100, :release => 0.1}, {:note => :a1, :cutoff => 100, :release => 0.1}, {:note => :a2, :cutoff => 100, :release => 0.1}, 
           {:note => :e1, :cutoff => 100, :release => 0.1}, {:note => :e2, :cutoff => 100, :release => 0.1}, {:note => :e1, :cutoff => 100, :release => 0.1}, {:note => :e2, :cutoff => 100, :release => 0.1})

# Massive, clean sub-bass (A Minor).
# Uses play_subbass. Hits strictly on the off-beats to provide a massive, 
# distortion-free low-end thump that anchors the buzzing pulse.
s_sub   = (ring nil, nil, {:note => :a1, :release => 0.15, :amp => 1.0}, nil, nil, nil, {:note => :a1, :release => 0.15, :amp => 1.0}, nil, nil, nil, {:note => :f1, :release => 0.15, :amp => 1.0}, nil, nil, nil, {:note => :e1, :release => 0.15, :amp => 1.0}, nil)

# The "Hypnotic Riser" Sweep.
# Uses play_noise. The notes slowly ascend and descend over the 16 steps, 
# forcing the filter cutoff to open and close, creating a slow, hydraulic sweep.
s_noise = (ring {:note => :a3, :amp => 0.2, :release => 0.1}, {:note => :b3, :amp => 0.3, :release => 0.1}, {:note => :c4, :amp => 0.4, :release => 0.1}, {:note => :d4, :amp => 0.5, :release => 0.1}, 
           {:note => :e4, :amp => 0.6, :release => 0.1}, {:note => :f4, :amp => 0.7, :release => 0.1}, {:note => :g4, :amp => 0.8, :release => 0.1}, {:note => :a4, :amp => 0.9, :release => 0.1}, 
           {:note => :g4, :amp => 0.8, :release => 0.1}, {:note => :f4, :amp => 0.7, :release => 0.1}, {:note => :e4, :amp => 0.6, :release => 0.1}, {:note => :d4, :amp => 0.5, :release => 0.1}, 
           {:note => :c4, :amp => 0.4, :release => 0.1}, {:note => :b3, :amp => 0.3, :release => 0.1}, {:note => :a3, :amp => 0.2, :release => 0.1}, nil)

# Stark, dark minor chord stabs (Am to F to E).
# Hit sparingly on the off-beats to leave maximum room for the pulse bass.
s_chords= (ring nil, nil, [:a3, :c4, :e4], nil, nil, nil, [:a3, :c4, :e4], nil, nil, nil, [:f3, :a3, :c4], nil, nil, nil, [:e3, :g3, :b3], nil)

# Piercing, robotic FM Lead (A Minor Pentatonic).
# Uses :play_fm with a low divisor (2) and depth (4) to create a sharp, 
# buzzy square wave that cuts through the heavy mix.
s_fm    = (ring nil, nil, nil, nil, {:note => :a4, :amp => 0.6, :divisor => 2, :depth => 4, :release => 0.1}, nil, nil, nil, nil, nil, nil, nil, {:note => :e4, :amp => 0.5, :divisor => 2, :depth => 4, :release => 0.1}, nil, nil, nil)

# Ethereal, dark vocal drone (Granular Synth).
# Long size (0.2) and low density (1) creates a slow, evolving background 
# texture that sounds like a distant voice in a cavernous club.
s_grain = (ring {:note => :a3, :buffer => :misc_lori, :pos => 0.3, :density => 1, :size => 0.2, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil, {:note => :e3, :buffer => :misc_lori, :pos => 0.5, :density => 1, :size => 0.2, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Grind - Just the kick, pulse bass, and hypnotic sweep (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_noise, s_noise, 4] ],
  
  # Scene 2: The Club - Add the heavy sub, snares, and stark chords (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_noise, s_noise, 8], 
    [:play_subbass, s_sub, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Drop - The robotic FM lead and vocal drone drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_noise, s_noise, 8], 
    [:play_subbass, s_sub, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_chords, s_chords, 8], [:play_lead, s_fm, 8], [:play_grain, s_grain, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN SLOW HYPNOSIS]
# 
# 1. The 33 RPM Illusion: Look at `s_bass` and `s_fm`. The bassline plays 
#    continuous 16th notes at 105 BPM, but the FM lead plays sparse, low-
#    pitched notes. This creates the psychological illusion that the track 
#    is playing at 33 RPM instead of 45 RPM, which is the absolute genetic 
#    code of the Belgian New Beat genre.
#
# 2. Data-Driven Sweeps: Look at `s_noise`. By passing ascending and 
#    descending notes (:a3 to :a4 and back) to the `play_noise` instrument, 
#    the engine forces the filter cutoff to open and close slowly over the 
#    16 steps. This creates a slow, hydraulic riser purely via data, 
#    perfectly mimicking the dark, industrial atmosphere of 80s Belgian 
#    dance clubs.
#
# 3. Clean Low-End Separation: New Beat relies on a massive, clean low-end. 
#    By using `play_sub` for the buzzing, high-frequency pulse and 
#    `play_subbass` for the off-beat thump, the engine separates the 
#    harmonics. This provides immense weight without muddying the mix, 
#    keeping the slow groove punchy and hypnotic.
# ==========================================================
