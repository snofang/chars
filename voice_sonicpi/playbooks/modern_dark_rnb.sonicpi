# ==========================================================
# PLAYBOOK: MODERN DARK R&B / PBR&B
# (Pioneered by The Weeknd, FKA Twigs, and Kelela)
# ==========================================================
# [WHY THIS GENRE?]
# PBR&B strips away swing and fills the slow 16‑step grid with
# echoing 808s, dark minor 9th chords, and cavernous vocal chops.
# This playbook uses long releases, slow attacks, and sparse
# granular textures to create a suffocating, cathedral‑like atmosphere.
# [DNA: 70 BPM, C# minor, massive 808 weight, swelling ghost chords,
#  cavernous granular drone, distant FM sine lead]
# ==========================================================

use_bpm 70

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# ----------------------------------------------------------
# SCORES – Normalized with gen_score
# ----------------------------------------------------------

# Slow, heavy kick – hits on steps 0, 6, 8
s_kick = gen_score("x.....x.x.......",
  [{note: :c4, amp: 1.2},
   {note: :c4, amp: 0.8},
   {note: :c4, amp: 1.0}])

# Crisp snare on beats 2 and 4 (steps 4, 12)
s_snare = gen_score("....x.......x...",
  [{note: :c4, amp: 0.8},
   {note: :c4, amp: 0.8}])

# Sparse hi‑hats – hits on steps 0, 6, 8, 14
s_hats = gen_score("x.....x.x.....x.",
  [{note: :c4, amp: 0.2},
   {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.3}])

# Massive echoing 808 bass – long release (2.0) for weight
s_bass = gen_score("x.......x.......",
  [{note: :cs1, release: 2.0, cutoff: 80},
   {note: :a1,  release: 2.0, cutoff: 80}])

# Dark minor 9th chords with slow attack and long release
s_chords = gen_score("x.......x.......",
  [{note: [:cs3, :e3, :gs3, :b3], cutoff: 90, attack: 0.5, release: 3.0, amp: 0.6},
   {note: [:a2,  :cs3, :e3, :gs3], cutoff: 90, attack: 0.5, release: 3.0, amp: 0.6}])

# Distant sine‑like FM melody – high divisor (3), low depth (1)
s_fm = gen_score("....x.......x...",
  [{note: :gs5, amp: 0.5, divisor: 3, depth: 1, release: 1.0},
   {note: :e5,  amp: 0.4, divisor: 3, depth: 1, release: 1.0}])

# Cavernous vocal drone – pitched down, sparse long grains
s_grain = gen_score("x.......x.......",
  [{note: :cs3, buffer: :ambi_choir, pos: 0.4, density: 1, size: 0.2, amp: 0.6},
   {note: :a3,  buffer: :ambi_choir, pos: 0.6, density: 1, size: 0.2, amp: 0.6}])

# ----------------------------------------------------------
# PLAYBOOK
# ----------------------------------------------------------
playbook = (ring
  # Scene 1 – The Void: bass, swelling chords, vocal drone (4 bars)
  [ [:play_chords, s_chords, 4],
    [:play_sub, s_bass, 4],
    [:play_grain, s_grain, 4] ],

  # Scene 2 – The Pulse: add slow, heavy drums (8 bars)
  [ [:play_chords, s_chords, 8],
    [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8],
    [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8] ],

  # Scene 3 – The Echo: distant synth melody enters (8 bars)
  [ [:play_chords, s_chords, 8],
    [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8],
    [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# 1. 808 Weight – a release of 2.0 at 70 BPM makes the sub‑bass
#    ring out for almost two seconds, creating massive low‑end.
# 2. Swelling Ghosts – attack 0.5 and release 3.0 on chords let
#    them slowly bloom and decay into a continuous dark harmony.
# 3. Cavernous Granular – density 1 and size 0.2 with a pitched‑
#    down vocal time‑stretch the sample into a haunting, formless
#    drone, reminiscent of The Weeknd and FKA Twigs.
# ==========================================================
