use_bpm 140

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (E Phrygian - Alien & Hypnotic)
# ==========================================================

# Relentless 4-on-the-floor
s_kick  = (ring :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil)

# Open hats strictly on the off-beats (steps 2, 6, 10, 14)
s_hats  = (ring nil, nil, {:note => :c4, :amp => 0.4}, nil, nil, nil, {:note => :c4, :amp => 0.5}, nil, 
           nil, nil, {:note => :c4, :amp => 0.4}, nil, nil, nil, {:note => :c4, :amp => 0.5}, nil)

# The classic Psytrance "Rolling Bass". 
# Plays on every 16th note, but alternates octaves to create a bouncing pulse.
s_bass  = (ring :e2, :e2, :e3, :e2, :e2, :e2, :e3, :e2, 
           :e2, :e2, :e3, :e2, :f2, :f2, :f3, :f2)

# Erratic, squelchy FM lead (E Phrygian)
# Uses Hashes to dynamically change the FM depth, creating a "talking" synth.
s_fm    = (ring nil, nil, {:note => :e5, :amp => 0.7, :depth => 3}, nil, 
           nil, {:note => :f5, :amp => 0.5, :depth => 1}, nil, {:note => :g5, :amp => 0.8, :depth => 4}, 
           nil, {:note => :e5, :amp => 0.6, :depth => 2}, nil, nil, 
           nil, {:note => :b4, :amp => 0.7, :depth => 3}, nil, nil)

# Drifting, cosmic granular pad (using :ambi_choir)
s_grain = (ring {:note => :e3, :buffer => :ambi_choir, :pos => 0.2, :density => 2, :size => 0.2, :amp => 0.6}, nil, nil, nil, nil, nil, nil, nil, 
           {:note => :f3, :buffer => :ambi_choir, :pos => 0.6, :density => 2, :size => 0.2, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil)

# Massive dark drone underneath
s_pad   = (ring {:note => :e2, :release => 4.0, :attack => 2.0}, nil, nil, nil, nil, nil, nil, nil, 
           {:note => :f2, :release => 4.0, :attack => 2.0}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the cosmic drone and relentless kick (4 bars)
  [ [:play_pad, s_pad, 4], [:play_grain, s_grain, 4], [:play_kick, s_kick, 4] ],
  
  # Scene 2: Add the rolling 16th-note bass (8 bars)
  [ [:play_pad, s_pad, 8], [:play_grain, s_grain, 8], [:play_kick, s_kick, 8], 
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8] ],
    
  # Scene 3: The erratic FM lead drops in (8 bars)
  [ [:play_pad, s_pad, 8], [:play_grain, s_grain, 8], [:play_kick, s_kick, 8], 
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8], [:play_fm, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
