use_bpm 175

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F Minor - Dark, Sci-Fi, Aggressive)
# ==========================================================

# Tight, syncopated DnB breakbeat kick. 
s_kick  = (ring :c4, nil, nil, {:note => :c4, :amp => 0.6}, nil, nil, :c4, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, :c4, nil, nil, nil)

# Heavy, punchy snares on beat 2 and 4 (steps 4 and 12), with a ghost snare.
s_snare = (ring nil, nil, nil, nil, {:note => :c4, :amp => 1.0}, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.4}, nil, {:note => :c4, :amp => 1.0}, nil, nil, nil)

# Relentless, rolling 16th hi-hats
s_hats  = (ring {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.4})

# The "Reese" Bass. Deep, long release, and heavily filtered (cutoff 70).
s_bass  = (ring {:note => :f2, :release => 2.0, :cutoff => 70}, nil, nil, nil, nil, nil, nil, nil, {:note => :f2, :release => 2.0, :cutoff => 70}, nil, nil, nil, nil, nil, nil, nil)

# Erratic, squelchy FM sci-fi stabs.
# Uses Hashes to dynamically change the FM depth and divisor for a "talking" synth.
s_fm    = (ring nil, nil, nil, nil, nil, nil, {:note => :f5, :amp => 0.7, :depth => 4, :divisor => 2}, nil, nil, nil, nil, nil, nil, nil, {:note => :eb5, :amp => 0.6, :depth => 1, :divisor => 4}, nil)

# Metallic, machine-room texture (Granular Synth)
# Using :elec_piano, tiny size (0.02), high density (6) = industrial static.
s_grain = (ring nil, nil, nil, nil, nil, nil, nil, nil, {:note => :f3, :buffer => :elec_piano, :pos => 0.8, :density => 6, :size => 0.02, :amp => 0.4}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the frantic breakbeat and Reese bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: Add the erratic FM sci-fi stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_fm, 8] ],
    
  # Scene 3: Add the metallic granular texture (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_fm, 8], [:play_grain, s_grain, 4] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
