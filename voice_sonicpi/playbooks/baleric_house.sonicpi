# ==========================================================
# PLAYBOOK: BALEARIC HOUSE / IBIZA SUNSET
# Warm, Organic, Mediterranean Chill
# ==========================================================
# [WHY THIS GENRE?]
# Balearic House (Café del Mar, Jose Padilla) is the sound
# of the Mediterranean sunset – relaxed 4/4 grooves, organic
# swinging percussion, deep round bass, lush major chords,
# and echoing guitar‑like melodies. This playbook captures
# that warm, sun‑drenched, chill‑out atmosphere.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 108 BPM (relaxed)
# Key: D Major (warm, bright)
# Rhythm: Syncopated organic kick (1, 'and' of 2, beat 3),
# swung shaker with gaps and dynamic amplitudes, slow
# melodic bass, lush chords on downbeats, sparse Spanish
# guitar melody with tape echo.
# Timbre: Soft kick (bd_haus with accents), organic shaker
# (cymbal_closed with amp variation), round sub‑bass (dsaw,
# low cutoff, long release), warm major 9th chords (blade,
# slow attack), Spanish guitar FM (divisor 2, depth 2,
# tape echo), ambient granular vocal sigh.
# Arrangement: Sunset (chords+bass+grain) → Groove (add
# drums) → Night (add guitar melody).
# ==========================================================

use_bpm 108

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Syncopated organic kick: hits on 1, 'and' of 2, and beat 3
s_kick = gen_score("x.....x.x.......",
  [:c4, {note: :c4, amp: 0.7}, {note: :c4, amp: 0.9}])

# Swung organic shaker – gaps and dynamic amps for human feel
s_hats = gen_score("x.x.x.x.x.x.x.x.",
  [{note: :c4, amp: 0.2}, {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.3}, {note: :c4, amp: 0.4},
   {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3}])

# Round sub‑bass – low cutoff, long release for warmth
s_bass = gen_score("x.....x.x.....x.",
  [{note: :d2, release: 0.5, cutoff: 70},
   {note: :d2, release: 0.5, cutoff: 70},
   {note: :a1, release: 0.5, cutoff: 70},
   {note: :g1, release: 0.5, cutoff: 70}])

# Warm major 9th chords – slow attack to fade in softly
s_chords = gen_score("x.......x.......",
  [{note: [:d3, :fs3, :a3, :e4], cutoff: 90, release: 1.5, attack: 0.3, amp: 0.6},
   {note: [:g3, :b3, :d4, :a4], cutoff: 90, release: 1.5, attack: 0.3, amp: 0.6}])

# Spanish guitar melody – warm plucked tone with tape echo
s_fm = gen_score("....x.x.......x.",
  [{note: :d5, amp: 0.6, divisor: 2, depth: 2, release: 0.8},
   {note: :fs5, amp: 0.5, divisor: 2, depth: 2, release: 0.8},
   {note: :a5, amp: 0.7, divisor: 2, depth: 2, release: 0.8}])

# Ambient vocal sigh – distant beach texture
s_grain = gen_score("x...............",
  [{note: :d4, buffer: :ambi_choir, pos: 0.4, density: 1, size: 0.2, amp: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Sunset – Chords, Bass, Vocal Sigh
  [ [:play_chords, s_chords, 4], [:play_sub, s_bass, 4],
    [:play_grain, s_grain, 4] ],

  # Scene 2: Groove – Add Drums
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8],
    [:play_hats, s_hats, 8] ],

  # Scene 3: Night – Add Spanish Guitar
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8],
    [:play_hats, s_hats, 8], [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - FM as Spanish guitar: divisor 2 and depth 2 create a warm,
#   plucked string tone – tape echo smears it across the space.
# - Organic swing: hats leave gaps and use dynamic amplitudes
#   (0.2–0.4) to create a human, live‑percussion feel.
# - Deep warmth: bass with low cutoff (70) and long release
#   (0.5), chords with slow attack (0.3) – the engine locks
#   these lush elements without clashing.
# ==========================================================
