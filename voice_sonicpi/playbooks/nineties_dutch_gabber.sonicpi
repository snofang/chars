# ==========================================================
# PLAYBOOK: 90s DUTCH GABBER / HARDCORE
# (Pioneered by Paul Elstak, Neophyte, and Angerfist)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Dutch Gabber.
# We have explored heavy genres like Industrial Rock and French Electro, 
# but Gabber is the absolute limit of the 16-step grid's perceptible speed. 
# At 200 BPM, a 16th note is a microscopic 75 milliseconds long. It is the 
# sound of pure, distorted adrenaline, relying on a relentless, distorted 
# 4/4 kick, an off-beat "bumping" bass, and frantic, chip-tune style FM 
# arpeggios.
#
# This playbook perfectly demonstrates how to push the master clock to its 
# absolute limit. By playing continuous 16th notes at 200 BPM, the engine 
# creates an auditory blur that feels like a high-speed freight train.
# ==========================================================

use_bpm 200

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Frantic, Distorted, & Relentless)
# ==========================================================

# Relentless, heavily distorted 4/4 Gabber kick. (4 x's, 4 elements)
s_kick = gen_score("x...x...x...x...", [
  {note: :c4, amp: 1.5}, {note: :c4, amp: 1.5}, 
  {note: :c4, amp: 1.5}, {note: :c4, amp: 1.5}
])

# Heavy, dry rave clap strictly on beats 2 and 4. (2 x's, 2 elements)
s_clap = gen_score("....x.......x...", [
  {note: :c4, amp: 0.8}, {note: :c4, amp: 0.8}
])

# Rigid, driving 16th off-beat hats. (4 x's, 4 elements)
s_hats = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.3}, 
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.3}
])

# The "Bumping" Gabber Bass (A Minor).
# Hits strictly on the off-beats to create the "boom-cha boom-cha" bounce. (4 x's, 4 elements)
s_bass = gen_score("..x...x...x...x.", [
  {note: :a1, release: 0.1, amp: 1.2}, 
  {note: :a1, release: 0.1, amp: 1.2}, 
  {note: :a1, release: 0.1, amp: 1.2}, 
  {note: :a1, release: 0.1, amp: 1.2}
])

# Aggressive, off-beat synth stabs (A Minor). (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:a3, :c4, :e4], cutoff: 110, release: 0.15, amp: 0.6},
  {note: [:a3, :c4, :e4], cutoff: 110, release: 0.15, amp: 0.6},
  {note: [:g3, :bb3, :d4], cutoff: 110, release: 0.15, amp: 0.6},
  {note: [:f3, :a3, :c4], cutoff: 110, release: 0.15, amp: 0.6}
])

# Frantic, 200 BPM FM Arpeggio (A Minor).
# Plays on EVERY 16th step. The extreme speed creates a buzzing, chip-tune blur. (16 x's, 16 elements)
lead_notes = [:a5, :e5, :c6, :e5, :a5, :e5, :c6, :e5, 
              :g5, :d5, :bb5, :d5, :f5, :c5, :a5, :c5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 4, release: 0.05} }
s_lead = gen_score("xxxxxxxxxxxxxxxx", lead_data)

# Pitched-up, demonic "MC" vocal stutter. (2 x's, 2 elements)
s_vocal = gen_score("....x.......x...", [
  {note: :a4, buffer: :misc_lori, pos: 0.2, density: 3, size: 0.02, amp: 0.6},
  {note: :c5, buffer: :misc_lori, pos: 0.4, density: 3, size: 0.02, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Freight Train - Just the relentless kick and bumping bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Rave - Add the heavy claps, hats, and off-beat stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], 
    [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Meltdown - The frantic 200 BPM FM arpeggio drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], 
    [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8], 
    [:play_lead, s_lead, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN EXTREME TEMPO]
# 
# 1. The 200 BPM Blur: Look at `s_lead`. It plays on EVERY single 16th step. 
#    At 200 BPM, the engine is firing a note every 75 milliseconds. Because 
#    the engine's strict master clock is perfectly rigid, this creates an 
#    auditory blur that sounds like a buzzing saw wave, perfectly mimicking 
#    the frantic chip-tune arpeggios of 90s Gabber and Happy Hardcore.
#
# 2. The Off-Beat Bump: Look at `s_bass` and `s_chords`. They hit strictly 
#    on steps 2, 6, 10, and 14. In a 16-step grid, these are the exact 
#    midpoints between the kicks. The engine's strict master clock locks 
#    these together perfectly, creating the signature Gabber "boom-cha 
#    boom-cha" bounce that drives the track forward unstoppably.
#
# 3. Extreme Distortion: The `s_kick` uses a massive amplitude (`1.5`). 
#    In Sonic Pi, pushing the amplitude this high causes the internal 
#    limiter to clamp down, naturally distorting the kick drum. Combined 
#    with the off-beat bass, the engine creates a massive, distorted wall 
#    of sound that feels like standing in front of a massive speaker stack 
#    at a 90s underground rave.
# ==========================================================
