# ==========================================================
# PLAYBOOK: TRIP HOP
# A Smoky, Downtempo, Beat‑Driven Atmosphere
# ==========================================================
# [WHY THIS GENRE?]
# Trip hop (Massive Attack, Portishead) fuses hip‑hop beats, jazz
# harmony, cinematic samples, and nocturnal mood. This playbook
# captures that essence – dusty, hypnotic, deeply textured.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 82 BPM
# Key: E minor (Dorian inflection)
# Rhythm: Heavy kick on 1 and ghost on the "and" of 3; snare on 2/4
# with swing; laid‑back 8th hats with shuffle.
# Timbre: Subby bass (dsaw), Rhodes‑like lead (prophet+echo), warm
# pads (blade), vibraphone‑like pluck, dusty vocal grains (ambi_choir).
# Arrangement: Intro (bass+chords+pluck) → Verse (drums enter) →
# Drop (lead+grain).
# ==========================================================

use_bpm 82

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick = gen_score("x...x..x...x..x.",
  [{note: :e2, amp: 1.5}, {note: :e2, amp: 0.7}, {note: :e2, amp: 0.9}])

s_snare = gen_score("...x...x..x..x...",
  [{note: :b2, amp: 0.7}, {note: :b2, amp: 0.4}, {note: :b2, amp: 0.9}])

hat_amps = 16.times.map { |i| {note: :e3, amp: (i % 2 == 0) ? 0.2 : 0.08} }
s_hats = gen_score("x.x...x.x...x.x.", hat_amps)

bass_data = 16.times.map { |i| {note: :e2, cutoff: 55 + (i % 8) * 3, release: 0.5, amp: 1.2} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

chord_seq = [
  [:e3, :g3, :b3, :d4], [:e3, :g3, :b3, :d4],
  [:a3, :c4, :e4, :g4], [:a3, :c4, :e4, :g4],
  [:g3, :b3, :d4, :e4], [:g3, :b3, :d4, :e4],
  [:f3, :a3, :c4, :e4], [:f3, :a3, :c4, :e4],
  [:e3, :g3, :b3, :d4], [:e3, :g3, :b3, :d4],
  [:a3, :c4, :e4, :g4], [:a3, :c4, :e4, :g4],
  [:g3, :b3, :d4, :e4], [:g3, :b3, :d4, :e4],
  [:f3, :a3, :c4, :e4], [:f3, :a3, :c4, :e4]
]
s_chords = gen_score("xxxxxxxxxxxxxxxx",
  chord_seq.map { |ch| {note: ch, cutoff: 70, release: 2.0, amp: 0.35} })

lead_notes = [:e4, :g4, :b4, :d5, :e4, :g4, :b4, :d5,
              :c5, :b4, :a4, :g4, :c5, :b4, :a4, :g4]
s_lead = gen_score("x...x...x...x...",
  lead_notes.map { |n| {note: n, amp: 0.6, cutoff: rrand(70,90)} })

pluck_notes = [:b4, :g4, :e4, :d4, :b4, :g4, :e4, :d4,
               :a4, :g4, :e4, :c4, :a4, :g4, :e4, :c4]
s_pluck = gen_score("x...x...x...x...",
  pluck_notes.map { |n| {note: n, amp: 0.4, coef: rrand(0.4,0.6)} })

grain_data = 16.times.map { |i|
  {note: :c5, buffer: :ambi_choir, pos: 0.1 + (i % 8) * 0.07,
   density: 3 + (i % 3), size: 0.06 + (i % 4) * 0.005, amp: 0.2}
}
s_grain = gen_score("x..x..x..x..x...", grain_data)

s_pad = gen_score("x...............", [{note: :e2, amp: 0.15, release: 5}])

# Playbook
playbook = (ring
  # Scene 1: Intro
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4],
    [:play_pluck, s_pluck, 4], [:play_pad, s_pad, 4] ],

  # Scene 2: Verse
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8],
    [:play_pluck, s_pluck, 8], [:play_pad, s_pad, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8] ],

  # Scene 3: Drop
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8],
    [:play_pluck, s_pluck, 8], [:play_pad, s_pad, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_lead, s_lead, 8],
    [:play_grain, s_grain, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The swing in s_hats: only two hits per 16th (with offset)
#   creates the signature laid‑back shuffle.
# - The chord progression (Em9 – Am9 – G6 – F#m7b5) uses
#   extended jazz harmony to evoke that melancholic, smoky
#   Bristol night vibe.
# - Grain on `:ambi_choir` with varying pos and density gives
#   a dusty, sampled‑vocal texture that fills space without
#   overpowering the beat.
# ==========================================================
