# ==========================================================
# PLAYBOOK: 2000s NU-METAL / RAP ROCK
# (Pioneered by Linkin Park, Limp Bizkit, and Korn)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 2000s Nu-Metal.
# We have explored Pop-Punk and Stadium Rock, but Nu-Metal is the sound 
# of 2000s teenage aggression. It fuses the heavy, syncopated drum loops 
# of hip-hop with massive, down-tuned distorted guitar chugs, eerie 
# cinematic synth pads, and pitched-down, rhythmic vocal stutters. 
#
# This playbook perfectly demonstrates how to use a purely electronic 
# engine to simulate a heavy metal band. By using the `:play_sub` synth 
# as a continuous, distorted 16th-note "chug" and the `:play_fm` synth 
# to create piercing, turntable-scratch leads, the engine creates a 
# massive, aggressive, and deeply nostalgic rock atmosphere.
# ==========================================================

use_bpm 95

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (C# Minor - Heavy, Aggressive, & Cinematic)
# ==========================================================

# Syncopated hip-hop rock kick. 
# Hits on step 0, the 'and' of 2 (step 6), and beat 3 (step 8).
s_kick = gen_score("x.....x.x.......", [:c4, {note: :c4, amp: 0.8}, :c4])

# Heavy, echoing snare strictly on beats 2 and 4.
s_snare = gen_score("....x.......x...", [:c4])

# Rigid, driving 8th hats.
s_hats = gen_score("x.x.x.x.x.x.x.x.", [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}])

# The "Distorted Guitar Chug" Bass (C# Minor).
# Plays continuous 16th notes. Extreme cutoff (120) and microscopic release (0.05) 
# create a grinding, distorted churn that mimics a down-tuned 7-string guitar.
bass_cycle = [:cs1, :cs1, :cs1, :cs1, :cs1, :cs1, :cs1, :cs1, 
              :g1, :g1, :g1, :g1, :b1, :b1, :b1, :b1]
bass_data = bass_cycle.map { |n| {note: n, cutoff: 120, release: 0.05, amp: 1.2} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Eerie, "Cinematic" Synth Pad (C#m to Gmaj to Bmaj).
# Hit on the downbeats. The slow 1.0-beat attack and massive 4.0-beat release 
# blur the chords into a continuous, haunting, atmospheric wave.
s_chords = gen_score("x.......x.......", [
  {note: [:cs3, :e3, :gs3], cutoff: 80, attack: 1.0, release: 4.0, amp: 0.4},
  {note: [:b2, :eb3, :fs3], cutoff: 80, attack: 1.0, release: 4.0, amp: 0.4}
])

# Piercing, "Turntable Scratch" Lead (C# Minor Pentatonic).
# Uses :play_fm with a low divisor (2) and extreme depth (5) to create a 
# sharp, buzzy square wave that mimics a DJ scratch or guitar harmonic.
lead_notes = [:cs4, :gs4, :b4, :cs5, :b4, :gs4, :e4, :cs4]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 5, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# Pitched-down, "Rap" vocal stutter (Granular Synth).
# Low density, small size = a dark, percussive vocal skip.
s_vocal = gen_score("....x.......x...", [
  {note: :cs3, buffer: :ambi_choir, pos: 0.1, density: 2, size: 0.04, amp: 0.7},
  {note: :b2, buffer: :ambi_choir, pos: 0.3, density: 2, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Jam - Just the heavy drums, guitar chug, and eerie pad (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_chords, s_chords, 4] ],
  
  # Scene 2: The Vibe - Add the rhythmic rap vocal chops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drop - The piercing turntable scratch lead drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN ROCK/hip-HOP FUSION]
# 
# 1. The Guitar Chug Illusion: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step with an extreme `cutoff` (120) and a microscopic 
#    `release` (0.05). This turns the detuned sawtooth into a relentless, 
#    grinding, distorted churn that perfectly mimics a down-tuned 7-string 
#    electric guitar playing palm-muted 16th notes.
#
# 2. FM as a Turntable: The `s_lead` sequence uses `divisor: 2` and an extreme 
#    `depth` of `5`. This harsh harmonic ratio produces a piercing, buzzy square 
#    wave. Routed through the tape echo, the sparse, staccato notes mimic a 
#    DJ scratching or a guitar harmonic, perfectly anchoring the track's 
#    rap-rock aesthetic.
#
# 3. Cinematic Contrast: Nu-Metal relies on the stark contrast between the 
#    aggressive, high-speed rhythm section and the slow, haunting, sweeping 
#    synth pads. The `s_chords` sequence uses a slow `attack` (1.0) and massive 
#    `release` (4.0) to blur the chords into a continuous, eerie wave of sound 
#    that floats above the heavy, distorted chugs.
# ==========================================================
