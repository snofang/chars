# ==========================================================
# PLAYBOOK: 80s FLAMENCO RUMBA / SPANISH GUITAR POP
# (Pioneered by Gipsy Kings, Ottmar Liebert, and Paco de Lucía)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 80s Flamenco Rumba.
# We have explored Bossa Nova and Mediterranean Tango, but Flamenco Rumba is 
# the sound of pure, high-energy Spanish passion. It fuses the complex, 
# syncopated "palmas" (hand-claps) and "cajón" drumming of traditional flamenco 
# with the accessible, driving 4/4 rhythm of pop. It relies on a rapid, 
# continuous 16th-note acoustic guitar strumming pattern (rasgueado), a deep, 
# walking upright bass, and a piercing, echoing lead guitar melody.
#
# This playbook perfectly demonstrates how to use the `:play_pluck` synth 
# to simulate a rapid, rhythmic acoustic guitar strum, and how to map a 
# complex, 3-3-2 "cajón" rhythm to the 16-step grid.
# ==========================================================

use_bpm 115

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (E Phrygian Dominant - Passionate, Fast, & Acoustic)
# ==========================================================

# The "Cajón" Kick. 
# A driving, 3-3-2 syncopated march. (4 x's, 4 elements)
s_kick = gen_score("x..x..x.x..x....", [
  :c4, {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.6}
])

# The "Palmas" (Hand-claps). 
# Crisp, organic snare on beats 2 and 4, with syncopated ghost claps. (3 x's, 3 elements)
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.4}, {note: :c4, amp: 0.9}
])

# Fast, rolling 16th shaker to drive the momentum. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Walking Upright" Bass (E Phrygian Dominant).
# Plays a driving, melodic line. Mid cutoff (80) and short release (0.15) 
# mimic a fast, picked upright bass. (8 x's, 8 elements)
bass_notes = [:e1, :e1, :f1, :e1, :c2, :c2, :d2, :e1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 80, release: 0.15, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# The "Rasgueado" Guitar Strums (E to F to G).
# Uses :play_pluck. Hits strictly on the off-beats to mimic fast, rhythmic strumming. 
# (4 x's, 4 elements)
s_guitar = gen_score("..x...x...x...x.", [
  {note: [:e3, :b3, :e4], amp: 0.6, release: 0.08, coef: 0.3}, 
  {note: [:f3, :c4, :f4], amp: 0.6, release: 0.08, coef: 0.3}, 
  {note: [:g3, :d4, :g4], amp: 0.6, release: 0.08, coef: 0.3}, 
  {note: [:f3, :c4, :f4], amp: 0.6, release: 0.08, coef: 0.3}
])

# Piercing, "Lead Guitar" Melody (E Phrygian Dominant).
# Uses :play_lead routed through the global tape echo bus. The long release (0.3) 
# creates a soaring, echoing Spanish guitar solo. (6 x's, 6 elements)
lead_notes = [:e5, :f5, :g5, :a5, :g5, :f5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, cutoff: 100, release: 0.3} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Ole!" Crowd Drone (Granular Synth).
# Using the built-in :ambi_choir sample.
# Long size (0.2) and low density (1) creates a lush, background texture. (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :e3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.2, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Café - Just the walking bass, rhythm guitar, and drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_pluck, s_guitar, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Dance - Add the cajón drums and palmas (8 bars)
  [ [:play_sub, s_bass, 8], [:play_pluck, s_guitar, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Solo - The piercing lead guitar melody drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_pluck, s_guitar, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN SPANISH PASSION]
# 
# 1. The "Rasgueado" Strum: Look at `s_guitar`. The `:play_pluck` synth hits 
#    strictly on the off-beats (steps 2, 6, 10, 14). By using a microscopic 
#    `release` (0.08) and a very low `coef` (0.3), the engine turns the pluck 
#    into a sharp, percussive "chuka" that perfectly mimics the rapid, rhythmic 
#    strumming of a Spanish acoustic guitar.
#
# 2. The Phrygian Dominant Scale: Look at `s_bass` and `s_lead`. The melody 
#    uses E, F, G, A, B, C, D. The augmented 2nd interval between F and G 
#    creates the exotic, "Spanish" sound that defines Flamenco music. The 
#    engine's strict 16-step grid ensures this rapid, melodic lead fires 
#    flawlessly over the complex rhythm section.
#
# 3. The 3-3-2 Cajón Rhythm: Look at `s_kick`. It completely avoids landing 
#    on a standard 4/4 pulse. By hitting on syncopated, galloping steps 
#    (0, 3, 6, 8, 11), the engine creates a lopsided, driving groove that 
#    perfectly mimics a live cajón player, anchoring the track's high-energy, 
#    passionate atmosphere.
# ==========================================================
