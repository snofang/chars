# ==========================================================
# PLAYBOOK: 80s HI-NRG / EURODISCO
# Piercing, Robotic, High Energy Momentum
# ==========================================================
# [WHY THIS GENRE?]
# Hi‑NRG (Patrick Cowley, Dead or Alive) is defined by a relentless
# octave‑jumping 16th‑note bassline (the "gallop"), rigid off‑beat
# hi‑hats, and piercing synthesized orchestral stabs. This playbook
# captures that unstoppable, high‑energy 80s club pulse.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 138 BPM
# Key: A minor (piercing, driving)
# Rhythm: 4/4 kick, clap on 2/4, off‑beat hats, gallop bass
# on every 16th with octave jumps, staccato chord stabs on
# off‑beats, piercing FM lead, chopped robotic vocal stutter.
# Timbre: Relentless kick (bd_haus), synthetic clap (sn_dolf),
# off‑beat hats (cymbal_closed), gallop bass (dsaw, high cutoff,
# short release), orchestral stabs (blade), FM lead (divisor 3,
# depth 4), granular vocal stutter (ambi_choir).
# Arrangement: Drive (kick+hats+bass) → Vibe (add clap+stabs)
# → Drop (add lead+vocal).
# ==========================================================

use_bpm 138

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Relentless 4‑on‑the‑floor kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy synthetic clap on beats 2 and 4
s_clap = gen_score("....x.......x...", [:c4])

# Rigid off‑beat hats (steps 2,6,10,14) with varying amplitudes
s_hats = gen_score("..x..x..x..x....",
  [{note: :c4, amp: 0.4}, {note: :c4, amp: 0.5},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}])

# The "Gallop" Bass – continuous 16ths with octave jumps
# Define the 16-step note sequence (alternating low/high)
bass_notes = [
  :a2, :a3, :a2, :a3, :a2, :a3, :e2, :e3,
  :a2, :a3, :a2, :a3, :g2, :g3, :f2, :e2
]
# Build hash array once
s_bass = gen_score("xxxxxxxxxxxxxxxx",
  bass_notes.map { |n| {note: n, cutoff: 100, release: 0.1} })

# Staccato orchestral stabs on off‑beats (steps 2,6,10,14)
s_chords = gen_score("..x..x..x..x....",
  [[:a3, :c4, :e4],
   [:a3, :c4, :e4],
   [:g3, :bb3, :d4],
   [:f3, :a3, :c4]])

# Piercing metallic FM lead – sparse on even steps (0,2,4,...)
# Define the note and amp sequence
fm_notes = [
  {note: :a5, amp: 0.6},
  {note: :e5, amp: 0.5},
  {note: :c6, amp: 0.7},
  {note: :e6, amp: 0.5},
  {note: :a5, amp: 0.6},
  {note: :c6, amp: 0.7},
  {note: :d6, amp: 0.5},
  {note: :e6, amp: 0.7}
]
s_fm = gen_score("x.x.x.x.x.x.x.x.",
  fm_notes.map { |h| h.merge(divisor: 3, depth: 4, release: 0.2) })

# Chopped robotic vocal stutter – steps 4 and 12
s_vocal = gen_score("....x.......x...",
  [{note: :a4, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.03, amp: 0.6},
   {note: :c5, buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.03, amp: 0.6}])

# Playbook
playbook = (ring
  # Scene 1: Drive – Kick, Hats, Gallop Bass
  [ [:play_kick, s_kick, 4], [:play_hats, s_hats, 4],
    [:play_sub, s_bass, 4] ],

  # Scene 2: Vibe – Add Clap and Stabs
  [ [:play_kick, s_kick, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_snare, s_clap, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3: Drop – Add FM Lead and Vocal
  [ [:play_kick, s_kick, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_snare, s_clap, 8],
    [:play_chords, s_chords, 8], [:play_lead, s_fm, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The gallop bass: continuous 16ths with octave jumps (a2→a3)
#   and high cutoff (100) create a relentless, piercing pulse.
# - Rigid off‑beats: hats and chords on steps 2,6,10,14 lock
#   together for a massive "boom‑cha" wall of sound.
# - FM as piercing lead: divisor 3 and depth 4 produce a sharp,
#   metallic square wave that cuts through the heavy bass.
# ==========================================================
