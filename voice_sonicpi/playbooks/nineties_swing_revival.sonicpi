# ==========================================================
# PLAYBOOK: 90s SWING REVIVAL / NEO-SWING
# (Pioneered by Big Bad Voodoo Daddy, Cherry Poppin' Daddies, and Royal Crown Revue)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Swing Revival.
# We have explored Ska Punk and Electro Swing, but Neo-Swing is the sound 
# of the 90s lounge revival. It fuses the blistering, high-speed tempo of 
# 1940s swing jazz with the loud, driving energy of a punk rock trio. 
# It relies on a relentless, driving 4/4 drum beat, a walking, upright 
# slap bass, tight, staccato horn section stabs, and a piercing, soaring 
# saxophone lead.
#
# This playbook perfectly demonstrates how to use a purely electronic 
# engine to simulate a high-energy, live jazz big band. By using the 
# `:play_fm` synth to simulate a brass section and the `:play_sub` synth 
# to create a walking slap bass, the engine creates a frantic, sweaty, 
# swing-dance atmosphere.
# ==========================================================

use_bpm 200

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (Bb Major - Fast, Brassy, & Driving)
# ==========================================================

# The "Swing Beat" Kick. 
# A driving, syncopated march. (5 x's, 5 elements)
s_kick = gen_score("x..x..x.x..x....", [
  :c4, {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.6}, :c4
])

# Heavy, dry snare on beats 2 and 4, with a syncopated ghost note. (3 x's, 3 elements)
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.9}
])

# Rigid, driving 8th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Walking Upright" Bass (Bb Major).
# Plays continuous, driving 8th notes. High cutoff (90) and short release (0.1) 
# mimic a fast, slapped upright bass. (8 x's, 8 elements)
bass_notes = [:bb1, :bb1, :c2, :d2, :eb2, :eb2, :f2, :g2]
bass_data = bass_notes.map { |n| {note: n, cutoff: 90, release: 0.1, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# Tight, "Horn Section" Stabs (Bb to Eb to F).
# Uses :play_fm with a low divisor (2) and mid depth (3) to create a warm, 
# brassy staccato hit that mimics a live horn section. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:bb3, :d4, :f4], divisor: 2, depth: 3, release: 0.1, amp: 0.6},
  {note: [:bb3, :d4, :f4], divisor: 2, depth: 3, release: 0.1, amp: 0.6},
  {note: [:eb3, :g3, :bb3], divisor: 2, depth: 3, release: 0.1, amp: 0.6},
  {note: [:f3, :a3, :c4], divisor: 2, depth: 3, release: 0.1, amp: 0.6}
])

# Piercing, "Lead Sax" Melody (Bb Major Pentatonic).
# Uses :play_fm with a high divisor (3) and low depth (2) to create a clean, 
# piercing brass tone. Routed through the engine's tape echo. (6 x's, 6 elements)
lead_notes = [:bb5, :f5, :d6, :bb5, :c6, :d6]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 2, release: 0.15} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Shouted" Vocal (Granular Synth).
# Long size (0.08) and low density (1) creates a raw, repetitive vocal hit. (1 x, 1 element)
s_vocal = gen_score("........x.......", [
  {note: :bb3, buffer: :misc_lori, pos: 0.2, density: 1, size: 0.08, amp: 0.8}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Jam - Just the driving drums, walking bass, and horns (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_fm, s_chords, 4] ],
  
  # Scene 2: The Vibe - Add the shouted vocals (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Solo - The piercing lead sax melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN BIG BAND ENERGY]
# 
# 1. FM as a Horn Section: Look at `s_chords`. The `:play_fm` synth is given 
#    a `divisor` of `2` and a `depth` of `3`, with a microscopic `release` 
#    (0.1). This forces the FM synth to produce a warm, brassy, staccato 
#    "hit" that perfectly mimics a live horn section locking in with the 
#    rhythm section on the off-beats.
#
# 2. The Walking Upright Bass: Look at `s_bass`. The `:play_sub` synth plays 
#    on every 8th note, mapping out a fast, walking line. By using a mid-range 
#    `cutoff` (90) and a short `release` (0.1), the engine turns the detuned 
#    sawtooth into a punchy, acoustic "thwack" that perfectly mimics a slapped 
#    upright bass driving the rhythm at 200 BPM.
#
# 3. FM as a Lead Sax: The `s_lead` sequence uses `divisor: 3` and `depth: 2`. 
#    This harmonic ratio produces a clean, piercing tone that mimics an alto 
#    saxophone solo. Routed through the engine's tape echo, the sparse notes 
#    cascade across the empty space, perfectly anchoring the track's frantic, 
#    swing-dance atmosphere.
# ==========================================================
