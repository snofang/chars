# ==========================================================
# PLAYBOOK: TRIBAL HOUSE / LATIN TRIBAL
# (Pioneered by Danny Tenaglia, Junior Vasquez, and Peter Rauhofer)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# Tribal House injects the 4/4 grid with dense polyrhythmic FM
# percussion, removing melodies in favor of hypnotic drum loops
# and cavernous vocal chants. This playbook uses FM synthesis
# to create woody conga/tom sounds, a pumping off‑beat bass,
# and a dark, cavernous vocal texture.
# ==========================================================

use_bpm 128

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x...x...x...x...", [:c4])

s_clap  = gen_score("....x.......x...", [:c4])

s_hats  = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4}
])

s_bass  = gen_score("..x...x...x...x.", [
  {note: :a1, release: 0.1, cutoff: 70}
])

s_toms  = gen_score("x..x.x.xx.x.x.x.", [
  {note: :a3, amp: 0.6, divisor: 4, depth: 1, release: 0.05},
  {note: :e3, amp: 0.7, divisor: 4, depth: 1, release: 0.05},
  {note: :a3, amp: 0.6, divisor: 4, depth: 1, release: 0.05},
  {note: :c4, amp: 0.5, divisor: 4, depth: 1, release: 0.05},
  {note: :e3, amp: 0.7, divisor: 4, depth: 1, release: 0.05},
  {note: :a3, amp: 0.6, divisor: 4, depth: 1, release: 0.05},
  {note: :g3, amp: 0.5, divisor: 4, depth: 1, release: 0.05},
  {note: :e3, amp: 0.7, divisor: 4, depth: 1, release: 0.05}
])

s_chords = gen_score("x.......x.......", [
  {note: [:a3, :c4, :e4], cutoff: 90, release: 0.2, amp: 0.5},
  {note: [:a3, :c4, :e4], cutoff: 90, release: 0.2, amp: 0.5}
])

s_vocal  = gen_score("x...........x...", [
  {note: :a3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.1, amp: 0.5},
  {note: :e3, buffer: :ambi_choir, pos: 0.4, density: 1, size: 0.1, amp: 0.5}
])

# Playbook
playbook = (ring
  # Scene 1: The Rhythm – kick, bass, and polyrhythmic toms (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_fm, s_toms, 4] ],
  
  # Scene 2: The Groove – add claps, hats, and sparse chords (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_fm, s_toms, 8],
    [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Cave – cavernous vocal chants drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_fm, s_toms, 8],
    [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - FM with divisor 4 and tiny release produces a hollow, woody
#   conga/tom sound that weaves polyrhythmically over the 4/4 kick.
# - The off‑beat bass (steps 2,6,10,14) with short release and low
#   cutoff creates a relentless, hypnotic pump.
# - The vocal is time‑stretched (size 0.1) into a distant,
#   cavernous drone, adding space and depth to the tribal groove.
# ==========================================================
