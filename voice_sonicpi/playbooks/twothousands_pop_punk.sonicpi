# ==========================================================
# PLAYBOOK: 2000s POP-PUNK / EMO POP
# (Pioneered by Blink-182, Green Day, and Sum 41)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 2000s Pop-Punk.
# We have explored electronic dance genres and hip-hop, but Pop-Punk is 
# the sound of 2000s teenage angst. It relies on a fast, driving 170 BPM 
# rhythm, continuous 8th-note drum hats, octave-jumping picked bass, 
# and massive, distorted power chords.
#
# This playbook perfectly demonstrates how to use a purely electronic 
# engine to simulate a live, fast-paced rock band. By using the `:play_fm` 
# synth to create distorted power chords and the `:play_sub` synth to 
# create a driving, picked bass, the engine creates a high-energy, 
# nostalgic rock atmosphere.
# ==========================================================

use_bpm 160

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Major - Fast, Distorted, & Energetic)
# ==========================================================

# Fast, driving 4/4 rock kick.
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, echoing snare strictly on beats 2 and 4.
s_snare = gen_score("....x.......x...", [:c4])

# Rigid, continuous 8th hats. 
# Notice the amplitude difference (0.3 vs 0.15) that creates a driving march.
s_hats = gen_score("x.x.x.x.x.x.x.x.", [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}])

# The "Picked" Octave Bass (D Major).
# Plays continuous 8th notes, alternating octaves (:d2, :d3). 
# High cutoff (100) and short release (0.1) create a punchy, aggressive churn.
bass_cycle = [:d2, :d3, :d2, :d3, :a1, :a2, :a1, :a2, :b1, :b2, :b1, :b2, :g1, :g2, :g1, :g2]
bass_data = bass_cycle.map { |n| {note: n, cutoff: 100, release: 0.1, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# Massive, "Distorted" Power Chords (D5 to A5 to B5 to G5).
# Uses :play_fm with a low divisor (2) and extreme depth (5) to create a 
# sharp, buzzy square wave that mimics a distorted electric guitar.
s_chords = gen_score("..x...x...x...x.", [
  {note: [:d3, :a3], divisor: 2, depth: 5, release: 0.2, amp: 0.6},
  {note: [:a3, :e4], divisor: 2, depth: 5, release: 0.2, amp: 0.6},
  {note: [:b3, :fs4], divisor: 2, depth: 5, release: 0.2, amp: 0.6},
  {note: [:g3, :d4], divisor: 2, depth: 5, release: 0.2, amp: 0.6}
])

# Bright, "Octave Guitar" Lead (D Major Pentatonic).
# Uses :play_fm with a high divisor (3) and low depth (2) to create a clean, 
# chiming guitar tone. Routed through the engine's tape echo for a smear.
lead_notes = [:d5, :a4, :d6, :a5, :e5, :b4, :e6, :b5, :g5, :d5, :g6, :d6, :fs5, :d5, :fs5, :a5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.5, divisor: 3, depth: 2, release: 0.1} }
s_lead = gen_score("x.x.x.x.x.x.x.x.", lead_data)

# "Group Vocals" chant (Granular Synth).
# Long size (0.1) and low density (1) creates a raw, repetitive vocal hit 
# that mimics a crowd singing along.
s_vocal = gen_score("........x.......", [
  {note: :d4, buffer: :misc_lori, pos: 0.3, density: 1, size: 0.1, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Jam - Just the fast drums, picked bass, and power chords (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_fm, s_chords, 4] ],
  
  # Scene 2: The Vibe - Add the group vocals (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Solo - The bright octave guitar lead drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN ROCK MOMENTUM]
# 
# 1. FM as a Distorted Amp: Look at `s_chords`. The `:play_fm` synth is given 
#    a `divisor` of `2` and an extreme `depth` of `5`. This harsh harmonic 
#    ratio forces the FM modulator to shatter the carrier wave, creating a 
#    piercing, buzzy square wave that perfectly mimics a distorted electric 
#    guitar playing power chords.
#
# 2. The Picked Octave Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    every 8th note, alternating between the low octave (:d2) and the high 
#    octave (:d3). By using a high `cutoff` (100) and a very short `release` 
#    (0.1), the engine turns the detuned sawtooth into a punchy, aggressive 
#    "thwack" that perfectly mimics a picked electric bass guitar driving 
#    the rhythm, a hallmark of 2000s pop-punk.
#
# 3. The 8th-Note Drive: 2000s Pop-Punk relies on a stark, driving rhythm 
#    section. The `s_hats` play straight 8th notes, and the `s_kick` avoids 
#    complex syncopation. The engine's strict master clock ensures this 
#    rigid, mechanical momentum locks perfectly with the continuous 8th-note 
#    bassline, creating a high-energy, forward-driving rock groove.
# ==========================================================
