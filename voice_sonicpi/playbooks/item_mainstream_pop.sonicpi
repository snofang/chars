# ==========================================================
# PLAYBOOK: 2024/2025 MAINSTREAM POP / "BRAT" ERA
# (Pioneered by Charli XCX, Tate McRae, and Dua Lipa)
# ========================================================== 

use_bpm 130

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Minor - Punchy, Catchy, & Club-Ready)
# ==========================================================

# Punchy, driving 4/4 dance-pop kick. (4 x's, 4 elements)
s_kick = gen_score("x...x...x...x...", [
  {note: :c4, amp: 1.0}, {note: :c4, amp: 0.9}, 
  {note: :c4, amp: 1.0}, {note: :c4, amp: 0.9}
])

# Heavy, organic 909 clap strictly on beats 2 and 4. (2 x's, 2 elements)
s_clap = gen_score("....x.......x...", [:c4, :c4])

# Bouncing, syncopated 16th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# Deep, "Reese" Sub-Bass (F# Minor).
# Plays a syncopated, bouncy line. 
# Low cutoff (60) and medium release (0.2) create a dark, warm undercurrent.
# (6 x's, 6 elements)
s_bass = gen_score("x..x..x..x..x..x.", [
  {note: :fs1, release: 0.2, cutoff: 60, amp: 1.2}, 
  {note: :fs1, release: 0.2, cutoff: 60, amp: 1.0}, 
  {note: :a1, release: 0.2, cutoff: 60, amp: 1.0}, 
  {note: :fs1, release: 0.2, cutoff: 60, amp: 1.0}, 
  {note: :e1, release: 0.2, cutoff: 60, amp: 1.0}, 
  {note: :fs1, release: 0.2, cutoff: 60, amp: 1.0}
])

# Bright, "Plucky" FM Chords (F#m to A to E).
# Uses :play_fm with a high divisor (3) and low depth (2) to create a pristine, 
# glassy, pop synth tone. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:fs3, :a3, :c4], divisor: 3, depth: 2, release: 0.15, amp: 0.5},
  {note: [:a3, :c4, :e4], divisor: 3, depth: 2, release: 0.15, amp: 0.5},
  {note: [:e3, :g3, :b3], divisor: 3, depth: 2, release: 0.15, amp: 0.5},
  {note: [:a3, :c4, :e4], divisor: 3, depth: 2, release: 0.15, amp: 0.5}
])

# Piercing, "Catchy" Synth Lead (F# Minor Pentatonic).
# Uses :play_fm with a low divisor (2) and mid depth (3) to create a sharp, 
# buzzy square wave. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:fs5, :a5, :c6, :b5, :a5, :fs5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 3, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# Chopped, "Stuttering" Pop Vocal (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched UP.
# High density, tiny size = a sharp, sugary, club-ready vocal skip. (2 x's, 2 elements)
s_vocal = gen_score("....x.......x...", [
  {note: :fs4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.6},
  {note: :a4, buffer: :ambi_choir, pos: 0.3, density: 3, size: 0.04, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the Reese bass, plucky chords, and vocal chops (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Verse - Add the driving 4/4 dance drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chorus - The catchy synth lead melody drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN MODERN POP]
# 
# 1. The Reese Bass: Look at `s_bass`. The `:play_sub` synth is given a 
#    low `cutoff` (60) and a medium `release` (0.2). This creates a deep, 
#    round, and warm low-end that weaves perfectly between the kicks, carrying 
#    the melodic progression without muddying the pristine high-end of the 
#    FM chords.
#
# 2. FM as a Pluck: Look at `s_chords`. The `:play_fm` synth is given a high 
#    `divisor` (3) and a low `depth` (2), with a microscopic `release` (0.15). 
#    This forces the FM synth to produce a pristine, glassy, staccato "pluck" 
#    that perfectly mimics the bright, catchy synth presets used in modern 
#    pop productions.
#
# 3. The Dance-Pop Groove: 2020s pop relies heavily on club rhythms. The 
#    `s_kick` hits strictly on every beat, while the `s_hats` play continuous 
#    16th notes. The engine's strict master clock ensures this rigid, mechanical 
#    momentum locks perfectly with the syncopated bassline, creating a massive, 
#    forward-driving dance-pop groove.
# ==========================================================
