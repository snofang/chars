# ==========================================================
# PLAYBOOK: 80s STADIUM ROCK / ARENA METAL
# (Pioneered by Europe, Survivor, and Scorpions)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 80s Stadium Rock.
# We have explored electronic dance genres and hip-hop, but Stadium Rock 
# is the sound of massive, distorted guitars and echoing, gated snares. 
# By slowing the grid down to a marching 110 BPM and using a high `cutoff` 
# on the `:play_sub` synth, we can simulate a driving, picked electric 
# bass. By pushing the `:play_fm` synth to extreme `depth`, we can 
# mimic a piercing, echoing electric guitar solo.
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create a massive, theatrical rock groove without a single real guitar 
# or drum kit, relying purely on aggressive synthesis and parameter hashes.
# ==========================================================

use_bpm 110

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Heavy, Theatrical, & Driving)
# ==========================================================

# Heavy, marching 4/4 kick. 
# Hits on step 0, beat 2 (step 4), beat 3 (step 8), and beat 4 (step 12).
s_kick  = (ring {:note => :c4, :amp => 1.2}, nil, nil, nil, {:note => :c4, :amp => 1.0}, nil, nil, nil, {:note => :c4, :amp => 1.2}, nil, nil, nil, {:note => :c4, :amp => 1.0}, nil, nil, nil)

# Massive, gated stadium snare strictly on beats 2 and 4 (steps 4 and 12).
s_snare = (ring nil, nil, nil, nil, {:note => :c4, :amp => 1.1}, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 1.1}, nil, nil, nil)

# Rigid, driving 8th hats. 
s_hats  = (ring {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, nil)

# The "Picked" Electric Bass (A Minor).
# Plays continuous, driving 8th notes. High cutoff (100) and short release 
# (0.15) mimic an aggressive, picked electric bass driving the rhythm.
s_bass  = (ring {:note => :a1, :cutoff => 100, :release => 0.15}, nil, {:note => :a1, :cutoff => 100, :release => 0.15}, nil, {:note => :a1, :cutoff => 100, :release => 0.15}, nil, {:note => :g1, :cutoff => 100, :release => 0.15}, nil, {:note => :f1, :cutoff => 100, :release => 0.15}, nil, {:note => :f1, :cutoff => 100, :release => 0.15}, nil, {:note => :e1, :cutoff => 100, :release => 0.15}, nil, {:note => :e1, :cutoff => 100, :release => 0.15}, nil)

# Massive, slow-attacking "Brass/String" Chords (Am to F to G).
# Hit on the downbeats. The slow 0.5-beat attack and massive release (2.0) 
# create a soaring, theatrical wall of sound.
s_chords= (ring {:note => [:a3, :c4, :e4], :cutoff => 100, :attack => 0.5, :release => 2.0, :amp => 0.6}, nil, nil, nil, nil, nil, nil, nil, {:note => [:f3, :a3, :c4], :cutoff => 100, :attack => 0.5, :release => 2.0, :amp => 0.6}, nil, nil, nil, nil, nil, nil, nil)

# Piercing, "Electric Guitar" Solo (A Minor Pentatonic).
# Uses :play_fm with a low divisor (2) and extreme depth (5) to create a 
# sharp, buzzy square wave. Routed through the engine's tape echo for a 
# cavernous, stadium-sized smear.
s_fm    = (ring nil, nil, nil, nil, {:note => :a5, :amp => 0.6, :divisor => 2, :depth => 5, :release => 0.3}, nil, {:note => :c6, :amp => 0.5, :divisor => 2, :depth => 5, :release => 0.3}, nil, 
           {:note => :e6, :amp => 0.7, :divisor => 2, :depth => 5, :release => 0.3}, nil, {:note => :c6, :amp => 0.5, :divisor => 2, :depth => 5, :release => 0.3}, nil, 
           {:note => :d6, :amp => 0.6, :divisor => 2, :depth => 5, :release => 0.3}, nil, {:note => :e6, :amp => 0.7, :divisor => 2, :depth => 5, :release => 0.3}, nil)

# Ethereal, "Arena Crowd" texture (Granular Synth).
# Long size (0.4) and low density (1) creates a slow, evolving background 
# texture that sounds like a distant crowd roaring in a massive stadium.
s_grain = (ring {:note => :a3, :buffer => :ambi_choir, :pos => 0.2, :density => 1, :size => 0.4, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil, {:note => :e3, :buffer => :ambi_choir, :pos => 0.5, :density => 1, :size => 0.4, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The March - Just the heavy drums, picked bass, and crowd (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Anthem - Add the massive, soaring brass chords (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Solo - The piercing electric guitar solo drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], [:play_chords, s_chords, 8], 
    [:play_lead, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN STADIUM ROCK]
# 
# 1. FM as a Guitar Solo: Look at `s_fm`. The `:play_fm` synth is given a 
#    `divisor` of `2` and an extreme `depth` of `5`. This harsh harmonic 
#    ratio forces the FM modulator to shatter the carrier wave, creating a 
#    piercing, buzzy square wave that perfectly mimics an electric guitar. 
#    Routed through the global tape echo, the sparse notes cascade across 
#    the empty space, simulating a stadium-sized guitar solo.
#
# 2. The Picked Bass: Look at `s_bass`. The `:play_sub` synth is given a 
#    `cutoff` of `100` and a `release` of `0.15`. This strips away the 
#    sub-frequencies and cuts the note off instantly, turning the detuned 
#    sawtooth into an aggressive, driving "thwack" that perfectly mimics a 
#    picked electric bass guitar driving the rhythm.
#
# 3. Theatrical Weight: Stadium Rock relies on massive, slow-moving harmony. 
#    The `s_chords` sequence uses a slow `attack` (0.5) and massive `release` 
#    (2.0) to blur the chords together into a continuous, soaring wave of 
#    brass-like sound, perfectly anchoring the track's epic, theatrical 
#    atmosphere.
# ==========================================================
