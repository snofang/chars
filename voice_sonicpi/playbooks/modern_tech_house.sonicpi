# ==========================================================
# PLAYBOOK: MODERN TECH HOUSE
# (Pioneered by Fisher, Chris Lake, and Detlef)
# ==========================================================
# [WHY THIS GENRE?]
# Tech House is the mainstream festival sound – rigid 4/4 kick
# with a syncopated "womp" FM bassline, crisp 909 drums, and
# percussive vocal chops. This playbook uses changing FM parameters
# to create a "talking" bassline that locks perfectly with the groove.
# [DNA: 125 BPM, F minor, 4/4 kick, off‑beat hats, syncopated
#  FM bass, staccato chords, plucky FM lead, granular vocal stabs]
# ==========================================================

use_bpm 125

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# ----------------------------------------------------------
# SCORES – Normalized with gen_score – behavior identical to original
# ----------------------------------------------------------

# Driving 4‑on‑the‑floor kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Thick clap on beats 2 and 4
s_clap = gen_score("....x.......x...", [:c4])

# Off‑beat open hats – steps 2,6,10,14
s_hats = gen_score("..x...x...x...x.",
  [{note: :c4, amp: 0.4}, {note: :c4, amp: 0.5},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}])

# "Womp" Tech House bass – syncopated 16ths with changing FM parameters
# Triggers on steps: 0,3,4,6,8,11,12,14 → "x..xx.x.x..xx.x."
bass_data = [
  {note: :f2,  divisor: 2, depth: 4, release: 0.12, amp: 1.0},
  {note: :f2,  divisor: 3, depth: 6, release: 0.12, amp: 0.8},
  {note: :ab2, divisor: 2, depth: 4, release: 0.12, amp: 1.0},
  {note: :c3,  divisor: 4, depth: 8, release: 0.12, amp: 0.8},
  {note: :f2,  divisor: 2, depth: 4, release: 0.12, amp: 1.0},
  {note: :f2,  divisor: 3, depth: 6, release: 0.12, amp: 0.8},
  {note: :eb2, divisor: 2, depth: 4, release: 0.12, amp: 1.0},
  {note: :g2,  divisor: 4, depth: 8, release: 0.12, amp: 0.8}
]
s_bass = gen_score("x..xx.x.x..xx.x.", bass_data)

# Staccato minor chord stabs – only on step 4
s_chords = gen_score("....x...........",
  [{note: [:f3, :ab3, :c4], cutoff: 100, release: 0.15, amp: 0.6}])

# Plucky, echoing top‑line melody – triggers on steps 4,6,12,14
# Pattern: "....x.x.....x.x."
fm_data = [
  {note: :f5,  amp: 0.6, divisor: 3, depth: 2, release: 0.3},
  {note: :c5,  amp: 0.5, divisor: 3, depth: 2, release: 0.3},
  {note: :ab5, amp: 0.6, divisor: 3, depth: 2, release: 0.3},
  {note: :c6,  amp: 0.5, divisor: 3, depth: 2, release: 0.3}
]
s_fm = gen_score("....x.x.....x.x.", fm_data)

# Repetitive festival vocal chop – triggers on steps 4 and 13
# Pattern: "....x........x.."
vocal_data = [
  {note: :f4, buffer: :ambi_choir, pos: 0.2, density: 2, size: 0.03, amp: 0.6},
  {note: :f4, buffer: :ambi_choir, pos: 0.2, density: 2, size: 0.03, amp: 0.6}
]
s_vocal = gen_score("....x........x..", vocal_data)

# ----------------------------------------------------------
# PLAYBOOK – In‑line and readable
# ----------------------------------------------------------
playbook = (ring
  # Scene 1 – The Groove: kick, hats, and womp bass (4 bars)
  [ [:play_kick, s_kick, 4],
    [:play_hats, s_hats, 4],
    [:play_fm, s_bass, 4] ],

  # Scene 2 – The Vibe: add claps and sparse chords (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_hats, s_hats, 8],
    [:play_fm, s_bass, 8],
    [:play_snare, s_clap, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3 – The Drop: plucky melody and vocal chops (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_hats, s_hats, 8],
    [:play_fm, s_bass, 8],
    [:play_snare, s_clap, 8],
    [:play_chords, s_chords, 8],
    [:play_lead, s_fm, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# 1. "Talking" Bass – changing divisor/depth per step reshapes the
#    FM carrier, creating a squelching, syncopated bassline.
# 2. Extreme Sparsity – chords and lead leave huge gaps, making
#    the bass and drums feel tight and punchy.
# 3. Percussive Vocals – granular chops (size 0.03) turn vocals
#    into rhythmic hits that add human energy to the grid.
# ==========================================================
