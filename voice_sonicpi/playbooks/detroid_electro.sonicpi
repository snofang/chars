use_bpm 115

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F Minor - Robotic & Futuristic)
# ==========================================================

# The classic 808 Electro Kick. 
# Hits on step 0, the 'a' of 1 (step 3), the 'and' of 2 (step 6), and beat 3 (step 8).
s_kick  = (ring :c4, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, {:note => :c4, :amp => 0.6}, nil, {:note => :c4, :amp => 1.0}, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil, nil)

# Sharp, dry clap on beats 2 and 4 (steps 4 and 12), with a ghost clap.
s_clap  = (ring nil, nil, nil, nil, :c4, nil, nil, nil, nil, nil, nil, nil, :c4, nil, {:note => :c4, :amp => 0.4}, nil)

# Rigid, rolling 16th hats. The alternating amps create the robotic groove.
s_hats  = (ring {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.2}, 
           {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.2}, 
           {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.2}, 
           {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.2})

# The "Planet Rock" Robotic Bassline. 
# Plays almost every 16th step, alternating notes to create a bouncy sequence.
s_bass  = (ring :f2, nil, :f2, nil, :f2, nil, :ab2, nil, :c3, nil, :c3, nil, :eb2, nil, :f2, nil)

# The 808 Cowbell Melody (F Minor Pentatonic).
# Using :play_fm with high divisor to create a metallic, bell-like tone.
# Routed through the engine's tape echo for that classic space echo smear.
s_fm    = (ring nil, {:note => :f5, :amp => 0.6, :divisor => 4.0, :depth => 1}, nil, nil, nil, {:note => :eb5, :amp => 0.5, :divisor => 4.0, :depth => 1}, nil, nil, nil, {:note => :c5, :amp => 0.6, :divisor => 4.0, :depth => 1}, nil, nil, nil, {:note => :f5, :amp => 0.7, :divisor => 4.0, :depth => 1}, nil, nil)

# Dark, sparse minor synth stabs (F Minor).
s_chords= (ring nil, nil, nil, nil, [:f3, :ab3, :c4], nil, nil, nil, nil, nil, nil, nil, [:eb3, :g3, :bb3], nil, nil, nil)

# Robotic, vocoder-style vocal stutter (Granular Synth)
# High density, small size = percussive, robotic stutter.
s_vocal = (ring nil, nil, nil, nil, nil, nil, nil, nil, {:note => :f4, :buffer => :ambi_choir, :pos => 0.4, :density => 3, :size => 0.04}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the robotic 808 drums and bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_clap, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: Add the dark synth stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The 808 cowbell melody and vocoder vocal drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], 
    [:play_fm, s_fm, 8], [:play_grain, s_vocal, 4] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
