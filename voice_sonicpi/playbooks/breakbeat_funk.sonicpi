# ==========================================================
# PLAYBOOK: BREAKBEAT / BIG BEAT
# Heavy, Aggressive, Breakbeat Energy
# ==========================================================
# [WHY THIS GENRE?]
# Breakbeat / Big Beat (The Prodigy, Fatboy Slim) is built on
# syncopated breakbeat drums, heavy distorted basslines, aggressive
# chord stabs, and chopped vocal shouts. This playbook captures
# that stadium‑sized, high‑energy, dancefloor intensity.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 125 BPM
# Key: E minor (aggressive, dark)
# Rhythm: Syncopated breakbeat kick (1, 'a' of 1, 'and' of 2, beat 4),
# snare on 2/4 with ghost on 'a' of 2, swinging hats with
# velocity layers, distorted bass with varying cutoff, aggressive
# chord stabs on off‑beats, chopped vocal shout.
# Timbre: Punchy kick (bd_haus with accents), heavy snare
# (sn_dolf with dynamics), swinging hats (cymbal_closed with
# amp layers), distorted bass (dsaw, high cutoff, short release),
# aggressive chord stabs (blade), granular vocal shout.
# Arrangement: Drums+Bass (foundation) → Chords (add stabs)
# → Vocal (add shout).
# ==========================================================

use_bpm 125

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Classic syncopated breakbeat kick
s_kick = gen_score("x..x..x..x......",
  [:c4,
   {note: :c4, amp: 0.8},
   {note: :c4, amp: 1.0},
   {note: :c4, amp: 0.6}])

# Heavy snare with ghost on 'a' of 2
s_snare = gen_score("....x..x....x...",
  [{note: :c4, amp: 1.0},
   {note: :c4, amp: 0.4},
   {note: :c4, amp: 1.0}])

# Swinging hats with heavy velocity manipulation
s_hats = gen_score("x.xxx.x.x.xxx.xx",
  [{amp: 0.3}, {amp: 0.4}, {amp: 0.2}, {amp: 0.5},
   {amp: 0.3}, {amp: 0.3}, {amp: 0.4}, {amp: 0.2},
   {amp: 0.5}, {amp: 0.3}, {amp: 0.2}])  # 11 elements match triggers

# Thick distorted bass riff – varying cutoff
s_bass = gen_score("x..x..x.x..x..x.",
  [{note: :e2, cutoff: 120, release: 0.25},
   {note: :e2, cutoff: 130, release: 0.25},
   {note: :g2, cutoff: 110, release: 0.25},
   {note: :e2, cutoff: 120, release: 0.25},
   {note: :d2, cutoff: 100, release: 0.25},
   {note: :e2, cutoff: 90, release: 0.25}])

# Aggressive chord stabs (E minor) on off‑beats
s_chords = gen_score("..x...x...x...x.",
  [[:e3, :g3, :b3],
   [:e3, :g3, :b3],
   [:g3, :b3, :d4],
   [:d3, :fs3, :a3]])

# Chopped vocal shout – percussive grain
s_vocal = gen_score("........x.......",
  [{note: :e4, buffer: :ambi_choir, pos: 0.1, density: 4, size: 0.04}])

# Playbook
playbook = (ring
  # Scene 1: Foundation – Drums + Bass
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4],
    [:play_hats, s_hats, 4], [:play_sub, s_bass, 4] ],

  # Scene 2: Chords – Add Stabs
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3: Vocal – Add Shout
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Syncopated breakbeat: kick on 1, 'a' of 1, 'and' of 2, and
#   beat 4 – the engine's grid locks this aggressive rhythm.
# - Distorted bass: high cutoff (120–130) pushes the dsaw into
#   overdrive, creating a thick, aggressive texture.
# - Swinging hats: heavy velocity layers (0.2–0.5) add a human,
#   rolling feel to the breakbeat.
# - Chopped vocal shout: a short, percussive grain adds a
#   live‑energy, stadium‑size punch.
# ==========================================================
