use_bpm 170

# ==========================================================
# PLAYBOOK: F# Minor Atmospheric Drum & Bass
# ==========================================================
# [WHY THIS GENRE? Atmospheric DnB with deep bass and granular pad]
# [DNA: 170 BPM, F# minor, breakbeat rhythm, sub bass + granular texture, arrangement: intro -> drums -> breakdown]
# ==========================================================

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x.....x...x.....", [:c4])
s_snare = gen_score("....x.......x....", [:c4])
s_hats  = gen_score("xxxxxxxxxxxxxxxx", [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}])
s_bass  = gen_score("x...............", [:fs1])
s_pad   = gen_score("x...............", [:fs3])

# Playbook
playbook = (ring
  [ [:play_grain, s_pad, 4], [:play_sub, s_bass, 4] ],
  [ [:play_grain, s_pad, 8], [:play_sub, s_bass, 8], [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
  [ [:play_grain, s_pad, 4], [:play_sub, s_bass, 4] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Atmospheric DnB relies on sparse kick/snare placement for groove
# - Granular pad creates evolving texture, sustain throughout
# - Alternating hi-hat dynamics add realism and forward motion
# ==========================================================
