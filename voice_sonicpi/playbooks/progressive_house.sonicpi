# ==========================================================
# PLAYBOOK: 2000s PROGRESSIVE HOUSE / PRYDA
# Hypnotic, Driving, Stadium‑Filling Tension
# ==========================================================
# [WHY THIS GENRE?]
# Progressive House (Eric Prydz, deadmau5) relies on a relentless
# 4/4 beat, a rolling 16th‑note bass, and the signature "Pryda
# Pluck"—an echoing FM note with massive gaps for reverb/delay.
# This playbook captures that hypnotic, cascading club energy.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 128 BPM
# Key: F# minor (driving, emotional)
# Rhythm: 4/4 kick, clap on 2/4, off‑beat hats and chords,
# rolling 16th bass, sparse FM plucks with gaps.
# Timbre: Deep rolling bass (dsaw, short release), analog clap
# (snare), off‑beat chords (blade), Pryda pluck (fm, high
# divisor, depth 2), vocal sigh (grain, long size, low density).
# Arrangement: Hypnosis (kick+bass+grain) → Build (add hats+
# claps+chords) → Release (add FM pluck).
# ==========================================================

use_bpm 128

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Relentless 4‑on‑the‑floor kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Deep analog clap on beats 2 and 4
s_clap = gen_score("....x.......x...", [:c4])

# Off‑beat open hats (steps 2, 6, 10, 14)
s_hats = gen_score("..x..x..x..x....",
  [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.4},
   {note: :c4, amp: 0.3}, {note: :c4, amp: 0.4}])

# Rolling 16th‑note bass – short release for pump
bass_notes = [:fs1, :fs1, :fs2, :fs1, :fs1, :fs1, :a1, :a1,
              :a1, :a1, :a2, :a1, :e1, :e1, :d1, :e1]
s_bass = gen_score("xxxxxxxxxxxxxxxx",
  bass_notes.map { |n| {note: n, release: 0.1, cutoff: 80} })

# Sparse off‑beat chord stabs (steps 2, 6, 10, 14)
chord_data = [
  {note: [:fs3, :a3, :c4], cutoff: 100, release: 0.5, amp: 0.5},
  {note: [:a3, :c4, :e4], cutoff: 100, release: 0.5, amp: 0.5},
  {note: [:d3, :fs3, :a3], cutoff: 100, release: 0.5, amp: 0.5},
  {note: [:e3, :g3, :b3], cutoff: 100, release: 0.5, amp: 0.5}
]
s_chords = gen_score("..x..x..x..x....", chord_data)

# Pryda Pluck lead – sparse notes (steps 0,3,6,8,11,14)
fm_data = [
  {note: :fs5, amp: 0.6, divisor: 3, depth: 2, release: 1.0},
  {note: :a5, amp: 0.5, divisor: 3, depth: 2, release: 1.0},
  {note: :c6, amp: 0.6, divisor: 3, depth: 2, release: 1.0},
  {note: :e5, amp: 0.5, divisor: 3, depth: 2, release: 1.0},
  {note: :d5, amp: 0.6, divisor: 3, depth: 2, release: 1.0},
  {note: :fs5, amp: 0.7, divisor: 3, depth: 2, release: 1.0}
]
s_fm = gen_score("x..x..x.x..x..x.", fm_data)

# Ethereal vocal sigh – one hit on step 8
s_grain = gen_score("........x.......",
  [{note: :fs4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.15, amp: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Hypnosis – Kick, Bass, Grain
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4],
    [:play_grain, s_grain, 4] ],

  # Scene 2: Build – Add Hats, Clap, Chords
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8], [:play_hats, s_hats, 8],
    [:play_snare, s_clap, 8], [:play_chords, s_chords, 8] ],

  # Scene 3: Release – Add Pryda Pluck
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8], [:play_hats, s_hats, 8],
    [:play_snare, s_clap, 8], [:play_chords, s_chords, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The Pryda Pluck illusion: only 6 triggers out of 16,
#   but tape echo fills the gaps – massive cascading space.
# - The 16th‑note pump: bass on every step with short release
#   (0.1) creates relentless, sidechain‑like drive.
# - Off‑beat pocket: chords and hats on steps 2,6,10,14
#   lock with the grid, leaving downbeats spacious.
# ==========================================================
