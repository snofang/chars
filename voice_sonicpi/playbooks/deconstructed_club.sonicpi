# ==========================================================
# PLAYBOOK: DECONSTRUCTED CLUB / AVANT-GARDE ELECTRONIC
# Chaotic, Metallic, Hyper‑Digital Sound Design
# ==========================================================
# [WHY THIS GENRE?]
# Deconstructed Club (Arca, SOPHIE) takes familiar club
# elements and shatters them – hyper‑quantized metallic FM
# percussion, massive distorted sub‑bass impacts, and pitch‑
# shifted sugary vocal glitches. This playbook uses extreme
# divisor/depth hashes to turn the FM synth into latex, metal,
# and glass.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 140 BPM
# Key: A minor (chaotic, dark)
# Rhythm: Sparse syncopated kick (1, 'a' of 2, 'e' of 3),
# FM metallic clap, massive sub‑bass impacts, shattered FM
# lead/percussion with morphing timbre, dissonant wide chord
# stabs, hyper‑glitched granular vocal FX.
# Timbre: Sparse kick (bd_haus with accents), FM metallic clap
# (divisor 3/4, depth 5/6), distorted sub‑bass (dsaw, low cutoff,
# long release), morphing FM (changing divisor/depth), razor
# chords (blade, high cutoff, short release), granular vocal
# glitch (ambi_choir, high density, microscopic size).
# Arrangement: Void (bass+clap+FM) → Machine (add kick+chords)
# → Meltdown (add vocal glitch).
# ==========================================================

use_bpm 140

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Sparse syncopated kick (steps 0, 7, 10)
s_kick = gen_score("x......x..x.....",
  [:c4, {note: :c4, amp: 0.6}, {note: :c4, amp: 1.0}])

# Metallic latex clap – FM on steps 4 and 12
s_clap = gen_score("....x.......x...",
  [{note: :c5, amp: 0.7, divisor: 4, depth: 5, release: 0.05},
   {note: :c5, amp: 0.7, divisor: 3, depth: 6, release: 0.05}])

# Massive distorted sub‑bass impacts (steps 0 and 14)
s_bass = gen_score("x.............x.",
  [{note: :a1, release: 1.5, cutoff: 50, amp: 1.2},
   {note: :g1, release: 0.2, cutoff: 120, amp: 1.0}])

# Shattered FM lead/percussion – morphing every hit (steps 0,3,5,8,11,13)
s_fm = gen_score("x..x.x..x..x.x..",
  [{note: :a5, amp: 0.6, divisor: 2, depth: 8, release: 0.05},
   {note: :e4, amp: 0.5, divisor: 4, depth: 3, release: 0.05},
   {note: :c6, amp: 0.7, divisor: 3, depth: 6, release: 0.05},
   {note: :a4, amp: 0.6, divisor: 5, depth: 4, release: 0.05},
   {note: :e5, amp: 0.5, divisor: 2, depth: 8, release: 0.05},
   {note: :g5, amp: 0.6, divisor: 3, depth: 5, release: 0.05}])

# Dissonant wide chord stabs (steps 4 and 12)
s_chords = gen_score("....x.......x...",
  [{note: [:a3, :c4, :eb4, :fs4], cutoff: 130, release: 0.1, amp: 0.5},
   {note: [:g3, :bb3, :db4, :e4], cutoff: 130, release: 0.1, amp: 0.5}])

# Hyper‑glitched sugary vocal FX (steps 2,6,9,13)
s_vocal = gen_score("..x...x..x...x..",
  [{note: :a5, buffer: :ambi_choir, pos: 0.1, density: 5, size: 0.02, amp: 0.6},
   {note: :c4, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.02, amp: 0.5},
   {note: :e5, buffer: :ambi_choir, pos: 0.3, density: 4, size: 0.02, amp: 0.6},
   {note: :a4, buffer: :ambi_choir, pos: 0.4, density: 5, size: 0.02, amp: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Void – Bass, Clap, FM
  [ [:play_sub, s_bass, 4], [:play_fm, s_clap, 4],
    [:play_fm, s_fm, 4] ],

  # Scene 2: Machine – Add Kick and Chords
  [ [:play_sub, s_bass, 8], [:play_fm, s_clap, 8],
    [:play_fm, s_fm, 8], [:play_kick, s_kick, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3: Meltdown – Add Vocal Glitch
  [ [:play_sub, s_bass, 8], [:play_fm, s_clap, 8],
    [:play_fm, s_fm, 8], [:play_kick, s_kick, 8],
    [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - FM as latex and metal: extreme divisor (4) and depth (5/8)
#   shatter the carrier wave into sharp, metallic snaps.
# - Extreme dynamic contrast: massive slow sub‑bass (cutoff 50)
#   against hyper‑quantized high‑pitched FM blips.
# - Micro‑glitched granular: microscopic size (0.02) and high
#   density (5) turn vocals into sugary digital stutters.
# ==========================================================
