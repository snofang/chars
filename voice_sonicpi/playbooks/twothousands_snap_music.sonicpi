# ==========================================================
# PLAYBOOK: 2000s SNAP MUSIC / ATLANTA SNAP
# (Pioneered by Dem Franchize Boys, D4L, and Soulja Boy)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 2000s Snap Music.
# We have explored heavy bass music and complex polyrhythms, but Snap Music 
# is the absolute masterclass in minimalism. Originating in Atlanta, it strips 
# the hip-hop grid down to almost nothing: a finger snap on beats 2 and 4, 
# a deep 808 bass, and a cheap, repetitive FM synth melody. 
#
# This playbook perfectly demonstrates the power of negative space. By leaving 
# 90% of the 16-step grid empty (`nil`), the engine creates a slow, bouncy, 
# and incredibly infectious groove that feels like a packed Atlanta roller rink 
# in 2006.
# ==========================================================

use_bpm 100

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Minor - Minimal, Bouncy, & Repetitive)
# ==========================================================

# Ultra-sparse, syncopated kick. 
# Hits on step 0, the 'and' of 2 (step 6), beat 3 (step 8), and beat 4 (step 12).
# (4 x's, 4 elements)
s_kick = gen_score("x.....x.x...x...", [
  :c4, {note: :c4, amp: 0.8}, :c4, {note: :c4, amp: 1.0}
])

# The "Finger Snap". 
# Uses play_snare pitched UP to :c5 to simulate a tight, high-pitched finger snap.
# (2 x's, 2 elements)
s_snap = gen_score("....x.......x...", [:c5, :c5])

# Rigid, bouncing 8th-note hats.
# (4 x's, 4 elements)
s_hats = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.2}, 
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.2}
])

# Deep, sliding 808 Bass (F# Minor).
# Massive release (0.5) allows the bass to ring out and carry the dark melody.
# (2 x's, 2 elements)
s_bass = gen_score("x.......x.......", [
  {note: :fs1, release: 0.5, cutoff: 70, amp: 1.2}, 
  {note: :c2, release: 0.5, cutoff: 70, amp: 1.0}
])

# Cheap, repetitive "Casio" FM Melody (F# Minor Pentatonic).
# Uses :play_fm with a low divisor (2) and high depth (4) to create a buzzy, 
# cheap keyboard sound that loops hypnotically.
# (4 x's, 4 elements)
s_fm = gen_score("x.......x.......x", [
  {note: :fs4, divisor: 2, depth: 4, release: 0.1, amp: 0.6}, 
  {note: :ab4, divisor: 2, depth: 4, release: 0.1, amp: 0.6}, 
  {note: :c5, divisor: 2, depth: 4, release: 0.1, amp: 0.7}, 
  {note: :ab4, divisor: 2, depth: 4, release: 0.1, amp: 0.6}
])

# Pitched-down, repetitive "Chant" vocal (Granular Synth).
# Using the built-in :ambi_choir sample.
# Low density, medium size = a raw, rhythmic vocal hit.
# (1 x, 1 element)
s_vocal = gen_score("x...............", [
  {note: :fs4, buffer: :ambi_choir, pos: 0.2, density: 2, size: 0.05, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Rink - Just the minimal kick, snaps, and 808 (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snap, 4], [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Groove - Add the bouncing hats and vocal chant (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snap, 8], [:play_sub, s_bass, 8], 
    [:play_hats, s_hats, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drop - The cheap FM melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snap, 8], [:play_sub, s_bass, 8], 
    [:play_hats, s_hats, 8], [:play_grain, s_vocal, 8], [:play_fm, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN MINIMALISM]
# 
# 1. The Pitched Snap: Look at `s_snap`. By passing `:c5` to the `play_snare` 
#    instrument, the engine pitches the snare sample up an octave. This 
#    transforms a heavy snare into a tight, high-pitched finger snap that 
#    defines the Snap Music genre.
#
# 2. Extreme Negative Space: Snap Music relies on what you *don't* play. 
#    80% of the `s_kick`, `s_bass`, and `s_fm` grids are `nil`. The engine 
#    honors these rests perfectly, letting the massive 808 bass ring out 
#    into the void. This creates a slow, bouncy groove that feels incredibly 
#    sparse but undeniably heavy.
#
# 3. Cheap FM Synthesis: The `s_fm` sequence uses `divisor: 2` and `depth: 4`. 
#    This creates a buzzy, aggressive square wave that perfectly mimics the 
#    cheap, preset Casio keyboard melodies used by 2000s Atlanta producers. 
#    The engine's strict 16-step grid ensures this repetitive loop fires with 
#    absolute mathematical precision, creating a hypnotic, earworm effect.
# ==========================================================
