# ==========================================================
# PLAYBOOK: SOCA / POWER SOCA
# (Pioneered by Machel Montano, Bunji Garlin, and Kes)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# Soca is the sound of Trinidad and Tobago's Carnival – fast
# (160 BPM), off‑beat kicks, steel drums, and bouncing energy.
# This playbook uses FM synthesis for steel drum melodies and
# a deep, round sub‑bass to create a festive, high‑energy
# Caribbean groove.
# ==========================================================

use_bpm 160

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores

# Off‑beat kick (steps 2,6,10,14)
s_kick = gen_score("..x...x...x...x.", [:c4])

# Snare on beats 2 and 4 (steps 4,12)
s_snare = gen_score("....x.......x...", [{note: :c4, amp: 0.9}])

# Fast 16th hats with dynamic accents
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2}
])

# Deep sub‑bass on downbeats (steps 0,6,10,14)
s_bass = gen_score("x.....x...x...x.", [
  {note: :a1, release: 0.15, cutoff: 70},
  {note: :a1, release: 0.15, cutoff: 70},
  {note: :c2, release: 0.15, cutoff: 70},
  {note: :g1, release: 0.15, cutoff: 70}
])

# Steel drum melody (even steps)
s_fm = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :a5, amp: 0.6, divisor: 2, depth: 2, release: 0.1},
  {note: :c5, amp: 0.5, divisor: 2, depth: 2, release: 0.1},
  {note: :e5, amp: 0.6, divisor: 2, depth: 2, release: 0.1},
  {note: :a5, amp: 0.5, divisor: 2, depth: 2, release: 0.1},
  {note: :g5, amp: 0.6, divisor: 2, depth: 2, release: 0.1},
  {note: :e5, amp: 0.5, divisor: 2, depth: 2, release: 0.1},
  {note: :d5, amp: 0.6, divisor: 2, depth: 2, release: 0.1},
  {note: :c5, amp: 0.5, divisor: 2, depth: 2, release: 0.1}
])

# Minor chord stabs on off‑beats (steps 2,6,10,14)
s_chords = gen_score("..x...x...x...x.", [
  [:a3, :c4, :e4],
  [:a3, :c4, :e4],
  [:c3, :e3, :g3],
  [:g3, :b3, :d4]
])

# Carnival vocal chant (steps 4,10)
s_vocal = gen_score("....x.....x....", [
  {note: :a4, buffer: :ambi_choir, pos: 0.2, density: 2, size: 0.04, amp: 0.6},
  {note: :c5, buffer: :ambi_choir, pos: 0.4, density: 2, size: 0.04, amp: 0.6}
])

# Playbook
playbook = (ring
  # Scene 1: The Carnival – off‑beat kick, bass, steel drums (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_fm, s_fm, 4] ],
  
  # Scene 2: The Groove – add snares, hats, and chord stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_fm, s_fm, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Drop – vocal chants drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_fm, s_fm, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The kick hits strictly on off‑beats (steps 2,6,10,14) to
#   create the signature Soca “wine and jam” bounce.
# - FM with divisor 2 and depth 2 produces a warm, organic
#   steel drum tone that dances over the relentless rhythm.
# - The sub‑bass uses cutoff 70 and a short release for a
#   round, bouncy low‑end that anchors the fast tempo.
# ==========================================================
