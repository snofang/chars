# ==========================================================
# PLAYBOOK: WITCH HOUSE / DRAG
# (Pioneered by Salem, Crystal Castles, and oOoOO)
# ==========================================================
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose Witch House.
# We have explored fast, rigid genres (Hyperpop, Hardcore) and organic
# genres (Afro House, Dub). Witch House is the sound of the dark web.
# It takes hip-hop aesthetics, slows them down to a glacial, chopped-and-
# screwed tempo (60 BPM), and drowns them in menacing, minor chords,
# eerie textures, and pitched-down, demonic vocal drones.
#
# This playbook perfectly demonstrates how to use extreme time-stretching
# via the Parameter Hashes. The granular engine uses a massive grain 
# `size` (0.5s) to turn a vocal into a monstrous, slurred drone, while 
# the synths use massive attack and release times to create a suffocating,
# horror-movie atmosphere.
# ==========================================================

use_bpm 60

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (C# Minor - Demonic & Ethereal)
# ==========================================================

# "Chopped and Screwed" Kick. 
# Slow, heavy, hits on step 0 and a dragged hit on step 10.
s_kick  = (ring :c4, nil, nil, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 1.2}, nil, nil, nil, nil, nil)

# Massive, echoing snare strictly on beat 3 (step 8).
s_snare = (ring nil, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.9}, nil, nil, nil, nil, nil, nil, nil)

# Very sparse, dragging hi-hats.
s_hats  = (ring {:note => :c4, :amp => 0.2}, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.3}, nil)

# Deep, suffocating Reese Bass. 
# Massive release (3.0) and low cutoff (60) to create a dark drone.
s_bass  = (ring {:note => :cs1, :release => 3.0, :cutoff => 60}, nil, nil, nil, nil, nil, nil, nil, {:note => :fs1, :release => 3.0, :cutoff => 60}, nil, nil, nil, nil, nil, nil, nil)

# Lush, haunting minor chords (C# Minor to F# Minor).
# Hit on the downbeats, but use a massive 2-beat attack so they slowly
# swell into the mix like a ghost.
s_chords= (ring {:note => [:cs3, :e3, :gs3, :b3], :attack => 2.0, :release => 4.0, :amp => 0.7}, nil, nil, nil, nil, nil, nil, nil, {:note => [:fs3, :a3, :cs4, :e4], :attack => 2.0, :release => 4.0, :amp => 0.7}, nil, nil, nil, nil, nil, nil, nil)

# Eerie, high-pitched FM ring (C# Harmonic Minor).
# Uses a high divisor (5) and long release to sound like a distant siren.
s_fm    = (ring nil, nil, nil, nil, nil, nil, nil, nil, {:note => :gs5, :amp => 0.4, :depth => 6, :divisor => 5, :release => 4.0}, nil, nil, nil, nil, nil, nil, nil)

# The "Demonic" Vocal Drone (Granular Synth)
# Pitched DOWN to :cs3. Massive grain size (0.5s) and low density (1).
# This time-stretches the vocal into an unrecognizable, slurred monster.
s_vocal = (ring {:note => :cs3, :buffer => :ambi_choir, :pos => 0.1, :density => 1, :size => 0.5, :amp => 0.6}, nil, nil, nil, nil, nil, nil, nil, {:note => :fs3, :buffer => :ambi_choir, :pos => 0.4, :density => 1, :size => 0.5, :amp => 0.6}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Ritual - Just the haunting chords and demonic vocal (4 bars)
  [ [:play_chords, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Summoning - Add the dragging drums and deep Reese (8 bars)
  [ [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8] ],
    
  # Scene 3: The Apparition - The eerie FM siren drops (8 bars)
  [ [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN DARKNESS]
# 
# 1. Granular Time-Stretching: Look at `s_vocal`. The granular engine 
#    is given a `size` of `0.5` (500 milliseconds) and a `density` of `1`.
#    This is 10x longer than the glitchy stutters we used in Hyperpop.
#    By pitching the vocal down to `:cs3` and using massive grains, the 
#    engine time-stretches the sample into a terrifying, demonic slur 
#    that defines the Witch House aesthetic.
#
# 2. Data-Driven Swells: Look at `s_chords`. The Hashes specify an 
#    `attack` of `2.0` and a `release` of `4.0`. Because the BPM is 60, 
#    it takes two whole beats for the chord to fade in, and four beats 
#    to fade out. The engine reads these Hashes and turns the normally 
#    sharp `:blade` synth into a slow, suffocating ghost.
#
# 3. The Power of the Void: 90% of this grid is `nil`. By leaving the 
#    16-step grid almost entirely empty, the track moves at a glacial 
#    pace. The engine's strict master clock ensures the massive gaps 
#    between the kicks and snares are perfectly timed, letting the reverb 
#    tails and Reese bass ring out into infinity.
# ==========================================================
