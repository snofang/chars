# ==========================================================
# PLAYBOOK: 80s SOPHISTI-POP / LATE-NIGHT JAZZ-POP
# (Pioneered by Sade, The Blue Nile, and Roxy Music)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 80s Sophisti-Pop.
# We have explored Synthpop and New Romantic, but Sophisti-Pop is the 
# sound of high-end 80s luxury. It fuses clean, pristine LinnDrum beats 
# with deep, melodic fretless bass, lush, jazzy electric piano chords, 
# and smooth, echoing clean guitar arpeggios. 
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create a laid-back, elegant, and deeply atmospheric groove. By using 
# slow `attack` times on the chords and a high `cutoff` on the bass, the 
# engine creates a pristine, late-night jazz-club atmosphere.
# ==========================================================

use_bpm 95

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Major - Smooth, Pristine, & Jazzy)
# ==========================================================

# Pristine, laid-back LinnDrum kick. Hits on 1, the 'and' of 2, and 3.
s_kick = gen_score("x.....x.x.......", [:c4, {note: :c4, amp: 0.8}, :c4])

# Crisp, organic snare/rimshot strictly on beats 2 and 4.
s_snare = gen_score("....x.......x...", [:c4])

# Rigid, ticking 8th hats. 
s_hats = gen_score("x.x.x.x.x.x.x.x.", [{note: :c4, amp: 0.2}, {note: :c4, amp: 0.1}])

# The "Fretless" Melodic Bass (D Major).
# Plays a slow, melodic line. Mid cutoff (90) and medium release (0.3) 
# mimic the warm, gliding tone of a fretless electric bass.
bass_notes = [:d2, :d2, :e2, :f2, :a2, :a2, :g2, :f2]
bass_data = bass_notes.map { |n| {note: n, cutoff: 90, release: 0.3, amp: 1.0} }
s_bass = gen_score("x...x.x.x.x.....", bass_data)

# Lush, "Electric Piano" Chords (Dmaj9 to Gmaj9).
# Hit on the downbeats. The slow 0.5-beat attack and massive 2.0-beat release 
# blur the chords together into a continuous, warm wave.
s_chords = gen_score("x.......x.......", [
  {note: [:d3, :fs3, :a3, :e4], cutoff: 80, attack: 0.5, release: 2.0, amp: 0.5},
  {note: [:g2, :b2, :d3, :a3], cutoff: 80, attack: 0.5, release: 2.0, amp: 0.5}
])

# Clean, "Chiming" Guitar Arpeggio (D Major).
# Uses :play_fm with a high divisor (3) and low depth (2) to create a clean, 
# glassy guitar tone. Routed through the engine's tape echo for a smear.
guitar_notes = [:d4, :a4, :d5, :fs5, :a4, :d5, :fs5, :a5]
guitar_data = guitar_notes.map { |n| {note: n, amp: 0.5, divisor: 3, depth: 2, release: 0.3} }
s_guitar = gen_score("x..x..x..x..x..x", guitar_data)

# Ethereal, "Saxophone" Lead (D Major Pentatonic).
# Uses :play_fm with a low divisor (2) and low depth (2) to create a warm, 
# brassy tone that mimics a smooth saxophone. Routed through the tape echo.
lead_notes = [:d5, :e5, :fs5, :a5, :g5, :e5, :d5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 2, release: 0.8} }
s_lead = gen_score("x..x..x..x..x...", lead_data)

# Soft, ambient "String" drone (Granular Synth).
# Long size (0.3) and low density (1) creates a slow, evolving background 
# texture that sounds like a lush string section.
s_grain = gen_score("x...............", [
  {note: :d4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.3, amp: 0.4}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Vibe - Just the fretless bass, EP chords, and guitar (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_fm, s_guitar, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Groove - Add the pristine LinnDrum beat (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_fm, s_guitar, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Solo - The smooth saxophone lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_fm, s_guitar, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN ELEGANT POP]
# 
# 1. The Fretless Bass: Look at `s_bass`. The `:play_sub` synth is given a 
#    `cutoff` of `90` and a `release` of `0.3`. This strips away the 
#    sub-frequencies and lets the note ring out slightly, perfectly 
#    mimicking the warm, gliding tone of a fretless electric bass driving 
#    a slow, melodic line.
#
# 2. Swelling Electric Piano: Look at `s_chords`. The Hashes specify an 
#    `attack` of `0.5` and a `release` of `2.0`. Because the engine reads 
#    these Hashes, the chords don't just hit; they slowly swell into the mix 
#    and fade away, creating a continuous, blurred wave of lush harmony that 
#    perfectly mimics a Fender Rhodes electric piano.
#
# 3. FM as a Saxophone: The `s_lead` sequence uses `divisor: 2` and `depth: 2`. 
#    This gentle harmonic ratio produces a warm, brassy tone that mimics a 
#    smooth saxophone. Routed through the engine's tape echo, the sparse notes 
#    cascade across the empty space, perfectly anchoring the track's late-night, 
#    luxurious atmosphere.
# ==========================================================
