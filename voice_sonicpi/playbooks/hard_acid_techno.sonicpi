# ==========================================================
# PLAYBOOK: HARD ACID TECHNO
# (Pioneered by Hardfloor, Plastikman, and Luke Slater)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose Hard Acid Techno.
# We have explored Acid House (which is bouncy and 128 BPM) and Minimal 
# Techno (which is sparse and clinical). Hard Acid Techno is the absolute 
# extreme of the 303. It pushes the tempo to 140 BPM, relying on relentless 
# 909 drums, a continuous 16th-note bassline, and extreme, data-driven 
# filter sweeps that sound like a machine gun.
#
# This playbook perfectly demonstrates how to push the Parameter Hashes 
# to their absolute limit. By playing continuous 16th notes and rapidly 
# cycling the `cutoff` Hash from 80 to 110 and back, the engine forces 
# the `:play_sub` synth to "squelch" relentlessly, creating that signature 
# hypnotic, aggressive 303 acid line.
# ==========================================================

use_bpm 140

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Relentless, Squelchy, & Driving)
# ==========================================================

# Relentless, heavy 909-style 4/4 kick.
s_kick  = (ring :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil)

# Heavy, dry 909 snare strictly on beats 2 and 4 (steps 4 and 12).
s_snare = (ring nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil)

# Rigid, off-beat open hats to drive the momentum.
s_hats  = (ring nil, nil, {:note => :c4, :amp => 0.4}, nil, nil, nil, {:note => :c4, :amp => 0.3}, nil, nil, nil, {:note => :c4, :amp => 0.4}, nil, nil, nil, {:note => :c4, :amp => 0.3}, nil)

# The "Acid 303" Bassline (A Minor).
# Plays continuous 16th notes. The 'cutoff' Hash rapidly cycles from 80 
# to 110 and back down, simulating the squelching filter envelope of a 
# Roland TB-303.
s_bass  = (ring {:note => :a1, :cutoff => 80}, {:note => :a1, :cutoff => 90}, {:note => :a2, :cutoff => 100}, {:note => :a1, :cutoff => 110}, 
           {:note => :a1, :cutoff => 80}, {:note => :a1, :cutoff => 90}, {:note => :e1, :cutoff => 100}, {:note => :a1, :cutoff => 110}, 
           {:note => :a1, :cutoff => 80}, {:note => :a1, :cutoff => 90}, {:note => :a2, :cutoff => 100}, {:note => :a1, :cutoff => 110}, 
           {:note => :g1, :cutoff => 80}, {:note => :g1, :cutoff => 90}, {:note => :e1, :cutoff => 100}, {:note => :a1, :cutoff => 110})

# Stark, minor chord stabs (Am to Gm).
# Hit sparingly on the off-beats to leave maximum room for the acid bass.
s_chords= (ring nil, nil, nil, nil, [:a3, :c4, :e4], nil, nil, nil, nil, nil, nil, nil, [:g3, :bb3, :d4], nil, nil, nil)

# Piercing, bleepy FM "Rave" Lead (A Minor Pentatonic).
# Uses :play_fm with a high divisor (3) and extreme depth (5) to create 
# a sharp, robotic square wave that cuts through the heavy 303 bass.
s_fm    = (ring {:note => :a5, :amp => 0.6, :divisor => 3, :depth => 5, :release => 0.05}, nil, {:note => :e5, :amp => 0.5, :divisor => 3, :depth => 5, :release => 0.05}, nil, 
           {:note => :c6, :amp => 0.6, :divisor => 3, :depth => 5, :release => 0.05}, nil, {:note => :e6, :amp => 0.5, :divisor => 3, :depth => 5, :release => 0.05}, nil, 
           {:note => :a5, :amp => 0.6, :divisor => 3, :depth => 5, :release => 0.05}, nil, {:note => :g5, :amp => 0.5, :divisor => 3, :depth => 5, :release => 0.05}, nil, 
           {:note => :e5, :amp => 0.6, :divisor => 3, :depth => 5, :release => 0.05}, nil, {:note => :a5, :amp => 0.7, :divisor => 3, :depth => 5, :release => 0.05}, nil)

# Metallic, granular texture (using :elec_piano).
# High density, tiny size = industrial, machine-like static.
s_grain = (ring {:note => :a3, :buffer => :elec_piano, :pos => 0.8, :density => 4, :size => 0.02, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil, {:note => :a3, :buffer => :elec_piano, :pos => 0.8, :density => 4, :size => 0.02, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Machine - Just the relentless kick and acid bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Factory - Add the 909 drums, hats, and stark chords (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], 
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Meltdown - The piercing FM lead and granular static drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], 
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8], 
    [:play_lead, s_fm, 8], [:play_grain, s_grain, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN THE ACID SQUELCH]
# 
# 1. Data-Driven 303: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step at 140 BPM. The `cutoff` Hash rapidly cycles 
#    from 80 to 110 and back down over 4 steps. Because the engine reads 
#    these Hashes independently, the filter opens and closes frantically, 
#    perfectly mimicking the squelching filter envelope of a Roland TB-303 
#    without needing a dedicated 303 oscillator.
#
# 2. Relentless 16th-Note Drive: Hard Acid Techno relies on continuous 
#    motion. The `s_bass` never stops. The engine's strict master clock 
#    ensures this 16-note sequence fires with absolute mathematical 
#    precision, creating a relentless, hypnotic pulse that drives the 
#    track forward unstoppably.
#
# 3. Extreme FM Bleeps: The `s_fm` sequence uses `divisor: 3` and an extreme 
#    `depth` of `5`. This harsh harmonic ratio forces the FM synth to produce 
#    a piercing, robotic square wave that cuts through the heavy 303 bassline, 
#    perfectly mimicking the bleepy synth leads of 90s underground rave music.
# ==========================================================
