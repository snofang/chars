# ==========================================================
# PLAYBOOK: LADY GAGA - "BAD ROMANCE" (2009)
# ==========================================================

use_bpm 119

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Dark, Driving, & Theatrical)
# ==========================================================

# Relentless, driving 4/4 dance-pop kick. (4 x's, 1 element)
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, echoing snare strictly on beats 2 and 4. (2 x's, 1 element)
s_snare = gen_score("....x.......x...", [:c4])

# Rigid, driving 16th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Dark" Synth Bass (A Minor).
# Plays a driving, syncopated line. High cutoff (100) and short release (0.1) 
# create a relentless, buzzing churn. (6 x's, 6 elements)
s_bass = gen_score("x..x.x..x..x.x..", [
  {note: :a1, release: 0.1, cutoff: 100, amp: 1.0}, 
  {note: :a1, release: 0.1, cutoff: 100, amp: 0.8}, 
  {note: :g1, release: 0.1, cutoff: 100, amp: 1.0}, 
  {note: :a1, release: 0.1, cutoff: 100, amp: 0.8}, 
  {note: :f1, release: 0.1, cutoff: 100, amp: 1.0}, 
  {note: :e1, release: 0.1, cutoff: 100, amp: 0.8}
])

# Massive, "Cinematic String" Stabs (Am to F to C to G).
# Uses :play_fm with a low divisor (2) and mid depth (4) to create a harsh, 
# brassy, staccato hit. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:a3, :c4, :e4], divisor: 2, depth: 4, release: 0.15, amp: 0.6},
  {note: [:f3, :a3, :c4], divisor: 2, depth: 4, release: 0.15, amp: 0.6},
  {note: [:c3, :e3, :g3], divisor: 2, depth: 4, release: 0.15, amp: 0.6},
  {note: [:g3, :bb3, :d4], divisor: 2, depth: 4, release: 0.15, amp: 0.6}
])

# Piercing, "Catchy" Synth Lead (A Minor Pentatonic).
# Uses :play_fm with a low divisor (2) and mid depth (3) to create a sharp, 
# buzzy square wave. Routed through the global tape echo. (8 x's, 8 elements)
lead_notes = [:a4, :c5, :e5, :a5, :g5, :e5, :c5, :a4]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 3, release: 0.1} }
s_lead = gen_score("x.x.x.x.x.x.x.x.", lead_data)

# "Rah, rah" Vocal Stutter (Granular Synth).
# Using the built-in :ambi_choir sample.
# High density, tiny size = a sharp, percussive, repetitive vocal skip. (4 x's, 4 elements)
s_vocal = gen_score("x...x...x...x...", [
  {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.7},
  {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.7},
  {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.7},
  {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the dark bass, string stabs, and "Rah rah" vocals (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Verse - Add the driving 4/4 dance drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chorus - The catchy synth lead melody drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN DARK POP]
# 
# 1. The "Rah rah" Stutter: Look at `s_vocal`. The granular engine is given 
#    a high `density` (3) and a tiny `size` (0.04). By pitching the grains 
#    to `:a4` and scattering them on a rigid 4-step pattern, the engine turns 
#    the `:ambi_choir` sample into a sharp, percussive, rhythmic vocal skip 
#    that perfectly mimics the iconic, stuttering hook of "Bad Romance".
#
# 2. The Dark Synth Bass: Look at `s_bass`. The `:play_sub` synth plays a 
#    syncopated, driving line. By using a high `cutoff` (100) and a short 
#    `release` (0.1), the engine turns the detuned sawtooth into a relentless, 
#    buzzing churn that perfectly anchors the track's dark, danceable energy.
#
# 3. The Cinematic Stabs: Look at `s_chords`. The `:play_fm` synth is given 
#    a `divisor` of `2` and a `depth` of `4`, with a microscopic `release` 
#    (0.15). This forces the FM synth to produce a harsh, brassy, staccato 
#    "hit" that perfectly mimics the massive, orchestral string section stabs 
#    that define the song's theatrical chorus.
# ==========================================================
