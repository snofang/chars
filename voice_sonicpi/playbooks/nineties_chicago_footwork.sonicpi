# ==========================================================
# PLAYBOOK: 90s CHICAGO FOOTWORK / JUKE
# (Pioneered by DJ Rashad, RP Boo, and DJ Spinn)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Chicago Footwork.
# We have explored Atlanta Trap and Miami Bass, but Footwork is the sound 
# of the Chicago underground. It pushes the tempo to a frantic 160 BPM and 
# relies on a highly specific, "skipping" syncopated drum pattern. It fuses 
# massive, round 808 sub-bass with rapid, chopped R&B vocal samples and 
# frantic, skittering hi-hats designed to accompany a highly physical, 
# fast-paced dance style.
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create a complex, "skipping" groove. By using the `gen_score` helper 
# to map out intricate, overlapping kick and snare hits, the engine 
# creates a frantic, kinetic, and deeply rhythmic atmosphere.
# ==========================================================

use_bpm 160

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Minor - Frantic, Skittering, & Bouncy)
# ==========================================================

# The "Footwork" Kick. 
# A highly syncopated, skipping pattern. (5 x's, 5 elements)
s_kick = gen_score("x..x...x.x..x...", [
  :c4, {note: :c4, amp: 0.8}, :c4, {note: :c4, amp: 0.7}, :c4
])

# Crisp, 808 snare/clap on beats 2 and 4, with a ghost note. (3 x's, 3 elements)
s_snare = gen_score("....x.......x.x.", [
  :c4, {note: :c4, amp: 0.9}, {note: :c4, amp: 0.3}
])

# Frantic, skittering 16th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# Deep, massive 808 Sub-Bass (F# Minor).
# Massive release (2.0) and low cutoff (50) create a deep, continuous rumble. (2 x's, 2 elements)
s_bass = gen_score("x.......x.......", [
  {note: :fs1, release: 2.0, cutoff: 50, amp: 1.2}, 
  {note: :a1, release: 2.0, cutoff: 50, amp: 1.0}
])

# Stark, "Synth String" Stabs (F#m to Am).
# Hit strictly on the off-beats. High cutoff (100) and short release (0.15) 
# create a sharp, staccato wall of sound. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:fs3, :a3, :cs4], cutoff: 100, release: 0.15, amp: 0.5},
  {note: [:fs3, :a3, :cs4], cutoff: 100, release: 0.15, amp: 0.5},
  {note: [:a3, :c4, :e4], cutoff: 100, release: 0.15, amp: 0.5},
  {note: [:a3, :c4, :e4], cutoff: 100, release: 0.15, amp: 0.5}
])

# Piercing, "Rave" FM Bleeps (F# Minor Pentatonic).
# Uses :play_fm with a high divisor (4) and low depth (2) to create a piercing, 
# glassy tone. (8 x's, 8 elements)
lead_notes = [:fs5, :cs5, :a5, :fs5, :e5, :cs5, :a4, :fs5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 4, depth: 2, release: 0.08} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# Chopped, "R&B" Vocal Stutter (Granular Synth).
# High density (3) and tiny size (0.04) shatter the vocal into a rhythmic skip. (1 x, 1 element)
s_vocal = gen_score("........x.......", [
  {note: :fs4, buffer: :misc_lori, pos: 0.3, density: 3, size: 0.04, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Skip - Just the frantic drums and sub-bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Vibe - Add the synth stabs and vocal chops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drop - The piercing rave FM bleeps drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN KINETIC RHYTHM]
# 
# 1. The Skipping Syncopation: Look at `s_kick`. It completely avoids landing 
#    on a standard 4/4 pulse. By hitting on syncopated, "skipping" steps 
#    (0, 3, 7, 9, 12), the engine creates a lopsided, frantic groove that 
#    feels like a dancer rapidly shifting their weight. The engine's strict 
#    master clock ensures this complex rhythm lands with absolute precision.
#
# 2. Subterranean Weight: Look at `s_bass`. The `:play_sub` synth is given a 
#    massive `release` of `2.0` (two whole beats) and an extreme low `cutoff` 
#    of `50`. This creates a deep, continuous rumble that anchors the erratic, 
#    skittering drums, perfectly mimicking the massive 808 bass of Chicago 
#    Footwork.
#
# 3. Micro-Glitched Vocals: Look at `s_vocal`. The granular engine is given a 
#    high `density` (3) and a tiny `size` (0.04). By scattering the grains, 
#    the engine turns the vocal into a sharp, skipping stutter that sounds 
#    like a DJ rapidly chopping an R&B acapella on a drum machine.
# ==========================================================
