# ==========================================================
# PLAYBOOK: 90s GABBER / UPTempo HARDCORE
# (Pioneered by Paul Elstak, Neophyte, and Angerfist)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# Gabber is the absolute limit of the 16‑step grid – 200 BPM
# with 16th notes at 75 ms. It uses a distorted 4/4 kick,
# off‑beat "bumping" bass, and frantic chip‑tune arpeggios
# to create a relentless freight‑train effect.
# ==========================================================

use_bpm 200

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x...x...x...x...", [{note: :c4, amp: 1.5}])

s_clap  = gen_score("....x.......x...", [{note: :c4, amp: 0.8}])

s_hats  = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.3}
])

s_bass  = gen_score("..x...x...x...x.", [{note: :a1, release: 0.1}])

s_chords = gen_score("..x...x...x...x.", [
  [:a3, :c4, :e4],
  [:a3, :c4, :e4],
  [:g3, :bb3, :d4],
  [:f3, :a3, :c4]
])

s_fm    = gen_score("xxxxxxxxxxxxxxxx", [
  {note: :a5, amp: 0.6, divisor: 2, depth: 4, release: 0.05},
  {note: :e5, amp: 0.5, divisor: 2, depth: 4, release: 0.05},
  {note: :c6, amp: 0.6, divisor: 2, depth: 4, release: 0.05},
  {note: :e6, amp: 0.5, divisor: 2, depth: 4, release: 0.05},
  {note: :a5, amp: 0.6, divisor: 2, depth: 4, release: 0.05},
  {note: :e5, amp: 0.5, divisor: 2, depth: 4, release: 0.05},
  {note: :c6, amp: 0.6, divisor: 2, depth: 4, release: 0.05},
  {note: :e6, amp: 0.5, divisor: 2, depth: 4, release: 0.05},
  {note: :g5, amp: 0.6, divisor: 2, depth: 4, release: 0.05},
  {note: :d5, amp: 0.5, divisor: 2, depth: 4, release: 0.05},
  {note: :bb5, amp: 0.6, divisor: 2, depth: 4, release: 0.05},
  {note: :d6, amp: 0.5, divisor: 2, depth: 4, release: 0.05},
  {note: :f5, amp: 0.6, divisor: 2, depth: 4, release: 0.05},
  {note: :c5, amp: 0.5, divisor: 2, depth: 4, release: 0.05},
  {note: :a5, amp: 0.6, divisor: 2, depth: 4, release: 0.05},
  {note: :c6, amp: 0.5, divisor: 2, depth: 4, release: 0.05}
])

s_vocal = gen_score("....x.......x...", [
  {note: :a4, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.02, amp: 0.6},
  {note: :c5, buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.02, amp: 0.6}
])

# Playbook
playbook = (ring
  # Scene 1: The Freight Train – kick and bumping bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Rave – add claps, hats, and off‑beat stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8],
    [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Meltdown – frantic FM arpeggio and vocal stutter (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8],
    [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8],
    [:play_lead, s_fm, 8], [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The FM arpeggio fires every 16th step at 200 BPM (every
#   75 ms), creating a buzzing chip‑tune blur.
# - Bass and chords hit on off‑beats (steps 2,6,10,14) to
#   lock with the kick, producing the classic "boom‑cha" bounce.
# - The kick uses amp 1.5 to push the internal limiter into
#   natural distortion, simulating a massive rave stack.
# ==========================================================
