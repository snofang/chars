# ==========================================================
# PLAYBOOK: AFRO HOUSE / TRIBAL HOUSE
# Deep, Warm, Soulful, Polyrhythmic
# ==========================================================
# [WHY THIS GENRE?]
# Afro House (Black Coffee, Keinemusik) softens the 4/4 grid
# with warm sub‑bass, organic polyrhythmic shakers, soulful
# jazzy chords, and kalimba/marimba melodies. This playbook
# captures that hypnotic, sun‑drenched dancefloor vibe.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 120 BPM
# Key: F minor (deep, soulful)
# Rhythm: Soft 4/4 kick, clap on 2/4, polyrhythmic shaker
# with dynamic amplitudes, melodic sub‑bass, off‑beat
# minor 9th chords, kalimba/marimba arpeggios, ambient
# vocal chop.
# Timbre: Warm kick (bd_haus), organic clap (sn_dolf),
# dynamic shaker (cymbal_closed with varying amp),
# round sub‑bass (dsaw, long release), soulful chords
# (blade), FM kalimba (divisor 3, depth 2), granular
# vocal smear (ambi_choir, low density, medium size).
# Arrangement: Foundation (kick+shaker+bass) → Groove
# (add clap+chords) → Texture (add kalimba+vocal).
# ==========================================================

use_bpm 120

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Soft 4‑on‑the‑floor kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Organic clap on beats 2 and 4
s_clap = gen_score("....x.......x...", [:c4])

# Polyrhythmic shaker – dynamic amplitudes for human swing
s_hats = gen_score("x.x.xx.xx.xx.xx.",
  [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.4},
   {note: :c4, amp: 0.2}, {note: :c4, amp: 0.5},
   {note: :c4, amp: 0.3}, {note: :c4, amp: 0.4},
   {note: :c4, amp: 0.2}, {note: :c4, amp: 0.5},
   {note: :c4, amp: 0.3}, {note: :c4, amp: 0.4}])

# Round sub‑bass – melodic anchor with long release
s_bass = gen_score("x......xx..x....",
  [{note: :f1, release: 0.5}, {note: :f1, release: 0.5},
   {note: :ab1, release: 0.5}, {note: :c2, release: 0.5}])

# Soulful minor 9th chords on off‑beats (steps 2,6,10,14)
s_chords = gen_score("..x...x...x...x.",
  [[:f3, :ab3, :c4, :eb4], [:f3, :ab3, :c4, :eb4],
   [:ab3, :c4, :eb4, :gb4], [:eb3, :g3, :bb3, :db4]])

# Kalimba/marimba melody – hollow, wooden bell tone
s_fm = gen_score("x..x.x...x.x....",
  [{note: :f5, amp: 0.6, depth: 2, divisor: 3, release: 0.5},
   {note: :ab5, amp: 0.5, depth: 2, divisor: 3, release: 0.5},
   {note: :c6, amp: 0.7, depth: 2, divisor: 3, release: 0.5},
   {note: :ab5, amp: 0.5, depth: 2, divisor: 3, release: 0.5},
   {note: :f5, amp: 0.6, depth: 2, divisor: 3, release: 0.5}])

# Ambient vocal smear – smooth, distant chop
s_vocal = gen_score("....x...........",
  [{note: :f4, buffer: :ambi_choir, pos: 0.3, density: 2, size: 0.1, amp: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Foundation – Kick, Shaker, Bass
  [ [:play_kick, s_kick, 4], [:play_hats, s_hats, 4],
    [:play_sub, s_bass, 4] ],

  # Scene 2: Groove – Add Clap and Chords
  [ [:play_kick, s_kick, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_snare, s_clap, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3: Texture – Add Kalimba and Vocal
  [ [:play_kick, s_kick, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_snare, s_clap, 8],
    [:play_chords, s_chords, 8], [:play_fm, s_fm, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The dynamic shaker: varying amplitudes (0.2–0.5) across
#   10 out of 16 steps creates a human, polyrhythmic swing.
# - FM as wood: divisor 3 and depth 2 produce a hollow,
#   woody thunk – perfect for kalimba/marimba textures.
# - Harmonic space: bass and chords hit on separate grid
#   steps, avoiding clash and leaving room for warmth.
# - Granular vocal smear: low density and medium size create
#   a distant, soulful texture that floats above the groove.
# ==========================================================
