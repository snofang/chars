# ==========================================================
# PLAYBOOK: 90s NEO‑SOUL / R&B
# (Pioneered by D’Angelo, Erykah Badu, and Maxwell)
# ==========================================================
# 
# [WHY THIS GENRE?]
# Neo‑Soul is the opposite of mechanical – it uses extreme
# “behind‑the‑beat” swing, deep round bass, and lush minor 11th
# chords to create a lazy, head‑nodding groove that feels deeply
# human, smoky, and late‑night.
# ==========================================================

use_bpm 85

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x.....x..x..x..", [
  :c4,
  {note: :c4, amp: 0.7},
  {note: :c4, amp: 1.0},
  {note: :c4, amp: 0.5}
])

s_snare = gen_score("....x..x....x..x", [
  :c4,
  {note: :c4, amp: 0.3},
  :c4,
  {note: :c4, amp: 0.3}
])

s_hats  = gen_score("x.xx.x.xx.xx.x.x", [
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.15},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.15},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4}
])

s_bass  = gen_score("x.....x..x.....x", [
  {note: :e2, release: 0.4, cutoff: 65},
  {note: :e2, release: 0.4, cutoff: 65},
  {note: :g2, release: 0.4, cutoff: 65},
  {note: :b1, release: 0.4, cutoff: 65}
])

s_chords = gen_score("x.....x......x..", [
  {note: [:e3, :g3, :b3, :d4], cutoff: 85, release: 0.8, amp: 0.6},
  {note: [:a3, :c4, :e4, :g4], cutoff: 85, release: 0.8, amp: 0.6},
  {note: [:b3, :d4, :fs4, :a4], cutoff: 85, release: 0.8, amp: 0.6}
])

s_fm    = gen_score("....x.....x.....", [
  {note: :b4, amp: 0.5, divisor: 3, depth: 1, release: 1.0},
  {note: :g4, amp: 0.4, divisor: 3, depth: 1, release: 1.0}
])

s_grain = gen_score("x...............", [
  {note: :e4, buffer: :ambi_choir, pos: 0.5, density: 1, size: 0.15, amp: 0.5}
])

# Playbook
playbook = (ring
  # Scene 1: The Vibe – lazy drums, bass, and smoky chords (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4],
    [:play_sub, s_bass, 4], [:play_chords, s_chords, 4] ],
  
  # Scene 2: The Groove – add vocal texture and let it breathe (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8] ],
    
  # Scene 3: The Solo – echoing Wurlitzer melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8],
    [:play_fm, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The kick avoids beat 2 (step 4) and lands late on 6 and 10,
#   creating a signature “Dilla” swing behind the beat.
# - Chords use low cutoff (85) to sound like a warm, muffled
#   Rhodes piano in a dimly lit jazz club.
# - Bass and melody leave generous rests, letting the tape echo
#   rings fill the space for an organic, soulful pocket.
# ==========================================================
