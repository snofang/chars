# ==========================================================
# PLAYBOOK: 90s NEO-SOUL / R&B
# (Pioneered by D'Angelo, Erykah Badu, and Maxwell)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Neo-Soul.
# We just explored 70s Disco and 200 BPM Gabber. Neo-Soul is the exact 
# opposite of mechanical. It is the sound of pure, organic "feel." It 
# takes the hip-hop drum grid but plays it with extreme "behind-the-beat" 
# swing, using deep, round sub-bass and lush, jazzy minor 11th chords.
#
# This playbook perfectly demonstrates how to simulate a live R&B band 
# on a rigid 16-step sequencer. By heavily manipulating the amplitude 
# Hashes and leaving specific gaps (`nil`), the engine creates a lazy, 
# head-nodding groove that feels deeply human, smoky, and late-night.
# ==========================================================

use_bpm 85

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (E Minor - Jazzy, Warm, & Soulful)
# ==========================================================

# The "Laid-Back" Kick. 
# Hits on step 0, the 'and' of 2 (step 6), and beat 3 (step 10).
# Notice the ghost kicks (amp 0.5) that fill the gaps like a live drummer.
s_kick  = (ring :c4, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.7}, nil, nil, nil, {:note => :c4, :amp => 1.0}, nil, nil, {:note => :c4, :amp => 0.5}, nil, nil)

# Crisp, live snare strictly on beats 2 and 4 (steps 4 and 12), 
# with a ghost snare on the 'a' of 2 (step 7) and 'a' of 4 (step 15).
s_snare = (ring nil, nil, nil, nil, {:note => :c4, :amp => 0.9}, nil, nil, {:note => :c4, :amp => 0.3}, nil, nil, nil, nil, {:note => :c4, :amp => 0.9}, nil, {:note => :c4, :amp => 0.3}, nil)

# Swung, lazy 16th hats. 
# Notice the heavy amplitude manipulation (0.2 to 0.4) to simulate a 
# human drummer playing with dynamics.
s_hats  = (ring {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.15}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.15}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.4})

# Deep, round sub-bass (E Minor).
# Walks a slow, melodic line. Very low cutoff (65) and medium release 
# (0.4) to create a warm, muffled undercurrent.
s_bass  = (ring {:note => :e2, :release => 0.4, :cutoff => 65}, nil, nil, nil, nil, nil, {:note => :e2, :release => 0.4, :cutoff => 65}, nil, nil, {:note => :g2, :release => 0.4, :cutoff => 65}, nil, nil, nil, nil, nil, {:note => :b1, :release => 0.4, :cutoff => 65})

# Lush, jazzy minor 11th chords (Em11 to Am11 to Bm7).
# Hit on the downbeats and the 'and' of 3. The low cutoff (85) gives 
# them that classic warm, "Rhodes electric piano" feel.
s_chords= (ring {:note => [:e3, :g3, :b3, :d4], :cutoff => 85, :release => 0.8, :amp => 0.6}, nil, nil, nil, nil, nil, {:note => [:a3, :c4, :e4, :g4], :cutoff => 85, :release => 0.8, :amp => 0.6}, nil, nil, nil, nil, nil, nil, {:note => [:b3, :d4, :fs4, :a4], :cutoff => 85, :release => 0.8, :amp => 0.6}, nil, nil)

# Smoky, echoing "Wurlitzer/Rhodes" Melody (E Minor Pentatonic).
# Uses :play_fm with a low divisor (3) and depth (1) to create a soft, 
# organic sine wave. Routed through the engine's tape echo for a cavernous, 
# jazz-club smear.
s_fm    = (ring nil, nil, nil, nil, {:note => :b4, :amp => 0.5, :divisor => 3, :depth => 1, :release => 1.0}, nil, nil, nil, nil, nil, {:note => :g4, :amp => 0.4, :divisor => 3, :depth => 1, :release => 1.0}, nil, nil, nil, nil, nil)

# Soft, ambient vocal "Sigh" (Granular Synth).
# Long size (0.15) and low density (1) creates a slow, evolving background 
# texture that sounds like a distant voice in a smoky room.
s_grain = (ring {:note => :e4, :buffer => :ambi_choir, :pos => 0.5, :density => 1, :size => 0.15, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Vibe - Just the lazy drums, bass, and smoky chords (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_chords, s_chords, 4] ],
  
  # Scene 2: The Groove - Add the vocal texture and let it breathe (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8] ],
    
  # Scene 3: The Solo - The echoing Wurlitzer melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_fm, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN HUMAN FEEL]
# 
# 1. The "Dilla" Swing: Look at `s_kick` and `s_hats`. The kick avoids 
#    hitting on step 4 (beat 2), pushing the groove late to step 6. The 
#    hats have wildly varying amplitudes. By emphasizing the off-beats 
#    and leaving gaps (`nil`), the engine simulates the famous "behind-
#    the-beat" swing of 90s Neo-Soul, all while maintaining a rigid 
#    `sleep 0.25` master clock.
#
# 2. Jazzy Warmth: Look at `s_chords`. The arrays form lush 4-note 
#    minor 11th chords. By using a low `cutoff` (85), the engine turns 
#    the normally sharp `:blade` synth into a soft, muffled Rhodes piano 
#    that sounds like it's playing in a dimly lit jazz club.
#
# 3. Extreme Dynamic Space: Neo-Soul relies on leaving massive room for 
#    the vocals and bass. The `s_bass` uses a very low `cutoff` (65) to 
#    keep it round and warm, while the `s_fm` melody leaves huge gaps 
#    (`nil`) between notes. The engine's strict 16-step grid ensures 
#    these slow, lush elements never clash, creating a deep, soulful 
#    pocket that feels incredibly organic.
# ==========================================================
