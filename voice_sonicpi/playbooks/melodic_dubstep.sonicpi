# ==========================================================
# PLAYBOOK: MELODIC DUBSTEP / CHILLSTEP
# ==========================================================
# Emotional dubstep with soaring supersaw chords and half-time cinematic groove.
# DNA: 140 BPM | Key E Minor | Rhythm: Half-time | Timbre: Soaring, cinematic, warm | Arrangement: Atmosphere → Build → Drop
# ==========================================================

use_bpm 140

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# ==========================================================
# DRUM PATTERNS
# ==========================================================

# Half-time dubstep kick with syncopated accents
s_kick = gen_score("x......xx.......", [
  {amp: 1.2},
  {amp: 0.8},
  {amp: 1.0}
])

# Massive snare on beat 3
s_snare = gen_score("........x.......", [{amp: 1.0}])

# Rolling trap hats with ascending amplitude
s_hats = gen_score("x.x.x.xx.x.x.x.x", [
  {amp: 0.3},
  {amp: 0.2},
  {amp: 0.3},
  {amp: 0.4},
  {amp: 0.5},
  {amp: 0.3},
  {amp: 0.2},
  {amp: 0.3},
  {amp: 0.4},
  {amp: 0.5},
  {amp: 0.6}
])

# ==========================================================
# BASS LAYER WITH SIDECHAIN SIMULATION
# ==========================================================

# Sub-bass with amp modulation to simulate sidechain compression
# Amp dips when kick hits (steps 0, 8) and pumps in between
s_bass = gen_score("x...x...x...x...", [
  {note: :e1, release: 0.5, amp: 0.2},
  {note: :d1, release: 0.5, amp: 0.8},
  {note: :c1, release: 0.5, amp: 0.2},
  {note: :b0, release: 0.5, amp: 0.8}
])

# ==========================================================
# HARMONIC & MELODIC ELEMENTS
# ==========================================================

# Emotional supersaw chord progression (Em → Cmaj7 → G → D)
s_chords = gen_score("x...x...x...x...", [
  {note: [:e3, :g3, :b3, :e4], cutoff: 120, release: 1.5, amp: 0.6},
  {note: [:c3, :e3, :g3, :b3], cutoff: 120, release: 1.5, amp: 0.6},
  {note: [:g3, :b3, :d4, :g4], cutoff: 120, release: 1.5, amp: 0.6},
  {note: [:d3, :fs3, :a3, :d4], cutoff: 120, release: 1.5, amp: 0.6}
])

# Echoing pluck arpeggio (E minor pentatonic)
s_fm = gen_score("x...x.x...x...x.", [
  {note: :e5, amp: 0.6, divisor: 2, depth: 2, release: 0.8},
  {note: :b4, amp: 0.5, divisor: 2, depth: 2, release: 0.8},
  {note: :g5, amp: 0.6, divisor: 2, depth: 2, release: 0.8},
  {note: :d5, amp: 0.5, divisor: 2, depth: 2, release: 0.8}
])

# Ethereal vocal pad texture
s_grain = gen_score("x.......x.......", [
  {note: :e4, buffer: :ambi_choir, pos: 0.2, density: 2, size: 0.15, amp: 0.5},
  {note: :c4, buffer: :ambi_choir, pos: 0.4, density: 2, size: 0.15, amp: 0.5}
])

# ==========================================================
# PLAYBOOK STRUCTURE
# ==========================================================

playbook = (ring
  
  # Scene 1: The Atmosphere (4 bars)
  # Vocal pad, bass, and chords establish the emotional landscape
  [
    [:play_grain,  s_grain, 4],
    [:play_sub,    s_bass, 4],
    [:play_chords, s_chords, 4]
  ],
  
  # Scene 2: The Build (8 bars)
  # Drums enter with half-time groove
  [
    [:play_grain,  s_grain, 8],
    [:play_sub,    s_bass, 8],
    [:play_chords, s_chords, 8],
    [:play_kick,   s_kick, 8],
    [:play_snare,  s_snare, 8],
    [:play_hats,   s_hats, 8]
  ],
  
  # Scene 3: The Drop (8 bars)
  # Emotional pluck arpeggio completes the arrangement
  [
    [:play_grain,  s_grain, 8],
    [:play_sub,    s_bass, 8],
    [:play_chords, s_chords, 8],
    [:play_kick,   s_kick, 8],
    [:play_snare,  s_snare, 8],
    [:play_hats,   s_hats, 8],
    [:play_fm,     s_fm, 8]
  ]
)

# ==========================================================
# RUN
# ==========================================================

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Amp modulation simulates sidechain compression on bass
# - Wide 4-note chords create cinematic supersaw wall
# - Echo delays fill gaps in arpeggio for cascading effect
# - Half-time drum pattern anchors the heavy groove
# - Granular pad adds ethereal vocal texture throughout
# ==========================================================
