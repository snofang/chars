# ==========================================================
# PLAYBOOK: MELODIC DUBSTEP / CHILLSTEP
# (Pioneered by Seven Lions, Illenium, and Koven)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose Melodic Dubstep.
# We have explored aggressive dubstep (Brostep/Riddim) and euphoric 
# major-key dance music (Future Bass). Melodic Dubstep is the emotional 
# bridge between them. It takes the heavy, half-time 140 BPM grid of 
# dubstep but replaces the metallic growls with massive, soaring supersaw 
# chords, deep sidechained sub-bass, and emotional, echoing arpeggios.
#
# This playbook perfectly demonstrates how to use the Parameter Hashes 
# to create a "sidechain pump" purely via data, and how to use wide 
# chord arrays to create a stadium-sized, cinematic atmosphere.
# ==========================================================

use_bpm 140

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (E Minor - Emotional, Cinematic, & Heavy)
# ==========================================================

# Half-time, heavy Dubstep kick. 
# Hits on step 0, the 'a' of 2 (step 7), and beat 3 (step 8).
s_kick  = (ring {:note => :c4, :amp => 1.2}, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, {:note => :c4, :amp => 1.0}, nil, nil, nil, nil, nil, nil, nil)

# Massive, echoing snare strictly on beat 3 (step 8).
s_snare = (ring nil, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 1.0}, nil, nil, nil, nil, nil, nil, nil)

# Fast, rolling Trap hats with a rising amplitude roll.
s_hats  = (ring {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.5}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.5}, {:note => :c4, :amp => 0.6})

# The "Sidechained" Sub-Bass (E Minor).
# Hits on the downbeats. The 'amp' Hashes dip to 0.2 when the kick hits 
# (steps 0, 8) and spike to 0.8 in between, simulating heavy sidechain 
# compression that makes the track "breathe".
s_bass  = (ring {:note => :e1, :release => 0.5, :amp => 0.2}, nil, nil, nil, {:note => :d1, :release => 0.5, :amp => 0.8}, nil, nil, nil, {:note => :c1, :release => 0.5, :amp => 0.2}, nil, nil, nil, {:note => :b0, :release => 0.5, :amp => 0.8}, nil, nil, nil)

# Massive, emotional Supersaw Chords (Em, Cmaj7, G, D).
# Hit on the downbeats with a high cutoff (120) and long release (1.5) 
# to create a soaring, cinematic wall of sound.
s_chords= (ring {:note => [:e3, :g3, :b3, :e4], :cutoff => 120, :release => 1.5, :amp => 0.6}, nil, nil, nil, {:note => [:c3, :e3, :g3, :b3], :cutoff => 120, :release => 1.5, :amp => 0.6}, nil, nil, nil, {:note => [:g3, :b3, :d4, :g4], :cutoff => 120, :release => 1.5, :amp => 0.6}, nil, nil, nil, {:note => [:d3, :fs3, :a3, :d4], :cutoff => 120, :release => 1.5, :amp => 0.6}, nil, nil, nil)

# Emotional, echoing Pluck Arpeggio (E Minor Pentatonic).
# Uses :play_fm with a low divisor (2) and depth (2) to create a soft, 
# organic guitar-like pluck. Routed through the engine's tape echo.
s_fm    = (ring {:note => :e5, :amp => 0.6, :divisor => 2, :depth => 2, :release => 0.8}, nil, nil, nil, nil, {:note => :b4, :amp => 0.5, :divisor => 2, :depth => 2, :release => 0.8}, nil, nil, {:note => :g5, :amp => 0.6, :divisor => 2, :depth => 2, :release => 0.8}, nil, nil, nil, nil, {:note => :d5, :amp => 0.5, :divisor => 2, :depth => 2, :release => 0.8}, nil, nil)

# Ethereal, granular vocal pad (using :ambi_choir).
# Long size (0.15) and low density (2) creates a slow, evolving celestial texture.
s_grain = (ring {:note => :e4, :buffer => :ambi_choir, :pos => 0.2, :density => 2, :size => 0.15, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :buffer => :ambi_choir, :pos => 0.4, :density => 2, :size => 0.15, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Atmosphere - Just the vocal pad, bass, and chords (4 bars)
  [ [:play_grain, s_grain, 4], [:play_sub, s_bass, 4], [:play_chords, s_chords, 4] ],
  
  # Scene 2: The Build - Add the half-time drums (8 bars)
  [ [:play_grain, s_grain, 8], [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Drop - The emotional pluck arpeggio drops (8 bars)
  [ [:play_grain, s_grain, 8], [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_fm, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN EMOTIONAL CONTRAST]
# 
# 1. Data-Driven Sidechain: Look at `s_bass`. A real Melodic Dubstep track 
#    uses heavy sidechain compression to make the bass "duck" when the kick 
#    hits. Because our engine reads Parameter Hashes, we can simulate this 
#    perfectly by just setting the bass `amp` to `0.2` on steps 0 and 8 
#    (where the kick hits), and `0.8` on the steps in between. The engine 
#    handles the rest, creating that massive, breathing groove.
#
# 2. The Supersaw Wall: Look at `s_chords`. The arrays form massive 4-note 
#    chords. By using a high `cutoff` (120) and a long `release` (1.5), the 
#    engine turns the `:blade` synth into a bright, soaring wall of sound 
#    that washes over the heavy half-time drums.
#
# 3. Echoing Plucks: The `s_fm` sequence plays a simple E minor pentatonic 
#    melody, but leaves massive gaps (`nil`) between the notes. Because the 
#    engine routes the `:play_fm` synth through a tape echo, those empty 
#    spaces are filled by delay tails, creating a cascading, emotional 
#    soundscape that perfectly mimics the guitar-like plucks of Seven Lions 
#    and Illenium.
# ==========================================================
