# ==========================================================
# PLAYBOOK: MASSIVE ATTACK - "UNFINISHED SYMPATHY" (1991)
# ==========================================================

use_bpm 88

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F Minor - Orchestral, Melancholic, & Driving)
# ==========================================================

# The "Breakbeat" Kick. 
# A heavy, syncopated, driving march. (5 x's, 5 elements)
s_kick = gen_score("x..x..x.x..x....", [
  :c4, {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.6}, {note: :c4, amp: 0.9}
])

# Heavy, echoing snare strictly on beats 2 and 4, with a ghost note. (3 x's, 3 elements)
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.3}, {note: :c4, amp: 1.0}
])

# Swung, continuous 16th shaker to drive the momentum. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.15}
])

# The "Walking" Upright Bass (F Minor).
# Plays a deep, melodic, syncopated line. 
# Mid cutoff (80) and short release (0.2) create a warm, percussive "thwack".
# (8 x's, 8 elements)
bass_notes = [:f1, :f1, :g1, :ab1, :c2, :c2, :bb1, :ab1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 80, release: 0.2, amp: 1.0} }
s_bass = gen_score("x..x.x..x..x.x..", bass_data)

# Massive, "Orchestral String" Pad (Fm to Db to Eb).
# Hit on the downbeats. The slow 2.0-beat attack and massive 4.0-beat release 
# blur the chords together into a continuous, cinematic, weeping wave. 
# (3 x's, 3 elements)
s_chords = gen_score("x.......x.x.....", [
  {note: [:f3, :ab3, :c4], cutoff: 70, attack: 2.0, release: 4.0, amp: 0.4},
  {note: [:db3, :f3, :ab3], cutoff: 70, attack: 2.0, release: 4.0, amp: 0.4},
  {note: [:eb3, :g3, :bb3], cutoff: 70, attack: 2.0, release: 4.0, amp: 0.4}
])

# Piercing, "Emotional" Lead (F Minor Pentatonic).
# Uses :play_lead (Prophet synth). Routed through the global tape echo. 
# (6 x's, 6 elements)
# FIXED: Removed invalid FM opts (divisor/depth) so the Prophet synth doesn't crash.
lead_notes = [:f5, :ab5, :c6, :bb5, :ab5, :f5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, cutoff: 90, release: 0.6} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "I know that I've been mad" Vocal Drone (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched UP.
# Massive size (0.5s) and low density (1) time-stretches the sample into a 
# slow, evolving, ethereal background texture. (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :f4, buffer: :ambi_choir, pos: 0.3, density: 1, size: 0.5, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the walking bass, sweeping strings, and vocal drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Verse - Add the heavy, syncopated breakbeat (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chorus - The piercing, emotional lead melody drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
