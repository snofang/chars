# ==========================================================
# PLAYBOOK: 2000s BROKEN BEAT / NU-JAZZ
# (Pioneered by Bugz in the Attic, 4Hero, and IG Culture)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 2000s Broken Beat.
# We have explored Jazz Funk and Future Garage, but Broken Beat (or "Bruk") 
# is the sound of the early 2000s West London underground. It fuses the 
# complex, shuffled syncopation of jazz fusion and drum & bass with the 
# deep, warm grooves of house music. It relies on heavily syncopated, 
# "broken" drum patterns, deep, round sub-bass, lush, wide electric piano 
# chords, and rapid, stuttering synth stabs that feel like a jazz band 
# jamming on futuristic machines.
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create a highly complex, shuffled groove. By using the `gen_score` helper 
# to map out intricate, overlapping drum hits, the engine creates a 
# sophisticated, deeply funky atmosphere that defined the Bruk movement.
# ==========================================================

use_bpm 120

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Minor - Syncopated, Warm, & Complex)
# ==========================================================

# The "Broken" Kick. 
# Highly syncopated. Hits on step 0, the 'a' of 1 (step 3), 
# beat 3 (step 8), and the 'e' of 4 (step 12).
s_kick = gen_score("x..x...x.x..x...", [
  :c4, {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.6}
])

# Crisp, live snare/rimshot on beats 2 and 4, with heavy ghost notes 
# on the 'and' of 2 and the 'a' of 3.
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.4}, {note: :c4, amp: 0.9}
])

# Swung, complex 16th shaker.
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.1}, 
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# Deep, round sub-bass (F# Minor).
# Plays a syncopated, melodic line. Low cutoff (60) and medium release (0.3) 
# to create a warm, bouncy undercurrent.
bass_notes = [:fs1, :fs1, :a1, :fs1, :c2, :c2, :a1, :fs1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 60, release: 0.3, amp: 1.2} }
s_bass = gen_score("x.....x...x.....", bass_data)

# Lush, "Electric Piano" Chords (F#m9 to Bbm9).
# Hit on the off-beats. The slow 0.2-beat attack and massive 1.5-beat release 
# blur the chords together into a continuous, warm wave.
chord_notes = [
  {note: [:fs3, :a3, :c4, :e4]}, {note: [:fs3, :a3, :c4, :e4]}, 
  {note: [:bb2, :db3, :f3, :ab3]}, {note: [:bb2, :db3, :f3, :ab3]}
]
chord_data = chord_notes.map { |c| c.merge({cutoff: 80, attack: 0.2, release: 1.5, amp: 0.5}) }
s_chords = gen_score("..x.....x.x.....", chord_data)

# Rapid, "Stuttering" Synth Stabs (F# Minor Pentatonic).
# Uses :play_fm with a high divisor (4) and low depth (2) to create a sharp, 
# clean pluck. Routed through the engine's tape echo for a smear.
lead_notes = [:fs5, :a5, :c6, :e6, :d6, :c6, :a5, :fs5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 4, depth: 2, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# Soft, "Jazz Room" ambient drone (Granular Synth).
# Long size (0.3) and low density (1) creates a slow, evolving background 
# texture that sounds like the ambient hum of a live club.
s_grain = gen_score("x...............", [
  {note: :fs4, buffer: :ambi_choir, pos: 0.3, density: 1, size: 0.3, amp: 0.4}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the sub-bass, lush chords, and synth stabs (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_lead, s_lead, 4], 
    [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Vibe - Add the complex, broken drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_lead, s_lead, 8], 
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], 
    [:play_hats, s_hats, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN COMPLEX FUNK]
# 
# 1. The "Broken" Syncopation: Look at `s_kick` and `s_snare`. They completely 
#    avoid landing on a standard 4/4 pulse. By hitting on highly syncopated, 
#    interlocking steps (0, 3, 8, 12 for kick; 4, 9, 11 for snare), the engine 
#    creates a lopsided, "drunken" groove that feels like a live jazz drummer 
#    playing a complex funk break. The engine's strict master clock ensures 
#    this complex rhythm lands with absolute precision.
#
# 2. FM as a Rhodes: Look at `s_chords` and `s_lead`. The `:play_fm` synth is 
#    given a high `divisor` (4) and a low `depth` (2). This gentle harmonic 
#    ratio produces a clean, glassy, sine-like wave that perfectly mimics the 
#    pristine tones of a Fender Rhodes electric piano. By playing rapid, 
#    16th-note stabs, the engine creates a futuristic, jazzy atmosphere.
#
# 3. Lush Harmonic Warmth: Look at `s_chords`. The Hashes specify an `attack` 
#    of `0.2` and a `release` of `1.5`. Because the engine reads these 
#    Hashes, the chords don't just hit; they slowly swell into the mix and 
#    fade away, creating a continuous, blurred wave of warm harmony that 
#    perfectly anchors the track's complex, shuffled rhythm section.
# ==========================================================
