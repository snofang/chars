# ==========================================================
# PLAYBOOK: 2000s BROKEN BEAT / NU-JAZZ
# (Pioneered by Bugz in the Attic, 4Hero, and IG Culture)
# ==========================================================
# 
# [WHY THIS GENRE?]
# We have explored IDM (which is mathematical) and Liquid DnB (which is 
# smooth). Broken Beat is the sound of the West London underground. It fuses 
# the complex, shuffled syncopation of jazz fusion and drum & bass with the 
# deep, warm grooves of house music. It relies on heavily syncopated, "broken" 
# drum patterns, deep, round sub-bass, lush, wide electric piano chords, and 
# rapid, stuttering synth stabs that feel like a jazz band jamming on 
# futuristic machines.
#
# [THE CAREFULLY DESCRIBED DNA]
# 1. Tempo: 120 BPM. A danceable but complex, mid-tempo groove.
# 2. Harmonic Center: F# Minor / Jazzy. Lush, complex, and soulful.
# 3. Rhythmic Skeleton: The "Broken" Syncopation. Kicks on off-beats 
#    (steps 0, 3, 8, 12). Snares on 2 and 4, with heavy ghost notes.
# 4. Timbral Palette:
#    - Bass: Deep, round, melodic sub-bass (low cutoff, medium release).
#    - Chords: Lush, wide electric piano chords (FM, high divisor, low depth).
#    - Lead: Rapid, stuttering, "brass" or "clav" synth stabs (FM, high cutoff).
#    - Texture: Soft, "room ambience" drone (granular, long size).
# 5. Arrangement: Intro (Bass/Chords) -> Verse (Broken Drums) -> Drop (Stabs).
# ==========================================================

use_bpm 120

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Minor - Syncopated, Jazzy, & Warm)
# ==========================================================

# The "Broken" Kick. 
# Highly syncopated. Hits on 0, the 'a' of 1 (step 3), beat 3 (step 8), 
# and the 'e' of 4 (step 12). (4 x's, 4 elements)
s_kick = gen_score("x..x...x.x..x...", [
  :c4, {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.6}
])

# Crisp, live snare/rimshot on beats 2 and 4, with heavy ghost notes 
# on the 'and' of 2 and the 'a' of 3. (3 x's, 3 elements)
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.4}, {note: :c4, amp: 0.9}
])

# Swung, complex 16th shaker. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.1}
])

# Deep, round sub-bass (F# Minor).
# Plays a syncopated, melodic line. 
# Low cutoff (60) and medium release (0.3) to create a warm, bouncy undercurrent.
# (4 x's, 4 elements)
s_bass = gen_score("x.....x.x.....x.", [
  {note: :fs1, release: 0.3, cutoff: 60, amp: 1.2}, 
  {note: :a1, release: 0.3, cutoff: 60, amp: 1.0}, 
  {note: :cs2, release: 0.3, cutoff: 60, amp: 1.0}, 
  {note: :fs1, release: 0.3, cutoff: 60, amp: 1.0}
])

# Lush, "Electric Piano" Chords (F#m11 to Bbm11).
# Hit on the off-beats. The slow 0.2-beat attack and massive 1.5-beat release 
# blur the chords together into a continuous, warm, jazzy wave. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:fs3, :a3, :c4, :e4], divisor: 3, depth: 2, attack: 0.2, release: 1.5, amp: 0.5},
  {note: [:fs3, :a3, :c4, :e4], divisor: 3, depth: 2, attack: 0.2, release: 1.5, amp: 0.5},
  {note: [:bb2, :db3, :f3, :ab3], divisor: 3, depth: 2, attack: 0.2, release: 1.5, amp: 0.5},
  {note: [:bb2, :db3, :f3, :ab3], divisor: 3, depth: 2, attack: 0.2, release: 1.5, amp: 0.5}
])

# Rapid, "Stuttering" Synth Stabs (F# Minor Pentatonic).
# Uses :play_fm with a high divisor (4) and low depth (2) to create a sharp, 
# clean, plucky tone. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:fs5, :a5, :c6, :e6, :d6, :c6]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 4, depth: 2, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# Soft, "Jazz Room" Ambient Drone (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched DOWN.
# Long size (0.3) and low density (1) creates a slow, evolving, warm 
# background texture that sounds like the ambient hum of a live club. 
# (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :fs4, buffer: :ambi_choir, pos: 0.3, density: 1, size: 0.3, amp: 0.4}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Vibe - Just the sub-bass, lush chords, and synth stabs (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_lead, s_lead, 4], 
    [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Groove - Add the complex, broken drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_lead, s_lead, 8], 
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], 
    [:play_hats, s_hats, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN COMPLEX FUNK]
# 
# 1. The "Broken" Syncopation: Look at `s_kick` and `s_snare`. They completely 
#    avoid landing on a standard 4/4 pulse. By hitting on highly syncopated, 
#    interlocking steps (Kick: 0, 3, 8, 12; Snare: 4, 9, 11), the engine 
#    creates a lopsided, "drunken" groove that feels like a live jazz drummer 
#    playing a complex funk break. The engine's strict master clock ensures 
#    this complex rhythm lands with absolute precision.
#
# 2. FM as a Rhodes: Look at `s_chords` and `s_lead`. The `:play_fm` synth is 
#    given a high `divisor` (3 or 4) and a low `depth` (2). This gentle harmonic 
#    ratio produces a clean, glassy, sine-like wave that perfectly mimics the 
#    pristine tones of a Fender Rhodes electric piano. By playing rapid, 16th-note 
#    stabs, the engine creates a futuristic, jazzy atmosphere.
#
# 3. Lush Harmonic Warmth: Look at `s_chords`. The arrays form massive 4-note 
#    minor 11th chords. By using a low `cutoff` (80) and a slow `attack` (0.2), 
#    the engine turns the `:blade` synth into a soft, muffled electric piano 
#    that perfectly mimics the lush, complex chords of Broken Beat.
# ==========================================================
