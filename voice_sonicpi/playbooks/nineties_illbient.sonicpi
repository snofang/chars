# ==========================================================
# PLAYBOOK: 90s ILLBIENT / NYC EXPERIMENTAL HIP-HOP
# Dark, Dubby, Echoing Soundscapes
# ==========================================================
# [WHY THIS GENRE?]
# Illbient (DJ Spooky, Dr. Octagon) fuses slow hip‑hop grooves
# with massive dub delays, dissonant ambient textures, and
# extreme negative space. This playbook captures that eerie,
# abandoned‑subway‑at‑3AM atmosphere.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 75 BPM
# Key: E minor (dark, brooding)
# Rhythm: Sparse kick on 1, and of 2, and 3; snare on 2/4;
# very sparse reversed hats.
# Timbre: Deep dub sub‑bass (dsaw, low cutoff, long release),
# dissonant minor chords (blade, long attack/release),
# hollow FM blips (divisor 3, low depth), pitched‑down
# granular vocal drone (long size, low density).
# Arrangement: Tunnel (bass+chords+grain) → Echo (drums enter)
# → Void (FM blips enter).
# ==========================================================

use_bpm 75

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores

# Sparse dub kick: hits on 1, and of 2, and beat 3
s_kick = gen_score("x.....x...x.....",
  [{note: :c4, amp: 1.0}, {note: :c4, amp: 0.8}, {note: :c4, amp: 1.0}])

# Heavy echoing snare on 2 and 4
s_snare = gen_score("....x.......x...", [:c4])

# Very sparse reversed‑sounding hats
s_hats = gen_score("..x.......x.....", 
  [{note: :c4, amp: 0.15}, {note: :c4, amp: 0.2}])

# Deep dub sub‑bass – low cutoff, massive release for rumble
s_bass = gen_score("x.......x.......",
  [{note: :e1, release: 2.0, cutoff: 60},
   {note: :g1, release: 2.0, cutoff: 60}])

# Eerie dissonant chords – slow attack, long release
chord_data = [
  {note: [:e3, :g3, :b3], cutoff: 70, attack: 0.5, release: 2.5, amp: 0.5},
  {note: [:c3, :e3, :g3, :b3], cutoff: 70, attack: 0.5, release: 2.5, amp: 0.5}
]
s_chords = gen_score("x.......x.......", chord_data)

# Sci‑fi echoing blips – FM with hollow tone
s_fm = gen_score("....x...x...x...",
  [{note: :e5, amp: 0.5, divisor: 3, depth: 2, release: 1.0},
   {note: :b4, amp: 0.4, divisor: 3, depth: 2, release: 1.0},
   {note: :g5, amp: 0.5, divisor: 3, depth: 2, release: 1.0}])

# Pitched‑down vocal drone – slow evolving grain
s_grain = gen_score("x.......x.......",
  [{note: :e3, buffer: :ambi_choir, pos: 0.4, density: 1, size: 0.4, amp: 0.6},
   {note: :c3, buffer: :ambi_choir, pos: 0.6, density: 1, size: 0.4, amp: 0.6}])

# Playbook
playbook = (ring
  # Scene 1: Tunnel – Bass, Chords, Grain
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4],
    [:play_grain, s_grain, 4] ],

  # Scene 2: Echo – Drums enter
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8],
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],

  # Scene 3: Void – FM blips enter
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8],
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The dub bass: release 2.0 at 75 BPM creates a 2.5‑second
#   tail that rumbles beneath everything – dark and suffocating.
# - Extreme negative space: most grid positions are rests,
#   letting reverb and delay tails ring into the void.
# - Swelling dissonance: attack 0.5 and release 2.5 on chords
#   turn stabs into continuous, blurred harmonic waves.
# - Granular drone with density 1 and size 0.4 time‑stretches
#   the choir into a distant, tunnel‑like ambient texture.
# ==========================================================
