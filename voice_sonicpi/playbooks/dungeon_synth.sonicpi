# ==========================================================
# PLAYBOOK: DUNGEON SYNTH / MEDIEVAL AMBIENT
# (Pioneered by Mortiis, Fief, and Burzum's synth albums)
# ==========================================================
# 
# [WHY THIS GENRE?]
# We have explored fast, chaotic extremes (Grindcore, Nintendocore, Shangaan 
# Electro) and slow, heavy extremes (Drone Metal, Doom Metal). Dungeon Synth 
# is the sound of a solitary, lo-fi medieval fantasy. It abandons percussion 
# entirely, relying on slow, sustained string pads, deep sub-bass drones, and 
# piercing, echoing "flute" or "harp" melodies. The engine captures that 
# exact, frozen, cavernous atmosphere.
#
# [THE CAREFULLY DESCRIBED DNA]
# 1. Tempo: 80 BPM. Slow, majestic, and frozen.
# 2. Harmonic Center: C Minor. Melancholic and medieval.
# 3. Rhythmic Skeleton: None. The 16-step grid is used purely to trigger 
#    massive, sustained events, not rhythmic hits.
# 4. Timbral Palette:
#    - Bass: Deep, continuous, sustained sub-bass drone.
#    - Chords: Slow-attacking string/harpsichord pads (extreme attack/release).
#    - Lead: Piercing, echoing "recorder" or "harp" melody (high FM divisor).
#    - Texture: Granular "crypt" or "wind" drone (long grain size, low density).
# 5. Arrangement: Intro (Strings/Bass) -> Verse (Texture) -> Chorus (Lead).
# ==========================================================

use_bpm 80

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (C Minor - Frozen, Cavernous, & Majestic)
# ==========================================================

# Deep, continuous "Sub-Bass" Drone (C Minor).
# Hits once and rings out for the entire scene (8 bars = 32 beats).
# Extreme low cutoff (50) and massive release (32.0) create a deep, 
# continuous, suffocating rumble. (1 x, 1 element)
s_bass = gen_score("x...............", [
  {note: :c1, release: 32.0, cutoff: 50, amp: 1.2}
])

# Lush, "String/Harpsichord" Pad (Cm to Ab).
# Hit on the downbeats. The slow 2.0-beat attack and massive 4.0-beat release 
# blur the chords together into a continuous, cinematic, frozen wave. 
# (2 x's, 2 elements)
s_chords = gen_score("x.......x.......", [
  {note: [:c3, :eb3, :g3], cutoff: 80, attack: 2.0, release: 4.0, amp: 0.4},
  {note: [:ab2, :c3, :eb3], cutoff: 80, attack: 2.0, release: 4.0, amp: 0.4}
])

# Piercing, "Recorder/Harp" Lead (C Minor Pentatonic).
# Uses :play_fm with a high divisor (3) and low depth (1) to create a pristine, 
# glassy, sine-like wave. Routed through the global tape echo. 
# (6 x's, 6 elements)
s_lead = gen_score("x..x..x..x..x..x", [
  {note: :c5, amp: 0.6, divisor: 3, depth: 1, release: 1.5}, 
  {note: :eb5, amp: 0.5, divisor: 3, depth: 1, release: 1.5}, 
  {note: :g5, amp: 0.7, divisor: 3, depth: 1, release: 2.0}, 
  {note: :c6, amp: 0.5, divisor: 3, depth: 1, release: 1.5}, 
  {note: :bb5, amp: 0.6, divisor: 3, depth: 1, release: 1.5}, 
  {note: :g5, amp: 0.7, divisor: 3, depth: 1, release: 2.0}
])

# "Crypt / Wind" Drone (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched DOWN.
# Massive size (0.5s) and low density (1) time-stretches the sample into 
# a slow, evolving, cavernous background texture. (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :c3, buffer: :ambi_choir, pos: 0.4, density: 1, size: 0.5, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Crypt - Just the deep bass, sweeping strings, and wind drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The March - Add a sparse, heavy, echoing kick (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8] ],
    
  # Scene 3: The Crown - The piercing, echoing recorder melody drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN FROZEN ATMOSPHERE]
# 
# 1. The Rhythmic Void: Look at the playbook. There are zero drum instruments 
#    (`:play_kick`, `:play_snare`, `:play_hats`). The 16-step grid is still 
#    ticking, but it is used purely to trigger massive durations. The engine's 
#    strict master clock ensures the chords and bass trigger exactly on beat 1, 
#    holding perfectly in sync for 8 bars without drifting.
#
# 2. Data-Driven Sustain: Look at `s_bass` and `s_chords`. The `release` times 
#    are 32.0 and 4.0. Because the scene is only 8 bars (32 beats) long, the 
#    sub-bass never actually finishes ringing out before the next scene triggers. 
#    This creates a continuous, overlapping "wall of sound" with no silence.
#
# 3. FM as a Recorder: The `s_lead` sequence uses `divisor: 3` and `depth: 1`. 
#    This gentle harmonic ratio produces a pristine, glassy, sine-like wave that 
#    mimics a medieval recorder or harp. Because it's routed through the global 
#    tape echo bus, the sparse notes smear into a soaring, echoing melody that 
#    perfectly anchors the track's frozen, cavernous atmosphere.
# ==========================================================
