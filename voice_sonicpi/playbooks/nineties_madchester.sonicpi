# ==========================================================
# PLAYBOOK: 90s MADCHESTER / BAGGY INDIE DANCE
# (Pioneered by The Stone Roses, Happy Mondays, and Inspiral Carpets)
# ==========================================================
# 
# [WHY THIS GENRE?]
# Madchester fuses 60s psychedelic rock with acid house groove.
# This playbook uses a rolling 16th‑note bass, syncopated
# "Funky Drummer" breakbeat, and droning Hammond‑style chords
# to create a swaggering, psychedelic dancefloor atmosphere.
# ==========================================================

use_bpm 105

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x.....x.x.....x.", [
  :c4,
  {note: :c4, amp: 0.8},
  {note: :c4, amp: 1.0},
  {note: :c4, amp: 0.6}
])

s_snare = gen_score("....x....x..x...", [
  {note: :c4, amp: 0.9},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.9}
])

s_hats  = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3}
])

s_bass  = gen_score("xxxxxxxxxxxxxxxx", [
  {note: :a2, cutoff: 100, release: 0.15},
  {note: :a2, cutoff: 100, release: 0.15},
  {note: :e2, cutoff: 100, release: 0.15},
  {note: :a2, cutoff: 100, release: 0.15},
  {note: :a2, cutoff: 100, release: 0.15},
  {note: :a2, cutoff: 100, release: 0.15},
  {note: :g2, cutoff: 100, release: 0.15},
  {note: :a2, cutoff: 100, release: 0.15},
  {note: :d2, cutoff: 100, release: 0.15},
  {note: :d2, cutoff: 100, release: 0.15},
  {note: :a2, cutoff: 100, release: 0.15},
  {note: :d2, cutoff: 100, release: 0.15},
  {note: :g2, cutoff: 100, release: 0.15},
  {note: :g2, cutoff: 100, release: 0.15},
  {note: :e2, cutoff: 100, release: 0.15},
  {note: :a2, cutoff: 100, release: 0.15}
])

s_chords = gen_score("x.......x.......", [
  {note: [:a3, :c4, :e4, :g4], cutoff: 100, release: 1.0, amp: 0.6},
  {note: [:g3, :b3, :d4, :f4], cutoff: 100, release: 1.0, amp: 0.6}
])

s_fm    = gen_score("xxxxxxxxxxxxxxxx", [
  {note: :a4, amp: 0.6, divisor: 2, depth: 3, release: 0.1},
  nil,
  {note: :c5, amp: 0.5, divisor: 2, depth: 3, release: 0.1},
  nil,
  {note: :d5, amp: 0.6, divisor: 2, depth: 3, release: 0.1},
  nil,
  {note: :e5, amp: 0.5, divisor: 2, depth: 3, release: 0.1},
  nil,
  {note: :g5, amp: 0.6, divisor: 2, depth: 3, release: 0.1},
  nil,
  {note: :e5, amp: 0.5, divisor: 2, depth: 3, release: 0.1},
  nil,
  {note: :d5, amp: 0.6, divisor: 2, depth: 3, release: 0.1},
  nil,
  {note: :c5, amp: 0.5, divisor: 2, depth: 3, release: 0.1},
  nil
])

s_grain = gen_score("x.......x.......", [
  {note: :a3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.15, amp: 0.5},
  {note: :d3, buffer: :ambi_choir, pos: 0.5, density: 1, size: 0.15, amp: 0.5}
])

# Playbook
playbook = (ring
  # Scene 1: The Groove – bass, drums, and Hammond chords (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4],
    [:play_sub, s_bass, 4], [:play_chords, s_chords, 4] ],
  
  # Scene 2: The Vibe – add psychedelic vocal sample (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8] ],
    
  # Scene 3: The Drop – hooky indie guitar riff drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The rolling 16th‑note bass (cutoff 100, release 0.15) mimics
#   a picked, chorus‑soaked electric bass driving the groove.
# - The kick syncopation (steps 0,6,8,14) creates a lopsided
#   "Funky Drummer" swagger that bridges rock and house.
# - The Mixolydian mode (flattened 7th) adds hypnotic, psychedelic
#   tension that defined the "Baggy" era.
# ==========================================================
