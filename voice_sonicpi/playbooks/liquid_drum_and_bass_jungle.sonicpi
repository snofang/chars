# ==========================================================
# PLAYBOOK: LIQUID DRUM & BASS / ATMOSPHERIC JUNGLE
# (Pioneered by LTJ Bukem, Makoto, and High Contrast)
# ==========================================================
# [WHY THIS GENRE?]
# Liquid DnB takes the high‑BPM 16‑step grid and softens it,
# focusing on lush chords, rolling sub‑bass, and crisp breakbeats.
# This playbook uses `:play_pad` for slow‑attack chords and
# `:play_grain` for ethereal vocal textures to create a fast,
# deeply relaxing groove.
# ==========================================================

use_bpm 170

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x..x....x.......", [
  :c4,
  {note: :c4, amp: 0.7},
  {note: :c4, amp: 1.0}
])

s_snare = gen_score("....x..x....x...", [
  {note: :c4, amp: 0.9},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.9}
])

s_hats  = gen_score("xx.xx.x.xx.xx.x.", [
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3}
])

s_bass  = gen_score("x.......x.......", [
  {note: :fs1, release: 1.5},
  {note: :a1,  release: 1.5}
])

s_chords = gen_score("x.......x.......", [
  {note: [:fs3, :a3, :cs4, :e4], attack: 1.0, release: 2.0, amp: 0.7},
  {note: [:a3,  :c4, :e4,  :g4], attack: 1.0, release: 2.0, amp: 0.7}
])

s_fm     = gen_score(".x...x...x...x..", [
  {note: :fs5, amp: 0.5, divisor: 3, depth: 2, release: 0.5},
  {note: :a5,  amp: 0.4, divisor: 3, depth: 2, release: 0.5},
  {note: :e5,  amp: 0.5, divisor: 3, depth: 2, release: 0.5},
  {note: :cs5, amp: 0.4, divisor: 3, depth: 2, release: 0.5}
])

s_grain  = gen_score("x.......x.......", [
  {note: :fs4, buffer: :ambi_choir, pos: 0.2, density: 2, size: 0.2, amp: 0.5},
  {note: :a4,  buffer: :ambi_choir, pos: 0.6, density: 2, size: 0.2, amp: 0.5}
])

# Playbook
playbook = (ring
  # Scene 1: Atmosphere – chords, grain, and bass (4 bars)
  [ [:play_chords, s_chords, 4], [:play_grain, s_grain, 4], [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Groove – add syncopated drums (8 bars)
  [ [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], [:play_sub, s_bass, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Journey – echoing Rhodes melody drops (8 bars)
  [ [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], [:play_sub, s_bass, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_fm, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The chords use `attack: 1.0` and `release: 2.0` to swell
#   slowly, contrasting the fast 170 BPM drums.
# - The sub‑bass holds each note for 1.5 beats, anchoring the
#   frantic breakbeat with a warm, rolling foundation.
# - The FM bell melody (divisor: 3, depth: 2) produces soft,
#   organic tones that smear through the tape echo, creating a
#   cascading, atmospheric texture.
# ==========================================================
