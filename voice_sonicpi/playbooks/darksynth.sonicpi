# ==========================================================
# PLAYBOOK: 2010s DARKSYNTH / CYBERPUNK
# (Pioneered by Perturbator, Carpenter Brut, and Mega Drive)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 2010s Darksynth.
# We have explored 80s Synthwave and Industrial Metal, but Darksynth is 
# the sound of modern, dystopian cyberpunk. It pushes the tempo to 115 BPM 
# and relies on a massive, heavily distorted continuous 16th-note bassline, 
# driving 4/4 metal drums, dissonant minor power chords, and a piercing, 
# screaming FM lead that feels like a high-speed hover-car chase through 
# a neon-lit, raining megacity.
#
# This playbook perfectly demonstrates how to push the `:play_sub` synth 
# into absolute overdrive. By using an extreme `cutoff` (120) and a 
# microscopic `release` (0.08) on continuous 16th notes, the engine 
# creates a grinding, aggressive wall of sound.
# ==========================================================

use_bpm 115

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (E Phrygian Dominant - Dark, Aggressive, & Driving)
# ==========================================================

# Heavy, driving 4/4 metal kick. (4 x's, 1 element)
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, echoing snare strictly on beats 2 and 4. (2 x's, 1 element)
s_snare = gen_score("....x.......x...", [:c4])

# Rigid, off-beat open hats to drive the momentum. (4 x's, 4 elements)
s_hats = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, 
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}
])

# The "Distorted" Bass (E Phrygian Dominant).
# Plays continuous 16th notes, alternating octaves. 
# Extreme cutoff (120) and microscopic release (0.08) create a relentless, 
# grinding, distorted churn that drives the track. (16 x's, 16 elements)
bass_cycle = [:e1, :e2, :e1, :e2, :e1, :e2, :e1, :e2, 
              :f1, :f2, :f1, :f2, :gs1, :gs2, :gs1, :gs2]
bass_data = bass_cycle.map { |n| {note: n, cutoff: 120, release: 0.08, amp: 1.2} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Massive, "Distorted" Power Chords (E5 to F5 to G#5).
# Uses :play_fm with a low divisor (2) and extreme depth (5) to create a 
# harsh, grinding hit. Hits on the off-beats. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:e3, :b3], divisor: 2, depth: 5, release: 0.15, amp: 0.7},
  {note: [:f3, :c4], divisor: 2, depth: 5, release: 0.15, amp: 0.7},
  {note: [:gs3, :ds4], divisor: 2, depth: 5, release: 0.15, amp: 0.7},
  {note: [:e3, :b3], divisor: 2, depth: 5, release: 0.15, amp: 0.7}
])

# Piercing, "Screaming" Synth Lead (E Phrygian Dominant).
# Uses :play_lead routed through the global tape echo bus. The long release (0.2) 
# and rapid, 8th-note melody create a soaring, screaming solo. (8 x's, 8 elements)
lead_notes = [:e5, :g5, :a5, :b5, :a5, :g5, :e5, :d5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, cutoff: 110, release: 0.2} }
s_lead = gen_score("x.x.x.x.x.x.x.x.", lead_data)

# Ethereal, "Cyber" Drone (Granular Synth).
# Using the built-in :ambi_choir sample.
# Massive size (0.4) and low density (1) creates a slow, evolving, dark background texture. 
# (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :e3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.4, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Megacity - Just the distorted bass, power chords, and drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Chase - Add the driving 4/4 metal drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Climax - The piercing screaming synth lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN CYBERPUNK AGGRESSION]
# 
# 1. The Distorted Churn: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step, alternating between the low octave (:e1) and the 
#    high octave (:e2). By using an extreme `cutoff` (120) and a microscopic 
#    `release` (0.08), the engine turns the detuned sawtooth into a relentless, 
#    grinding, distorted wall of sound that perfectly mimics the heavy, 
#    overdriven analog basslines of Darksynth.
#
# 2. FM as a Distorted Amp: Look at `s_chords`. The `:play_fm` synth is 
#    given a `divisor` of `2` and an extreme `depth` of `5`. This harsh 
#    harmonic ratio forces the FM modulator to grind the carrier wave, 
#    creating a harsh, distorted square wave. By playing dissonant power 
#    chords on the off-beats, the engine perfectly mimics the aggressive 
#    rhythm guitars of cyberpunk metal.
#
# 3. The Phrygian Dominant Scale: Look at `s_bass`, `s_chords`, and `s_lead`. 
#    The harmony uses E, F, G#, A, B, C, D. The augmented 2nd interval 
#    between F and G# creates the exotic, dark, "Middle Eastern" sound that 
#    defines the Darksynth genre. The engine's strict 16-step grid ensures 
#    this rapid, complex melody fires flawlessly over the driving rhythm section.
# ==========================================================
