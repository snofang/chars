# ==========================================================
# PLAYBOOK: DANCE-PUNK / INDIE DANCE
# Raw, Jagged, Relentless 16th‑Note Energy
# ==========================================================
# [WHY THIS GENRE?]
# Dance-Punk (LCD Soundsystem, The Rapture) fuses the raw
# energy of post‑punk guitars with the driving 4/4 grid of
# house music and disco. This playbook captures that jagged,
# relentless, New York underground vibe.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 125 BPM
# Key: D minor (raw, driving)
# Rhythm: 4/4 kick with syncopated hit on step 15, snare on 2/4
# with ghost on step 7, rigid 16th hats with disco bounce,
# continuous picked bass on 16ths, staccato chords on off‑beats,
# piercing FM riff, chopped vocal stutter.
# Timbre: Driving kick (bd_haus with accent), crisp snare
# (sn_dolf with dynamics), disco hats (cymbal_closed with amp
# layers), picked bass (dsaw, high cutoff, short release),
# jagged chords (blade), FM riff (divisor 2, depth 3),
# granular vocal skip.
# Arrangement: Groove (drums+bass) → Vibe (add chords) →
# Drop (add FM riff+vocal).
# ==========================================================

use_bpm 125

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Driving kick with syncopated hit on step 15
s_kick = gen_score("x...x...x...x..x",
  [:c4, :c4, :c4, :c4, {note: :c4, amp: 0.6}])

# Crisp snare with ghost on step 7
s_snare = gen_score("....x..x....x...",
  [{note: :c4, amp: 0.9}, {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.9}])

# Rigid 16th hats with disco bounce
s_hats = gen_score("x.x.x.x.x.x.x.x.",
  [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2}])

# Picked driving bass – continuous 16ths, high cutoff
bass_notes = [:d2, :d2, :d3, :d2, :d2, :d2, :c3, :d2,
              :d2, :d2, :d3, :d2, :a2, :a2, :g2, :a2]
s_bass = gen_score("xxxxxxxxxxxxxxxx",
  bass_notes.map { |n| {note: n, cutoff: 110, release: 0.1} })

# Jagged staccato chords on off‑beats (steps 2,6,10,14)
s_chords = gen_score("..x..x..x..x....",
  [[:d3, :f3, :a3, :c4],
   [:d3, :f3, :a3, :c4],
   [:c3, :e3, :g3, :b3],
   [:c3, :e3, :g3, :b3]])

# Piercing FM riff (steps 1,3,5,7,9,11,13,14)
s_fm = gen_score(".x.x.x.x.x.x.xx.",
  [{note: :d5, amp: 0.6, divisor: 2, depth: 3},
   {note: :f5, amp: 0.5, divisor: 2, depth: 3},
   {note: :c5, amp: 0.6, divisor: 2, depth: 3},
   {note: :d5, amp: 0.5, divisor: 2, depth: 3},
   {note: :a4, amp: 0.6, divisor: 2, depth: 3},
   {note: :c5, amp: 0.5, divisor: 2, depth: 3},
   {note: :d5, amp: 0.7, divisor: 2, depth: 3}])

# Chopped vocal stutter – steps 4 and 12
s_vocal = gen_score("....x.......x...",
  [{note: :d4, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.03, amp: 0.5},
   {note: :c4, buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.03, amp: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Groove – Drums + Picked Bass
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4],
    [:play_hats, s_hats, 4], [:play_sub, s_bass, 4] ],

  # Scene 2: Vibe – Add Jagged Chords
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3: Drop – Add FM Riff and Vocal Chops
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8], [:play_fm, s_fm, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The picked bass: cutoff 110 and release 0.1 turn the dsaw
#   into an aggressive, repetitive "thwack" – the engine locks
#   it on every 16th step.
# - Relentless 16ths: continuous bass notes create forward
#   momentum; the grid's precision keeps it tight.
# - Jagged FM: divisor 2 and depth 3 produce a piercing square‑wave
#   riff that cuts through the heavy bass and drums.
# ==========================================================
