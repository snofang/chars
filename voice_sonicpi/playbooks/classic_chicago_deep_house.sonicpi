# ==========================================================
# PLAYBOOK: CLASSIC CHICAGO DEEP HOUSE
# (Pioneered by Larry Heard (Mr. Fingers), Marshall Jefferson, and Ron Trent)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose Classic Chicago 
# Deep House. We have explored modern tech house and UK garage, but 
# Chicago Deep House is the absolute root of the tree. It is the sound of 
# the 80s underground. It takes the rigid 4/4 grid but softens it with 
# lush, analog jazz chords, deep, round sub-bass, and a distinct 909 
# drum machine swing. 
#
# This playbook perfectly demonstrates how to use the Parameter Hashes 
# to simulate the legendary Korg M1 "Organ Bass" and warm analog pads. 
# By using low `cutoff` values and medium `release` times, the engine 
# creates a deep, soulful, and hypnotic groove that feels like walking 
# into a dark, smoky club in 1986.
# ==========================================================

use_bpm 120

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F Minor - Deep, Soulful, & Warm)
# ==========================================================

# Classic, driving 4/4 kick.
s_kick = gen_score("x...x...x...x...", [:c4])

# Thick, vinyl-crackle clap strictly on beats 2 and 4 (steps 4 and 12).
s_clap = gen_score("....x.......x...", [:c4])

# 909 Swung Hi-Hats – alternating amplitudes to create shuffle.
# Define a sequence of amplitudes for each trigger; map to hashes.
hat_amps = [0.3, 0.15, 0.4, 0.2, 0.15, 0.4, 0.3, 0.15, 0.4, 0.2, 0.15, 0.4]
s_hats = gen_score("x.xxx.xxx.xxx.xx",
  hat_amps.map { |a| {note: :c4, amp: a} })

# The "Korg M1" Deep Organ Bass (F Minor) – walks a soulful melody.
# Define notes and common params; use base hash + note.
bass_notes = [:f2, :f2, :ab2, :c3]
bass_base = {release: 0.3, cutoff: 70}
s_bass = gen_score("x.....x.x.....x.",
  bass_notes.map { |n| bass_base.merge(note: n) })

# Lush, warm minor 9th chords (Fm9 to Abm9) on off-beats.
chord_voicings = [
  [:f3, :ab3, :c4, :eb4],
  [:f3, :ab3, :c4, :eb4],
  [:ab3, :cb4, :eb4, :gb4],
  [:eb3, :g3, :bb3, :db4]
]
s_chords = gen_score("..x...x...x...x.", chord_voicings)

# Warm, echoing "Rhodes" melody (F Minor Pentatonic) – tape echo.
# Define note/amp pairs, merge with FM base.
fm_notes = [
  {note: :f5, amp: 0.5},
  {note: :c5, amp: 0.4},
  {note: :eb5, amp: 0.5},
  {note: :c5, amp: 0.4}
]
fm_base = {divisor: 3, depth: 2, release: 0.5}
s_fm = gen_score("....x.x.....x.x.",
  fm_notes.map { |h| fm_base.merge(h) })

# Soulful, pitched-down "Diva" vocal hit – ambient smear.
s_vocal = gen_score("........x.......",
  [{note: :f4, buffer: :ambi_choir, pos: 0.4, density: 2, size: 0.1, amp: 0.5}])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Vibe - Just the swinging drums and deep bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_clap, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Groove - Add the lush, muffled chords (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Late Night - The Rhodes melody and diva vocals drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], 
    [:play_fm, s_fm, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN DEEP WARMTH]
# 
# 1. The M1 Organ Bass: Look at `s_bass`. The `:play_sub` synth is given a 
#    `cutoff` of `70` and a `release` of `0.3`. This filters out all the 
#    harsh high frequencies and cuts the note off cleanly, perfectly 
#    mimicking the legendary Korg M1 organ bass patch used in almost every 
#    classic 80s house track.
#
# 2. The 909 Shuffle: Look at `s_hats`. The hats don't just play straight 
#    16th notes; their amplitudes swing wildly between 0.15 and 0.4. By 
#    emphasizing the off-beats (the 'e' and 'a') and leaving gaps (`nil`), 
#    the engine simulates the famous 909 16th-note shuffle that gives 
#    Chicago house its bouncy, human feel.
#
# 3. The Off-Beat Pocket: The `s_chords` hit strictly on steps 2, 6, 10, 
#    and 14. By using a low `cutoff` (85), the engine turns the `:blade` 
#    synth into a warm, muffled pad that locks perfectly between the 
#    kicks and the bassline, creating that deep, head-nodding "pocket".
# ==========================================================
