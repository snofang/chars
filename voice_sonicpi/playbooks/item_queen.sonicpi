# ==========================================================
# PLAYBOOK: QUEEN - "ANOTHER ONE BITES THE DUST" (1980)
# ==========================================================

use_bpm 110

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Minor - Funky, Dark, & Driving)
# ==========================================================

# The "Funk Rock" Kick. 
# A heavy, syncopated march. (4 x's, 4 elements)
s_kick = gen_score("x.....x.x.....x.", [
  :c4, {note: :c4, amp: 0.8}, :c4, {note: :c4, amp: 0.7}
])

# Crisp, dry snare/clap strictly on beats 2 and 4. (2 x's, 2 elements)
s_snare = gen_score("....x.......x...", [:c4, :c4])

# Rigid, off-beat 8th hats to drive the momentum. (4 x's, 4 elements)
s_hats = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, 
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}
])

# The "Iconic" Bassline (D Minor).
# Plays the legendary, syncopated, walking line. 
# High cutoff (100) and short release (0.1) create a punchy, aggressive "thwack".
# (8 x's, 8 elements)
s_bass = gen_score("x...x.x.x.x.x.x.", [
  {note: :d2, release: 0.1, cutoff: 100, amp: 1.0}, 
  {note: :a2, release: 0.1, cutoff: 100, amp: 0.8}, 
  {note: :b2, release: 0.1, cutoff: 100, amp: 1.0}, 
  {note: :a2, release: 0.1, cutoff: 100, amp: 0.8}, 
  {note: :g2, release: 0.1, cutoff: 100, amp: 1.0}, 
  {note: :a2, release: 0.1, cutoff: 100, amp: 0.8}, 
  {note: :g2, release: 0.1, cutoff: 100, amp: 1.0}, 
  {note: :fs2, release: 0.1, cutoff: 100, amp: 0.8}
])

# Stark, "Guitar/Brass" Stabs (Dm to Am).
# Uses :play_fm with a low divisor (2) and mid depth (4) to create a harsh, 
# staccato hit. Hit strictly on the off-beats. (3 x's, 3 elements)
s_chords = gen_score("..x.....x.x.....", [
  {note: [:d3, :f3, :a3], divisor: 2, depth: 4, release: 0.1, amp: 0.6},
  {note: [:d3, :f3, :a3], divisor: 2, depth: 4, release: 0.1, amp: 0.6},
  {note: [:a2, :c3, :e3], divisor: 2, depth: 4, release: 0.1, amp: 0.6}
])

# Piercing, "Echoing" Lead (D Minor).
# Uses :play_fm with a high divisor (3) and mid depth (3) to create a sharp, 
# glassy, digital tone. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:d5, :c5, :a4, :g4, :a4, :c5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, divisor: 3, depth: 3, release: 0.3} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Another one bites the dust" Vocal Stutter (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched DOWN.
# High density, tiny size = a sharp, percussive, repetitive vocal skip. (2 x's, 2 elements)
s_vocal = gen_score("....x.......x...", [
  {note: :d3, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.04, amp: 0.7},
  {note: :f3, buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the iconic bassline and echoing drums (4 bars)
  [ [:play_sub, s_bass, 4], [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], 
    [:play_hats, s_hats, 4] ],
  
  # Scene 2: The Verse - Add the stark guitar stabs and vocal chops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], 
    [:play_hats, s_hats, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Chorus - The piercing, echoing lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], 
    [:play_hats, s_hats, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN FUNK-ROCK]
# 
# 1. The Iconic Bassline: Look at `s_bass`. The `:play_sub` synth plays the 
#    legendary D-A-B-A-G-A-G-F# sequence. By using a high `cutoff` (100) and a 
#    short `release` (0.1), the engine turns the detuned sawtooth into a punchy, 
#    aggressive "thwack" that perfectly mimics John Deacon's iconic, driving 
#    electric bass performance.
#
# 2. The Stark Stabs: Look at `s_chords`. The `:play_fm` synth is given a 
#    `divisor` of `2` and a `depth` of `4`, with a microscopic `release` (0.1). 
#    This forces the FM synth to produce a harsh, staccato "hit" that perfectly 
#    mimics the stark, orchestral guitar and brass stabs that define the song's 
#    minimalist, theatrical atmosphere.
#
# 3. The Echoing Lead: The `s_lead` sequence uses `divisor: 3` and `depth: 3`. 
#    This harmonic ratio produces a sharp, glassy, digital tone that cuts 
#    through the heavy mix. Because it's routed through the global tape echo 
#    bus, the sparse notes smear into a soaring, echoing melody that perfectly 
#    anchors the track's dark, funky atmosphere.
# ==========================================================
