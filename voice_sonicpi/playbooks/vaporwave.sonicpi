# ==========================================================
# PLAYBOOK: VAPORWAVE / MALLSOFT
# (Pioneered by Macintosh Plus, Saint Pepsi, and Blank Banshee)
# ==========================================================
# 
# [WHY THIS GENRE?]
# We have explored blistering, hyper-technical speeds (Neurofunk, Shangaan 
# Electro). Vaporwave does the exact opposite. It takes the grid, slows it 
# down to a glacial 60 BPM, and strips away all rhythmic urgency. It relies 
# on "chopped and screwed" aesthetics, massive, slow-attacking synth pads, 
# deep continuous sub-bass, and pitch-shifted, time-stretched granular 
# textures that sound like wandering through an abandoned, neon-lit shopping 
# mall in a dream.
#
# [THE CAREFULLY DESCRIBED DNA]
# 1. Tempo: 60 BPM. Glacial, hypnotic, and nostalgic.
# 2. Harmonic Center: F Major. Lush, warm, and slightly unsettling.
# 3. Rhythmic Skeleton: A sparse, slow 4/4 beat. Muffled kick on 1 and 3, 
#    echoing snare on 2 and 4. Very lazy, sparse hats.
# 4. Timbral Palette:
#    - Bass: Deep, continuous sub-bass drone (low cutoff, massive release).
#    - Chords: Lush, slow-attacking electric piano/string pads.
#    - Lead: Clean, echoing, vibrato-heavy synth melody.
#    - Texture: Granular "tape warp" or "VHS" drone, pitched down.
# 5. Arrangement: Intro (Pad/Texture) -> Verse (Slow Drums) -> Chorus (Lead).
# ==========================================================

use_bpm 60

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F Major - Slow, Lush, & Nostalgic)
# ==========================================================

# The "Chopped" Kick. 
# A slow, muffled pulse. Hits on 1 and the 'and' of 3. (2 x's, 2 elements)
s_kick = gen_score("x.......x.......", [
  {note: :c4, amp: 0.7}, {note: :c4, amp: 0.6}
])

# Heavy, echoing snare strictly on beats 2 and 4. (2 x's, 2 elements)
s_snare = gen_score("....x.......x...", [:c4, :c4])

# Very sparse, lazy 8th hats. (4 x's, 4 elements)
s_hats = gen_score("x..x..x..x..x..x", [
  {note: :c4, amp: 0.15}, {note: :c4, amp: 0.1}, 
  {note: :c4, amp: 0.15}, {note: :c4, amp: 0.1}
])

# Deep, continuous "Sub-Bass" Drone (F Major).
# Hits once and rings out for the entire scene. 
# Extreme low cutoff (40) and massive release (8.0) create a heavy, 
# continuous rumble. (1 x, 1 element)
s_bass = gen_score("x...............", [
  {note: :f1, release: 8.0, cutoff: 40, amp: 1.2}
])

# Lush, "Electric Piano" Chords (Fmaj9 to Cmaj7).
# Hit on the downbeats. The slow 2.0-beat attack and massive 4.0-beat release 
# blur the chords together into a continuous, cinematic wave. (2 x's, 2 elements)
s_chords = gen_score("x.......x.......", [
  {note: [:f3, :a3, :c4, :e4], cutoff: 70, attack: 2.0, release: 4.0, amp: 0.5},
  {note: [:c3, :e3, :g3, :b3], cutoff: 70, attack: 2.0, release: 4.0, amp: 0.5}
])

# Piercing, "Vibrato" Lead (F Major Pentatonic).
# Uses :play_fm with a high divisor (3) and low depth (1) to create a pristine, 
# glassy, sine-like wave. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:f5, :a5, :c6, :a5, :g5, :e5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 1, release: 1.5} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "VHS / Tape Warp" Texture (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched DOWN.
# Massive size (1.0s) and low density (1) time-stretches the sample into 
# a slow, evolving, degraded background drone. (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :f3, buffer: :ambi_choir, pos: 0.5, density: 1, size: 1.0, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Mall - Just the deep bass, sweeping pads, and VHS drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Echo - Add the slow, chopped drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Dream - The echoing, vibrato lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN NOSTALGIA]
# 
# 1. The 33 RPM Illusion: Look at `s_chords` and `s_bass`. The Hashes specify 
#    massive `attack` (2.0) and `release` (4.0/8.0) times. Because the BPM is 
#    60, the notes take entire beats to fade in and fade out. Combined with the 
#    slow tempo, this creates the psychological illusion that a 120 BPM 80s track 
#    has been physically slowed down to half speed.
#
# 2. Ambient Granular Time-Stretching: Look at `s_grain`. The granular engine 
#    is given a massive `size` of `1.0` (1000 milliseconds) and a `density` of 
#    `1`. By pitching the `:ambi_choir` sample down and using sparse, long 
#    grains, the engine time-stretches the sample into a formless, mournful drone. 
#    It sounds like a distorted, pitch-shifted memory echoing in an empty atrium.
#
# 3. Extreme Negative Space: Vaporwave relies on what you *don't* play. 80% of 
#    the `s_kick`, `s_hats`, and `s_lead` grids are `nil`. The engine honors 
#    these rests perfectly, letting the massive reverb tails of the snare and the 
#    delay tails of the FM melody ring out into the void, creating a slow, 
#    echoing atmosphere of eerie tranquility.
# ==========================================================
