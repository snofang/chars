# ==========================================================
# PLAYBOOK: 90s HAND BAG HOUSE / DIVA HOUSE
# (Pioneered by Robin S, Crystal Waters, and Black Box)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Handbag House.
# We have explored French House and Piano House, but Handbag House is the 
# sound of 90s mainstream, joyful, vocal-driven club anthems. It relies 
# on a relentless, driving 4/4 beat, a massive, bouncing off-beat bassline, 
# huge "Korg M1" piano stabs, and soaring, pitched-up "diva" vocal chops 
# that feel like a euphoric, sweaty dancefloor.
#
# This playbook perfectly demonstrates how to use the `gen_score` helper 
# to create a massive, bouncing "boom-cha" groove. By locking the bass, 
# chords, and open hats strictly to the off-beats, and routing a piercing 
# FM lead through the global tape echo, the engine creates a high-energy, 
# deeply nostalgic 90s club atmosphere.
# ==========================================================

use_bpm 126

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (G Minor - Bouncy, Euphoric, & Driving)
# ==========================================================

# Relentless, driving 4/4 kick.
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, rave clap strictly on beats 2 and 4.
s_clap = gen_score("....x.......x...", [:c4])

# Off-beat open hats to drive the momentum.
s_hats = gen_score("..x...x...x...x.", [{note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}])

# The "Off-Beat" Rave Bass (G Minor).
# Hits strictly on the off-beats. Very short release (0.15) creates a 
# relentless, bouncing "pump" that drives the track forward.
bass_notes = [:g1, :g1, :bb1, :d2]
bass_data = bass_notes.map { |n| {note: n, release: 0.15, cutoff: 90, amp: 1.0} }
s_bass = gen_score("..x...x...x...x.", bass_data)

# Massive, "Korg M1" Piano Stabs (Gm to Cm).
# Hit strictly on the off-beats in sync with the bass. High cutoff (110) 
# and short release (0.2) give them that piercing, 90s rave piano feel.
chord_notes = [
  {note: [:g3, :bb3, :d4, :f4]}, {note: [:g3, :bb3, :d4, :f4]}, 
  {note: [:c3, :eb3, :g3, :bb3]}, {note: [:c3, :eb3, :g3, :bb3]}
]
chord_data = chord_notes.map { |c| c.merge({cutoff: 110, release: 0.2, amp: 0.6}) }
s_chords = gen_score("..x...x...x...x.", chord_data)

# Piercing, "Organ" Lead (G Minor Pentatonic).
# Uses :play_fm with a low divisor (2) and depth (3) to create a sharp, 
# buzzy organ riff that cuts through the heavy mix.
lead_notes = [:g5, :d5, :bb5, :d6, :g5, :f5, :d5, :bb4]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 3, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# High-pitched, soaring "Diva" Vocal Chops (Granular Synth).
# Pitched UP to :g4 and :bb4. High density, tiny size = a sharp, sugary vocal skip.
vocal_notes = [:g4, :bb4]
vocal_data = vocal_notes.map { |n| {note: n, buffer: :misc_lori, pos: 0.1, density: 3, size: 0.04, amp: 0.6} }
s_vocal = gen_score("....x.......x...", vocal_data)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the kick, off-beat bass, and hats (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_hats, s_hats, 4] ],
  
  # Scene 2: The Vibe - Add the heavy claps, piano stabs, and diva vocals (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8], 
    [:play_snare, s_clap, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drop - The piercing organ lead drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8], 
    [:play_snare, s_clap, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN RAVE EUPHORIA]
# 
# 1. The Off-Beat Wall: Look at `s_bass`, `s_hats`, and `s_chords`. They 
#    ALL hit strictly on steps 2, 6, 10, and 14. In a 16-step grid, these 
#    are the exact midpoints between the kicks. The engine's strict master 
#    clock locks these together perfectly at 126 BPM, creating a massive, 
#    bouncing "boom-cha" momentum that forces you to dance.
#
# 2. The Korg M1 Illusion: Look at `s_chords`. The arrays form massive 
#    4-note minor chords. By using a high `cutoff` (110) and a short 
#    `release` (0.2), the engine turns the `:blade` synth into a bright, 
#    piercing piano stab that perfectly mimics the legendary Korg M1 
#    "Organ 2" patch used in almost every 90s handbag house track.
#
# 3. Euphoric Granular Vocals: The `s_vocal` sequence uses the granular 
#    engine to chop a vocal into microscopic shards (`size: 0.04`). By 
#    pitching them UP to `:g4` and `:bb4`, the vocal loses its dark tone 
#    and becomes a soaring, sugary diva stutter that defines 90s Handbag House.
# ==========================================================
