# ==========================================================
# PLAYBOOK: 90s LO-FI HIP-HOP / CHILLHOP
# (Pioneered by Nujabes, J Dilla, and ChilledCow/Lofi Girl)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Lo-Fi Hip-Hop.
# We have explored Trip-Hop and Neo-Soul, but Lo-Fi Hip-Hop is the sound 
# of pure, unadulterated relaxation. It takes the boom-bap drum pattern of 
# 90s hip-hop, slows it down to a lazy 82 BPM, and pairs it with warm, 
# jazzy 9th chords, dusty tape saturation, and mellow, echoing Rhodes melodies.
#
# This playbook perfectly demonstrates how to simulate the legendary "Dilla 
# Swing" on a rigid 16-step sequencer. By pushing the kick and snare slightly 
# late on the grid, the engine creates a lazy, head-nodding groove that feels 
# like a worn-out cassette tape playing in a rainy bedroom.
# ==========================================================

use_bpm 82

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F Major - Jazzy, Warm, & Dusty)
# ==========================================================

# The "Dilla Swing" Kick. 
# Hits on step 0, the 'a' of 2 (step 7), and the 'e' of 3 (step 10).
# This lopsided placement creates the signature lazy, head-nodding bounce.
s_kick = gen_score("x......x.x.......", [
  :c4, {note: :c4, amp: 0.8}, {note: :c4, amp: 1.0}
])

# Crisp, vinyl-crackle snare strictly on beats 2 and 4.
s_snare = gen_score("....x.......x...", [:c4])

# Swung, lazy 16th hats. 
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}, 
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.15}
])

# Deep, round, melodic bass (F Major).
# Long release (0.6) and low cutoff (75) to create a warm, muffled undercurrent.
s_bass = gen_score("x.....x.x.....x.", [
  {note: :f2, release: 0.6, cutoff: 75, amp: 1.0}, 
  {note: :a2, release: 0.6, cutoff: 75, amp: 0.8}, 
  {note: :c3, release: 0.6, cutoff: 75, amp: 1.0}, 
  {note: :g2, release: 0.6, cutoff: 75, amp: 0.8}
])

# Lush, jazzy minor 9th chords (Fmaj9 to Dm9).
# Hit on the downbeats. The 0.2-beat attack makes them slowly fade in 
# like a warm Rhodes piano.
s_chords = gen_score("x.......x.......", [
  {note: [:f3, :a3, :c4, :e4], cutoff: 90, attack: 0.2, release: 1.5, amp: 0.6},
  {note: [:d3, :f3, :a3, :c4], cutoff: 90, attack: 0.2, release: 1.5, amp: 0.6}
])

# Mellow, echoing "Rhodes" melody (F Major Pentatonic).
# Uses :play_fm with a low divisor (2) and depth (1) to create a soft, 
# organic bell tone. Routed through the engine's tape echo for a nostalgic smear.
lead_notes = [:c5, :a4, :g4, :a4, :f4, :g4, :a4, :c5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.5, divisor: 2, depth: 1, release: 0.5} }
s_fm = gen_score("x..x..x..x..x..x", lead_data)

# Dusty, ambient "Rain/Vinyl" texture (Granular Synth).
# Long size (0.3) and low density (1) creates a slow, evolving, warm 
# background hiss that anchors the lo-fi aesthetic.
s_grain = gen_score("x...............", [
  {note: :f4, buffer: :elec_piano, pos: 0.3, density: 1, size: 0.3, amp: 0.4}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Vibe - Just the dusty chords, bass, and vinyl texture (4 bars)
  [ [:play_chords, s_chords, 4], [:play_sub, s_bass, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Groove - Add the swung boom-bap drums (8 bars)
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Late Night - The mellow Rhodes melody drops (8 bars)
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_fm, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN LAZY GROOVE]
# 
# 1. The Dilla Swing: Look at `s_kick`. Instead of hitting on step 4 
#    (beat 2), it hits on step 7 (the 'a' of beat 2). In 90s Lo-Fi Hip-Hop, 
#    drummers physically play slightly behind the beat. Because the engine's 
#    grid is mathematically perfect, pushing the kick just one 16th note late 
#    creates that heavy, leaning, "drunken" bounce.
#
# 2. Jazzy Warmth: Look at `s_chords`. The arrays form lush 4-note major 9th 
#    and minor 9th chords. By using a low `cutoff` (90) and a slow `attack` 
#    (0.2), the engine turns the normally sharp `:blade` synth into a soft, 
#    muffled Rhodes piano that sounds like it's playing from the next room.
#
# 3. Granular Hiss: The `s_grain` sequence uses a `density` of `1` and a 
#    `size` of `0.3`. By time-stretching the electric piano sample into a 
#    slow, evolving drone, the engine simulates the ambient warmth of a vinyl 
#    record or a rainy window, perfectly anchoring the lo-fi aesthetic.
# ==========================================================
