# ==========================================================
# PLAYBOOK: THE HUMAN LEAGUE - "DON'T YOU WANT ME" (1981)
# ==========================================================

use_bpm 116

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Minor - Cold, Melodic, & Cinematic)
# ==========================================================

# Relentless, driving 4/4 LinnDrum kick. (4 x's, 4 elements)
s_kick = gen_score("x...x...x...x...", [:c4, :c4, :c4, :c4])

# Heavy, dry snare strictly on beats 2 and 4. (2 x's, 2 elements)
s_snare = gen_score("....x.......x...", [:c4, :c4])

# Rigid, off-beat 8th hats to drive the momentum. (4 x's, 4 elements)
s_hats = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, 
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}
])

# The "Walking" Synth Bass (F# Minor).
# Plays a deep, melodic, syncopated line. 
# Mid cutoff (90) and short release (0.15) create a warm, punchy "thwack".
# (8 x's, 8 elements)
bass_notes = [:fs1, :fs1, :a1, :a1, :d2, :d2, :a1, :a1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 90, release: 0.15, amp: 1.0} }
s_bass = gen_score("x..x.x..x..x.x..", bass_data)

# Lush, "String Synth" Pad (F#m to D).
# Hit on the downbeats. The slow 1.0-beat attack and massive 4.0-beat release 
# blur the chords together into a continuous, cinematic wave. (2 x's, 2 elements)
s_chords = gen_score("x.......x.......", [
  {note: [:fs3, :a3, :cs4], cutoff: 70, attack: 1.0, release: 4.0, amp: 0.4},
  {note: [:d3, :fs3, :a3], cutoff: 70, attack: 1.0, release: 4.0, amp: 0.4}
])

# Piercing, "Cold" Synth Lead (F# Minor).
# Uses :play_fm with a high divisor (3) and mid depth (3) to create a sharp, 
# glassy, digital tone. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:fs5, :a5, :c6, :b5, :a5, :fs5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, divisor: 3, depth: 3, release: 0.3} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Don't you want me" Vocal Stutter (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched DOWN.
# High density, tiny size = a sharp, robotic, deadpan vocal skip. (2 x's, 2 elements)
s_vocal = gen_score("....x.......x...", [
  {note: :fs3, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.04, amp: 0.7},
  {note: :a3, buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the walking bass, sweeping pads, and vocal chops (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Verse - Add the relentless 4/4 LinnDrum beat (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chorus - The piercing, cold synth lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN EARLY 80S SYNTH-POP]
# 
# 1. The Walking Bass: Look at `s_bass`. The `:play_sub` synth plays a deep, 
#    melodic, syncopated line (F#-F#-A-A-D-D-A-A). By using a mid-range 
#    `cutoff` (90) and a short `release` (0.15), the engine turns the detuned 
#    sawtooth into a warm, punchy "thwack" that perfectly mimics the driving, 
#    melancholic synth bass that anchors the track.
#
# 2. The Cold Lead: The `s_lead` sequence uses `divisor: 3` and `depth: 3`. 
#    This harmonic ratio produces a sharp, glassy, digital tone that cuts 
#    through the heavy mix. Because it's routed through the global tape echo 
#    bus, the sparse notes smear into a soaring, echoing melody that perfectly 
#    mimics the cold, emotional atmosphere of the track.
#
# 3. The Cinematic Swell: Look at `s_chords`. The Hashes specify an `attack` 
#    of `1.0` and a `release` of `4.0`. Because the engine reads these 
#    Hashes, the chords don't just hit; they slowly swell into the mix and 
#    fade away over five whole beats, creating a continuous, blurred wave 
#    of warm harmony that perfectly mimics the lush, wide-stereo string pads 
#    of early 80s sophisti-pop.
# ==========================================================
