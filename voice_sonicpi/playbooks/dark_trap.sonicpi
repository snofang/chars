use_bpm 140

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Minor - Ominous & Dark)
# ==========================================================

# Half-time kick. Hits on step 0, and an extra syncopated hit on step 12.
s_kick  = (ring :c4, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil)

# Heavy snare/clap strictly on beat 3 (step 8).
s_snare = (ring nil, nil, nil, nil, nil, nil, nil, nil, :c4, nil, nil, nil, nil, nil, nil, nil)

# Rolling Trap Hi-Hats. 
# Notice steps 5,6,7 and 12,13,14,15. By using Hashes to rapidly increase 
# the amplitude, we simulate a 16th-note hi-hat roll without breaking the grid!
s_hats  = (ring {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, 
           {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.4}, nil, 
           {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, 
           {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.5})

# Booming, melodic 808 bass. Long releases make it ring out.
s_bass  = (ring {:note => :fs2, :release => 1.5}, nil, nil, nil, nil, nil, nil, nil, 
           {:note => :a2, :release => 1.5}, nil, nil, nil, nil, nil, nil, nil)

# Ominous, echoing lead melody (F# Minor)
s_lead  = (ring :fs4, nil, nil, nil, nil, nil, nil, nil, :a4, nil, nil, nil, :c5, nil, nil, nil)

# Atmospheric granular vocal drone to fill the empty space
s_grain = (ring {:note => :fs3, :buffer => :misc_lori, :pos => 0.3, :density => 2, :size => 0.15}, nil, nil, nil, 
           nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the atmosphere and 808 bass (4 bars)
  [ [:play_grain, s_grain, 4], [:play_sub, s_bass, 4] ],
  
  # Scene 2: The half-time beat drops (8 bars)
  [ [:play_grain, s_grain, 8], [:play_sub, s_bass, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: Add the dark lead melody (8 bars)
  [ [:play_grain, s_grain, 8], [:play_sub, s_bass, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
