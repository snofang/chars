# ==========================================================
# PLAYBOOK: MAINSTAGE EDM / BIG ROOM HOUSE
# ==========================================================
# Festival-ready big room with syncopated supersaw drops and driving energy.
# DNA: 128 BPM | Key E Minor | Rhythm: 4-on-the-floor with syncopation | Timbre: Aggressive, bright, massive | Arrangement: Buildup → Groove → Drop
# ==========================================================

use_bpm 128

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick = gen_score("x...x...x...x...", [:c4])
s_clap = gen_score("....x.......x...", [:c4])
s_hats = gen_score("..x...x...x...x.", [{amp: 0.4}, {amp: 0.5}])
s_bass = gen_score("..x...x...x...x.", [{note: :e2, amp: 1.0, release: 0.15}, {note: :g2, amp: 1.0, release: 0.15}])
s_chords = gen_score("x..x..x.x..x..x.", [[:e3, :g3, :b3, :e4], {note: [:e3, :g3, :b3, :e4], cutoff: 90, amp: 0.6}, {note: [:e3, :g3, :b3, :e4], cutoff: 100, amp: 0.7}, [:g3, :b3, :d4, :g4], {note: [:g3, :b3, :d4, :g4], cutoff: 90, amp: 0.6}, {note: [:g3, :b3, :d4, :g4], cutoff: 100, amp: 0.7}])
s_fm = gen_score(".x........x.....", [{note: :e6, amp: 0.6, depth: 2, divisor: 4}, {note: :b5, amp: 0.5, depth: 2, divisor: 4}])
s_vocal = gen_score("........x.x.x.x.", [{note: :e4, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.03, amp: 0.6}, {note: :g4, buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.03, amp: 0.6}])

# Playbook
playbook = (ring
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_fm, s_fm, 4] ],
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_fm, s_fm, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], [:play_grain, s_vocal, 8] ],
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_fm, s_fm, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], [:play_grain, s_vocal, 8], [:play_chords, s_chords, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Syncopated chord rhythm creates the signature big room bounce
# - Progressive cutoff values simulate filter sweeps across the pattern
# - Granular vocal chops add human energy to the rigid grid
# - Off-beat bass placement drives the festival groove
# - Open hats on off-beats reinforce the syncopated feel
# ==========================================================
