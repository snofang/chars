# ==========================================================
# PLAYBOOK: MODERN DANCEHALL / REGGAE FUSION
# (Pioneered by Sean Paul, Konshens, and Popcaan)
# ==========================================================
# [WHY THIS GENRE?]
# Modern Dancehall is the king of the Caribbean 16‑step grid.
# At ~100 BPM, it relies on a syncopated “Boom Clash” rhythm
# with stuttering kicks, deep sliding bass, and sparse off‑beat
# chords. This playbook uses grid sparsity to create a massive,
# swaggering island groove that leaves room for vocals.
# [DNA: 102 BPM, C minor, galloping kick, melodic 808 slides,
#  FM brass stabs, granular vocal chops]
# ==========================================================

use_bpm 102

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# ----------------------------------------------------------
# SCORES – Normalized with gen_score
# ----------------------------------------------------------

# Galloping kick – hits on steps 0, 3, 6, 8
s_kick = gen_score("x..x..x.x.......",
  [:c4,
   {note: :c4, amp: 0.8},
   {note: :c4, amp: 0.6},
   {note: :c4, amp: 1.0}])

# Snare on beats 2 and 4, with a ghost note on 14
s_snare = gen_score("....x.......x.x.",
  [{note: :c4, amp: 0.9},
   {note: :c4, amp: 0.9},
   {note: :c4, amp: 0.4}])

# Swung, triplet‑feel hi‑hats – lazy Caribbean roll
s_hats = gen_score(".xxx.xx..xxx.xx.",
  [{note: :c4, amp: 0.2},
   {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.4},
   {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.4},
   {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.4},
   {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.4}])

# Deep, sliding 808 melodic bass – C minor line, long release
s_bass = gen_score("x.....x.x.....x.",
  [{note: :c2, release: 0.4},
   {note: :eb2, release: 0.4},
   {note: :g2, release: 0.4},
   {note: :f2, release: 0.4}])

# Lush staccato chords (Cm / Fm) on off‑beats
s_chords = gen_score("....x.......x...",
  [[:c3, :eb3, :g3],
   [:f3, :ab3, :c4]])

# Bright, brassy FM horn melody (C minor pentatonic)
s_fm = gen_score("........x.x.....",
  [{note: :g5, amp: 0.7, divisor: 2, depth: 2},
   {note: :eb5, amp: 0.5, divisor: 2, depth: 2}])

# Rhythmic dancehall vocal chant – pitched‑down granular stab
s_vocal = gen_score("........x.......",
  [{note: :c4, buffer: :ambi_choir, pos: 0.3, density: 2, size: 0.05, amp: 0.6}])

# ----------------------------------------------------------
# PLAYBOOK
# ----------------------------------------------------------
playbook = (ring
  # Scene 1 – The Riddim: drums and melodic bass (4 bars)
  [ [:play_kick, s_kick, 4],
    [:play_snare, s_snare, 4],
    [:play_hats, s_hats, 4],
    [:play_sub, s_bass, 4] ],

  # Scene 2 – The Groove: add lush off‑beat chords (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3 – The Hook: brassy FM lead and vocal chant (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8],
    [:play_fm, s_fm, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# 1. Galloping Kick – hits on steps 0,3,6,8 create a lopsided,
#    staggering bounce that defines the Dancehall “Boom Clash”.
# 2. Melodic 808 Slides – a release of 0.4 lets the sub‑bass
#    ring out and carry the melody, a hallmark of the genre.
# 3. FM as Brass – divisor 2, depth 2 turns FM into a sharp
#    horn stab; the tape echo smears it across the empty space
#    for a festival‑ready Reggae Fusion feel.
# ==========================================================
