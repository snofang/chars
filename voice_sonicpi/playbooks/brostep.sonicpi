# ==========================================================
# PLAYBOOK: BROSTEP / RIDDIM
# Aggressive, Chaotic, Metallic Bass Energy
# ==========================================================
# [WHY THIS GENRE?]
# Brostep / Riddim (Skrillex, Excision) pushes half‑time
# dubstep into chaotic, metallic territory – with growling FM
# bass, piercing alien blips, and monolithic vocal grunts.
# This playbook captures that fierce, stadium‑sized aggression.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 140 BPM
# Key: F# minor (dark, aggressive)
# Rhythm: Half‑time kick (1, ghost on 'a' of 4), snare on beat 3
# with ghost on 'a' of 3, frantic triplet‑feel trap hats with
# rising rolls, syncopated growl bass, sparse eerie chords,
# alien FM blips, monstrous granular vocal grunt.
# Timbre: Punchy kick (bd_haus with accents), stadium snare
# (sn_dolf with dynamics), triplet hats (cymbal_closed with rolls),
# growl FM bass (changing divisor/depth), eerie minor chords
# (blade), alien FM blips (fm, high divisor), granular grunt
# (ambi_choir, pitch‑down, long size).
# Arrangement: Void (chords+grain) → Tension (add drums+growl)
# → Drop (add alien blips).
# ==========================================================

use_bpm 140

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Half‑time kick – hits on step 0 and ghost on step 14
s_kick = gen_score("x.............x.",
  [{note: :c4, amp: 1.2}, {note: :c4, amp: 0.6}])

# Stadium snare – main hit on step 8, ghost on step 12
s_snare = gen_score("........x...x...",
  [{note: :c4, amp: 1.2}, {note: :c4, amp: 0.4}])

# Frantic triplet‑feel hats with rising rolls
s_hats = gen_score("x.xx.x.xx.x.xxxx",
  [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.5},
   {note: :c4, amp: 0.6}])

# Metallic growl bass – FM with radically changing parameters
s_bass = gen_score("x.x..x..x.x..x.x",
  [{note: :fs1, divisor: 2, depth: 8, release: 0.15, amp: 1.0},
   {note: :fs1, divisor: 4, depth: 5, release: 0.15, amp: 0.8},
   {note: :fs1, divisor: 3, depth: 9, release: 0.15, amp: 1.0},
   {note: :a1,  divisor: 2, depth: 6, release: 0.15, amp: 1.0},
   {note: :a1,  divisor: 5, depth: 3, release: 0.15, amp: 0.8},
   {note: :fs1, divisor: 2, depth: 8, release: 0.15, amp: 1.0},
   {note: :b1,  divisor: 3, depth: 7, release: 0.15, amp: 0.9}])

# Eerie sparse minor chords – on off‑beats (steps 4 and 12)
s_chords = gen_score("....x.......x...",
  [{note: [:fs3, :a3, :c4], cutoff: 110, release: 0.5, amp: 0.5},
   {note: [:a3, :c4, :e4], cutoff: 110, release: 0.5, amp: 0.5}])

# Piercing alien FM blips – high divisor, sparse
s_fm = gen_score("....x.x...x.x.x.",
  [{note: :fs5, amp: 0.6, divisor: 4, depth: 3},
   {note: :a5,  amp: 0.5, divisor: 4, depth: 3},
   {note: :b5,  amp: 0.7, divisor: 4, depth: 3},
   {note: :a5,  amp: 0.5, divisor: 4, depth: 3},
   {note: :fs5, amp: 0.6, divisor: 4, depth: 3}])

# Monstrous pitched‑down vocal grunt – slow, demonic
s_grain = gen_score("........x.......",
  [{note: :fs2, buffer: :ambi_choir, pos: 0.6, density: 1, size: 0.1, amp: 0.7}])

# Playbook
playbook = (ring
  # Scene 1: Void – Chords + Grunt
  [ [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],

  # Scene 2: Tension – Add Drums and Growl
  [ [:play_chords, s_chords, 8], [:play_grain, s_grain, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_fm, s_bass, 8] ],

  # Scene 3: Drop – Add Alien Blips
  [ [:play_chords, s_chords, 8], [:play_grain, s_grain, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_fm, s_bass, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The growl bass: FM with rapidly changing divisor/depth
#   (2→4→3→2→5→2→3) creates a squelching, "talking" texture.
# - Half‑time tension: kick on 1 and snare on beat 3 with
#   syncopated ghosts – the engine's grid locks this aggressive
#   rhythm.
# - Alien blips: high divisor (4) and sparse placement (steps
#   4,6,10,12,14) pierce through the heavy low‑end.
# - Vocal grunt: pitched down to :fs2 with long grain (0.1s)
#   adds a monstrous foundation.
# ==========================================================
