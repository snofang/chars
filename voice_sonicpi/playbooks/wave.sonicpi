# ==========================================================
# PLAYBOOK: WAVE / CLOUD RAP
# Ethereal, Floating, Digital Cloud Atmosphere
# ==========================================================
# [WHY THIS GENRE?]
# Wave / Cloud Rap (SpaceGhostPurrp, Bladee) fuses half-time
# trap drums with massive, reverb‑soaked synth pads, deep
# booming 808s, and pitched‑up angelic vocal chops. This
# playbook captures that floating, internet‑era, melancholic
# atmosphere – like drifting through a digital cloud.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 140 BPM
# Key: F# minor (ethereal, dark, floating)
# Rhythm: Half‑time kick on 1 and ghost on the 'a' of 3,
# snare on beat 3, rolling trap hats with amplitude rolls.
# Timbre: Booming 808 bass (dsaw, long release), lush minor
# 9th chords (blade, high cutoff, long release), FM sine‑wave
# melody (divisor 3, depth 1, tape echo), pitched‑up angelic
# vocal drone (grain, high note, long size).
# Arrangement: Cloud (chords+grain+bass) → Flight (add drums)
# → Void (add FM melody).
# ==========================================================

use_bpm 140

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Half‑time kick – hits on step 0 and step 14
s_kick = gen_score("x.............x.",
  [{note: :c4, amp: 1.2}, {note: :c4, amp: 0.6}])

# Snare on beat 3 (step 8)
s_snare = gen_score("........x.......", [{note: :c4, amp: 0.9}])

# Fast rolling trap hats with amplitude roll
s_hats = gen_score("x...x.xxx...x.xx",
  [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.3}, {note: :c4, amp: 0.4},
   {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.5}, {note: :c4, amp: 0.6}])

# Booming 808 bass – long release for weight
s_bass = gen_score("x.......x.......",
  [{note: :fs1, release: 1.5, cutoff: 80},
   {note: :a1, release: 1.5, cutoff: 80}])

# Lush minor 9th chords – high cutoff for soaring brightness
s_chords = gen_score("x.......x.......",
  [{note: [:fs3, :a3, :c4, :e4], cutoff: 100, release: 2.0, amp: 0.6},
   {note: [:a3, :c4, :e4, :g4], cutoff: 100, release: 2.0, amp: 0.6}])

# Ethereal FM sine‑wave melody – routed through tape echo
s_fm = gen_score("....x.......x...",
  [{note: :fs5, amp: 0.6, divisor: 3, depth: 1, release: 1.0},
   {note: :e5, amp: 0.5, divisor: 3, depth: 1, release: 1.0}])

# Pitched‑up angelic vocal drone – long grains for celestial texture
s_grain = gen_score("x.......x.......",
  [{note: :a4, buffer: :ambi_choir, pos: 0.3, density: 1, size: 0.2, amp: 0.5},
   {note: :c5, buffer: :ambi_choir, pos: 0.5, density: 1, size: 0.2, amp: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Cloud – Chords, Grain, Bass
  [ [:play_chords, s_chords, 4], [:play_grain, s_grain, 4],
    [:play_sub, s_bass, 4] ],

  # Scene 2: Flight – Add Drums
  [ [:play_chords, s_chords, 8], [:play_grain, s_grain, 8],
    [:play_sub, s_bass, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],

  # Scene 3: Void – Add FM Melody
  [ [:play_chords, s_chords, 8], [:play_grain, s_grain, 8],
    [:play_sub, s_bass, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Angelic granular: pitching the vocal UP (a4, c5) with long
#   grains (size 0.2) creates a soaring celestial texture.
# - Half‑time float: kick on 1 and snare on beat 3 at 140 BPM
#   creates a slow 70 BPM feel; rolling hats fill the gaps.
# - Reverb‑soaked FM: divisor 3 and depth 1 produce a soft
#   sine wave; tape echo cascades the sparse notes across space.
# ==========================================================
