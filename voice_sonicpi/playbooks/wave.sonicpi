# ==========================================================
# PLAYBOOK: WAVE / CLOUD RAP
# (Pioneered by SpaceGhostPurrp, Bladee, and Liquid Stranger)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose Wave / Cloud Rap.
# We have explored dark trap (Phonk, Plugg) and ambient space (Balearic, 
# Ambient Techno). Wave is the sound of the modern underground internet. 
# It takes the half-time 140 BPM trap grid but replaces the aggression 
# with massive, reverb-soaked ethereal synth pads, deep booming 808s, 
# and pitched-up, angelic vocal chops that feel like floating through 
# a digital cloud.
#
# This playbook perfectly demonstrates how to use the Granular Synthesizer 
# to create an angelic, pitched-up vocal drone. By using a high `note` 
# and a long `size`, the engine turns a vocal sample into a soaring, 
# celestial texture that washes over the heavy 808s.
# ==========================================================

use_bpm 140

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Minor - Ethereal, Dark, & Floating)
# ==========================================================

# Half-time, heavy 808 kick. 
# Hits on step 0, and a ghost kick on the 'a' of 3 (step 14).
s_kick  = (ring {:note => :c4, :amp => 1.2}, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.6}, nil)

# Crisp, metallic snare strictly on beat 3 (step 8).
s_snare = (ring nil, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.9}, nil, nil, nil, nil, nil, nil, nil)

# Fast, rolling Trap hats with a rising amplitude roll.
s_hats  = (ring {:note => :c4, :amp => 0.3}, nil, nil, nil, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.3}, nil, nil, nil, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.5}, {:note => :c4, :amp => 0.6})

# Deep, booming 808 Bass (F# Minor).
# Massive release (1.5) allows the bass to ring out and carry the dark melody.
s_bass  = (ring {:note => :fs1, :release => 1.5, :cutoff => 80}, nil, nil, nil, nil, nil, nil, nil, {:note => :a1, :release => 1.5, :cutoff => 80}, nil, nil, nil, nil, nil, nil, nil)

# Lush, wide minor 9th chords (F#m9 to Am9).
# Hit on the downbeats. The high cutoff (100) and massive release (2.0) 
# create a soaring, reverb-soaked wall of sound.
s_chords= (ring {:note => [:fs3, :a3, :c4, :e4], :cutoff => 100, :release => 2.0, :amp => 0.6}, nil, nil, nil, nil, nil, nil, nil, {:note => [:a3, :c4, :e4, :g4], :cutoff => 100, :release => 2.0, :amp => 0.6}, nil, nil, nil, nil, nil, nil, nil)

# Ethereal, echoing "Synth String" Melody (F# Minor Pentatonic).
# Uses :play_fm with a high divisor (3) and low depth (1) to create a soft, 
# sine-like wave. Routed through the engine's tape echo for a cascading smear.
s_fm    = (ring nil, nil, nil, nil, {:note => :fs5, :amp => 0.6, :divisor => 3, :depth => 1, :release => 1.0}, nil, nil, nil, nil, nil, nil, nil, {:note => :e5, :amp => 0.5, :divisor => 3, :depth => 1, :release => 1.0}, nil, nil, nil)

# Pitched-up, angelic "Vocal" drone (Granular Synth).
# Pitched UP to :a4 and :c5. Long size (0.2) and low density (1) creates 
# a slow, evolving celestial texture that floats over the beat.
s_grain = (ring {:note => :a4, :buffer => :ambi_choir, :pos => 0.3, :density => 1, :size => 0.2, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil, {:note => :c5, :buffer => :ambi_choir, :pos => 0.5, :density => 1, :size => 0.2, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Cloud - Just the ethereal chords, vocal drone, and 808 (4 bars)
  [ [:play_chords, s_chords, 4], [:play_grain, s_grain, 4], [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Flight - Add the half-time drums and rolling hats (8 bars)
  [ [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], [:play_sub, s_bass, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Void - The echoing synth string melody drops (8 bars)
  [ [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], [:play_sub, s_bass, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN ETHEREAL BASS]
# 
# 1. Angelic Granular: Look at `s_grain`. The granular engine is given a 
#    high `note` (:a4, :c5) and a long `size` (0.2). By pitching the vocal 
#    UP and using sparse, long grains, the engine time-stretches the sample 
#    into a soaring, celestial drone that perfectly contrasts the deep, 
#    dark 808 bass.
#
# 2. The Half-Time Float: The engine's master clock is ticking at 140 BPM, 
#    but the kick and snare only hit on steps 0 and 8. This creates a 
#    slow, floating psychological tempo (70 BPM). The rolling hi-hats fill 
#    the gaps, creating a sense of fast forward momentum through a slow, 
#    spacious soundscape.
#
# 3. Reverb-Soaked FM: The `s_fm` sequence uses `divisor: 3` and `depth: 1`. 
#    This gentle ratio produces a soft, sine-like wave. Because it's routed 
#    through the engine's tape echo, the sparse notes cascade across the 
#    empty space, perfectly anchoring the track's melancholic, internet-era 
#    atmosphere.
# ==========================================================
