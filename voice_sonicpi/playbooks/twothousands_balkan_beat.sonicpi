# ==========================================================
# PLAYBOOK: 2000s BALKAN BEAT / GYPSY PUNK
# (Pioneered by Gogol Bordello, Shantel, and Balkan Beat Box)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 2000s Balkan Beat.
# We have explored Ska Punk and Afrobeat, but Balkan Beat is the sound of 
# Eastern European wedding parties crashing into Western punk clubs. 
# It fuses a frantic, driving 4/4 punk drum beat with rapid, syncopated 
# brass/accordion stabs, a continuous 16th-note bassline, and a harmonic 
# minor scale that sounds distinctly gypsy.
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create high-energy, live-band chaos. By pushing the `:play_fm` synth 
# to play rapid, staccato minor chords, the engine simulates a tight, 
# blasting horn section.
# ==========================================================

use_bpm 130

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (E Harmonic Minor - Frantic, High Energy, & Ethnic)
# ==========================================================

# Frantic, driving 4/4 punk kick.
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, echoing snare strictly on beats 2 and 4.
s_snare = gen_score("....x.......x...", [:c4])

# Fast, driving 8th hats. 
s_hats = gen_score("x.x.x.x.x.x.x.x.", [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}])

# The "Upright/Punk" Bass (E Harmonic Minor).
# Plays continuous, fast 8th notes. High cutoff (100) and short release (0.1) 
# create a punchy, aggressive "thwack" that drives the track.
bass_notes = [:e1, :e1, :e1, :e1, :d1, :d1, :d1, :d1, 
              :c1, :c1, :c1, :c1, :b0, :b0, :b0, :b0]
bass_data = bass_notes.map { |n| {note: n, cutoff: 100, release: 0.1, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# Tight, "Blasting Brass/Accordion" Stabs (Em to D to C to B).
# Uses :play_fm with a low divisor (2) and extreme depth (4) to create a 
# sharp, buzzy, staccato hit that mimics a live horn section.
chord_notes = [
  {note: [:e3, :g3, :b3]}, {note: [:e3, :g3, :b3]}, 
  {note: [:d3, :fs3, :a3]}, {note: [:c3, :e3, :g3]}
]
chord_data = chord_notes.map { |c| c.merge({divisor: 2, depth: 4, release: 0.15, amp: 0.6}) }
s_chords = gen_score("..x...x...x...x.", chord_data)

# Frantic, "Clarinet/Sax" Lead (E Harmonic Minor).
# Uses :play_fm with a high divisor (3) and low depth (1) to create a clean, 
# piercing tone. Plays a rapid, 16th-note melody.
lead_notes = [:e5, :fs5, :g5, :fs5, :e5, :d5, :c5, :b4, 
              :c5, :d5, :e5, :fs5, :g5, :a5, :b5, :a5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 1, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Group Vocals" shout (Granular Synth).
# Long size (0.08) and low density (1) creates a raw, repetitive vocal hit 
# that mimics a crowd shouting along.
s_vocal = gen_score("........x.......", [
  {note: :e3, buffer: :misc_lori, pos: 0.3, density: 1, size: 0.08, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Jam - Just the fast drums, driving bass, and brass stabs (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_fm, s_chords, 4] ],
  
  # Scene 2: The Vibe - Add the group vocals (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drop - The frantic clarinet melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN ETHNIC PUNK]
# 
# 1. The Harmonic Minor Scale: Look at `s_lead`. The melody uses E, F#, G, 
#    A, B, C, D#, and E. The augmented 2nd interval between D and D# 
#    creates the exotic, "gypsy" sound that defines Balkan and Eastern 
#    European folk music. The engine's strict 16-step grid ensures this 
#    rapid, complex melody fires with absolute mathematical precision.
#
# 2. FM as a Brass Section: Look at `s_chords`. The `:play_fm` synth is 
#    given a `divisor` of `2` and a `depth` of `4`, with a short `release` 
#    (0.15). This forces the FM synth to produce a sharp, buzzy, staccato 
#    "hit" that perfectly mimics a live horn section or accordion blasting 
#    out the off-beats.
#
# 3. The Punk Rock Drive: Balkan Beat relies on a frantic, relentless 
#    rhythm section. The `s_bass` plays continuous 8th notes with a high 
#    `cutoff` (100) to mimic an aggressive, picked upright bass. The 
#    engine's strict master clock ensures this driving momentum locks 
#    perfectly with the fast 8th-note hats, creating a high-energy, 
#    wedding-party atmosphere.
# ==========================================================
