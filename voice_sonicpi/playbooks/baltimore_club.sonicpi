# ==========================================================
# PLAYBOOK: BALTIMORE CLUB
# Raw, Galloping, Choppy Vocal Energy
# ==========================================================
# [WHY THIS GENRE?]
# Baltimore Club (DJ Technics, Rod Lee) is the Godfather of
# the 130 BPM bounce – a galloping kick, heavy snare, raw 808
# punch, and heavily chopped R&B vocal stutters. This playbook
# captures that frantic, physical, club‑ready energy.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 130 BPM
# Key: G minor (raw, dark)
# Rhythm: Baltimore Break kick (1, 'and' of 2, beat 3, rapid
# 16th stutter on 'e' and 'and' of 4), snare on 2/4 with ghost
# on 'a' of 2, relentless 16th hats, raw 808 bass with short
# release, staccato minor chords on off‑beats, chopped granular
# vocal stabs.
# Timbre: Punchy kick (bd_haus with accents), heavy dry snare
# (sn_dolf), driving hats (cymbal_closed with amp layers),
# raw 808 bass (dsaw, short release), minor chord stabs (blade),
# granular vocal chops (ambi_choir, high density, tiny size).
# Arrangement: Break (drums only) → Groove (add bass+chords)
# → Club (add vocal chops).
# ==========================================================

use_bpm 130

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Baltimore Break kick – galloping stutter on steps 10 and 11
s_kick = gen_score("x.....x.x.xx....",
  [:c4,
   {note: :c4, amp: 0.8},
   {note: :c4, amp: 1.0},
   {note: :c4, amp: 0.6},
   {note: :c4, amp: 0.9}])

# Heavy snare on 2/4 with ghost on 'a' of 2 (step 7)
s_snare = gen_score("....x..x....x...",
  [{note: :c4, amp: 1.0},
   {note: :c4, amp: 0.4},
   {note: :c4, amp: 1.0}])

# Relentless 16th hats with dynamic amplitudes
hat_data = [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3}
]
s_hats = gen_score("x.xxx.x.xx.xxx.x.", hat_data)

# Raw 808 bass – short release for rhythmic punch
s_bass = gen_score("x...x.x.x...x...",
  [{note: :g1, release: 0.2},
   {note: :g1, release: 0.2},
   {note: :bb1, release: 0.2},
   {note: :c2, release: 0.2},
   {note: :bb1, release: 0.2}])

# Staccato minor chord stabs on off‑beats (steps 3 and 11)
s_chords = gen_score("...x.......x....",
  [[:g3, :bb3, :d4],
   [:bb3, :db4, :f4]])

# Chopped R&B vocal stutters – granular percussion (steps 2,6,11)
s_vocal = gen_score("..x...x....x....",
  [{note: :g4, buffer: :ambi_choir, pos: 0.3, density: 3, size: 0.03, amp: 0.6},
   {note: :bb4, buffer: :ambi_choir, pos: 0.5, density: 3, size: 0.03, amp: 0.6},
   {note: :d5, buffer: :ambi_choir, pos: 0.7, density: 3, size: 0.03, amp: 0.6}])

# Playbook
playbook = (ring
  # Scene 1: Break – Drums only
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4],
    [:play_hats, s_hats, 4] ],

  # Scene 2: Groove – Add Bass and Chords
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3: Club – Add Vocal Chops
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The galloping kick: steps 10 and 11 create a rapid 16th
#   stutter that physically lurches the track forward.
# - Raw 808 punch: short release (0.2) cuts the bass, turning
#   it into a sharp rhythmic punch.
# - Percussive vocals: granular chops (size 0.03, density 3)
#   turn a vocal sample into raw, rhythmic stabs – the engine
#   locks them with absolute precision.
# ==========================================================
