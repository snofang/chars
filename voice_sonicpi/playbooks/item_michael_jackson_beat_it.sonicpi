# ==========================================================
# PLAYBOOK: MICHAEL JACKSON - "BEAT IT" (1982)
# ==========================================================

use_bpm 138

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (Eb Minor - Heavy, Driving, & Iconic)
# ==========================================================

# Driving 4/4 rock/funk kick. (4 x's, 1 element)
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, echoing snare strictly on beats 2 and 4. (2 x's, 1 element)
s_snare = gen_score("....x.......x...", [:c4])

# Rigid, driving 16th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Moog" Synth Bass (Eb Minor).
# Plays the iconic, driving, descending 16th-note line. 
# High cutoff (100) and microscopic release (0.06) create a relentless, 
# hypnotic, buzzing analog churn. (16 x's, 16 elements)
bass_notes = [:eb2, :eb2, :eb2, :eb2, :ab2, :ab2, :gb2, :gb2, 
              :f2, :f2, :e2, :e2, :eb2, :eb2, :eb2, :eb2]
bass_data = bass_notes.map { |n| {note: n, cutoff: 100, release: 0.06, amp: 1.0} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Stark, "Synth/Brass" Stabs (Ebm to Abm).
# Uses :play_fm with a low divisor (2) and mid depth (4) to create a harsh, 
# staccato hit. Hit strictly on the off-beats. (3 x's, 3 elements)
s_chords = gen_score("..x.....x.x.....", [
  {note: [:eb3, :gb3, :bb3], divisor: 2, depth: 4, release: 0.1, amp: 0.5},
  {note: [:eb3, :gb3, :bb3], divisor: 2, depth: 4, release: 0.1, amp: 0.5},
  {note: [:ab3, :cb4, :eb4], divisor: 2, depth: 4, release: 0.1, amp: 0.5}
])

# Piercing, "Guitar Solo" Lead (Eb Minor Pentatonic).
# Uses :play_lead routed through the global tape echo bus. The long release (0.2) 
# creates a soaring, echoing, chaotic solo that mimics Eddie Van Halen's legendary 
# performance. (6 x's, 6 elements)
lead_notes = [:eb5, :db5, :bb4, :ab4, :bb4, :db5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, cutoff: 110, release: 0.2} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Beat it" Vocal Stutter (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched DOWN.
# High density, tiny size = a sharp, percussive, aggressive vocal skip. (2 x's, 2 elements)
s_vocal = gen_score("....x.......x...", [
  {note: :eb3, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.04, amp: 0.7},
  {note: :gb3, buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the driving Moog bass, synth stabs, and vocal chops (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Verse - Add the heavy, driving 4/4 rock drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Solo - The piercing, soaring guitar solo drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN FUNK-ROCK POP]
# 
# 1. The Moog Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step, mapping out the iconic, descending line 
#    (Eb-Ab-Gb-F-E-Eb). By using a high `cutoff` (100) and a microscopic 
#    `release` (0.06), the engine creates a relentless, hypnotic, buzzing churn 
#    that perfectly mimics the legendary Moog synthesizer bassline that drives 
#    the track.
#
# 2. The Guitar Solo: The `s_lead` sequence uses the Prophet synth with a 
#    high `cutoff` (110) and a long `release` (0.2). Because it's routed 
#    through the global tape echo bus, the rapid notes smear into a soaring, 
#    chaotic, echoing solo that perfectly mimics the legendary, whammy-bar 
#    guitar performance by Eddie Van Halen.
#
# 3. The Stark Stabs: Look at `s_chords`. The `:play_fm` synth is given 
#    a `divisor` of `2` and a `depth` of `4`, with a microscopic `release` 
#    (0.1). This forces the FM synth to produce a harsh, staccato "hit" that 
#    perfectly mimics the stark, orchestral synth-brass stabs that punctuate 
#    the groove.
# ==========================================================
