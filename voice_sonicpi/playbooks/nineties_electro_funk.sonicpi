# ==========================================================
# PLAYBOOK: 80s ELECTRO FUNK / HIP-HOP ORIGINS
# (Pioneered by Afrika Bambaataa, Soulsonic Force, and Egyptian Lover)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 80s Electro Funk.
# We have explored Detroit Techno and Miami Bass, but Electro Funk is the 
# absolute genesis of hip-hop and electronic dance music. Pioneered by 
# Afrika Bambaataa's "Planet Rock," it relies entirely on the legendary 
# Roland TR-808 drum machine. It features a relentless, syncopated 808 
# kick pattern, continuous 16th-note hi-hats, a robotic, vocoder-style 
# synth bass, and a piercing, "Kraftwerk" inspired FM lead. 
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create the iconic "Planet Rock" bounce. By using a high `cutoff` on the 
# `:play_sub` synth to simulate a robotic 808 bass, and the `:play_fm` 
# synth to simulate a vocoder melody, the engine creates a futuristic, 
# robotic, and deeply funky 80s atmosphere.
# ==========================================================

use_bpm 115

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Robotic, Bouncy, & 808-Driven)
# ==========================================================

# The "Planet Rock" Kick. 
# A syncopated, bouncy 808 pattern. (5 x's, 5 elements)
s_kick = gen_score("x..x..x.x..x....", [
  :c4, {note: :c4, amp: 0.8}, :c4, {note: :c4, amp: 0.6}, :c4
])

# Crisp, 808 snare strictly on beats 2 and 4, with a syncopated ghost note. 
# (3 x's, 3 elements)
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.9}
])

# Rigid, alternating 16th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Robotic" Synth Bass (A Minor).
# Plays continuous 16th notes, alternating octaves. 
# High cutoff (100) and short release (0.08) create a relentless, 
# bouncy, robotic "thwack" that mimics an 808 bass. (16 x's, 16 elements)
bass_cycle = [:a1, :a2, :a1, :a2, :a1, :a2, :a1, :a2, 
              :g1, :g2, :g1, :g2, :a1, :a2, :a1, :a2]
bass_data = bass_cycle.map { |n| {note: n, cutoff: 100, release: 0.08, amp: 1.0} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Stark, "Vocoder" Synth Stabs (Am to G).
# Uses :play_fm with a low divisor (2) and mid depth (3) to create a sharp, 
# robotic staccato hit. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:a3, :c4, :e4], divisor: 2, depth: 3, release: 0.15, amp: 0.5},
  {note: [:a3, :c4, :e4], divisor: 2, depth: 3, release: 0.15, amp: 0.5},
  {note: [:g3, :bb3, :d4], divisor: 2, depth: 3, release: 0.15, amp: 0.5},
  {note: [:g3, :bb3, :d4], divisor: 2, depth: 3, release: 0.15, amp: 0.5}
])

# Piercing, "Kraftwerk" FM Lead (A Minor Pentatonic).
# Uses :play_fm with a high divisor (4) and low depth (2) to create a pristine, 
# glassy, computer-like tone. Routed through the engine's tape echo. 
# (8 x's, 8 elements)
lead_notes = [:a5, :e5, :c6, :e5, :a5, :e5, :c6, :e5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 4, depth: 2, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Robotic" Vocal Chops (Granular Synth).
# High density, tiny size = a sharp, pristine, vocoder-style vocal skip. 
# (1 x, 1 element)
s_vocal = gen_score("........x.......", [
  {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Grid - Just the 808s, robotic bass, and hats (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_hats, s_hats, 4] ],
  
  # Scene 2: The Vibe - Add the vocoder stabs and robotic vocals (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8], 
    [:play_snare, s_snare, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drop - The piercing Kraftwerk FM lead drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8], 
    [:play_snare, s_snare, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN 808 FUNK]
# 
# 1. The "Planet Rock" Bounce: Look at `s_kick`. It completely avoids landing 
#    on the standard 4/4 pulse. By hitting on syncopated, bouncy steps 
#    (0, 3, 6, 8, 11), the engine creates a lopsided, "dancing" groove that 
#    feels like a live 808 drum machine. The engine's strict master clock 
#    ensures this complex rhythm lands with absolute precision, creating the 
#    signature Electro Funk bounce.
#
# 2. The Robotic Synth Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step, alternating octaves. By using a high `cutoff` 
#    (100) and a short `release` (0.08), the engine turns the detuned sawtooth 
#    into a relentless, bouncy, robotic "thwack" that perfectly mimics the 
#    808 basslines of 80s Electro Funk.
#
# 3. FM as a Vocoder: The `s_lead` sequence uses `divisor: 4` and `depth: 2`. 
#    This gentle harmonic ratio produces a pristine, glassy, sine-like wave 
#    that sounds more like a 1980s mainframe computer than a synthesizer. By 
#    playing a repetitive, 8th-note melody, the engine creates a quirky, 
#    robotic hook that perfectly mimics the Kraftwerk-inspired vocoder melodies 
#    of Afrika Bambaataa and the Soulsonic Force.
# ==========================================================
