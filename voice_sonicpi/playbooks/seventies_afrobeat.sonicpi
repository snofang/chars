# ==========================================================
# PLAYBOOK: 70s AFROBEAT / FELA KUTI STYLE
# (Pioneered by Fela Kuti, Tony Allen, and Africa 70)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 70s Afrobeat.
# We have explored P-Funk and Salsa, but Afrobeat is the sound of 70s 
# Lagos, Nigeria. It fuses traditional Yoruba polyrhythms with American 
# funk and jazz. It relies on a highly syncopated, 3-3-2 drum pattern 
# (the "Afrobeat Groove"), continuous 16th-note shakers, a deep, melodic 
# bassline, and tight, 2-note "chuka" guitar stabs on the off-beats.
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create a massive, interlocking, live-band funk groove. By using the 
# `:play_pluck` synth for the off-beat guitar and `:play_fm` for the 
# brass section, the engine creates a relentless, hypnotic, and deeply 
# funky atmosphere.
# ==========================================================

use_bpm 105

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Minor - Funky, Hypnotic, & Polyrhythmic)
# ==========================================================

# The "Afrobeat" Kick. 
# A 3-3-2 syncopated pulse. Hits on step 0, the 'and' of 2 (step 6), 
# beat 3 (step 8), and the 'a' of 3 (step 11).
s_kick = gen_score("x.....x.x..x....", [
  :c4, {note: :c4, amp: 0.8}, :c4, {note: :c4, amp: 0.6}
])

# Heavy, organic snare/rimshot on beats 2 and 4, with a syncopated 
# ghost note on the 'e' of 3 (step 10).
s_snare = gen_score("....x...x.x.....", [
  :c4, {note: :c4, amp: 0.4}, {note: :c4, amp: 0.9}
])

# Relentless, continuous 16th shaker. 
# Notice the heavy amplitude manipulation to simulate a human percussionist.
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}, 
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2}
])

# Deep, melodic bass (D Dorian).
# Plays a syncopated line. Low cutoff (70) and medium release (0.2) 
# to create a warm, muffled undercurrent.
s_bass = gen_score("x.....x.x.....x.", [
  {note: :d1, release: 0.2, cutoff: 70, amp: 1.2}, 
  {note: :f1, release: 0.2, cutoff: 70, amp: 1.0}, 
  {note: :c2, release: 0.2, cutoff: 70, amp: 1.0}, 
  {note: :d1, release: 0.2, cutoff: 70, amp: 1.0}
])

# The "Chuka" Guitar Stabs (Dm).
# Uses :play_pluck. Hits strictly on the off-beats to leave maximum room 
# for the syncopated kick and bass.
s_guitar = gen_score("..x...x...x...x.", [
  {note: [:d3, :a3], amp: 0.5, release: 0.1, coef: 0.4}, 
  {note: [:d3, :a3], amp: 0.5, release: 0.1, coef: 0.4}
])

# Tight, "Horn Section" Stabs (Dm to Cmaj).
# Uses :play_fm with a low divisor (2) and depth (3) to create a warm, 
# brassy staccato hit that mimics a live horn section.
s_chords = gen_score("x.......x.......", [
  {note: [:d3, :f3, :a3], divisor: 2, depth: 3, release: 0.3, amp: 0.6},
  {note: [:c3, :e3, :g3], divisor: 2, depth: 3, release: 0.3, amp: 0.6}
])

# Piercing, "Lead Sax" Melody (D Dorian Pentatonic).
# Uses :play_fm with a high divisor (3) and low depth (1) to create a 
# clean, piercing brass tone. Routed through the engine's tape echo.
lead_notes = [:d4, :a4, :c5, :d5, :c5, :a4, :g4, :a4]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 1, release: 0.3} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Call-and-Response" vocal chant (Granular Synth).
# Pitched-down to :d3. Long size (0.1) creates a raw, repetitive vocal hit.
s_vocal = gen_score("........x.......", [
  {note: :d3, buffer: :misc_lori, pos: 0.2, density: 1, size: 0.1, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the interlocking drums, bass, and guitar (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_pluck, s_guitar, 4] ],
  
  # Scene 2: The Vibe - Add the horn stabs and vocal chants (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_pluck, s_guitar, 8], [:play_fm, s_chords, 8], 
    [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drop - The piercing lead sax melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_pluck, s_guitar, 8], [:play_fm, s_chords, 8], 
    [:play_grain, s_vocal, 8], [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN POLYRHYTHM]
# 
# 1. The 3-3-2 Syncopation: Look at `s_kick`. It completely avoids landing 
#    on the standard 4/4 pulse. By hitting on steps 0, 6, 8, and 11, the 
#    engine creates a lopsided, hypnotic groove that feels like a live 
#    drummer playing a traditional Yoruba rhythm. The engine's strict 
#    master clock ensures this complex rhythm lands with absolute precision.
#
# 2. The "Chuka" Guitar: Look at `s_guitar`. The `:play_pluck` synth hits 
#    strictly on steps 2, 6, 10, and 14. In a 16-step grid, these are the 
#    exact midpoints between the beats. By using a short `release` (0.1) 
#    and a low `coef` (0.4), the engine turns the pluck into a sharp, 
#    staccato "chuka" that perfectly mimics the off-beat guitar strums 
#    that define Afrobeat.
#
# 3. FM as a Saxophone: The `s_lead` sequence uses `divisor: 3` and `depth: 1`. 
#    This gentle harmonic ratio produces a clean, piercing tone that mimics 
#    a lead saxophone. Routed through the engine's tape echo, the sparse 
#    notes cascade across the empty space, perfectly anchoring the track's 
#    hypnotic, jazz-funk atmosphere.
# ==========================================================
