# ==========================================================
# PLAYBOOK: BREAKCORE / MASHCORE
# Chaotic, Distorted, Frantic Glitch Energy
# ==========================================================
# [WHY THIS GENRE?]
# Breakcore (Venetian Snares, Igorrr) shatters the Amen break
# into microscopic, chaotic fragments at 180 BPM, paired with
# distorted bass and erratic classical‑sounding FM stabs. This
# playbook captures that beautiful, controlled chaos.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 180 BPM
# Key: A minor (dark, frantic)
# Rhythm: Shattered kick (1, 'a' of 1, 'and' of 2, beat 3,
# 'e' of 4), Amen snare with rolls (2/4 with 'a' of 3 and beat 4
# stutters), erratic 16th hats with random amplitude, continuous
# rolling bass, spastic chord stabs, frantic harpsichord lead,
# sliced vocal glitches.
# Timbre: Punched kick (bd_haus with accents), heavy snare
# (sn_dolf with rolls), erratic hats (cymbal_closed with amp
# layers), distorted Reese bass (dsaw, extreme cutoff, short
# release), spastic classical chord stabs (blade), harpsichord‑
# style FM lead (divisor 2, depth 3), glitchy granular vocal.
# Arrangement: Chaos (drums+bass) → Tension (add chord stabs)
# → Meltdown (add harpsichord+vocal glitches).
# ==========================================================

use_bpm 180

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Shattered kick – highly syncopated (indices 0,3,5,8,10,13)
s_kick = gen_score("x..x.x..x.x..x..",
  [{note: :c4, amp: 1.0},
   {note: :c4, amp: 0.7},
   {note: :c4, amp: 0.9},
   {note: :c4, amp: 1.0},
   {note: :c4, amp: 0.6},
   {note: :c4, amp: 0.8}])

# Amen snare – heavy hits with rolls (indices 4,7,11,12,14,15)
s_snare = gen_score("....x..x...x.xx.",
  [{note: :c4, amp: 1.0},
   {note: :c4, amp: 0.4},
   {note: :c4, amp: 0.9},
   {note: :c4, amp: 1.0},
   {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.5}])

# Erratic hats – all 16 steps with amplitude variation
hat_amps = [0.2, 0.4, 0.1, 0.3, 0.4, 0.2, 0.3, 0.1,
            0.4, 0.2, 0.1, 0.3, 0.4, 0.2, 0.1, 0.3]
s_hats = gen_score("xxxxxxxxxxxxxxxx",
  hat_amps.map { |a| {note: :c4, amp: a} })

# Distorted rolling bass – all 16 steps, extreme cutoff
bass_notes = [:a1, :a1, :a2, :a1, :a1, :a1, :e1, :e1,
              :a1, :a1, :a2, :a1, :g1, :g1, :f1, :e1]
s_bass = gen_score("xxxxxxxxxxxxxxxx",
  bass_notes.map { |n| {note: n, release: 0.1, cutoff: 120} })

# Spastic classical chord stabs (indices 0,5,8,13)
s_chords = gen_score("x...x...x...x...",
  [[:a3, :c4, :e4],
   [:a3, :c4, :e4],
   [:g3, :bb3, :d4],
   [:f3, :a3, :c4]])

# Harpsichord‑style FM lead – erratic (indices 0,2,3,5,7,8,10,12,13,15)
fm_data = [
  {note: :a5, divisor: 2, depth: 3, release: 0.05},
  {note: :e5, divisor: 2, depth: 3, release: 0.05},
  {note: :a5, divisor: 2, depth: 3, release: 0.05},
  {note: :c6, divisor: 2, depth: 3, release: 0.05},
  {note: :b5, divisor: 2, depth: 3, release: 0.05},
  {note: :a5, divisor: 2, depth: 3, release: 0.05},
  {note: :g5, divisor: 2, depth: 3, release: 0.05},
  {note: :e5, divisor: 2, depth: 3, release: 0.05},
  {note: :f5, divisor: 2, depth: 3, release: 0.05},
  {note: :e5, divisor: 2, depth: 3, release: 0.05}
]
s_fm = gen_score("x.xx.x.xx.x.xx.x", fm_data)

# Sliced vocal glitch – microscopic grains (indices 0,2,4,6,7,10,13)
vocal_data = [
  {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.02, amp: 0.6},
  {note: :c5, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.02, amp: 0.5},
  {note: :e4, buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.02, amp: 0.6},
  {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.02, amp: 0.4},
  {note: :d5, buffer: :ambi_choir, pos: 0.6, density: 3, size: 0.02, amp: 0.6},
  {note: :c5, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.02, amp: 0.5},
  {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.02, amp: 0.7}
]
s_vocal = gen_score("x.x.x.xx..x..x..", vocal_data)

# Playbook
playbook = (ring
  # Scene 1: Chaos – Shattered Drums + Distorted Bass
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4],
    [:play_hats, s_hats, 4], [:play_sub, s_bass, 4] ],

  # Scene 2: Tension – Add Spastic Chords
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3: Meltdown – Add Harpsichord and Vocal Glitches
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8], [:play_lead, s_fm, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The shattered Amen: kick and snare avoid landing on the
#   same beats – the engine's grid precision creates the
#   signature Breakcore "chatter."
# - Distorted rolling bass: extreme cutoff (120) pushes dsaw
#   into overdrive, creating a grinding low‑end anchor.
# - FM as harpsichord: divisor 2 and depth 3 produce a sharp,
#   buzzy square wave – the engine's clock turns the grid
#   into a beautiful, controlled glitch.
# - Vocal glitches: microscopic grains (size 0.02, density 3)
#   chop the voice into rhythmic shards.
# ==========================================================
