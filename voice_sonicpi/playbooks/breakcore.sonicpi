# ==========================================================
# PLAYBOOK: BREAKCORE / MASHCORE
# (Pioneered by Venetian Snares, Igorrr, and goreshit)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose Breakcore.
# We have explored fast, 4/4 genres (Gabber, Singeli) and broken beats 
# (Jungle, Footwork). Breakcore is the absolute extreme of the 16-step 
# grid. Operating at 180 BPM, it takes the "Amen" break and shatters it 
# into microscopic, chaotic fragments, pairing it with distorted bass 
# and erratic, classical-sounding FM synth stabs.
#
# This playbook perfectly demonstrates how to push the engine's master 
# clock to its rhythmic limit. By filling the 16-step grid with dense, 
# overlapping ghost notes and rapid amplitude changes, the engine 
# creates a frantic, mathematical wall of sound that feels like a 
# beautiful, controlled glitch.
# ==========================================================

use_bpm 180

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Chaotic, Distorted, & Frantic)
# ==========================================================

# The "Shattered" Kick. 
# Highly syncopated, hits on step 0, the 'a' of 1 (step 3), 
# the 'and' of 2 (step 6), beat 3 (step 8), and the 'e' of 4 (step 12).
s_kick  = (ring {:note => :c4, :amp => 1.0}, nil, nil, {:note => :c4, :amp => 0.7}, nil, {:note => :c4, :amp => 0.9}, nil, nil, {:note => :c4, :amp => 1.0}, nil, {:note => :c4, :amp => 0.6}, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil)

# The "Amen" Snare. 
# Heavy hits on 2 and 4, with frantic rolls on the 'a' of 3 and beat 4.
s_snare = (ring nil, nil, nil, nil, {:note => :c4, :amp => 1.0}, nil, nil, {:note => :c4, :amp => 0.4}, nil, nil, nil, {:note => :c4, :amp => 0.9}, {:note => :c4, :amp => 1.0}, nil, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.5})

# Relentless, erratic 16th hats with random amplitude manipulation.
s_hats  = (ring {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.1}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.1}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.1}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.1}, {:note => :c4, :amp => 0.3})

# Distorted, rolling Reese Bass (A Minor).
# Plays continuous 16th notes. Extreme cutoff (120) creates a grinding, 
# distorted wall of low-end that anchors the chaotic drums.
s_bass  = (ring {:note => :a1, :release => 0.1, :cutoff => 120}, {:note => :a1, :release => 0.1, :cutoff => 120}, {:note => :a2, :release => 0.1, :cutoff => 120}, {:note => :a1, :release => 0.1, :cutoff => 120}, 
           {:note => :a1, :release => 0.1, :cutoff => 120}, {:note => :a1, :release => 0.1, :cutoff => 120}, {:note => :e1, :release => 0.1, :cutoff => 120}, {:note => :e1, :release => 0.1, :cutoff => 120}, 
           {:note => :a1, :release => 0.1, :cutoff => 120}, {:note => :a1, :release => 0.1, :cutoff => 120}, {:note => :a2, :release => 0.1, :cutoff => 120}, {:note => :a1, :release => 0.1, :cutoff => 120}, 
           {:note => :g1, :release => 0.1, :cutoff => 120}, {:note => :g1, :release => 0.1, :cutoff => 120}, {:note => :f1, :release => 0.1, :cutoff => 120}, {:note => :e1, :release => 0.1, :cutoff => 120})

# Spastic, classical-sounding chord stabs (Am to G to F).
# Hit erratically to mimic the orchestral samples used in Breakcore.
s_chords= (ring [:a3, :c4, :e4], nil, nil, nil, nil, [:a3, :c4, :e4], nil, nil, [:g3, :bb3, :d4], nil, nil, nil, nil, [:f3, :a3, :c4], nil, nil)

# Erratic, "Harpsichord/Classical" FM Lead (A Harmonic Minor).
# Uses :play_fm with a low divisor (2) and depth (3) to create a sharp, 
# buzzy harpsichord tone that dances frantically over the breakbeat.
s_fm    = (ring {:note => :a5, :divisor => 2, :depth => 3, :release => 0.05}, nil, {:note => :e5, :divisor => 2, :depth => 3, :release => 0.05}, {:note => :a5, :divisor => 2, :depth => 3, :release => 0.05}, nil, {:note => :c6, :divisor => 2, :depth => 3, :release => 0.05}, nil, {:note => :b5, :divisor => 2, :depth => 3, :release => 0.05}, {:note => :a5, :divisor => 2, :depth => 3, :release => 0.05}, nil, {:note => :g5, :divisor => 2, :depth => 3, :release => 0.05}, nil, {:note => :e5, :divisor => 2, :depth => 3, :release => 0.05}, {:note => :f5, :divisor => 2, :depth => 3, :release => 0.05}, nil, {:note => :e5, :divisor => 2, :depth => 3, :release => 0.05})

# Sliced, glitchy vocal "Skip" (Granular Synth).
# High density, tiny size = a microscopic, rhythmic vocal glitch.
s_vocal = (ring {:note => :a4, :buffer => :ambi_choir, :pos => 0.1, :density => 3, :size => 0.02, :amp => 0.6}, nil, {:note => :c5, :buffer => :ambi_choir, :pos => 0.2, :density => 3, :size => 0.02, :amp => 0.5}, nil, {:note => :e4, :buffer => :ambi_choir, :pos => 0.4, :density => 3, :size => 0.02, :amp => 0.6}, nil, {:note => :a4, :buffer => :ambi_choir, :pos => 0.1, :density => 3, :size => 0.02, :amp => 0.4}, {:note => :d5, :buffer => :ambi_choir, :pos => 0.6, :density => 3, :size => 0.02, :amp => 0.6}, nil, nil, {:note => :c5, :buffer => :ambi_choir, :pos => 0.2, :density => 3, :size => 0.02, :amp => 0.5}, nil, nil, {:note => :a4, :buffer => :ambi_choir, :pos => 0.1, :density => 3, :size => 0.02, :amp => 0.7}, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Chaos - Just the shattered breakbeat and distorted bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Tension - Add the spastic classical chord stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Meltdown - The frantic harpsichord and vocal glitches drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], 
    [:play_lead, s_fm, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN CONTROLLED CHAOS]
# 
# 1. The Shattered Amen: Look at `s_kick` and `s_snare`. They completely 
#    avoid landing on the same beats. The engine's strict master clock 
#    ensures these complex, overlapping hits land with the precision of a 
#    hardware sampler block, creating that signature Breakcore "chatter" 
#    that feels like a live drummer having a seizure.
#
# 2. Distorted Rolling Bass: Look at `s_bass`. It plays on EVERY single 
#    16th step at 180 BPM. By using an extreme `cutoff` (120), the engine 
#    forces the `:dsaw` synth into overdrive, creating a grinding, 
#    distorted wall of low-end that perfectly anchors the frantic drums.
#
# 3. FM as a Harpsichord: The `s_fm` sequence uses `divisor: 2` and 
#    `depth: 3`. This narrows the harmonic ratio to produce a sharp, buzzy 
#    square wave that perfectly mimics the classical harpsichord samples 
#    used by artists like Igorrr and Venetian Snares. The engine's strict 
#    clock ensures these erratic notes fire with absolute mathematical 
#    precision, turning the 16-step grid into a beautiful, controlled glitch.
# ==========================================================
