# ==========================================================
# PLAYBOOK: KRAUTROCK / COSMIC SEQUENCER
# Hypnotic, Motorik, Filter‑Sweep Arpeggios
# ==========================================================
# [WHY THIS GENRE?]
# Krautrock (Neu!, Can) is built on a relentless "motorik"
# 4/4 drum pulse, repetitive 16th‑note bass sequences, and
# evolving filter‑sweep arpeggios. This playbook captures
# that hypnotic, mechanical, cosmic drive.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 120 BPM
# Key: A minor (dark, hypnotic)
# Rhythm: Steady 4/4 kick, snare on 2/4, hi‑hats on every 8th,
# continuous 16th bass with alternating amplitudes,
# continuous 16th arpeggio with filter sweep across steps.
# Timbre: Motorik drums (kick, snare, hats), analog bass
# (dsaw with amp modulation), arpeggio lead (prophet with
# cutoff sweep), granular cosmic drone (ambi_choir, long size),
# dark pad (dark_ambience, long attack/release).
# Arrangement: Drone+Drums (pad+grain+kick+hats) → Bass
# (add 16th bass) → Arpeggio (add filter‑sweep lead).
# ==========================================================

use_bpm 120

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Motorik kick – 4/4 on every beat
s_kick = gen_score("x...x...x...x...", [:c4])

# Snare on beats 2 and 4
s_snare = gen_score("....x.......x...", [:c4])

# Hi‑hats on every 8th step (even positions) with constant amp
s_hats = gen_score("x.x.x.x.x.x.x.x.", [{note: :c4, amp: 0.3}])

# Relentless 16th‑note bass – alternating amplitudes for mechanical pump
bass_data = [
  {note: :a2, amp: 0.8}, {note: :a2, amp: 0.4},
  {note: :e2, amp: 0.8}, {note: :a2, amp: 0.4},
  {note: :a2, amp: 0.8}, {note: :a2, amp: 0.4},
  {note: :g2, amp: 0.8}, {note: :a2, amp: 0.4},
  {note: :a2, amp: 0.8}, {note: :a2, amp: 0.4},
  {note: :e2, amp: 0.8}, {note: :a2, amp: 0.4},
  {note: :c3, amp: 0.8}, {note: :c3, amp: 0.4},
  {note: :g2, amp: 0.8}, {note: :a2, amp: 0.4}
]
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Filter‑sweep arpeggio – cutoff opens from 70 to 110 then back
seq_data = [
  {note: :a4, cutoff: 70}, {note: :a4, cutoff: 75},
  {note: :e4, cutoff: 80}, {note: :a4, cutoff: 85},
  {note: :c5, cutoff: 90}, {note: :a4, cutoff: 95},
  {note: :e4, cutoff: 100}, {note: :a4, cutoff: 105},
  {note: :a4, cutoff: 110}, {note: :a4, cutoff: 105},
  {note: :e4, cutoff: 100}, {note: :a4, cutoff: 95},
  {note: :c5, cutoff: 90}, {note: :c5, cutoff: 85},
  {note: :g4, cutoff: 80}, {note: :a4, cutoff: 75}
]
s_seq = gen_score("xxxxxxxxxxxxxxxx", seq_data)

# Cosmic granular drone – long grains, evolving texture
s_grain = gen_score("x.......x.......",
  [{note: :a3, buffer: :ambi_choir, pos: 0.3, density: 2, size: 0.2, amp: 0.6},
   {note: :g3, buffer: :ambi_choir, pos: 0.6, density: 2, size: 0.2, amp: 0.5}])

# Dark pad – long attack and release for sustained drone
s_pad = gen_score("x.......x.......",
  [{note: :a2, release: 4.0, attack: 2.0},
   {note: :g2, release: 4.0, attack: 2.0}])

# Playbook
playbook = (ring
  # Scene 1: Drone + Motorik Drums
  [ [:play_pad, s_pad, 4], [:play_grain, s_grain, 4],
    [:play_kick, s_kick, 4], [:play_hats, s_hats, 4] ],

  # Scene 2: Add relentless 16th‑note bass
  [ [:play_pad, s_pad, 8], [:play_grain, s_grain, 8],
    [:play_kick, s_kick, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8] ],

  # Scene 3: Add filter‑sweep arpeggio
  [ [:play_pad, s_pad, 8], [:play_grain, s_grain, 8],
    [:play_kick, s_kick, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_lead, s_seq, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Motorik drums: steady 4/4 kick and hats create a mechanical,
#   hypnotic pulse that drives the track forward.
# - Relentless bass: 16th‑note sequence with alternating amplitudes
#   (0.8/0.4) adds a pumping, sidechain‑like feel.
# - Filter‑sweep arpeggio: cutoff values gradually open and close
#   across the 16‑step grid – a pure data‑driven LFO simulation.
# - Cosmic textures: granular drone and dark pad provide a vast,
#   swirling backdrop for the mechanical sequencer patterns.
# ==========================================================
