use_bpm 140

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F Minor - Dark & Heavy)
# ==========================================================

# Classic half-time kick. Hits on step 0, with a ghost kick on step 14.
s_kick = gen_score("x.............x.",
  [:c4, {note: :c4, amp: 0.6}])

# Heavy snare strictly on beat 3 (step 8), with a ghost snare on the 'a' of 4.
s_snare = gen_score("........x.....x.",
  [:c4, {note: :c4, amp: 0.5}])

# Syncopated, rolling hats to keep the 140 BPM momentum alive
hat_data = [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.5}
]
s_hats = gen_score("x.xx.xx.x.xx.xx.", hat_data)

# Massive, sustained sub-bass. Long releases create that iconic wobble feel.
s_bass = gen_score("x.......x.......",
  [{note: :f2, release: 1.0}, {note: :eb2, release: 1.0}])

# Distant, echoing 8-bit melody (F Minor Pentatonic)
s_fm = gen_score("....x.....x...x.",
  [:f5, :eb5, :c5])

# Massive dark pad to fill the empty space
s_pad = gen_score("x.......x.......",
  [:f3, :eb3])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Atmospheric intro, just pad and sub-bass (4 bars)
  [ [:play_pad, s_pad, 4], [:play_sub, s_bass, 4] ],
  
  # Scene 2: The half-time drums drop (8 bars)
  [ [:play_pad, s_pad, 8], [:play_sub, s_bass, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: Add the distant FM melody (8 bars)
  [ [:play_pad, s_pad, 8], [:play_sub, s_bass, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_fm, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
