# ==========================================================
# PLAYBOOK: 70s FUNK / JAMES BROWN STYLE
# (Pioneered by James Brown, The J.B.'s, and Bootsy Collins)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 70s Funk.
# We have explored P-Funk and Motown, but classic 70s Funk is the sound 
# of pure, uncut groove. It relies on "The One"—a heavy emphasis on the 
# first beat of every bar. It features a highly syncopated, "Funky Drummer" 
# drum break, a deep, melodic bassline that dances around the root note, 
# and tight, staccato horn stabs that lock perfectly into the off-beats.
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create a complex, live-band funk groove. By using the `gen_score` helper 
# to map out intricate, overlapping drum hits, the engine creates a 
# relentless, deeply infectious, and undeniably sweaty atmosphere.
# ==========================================================

use_bpm 105

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Dorian - Funky, Syncopated, & Tight)
# ==========================================================

# The "Funky Drummer" Kick. 
# Highly syncopated. Heavy emphasis on "The One" (step 0). (5 x's, 5 elements)
s_kick = gen_score("x..x..x.x..x....", [
  :c4, {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.6}, :c4
])

# Crisp, live snare with heavy ghost notes on the 'and' of 2 and the 'a' of 3. 
# (3 x's, 3 elements)
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.9}
])

# Relentless, continuous 16th shaker. 
# (8 x's, 2 elements - cycles 4 times)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# Deep, melodic bass (D Dorian).
# Plays a syncopated, walking line. Low cutoff (70) and medium release (0.2) 
# to create a warm, round undercurrent. (4 x's, 4 elements)
s_bass = gen_score("x.....x.x.....x.", [
  {note: :d1, release: 0.2, cutoff: 70, amp: 1.2}, 
  {note: :a1, release: 0.2, cutoff: 70, amp: 1.0}, 
  {note: :c2, release: 0.2, cutoff: 70, amp: 1.0}, 
  {note: :d1, release: 0.2, cutoff: 70, amp: 1.0}
])

# Tight, "Horn Section" Stabs (Dm9 to Gm9).
# Uses :play_fm with a low divisor (2) and mid depth (3) to create a warm, 
# brassy staccato hit. Hit strictly on the off-beats. (3 x's, 3 elements)
s_chords = gen_score("..x.....x.....x.", [
  {note: [:d3, :f3, :a3, :c4], divisor: 2, depth: 3, release: 0.1, amp: 0.6},
  {note: [:g2, :bb2, :d3, :f3], divisor: 2, depth: 3, release: 0.1, amp: 0.6},
  {note: [:d3, :f3, :a3, :c4], divisor: 2, depth: 3, release: 0.1, amp: 0.6}
])

# Piercing, "Clavinet" Melody (D Dorian Pentatonic).
# Uses :play_fm with a high divisor (4) and low depth (2) to create a sharp, 
# clean pluck. Routed through the engine's tape echo. (6 x's, 6 elements)
lead_notes = [:d5, :a4, :c5, :d5, :c5, :a4]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 4, depth: 2, release: 0.15} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Uh!" Vocal Grunt (Granular Synth).
# Pitched DOWN to :d3. High density, tiny size = a sharp, percussive vocal hit. 
# (1 x, 1 element)
s_vocal = gen_score("........x.......", [
  {note: :d3, buffer: :misc_lori, pos: 0.2, density: 2, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the syncopated drums, bass, and horns (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_fm, s_chords, 4] ],
  
  # Scene 2: The Vibe - Add the "Uh!" vocal grunt (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Solo - The piercing clavinet melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN THE GROOVE]
# 
# 1. "The One": Look at `s_kick`. It hits heavily on step 0 (beat 1), but 
#    then completely avoids the standard 4/4 pulse, hitting on syncopated 
#    steps (3, 6, 8, 11). This creates a lopsided, "funky" groove that 
#    emphasizes the downbeat before dancing around it. The engine's strict 
#    master clock ensures this complex rhythm lands with absolute precision.
#
# 2. FM as a Horn Section: Look at `s_chords`. The `:play_fm` synth is 
#    given a `divisor` of `2` and a `depth` of `3`, with a microscopic 
#    `release` (0.1). This forces the FM synth to produce a warm, brassy, 
#    staccato "hit" that perfectly mimics a live horn section locking in 
#    with the rhythm section on the off-beats.
#
# 3. The Dorian Mode: Look at `s_bass` and `s_lead`. The melody uses D, E, 
#    F, G, A, B, C. The minor 3rd (F) and major 6th (B) create the smooth, 
#    sophisticated, "cool" sound that defines 70s funk. The engine's strict 
#    16-step grid ensures this syncopated, melodic bassline fires flawlessly 
#    over the complex drum pattern.
# ==========================================================
