# ==========================================================
# PLAYBOOK: LUIS FONSI ft. DADDY YANKEE - "DESPACITO" (2017)
# ==========================================================

use_bpm 89

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (B Minor - Tropical, Driving, & Latin-Pop)
# ==========================================================

# The "Dembow" Kick. 
# A driving 3-3-2 syncopated march. (4 x's, 4 elements)
s_kick = gen_score("x..x..x.x..x....", [
  :c4, {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.6}
])

# Crisp, organic snare/rimshot on beats 2 and 4, with a ghost note. (3 x's, 3 elements)
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.9}
])

# Steady 8th-note hats to drive the momentum. (4 x's, 4 elements)
s_hats = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, 
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}
])

# The "Acoustic Guitar" Riff (B Minor).
# Uses :play_pluck. Plays the iconic, syncopated melody. 
# (8 x's, 8 elements)
guitar_notes = [:b4, :a4, :g4, :a4, :e4, :g4, :a4, :b4]
guitar_data = guitar_notes.map { |n| {note: n, amp: 0.6, release: 0.15, coef: 0.5} }
s_guitar = gen_score("x.x.x.x.x.x.x.x.", guitar_data)

# Deep, warm sub-bass (B Minor).
# Plays a syncopated line. Low cutoff (60) and medium release (0.2) 
# to create a warm, muffled undercurrent. (4 x's, 4 elements)
s_bass = gen_score("x.....x.x.....x.", [
  {note: :b1, release: 0.2, cutoff: 60, amp: 1.2}, 
  {note: :g1, release: 0.2, cutoff: 60, amp: 1.0}, 
  {note: :d1, release: 0.2, cutoff: 60, amp: 1.0}, 
  {note: :a1, release: 0.2, cutoff: 60, amp: 1.0}
])

# Lush, "Synth Pad" Chords (Bm to G to D to A).
# Hit strictly on the off-beats. High cutoff (90) and short release (0.2) 
# create a sharp, staccato wall of sound. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:b3, :d4, :fs4], cutoff: 90, release: 0.2, amp: 0.5},
  {note: [:g3, :b3, :d4], cutoff: 90, release: 0.2, amp: 0.5},
  {note: [:d3, :fs3, :a3], cutoff: 90, release: 0.2, amp: 0.5},
  {note: [:a2, :cs3, :e3], cutoff: 90, release: 0.2, amp: 0.5}
])

# Piercing, "Synth Flute" Lead (B Minor Pentatonic).
# Uses :play_fm with a high divisor (3) and low depth (2) to create a pristine, 
# glassy tone. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:b5, :a5, :g5, :a5, :e5, :b5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 2, release: 0.2} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Ay!" Vocal Stutter (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched UP.
# High density, tiny size = a sharp, percussive vocal skip. (1 x, 1 element)
s_vocal = gen_score("........x.......", [
  {note: :b4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the acoustic guitar riff, bass, and pad (4 bars)
  [ [:play_pluck, s_guitar, 4], [:play_sub, s_bass, 4], [:play_chords, s_chords, 4] ],
  
  # Scene 2: The Verse - Add the driving Dembow drums (8 bars)
  [ [:play_pluck, s_guitar, 8], [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chorus - The piercing synth flute melody drops (8 bars)
  [ [:play_pluck, s_guitar, 8], [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN LATIN POP]
# 
# 1. The Acoustic Guitar Riff: Look at `s_guitar`. The `:play_pluck` synth plays 
#    the iconic, syncopated melody (B-A-G-A). By using a mid `coef` (0.5) and a 
#    short `release` (0.15), the engine turns the pluck into a sharp, percussive 
#    "thwack" that perfectly mimics a nylon-string acoustic guitar.
#
# 2. The Dembow Rhythm: Look at `s_kick`. It hits on a 3-3-2 syncopated pattern 
#    (steps 0, 3, 6, 8, 11). The engine's strict master clock ensures this complex 
#    rhythm lands with absolute precision, creating the relentless, bouncing 
#    groove that defines Reggaeton and Latin Pop.
#
# 3. The Off-Beat Groove: Look at `s_hats` and `s_chords`. They ALL hit strictly 
#    on steps 2, 6, 10, and 14. In a 16-step grid, these are the exact midpoints 
#    between the kicks. The engine's strict master clock locks these together 
#    perfectly, creating a massive, bouncing "boom-cha" momentum that forces 
#    you to dance.
# ==========================================================
