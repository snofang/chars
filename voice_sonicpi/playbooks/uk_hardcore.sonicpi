# ==========================================================
# PLAYBOOK: UK HARDCORE / HAPPY HARDCORE
# Frantic, Euphoric, High‑BPM Rave Energy
# ==========================================================
# [WHY THIS GENRE?]
# UK Hardcore (Scott Brown, Hixxy) pushes the tempo to 170+ BPM,
# pairing rigid 4/4 kicks with off‑beat basslines, massive piano
# chords, and pitched‑up vocal stutters. This playbook captures
# that euphoric, high‑energy rave atmosphere.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 170 BPM
# Key: C major (bright, euphoric)
# Rhythm: 4/4 kick, clap on 2/4, off‑beat hats and bass,
# bright piano chords on off‑beats, arpeggiated lead,
# pitched‑up vocal chops.
# Timbre: Punchy kick (bd_haus), heavy rave clap (sn_dolf),
# off‑beat hats (cymbal_closed), sub‑bass (dsaw, short release),
# bright piano stabs (blade), FM arpeggio lead (fm, tape echo),
# pitched‑up granular vocal chops (ambi_choir, high density,
# tiny size).
# Arrangement: Foundation (kick+bass) → Build (add claps+
# hats+chords) → Drop (add vocal chops+lead arpeggio).
# ==========================================================

use_bpm 170

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Rigid 4‑on‑the‑floor kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy rave clap on beats 2 and 4
s_clap = gen_score("....x.......x...", [:c4])

# Off‑beat open hats (steps 2,6,10,14)
s_hats = gen_score("..x..x..x..x....",
  [{note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}])

# Off‑beat rave bass – hits exactly between kicks
s_bass = gen_score("..x..x..x..x....",
  [{note: :c2, amp: 1.0, release: 0.15},
   {note: :c2, amp: 1.0, release: 0.15},
   {note: :g1, amp: 1.0, release: 0.15},
   {note: :g1, amp: 1.0, release: 0.15}])

# Bright piano stabs – off‑beats in sync with bass
chord_data = [
  [:c3, :e3, :g3, :b3],
  [:c3, :e3, :g3, :b3],
  [:g3, :b3, :d4, :f4],
  [:g3, :b3, :d4, :f4]
]
s_chords = gen_score("..x..x..x..x....",
  chord_data.map { |ch| {note: ch} })

# Pitched‑up euphoric vocal chops – tiny grains
s_vocal = gen_score("....x.....x....",
  [{note: :c5, buffer: :ambi_choir, pos: 0.2, density: 4, size: 0.03, amp: 0.6},
   {note: :e5, buffer: :ambi_choir, pos: 0.4, density: 4, size: 0.03, amp: 0.6}])

# Bright arpeggio lead – routed through tape echo
lead_notes = [:c5, :d5, :e5, :g5, :e5, :d5, :c5, :g4]
s_lead = gen_score("x.x.x.x.x.x.x.x.", lead_notes)

# Playbook
playbook = (ring
  # Scene 1: Foundation – Kick + Bass
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4] ],

  # Scene 2: Build – Add Claps, Hats, Chords
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8],
    [:play_snare, s_clap, 8], [:play_hats, s_hats, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3: Drop – Add Vocal Chops and Lead Arpeggio
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8],
    [:play_snare, s_clap, 8], [:play_hats, s_hats, 8],
    [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8],
    [:play_lead, s_lead, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The off‑beat bounce: bass, hats, and chords all hit on
#   steps 2,6,10,14 – the midpoints between kicks – creating
#   the signature "boom‑cha" momentum at 170 BPM.
# - Extreme tempo precision: the engine's master clock ensures
#   every hit lands with mathematical accuracy at high speed.
# - Pitched‑up granular vocals: size 0.03 and high density chop
#   the vocal into tiny, angelic flutters that dance above
#   the heavy kick.
# ==========================================================
