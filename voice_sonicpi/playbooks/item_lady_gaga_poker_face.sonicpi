# ==========================================================
# PLAYBOOK: LADY GAGA - "POKER FACE" (2008)
# ==========================================================

use_bpm 120

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (G# Minor - Cold, Driving, & Robotic)
# ==========================================================

# Relentless, driving 4/4 dance-pop kick. (4 x's, 4 elements)
s_kick = gen_score("x...x...x...x...", [:c4, :c4, :c4, :c4])

# Heavy, organic 909 clap strictly on beats 2 and 4. (2 x's, 2 elements)
s_clap = gen_score("....x.......x...", [:c4, :c4])

# Off-beat open hats to drive the momentum. (4 x's, 4 elements)
s_hats = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, 
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}
])

# The "Iconic" Synth Bass (G# Minor).
# Plays a relentless, repetitive 8th-note line. 
# High cutoff (100) and microscopic release (0.08) create a relentless, 
# bouncy, buzzing churn that drives the track. (8 x's, 8 elements)
bass_notes = [:gs1, :gs1, :fs1, :fs1, :e1, :e1, :ds1, :ds1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 100, release: 0.08, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# Stark, "Synth Brass" Stabs (G#m to F# to E to D#m).
# Uses :play_fm with a low divisor (2) and mid depth (4) to create a harsh, 
# brassy, staccato hit. Hit strictly on the off-beats. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:gs3, :b3, :ds4], divisor: 2, depth: 4, release: 0.15, amp: 0.6},
  {note: [:fs3, :a3, :cs4], divisor: 2, depth: 4, release: 0.15, amp: 0.6},
  {note: [:e3, :g3, :b3], divisor: 2, depth: 4, release: 0.15, amp: 0.6},
  {note: [:ds3, :fs3, :as3], divisor: 2, depth: 4, release: 0.15, amp: 0.6}
])

# Piercing, "Robotic" Synth Lead (G# Minor).
# Uses :play_fm with a high divisor (3) and mid depth (3) to create a sharp, 
# glassy, digital tone. Routed through the global tape echo. (8 x's, 8 elements)
lead_notes = [:gs4, :gs4, :gs4, :fs4, :fs4, :e4, :ds4, :e4]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, divisor: 3, depth: 3, release: 0.1} }
s_lead = gen_score("x.x.x.x.x.x.x.x.", lead_data)

# "Po-po-po-poker face" Vocal Stutter (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched DOWN.
# High density, tiny size = a sharp, percussive, robotic vocal skip. (2 x's, 2 elements)
s_vocal = gen_score("....x.......x...", [
  {note: :gs3, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.7},
  {note: :b3, buffer: :ambi_choir, pos: 0.3, density: 3, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the iconic synth bass, brass stabs, and vocal chops (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Verse - Add the relentless 4/4 dance drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chorus - The piercing, robotic synth lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN ELECTRO-POP]
# 
# 1. The Iconic Synth Bass: Look at `s_bass`. The `:play_sub` synth plays 
#    the legendary G#-G#-F#-F#-E-E-D#-D# sequence on continuous 8th notes. 
#    By using a high `cutoff` (100) and a microscopic `release` (0.08), the 
#    engine turns the detuned sawtooth into a relentless, bouncy, buzzing 
#    churn that perfectly mimics the driving, robotic synth bass that anchors 
#    the track.
#
# 2. FM as a Synth Brass: Look at `s_chords`. The `:play_fm` synth is given 
#    a `divisor` of `2` and a `depth` of `4`, with a microscopic `release` 
#    (0.15). This forces the FM synth to produce a harsh, brassy, staccato 
#    "hit" that perfectly mimics the massive synth-brass section stabs that 
#    define the song's upbeat, club-ready atmosphere.
#
# 3. The Robotic Lead: The `s_lead` sequence uses `divisor: 3` and `depth: 3`. 
#    This harmonic ratio produces a sharp, glassy, digital tone that cuts 
#    through the heavy mix. Because it's routed through the global tape echo 
#    bus, the rapid, staccato notes smear into a soaring, cascading melody 
#    that perfectly mimics the iconic, deadpan vocal hook.
# ==========================================================
