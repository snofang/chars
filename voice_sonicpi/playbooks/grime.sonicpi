use_bpm 140

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Minor - Cold & Tense)
# ==========================================================

# Syncopated kick. Hits on step 0, the 'a' of 2 (step 7), and beat 3 (step 8).
s_kick  = (ring :c4, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, {:note => :c4, :amp => 1.0}, nil, nil, nil, nil, nil, nil, nil)

# Heavy, metallic snare strictly on beat 3 (step 8). 
# In Grime, the snare often hits on beat 3 instead of 2 and 4.
s_snare = (ring nil, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 1.0}, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.6}, nil)

# Fast, relentless, rolling hats
s_hats  = (ring {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.4}, 
           nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, 
           {:note => :c4, :amp => 0.4}, nil, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.5}, 
           nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2})

# Sharp, bouncing "Square Wave" style bass. 
# Short releases make it punchy and staccato.
s_bass  = (ring {:note => :fs2, :release => 0.15}, nil, nil, nil, {:note => :fs2, :release => 0.15, :amp => 0.8}, nil, nil, nil, 
           {:note => :a2, :release => 0.15}, nil, {:note => :a2, :release => 0.15, :amp => 0.6}, nil, 
           {:note => :b2, :release => 0.15}, nil, nil, nil)

# Tense, staccato minor chord stabs (F# Minor)
# Hits on the off-beats to leave space for the bass.
s_chords= (ring nil, nil, [:fs3, :a3, :c4], nil, nil, nil, [:fs3, :a3, :c4], nil, 
           nil, nil, [:a3, :c4, :e4], nil, nil, nil, [:b3, :d4, :fs4], nil)

# Chopped, rhythmic alien vocal hook (Granular Synth)
# High density, small size = glitchy, rhythmic stutter
s_vocal = (ring nil, nil, nil, nil, nil, nil, nil, nil, 
           {:note => :fs4, :buffer => :ambi_choir, :pos => 0.2, :density => 4, :size => 0.03}, nil, nil, nil, 
           nil, nil, {:note => :a4, :buffer => :ambi_choir, :pos => 0.4, :density => 4, :size => 0.03}, nil)

# Distant, eerie FM bell melody (F# Minor)
s_fm    = (ring nil, nil, nil, {:note => :fs5, :amp => 0.6}, nil, nil, nil, nil, 
           nil, nil, nil, {:note => :e5, :amp => 0.5}, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the tense drums and stabs (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_chords, s_chords, 4] ],
  
  # Scene 2: Add the bouncing, staccato bassline (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_chords, s_chords, 8], [:play_sub, s_bass, 8] ],
    
  # Scene 3: The chopped vocal hook and distant bells drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], 
    [:play_grain, s_vocal, 8], [:play_fm, s_fm, 4] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
