# ==========================================================
# PLAYBOOK: MACHINE BEAT / INDUSTRIAL TECHNO
# Pounding, Mechanical, Dystopian Energy
# ==========================================================
# [WHY THIS GENRE?]
# This playbook captures a rigid, pounding industrial techno
# aesthetic – a 4/4 kick with an extra 16th hit, metallic snares,
# relentless 16th hats, a driving FM bassline, caustic synth stabs,
# and granular metallic static. It's dark, mechanical, and relentless.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 125 BPM
# Key: D minor (dark, mechanical)
# Rhythm: 4/4 kick with extra 16th on step 14, snare on 2/4,
# continuous 16th hats with alternating dynamics, FM bass on
# even steps, synth stabs on off‑beats, granular static on
# downbeats.
# Timbre: Kick (bd_haus with accent), snare (sn_dolf), hats
# (cymbal_closed), FM bass (fm, divisor 2, depth 4), lead
# (fm, tape echo), granular static (elec_piano, tiny size,
# high density).
# Arrangement: Machine beat (drums) → Add bassline → Add
# stabs and static.
# ==========================================================

use_bpm 125

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Minor - Dystopian & Mechanical)
# ==========================================================

# Rigid, pounding 4-on-the-floor with an extra 16th hit (step 14)
s_kick = gen_score("x...x...x...x.x.",
  [ :c4, :c4, :c4, :c4, {note: :c4, amp: 0.6} ])

# Heavy, metallic snare strictly on beats 2 and 4 (steps 4 and 12)
s_snare = gen_score("....x.......x...", [:c4])

# Rigid 16th hats with alternating amplitudes (0.3 / 0.2)
s_hats = gen_score("xxxxxxxxxxxxxxxx",
  [0.3, 0.2].cycle.take(16).map { |a| {note: :c4, amp: a} })

# Driving, aggressive FM 16th bassline – even steps only
s_fm = gen_score("x.x.x.x.x.x.x.x.",
  [ :d2, :d2, :d2, :f2, :d2, :d2, :a2, :f2 ])

# Caustic, echoing synth stabs on off‑beats (steps 6 and 14)
s_lead = gen_score("......x......x..",
  [ {note: :d4, amp: 0.8}, {note: :c4, amp: 0.8} ])

# Granular metallic texture – tiny, high‑density static (steps 0 and 8)
s_grain = gen_score("x.......x.......",
  [ {note: :d3, buffer: :elec_piano, pos: 0.8, density: 6, size: 0.02},
    {note: :d3, buffer: :elec_piano, pos: 0.8, density: 6, size: 0.02} ])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the pounding machine beat (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4] ],

  # Scene 2: Add the driving FM bassline (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_fm, s_fm, 8] ],

  # Scene 3: Add caustic stabs and granular static (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_fm, s_fm, 8], [:play_lead, s_lead, 8], [:play_grain, s_grain, 4] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Extra kick on step 14 adds a syncopated drive.
# - Alternating hat amplitudes (0.3/0.2) create a rigid, mechanical pulse.
# - FM bassline on even steps provides a driving, aggressive low‑end.
# - Caustic stabs on off‑beats (6,14) add tension.
# - Granular static: tiny grains (0.02) with high density (6)
#   simulate industrial machine noise.
# ==========================================================
