# ==========================================================
# PLAYBOOK: 80s DIGITAL DANCEHALL / "STING" RIDDIM
# (Pioneered by King Jammy, Wayne Smith, and Sleng Teng)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 80s Digital Dancehall.
# We have explored 70s Roots Dub and 90s Modern Dancehall, but Digital 
# Dancehall (born from the "Sleng Teng" riddim in 1985) is the absolute 
# genesis of modern electronic reggae. It replaced live bands with the 
# Casio MT-40 and Yamaha DX7. It relies on a rigid, bouncing 808 drum 
# pattern, a massive, square-wave "synth bass" line, and stark, off-beat 
# organ stabs that feel like a warm Caribbean night.
#
# This playbook perfectly demonstrates how to use the `:play_fm` synth 
# to simulate a classic digital dancehall bassline. By using a low `divisor` 
# and `depth`, the engine creates a warm, hollow, square-wave tone that 
# drives the track, while the `:play_sub` synth handles the deep sub-bass.
# ==========================================================

use_bpm 85

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (C Minor - Bouncy, Warm, & Digital)
# ==========================================================

# The "Digital" Kick. 
# A rigid, bouncing 4/4 pattern. (4 x's, 4 elements)
s_kick = gen_score("x...x...x...x...", [:c4, :c4, :c4, :c4])

# Crisp, 808 snare strictly on beats 2 and 4. (2 x's, 1 element)
s_snare = gen_score("....x.......x...", [:c4])

# Off-beat hats to drive the momentum. (4 x's, 4 elements)
s_hats = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, 
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}
])

# The "Sleng Teng" Synth Bass (C Minor).
# Uses :play_fm with a low divisor (2) and low depth (2) to create a warm, 
# hollow, square-wave tone. (8 x's, 8 elements)
bass_notes = [:c2, :c2, :c2, :eb2, :c2, :c2, :g1, :c2]
bass_data = bass_notes.map { |n| {note: n, amp: 0.8, divisor: 2, depth: 2, release: 0.15} }
s_fm_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# Deep, round sub-bass (C Minor).
# Hits in sync with the synth bass. Very low cutoff (50) provides a pristine, 
# distortion-free low-end thump. (8 x's, 8 elements)
sub_notes = [:c1, :c1, :c1, :eb1, :c1, :c1, :g0, :c1]
sub_data = sub_notes.map { |n| {note: n, cutoff: 50, release: 0.15, amp: 1.0} }
s_sub = gen_score("x.x.x.x.x.x.x.x.", sub_data)

# Stark, "Organ" Stabs (Cm to Bb).
# Hit strictly on the off-beats. High cutoff (100) and short release (0.1) 
# create a sharp, staccato wall of sound. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:c3, :eb3, :g3], cutoff: 100, release: 0.1, amp: 0.5},
  {note: [:c3, :eb3, :g3], cutoff: 100, release: 0.1, amp: 0.5},
  {note: [:bb2, :db3, :f3], cutoff: 100, release: 0.1, amp: 0.5},
  {note: [:bb2, :db3, :f3], cutoff: 100, release: 0.1, amp: 0.5}
])

# Piercing, "Synth Brass" Lead (C Minor Pentatonic).
# Uses :play_fm with a high divisor (3) and mid depth (3) to create a sharp, 
# brassy tone. Routed through the engine's tape echo. (6 x's, 6 elements)
lead_notes = [:c5, :eb5, :g5, :f5, :eb5, :c5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 3, release: 0.2} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Soundclash" Siren FX (Granular Synth).
# High density, tiny size = a sharp, repetitive vocal skip. (1 x, 1 element)
s_vocal = gen_score("........x.......", [
  {note: :c4, buffer: :misc_lori, pos: 0.1, density: 3, size: 0.04, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Riddim - Just the synth bass, sub, and off-beat organ (4 bars)
  [ [:play_fm, s_fm_bass, 4], [:play_sub, s_sub, 4], [:play_chords, s_chords, 4] ],
  
  # Scene 2: The Groove - Add the rigid 808 drums and siren FX (8 bars)
  [ [:play_fm, s_fm_bass, 8], [:play_sub, s_sub, 8], [:play_chords, s_chords, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Dub - The piercing synth brass melody drops (8 bars)
  [ [:play_fm, s_fm_bass, 8], [:play_sub, s_sub, 8], [:play_chords, s_chords, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_grain, s_vocal, 8], [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN DIGITAL REGGAE]
# 
# 1. FM as a Synth Bass: Look at `s_fm_bass`. The `:play_fm` synth is 
#    given a `divisor` of `2` and a `depth` of `2`. This harmonic ratio 
#    produces a warm, hollow, square-wave tone that perfectly mimics the 
#    legendary Casio MT-40 bassline that launched the "Sleng Teng" riddim 
#    and revolutionized Jamaican music in 1985.
#
# 2. Pristine Low-End Separation: Digital Dancehall requires a massive, 
#    clean low-end. By using `play_fm` for the melodic, square-wave bass 
#    and `play_sub` with a low `cutoff` (50) for the syncopated thump, 
#    the engine separates the harmonics. This provides immense weight 
#    without muddying the pristine high-end of the organ stabs.
#
# 3. The Off-Beat Pocket: Look at `s_chords` and `s_hats`. They ALL hit 
#    strictly on steps 2, 6, 10, and 14. In a 16-step grid, these are the 
#    exact midpoints between the kicks. The engine's strict master clock 
#    locks these together perfectly, creating a massive, bouncing "boom-cha" 
#    groove that forces you to dance.
# ==========================================================
