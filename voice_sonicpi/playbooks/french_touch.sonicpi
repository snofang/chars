# ==========================================================
# PLAYBOOK: FRENCH TOUCH / FILTER HOUSE
# (Pioneered by Daft Punk, Stardust, and Cassius)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose French Touch.
# We have explored Bass House (which is aggressive) and Disco (which 
# is live). French Touch is the sound of 90s Paris. It takes a looped 
# disco sample and pushes it through a massive, sidechained Moog 
# filter, creating a relentless, pumping "wall of sound."
#
# This playbook perfectly demonstrates how to use the Parameter Hashes 
# (`amp` and `cutoff`) to simulate heavy sidechain compression and 
# filter sweeps purely via data. By making the bass volume dip on every 
# kick hit, and sweeping the chord filter open and closed, the engine 
# creates that massive, breathing, dancefloor momentum.
# ==========================================================

use_bpm 124

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (G Minor - Pumping, Filtered, & Funky)
# ==========================================================

# Relentless, driving 4‑on‑the‑floor kick.
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, organic disco clap strictly on beats 2 and 4.
s_clap = gen_score("....x.......x...", [:c4])

# Off‑beat open hats (steps 2,6,10,14) with alternating amp.
s_hats = gen_score("..x..x..x..x....",
  [ {note: :c4, amp: 0.4},
    {note: :c4, amp: 0.5},
    {note: :c4, amp: 0.4},
    {note: :c4, amp: 0.5} ])

# Sidechained pumping bass – continuous 16ths, amp dips on kick hits.
bass_data = [
  {note: :g1, amp: 0.2, cutoff: 80}, {note: :g1, amp: 0.9, cutoff: 90},
  {note: :g1, amp: 1.0, cutoff: 100}, {note: :g1, amp: 0.8, cutoff: 110},
  {note: :g1, amp: 0.2, cutoff: 80}, {note: :g1, amp: 0.9, cutoff: 90},
  {note: :bb1, amp: 1.0, cutoff: 100}, {note: :bb1, amp: 0.8, cutoff: 110},
  {note: :bb1, amp: 0.2, cutoff: 80}, {note: :bb1, amp: 0.9, cutoff: 90},
  {note: :d2, amp: 1.0, cutoff: 100}, {note: :d2, amp: 0.8, cutoff: 110},
  {note: :d2, amp: 0.2, cutoff: 80}, {note: :d2, amp: 0.9, cutoff: 90},
  {note: :g1, amp: 1.0, cutoff: 100}, {note: :g1, amp: 0.8, cutoff: 110}
]
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Filtered disco chords – off‑beats, cutoff alternates 70 ↔ 90.
s_chords = gen_score("..x..x..x..x....",
  [ {note: [:g3, :bb3, :d4, :f4], cutoff: 70, release: 0.3, amp: 0.6},
    {note: [:g3, :bb3, :d4, :f4], cutoff: 90, release: 0.3, amp: 0.6},
    {note: [:c4, :eb4, :g4, :bb4], cutoff: 70, release: 0.3, amp: 0.6},
    {note: [:c4, :eb4, :g4, :bb4], cutoff: 90, release: 0.3, amp: 0.6} ])

# Bright echoing brass riff – even steps, tape echo.
fm_data = [
  {note: :g5, amp: 0.6}, {note: :d5, amp: 0.5},
  {note: :bb5, amp: 0.6}, {note: :d6, amp: 0.7},
  {note: :g5, amp: 0.6}, {note: :c6, amp: 0.5},
  {note: :bb5, amp: 0.7}
]
fm_base = {divisor: 2, depth: 2, release: 0.1}
s_fm = gen_score("x.x.x.x.x.x.x.x.",
  fm_data.map { |h| fm_base.merge(h) })

# Choppy "Diva" vocal stutter – steps 4,8,12.
s_vocal = gen_score("....x...x...x...",
  [ {note: :g4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.6},
    {note: :bb4, buffer: :ambi_choir, pos: 0.3, density: 3, size: 0.04, amp: 0.6},
    {note: :d5, buffer: :ambi_choir, pos: 0.5, density: 3, size: 0.04, amp: 0.6} ])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Pump - Just the kick, sidechained bass, and vocal chops (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Filter - Add the heavy claps, hats, and filtered chords (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_grain, s_vocal, 8], 
    [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Riff - The echoing brass melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_grain, s_vocal, 8], 
    [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8], 
    [:play_lead, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN THE PUMP]
# 
# 1. Data-Driven Sidechain: Look at `s_bass`. A real French Touch track 
#    uses heavy sidechain compression to make the bass "duck" when the 
#    kick hits. Because our engine reads Parameter Hashes, we simulate 
#    this perfectly by just setting the bass `amp` to `0.2` on steps 0, 4, 
#    8, and 12 (where the kick hits), and `1.0` on the steps in between.
#
# 2. The Filter Sweep: Look at `s_chords`. The `cutoff` Hash alternates 
#    between `70` and `90`. Because the engine reads these Hashes 
#    independently on every step, the filter opens and closes on the 
#    off-beats, perfectly mimicking the sound of a DJ twisting a Moog 
#    filter knob on a looped disco sample.
#
# 3. The 16th-Note Roll: The `s_bass` plays on EVERY single 16th step. 
#    By combining the continuous rhythm with the data-driven amplitude 
#    dips, the engine creates a relentless, pumping "gallop" that drives 
#    the track forward unstoppably, defining the 90s Paris club sound.
# ==========================================================
