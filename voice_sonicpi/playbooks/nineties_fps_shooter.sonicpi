#j==========================================================
# PLAYBOOK: 90s FPS SHOOTER / MIDI METAL (DOOM STYLE)
# (Pioneered by Bobby Prince, Lee Jackson, and Nine Inch Nails)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose the 90s FPS Shooter.
# We have explored various metal and rock genres, but the 90s FPS Shooter 
# (think DOOM, Quake, and Duke Nukem 3D) is a unique beast. It fuses heavy 
# metal riffing with the limitations of early PC sound cards (MIDI synthesis). 
# It relies on a blistering, fast tempo (140 BPM), a relentless "tremolo picked" 
# 16th-note bassline, massive, dissonant power chords, and a piercing, 
# high-pitched "MIDI guitar" solo that feels like ripping and tearing through 
# hordes of demons.
#
# This playbook perfectly demonstrates how to push the `:play_sub` synth 
# into a continuous, distorted churn to simulate tremolo picking, and how 
# to use the `:play_fm` synth with an extreme `depth` to simulate a harsh, 
# digital guitar solo.
# ==========================================================

use_bpm 140

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (E Phrygian Dominant - Dark, Fast, & Aggressive)
# ==========================================================

# The "Double Kick" Drum. 
# A blistering, continuous 8th-note gallop. (8 x's, 8 elements)
s_kick = gen_score("x.x.x.x.x.x.x.x.", [:c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4])

# Heavy, dry snare strictly on beats 2 and 4. (2 x's, 1 element)
s_snare = gen_score("....x.......x...", [:c4])

# Fast, driving 16th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Tremolo Picked" Bass (E Phrygian Dominant).
# Plays continuous 16th notes, alternating octaves. 
# Extreme cutoff (120) and microscopic release (0.06) create a relentless, 
# grinding, distorted churn that mimics a down-tuned, palm-muted guitar.
# (16 x's, 16 elements)
bass_notes = [:e1, :e2, :e1, :e2, :e1, :e2, :e1, :e2, 
              :f1, :f2, :f1, :f2, :e1, :e2, :e1, :e2]
bass_data = bass_notes.map { |n| {note: n, cutoff: 120, release: 0.06, amp: 1.2} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Massive, "Dissonant" Power Chords (E5 to F5).
# Uses :play_fm with a low divisor (2) and extreme depth (6) to create a 
# harsh, grinding hit. Plays a classic, palm-muted metal riff. (3 x's, 3 elements)
s_chords = gen_score("x.....x...x.....", [
  {note: [:e3, :b3], divisor: 2, depth: 6, release: 0.15, amp: 0.7},
  {note: [:f3, :c4], divisor: 2, depth: 6, release: 0.15, amp: 0.7},
  {note: [:e3, :b3], divisor: 2, depth: 6, release: 0.15, amp: 0.7}
])

# Piercing, "MIDI Guitar" Solo (E Phrygian Dominant).
# Uses :play_lead routed through the global tape echo bus. The long release (0.2) 
# and rapid, 8th-note melody create a soaring, chaotic, shredding solo. 
# (6 x's, 6 elements)
lead_notes = [:e5, :g5, :a5, :b5, :a5, :g5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, cutoff: 110, release: 0.2} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Demon Growl" Drone (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched DOWN.
# Long size (0.15) creates a dark, distorted vocal hit. (1 x, 1 element)
s_grain = gen_score("........x.......", [
  {note: :e2, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.15, amp: 0.8}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Onset - Just the double kick, tremolo bass, and power chords (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_fm, s_chords, 4] ],
  
  # Scene 2: The Fight - Add the snare, hats, and demon growl (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], 
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], [:play_grain, s_grain, 8] ],
    
  # Scene 3: The Climax - The piercing MIDI guitar solo drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], 
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], [:play_grain, s_grain, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN DIGITAL BRUTALITY]
# 
# 1. The Tremolo Pick Illusion: Look at `s_bass`. The `:play_sub` synth plays 
#    on EVERY single 16th step, alternating between the low octave (:e1) and the 
#    high octave (:e2). By using an extreme `cutoff` (120) and a microscopic 
#    `release` (0.06), the engine turns the detuned sawtooth into a relentless, 
#    grinding, distorted churn that perfectly mimics the "tremolo picking" 
#    technique used by metal guitarists.
#
# 2. FM as a Distorted Amp: Look at `s_chords`. The `:play_fm` synth is 
#    given a `divisor` of `2` and an extreme `depth` of `6`. This harsh 
#    harmonic ratio forces the FM modulator to grind the carrier wave, 
#    creating a harsh, distorted square wave. By playing dissonant power 
#    chords (E5 to F5), the engine perfectly mimics the evil, metallic 
#    riffing of 90s FPS soundtracks.
#
# 3. The Phrygian Dominant Scale: Look at `s_bass` and `s_lead`. The harmony 
#    uses E, F, G#, A, B, C, D. The augmented 2nd interval between F and G# 
#    creates the dark, exotic, "demonic" sound that defines the genre. The 
#    engine's strict 16-step grid ensures this rapid, shredding solo fires 
#    flawlessly over the driving rhythm section.
# ==========================================================
