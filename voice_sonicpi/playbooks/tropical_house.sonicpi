# ==========================================================
# PLAYBOOK: TROPICAL HOUSE
# Sun-Drenched, Bouncy, Off-Beat Relaxation
# ==========================================================
# [WHY THIS GENRE?]
# Tropical House (Kygo, Thomas Jack) slows the 4/4 house grid
# to 100 BPM, replacing harsh synths with warm marimbas, deep
# sub-bass, and wide major chords on the off-beats. Pure
# beach-side atmosphere.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 100 BPM
# Key: Db Major (warm, sunny)
# Rhythm: 4/4 kick, off-beat hats and chords, claps on 2/4
# Timbre: Deep sub-bass (dsaw, low cutoff), lush chords (blade),
# marimba/steel drum (fm, divisor 3), vocal chops (grain)
# Arrangement: Vibe (kick+hats+bass) → Groove (add claps+chords)
# → Drop (add marimba+vocal chops)
# ==========================================================

use_bpm 100

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores

# Soft 4/4 kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Thick clap on beats 2 and 4 (steps 4 and 12)
s_clap = gen_score("....x.......x...", [:c4])

# Off-beat hats (steps 2, 6, 10, 14) with varying amplitude
s_hats = gen_score("..x..x..x..x....",
  [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.4},
   {note: :c4, amp: 0.3}, {note: :c4, amp: 0.4}])

# Deep sub-bass – low cutoff for warmth, long release for roundness
s_bass = gen_score("x.......x.......",
  [{note: :db1, release: 0.5, cutoff: 60},
   {note: :ab1, release: 0.5, cutoff: 60}])

# Wide major chords (Dbmaj9 – Abmaj7) on the off-beats
s_chords = gen_score("..x..x..x..x....",
  [{note: [:db3, :f3, :ab3, :c4], cutoff: 100, release: 0.6, amp: 0.6},
   {note: [:db3, :f3, :ab3, :c4], cutoff: 100, release: 0.6, amp: 0.6},
   {note: [:ab2, :c3, :eb3, :g3], cutoff: 100, release: 0.6, amp: 0.6},
   {note: [:ab2, :c3, :eb3, :g3], cutoff: 100, release: 0.6, amp: 0.6}])

# Marimba/steel drum melody – FM with divisor 3 for woody tone
s_fm = gen_score("x.x.x.x.x.x.x.x.",
  [{note: :ab4, amp: 0.6, divisor: 3, depth: 2, release: 0.3},
   {note: :db5, amp: 0.5, divisor: 3, depth: 2, release: 0.3},
   {note: :eb5, amp: 0.6, divisor: 3, depth: 2, release: 0.3},
   {note: :db5, amp: 0.5, divisor: 3, depth: 2, release: 0.3},
   {note: :ab4, amp: 0.6, divisor: 3, depth: 2, release: 0.3},
   {note: :c5, amp: 0.5, divisor: 3, depth: 2, release: 0.3},
   {note: :bb4, amp: 0.6, divisor: 3, depth: 2, release: 0.3},
   {note: :ab4, amp: 0.6, divisor: 3, depth: 2, release: 0.3}])

# Vocal chops – granular stutter for beach texture
s_vocal = gen_score("....x.......x...",
  [{note: :db4, buffer: :ambi_choir, pos: 0.2, density: 3, size: 0.04, amp: 0.5},
   {note: :bb3, buffer: :ambi_choir, pos: 0.4, density: 3, size: 0.04, amp: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Vibe – Kick, Hats, Bass
  [ [:play_kick, s_kick, 4], [:play_hats, s_hats, 4],
    [:play_sub, s_bass, 4] ],

  # Scene 2: Groove – Add Claps and Chords
  [ [:play_kick, s_kick, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_snare, s_clap, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3: Drop – Add Marimba and Vocal Chops
  [ [:play_kick, s_kick, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_snare, s_clap, 8],
    [:play_chords, s_chords, 8], [:play_lead, s_fm, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The off-beat pocket: hats and chords hit on steps 2, 6, 10,
#   14 – the exact midpoints between kicks. This creates the
#   signature "boom-cha" bounce.
# - FM as marimba: divisor 3 and depth 2 narrow the harmonic
#   ratio, leaving a hollow, woody thunk – perfect for steel
#   drum or marimba textures.
# - Deep sub warmth: cutoff at 60 filters harsh highs, leaving
#   only a round, muffled rumble that anchors the bright chords.
# ==========================================================
