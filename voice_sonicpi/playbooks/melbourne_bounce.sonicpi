# ==========================================================
# PLAYBOOK: 2010s MELBOURNE BOUNCE
# ==========================================================
# High-energy festival bounce with squelching FM bass and driving off-beat groove.
# DNA: 126 BPM | Key E Minor | Rhythm: Off-beat bounce | Timbre: Squelchy, metallic, bright | Arrangement: Groove → Build → Drop
# ==========================================================

use_bpm 126

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# ==========================================================
# DRUM PATTERNS
# ==========================================================

# 4-on-the-floor kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Festival clap on beats 2 and 4
s_clap = gen_score("....x.......x...", [:c4])

# Off-beat open hats
s_hats = gen_score("..x...x...x...x.", [
  {amp: 0.4}, 
  {amp: 0.5}
])

# ==========================================================
# BASS LAYERS
# ==========================================================

# Squelching FM bounce bass with changing timbre per hit
s_bass = gen_score("..x...x...x...x.", [
  {note: :e2, divisor: 2, depth: 4, release: 0.12, amp: 1.0},
  {note: :e2, divisor: 3, depth: 5, release: 0.12, amp: 0.8},
  {note: :g2, divisor: 2, depth: 4, release: 0.12, amp: 1.0},
  {note: :d2, divisor: 4, depth: 6, release: 0.12, amp: 0.8}
])

# Clean sub bass on off-beats for low-end power
s_sub = gen_score("..x...x...x...x.", [
  {note: :e1, release: 0.15, amp: 1.0, cutoff: 60},
  {note: :g1, release: 0.15, amp: 1.0, cutoff: 60},
  {note: :d1, release: 0.15, amp: 1.0, cutoff: 60}
])

# ==========================================================
# MELODIC & HARMONIC ELEMENTS
# ==========================================================

# Ascending riser with increasing amplitude (steps 2-7)
s_riser = gen_score("..xxxxxxxx......", [
  {note: :e5, amp: 0.2, divisor: 3, depth: 2, release: 0.1},
  {note: :f5, amp: 0.3, divisor: 3, depth: 2, release: 0.1},
  {note: :g5, amp: 0.4, divisor: 3, depth: 2, release: 0.1},
  {note: :a5, amp: 0.5, divisor: 3, depth: 2, release: 0.1},
  {note: :b5, amp: 0.6, divisor: 3, depth: 2, release: 0.1},
  {note: :c6, amp: 0.7, divisor: 3, depth: 2, release: 0.1}
])

# Off-beat chord stabs (Em → G → D)
s_chords = gen_score("..x..x..x..x..x.", [
  [:e3, :g3, :b3],
  [:g3, :b3, :d4],
  [:d3, :f3, :a3]
])

# Brassy FM lead on the off-beats
s_fm = gen_score("....x...x...x...", [
  {note: :e5, amp: 0.6, divisor: 2, depth: 4, release: 0.1},
  {note: :g5, amp: 0.5, divisor: 2, depth: 4, release: 0.1},
  {note: :b5, amp: 0.7, divisor: 2, depth: 4, release: 0.1}
])

# Metallic blips for rhythmic texture
s_blip = gen_score("..x.....x.....x.", [
  {note: :c5, divisor: 4, depth: 2, release: 0.2, amp: 0.6},
  {note: :e5, divisor: 4, depth: 2, release: 0.2, amp: 0.5},
  {note: :g5, divisor: 4, depth: 2, release: 0.2, amp: 0.6}
])

# ==========================================================
# PLAYBOOK STRUCTURE
# ==========================================================

playbook = (ring
  
  # Scene 1: The Groove (4 bars)
  # Foundation: Kick, bounce bass, and sub
  [
    [:play_kick, s_kick, 4],
    [:play_fm,   s_bass, 4],
    [:play_sub,  s_sub,  4]
  ],
  
  # Scene 2: The Build (8 bars)
  # Add claps, hats, and riser for tension
  [
    [:play_kick, s_kick, 8],
    [:play_fm,   s_bass, 8],
    [:play_sub,  s_sub,  8],
    [:play_snare, s_clap, 8],
    [:play_hats,  s_hats, 8],
    [:play_fm,    s_riser, 8]
  ],
  
  # Scene 3: The Drop (8 bars)
  # Full arrangement with chords, lead, and blips
  [
    [:play_kick,   s_kick, 8],
    [:play_fm,     s_bass, 8],
    [:play_sub,    s_sub,  8],
    [:play_snare,  s_clap, 8],
    [:play_hats,   s_hats, 8],
    [:play_fm,     s_riser, 8],
    [:play_chords, s_chords, 8],
    [:play_lead,   s_fm, 8],
    [:play_fm,     s_blip, 8]
  ]
)

# ==========================================================
# RUN
# ==========================================================

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - FM bass uses changing divisor/depth for squelching, talking effect
# - Dual bass layers (FM + sub) create massive low-end presence
# - Ascending riser builds tension with increasing amplitude
# - Off-beat chord stabs define the Melbourne bounce signature
# - Metallic blips add rhythmic texture to the drop
# ==========================================================
