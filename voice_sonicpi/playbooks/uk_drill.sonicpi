use_bpm 140

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F Minor - Melancholy & Aggressive)
# ==========================================================

# Half-time, syncopated kick. Hits on step 0, the 'a' of 2 (step 7), and beat 3 (step 8).
s_kick  = (ring :c4, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, {:note => :c4, :amp => 1.0}, nil, nil, nil, nil, nil, nil, nil)

# Heavy, metallic snare strictly on beat 3 (step 8), with a ghost snare on the 'a' of 4.
s_snare = (ring nil, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 1.0}, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.5}, nil)

# The signature Drill Hi-Hat Rolls.
# Notice steps 3,4,5 and 11,12,13. By using rapidly rising amplitudes, 
# we simulate a 16th-note trill/roll that accelerates into the next beat.
s_hats  = (ring {:note => :c4, :amp => 0.3}, nil, nil, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.4}, nil, nil, 
           {:note => :c4, :amp => 0.3}, nil, nil, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.5}, nil)

# The "Sliding 808" Bass. 
# Long releases make it ring out and carry the melancholic melody.
s_bass  = (ring {:note => :f2, :release => 1.5}, nil, nil, nil, nil, nil, nil, nil, 
           {:note => :ab2, :release => 1.5}, nil, nil, nil, nil, nil, nil, nil)

# Melancholic minor 7th piano chords (Fm7 to Abm7).
# Hit on the off-beats to leave room for the sliding 808s.
s_chords= (ring nil, nil, [:f3, :ab3, :eb4, :g4], nil, nil, nil, nil, nil, 
           nil, nil, [:ab3, :cb4, :gb4, :bb4], nil, nil, nil, nil, nil)

# High-pitched, dark granular vocal whisper (Granular Synth)
s_vocal = (ring nil, nil, nil, nil, nil, nil, nil, nil, 
           {:note => :f4, :buffer => :ambi_choir, :pos => 0.6, :density => 2, :size => 0.1, :amp => 0.4}, nil, nil, nil, 
           nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the melancholic chords and 808 bass (4 bars)
  [ [:play_chords, s_chords, 4], [:play_sub, s_bass, 4] ],
  
  # Scene 2: Add the half-time drums and rolling hats (8 bars)
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: Add the dark granular vocal chops (8 bars)
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
