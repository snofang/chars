# ==========================================================
# PLAYBOOK: MODERN LATIN TRAP / REGGAETON FUSION
# (Pioneered by Bad Bunny, J Balvin, and Tainy)
# ==========================================================
# [WHY THIS GENRE?]
# Modern Latin Trap fuses the 3‑3‑2 Dembow pulse with Trap
# hi‑hat rolls and sliding 808s. At 92 BPM, it creates a slow,
# heavy, swaggering groove that dominates global charts.
# [DNA: 92 BPM, C minor, Dembow kick, trap rimshots, sliding 808,
#  dark chords, FM flute/marimba, granular vocal chant]
# ==========================================================

use_bpm 92

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# ----------------------------------------------------------
# SCORES – Normalized with gen_score & DRY parameters
# ----------------------------------------------------------

# Dembow kick – hits on steps 0,3,6,8 (3‑3‑2 feel)
kick_hits = [:c4, {note: :c4, amp: 0.6}, {note: :c4, amp: 0.8}, {note: :c4, amp: 1.0}, {note: :c4, amp: 0.6}]
s_kick = gen_score("x..x..x.x..x....", kick_hits)

# Trap‑style rimshot/snare – fills the gaps
snare_hits = [{note: :c4, amp: 0.7}, {note: :c4, amp: 0.9}, {note: :c4, amp: 0.4},
              {note: :c4, amp: 0.7}, {note: :c4, amp: 0.9}, {note: :c4, amp: 0.4}]
s_snare = gen_score("..x..x.x..x..x.x", snare_hits)

# Trap hi‑hats with rising amplitude roll
hat_amps = [0.3, 0.2, 0.3, 0.4, 0.3, 0.2, 0.3, 0.4, 0.5]
s_hats = gen_score("x..xx.x..x..xxx.",
  hat_amps.map { |a| {note: :c4, amp: a} })

# Sliding 808 bass – long release (1.0) for weight
s_bass = gen_score("x.......x.......",
  [{note: :c1, release: 1.0, cutoff: 80},
   {note: :f1, release: 1.0, cutoff: 80}])

# Dark sparse chords – off‑beats, short release
s_chords = gen_score("....x.......x...",
  [{note: [:c3, :eb3, :g3], cutoff: 90, release: 0.3, amp: 0.5},
   {note: [:f3, :ab3, :c4], cutoff: 90, release: 0.3, amp: 0.5}])

# Mellow FM flute/marimba – divisor 2, depth 2 for organic pluck
fm_notes = [:g5, :eb5, :c5, :ab5, :f5, :c5]
fm_defaults = {divisor: 2, depth: 2, release: 0.3, amp: 0.6}
s_fm = gen_score(".x.x.x...x.x.x..",
  fm_notes.map { |n| {note: n, **fm_defaults} })

# Rhythmic vocal chant – granular, medium density, small size
vocal_hits = [{note: :c4, pos: 0.2}, {note: :f4, pos: 0.4}]
s_vocal = gen_score("....x......x....",
  vocal_hits.map { |h| {note: h[:note], buffer: :ambi_choir,
                        pos: h[:pos], density: 2, size: 0.05, amp: 0.6} })

# ----------------------------------------------------------
# PLAYBOOK – In‑line and readable
# ----------------------------------------------------------
playbook = (ring
  # Scene 1 – The Vibe: 808, chords, and vocal chant (4 bars)
  [ [:play_sub, s_bass, 4],
    [:play_chords, s_chords, 4],
    [:play_grain, s_vocal, 4] ],

  # Scene 2 – The Groove: add Dembow kick, trap snares, hats (8 bars)
  [ [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8],
    [:play_grain, s_vocal, 8],
    [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8] ],

  # Scene 3 – The Drop: mellow flute melody enters (8 bars)
  [ [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8],
    [:play_grain, s_vocal, 8],
    [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# 1. Dembow/Trap Blend – the kick keeps the 3‑3‑2 pulse while
#    the snare abandons rigid reggaeton for organic trap rimshots,
#    creating a hybrid groove.
# 2. Sliding 808 – release 1.0 at 92 BPM lets the bass ring out,
#    carrying the dark melody with massive low‑end.
# 3. Mellow FM Flute – divisor 2, depth 2 create an organic pluck;
#    tape echo cascades the sparse notes across the mix.
# ==========================================================
