# ==========================================================
# PLAYBOOK: NEW JACK SWING
# (Pioneered by Janet Jackson, Bobby Brown, and Bell Biv DeVoe)
# ==========================================================
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose New Jack Swing (NJS).
# We have explored rigid 4/4 genres (Hardbass) and half-time genres (Trap).
# New Jack Swing is the sound of late 80s/early 90s R&B. It takes the 
# 16-step grid and applies an extreme "MPC Swing" to it. The kicks are 
# lopsided, the snares have massive ghost notes, and the chords are bright, 
# staccato, and highly syncopated.
#
# This playbook perfectly demonstrates how to simulate that classic "baggy" 
# swing feel on a rigid 16-step sequencer. By utilizing specific off-beat 
# grid placements and dynamic amplitude Hashes, the engine creates a bouncy, 
# kinetic groove that defined an era of dance music.
# ==========================================================

use_bpm 112

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F Major - Bouncy & Baggy)
# ==========================================================

# The "Swung" Kick. 
# Hits on step 0, the 'a' of 1 (step 3), beat 3 (step 8), and the 'a' of 3 (step 11).
# This lopsided placement creates the classic NJS "stagger".
s_kick  = (ring :c4, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil, nil, {:note => :c4, :amp => 1.0}, nil, nil, {:note => :c4, :amp => 0.7}, nil, nil, nil, nil)

# Heavy snare on beats 2 and 4 (steps 4 and 12), with a ghost snare on the 'a' of 2.
s_snare = (ring nil, nil, nil, nil, {:note => :c4, :amp => 1.0}, nil, nil, {:note => :c4, :amp => 0.3}, nil, nil, nil, nil, {:note => :c4, :amp => 1.0}, nil, nil, nil)

# The "MPC Swing" Hats.
# Instead of straight 16ths, they hit on the 'e' and 'a' with varying amplitudes
# to simulate a human drummer playing with a 54% swing quantize.
s_hats  = (ring {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.5}, nil, nil, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.5}, nil, nil, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.3})

# Deep, round Moog-style bass.
# Plays a highly syncopated countermelody to the kicks.
s_bass  = (ring {:note => :f2, :release => 0.3}, nil, nil, :f2, nil, nil, {:note => :f2, :amp => 0.6}, nil, {:note => :d2, :release => 0.3}, nil, nil, :d2, nil, nil, {:note => :c2, :amp => 0.6}, nil)

# Bright, staccato Major 9th chords (Fmaj9 to Bbmaj9).
# Hit on the off-beats (steps 1, 6, 9, 14) to leave room for the heavy kick syncopations.
s_chords= (ring nil, [:f3, :a3, :c4, :e4], nil, nil, nil, nil, [:f3, :a3, :c4, :e4], nil, nil, [:bb3, :d4, :f4, :a4], nil, nil, nil, nil, [:bb3, :d4, :f4, :a4], nil)

# The "Alto Sax" Melody (F Major Pentatonic).
# Uses :play_fm with specific Hashes to create a sharp, brassy staccato hit.
s_fm    = (ring nil, nil, nil, nil, {:note => :a4, :amp => 0.7, :depth => 3, :divisor => 2, :release => 0.2}, nil, {:note => :c5, :amp => 0.6, :depth => 3, :divisor => 2, :release => 0.2}, nil, nil, nil, nil, nil, nil, nil, {:note => :a4, :amp => 0.7, :depth => 3, :divisor => 2, :release => 0.2}, nil)

# Rhythmic, pitching vocal chop (Granular Synth)
s_vocal = (ring nil, nil, nil, nil, nil, nil, nil, nil, {:note => :f4, :buffer => :ambi_choir, :pos => 0.1, :density => 3, :size => 0.04, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Drums and syncopated bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Vibe - Add the bright staccato chords (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Hook - The Alto Sax melody and vocal chops drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], 
    [:play_fm, s_fm, 8], [:play_grain, s_vocal, 4] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN SWING]
# 
# 1. The "Baggy" Kick: Look at `s_kick`. It completely avoids hitting 
#    on the straight 8th notes (steps 4 and 12). Instead, it hits on 
#    steps 0, 3, 8, and 11. This specific 3-3-2-3 placement pushes 
#    the kick drum slightly late, creating that lopsided, "baggy" 
#    street feel that defined producers like Jimmy Jam & Terry Lewis.
#
# 2. Amplitude Swing: Look at `s_hats`. The hi-hats don't just hit on 
#    every 16th note; their amplitudes swing wildly between 0.2, 0.4, 
#    and 0.5. By emphasizing the "e" and "a" of the beat, the engine 
#    simulates the famous 54% MPC swing setting without ever breaking 
#    the rigid `sleep 0.25` master clock.
#
# 3. FM as Brass: The `s_fm` sequence uses `divisor: 2` and `depth: 3` 
#    to turn the FM synth into a sharp, brassy staccato hit. By keeping 
#    the `release` extremely short (`0.2`), it perfectly mimics an alto 
#    saxophone player hitting quick, funky stabs over a dance beat.
# ==========================================================
