# ==========================================================
# PLAYBOOK: NEW JACK SWING
# (Pioneered by Janet Jackson, Bobby Brown, and Bell Biv DeVoe)
# ==========================================================
# [WHY THIS GENRE?]
# New Jack Swing applies extreme "MPC Swing" to the grid – lopsided
# kicks, ghost snares, and bright staccato chords. This playbook
# simulates that "baggy" feel using off‑beat grid placements and
# dynamic amplitude hashes.
# [DNA: 112 BPM, F major, swung kick, ghost snare, MPC swing hats,
#  syncopated bass, staccato major chords, brassy FM lead, vocal chop]
# ==========================================================

use_bpm 112

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# ----------------------------------------------------------
# SCORES – Normalized with gen_score – behavior identical to original
# ----------------------------------------------------------

# Swung kick – hits on steps 0,3,8,11 (lopsided 3‑3‑2‑3 placement)
s_kick = gen_score("x..x....x..x....",
  [:c4,
   {note: :c4, amp: 0.8},
   {note: :c4, amp: 1.0},
   {note: :c4, amp: 0.7}])

# Heavy snare on beats 2 & 4, with a ghost on the 'a' of 2 (step 7)
s_snare = gen_score("....x..x....x...",
  [{note: :c4, amp: 1.0},
   {note: :c4, amp: 0.3},
   {note: :c4, amp: 1.0}])

# MPC swing hats – hits on 'e' and 'a' with varying amplitude
s_hats = gen_score("x.xx..xxx.xx..xx",
  [{note: :c4, amp: 0.2}, {note: :c4, amp: 0.4}, {note: :c4, amp: 0.5},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}, {note: :c4, amp: 0.4},
   {note: :c4, amp: 0.3}])

# Syncopated Moog‑style bass – countermelody to kicks
s_bass = gen_score("x..x..x.x..x..x.",
  [{note: :f2, release: 0.3},
   :f2,
   {note: :f2, amp: 0.6},
   {note: :d2, release: 0.3},
   :d2,
   {note: :c2, amp: 0.6}])

# Bright staccato major 9th chords – off‑beats (steps 1,6,9,14)
s_chords = gen_score(".x....x..x....x.",
  [[:f3, :a3, :c4, :e4],
   [:f3, :a3, :c4, :e4],
   [:bb3, :d4, :f4, :a4],
   [:bb3, :d4, :f4, :a4]])

# Alto sax melody – brassy FM stabs on steps 4,6,14
s_fm = gen_score("....x.x.......x.",
  [{note: :a4, amp: 0.7, depth: 3, divisor: 2, release: 0.2},
   {note: :c5, amp: 0.6, depth: 3, divisor: 2, release: 0.2},
   {note: :a4, amp: 0.7, depth: 3, divisor: 2, release: 0.2}])

# Rhythmic vocal chop – one hit on step 8
s_vocal = gen_score("........x.......",
  [{note: :f4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.5}])

# ----------------------------------------------------------
# PLAYBOOK – In‑line and readable
# ----------------------------------------------------------
playbook = (ring
  # Scene 1 – The Groove: drums and syncopated bass (4 bars)
  [ [:play_kick, s_kick, 4],
    [:play_snare, s_snare, 4],
    [:play_hats, s_hats, 4],
    [:play_sub, s_bass, 4] ],

  # Scene 2 – The Vibe: add bright staccato chords (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3 – The Hook: alto sax and vocal chops (8 bars for most, vocal 4 bars)
  [ [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8],
    [:play_fm, s_fm, 8],
    [:play_grain, s_vocal, 4] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# 1. "Baggy" Kick – hits on 0,3,8,11 avoid straight 8th notes,
#    creating a lopsided street feel (a signature of Jimmy Jam & Terry Lewis).
# 2. Amplitude Swing – hi‑hats vary from 0.2 to 0.5, emphasising
#    the "e" and "a" to simulate a 54% MPC swing without breaking the grid.
# 3. FM as Brass – divisor 2 & depth 3 produce a sharp staccato
#    hit with short release (0.2), mimicking an alto sax stab.
# ==========================================================
