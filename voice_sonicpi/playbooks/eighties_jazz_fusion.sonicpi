# ==========================================================
# PLAYBOOK: 80s JAZZ FUSION / SYNTH FUNK
# (Pioneered by Casiopea, T-Square, and Masayoshi Takanaka)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 80s Jazz Fusion.
# We have explored 80s City Pop (which is laid back) and Electro Swing 
# (which is sample-based). Jazz Fusion is the sound of pure, technical 
# virtuosity. It pushes the 16-step grid to its absolute melodic and 
# rhythmic limits. It relies on hyper-syncopated, ghost-note-heavy drum 
# breaks, continuous 16th-note slap bass, and bright, shredding FM 
# synthesizer solos (like the Yamaha DX7).
#
# This playbook perfectly demonstrates how to push the engine's master 
# clock to a high tempo (135 BPM) while filling almost every 16th step 
# with complex, interlocking instrumental data. It is a masterclass in 
# density and precision.
# ==========================================================

use_bpm 135

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (E Minor - Bright, Technical, & Fast)
# ==========================================================

# The "Fusion" Kick. 
# Highly syncopated. Hits on step 0, the 'a' of 1 (step 3), 
# the 'and' of 2 (step 6), beat 3 (step 8), and the 'a' of 3 (step 11).
s_kick  = (ring :c4, nil, nil, {:note => :c4, :amp => 0.6}, nil, nil, {:note => :c4, :amp => 0.8}, nil, {:note => :c4, :amp => 1.0}, nil, nil, {:note => :c4, :amp => 0.5}, nil, nil, {:note => :c4, :amp => 0.7}, nil)

# Crisp, technical snare with heavy ghost notes on the 'a' of 2 and 'a' of 4.
s_snare = (ring nil, nil, nil, nil, {:note => :c4, :amp => 0.9}, nil, nil, {:note => :c4, :amp => 0.3}, nil, nil, nil, nil, {:note => :c4, :amp => 0.9}, nil, {:note => :c4, :amp => 0.3}, nil)

# Rigid, driving 16th hats to maintain the high-speed momentum.
s_hats  = (ring {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2})

# The "Slap Bass" (E Minor).
# Plays continuous, melodic 16th notes. The high cutoff (110) and very 
# short release (0.1) mimic an aggressive, picked/slapped electric bass.
s_bass  = (ring {:note => :e2, :cutoff => 110, :release => 0.1}, {:note => :e3, :cutoff => 110, :release => 0.1}, {:note => :e2, :cutoff => 110, :release => 0.1}, {:note => :d3, :cutoff => 110, :release => 0.1}, 
           {:note => :e2, :cutoff => 110, :release => 0.1}, {:note => :e3, :cutoff => 110, :release => 0.1}, {:note => :g2, :cutoff => 110, :release => 0.1}, {:note => :g3, :cutoff => 110, :release => 0.1}, 
           {:note => :a2, :cutoff => 110, :release => 0.1}, {:note => :a3, :cutoff => 110, :release => 0.1}, {:note => :a2, :cutoff => 110, :release => 0.1}, {:note => :g3, :cutoff => 110, :release => 0.1}, 
           {:note => :e2, :cutoff => 110, :release => 0.1}, {:note => :e3, :cutoff => 110, :release => 0.1}, {:note => :d2, :cutoff => 110, :release => 0.1}, {:note => :e3, :cutoff => 110, :release => 0.1})

# Bright, jazzy minor 9th and major 7th chords (Em9 to Cmaj7 to D13).
# Hit strictly on the off-beats (steps 2, 6, 10, 14) to leave room for the bass.
s_chords= (ring nil, nil, [:e3, :g3, :b3, :d4], nil, nil, nil, [:e3, :g3, :b3, :d4], nil, nil, nil, [:c3, :e3, :g3, :b3], nil, nil, nil, [:d3, :f3, :a3, :c4], nil)

# The "Shredding" FM Synth Lead (E Minor Pentatonic).
# Uses :play_fm with a low divisor (2) and depth (3) to create a sharp, 
# brassy DX7 tone. Plays a rapid, continuous 16th-note solo.
s_fm    = (ring {:note => :e5, :amp => 0.6, :divisor => 2, :depth => 3, :release => 0.1}, 
           {:note => :g5, :amp => 0.5, :divisor => 2, :depth => 3, :release => 0.1}, 
           {:note => :a5, :amp => 0.6, :divisor => 2, :depth => 3, :release => 0.1}, 
           {:note => :b5, :amp => 0.5, :divisor => 2, :depth => 3, :release => 0.1}, 
           {:note => :e6, :amp => 0.7, :divisor => 2, :depth => 3, :release => 0.1}, 
           {:note => :b5, :amp => 0.5, :divisor => 2, :depth => 3, :release => 0.1}, 
           {:note => :a5, :amp => 0.6, :divisor => 2, :depth => 3, :release => 0.1}, 
           nil, 
           {:note => :g5, :amp => 0.6, :divisor => 2, :depth => 3, :release => 0.1}, 
           {:note => :e5, :amp => 0.5, :divisor => 2, :depth => 3, :release => 0.1}, 
           {:note => :d5, :amp => 0.6, :divisor => 2, :depth => 3, :release => 0.1}, 
           {:note => :e5, :amp => 0.5, :divisor => 2, :depth => 3, :release => 0.1}, 
           {:note => :g5, :amp => 0.6, :divisor => 2, :depth => 3, :release => 0.1}, 
           {:note => :a5, :amp => 0.5, :divisor => 2, :depth => 3, :release => 0.1}, 
           {:note => :b5, :amp => 0.6, :divisor => 2, :depth => 3, :release => 0.1}, 
           {:note => :a5, :amp => 0.5, :divisor => 2, :depth => 3, :release => 0.1})

# Bright, Brass "Stab" hit (Granular Synth).
# High density, tiny size = a sharp, jazzy brass section stab.
s_vocal = (ring {:note => :e4, :buffer => :ambi_choir, :pos => 0.2, :density => 2, :size => 0.04, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the syncopated drums and slap bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Vibe - Add the bright, jazzy chords (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Solo - The shredding FM synth lead drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], 
    [:play_lead, s_fm, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN TECHNICAL DENSITY]
# 
# 1. The Slap Bass Illusion: Look at `s_bass`. The `:play_sub` synth (usually 
#    a deep rumble) is given a `cutoff` of `110` and a `release` of `0.1`. 
#    This strips away the sub-frequencies and cuts the note off instantly, 
#    turning the detuned sawtooth into an aggressive, percussive "thwack" 
#    that perfectly mimics a slapped electric bass guitar driving the rhythm.
#
# 2. Continuous 16th-Note Density: Jazz Fusion relies on continuous motion. 
#    The `s_bass`, `s_hats`, and `s_fm` sequences almost never rest. The 
#    engine's strict master clock ensures these 16-note sequences fire with 
#    absolute mathematical precision at 135 BPM, creating a relentless, 
#    high-energy wall of sound that feels like a live band playing in perfect 
#    sync.
#
# 3. FM as a DX7 Solo: The `s_fm` sequence uses `divisor: 2` and `depth: 3`. 
#    This harmonic ratio produces a sharp, brassy tone that perfectly mimics 
#    the legendary Yamaha DX7 presets used by 80s fusion bands. By routing 
#    it through the tape echo, the rapid 16th notes cascade and smear, 
#    simulating a shredding guitar/synth solo.
# ==========================================================
