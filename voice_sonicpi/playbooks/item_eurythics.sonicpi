# ==========================================================
# PLAYBOOK: EURYTHMICS - "SWEET DREAMS" (1983)
# ==========================================================

use_bpm 125

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (C Minor - Cold, Driving, & Hypnotic)
# ==========================================================

# Relentless, driving 4/4 LinnDrum kick. (4 x's, 1 element)
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, dry snare strictly on beats 2 and 4. (2 x's, 1 element)
s_snare = gen_score("....x.......x...", [:c4])

# Rigid, driving 8th hats. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Sweet Dreams" Sequencer Bass (C Minor).
# Plays the iconic, repetitive 8-note sequence. 
# High cutoff (100) and microscopic release (0.06) create a relentless, 
# hypnotic, buzzing analog churn. (8 x's, 8 elements)
bass_notes = [:c2, :c2, :g2, :g2, :ab2, :ab2, :f2, :f2]
bass_data = bass_notes.map { |n| {note: n, cutoff: 100, release: 0.06, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# Lush, "String Synth" Pad (Cm to Ab to Eb to G).
# Hit on the downbeats. The slow 1.0-beat attack and massive 3.0-beat release 
# blur the chords together into a continuous, cinematic wave. (4 x's, 4 elements)
s_chords = gen_score("x...x...x...x...", [
  {note: [:c3, :eb3, :g3], cutoff: 80, attack: 1.0, release: 3.0, amp: 0.4},
  {note: [:ab2, :c3, :eb3], cutoff: 80, attack: 1.0, release: 3.0, amp: 0.4},
  {note: [:eb3, :g3, :bb3], cutoff: 80, attack: 1.0, release: 3.0, amp: 0.4},
  {note: [:g3, :bb3, :d4], cutoff: 80, attack: 1.0, release: 3.0, amp: 0.4}
])

# Piercing, "Analog Brass" Lead (C Minor).
# Uses :play_fm with a low divisor (2) and mid depth (4) to create a sharp, 
# buzzy, analog brass tone. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:c5, :eb5, :g5, :f5, :eb5, :c5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, divisor: 2, depth: 4, release: 0.3} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Sweet dreams" Vocal Stutter (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched DOWN.
# High density, tiny size = a sharp, robotic, rhythmic vocal skip. (2 x's, 2 elements)
s_vocal = gen_score("....x.......x...", [
  {note: :c4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.6},
  {note: :eb4, buffer: :ambi_choir, pos: 0.3, density: 3, size: 0.04, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the sequencer bass, sweeping pads, and vocal chops (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Verse - Add the relentless 4/4 LinnDrum beat (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chorus - The piercing analog brass melody drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN 80S SYNTH-POP]
# 
# 1. The 8-Note Sequencer: Look at `s_bass`. The `:play_sub` synth plays the 
#    iconic C-C-G-G-Ab-Ab-F-F sequence on continuous 8th notes. By using a high 
#    `cutoff` (100) and a microscopic `release` (0.06), the engine turns the 
#    detuned sawtooth into a relentless, hypnotic, buzzing churn that perfectly 
#    mimics the legendary analog sequencer bassline of "Sweet Dreams".
#
# 2. The Analog Brass: The `s_lead` sequence uses `divisor: 2` and `depth: 4`. 
#    This harmonic ratio produces a sharp, buzzy, saw-like wave that cuts 
#    through the heavy mix. Because it's routed through the global tape echo 
#    bus, the sparse notes smear into a soaring, cinematic melody that perfectly 
#    anchors the track's cold, emotional atmosphere.
#
# 3. The Cinematic Swell: Look at `s_chords`. The Hashes specify an `attack` 
#    of `1.0` and a `release` of `3.0`. Because the engine reads these 
#    Hashes, the chords don't just hit; they slowly swell into the mix and 
#    fade away over four whole beats, creating a continuous, blurred wave 
#    of warm harmony that perfectly mimics the lush, wide-stereo string pads 
#    of 80s synth-pop.
# ==========================================================
