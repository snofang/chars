# ==========================================================
# PLAYBOOK: 90s HARD TRANCE / HARD DANCE
# (Pioneered by Scot Project, DuMonde, and Yoji Biomehanika)
# ==========================================================
# 
# [WHY THIS GENRE?]
# 90s Hard Trance is the aggressive, driving sound of German
# festivals at 140 BPM. It uses an off‑beat rolling bass,
# massive distorted supersaw stabs, and a continuous 16th‑note
# "Hoover" FM riff that sounds like a robot screaming.
# ==========================================================

use_bpm 140

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x...x...x...x...", [:c4])

s_clap  = gen_score("....x.......x...", [:c4])

s_hats  = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.5}
])

s_bass  = gen_score("..x...x...x...x.", [
  {note: :a1, release: 0.1, cutoff: 90},
  {note: :a1, release: 0.1, cutoff: 90},
  {note: :e1, release: 0.1, cutoff: 90},
  {note: :g1, release: 0.1, cutoff: 90}
])

s_chords = gen_score("..x...x...x...x.", [
  {note: [:a3, :c4, :e4], cutoff: 120, release: 0.3, amp: 0.6},
  {note: [:a3, :c4, :e4], cutoff: 120, release: 0.3, amp: 0.6},
  {note: [:f3, :a3, :c4], cutoff: 120, release: 0.3, amp: 0.6},
  {note: [:g3, :bb3, :d4], cutoff: 120, release: 0.3, amp: 0.6}
])

s_fm    = gen_score("xxxxxxxxxxxxxxxx", [
  {note: :a3,  divisor: 2, depth: 8, release: 0.1, amp: 0.7},
  {note: :a4,  divisor: 2, depth: 8, release: 0.1, amp: 0.5},
  {note: :a3,  divisor: 2, depth: 8, release: 0.1, amp: 0.7},
  {note: :e4,  divisor: 2, depth: 8, release: 0.1, amp: 0.5},
  {note: :a3,  divisor: 2, depth: 8, release: 0.1, amp: 0.7},
  {note: :a4,  divisor: 2, depth: 8, release: 0.1, amp: 0.5},
  {note: :c4,  divisor: 2, depth: 8, release: 0.1, amp: 0.7},
  {note: :e4,  divisor: 2, depth: 8, release: 0.1, amp: 0.5},
  {note: :f3,  divisor: 2, depth: 8, release: 0.1, amp: 0.7},
  {note: :f4,  divisor: 2, depth: 8, release: 0.1, amp: 0.5},
  {note: :f3,  divisor: 2, depth: 8, release: 0.1, amp: 0.7},
  {note: :c4,  divisor: 2, depth: 8, release: 0.1, amp: 0.5},
  {note: :g3,  divisor: 2, depth: 8, release: 0.1, amp: 0.7},
  {note: :g4,  divisor: 2, depth: 8, release: 0.1, amp: 0.5},
  {note: :bb3, divisor: 2, depth: 8, release: 0.1, amp: 0.7},
  {note: :d4,  divisor: 2, depth: 8, release: 0.1, amp: 0.5}
])

s_grain = gen_score("x.......x.......", [
  {note: :a4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.2, amp: 0.5},
  {note: :f4, buffer: :ambi_choir, pos: 0.5, density: 1, size: 0.2, amp: 0.5}
])

# Playbook
playbook = (ring
  # Scene 1: The Drive – kick, off‑beat bass, and hats (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_hats, s_hats, 4] ],
  
  # Scene 2: The Build – add claps, supersaw chords, and vocal pad (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8],
    [:play_snare, s_clap, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8] ],
    
  # Scene 3: The Drop – relentless Hoover FM riff drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8],
    [:play_snare, s_clap, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8],
    [:play_fm, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The FM "Hoover" riff uses divisor 2 and depth 8 to create
#   a buzzing, aggressive sound that plays on every 16th step.
# - Bass, hats, and chords lock on off‑beats (2,6,10,14) to
#   create the relentless "boom‑cha" pump at 140 BPM.
# - The supersaw chords use extreme cutoff (120) to cut through
#   the mix as sharp, distorted stabs.
# ==========================================================
