# ==========================================================
# PLAYBOOK: DEPECHE MODE - "JUST CAN'T GET ENOUGH" (1981)
# ==========================================================

use_bpm 128

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Bouncy, Mechanical, & Catchy)
# ==========================================================

# Relentless, driving 4/4 drum machine kick. (4 x's, 1 element)
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, dry snare strictly on beats 2 and 4. (2 x's, 1 element)
s_snare = gen_score("....x.......x...", [:c4])

# Off-beat open hats to drive the momentum. (4 x's, 4 elements)
s_hats = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, 
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}
])

# The "Sequencer" Bass (A Minor).
# Plays the iconic, bouncy, continuous 16th-note line, alternating octaves. 
# High cutoff (100) and microscopic release (0.06) create a relentless, 
# hypnotic, buzzing analog churn. (16 x's, 16 elements)
bass_notes = [:a1, :a2, :a1, :a2, :a1, :a2, :a1, :a2, 
              :g1, :g2, :g1, :g2, :g1, :g2, :g1, :g2]
bass_data = bass_notes.map { |n| {note: n, cutoff: 100, release: 0.06, amp: 1.0} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Stark, "Synth Brass" Stabs (Am to F to C to G).
# Uses :play_fm with a low divisor (2) and mid depth (4) to create a harsh, 
# staccato hit. Hit strictly on the off-beats. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:a3, :c4, :e4], divisor: 2, depth: 4, release: 0.15, amp: 0.6},
  {note: [:f3, :a3, :c4], divisor: 2, depth: 4, release: 0.15, amp: 0.6},
  {note: [:c3, :e3, :g3], divisor: 2, depth: 4, release: 0.15, amp: 0.6},
  {note: [:g3, :bb3, :d4], divisor: 2, depth: 4, release: 0.15, amp: 0.6}
])

# Piercing, "Catchy" Synth Lead (A Minor).
# Uses :play_fm with a high divisor (3) and mid depth (3) to create a sharp, 
# glassy, digital tone. Routed through the global tape echo. (8 x's, 8 elements)
lead_notes = [:a5, :c6, :e6, :c6, :a5, :e5, :c5, :a4]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, divisor: 3, depth: 3, release: 0.15} }
s_lead = gen_score("x.x.x.x.x.x.x.x.", lead_data)

# "Just can't get enough" Vocal Stutter (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched UP.
# High density, tiny size = a sharp, sugary, robotic vocal skip. (1 x, 1 element)
s_vocal = gen_score("........x.......", [
  {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the sequencer bass, synth stabs, and vocal chop (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Verse - Add the driving 4/4 drum machine beat (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chorus - The piercing, catchy synth lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN EARLY SYNTH-POP]
# 
# 1. The Sequencer Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step, alternating rapidly between the low octave (:a1) 
#    and the high octave (:a2). By using a high `cutoff` (100) and a microscopic 
#    `release` (0.06), the engine turns the detuned sawtooth into a relentless, 
#    bouncy, buzzing churn that perfectly mimics the legendary analog sequencer 
#    bassline that drives the track.
#
# 2. FM as a Synth Brass: Look at `s_chords`. The `:play_fm` synth is given 
#    a `divisor` of `2` and a `depth` of `4`, with a microscopic `release` 
#    (0.15). This forces the FM synth to produce a harsh, brassy, staccato 
#    "hit" that perfectly mimics the massive synth-brass section stabs that 
#    define the song's upbeat, catchy atmosphere.
#
# 3. The Catchy Lead: The `s_lead` sequence uses `divisor: 3` and `depth: 3`. 
#    This harmonic ratio produces a sharp, glassy, digital tone that cuts 
#    through the heavy mix. Because it's routed through the global tape echo 
#    bus, the rapid notes smear into a soaring, cascading melody that perfectly 
#    mimics the iconic vocal hook.
# ==========================================================
