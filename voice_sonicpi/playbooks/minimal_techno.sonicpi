# ==========================================================
# PLAYBOOK: MINIMAL TECHNO
# ==========================================================
# Stark, hypnotic techno with sparse percussion and evolving filter sweeps.
# DNA: 127 BPM | Key A Minor | Rhythm: Sparse 4-on-the-floor | Timbre: Clinical, sterile, evolving | Arrangement: Hypnosis → Machine → Echo
# ==========================================================

use_bpm 127

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# ==========================================================
# DRUM PATTERNS
# ==========================================================

# Driving 4-on-the-floor kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Sparse dry clap - only on beat 3
s_clap = gen_score("........x.......", [{amp: 0.6}])

# Micro hats on off-beats
s_hats = gen_score("..x..x..x..x..x.", [{amp: 0.15}])

# ==========================================================
# HYPNOTIC BASS WITH EVOLVING FILTER
# ==========================================================

# Sparse bassline with slowly evolving cutoff
# Filter opens from 60 to 90 and closes back down
s_bass = gen_score("x..x..x.x..x..x.", [
  {note: :a1, cutoff: 60},
  {note: :a1, cutoff: 65},
  {note: :a1, cutoff: 70},
  {note: :a1, cutoff: 80},
  {note: :a1, cutoff: 90},
  {note: :a1, cutoff: 75}
])

# ==========================================================
# TEXTURAL & MELODIC ELEMENTS
# ==========================================================

# Robotic FM click with echo
s_fm = gen_score("........x.....x.", [
  {note: :e5, amp: 0.5, divisor: 4, depth: 2, release: 0.1},
  {note: :a5, amp: 0.4, divisor: 4, depth: 2, release: 0.1}
])

# Subliminal granular drone
s_grain = gen_score("x...............", [
  {note: :a3, buffer: :elec_piano, pos: 0.1, density: 1, size: 0.2, amp: 0.3}
])

# ==========================================================
# PLAYBOOK STRUCTURE
# ==========================================================

playbook = (ring
  
  # Scene 1: The Hypnosis (4 bars)
  # Kick, sweeping bass, and drone
  [
    [:play_kick,  s_kick, 4],
    [:play_sub,   s_bass, 4],
    [:play_grain, s_grain, 4]
  ],
  
  # Scene 2: The Machine (8 bars)
  # Add micro-hats and clap
  [
    [:play_kick,  s_kick, 8],
    [:play_sub,   s_bass, 8],
    [:play_grain, s_grain, 8],
    [:play_hats,  s_hats, 8],
    [:play_snare, s_clap, 8]
  ],
  
  # Scene 3: The Echo (8 bars)
  # Robotic FM blips complete the arrangement
  [
    [:play_kick,  s_kick, 8],
    [:play_sub,   s_bass, 8],
    [:play_grain, s_grain, 8],
    [:play_hats,  s_hats, 8],
    [:play_snare, s_clap, 8],
    [:play_fm,    s_fm, 8]
  ]
)

# ==========================================================
# RUN
# ==========================================================

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Evolving cutoff creates motion without adding new notes
# - Extreme negative space makes sparse hits feel heavy
# - High FM divisor creates piercing robotic clicks
# - Subtle granular drone anchors the minimal arrangement
# - Micro-hats add rhythm without clutter
# ==========================================================
