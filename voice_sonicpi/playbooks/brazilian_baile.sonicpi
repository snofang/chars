use_bpm 130

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F Minor - Aggressive & Bouncy)
# ==========================================================

# The "Tamborzão" Kick. 
# Hits on step 0, beat 3 (step 8), and a syncopated hit on the 'and' of 3 (step 10).
s_kick  = (ring :c4, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 1.0}, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil, nil, nil)

# The metallic Tamborzão Woodblock/Snare.
# Highly syncopated, hits on the off-beats (steps 3, 6, 11, 14).
s_snare = (ring nil, nil, nil, {:note => :c4, :amp => 0.7}, nil, nil, {:note => :c4, :amp => 0.9}, nil, nil, nil, nil, {:note => :c4, :amp => 0.6}, nil, nil, {:note => :c4, :amp => 0.8}, nil)

# Fast, driving 16th hats
s_hats  = (ring {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, 
           {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, 
           {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, 
           {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2})

# The Booming, Rhythmic 808 Bass. 
# Acts as a melodic bounce. Short release to make it punchy.
s_bass  = (ring {:note => :f1, :release => 0.3}, nil, nil, nil, nil, nil, {:note => :f1, :release => 0.3}, nil, 
           {:note => :ab1, :release => 0.3}, nil, nil, nil, nil, nil, {:note => :c2, :release => 0.3}, nil)

# Aggressive, synth brass/bell stabs (F Minor).
# Uses Hashes to change the FM depth for a "talking" synth effect.
s_fm    = (ring nil, {:note => :f4, :amp => 0.7, :depth => 3}, nil, nil, nil, nil, {:note => :ab4, :amp => 0.8, :depth => 4}, nil, 
           nil, {:note => :c5, :amp => 0.6, :depth => 2}, nil, nil, nil, nil, {:note => :f4, :amp => 0.7, :depth => 3}, nil)

# Chopped, rhythmic MC vocal shout (Granular Synth)
# High density, small size = percussive vocal stutter
s_vocal = (ring nil, nil, nil, nil, {:note => :f4, :buffer => :misc_lori, :pos => 0.2, :density => 4, :size => 0.03}, nil, nil, nil, 
           nil, nil, nil, nil, {:note => :ab4, :buffer => :misc_lori, :pos => 0.4, :density => 4, :size => 0.03}, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the Tamborzão rhythm (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4] ],
  
  # Scene 2: Add the booming 808 bass bounce (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8] ],
    
  # Scene 3: Add the aggressive FM stabs and vocal chops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_fm, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
