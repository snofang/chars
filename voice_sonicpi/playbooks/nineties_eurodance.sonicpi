# ==========================================================
# PLAYBOOK: 90s EURODANCE
# (Pioneered by Snap!, Haddaway, Culture Beat, and 2 Unlimited)
# ==========================================================
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Eurodance.
# We have explored underground genres (Gqom, Witch House) and modern 
# festival sounds (Melodic Techno, Hyperpop). Eurodance is the sound 
# of pure, unadulterated 90s mainstream radio. It perfectly fuses the 
# relentless 4/4 grid of house music with aggressive, off-beat synth 
# basses, staccato piano stabs, and piercing, high-energy FM synth riffs.
#
# This playbook perfectly demonstrates the classic "Rhythm of the Night" 
# formula. By stacking the bass, chords, and open hats strictly on the 
# off-beats, the engine creates that massive, bouncing "boom-cha" groove 
# that dominated global dancefloors in 1993.
# ==========================================================

use_bpm 135

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - High Energy & Euphoric)
# ==========================================================

# Relentless, driving 4-on-the-floor kick.
s_kick  = (ring :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil)

# Heavy, rave-style clap strictly on beats 2 and 4 (steps 4 and 12).
s_clap  = (ring nil, nil, nil, nil, :c4, nil, nil, nil, nil, nil, nil, nil, :c4, nil, nil, nil)

# Off-beat open hats. Notice they hit exactly between the kicks.
s_hats  = (ring nil, nil, {:note => :c4, :amp => 0.4}, nil, nil, nil, {:note => :c4, :amp => 0.5}, nil, 
           nil, nil, {:note => :c4, :amp => 0.4}, nil, nil, nil, {:note => :c4, :amp => 0.5}, nil)

# The "Off-Beat" Rave Bass. 
# Hits strictly on the off-beats (steps 2, 6, 10, 14).
# Very short release (0.15) makes it punchy and bouncy.
s_bass  = (ring nil, nil, {:note => :a2, :amp => 1.2, :release => 0.15}, nil, nil, nil, {:note => :a2, :amp => 1.2, :release => 0.15}, nil, 
           nil, nil, {:note => :c3, :amp => 1.2, :release => 0.15}, nil, nil, nil, {:note => :g2, :amp => 1.2, :release => 0.15}, nil)

# Staccato, high-energy piano/house stabs (A Minor).
# Hits in sync with the off-beat bass to create a massive wall of sound.
s_chords= (ring nil, nil, [:a3, :c4, :e4], nil, nil, nil, [:a3, :c4, :e4], nil, 
           nil, nil, [:g3, :bb3, :d4], nil, nil, nil, [:f3, :a3, :c4], nil)

# Piercing, high-energy synth riff (A Minor).
# Uses :play_fm with a high divisor to create a bright, piercing rave melody.
# Routed through the engine's tape echo for a classic 90s space echo smear.
s_fm    = (ring :a4, nil, :c5, :e5, :a5, nil, :e5, :c5, 
           :g4, nil, :c5, :e5, :g5, nil, :e5, :c5)

# Pitched-up, "Diva" vocal chops (Granular Synth)
# High density, tiny size = a sharp, rhythmic vocal stutter.
s_vocal = (ring nil, nil, nil, nil, {:note => :a4, :buffer => :misc_lori, :pos => 0.2, :density => 3, :size => 0.04, :amp => 0.6}, nil, nil, nil, 
           nil, nil, nil, nil, {:note => :c5, :buffer => :misc_lori, :pos => 0.4, :density => 3, :size => 0.04, :amp => 0.6}, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the kick, off-beat bass, and hats (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_hats, s_hats, 4] ],
  
  # Scene 2: The Vibe - Add the heavy claps and piano stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8], 
    [:play_snare, s_clap, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Drop - The piercing synth riff and diva vocals drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8], 
    [:play_snare, s_clap, 8], [:play_chords, s_chords, 8], 
    [:play_fm, s_fm, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN 90s RADIO ENERGY]
# 
# 1. The Off-Beat Wall: Look at `s_bass`, `s_hats`, and `s_chords`. They 
#    ALL hit strictly on steps 2, 6, 10, and 14. In a 16-step grid, these 
#    are the exact midpoints between the kicks. Because the engine's master 
#    clock locks these together perfectly at 135 BPM, the track physically 
#    "bounces" up and down, creating the signature Eurodance "boom-cha" 
#    momentum that makes people want to dance.
#
# 2. Staccato Pianos: Look at `s_chords`. The arrays hit strictly on the 
#    off-beats. Because the engine's `:play_chords` synth uses a sharp 
#    attack, these minor chords sound like a razor blade slicing perfectly 
#    between the bassline notes, emulating the classic Korg M1 piano stabs 
#    of the 90s.
#
# 3. Piercing FM Riffs: The `s_fm` sequence plays a rapid, 8th-note arpeggio. 
#    By using `divisor: 2` (default in our hash, but let's imagine the 
#    engine's bright FM tone) and routing it through the tape echo, the 
#    engine creates a piercing, shimmering riff that cuts through the heavy 
#    bass and kicks, perfectly mimicking the synth hooks of 2 Unlimited 
#    and Culture Beat.
# ==========================================================
