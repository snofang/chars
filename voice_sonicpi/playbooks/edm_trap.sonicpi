# ==========================================================
# PLAYBOOK: 2010s EDM TRAP / FESTIVAL TRAP
# Heavy, Festival-Ready, Bouncy Energy
# ==========================================================
# [WHY THIS GENRE?]
# EDM Trap (RL Grime, Flosstradamus) fuses 808s and hi‑hat
# rolls with massive supersaw chords and aggressive brass‑like
# FM stabs. This playbook captures that high‑energy, stadium‑
# ready festival drop.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 150 BPM
# Key: F minor (heavy, dark)
# Rhythm: Half‑time kick (1, ghost on 'a' of 3), snare on beat 3,
# trap hat roll with rising amplitudes, sliding 808 on downbeats,
# off‑beat supersaw chords, aggressive FM stabs, vocal grunts.
# Timbre: Heavy kick (bd_haus with accents), massive snare
# (sn_dolf), trap hats (cymbal_closed with velocity rolls),
# sliding 808 (dsaw, long release), supersaw chords (blade,
# high cutoff), brass FM stabs (divisor 2, depth 4), granular
# vocal grunt (ambi_choir).
# Arrangement: Build (808+chords+stabs) → Groove (add drums)
# → Drop (add vocal grunts).
# ==========================================================

use_bpm 150

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Half‑time kick – hits on step 0 and ghost on step 14
s_kick = gen_score("x.............x.",
  [{note: :c4, amp: 1.2}, {note: :c4, amp: 0.6}])

# Massive snare – hit on step 8 only
s_snare = gen_score("........x.......",
  [{note: :c4, amp: 1.1}])

# Trap hat roll – triggers on steps 0,3,6,7,8,10,12,13,14,15 with rising amps
s_hats = gen_score("x..x..xxx.x.xxxx",
  [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.3}, {note: :c4, amp: 0.4},
   {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.5}, {note: :c4, amp: 0.6},
   {note: :c4, amp: 0.7}, {note: :c4, amp: 0.8}])

# Sliding 808 bass – hits on steps 0 and 8
s_bass = gen_score("x.......x.......",
  [{note: :f1, release: 1.5, cutoff: 70, amp: 1.2},
   {note: :ab1, release: 1.5, cutoff: 70, amp: 1.0}])

# Supersaw chords – hits on steps 4 and 12
s_chords = gen_score("....x.......x...",
  [{note: [:f3, :ab3, :c4, :eb4], cutoff: 110, release: 0.3, amp: 0.6},
   {note: [:ab3, :c4, :eb4, :g4], cutoff: 110, release: 0.3, amp: 0.6}])

# Aggressive brass FM stabs – hits on steps 0,4,8,12
s_fm = gen_score("x...x...x...x...",
  [{note: :f4, amp: 0.6, divisor: 2, depth: 4, release: 0.1},
   {note: :ab4, amp: 0.5, divisor: 2, depth: 4, release: 0.1},
   {note: :c5, amp: 0.7, divisor: 2, depth: 4, release: 0.1},
   {note: :eb4, amp: 0.5, divisor: 2, depth: 4, release: 0.1}])

# Pitched‑down vocal grunt – hit on step 8
s_vocal = gen_score("........x.......",
  [{note: :f3, buffer: :ambi_choir, pos: 0.2, density: 2, size: 0.05, amp: 0.6}])

# Playbook
playbook = (ring
  # Scene 1: Build – 808, Chords, Stabs
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4],
    [:play_fm, s_fm, 4] ],

  # Scene 2: Groove – Add Drums
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8],
    [:play_fm, s_fm, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],

  # Scene 3: Drop – Add Vocal Grunts
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8],
    [:play_fm, s_fm, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The trap hat roll: rising amplitudes (0.2→0.8) on steps
#   12‑15 create a machine‑gun roll that builds tension.
# - The supersaw wall: off‑beat chords (steps 4 and 12) with
#   high cutoff (110) create a soaring, festival‑sized sound.
# - Rhythmic 808s: syncopated bass melody with long release
#   (1.5) locks with the kick for heavy, bouncing low‑end.
# - Brass FM stabs: divisor 2 and depth 4 produce a sharp,
#   brassy square wave that cuts through the mix.
# ==========================================================
