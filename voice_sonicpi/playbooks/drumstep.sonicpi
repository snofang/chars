# ==========================================================
# PLAYBOOK: DRUMSTEP / HALFTIME DNB
# Epic, Dark, Heavy, Half‑Time Energy at 174 BPM
# ==========================================================
# [WHY THIS GENRE?]
# Drumstep (Noisia, Nero) fuses the frantic 174 BPM grid of
# DnB with a heavy, swaggering half‑time drum pattern, massive
# distorted Reese basslines, and epic orchestral chord stabs.
# This playbook captures that festival‑sized, aggressive energy.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 174 BPM
# Key: E minor (epic, dark)
# Rhythm: Half‑time kick (1, ghost on 'a' of 2, beat 3), snare
# on beat 3, frantic 16th hats with rising roll, Reese bass on
# downbeats, epic chord stabs, metallic FM blips, ethereal
# granular pad.
# Timbre: Heavy kick (bd_haus with accents), massive snare
# (sn_dolf), frantic hats (cymbal_closed with amp roll),
# distorted Reese bass (dsaw, high cutoff, long release),
# orchestral chords (blade, high cutoff, long release),
# metallic FM blips (divisor 3, depth 4), granular pad
# (ambi_choir, long size).
# Arrangement: Intro (chords+bass+pad) → Drop (add drums) →
# Climax (add FM blips).
# ==========================================================

use_bpm 174

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Half‑time kick – hits on step 0, ghost on step 7, beat 3 (step 8)
s_kick = gen_score("x......xx.......",
  [{note: :c4, amp: 1.2},
   {note: :c4, amp: 0.6},
   {note: :c4, amp: 1.0}])

# Massive snare on beat 3 (step 8)
s_snare = gen_score("........x.......",
  [{note: :c4, amp: 1.1}])

# Frantic 16th hats with rising roll at end (steps 0‑15)
hat_data = [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.5},
  {note: :c4, amp: 0.6}, {note: :c4, amp: 0.7}
]
s_hats = gen_score("xxxxxxxxxxxxxxxx", hat_data)

# Distorted Reese bass – extreme cutoff, long release (steps 0 and 8)
s_bass = gen_score("x.......x.......",
  [{note: :e1, release: 1.5, cutoff: 120, amp: 1.0},
   {note: :e1, release: 1.5, cutoff: 120, amp: 1.0}])

# Epic orchestral chords – high cutoff, long release (steps 0 and 8)
s_chords = gen_score("x.......x.......",
  [{note: [:e3, :g3, :b3, :d4], cutoff: 110, release: 1.0, amp: 0.7},
   {note: [:c3, :e3, :g3, :b3], cutoff: 110, release: 1.0, amp: 0.7}])

# Metallic FM blips – high divisor, sharp (steps 6 and 14)
s_fm = gen_score("......x.......x.",
  [{note: :e5, amp: 0.6, divisor: 3, depth: 4},
   {note: :g5, amp: 0.5, divisor: 3, depth: 4}])

# Ethereal granular pad – long grains (steps 0 and 8)
s_grain = gen_score("x.......x.......",
  [{note: :e4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.3, amp: 0.5},
   {note: :c4, buffer: :ambi_choir, pos: 0.6, density: 1, size: 0.3, amp: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Intro – Chords + Bass + Pad
  [ [:play_chords, s_chords, 4], [:play_sub, s_bass, 4],
    [:play_grain, s_grain, 4] ],

  # Scene 2: Drop – Add Drums
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],

  # Scene 3: Climax – Add FM Blips
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_fm, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The half‑time illusion: kick on 0 and 8, snare on 8 at 174 BPM
#   creates a slow 87 BPM feel; frantic 16th hats fill the gaps.
# - Distorted Reese: cutoff 120 and release 1.5 push the dsaw
#   into overdrive, creating a roaring, grinding low‑end wall.
# - Cinematic contrast: long‑release chords and granular pad
#   provide an ethereal backdrop against the aggressive bass.
# ==========================================================
