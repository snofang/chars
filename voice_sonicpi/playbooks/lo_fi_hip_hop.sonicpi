# ==========================================================
# PLAYBOOK: LO-FI HIP-HOP / CHILLHOP
# ==========================================================
# Warm, swung boom-bap with jazzy 9th chords and dusty tape texture.
# DNA: 82 BPM | Key F Major | Rhythm: Dilla swing | Timbre: Warm, muffled, vinyl | Arrangement: Texture → Drums → Melody
# ==========================================================

use_bpm 82

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick = gen_score("x......x..x.....", [{amp: 0.8}, {amp: 1.0}])
s_snare = gen_score("....x.......x...", [{amp: 0.9}])
s_hats = gen_score("x.x.x.x.x.x.x.x.", [{amp: 0.3}, {amp: 0.15}, {amp: 0.4}, {amp: 0.15}])
s_bass = gen_score("x.......x.......", [{note: :f2, release: 0.6, cutoff: 75}, {note: :d2, release: 0.6, cutoff: 75}])
s_chords = gen_score("x.......x.......", [{note: [:f3, :a3, :c4, :e4], attack: 0.2, release: 1.5, cutoff: 90, amp: 0.6}, {note: [:d3, :f3, :a3, :c4], attack: 0.2, release: 1.5, cutoff: 90, amp: 0.6}])
s_fm = gen_score("....x...........", [{note: :c5, amp: 0.5, divisor: 2, depth: 1, release: 0.5}])
s_grain = gen_score("x...............", [{note: :f4, buffer: :elec_piano, pos: 0.3, density: 1, size: 0.3, amp: 0.4}])

# Playbook
playbook = (ring
  [ [:play_chords, s_chords, 4], [:play_sub, s_bass, 4], [:play_grain, s_grain, 4] ],
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], [:play_fm, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Dilla swing achieved through kick placement on steps 0, 7, 10
# - Chord voicings use Fmaj9 and Dm9 for warm jazz harmony
# - Granular texture creates vinyl warmth through time-stretched piano
# - Low cutoff and slow attack simulate muffled Rhodes piano
# - Long bass release anchors the low end without overpowering
# ==========================================================
