# ==========================================================
# PLAYBOOK: CLASSIC DUBSTEP (Wobble Bass)
# (Pioneered by Skream, Benga, and Coki)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose Classic Dubstep.
# We have explored modern heavy bass (Brostep) and dark garage (Future 
# Garage), but Classic Dubstep is the origin. At 140 BPM, it relies on 
# a half-time groove, massive sub-bass, and the iconic "LFO wobble"—a 
# filter that rapidly opens and closes in sync with the tempo.
#
# This playbook perfectly demonstrates how to simulate a hardware LFO 
# filter wobble purely via data. By playing continuous 16th notes and 
# rapidly alternating the `cutoff` Hashes between 60 (muffled) and 130 
# (bright) on every step, the engine forces the `:play_sub` synth to 
# "wub-wub" perfectly in time with the master clock.
# ==========================================================

use_bpm 140

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Half-time kick – hits on step 0 and ghost on step 14
s_kick = gen_score("x.............x.",
  [{note: :c4, amp: 1.2},
   {note: :c4, amp: 0.6}])

# Massive echoing snare – hits on step 8 only
s_snare = gen_score("........x.......",
  [{note: :c4, amp: 1.1}])

# Syncopated bouncing hats – hits on even steps with varying amps
s_hats = gen_score("x.x.x.x.x.x.x.x.",
  [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2}])

# Wobble bass – continuous 16ths with alternating cutoff (60 ↔ 130)
bass_data = 16.times.map do |i|
  {note: (i < 8 ? :f1 : :ab1), cutoff: (i.even? ? 60 : 130)}
end
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Dark sparse minor chord stab – hits on step 8
s_chords = gen_score("........x.......",
  [{note: [:f3, :ab3, :c4, :eb4], cutoff: 90, release: 0.5, amp: 0.5}])

# Deep echoing blip – hits on steps 3 and 12
s_fm = gen_score("...x........x...",
  [{note: :f5, amp: 0.6, divisor: 2, depth: 4, release: 0.3},
   {note: :c5, amp: 0.5, divisor: 2, depth: 4, release: 0.3}])

# Demonic vocal grunt – hit on step 8
s_vocal = gen_score("........x.......",
  [{note: :f3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.1, amp: 0.6}])

# Playbook
playbook = (ring
  # Scene 1: Wobble – Drums + Bass
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4],
    [:play_hats, s_hats, 4], [:play_sub, s_bass, 4] ],

  # Scene 2: Vibe – Add Chords
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3: Drop – Add Blips and Vocal Grunts
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8], [:play_lead, s_fm, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Data-driven LFO: alternating cutoff (60/130) on every 16th
#   step simulates a fast filter wobble without an LFO oscillator.
# - Half-time illusion: kick on 1 and snare on beat 3 at 140 BPM
#   create a slow 70 BPM feel; hats fill the gaps.
# - Demonic granular: pitched down to :f3 with low density (1)
#   and long grain (0.1) creates a monstrous, time‑stretched grunt.
# ==========================================================
