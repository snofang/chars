# ==========================================================
# PLAYBOOK: GQOM / DARK SOUTH AFRICAN HOUSE
# (Pioneered by DJ Lag, Distruction Boyz, and Naked Boyz)
# ==========================================================
# 
# [WHY THIS GENRE?]
# We have explored Amapiano (which is lush and jazzy) and Kwaito (which is 
# nostalgic and bouncy). Gqom translates to "drum" or "hit." Emerging from the 
# townships of Durban, it is a minimalist, dark, and highly syncopated offshoot 
# of house music. It strips away all melody and swing, relying on massive, 
# hollow sub-bass, broken 4/4 kick patterns, and relentless, ticking hi-hats 
# that create a feeling of deep, late-night tension.
#
# [THE CAREFULLY DESCRIBED DNA]
# 1. Tempo: 125 BPM. A relentless, dark, and hypnotic pace.
# 2. Harmonic Center: A Minor / Atonal. Dark, minimal, and tense.
# 3. Rhythmic Skeleton: A broken, syncopated 4/4 grid. Kicks avoid the 
#    standard pulse. Snares are sparse. Relentless 16th hats drive the momentum.
# 4. Timbral Palette:
#    - Bass: Massive, booming, continuous sub-bass drone (extreme low cutoff).
#    - Chords: Stark, dissonant, echoing synth stabs (FM, low divisor, mid depth).
#    - Lead: Piercing, "siren" or "alarm" FM bleeps (high divisor, extreme depth).
#    - Texture: Pitched-down, repetitive "chant" vocal drone (granular, rhythmic).
# 5. Arrangement: Intro (Bass/Drone) -> Verse (Broken Drums) -> Drop (Stabs).
# ==========================================================

use_bpm 125

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor / Atonal - Dark, Hypnotic, & Minimal)
# ==========================================================

# The "Gqom" Kick. 
# A heavy, syncopated, broken march. (4 x's, 4 elements)
s_kick = gen_score("x..x..x.x..x....", [
  :c4, {note: :c4, amp: 0.8}, :c4, {note: :c4, amp: 0.7}
])

# Very sparse, heavy clap. Only hits once per bar on beat 4 (step 12). (1 x, 1 element)
s_snare = gen_score("............x...", [:c4])

# Relentless, ticking 16th hats. 
# Notice the heavy amplitude manipulation to create a hypnotic, swirling feel.
# (8 x's, 8 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}, {note: :c4, amp: 0.4}, 
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}, {note: :c4, amp: 0.4}
])

# Deep, massive "Sub-Bass" Drone (A Minor).
# Hits once and rings out for the entire scene (8 bars = 32 beats).
# Extreme low cutoff (40) and massive release (32.0) create a deep, 
# continuous, suffocating rumble. (1 x, 1 element)
s_bass = gen_score("x...............", [
  {note: :a1, release: 32.0, cutoff: 40, amp: 1.5}
])

# Stark, "Dissonant" Synth Stabs (Am to G).
# Hit sparingly on the off-beats. High cutoff (100) and short release (0.15) 
# create a sharp, metallic wall of sound. (3 x's, 3 elements)
s_chords = gen_score("..x.....x.x.....", [
  {note: [:a3, :c4, :e4], cutoff: 100, release: 0.15, amp: 0.5},
  {note: [:a3, :c4, :e4], cutoff: 100, release: 0.15, amp: 0.5},
  {note: [:g3, :bb3, :d4], cutoff: 100, release: 0.15, amp: 0.5}
])

# Piercing, "Siren" FM Lead (A Minor Pentatonic).
# Uses :play_fm with a high divisor (4) and extreme depth (5) to create a 
# sharp, piercing, digital tone. Routed through the global tape echo. 
# (6 x's, 6 elements)
lead_notes = [:a5, :e5, :c6, :a5, :g5, :e5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 4, depth: 5, release: 0.2} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Chant" Vocal Drone (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched DOWN.
# Long size (0.1) and low density (1) creates a raw, repetitive, 
# hypnotic background texture. (2 x's, 2 elements)
s_grain = gen_score("....x.......x...", [
  {note: :a3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.1, amp: 0.6},
  {note: :a3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.1, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Township - Just the deep sub-bass, dissonant stabs, and chant (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Rhythm - Add the broken, syncopated drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Drop - The piercing, siren-like lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN MINIMAL TENSION]
# 
# 1. The Broken Syncopation: Look at `s_kick`. It hits on steps 0, 3, 6, 8, 
#    and 11. By avoiding the standard 4/4 pulse and hitting on the "a" of beat 
#    1 and the "and" of beat 2, the engine creates a lopsided, staggering 
#    groove that feels distinctly raw and unpolished, perfectly mimicking the 
#    DIY, low-budget sound of early Gqom.
#
# 2. The Tectonic Sub-Bass: Look at `s_bass`. The `:play_sub` synth is given 
#    an extreme low `cutoff` of `40` and a massive `release` of `32.0`. This 
#    creates a deep, continuous, suffocating rumble that anchors the track for 
#    the entire scene without ever needing to re-trigger.
#
# 3. Extreme Negative Space: Gqom relies on what you *don't* play. The `s_snare` 
#    grid is 90% `nil`, hitting only once per bar. The `s_chords` hit sparingly. 
#    The engine honors these rests perfectly, letting the reverb tails of the 
#    stabs and the relentless ticking of the hats ring out into the dark void.
# ==========================================================
