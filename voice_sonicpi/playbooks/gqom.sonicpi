# ==========================================================
# PLAYBOOK: GQOM
# (Pioneered by DJ Lag, Distruction Boyz, and Naked Boyz)
# ==========================================================
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose Gqom. 
# Emerging from the townships of Durban, South Africa, Gqom translates 
# to "drum" or "hit." It is a minimalist, dark, and hypnotic offshoot 
# of house music. Unlike the lush, jazzy chords of Afro House, Gqom 
# strips away melody almost entirely. It relies on massive, hollow 
# syncopated kicks, repetitive vocal chants, and a feeling of deep, 
# rhythmic tension.
#
# This playbook perfectly demonstrates how to use extreme syncopation 
# and negative space (rests) on the 16-step grid. By avoiding the 
# downbeats, the engine creates a lopsided, staggering groove that 
# feels raw and unmistakably Durban.
# ==========================================================

use_bpm 122

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (C Minor - Dark, Minimal, & Hypnotic)
# ==========================================================

# The Syncopated Gqom Kick. 
# Completely avoids the standard 4/4 pulse. Hits on step 0, 
# the 'a' of 1 (step 3), beat 3 (step 8), and the 'a' of 3 (step 11).
s_kick  = (ring :c4, nil, nil, {:note => :c4, :amp => 0.9}, nil, nil, nil, nil, {:note => :c4, :amp => 1.2}, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil, nil)

# Very sparse, heavy clap. Only hits once per bar on beat 4 (step 12).
s_clap  = (ring nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.9}, nil, nil, nil)

# Minimalist, woodblock-style percussion.
# Hits on the 'and' of the beats to create a sense of forward momentum.
s_hats  = (ring nil, nil, {:note => :c4, :amp => 0.3}, nil, nil, {:note => :c4, :amp => 0.4}, nil, nil, nil, nil, {:note => :c4, :amp => 0.3}, nil, nil, {:note => :c4, :amp => 0.5}, nil, nil)

# Deep, booming, continuous sub-bass.
# Acts as a dark drone underneath the frantic drums.
s_bass  = (ring {:note => :c1, :release => 0.5}, nil, nil, nil, {:note => :c1, :release => 0.5}, nil, nil, nil, {:note => :eb1, :release => 0.5}, nil, nil, nil, {:note => :g1, :release => 0.5}, nil, nil, nil)

# Dark, repetitive "Chant" synth stab (C Minor).
# Uses :play_fm with a high depth to create a dissonant, hollow knock.
s_fm    = (ring nil, nil, nil, nil, {:note => :c4, :amp => 0.7, :depth => 4, :divisor => 2, :release => 0.15}, nil, nil, nil, nil, nil, nil, nil, {:note => :eb4, :amp => 0.6, :depth => 4, :divisor => 2, :release => 0.15}, nil, nil, nil)

# Pitched-down, repetitive vocal chant (Granular Synth)
# Low density, medium size = a raw, rhythmic vocal hit.
s_vocal = (ring nil, nil, nil, nil, nil, nil, nil, nil, {:note => :c3, :buffer => :misc_lori, :pos => 0.5, :density => 2, :size => 0.08, :amp => 0.7}, nil, nil, nil, nil, nil, nil, nil)

# Massive, dark drone pad to anchor the tension.
s_pad   = (ring {:note => :c2, :release => 4.0, :attack => 2.0}, nil, nil, nil, nil, nil, nil, nil, {:note => :g2, :release => 4.0, :attack => 2.0}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Hypnosis - Just the dark pad and syncopated kick (4 bars)
  [ [:play_pad, s_pad, 4], [:play_kick, s_kick, 4] ],
  
  # Scene 2: The Rhythm - Add the sub-bass, sparse clap, and percussion (8 bars)
  [ [:play_pad, s_pad, 8], [:play_kick, s_kick, 8], 
    [:play_sub, s_bass, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chant - Add the FM stabs and granular vocal drops (8 bars)
  [ [:play_pad, s_pad, 8], [:play_kick, s_kick, 8], 
    [:play_sub, s_bass, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_fm, s_fm, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN MINIMALISM]
# 
# 1. The Staggering Kick: Look at `s_kick`. It hits on steps 0, 3, 8, and 11.
#    By avoiding steps 4 and 12 (the classic backbeat), the groove loses 
#    its standard anchor. The engine's strict master clock ensures these 
#    lopsided hits land with absolute precision, creating a feeling of 
#    constantly falling forward—the defining characteristic of Gqom.
#
# 2. Extreme Negative Space: 90% of the `s_hats` and `s_clap` grids are 
#    `nil`. Gqom doesn't fill the grid; it leaves massive, echoing voids. 
#    The engine honors these rests perfectly, letting the reverb tails of 
#    the sub-bass and the synth stabs ring out into the darkness.
#
# 3. FM as a Hollow Knock: The `s_fm` sequence uses `divisor: 2` and 
#    `depth: 4`. This extreme ratio forces the FM synth to produce a 
#    dissonant, hollow knock that sounds more like a piece of metal being 
#    struck in a tunnel than a musical synthesizer.
# ==========================================================
