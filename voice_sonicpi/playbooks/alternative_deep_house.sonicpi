# ==========================================================
# PLAYBOOK: 2010s ALTERNATIVE DEEP HOUSE / INDIE DANCE
# (Pioneered by Bob Moses, RÜFÜS DU SOL, and Polo & Pan)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 2010s Alternative Deep House.
# We have explored Tech House and Synth-Pop, but the Bob Moses / Indie Dance 
# sound is the sound of the modern underground festival. It fuses the dark, 
# driving grooves of deep house with the lush, melancholic atmosphere of 
# indie rock. It relies on a relentless, driving 4/4 beat, a deep, round 
# analog bassline, massive, slow-attacking "string synth" chords, and a 
# piercing, echoing "electric guitar" or synth pluck that feels like 
# dancing in a dark, sweaty warehouse at 3 AM.
#
# This playbook perfectly demonstrates how to combine a driving, continuous 
# 8th-note bass with massive, cinematic chord swells. By using the `:play_sub` 
# synth for a deep, round bass, and routing a piercing lead through the global 
# tape echo, the engine creates a massive, emotional, and deeply hypnotic 
# atmosphere.
# ==========================================================

use_bpm 122

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F# Minor - Dark, Melodic, & Driving)
# ==========================================================

# Relentless, driving 4/4 kick. (4 x's, 1 element)
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, organic 909 clap strictly on beats 2 and 4. (2 x's, 1 element)
s_clap = gen_score("....x.......x...", [:c4])

# Rigid, off-beat open hats to drive the momentum. (4 x's, 4 elements)
s_hats = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, 
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}
])

# The "Analog" Bass (F# Minor).
# Plays a driving, syncopated 8th-note line. 
# Mid cutoff (80) and short release (0.15) create a warm, punchy "thwack". 
# (8 x's, 8 elements)
bass_notes = [:fs1, :fs1, :fs1, :fs1, :a1, :a1, :c2, :a1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 80, release: 0.15, amp: 1.0} }
s_bass = gen_score("x..x..x..x..x..x.", bass_data)

# Lush, "String Synth" Chords (F#m9 to Amaj7).
# Hit on the downbeats. The slow 1.0-beat attack and massive 3.0-beat release 
# blur the chords together into a continuous, cinematic wave. (2 x's, 2 elements)
s_chords = gen_score("x.......x.......", [
  {note: [:fs3, :a3, :c4, :e4], cutoff: 70, attack: 1.0, release: 3.0, amp: 0.5},
  {note: [:a2, :cs3, :e3, :gs3], cutoff: 70, attack: 1.0, release: 3.0, amp: 0.5}
])

# Piercing, "Electric Guitar" Lead (F# Minor Pentatonic).
# Uses :play_lead routed through the global tape echo bus. The long release (0.4) 
# creates a soaring, echoing, melancholic melody. (6 x's, 6 elements)
lead_notes = [:fs5, :a5, :c6, :b5, :a5, :fs5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, cutoff: 90, release: 0.4} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Ahh" Vocal Drone (Granular Synth).
# Using the built-in :ambi_choir sample.
# Long size (0.4) and low density (1) creates a slow, evolving background texture. 
# (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :fs3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.4, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Vibe - Just the analog bass, sweeping chords, and drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Groove - Add the driving 4/4 drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Drop - The piercing electric guitar lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN INDIE DANCE]
# 
# 1. The Analog Bass Drive: Look at `s_bass`. The `:play_sub` synth plays on 
#    every 8th note, mapping out a deep, melodic line. By using a mid-range 
#    `cutoff` (80) and a short `release` (0.15), the engine turns the detuned 
#    sawtooth into a warm, punchy "thwack" that perfectly mimics the driving, 
#    analog basslines of Bob Moses and RÜFÜS DU SOL.
#
# 2. The Cinematic Swell: Look at `s_chords`. The Hashes specify an `attack` 
#    of `1.0` and a `release` of `3.0`. Because the engine reads these 
#    Hashes, the chords don't just hit; they slowly swell into the mix and 
#    fade away over four whole beats, creating a continuous, blurred wave 
#    of warm harmony that perfectly mimics the lush, wide-stereo string pads 
#    of modern Indie Dance.
#
# 3. Echoing Space: The `s_lead` sequence plays a simple F# minor pentatonic 
#    melody, but leaves massive gaps (`nil`) between the notes. Because the 
#    engine routes the `:play_lead` synth through the global tape echo bus, 
#    those empty spaces are filled by delay tails, creating a cascading, 
#    stadium-sized soundscape that perfectly anchors the track's dark, 
#    hypnotic atmosphere.
# ==========================================================
