# ==========================================================
# PLAYBOOK: 90s KWAITO / SOUTH AFRICAN HOUSE
# (Pioneered by Arthur, Mzekezeke, and Trompies)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Kwaito.
# We have explored Amapiano and Gqom, but Kwaito is the Godfather of 
# South African electronic music. Emerging in the 90s, it slowed house music 
# down to a swaggering 105 BPM. It relies on deep, round reggae-style basslines, 
# a specific "Sembhi" syncopated kick, raw, repetitive vocal chants, and stark, 
# minor chord stabs.
#
# This playbook perfectly demonstrates how to use a purely electronic engine 
# to simulate a 90s Yamaha groovebox. By using a low `cutoff` on the bass and 
# mapping a syncopated "Tamborzão" style rhythm to the 16-step grid, the engine 
# creates a nostalgic, deep, and distinctly South African street groove.
# ==========================================================

use_bpm 105

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Deep, Nostalgic, & Bouncy)
# ==========================================================

# The "Sembhi" Kick. 
# Syncopated 3-3-2 feel. Hits on step 0, the 'a' of 1 (step 3), 
# the 'and' of 2 (step 6), and beat 3 (step 8). (4 x's, 4 elements)
s_kick = gen_score("x..x..x.x.......", [
  :c4, {note: :c4, amp: 0.8}, :c4, {note: :c4, amp: 1.0}
])

# Crisp, organic clap strictly on beats 2 and 4. (2 x's, 1 element)
s_snare = gen_score("....x.......x...", [:c4])

# Swung, organic shaker. 
# Notice the gaps (nil) and amplitude manipulation to create a human feel.
# (6 x's, 6 elements)
s_hats = gen_score("x..x.x.x..x.x.x.", [
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}, 
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Deep Kwaito" Bass (A Minor).
# Walks a melodic line. Very low cutoff (70) and medium release (0.3) 
# to create a warm, muffled, 90s groovebox undercurrent. (3 x's, 3 elements)
s_bass = gen_score("x.....x.x.....x.", [
  {note: :a1, release: 0.3, cutoff: 70, amp: 1.2}, 
  {note: :c2, release: 0.3, cutoff: 70, amp: 1.0}, 
  {note: :e2, release: 0.3, cutoff: 70, amp: 1.0}
])

# Lush, warm minor chord stabs (Am to Em).
# Hit on the downbeats. The low cutoff (85) gives them that classic 
# "played through a wall" muffled feel. (2 x's, 2 elements)
s_chords = gen_score("x.......x.......", [
  {note: [:a3, :c4, :e4], cutoff: 85, release: 0.5, amp: 0.6},
  {note: [:e3, :g3, :b3], cutoff: 85, release: 0.5, amp: 0.6}
])

# Bright, echoing "Marimba/Choral" Melody (A Minor Pentatonic).
# Uses :play_fm with a low divisor (2) and depth (2) to create a warm, 
# organic pluck. Routed through the engine's tape echo. (6 x's, 6 elements)
lead_notes = [:a5, :c6, :e6, :d6, :c6, :a5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 2, release: 0.3} }
s_fm = gen_score("x..x..x..x..x..x", lead_data)

# Repetitive, pitched-down "Street" vocal chant (Granular Synth).
# Using the built-in :ambi_choir sample.
# Low density, medium size = a raw, rhythmic vocal hit. (1 x, 1 element)
s_vocal = gen_score("x...............", [
  {note: :a3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.1, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the syncopated drums, bass, and vocal chant (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Vibe - Add the warm, muffled chord stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_grain, s_vocal, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Street - The bright marimba melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_grain, s_vocal, 8], [:play_chords, s_chords, 8], 
    [:play_fm, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN SOUTH AFRICAN GROOVE]
# 
# 1. The Sembhi Syncopation: Look at `s_kick`. It hits on steps 0, 3, 6, and 8. 
#    By avoiding the standard 4/4 pulse and hitting on the "a" of beat 1 and the 
#    "and" of beat 2, the engine creates a lopsided, staggering groove that feels 
#    distinctly South African. The engine's strict master clock ensures this complex 
#    rhythm lands with absolute precision.
#
# 2. The 90s Groovebox Bass: Look at `s_bass`. The `:play_sub` synth is given a 
#    low `cutoff` (70) and a medium `release` (0.3). This filters out all the harsh 
#    high frequencies, leaving only a deep, warm, muffled low-end that perfectly 
#    mimics the raw, 90s Yamaha RM1X basslines used to produce early Kwaito tracks.
#
# 3. Deep Harmonic Space: Kwaito relies on leaving massive room for the vocals and 
#    bass. The `s_chords` sequence uses a low `cutoff` (85) to keep the stabs muffled 
#    and out of the way, while the `s_fm` melody leaves huge gaps (`nil`) between 
#    notes. The engine's strict 16-step grid ensures these slow, lush elements never 
#    clash with the complex, syncopated drum pattern.
# ==========================================================
