# ==========================================================
# PLAYBOOK: 2000s NEW RAVE / NU-RAVE
# (Pioneered by Klaxons, Late of the Pier, and Shitdisco)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 2000s New Rave.
# We have explored 90s Baggy/Madchester and 2000s Bloghouse, but New Rave 
# is the sound of the mid-2000s UK indie-dance crossover. It fuses the 
# noisy, distorted synthesizers of rave culture with the live, aggressive 
# energy of a punk rock band. It relies on a driving 4/4 rock beat, a 
# massively distorted, continuous 16th-note "buzzsaw" bass, jagged guitar 
# stabs, and piercing, high-pitched FM synth blips.
#
# This playbook perfectly demonstrates how to use the `:play_sub` synth 
# as a distorted continuous bass, and the `:play_fm` synth to create 
# jagged, metallic guitar stabs and piercing rave blips.
# ==========================================================

use_bpm 128

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Noisy, Driving, & Distorted)
# ==========================================================

# Driving rock/dance kick. Hits on 1, 2, 3, and 4.
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, echoing snare strictly on beats 2 and 4.
s_snare = gen_score("....x.......x...", [:c4])

# Fast, driving 16th hats.
s_hats = gen_score("x.x.x.x.x.x.x.x.", [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}])

# The "Buzzsaw" Bass (A Minor).
# Plays continuous 16th notes. Extreme cutoff (120) and microscopic release (0.08) 
# create a relentless, distorted, buzzing churn.
bass_notes = [:a1, :a2, :a1, :a2, :a1, :a2, :a1, :a2, 
              :g1, :g2, :g1, :g2, :f1, :f2, :f1, :f2]
bass_data = bass_notes.map { |n| {note: n, cutoff: 120, release: 0.08, amp: 1.2} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Jagged, "Guitar/Synth" Stabs (Am to G to F).
# Uses :play_fm with a low divisor (2) and extreme depth (5) to create a 
# harsh, distorted hit. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:a3, :e4], divisor: 2, depth: 5, release: 0.1, amp: 0.7},
  {note: [:g3, :d4], divisor: 2, depth: 5, release: 0.1, amp: 0.7},
  {note: [:f3, :c4], divisor: 2, depth: 5, release: 0.1, amp: 0.7},
  {note: [:g3, :d4], divisor: 2, depth: 5, release: 0.1, amp: 0.7}
])

# Piercing, "Rave Blip" Lead (A Minor Pentatonic).
# Uses :play_fm with a high divisor (4) and low depth (2) to create a piercing, 
# glassy tone. (8 x's, 8 elements)
lead_notes = [:a5, :e5, :c6, :e5, :g5, :d5, :b5, :d5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 4, depth: 2, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Yelping" vocal stutter (Granular Synth).
# Pitched UP to :a4. High density, tiny size = a sharp, noisy vocal skip. (2 x's, 2 elements)
s_vocal = gen_score("....x.......x...", [
  {note: :a4, buffer: :misc_lori, pos: 0.1, density: 3, size: 0.04, amp: 0.6},
  {note: :c5, buffer: :misc_lori, pos: 0.3, density: 3, size: 0.04, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Jam - Just the driving drums, buzzsaw bass, and stabs (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_fm, s_chords, 4] ],
  
  # Scene 2: The Vibe - Add the yelping vocals (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drop - The piercing rave blip lead drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN INDIE-DANCE NOISE]
# 
# 1. The Buzzsaw Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step, alternating octaves. By using an extreme `cutoff` 
#    (120) and a microscopic `release` (0.08), the engine turns the detuned 
#    sawtooth into a relentless, distorted, buzzing wall of sound that perfectly 
#    mimics the noisy, overdriven synth basslines of 2000s New Rave.
#
# 2. FM as a Jagged Guitar: Look at `s_chords`. The `:play_fm` synth is given 
#    a `divisor` of `2` and an extreme `depth` of `5`. This harsh harmonic 
#    ratio forces the FM modulator to shatter the carrier wave, creating a 
#    piercing, buzzy square wave that perfectly mimics a distorted electric 
#    guitar or a harsh vintage synth stab.
#
# 3. The 16th-Note Drive: New Rave relies on a stark, driving rhythm section. 
#    The `s_hats` play straight 16th notes, and the `s_bass` plays continuous 
#    16th notes. The engine's strict master clock ensures this rigid, mechanical 
#    momentum locks perfectly with the live-sounding 4/4 rock beat, creating a 
#    high-energy, hybrid dance-rock atmosphere.
# ==========================================================
