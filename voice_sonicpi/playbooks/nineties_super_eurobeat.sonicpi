# ==========================================================
# PLAYBOOK: 90s SUPER EUROBEAT / INITIAL D STYLE
# (Pioneered by Dave Rodgers, Maurizio De Jorio, and Ken Blast)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Super Eurobeat.
# We have explored Italo Disco and Spacesynth, but Super Eurobeat is the 
# sound of high-octane 90s Japanese street racing. It pushes the tempo 
# to a frantic 155 BPM and relies on a relentless, driving 4/4 beat, 
# a continuous, octave-jumping 16th-note "Moroder" bass, massive, 
# dramatic off-beat synth stabs, and piercing, high-speed FM arpeggios 
# that feel like drifting a modified car around a mountain pass at midnight.
#
# This playbook perfectly demonstrates how to use the DRY `gen_score` helper 
# and Ruby's `.map` function to algorithmically generate a continuous, 
# octave-jumping 16th-note bassline with zero repetitive code, creating 
# an unstoppable, adrenaline-fueled momentum.
# ==========================================================

use_bpm 155

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Frantic, Dramatic, & High-Speed)
# ==========================================================

# Relentless, driving 4/4 kick. (4 x's, 4 elements)
s_kick = gen_score("x...x...x...x...", [:c4, :c4, :c4, :c4])

# Heavy, dry snare on beats 2 and 4, with a 16th roll at the end of the bar. (4 x's, 4 elements)
s_snare = gen_score("....x.......x.xx", [
  :c4, :c4, {note: :c4, amp: 0.5}, {note: :c4, amp: 0.7}
])

# Off-beat open hats to drive the momentum. (4 x's, 4 elements)
s_hats = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}, 
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}
])

# The "Eurobeat" Bass (A Minor).
# Generate 16 continuous 16th notes with alternating octaves automatically. (16 x's, 16 elements)
bass_cycle = [:a1, :a2, :a1, :a2, :a1, :a2, :a1, :a2, 
              :f1, :f2, :f1, :f2, :g1, :g2, :g1, :g2]
bass_data = bass_cycle.map { |n| {note: n, cutoff: 110, release: 0.06, amp: 1.0} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Massive, dramatic "Supersaw" Stabs (Am to F to G).
# Hit strictly on the off-beats. High cutoff (110) and short release (0.15) 
# create a sharp, piercing wall of sound. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:a3, :c4, :e4], cutoff: 110, release: 0.15, amp: 0.6},
  {note: [:a3, :c4, :e4], cutoff: 110, release: 0.15, amp: 0.6},
  {note: [:f3, :a3, :c4], cutoff: 110, release: 0.15, amp: 0.6},
  {note: [:g3, :bb3, :d4], cutoff: 110, release: 0.15, amp: 0.6}
])

# Piercing, "High-Speed" FM Lead (A Minor).
# Uses :play_fm with a low divisor (2) and extreme depth (4) to create a 
# sharp, buzzy square wave. Plays a rapid, 8th-note melody. (8 x's, 8 elements)
lead_notes = [:a5, :e5, :c6, :e5, :a5, :e5, :c6, :e5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 4, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Racing" vocal stutter (Granular Synth).
# High density, tiny size = a sharp, pristine vocal skip. (1 x, 1 element)
s_vocal = gen_score("........x.......", [
  {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Ignition - Just the driving bass, off-beat hats, and stabs (4 bars)
  [ [:play_sub, s_bass, 4], [:play_hats, s_hats, 4], [:play_chords, s_chords, 4] ],
  
  # Scene 2: The Race - Add the relentless 4/4 drums and vocal stutters (8 bars)
  [ [:play_sub, s_bass, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drift - The piercing high-speed FM lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_hats, s_hats, 8], [:play_chords, s_chords, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN ADRENALINE]
# 
# 1. Algorithmic Octave Bass: Look at `s_bass`. Instead of typing 16 
#    repetitive Hashes, we define an array `bass_cycle` that alternates 
#    between the low octave (:a1) and the high octave (:a2). We then use 
#    `.map` to inject the default parameters into every step. This creates 
#    the relentless, driving 16th-note "gallop" that defines Eurobeat, 
#    with zero repetitive code.
#
# 2. FM as a Eurobeat Lead: The `s_lead` sequence uses `divisor: 2` and an 
#    extreme `depth` of `4`. This harsh harmonic ratio produces a piercing, 
#    buzzy square wave that cuts through the heavy mix. By playing a rapid, 
#    8th-note melody, the engine creates a frantic, high-energy hook that 
#    perfectly mimics the dramatic synth solos of 90s racing anime.
#
# 3. The Snare Roll: Look at `s_snare`. It hits on beats 2 and 4, but adds 
#    a 16th-note roll at the very end of the bar (steps 14 and 15). The 
#    engine's strict master clock ensures this rapid roll fires with absolute 
#    mathematical precision, building immense tension and momentum into the 
#    next downbeat.
# ==========================================================
