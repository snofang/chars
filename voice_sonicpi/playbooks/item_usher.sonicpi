# ==========================================================
# PLAYBOOK: USHER ft. LIL JON - "YEAH!" (2004)
# ==========================================================

use_bpm 120

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (G Minor - Bouncy, Aggressive, & Catchy)
# ==========================================================

# The "Crunk" Kick. 
# A heavy, syncopated 808 bounce. (5 x's, 5 elements)
s_kick = gen_score("x..x.x.x..x.....", [
  :c4, {note: :c4, amp: 0.8}, :c4, {note: :c4, amp: 0.7}, {note: :c4, amp: 0.9}
])

# Crisp, dry snare strictly on beats 2 and 4, with a ghost note. (3 x's, 3 elements)
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.4}, {note: :c4, amp: 1.0}
])

# Fast, rolling 16th hats. (8 x's, 8 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}, 
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# Deep, sliding 808 Sub-Bass (G Minor).
# Massive release (0.5) allows the bass to ring out and carry the groove. 
# (4 x's, 4 elements)
s_bass = gen_score("x.....x.x.....x.", [
  {note: :g1, release: 0.5, cutoff: 60, amp: 1.2}, 
  {note: :g1, release: 0.5, cutoff: 60, amp: 1.0}, 
  {note: :bb1, release: 0.5, cutoff: 60, amp: 1.0}, 
  {note: :d2, release: 0.5, cutoff: 60, amp: 1.0}
])

# Stark, "String Synth" Stabs (Gm to Bb).
# Hit strictly on the off-beats. High cutoff (100) and short release (0.15) 
# create a sharp, staccato wall of sound. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:g3, :bb3, :d4], cutoff: 100, release: 0.15, amp: 0.5},
  {note: [:g3, :bb3, :d4], cutoff: 100, release: 0.15, amp: 0.5},
  {note: [:bb3, :db4, :f4], cutoff: 100, release: 0.15, amp: 0.5},
  {note: [:bb3, :db4, :f4], cutoff: 100, release: 0.15, amp: 0.5}
])

# The "Yeah!" Synth Riff (G Minor Pentatonic).
# Uses :play_fm with a low divisor (2) and mid depth (3) to create a piercing, 
# buzzy square wave. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:g5, :f5, :eb5, :d5, :f5, :g5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, divisor: 2, depth: 3, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Yeah!" / "Okay!" Vocal Stutter (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched DOWN.
# High density, tiny size = a sharp, percussive, repetitive vocal skip. (2 x's, 2 elements)
s_vocal = gen_score("....x.......x...", [
  {note: :g3, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.8},
  {note: :bb3, buffer: :ambi_choir, pos: 0.3, density: 3, size: 0.04, amp: 0.8}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Intro - Just the sliding bass, string stabs, and vocal chops (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_chords, 4], [:play_grain, s_vocal, 4] ],
  
  # Scene 2: The Verse - Add the heavy, syncopated 808 drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Chorus - The piercing "Yeah!" synth riff drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN CRUNK-POP]
# 
# 1. The "Yeah!" Riff: Look at `s_lead`. The `:play_fm` synth is given a low 
#    `divisor` (2) and a `depth` (3), with a microscopic `release` (0.1). This 
#    forces the FM synth to produce a piercing, buzzy square wave that plays 
#    the iconic G-F-Eb-D-F-G pentatonic riff. Because it's routed through the 
#    global tape echo bus, the rapid notes smear into a frantic, club-ready hook.
#
# 2. The Sliding 808 Bass: Look at `s_bass`. The `:play_sub` synth is given 
#    a `release` of `0.5` and a low `cutoff` (60). This creates a deep, round, 
#    and warm low-end that rings out over the syncopated kicks, carrying the 
#    massive, booming groove of the track.
#
# 3. The Crunk Bounce: Look at `s_kick`. It completely avoids landing on a 
#    standard 4/4 pulse. By hitting on syncopated, bouncing steps 
#    (0, 3, 5, 7, 10), the engine creates a lopsided, physical groove that 
#    feels like a live 808 drum machine. The engine's strict master clock 
#    ensures this complex rhythm lands with absolute precision.
# ==========================================================
