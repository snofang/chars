# ==========================================================
# PLAYBOOK: 90s JAZZ RAP / ACID JAZZ
# (Pioneered by A Tribe Called Quest, Gang Starr, and US3)
# ==========================================================
# 
# [WHY THIS GENRE?]
# Jazz Rap fuses a swung MPC drum break with lush, sample‑based
# jazz instrumentation – walking upright bass, warm major 9th
# chords, and a mellow muted trumpet/sax melody.
# This playbook uses FM to simulate brass and a low‑cutoff
# sub‑bass for a warm, dusty upright tone.
# ==========================================================

use_bpm 90

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x......x..x.....", [
  :c4,
  {note: :c4, amp: 0.8},
  {note: :c4, amp: 1.0}
])

s_snare = gen_score("....x..x....x..x", [
  :c4,
  {note: :c4, amp: 0.3},
  :c4,
  {note: :c4, amp: 0.3}
])

s_hats  = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.15},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.15},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.15},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.15}
])

s_bass  = gen_score("x...x.x.x.x.x.x.", [
  {note: :eb2, release: 0.2, cutoff: 80},
  {note: :eb2, release: 0.2, cutoff: 80},
  {note: :g2,  release: 0.2, cutoff: 80},
  {note: :ab2, release: 0.2, cutoff: 80},
  {note: :bb2, release: 0.2, cutoff: 80},
  {note: :c3,  release: 0.2, cutoff: 80},
  {note: :bb2, release: 0.2, cutoff: 80}
])

s_chords = gen_score("x.......x.......", [
  {note: [:eb3, :g3, :bb3, :d4], cutoff: 75, release: 1.0, amp: 0.6},
  {note: [:ab2, :c3, :eb3, :g3], cutoff: 75, release: 1.0, amp: 0.6}
])

s_fm    = gen_score("....x.x.......x.", [
  {note: :eb5, amp: 0.5, divisor: 3, depth: 2, release: 0.8},
  {note: :g5,  amp: 0.4, divisor: 3, depth: 2, release: 0.8},
  {note: :bb4, amp: 0.5, divisor: 3, depth: 2, release: 0.8}
])

s_grain = gen_score("x...............", [
  {note: :eb4, buffer: :elec_piano, pos: 0.2, density: 1, size: 0.3, amp: 0.4}
])

# Playbook
playbook = (ring
  # Scene 1: The Vibe – walking bass, dusty chords, vinyl crackle (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Groove – add swung MPC drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Solo – mellow muted trumpet melody drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The walking bassline (eb2 → g2 → ab2 → bb2 → c3 → bb2)
#   uses a low cutoff (80) and short release for a warm upright tone.
# - The kick and hats avoid straight 16ths – hits on 7 and 10,
#   with large amplitude variations, simulate an MPC’s 54% swing.
# - FM with divisor 3 and depth 2 produces a soft, brassy timbre
#   that sounds like a muted trumpet through tape echo.
# ==========================================================
