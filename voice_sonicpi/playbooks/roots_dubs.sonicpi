# ==========================================================
# PLAYBOOK: DUB REGGAE / STEPPERS
# Deep, Echoing, Psychedelic Sound System Vibes
# ==========================================================
# [WHY THIS GENRE?]
# Dub reggae (King Tubby, Lee Perry) is built on sparse,
# heavy drums, deep sub‑bass, off‑beat guitar skanks, and
# cavernous delays. This playbook captures that hypnotic,
# smoke‑filled sound system atmosphere.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 75 BPM
# Key: G minor (dark, grooving)
# Rhythm: Steppers kick on every beat, snare on 2/4,
# hats on off‑beats, bass on 1 and 3, chords on off‑beats.
# Timbre: Deep sub‑bass (dsaw, long release), staccato
# minor chords (blade), echoing melodica (prophet+echo),
# dubbed vocal grains (ambi_choir, low density).
# Arrangement: Beat (drums+bass) → Skank (chords enter)
# → Melodica + Vocal (lead and grain enter).
# ==========================================================

use_bpm 75

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores

# Steppers kick – hit on every beat with variable velocity
s_kick = gen_score("x...x...x...x...",
  [:c4, {note: :c4, amp: 0.8}, :c4, {note: :c4, amp: 0.8}])

# Snare on beats 2 and 4
s_snare = gen_score("....x.......x...",
  [{note: :c4, amp: 0.9}, {note: :c4, amp: 0.9}])

# Hi‑hats on off‑beats (steps 2,6,10,14)
s_hats = gen_score("..x..x..x..x....",
  [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.3}, {note: :c4, amp: 0.3}])

# Deep sub‑bass – long release for rolling low‑end
s_bass = gen_score("x.......x.......",
  [{note: :g1, release: 1.5}, {note: :bb1, release: 1.5}])

# Off‑beat skank chords – staccato minor chords
s_chords = gen_score("..x..x..x..x....",
  [{note: [:g3, :bb3, :d4]}, {note: [:g3, :bb3, :d4]},
   {note: [:c4, :eb4, :g4]}, {note: [:c4, :eb4, :g4]}])

# Echoing melodica melody – routed through tape echo
s_lead = gen_score("........x......x",
  [{note: :g5, amp: 0.6}, {note: :f5, amp: 0.5}])

# Dubbed‑out vocal fragment – ghostly grain
s_vocal = gen_score("........x.......",
  [{note: :g4, buffer: :ambi_choir, pos: 0.5,
    density: 2, size: 0.1, amp: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Beat – Drums + Bass
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4],
    [:play_hats, s_hats, 4], [:play_sub, s_bass, 4] ],

  # Scene 2: Skank – Chords enter
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3: Full – Melodica and Vocal enter
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_chords, s_chords, 8], [:play_lead, s_lead, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The long release (1.5) on s_bass creates a rolling,
#   rumbling sub‑bass that anchors the groove.
# - Off‑beat hats and chords (steps 2,6,10,14) create the
#   classic reggae "skank" rhythm – the engine locks them
#   perfectly against the kick.
# - The tape echo on s_lead smears the sparse notes into
#   a psychedelic, echoing melodica line.
# - The grain vocal with density 2 and size 0.1 gives a
#   short, stuttered dub plate effect, adding texture.
# ==========================================================
