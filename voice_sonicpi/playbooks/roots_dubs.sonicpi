use_bpm 75

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (G Minor - Cavernous & Psychedelic)
# ==========================================================

# The "Steppers" Kick. Hits strictly on every beat (steps 0, 4, 8, 12).
s_kick  = (ring :c4, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil, :c4, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil)

# Cross-stick/Snare strictly on beats 2 and 4 (steps 4 and 12).
s_snare = (ring nil, nil, nil, nil, {:note => :c4, :amp => 0.9}, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.9}, nil, nil, nil)

# Closed hats strictly on the off-beats (the "and" of each beat).
s_hats  = (ring nil, nil, {:note => :c4, :amp => 0.3}, nil, nil, nil, {:note => :c4, :amp => 0.3}, nil, nil, nil, {:note => :c4, :amp => 0.3}, nil, nil, nil, {:note => :c4, :amp => 0.3}, nil)

# Deep, round reggae sub-bass. 
# Long release to create a massive, rolling low-end.
s_bass  = (ring {:note => :g1, :release => 1.5}, nil, nil, nil, nil, nil, nil, nil, {:note => :bb1, :release => 1.5}, nil, nil, nil, nil, nil, nil, nil)

# The classic Reggae "Skank". 
# Staccato minor chords strictly on the off-beats (steps 2, 6, 10, 14).
s_chords= (ring nil, nil, [:g3, :bb3, :d4], nil, nil, nil, [:g3, :bb3, :d4], nil, nil, nil, [:c4, :eb4, :g4], nil, nil, nil, [:c4, :eb4, :g4], nil)

# Distant, echoing melodica melody (G Minor).
# Routed through the engine's tape echo for a psychedelic smear.
s_lead  = (ring nil, nil, nil, nil, nil, nil, nil, nil, {:note => :g5, :amp => 0.6}, nil, nil, nil, nil, nil, {:note => :f5, :amp => 0.5}, nil)

# Dubbed-out, echoing vocal fragment (Granular Synth)
# Low density, long size = a ghostly, drifting echo.
s_vocal = (ring nil, nil, nil, nil, nil, nil, nil, nil, {:note => :g4, :buffer => :ambi_choir, :pos => 0.5, :density => 2, :size => 0.1, :amp => 0.5}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the massive steppers beat and sub-bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: Add the off-beat skank guitar (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The echoing melodica and vocal fragments drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], 
    [:play_lead, s_lead, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
