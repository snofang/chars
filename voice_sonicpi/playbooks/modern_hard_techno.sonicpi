# ==========================================================
# PLAYBOOK: MODERN HARD TECHNO / PEAK-TIME INDUSTRIAL
# (Pioneered by I Hate Models, 999999999, and Charlie Sparks)
# ==========================================================
# [WHY THIS GENRE?]
# Modern Hard Techno pushes 138 BPM with a relentless 4/4 kick,
# a distorted 16th‑note rolling bass, and piercing industrial FM
# stabs. This playbook uses extreme cutoff (120) and microscopic
# release (0.1) to create a grinding, aggressive wall of sound.
# [DNA: 138 BPM, D minor, 4/4 kick, distorted rolling bass,
#  off‑beat hats, stark chords, industrial FM alarm, granular static]
# ==========================================================

use_bpm 138

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# ----------------------------------------------------------
# SCORES – Normalized with gen_score, DRY where possible
# ----------------------------------------------------------

# Relentless 4/4 kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy dry clap on beats 2 and 4
s_clap = gen_score("....x.......x...", [:c4])

# Rigid off‑beat open hats – pattern with 4 hits
s_hats = gen_score("..x...x...x...x.",
  [{note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}])

# Distorted rolling bass – continuous 16th notes
bass_notes = [:d1, :d1, :d2, :d1,
              :d1, :d1, :f1, :f1,
              :f1, :f1, :f2, :f1,
              :g1, :g1, :a1, :d1].ring
s_bass = gen_score("xxxxxxxxxxxxxxxx",
  bass_notes.map { |n| {note: n, cutoff: 120, release: 0.1} })

# Stark minor chords – off‑beats (same pattern as hats)
s_chords = gen_score("..x...x...x...x.",
  [[:d3, :f3, :a3], [:d3, :f3, :a3],
   [:g3, :bb3, :d4], [:g3, :bb3, :d4]])

# Piercing industrial FM alarm – 5 hits
s_fm = gen_score("....x.x..x.x..x.",
  [{note: :d6, amp: 0.5, divisor: 3, depth: 4, release: 0.1},
   {note: :a5, amp: 0.4, divisor: 3, depth: 4, release: 0.1},
   {note: :d6, amp: 0.5, divisor: 3, depth: 4, release: 0.1},
   {note: :f6, amp: 0.6, divisor: 3, depth: 4, release: 0.1},
   {note: :a5, amp: 0.4, divisor: 3, depth: 4, release: 0.1}])

# Grinding granular static – two hits
s_grain = gen_score("x.......x.......",
  [{note: :d3, buffer: :elec_piano, pos: 0.1, density: 6, size: 0.05, amp: 0.4},
   {note: :d3, buffer: :elec_piano, pos: 0.5, density: 6, size: 0.05, amp: 0.5}])

# ----------------------------------------------------------
# PLAYBOOK 
# ----------------------------------------------------------
playbook = (ring
  # Scene 1 – The Warehouse: kick + bass (4 bars)
  [ [:play_kick, s_kick, 4],
    [:play_sub, s_bass, 4] ],

  # Scene 2 – The Machine: add claps, hats, and chords (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_sub, s_bass, 8],
    [:play_snare, s_clap, 8],
    [:play_hats, s_hats, 8],
    [:play_chords, s_chords, 8] ],

  # Scene 3 – The Meltdown: full arrangement with FM and granular (8 bars)
  [ [:play_kick, s_kick, 8],
    [:play_sub, s_bass, 8],
    [:play_snare, s_clap, 8],
    [:play_hats, s_hats, 8],
    [:play_chords, s_chords, 8],
    [:play_lead, s_fm, 8],
    [:play_grain, s_grain, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# 1. Data‑Driven Overdrive – cutoff 120 on every bass step opens
#    the filter wide, letting harsh sawtooth harmonics create a
#    buzzing “chug” that mimics modular overdrive.
# 2. The 16th‑Note Roll – the bass never stops, firing with
#    mathematical precision at 138 BPM for a hypnotic, relentless
#    pulse.
# 3. Extreme FM Aggression – divisor 3 and depth 4 produce a
#    piercing metallic alarm that cuts through the heavy mix
#    without external distortion.
# ==========================================================
