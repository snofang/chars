# ==========================================================
# PLAYBOOK: 80s POST-PUNK / COLDWAVE
# (Pioneered by Joy Division, Bauhaus, and The Cure)
# ==========================================================
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 80s Post-Punk.
# We have explored complex syncopation (Baltimore Club) and massive 
# festival energy (Trance). Post-Punk is the exact opposite. It is 
# rigid, stark, and melancholic. It relies on a driving, relentless 
# 8th/16th-note bassline (often played with a pick on a bass guitar), 
# sparse, mechanical drum machines, and cold, atmospheric synth pads.
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create hypnotic momentum without complex breaks. By pushing the 
# `:play_sub` synth to a high `cutoff` and short `release`, the engine 
# turns the detuned sawtooth into a driving, melodic bass guitar.
# ==========================================================

use_bpm 140

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Minor - Stark & Melancholic)
# ==========================================================

# Stark, mechanical drum machine kick. 
# Hits on step 0, beat 3 (step 8), and a ghost hit on the 'a' of 4 (step 15).
s_kick  = (ring :c4, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 1.0}, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.5}, nil)

# Tight, dry snare strictly on beats 2 and 4 (steps 4 and 12).
s_snare = (ring nil, nil, nil, nil, :c4, nil, nil, nil, nil, nil, nil, nil, :c4, nil, nil, nil)

# Rigid, relentless 8th-note closed hats.
s_hats  = (ring {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.3}, nil)

# The "Picked" Driving Bass (D Minor).
# Plays continuous 16th notes. The high cutoff (100) and short release (0.15) 
# mimic the aggressive, repetitive sound of a picked electric bass.
s_bass  = (ring {:note => :d2, :release => 0.15, :cutoff => 100}, {:note => :d2, :release => 0.15, :cutoff => 100}, {:note => :d3, :release => 0.15, :cutoff => 100}, {:note => :d2, :release => 0.15, :cutoff => 100}, 
           {:note => :d2, :release => 0.15, :cutoff => 100}, {:note => :d2, :release => 0.15, :cutoff => 100}, {:note => :f2, :release => 0.15, :cutoff => 100}, {:note => :d2, :release => 0.15, :cutoff => 100}, 
           {:note => :a2, :release => 0.15, :cutoff => 100}, {:note => :a2, :release => 0.15, :cutoff => 100}, {:note => :a3, :release => 0.15, :cutoff => 100}, {:note => :a2, :release => 0.15, :cutoff => 100}, 
           {:note => :g2, :release => 0.15, :cutoff => 100}, {:note => :g2, :release => 0.15, :cutoff => 100}, {:note => :f2, :release => 0.15, :cutoff => 100}, {:note => :e2, :release => 0.15, :cutoff => 100})

# Cold, atmospheric minor chord stabs (Dm to Gm).
# Hit sparingly on the downbeats to create a sense of dread.
s_chords= (ring [:d3, :f3, :a3], nil, nil, nil, nil, nil, nil, nil, [:g3, :bb3, :d4], nil, nil, nil, nil, nil, nil, nil)

# Angular, echoing guitar/synth melody (D Harmonic Minor).
# Uses :play_fm with a low divisor to create a sharp, organic pluck.
# Routed through the engine's tape echo for a cavernous, gothic smear.
s_fm    = (ring nil, nil, nil, nil, nil, nil, nil, nil, {:note => :d5, :amp => 0.6, :divisor => 1, :depth => 2, :release => 0.5}, nil, nil, nil, nil, nil, nil, nil)

# Dark, swirling analog drone (Granular Synth).
# Long size (0.3) and low density (1) creates a slow, evolving coldwave texture.
s_grain = (ring {:note => :d3, :buffer => :ambi_choir, :pos => 0.1, :density => 1, :size => 0.3, :amp => 0.4}, nil, nil, nil, nil, nil, nil, nil, {:note => :a3, :buffer => :ambi_choir, :pos => 0.4, :density => 1, :size => 0.3, :amp => 0.4}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Atmosphere - Just the drone and driving bass (4 bars)
  [ [:play_grain, s_grain, 4], [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Machine - Add the stark, mechanical drums (8 bars)
  [ [:play_grain, s_grain, 8], [:play_sub, s_bass, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Dread - The cold chords and angular melody drop (8 bars)
  [ [:play_grain, s_grain, 8], [:play_sub, s_bass, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_chords, s_chords, 8], [:play_fm, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN STARK MOMENTUM]
# 
# 1. The Picked Bass: Look at `s_bass`. The `:play_sub` synth (usually a 
#    deep rumble) is given a `cutoff` of `100` and a `release` of `0.15`. 
#    This strips away the sub-frequencies and cuts the note off instantly, 
#    turning the detuned sawtooth into an aggressive, repetitive "thwack" 
#    that perfectly mimics a picked bass guitar driving the rhythm.
#
# 2. Rigid Minimalism: Look at `s_hats` and `s_snare`. The hats play 
#    relentless, straight 8th notes. There is zero swing. The engine's 
#    strict master clock ensures this rigid, mechanical repetition never 
#    wavers, creating the cold, industrial feel of 80s drum machines.
#
# 3. Cavernous Space: 90% of the `s_chords` and `s_fm` grids are `nil`. 
#    By leaving the grid almost entirely empty, the track feels vast and 
#    lonely. When the melody does hit (step 8), the engine's tape echo 
#    smears it across the empty space, creating the gothic, echoing 
#    atmosphere defined by bands like Joy Division and The Cure.
# ==========================================================
