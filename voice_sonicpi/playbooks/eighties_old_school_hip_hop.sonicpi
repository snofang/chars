# ==========================================================
# PLAYBOOK: 80s OLD-SCHOOL HIP-HOP / GOLDEN AGE
# (Pioneered by Run-DMC, LL Cool J, and Beastie Boys)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 80s Old-School Hip-Hop.
# We have explored modern Trap and 90s Boom-Bap, but Old-School Hip-Hop is 
# the sound of the 80s park jam. It relies on a stark, stripped-down Roland 
# TR-808 drum machine, heavy "rock-guitar" power chords, and a relentless, 
# bouncing 8th-note bassline. It is raw, mechanical, and undeniably funky.
#
# This playbook perfectly demonstrates how to use the `:play_fm` synth 
# to simulate a distorted rock guitar stab, and how to use the 16-step 
# grid to create a heavy, bouncing 8th-note bassline that drives the track.
# ==========================================================

use_bpm 100

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (E Minor - Raw, Stark, & Bouncy)
# ==========================================================

# The "808" Kick. 
# Heavy march. Hits on step 0, beat 2 (step 4), beat 3 (step 8), and beat 4 (step 12).
s_kick = gen_score("x...x...x...x...", [:c4])

# Crisp, 808 snare strictly on beats 2 and 4.
s_snare = gen_score("....x.......x...", [:c4])

# Rigid, alternating 8th hats. 
# Notice the amplitude difference (0.3 vs 0.15) that creates a robotic march.
s_hats = gen_score("x.x.x.x.x.x.x.x.", [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}])

# The "Bouncing" Bass (E Minor).
# Plays continuous 8th notes. Mid cutoff (90) and short release (0.15) 
# create a raw, bouncy undercurrent.
bass_cycle = [:e1, :e1, :e1, :e1, :g1, :g1, :g1, :g1, :a1, :a1, :a1, :a1, :b1, :b1, :b1, :b1]
bass_data = bass_cycle.map { |n| {note: n, cutoff: 90, release: 0.15, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# The "Rock Guitar" Power Chords (E5 to G5 to A5).
# Uses :play_fm with a low divisor (2) and extreme depth (5) to create a 
# sharp, buzzy square wave that mimics a distorted electric guitar.
s_chords = gen_score("..x.....x.....x.", [
  {note: [:e3, :b3], divisor: 2, depth: 5, release: 0.2, amp: 0.6},
  {note: [:g3, :d4], divisor: 2, depth: 5, release: 0.2, amp: 0.6},
  {note: [:a3, :e4], divisor: 2, depth: 5, release: 0.2, amp: 0.6}
])

# Piercing, "Scratch" FM Lead (E Minor Pentatonic).
# Uses :play_fm with a high divisor (3) and depth (2) to create a sharp, 
# piercing pluck that mimics a DJ scratch.
fm_notes = [:e5, :g5, :b5, :e5, :d5, :b4]
fm_data = fm_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 2, release: 0.1} }
s_fm = gen_score("x...x...x...x...", fm_data)

# Pitched-down, "Crowd" vocal chant (Granular Synth).
# Long size (0.1) and low density (1) creates a raw, repetitive vocal hit.
s_vocal = gen_score("x...............", [
  {note: :e3, buffer: :misc_lori, pos: 0.2, density: 1, size: 0.1, amp: 0.6}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Jam - Just the 808 drums, bass, and guitar stabs (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_fm, s_chords, 4] ],
  
  # Scene 2: The Vibe - Add the crowd chant (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drop - The piercing scratch lead drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN RAW FUNK]
# 
# 1. FM as a Rock Guitar: Look at `s_chords`. The `:play_fm` synth is given 
#    a `divisor` of `2` and an extreme `depth` of `5`. This harsh harmonic 
#    ratio forces the FM modulator to shatter the carrier wave, creating a 
#    piercing, buzzy square wave that perfectly mimics a distorted electric 
#    guitar playing power chords.
#
# 2. The 8th-Note Bounce: Look at `s_bass`. The `:play_sub` synth plays on 
#    every 8th note (steps 0, 2, 4, 6, etc.). By using a mid-range `cutoff` 
#    (90) and a short `release` (0.15), the engine turns the detuned sawtooth 
#    into a raw, bouncy "thwack" that perfectly mimics the heavy, driving 
#    basslines of 80s old-school hip-hop.
#
# 3. The 808 March: Look at `s_kick`. It hits strictly on every beat 
#    (steps 0, 4, 8, 12). This rigid, four-on-the-floor pattern is the 
#    absolute genetic code of 80s hip-hop. The engine's strict master clock 
#    ensures this heavy, mechanical march locks perfectly with the bouncing 
#    8th-note bassline.
# ==========================================================
