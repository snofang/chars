use_bpm 120

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (C# Minor - Menacing & Dark)
# ==========================================================

# Bouncing 4/4 kick with a syncopated extra hit on the 'and' of 3.
s_kick  = (ring :c4, nil, nil, nil, {:note => :c4, :amp => 0.6}, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil, {:note => :c4, :amp => 0.6}, nil, nil, nil)

# Tight, dry Memphis snare strictly on beats 2 and 4.
s_snare = (ring nil, nil, nil, nil, :c4, nil, nil, nil, nil, nil, nil, nil, :c4, nil, nil, nil)

# Fast, relentless 16th hats
s_hats  = (ring {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, 
           {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, 
           {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, 
           {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2})

# Booming, syncopated 808 bass. Long release to ring out underneath the cowbell.
s_bass  = (ring {:note => :cs2, :release => 1.0}, nil, nil, nil, nil, nil, nil, nil, 
           {:note => :gs2, :release => 1.0}, nil, nil, nil, nil, nil, nil, nil)

# The Iconic 808 Cowbell Melody (C# Minor).
# Using :play_fm with high divisor to create a metallic, bell-like tone.
# Routed through the engine's tape echo for that signature Phonk smear.
s_cowbell = (ring {:note => :cs5, :amp => 0.7, :divisor => 4.0, :depth => 1}, nil, {:note => :cs5, :amp => 0.5, :divisor => 4.0, :depth => 1}, nil, 
             {:note => :ds5, :amp => 0.6, :divisor => 4.0, :depth => 1}, nil, {:note => :fs5, :amp => 0.8, :divisor => 4.0, :depth => 1}, nil, 
             {:note => :gs5, :amp => 0.7, :divisor => 4.0, :depth => 1}, nil, {:note => :fs5, :amp => 0.5, :divisor => 4.0, :depth => 1}, nil, 
             {:note => :ds5, :amp => 0.6, :divisor => 4.0, :depth => 1}, nil, {:note => :cs5, :amp => 0.7, :divisor => 4.0, :depth => 1}, nil)

# Sinister, chopped-and-screwed vocal whisper (Granular Synth)
# Using :misc_lori, low pitch, long size for a demonic, drifting drone.
s_vocal = (ring nil, nil, nil, nil, nil, nil, nil, nil, 
           {:note => :cs3, :buffer => :misc_lori, :pos => 0.8, :density => 2, :size => 0.15, :amp => 0.5}, nil, nil, nil, 
           nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the booming 808 and the cowbell melody (4 bars)
  [ [:play_sub, s_bass, 4], [:play_fm, s_cowbell, 4] ],
  
  # Scene 2: Add the bouncing Memphis drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_cowbell, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: Add the sinister granular vocal chops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_fm, s_cowbell, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
