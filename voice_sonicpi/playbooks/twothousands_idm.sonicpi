# ==========================================================
# PLAYBOOK: 2000s IDM / NOSTALGIC ELECTRONICA
# (Pioneered by Boards of Canada, Tycho, and Ulrich Schnauss)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# Nostalgic Electronica is the sound of warm, analog childhood
# memories – a slowed‑down hip‑hop grid at 85 BPM, tape‑warbled
# pads, deep round bass, and wobbly FM melodies. This playbook
# uses low cutoffs, slow attacks, and long granular sizes to
# create a hazy, VHS‑like, dreamlike atmosphere.
# ==========================================================

use_bpm 85

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x......x..x.....", [
  :c4,
  {note: :c4, amp: 0.7},
  {note: :c4, amp: 1.0}
])

s_snare = gen_score("....x.......x...", [
  {note: :c4, amp: 0.7},
  {note: :c4, amp: 0.7}
])

s_hats  = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.15},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.15},
  {note: :c4, amp: 0.3}
])

s_bass  = gen_score("x.......x.......", [
  {note: :d2, release: 0.5, cutoff: 60},
  {note: :a1, release: 0.5, cutoff: 60}
])

s_chords = gen_score("x.......x.......", [
  {note: [:d3, :fs3, :a3, :e4], cutoff: 75, attack: 0.5, release: 2.0, amp: 0.6},
  {note: [:g2, :b2, :d3, :a3], cutoff: 75, attack: 0.5, release: 2.0, amp: 0.6}
])

s_fm    = gen_score("....x...x...x...", [
  {note: :d5,  amp: 0.5, divisor: 2, depth: 1, release: 0.8},
  {note: :fs5, amp: 0.4, divisor: 2, depth: 1, release: 0.8},
  {note: :a5,  amp: 0.5, divisor: 2, depth: 1, release: 0.8}
])

s_grain = gen_score("x.......x.......", [
  {note: :d4, buffer: :ambi_choir, pos: 0.3, density: 1, size: 0.3, amp: 0.5},
  {note: :a4, buffer: :ambi_choir, pos: 0.6, density: 1, size: 0.3, amp: 0.5}
])

# Playbook
playbook = (ring
  # Scene 1: The Memory – sweeping chords, bass, and vocal drone (4 bars)
  [ [:play_chords, s_chords, 4], [:play_sub, s_bass, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Groove – add swung, laid‑back drums (8 bars)
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], [:play_grain, s_grain, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Vibe – wobbly analog melody drops (8 bars)
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], [:play_grain, s_grain, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Data‑driven saturation: low cutoffs (60, 75) strip high
#   frequencies, creating a warm, VHS‑like, muffled tone.
# - Swelling waves: attack 0.5 and release 2.0 on chords make
#   them slowly fade in and out, like a blurred memory.
# - Soft FM bells: divisor 2, depth 1 produce a sine‑like
#   analog tone; tape echo spreads the sparse notes into a
#   dreamy, cascading texture.
# ==========================================================
