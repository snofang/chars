# ==========================================================
# PLAYBOOK: SLAP HOUSE / BRAZILIAN BASS
# (Pioneered by Alok, Vintage Culture, and Malaa)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# Slap House is the modern Brazilian sound – a rolling FM
# "slap" bass on the off‑beats, driving 4/4 kicks, and
# staccato chords. This playbook uses rapidly changing FM
# parameters to create a thick, wobbly "talking" bass that
# defines the genre.
# ==========================================================

use_bpm 122

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores

# 4‑on‑the‑floor kick
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy clap on beats 2 and 4
s_clap = gen_score("....x.......x...", [:c4])

# Off‑beat open hats with dynamic accents
s_hats = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4}
])

# "Slap" FM bass – double hits with changing divisor/depth
s_bass = gen_score("..xx..xx..xx..xx", [
  {note: :a1, divisor: 2, depth: 4, release: 0.12, amp: 1.0},
  {note: :a1, divisor: 3, depth: 5, release: 0.12, amp: 0.8},
  {note: :c2, divisor: 2, depth: 4, release: 0.12, amp: 1.0},
  {note: :c2, divisor: 4, depth: 6, release: 0.12, amp: 0.8},
  {note: :e2, divisor: 2, depth: 4, release: 0.12, amp: 1.0},
  {note: :e2, divisor: 3, depth: 5, release: 0.12, amp: 0.8},
  {note: :g2, divisor: 2, depth: 4, release: 0.12, amp: 1.0},
  {note: :g2, divisor: 4, depth: 6, release: 0.12, amp: 0.8}
])

# Staccato chord stabs on the off‑beats
s_chords = gen_score("....x....x....x.", [
  {note: [:a3, :c4, :e4], cutoff: 100, release: 0.15, amp: 0.6},
  {note: [:c4, :e4, :g4], cutoff: 100, release: 0.15, amp: 0.6},
  {note: [:e3, :g3, :b3], cutoff: 100, release: 0.15, amp: 0.6}
])

# High‑pitched pluck melody with tape echo
s_fm = gen_score("x..x.x..x..x....", [
  {note: :a5, amp: 0.6, divisor: 3, depth: 2, release: 0.2},
  {note: :e5, amp: 0.5, divisor: 3, depth: 2, release: 0.2},
  {note: :c6, amp: 0.6, divisor: 3, depth: 2, release: 0.2},
  {note: :b5, amp: 0.5, divisor: 3, depth: 2, release: 0.2},
  {note: :a5, amp: 0.7, divisor: 3, depth: 2, release: 0.2}
])

# Sugary vocal stutter
s_vocal = gen_score("....x.....x....", [
  {note: :a4, buffer: :ambi_choir, pos: 0.2, density: 2, size: 0.03, amp: 0.6},
  {note: :c5, buffer: :ambi_choir, pos: 0.4, density: 2, size: 0.03, amp: 0.6}
])

# Playbook
playbook = (ring
  # Scene 1: The Groove – kick, hats, slap bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_hats, s_hats, 4], [:play_fm, s_bass, 4] ],
  
  # Scene 2: The Vibe – add claps and chord stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_hats, s_hats, 8], [:play_fm, s_bass, 8],
    [:play_snare, s_clap, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Drop – pluck melody and vocal chops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_hats, s_hats, 8], [:play_fm, s_bass, 8],
    [:play_snare, s_clap, 8], [:play_chords, s_chords, 8],
    [:play_lead, s_fm, 8], [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The "slap" FM bass uses rapid divisor/depth changes on
#   off‑beat double hits to create a thick, wobbly "talking"
#   sound that defines Brazilian Bass.
# - Bass, hats, and chords lock on steps 2,6,10,14 – the
#   exact midpoints between kicks – for a relentless bounce.
# - The pluck melody (divisor 3) cuts through the mix, while
#   the granular vocal stutter adds a pristine pop quality
#   perfect for streaming.
# ==========================================================
