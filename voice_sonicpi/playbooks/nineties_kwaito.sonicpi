# ==========================================================
# PLAYBOOK: 90s KWAITO
# (Pioneered by Arthur, Mzekezeke, and Trompies)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# Kwaito is the Godfather of South African electronic music.
# It slows house down to 105 BPM with deep reggae‑style bass,
# syncopated "Sembhi" kicks, and raw vocal chants.
# This playbook uses low‑cutoff bass and muffled chords to
# recreate the warm, nostalgic 90s groovebox sound.
# ==========================================================

use_bpm 105

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x..x..x.x.....x.", [
  {note: :c4, amp: 1.0},
  {note: :c4, amp: 0.8},
  {note: :c4, amp: 0.9},
  {note: :c4, amp: 1.0},
  {note: :c4, amp: 0.5}
])

s_clap  = gen_score("....x.......x...", [
  {note: :c4, amp: 0.8},
  {note: :c4, amp: 0.8}
])

s_hats  = gen_score("x.xxx.xxx.xxx.xx", [
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.15},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.15},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.15},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.15}
])

s_bass  = gen_score("x..x.x..x..x.x.x", [
  {note: :a1, release: 0.3, cutoff: 70},
  {note: :a1, release: 0.3, cutoff: 70},
  {note: :c2, release: 0.3, cutoff: 70},
  {note: :e2, release: 0.3, cutoff: 70},
  {note: :e2, release: 0.3, cutoff: 70},
  {note: :d2, release: 0.3, cutoff: 70},
  {note: :c2, release: 0.3, cutoff: 70}
])

s_chords = gen_score("x.......x.......", [
  {note: [:a3, :c4, :e4], cutoff: 85, release: 0.5, amp: 0.6},
  {note: [:e3, :g3, :b3], cutoff: 85, release: 0.5, amp: 0.6}
])

s_fm    = gen_score(".x...x.x.x...x..", [
  {note: :a5, amp: 0.6, divisor: 3, depth: 2, release: 0.3},
  {note: :c5, amp: 0.5, divisor: 3, depth: 2, release: 0.3},
  {note: :e5, amp: 0.6, divisor: 3, depth: 2, release: 0.3},
  {note: :a5, amp: 0.7, divisor: 3, depth: 2, release: 0.3},
  {note: :e5, amp: 0.5, divisor: 3, depth: 2, release: 0.3}
])

s_vocal = gen_score("x.......x.......", [
  {note: :a3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.1, amp: 0.6},
  {note: :a3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.1, amp: 0.6}
])

# Playbook
playbook = (ring
  # Scene 1: The Groove – syncopated drums and deep bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_clap, 4], [:play_hats, s_hats, 4],
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Vibe – add muffled chords (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Street – marimba melody and vocal chants drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8],
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8],
    [:play_lead, s_fm, 8], [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The "Sembhi" kick syncopation (steps 0,3,6,8,14) creates
#   a lopsided, distinctly South African groove.
# - Bass uses cutoff 70 and release 0.3 for a warm, muffled
#   low‑end that mimics 90s Yamaha groovebox basslines.
# - The granulated vocal (density 1, size 0.1) produces a raw,
#   rhythmic chant that locks with the off‑beat percussion.
# ==========================================================
