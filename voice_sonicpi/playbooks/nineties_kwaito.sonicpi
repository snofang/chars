# ==========================================================
# PLAYBOOK: 90s KWAITO
# (Pioneered by Arthur, Mzekezeke, and Trompies)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Kwaito.
# We have explored Afro House (which is lush and jazzy) and Gqom 
# (which is dark and minimal). Kwaito is the Godfather of South 
# African electronic music. Emerging in the 90s, it slowed house 
# music down to a swaggering 105 BPM. It relies on deep, round 
# reggae-style basslines, a specific "Sembhi" syncopated kick, and 
# raw, repetitive vocal chants.
#
# This playbook perfectly demonstrates how to use the Parameter 
# Hashes to create a warm, muffled bassline that feels like a 90s 
# Yamaha groovebox. By using a low `cutoff` and medium `release`, 
# the engine creates a nostalgic, deep, and distinctly South African 
# street groove.
# ==========================================================

use_bpm 105

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Deep, Nostalgic, & Bouncy)
# ==========================================================

# The "Sembhi" Kick. 
# Syncopated 3-3-2 feel. Hits on step 0, the 'a' of 1 (step 3), 
# the 'and' of 2 (step 6), and beat 3 (step 8), with a ghost on 15.
s_kick  = (ring {:note => :c4, :amp => 1.0}, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, {:note => :c4, :amp => 0.9}, nil, {:note => :c4, :amp => 1.0}, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.5}, nil)

# Crisp, organic clap strictly on beats 2 and 4 (steps 4 and 12).
s_clap  = (ring nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil)

# Swung, organic shaker. 
# Notice the gaps (nil) and amplitude manipulation to create a human feel.
s_hats  = (ring {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.15}, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.15}, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.15}, {:note => :c4, :amp => 0.2}, nil, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.15})

# The "Deep Kwaito" Bass (A Minor).
# Walks a melodic line. Very low cutoff (70) and medium release (0.3) 
# to create a warm, muffled, 90s groovebox undercurrent.
s_bass  = (ring {:note => :a1, :release => 0.3, :cutoff => 70}, nil, nil, {:note => :a1, :release => 0.3, :cutoff => 70}, nil, {:note => :c2, :release => 0.3, :cutoff => 70}, nil, nil, {:note => :e2, :release => 0.3, :cutoff => 70}, nil, nil, {:note => :e2, :release => 0.3, :cutoff => 70}, nil, {:note => :d2, :release => 0.3, :cutoff => 70}, nil, {:note => :c2, :release => 0.3, :cutoff => 70})

# Lush, warm minor chord stabs (Am to Em).
# Hit on the downbeats. The low cutoff (85) gives them that classic 
# "played through a wall" muffled feel.
s_chords= (ring {:note => [:a3, :c4, :e4], :cutoff => 85, :release => 0.5, :amp => 0.6}, nil, nil, nil, nil, nil, nil, nil, {:note => [:e3, :g3, :b3], :cutoff => 85, :release => 0.5, :amp => 0.6}, nil, nil, nil, nil, nil, nil, nil)

# Bright, echoing "Marimba/Choral" Melody (A Minor Pentatonic).
# Uses :play_fm with a high divisor (3) and depth (2) to create a 
# hollow, organic African marimba tone.
s_fm    = (ring nil, {:note => :a5, :amp => 0.6, :divisor => 3, :depth => 2, :release => 0.3}, nil, nil, nil, {:note => :c5, :amp => 0.5, :divisor => 3, :depth => 2, :release => 0.3}, nil, {:note => :e5, :amp => 0.6, :divisor => 3, :depth => 2, :release => 0.3}, nil, {:note => :a5, :amp => 0.7, :divisor => 3, :depth => 2, :release => 0.3}, nil, nil, nil, {:note => :e5, :amp => 0.5, :divisor => 3, :depth => 2, :release => 0.3}, nil, nil)

# Repetitive, pitched-down "Street" vocal chant (Granular Synth).
# Low density, medium size = a raw, repetitive vocal hit.
s_vocal = (ring {:note => :a3, :buffer => :ambi_choir, :pos => 0.2, :density => 1, :size => 0.1, :amp => 0.6}, nil, nil, nil, nil, nil, nil, nil, {:note => :a3, :buffer => :ambi_choir, :pos => 0.2, :density => 1, :size => 0.1, :amp => 0.6}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the syncopated drums and deep bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_clap, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Vibe - Add the warm, muffled chords (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Street - The marimba melody and vocal chants drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], 
    [:play_lead, s_fm, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN SOUTH AFRICAN GROOVE]
# 
# 1. The Sembhi Syncopation: Look at `s_kick`. It hits on steps 0, 3, 6, 
#    8, and 15. By avoiding the standard 4/4 pulse and hitting on the "a" 
#    of beat 1 and the "and" of beat 2, the engine creates a lopsided, 
#    staggering groove that feels distinctly South African. The engine's 
#    strict master clock ensures this complex rhythm lands with absolute 
#    precision.
#
# 2. The 90s Groovebox Bass: Look at `s_bass`. The `:play_sub` synth is 
#    given a `cutoff` of `70` and a `release` of `0.3`. This filters out 
#    all the harsh high frequencies, leaving only a deep, warm, muffled 
#    low-end that perfectly mimics the raw, 90s Yamaha RM1X basslines 
#    used to produce early Kwaito tracks.
#
# 3. Raw Vocal Chants: Kwaito vocals are rarely melodic; they are raw, 
#    repetitive, and percussive. The `s_vocal` sequence uses the granular 
#    engine to chop a vocal into a raw, rhythmic hit. By pitching it down 
#    to `:a3` and placing it on the downbeats, the engine creates the 
#    perfect call-and-response structure for a street chant.
# ==========================================================
