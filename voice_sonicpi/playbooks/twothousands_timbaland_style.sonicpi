# ==========================================================
# PLAYBOOK: 2000s TIMBALAND STYLE / ELECTRO-R&B
# (Pioneered by Timbaland, Justin Timberlake, and Aaliyah)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 2000s Timbaland Style.
# We have explored 90s Hip-Hop and modern Trap, but the 2000s Timbaland 
# sound is the absolute pinnacle of syncopated, futuristic pop-R&B. 
# It relies on heavily syncopated, staccato 808 drum patterns, deep, 
# bouncy sub-bass, eerie "Arabic" or "Indian" scale melodies, and 
# pitched-down, rhythmic vocal grunts.
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create a highly complex, bouncy groove. By using a high `cutoff` on 
# the `:play_fm` synth to simulate a pizzicato string/harp, the engine 
# creates a futuristic, syncopated atmosphere that defined 2000s radio.
# ==========================================================

use_bpm 100

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Phrygian Dominant - Futuristic, Syncopated, & Bouncy)
# ==========================================================

# The "Timbaland" Kick. 
# Highly syncopated staccato hits. Steps 0, 3, 6, 8, 11.
s_kick = gen_score("x..x.x.x..x.....", [
  :c4, {note: :c4, amp: 0.6}, {note: :c4, amp: 0.8}, :c4, {note: :c4, amp: 0.7}
])

# Crisp, organic snare/clap strictly on beats 2 and 4.
s_snare = gen_score("....x.......x...", [:c4])

# Fast, rolling 16th hats with a pause to create space.
s_hats = gen_score("x.x.x.....x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, {note: :c4, amp: 0.4}, 
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}
])

# Deep, bouncy sub-bass (D Phrygian Dominant).
# Hits a syncopated melody. Low cutoff (60) and short release (0.15) 
# to create a pristine, distortion-free bounce.
s_bass = gen_score("x.....x...x.....", [
  {note: :d1, release: 0.15, cutoff: 60, amp: 1.2}, 
  {note: :c2, release: 0.15, cutoff: 60, amp: 1.0}, 
  {note: :a1, release: 0.15, cutoff: 60, amp: 1.0}
])

# The "Pizzicato" Synth Stabs (Dm to C# to A).
# Uses :play_fm with a high divisor (4) and low depth (2) to create a sharp, 
# staccato pluck that mimics a harp or pizzicato string.
chord_notes = [
  {note: [:d3, :f3, :a3]}, {note: [:cs3, :e3, :g3]}, 
  {note: [:cs3, :e3, :g3]}, {note: [:a2, :cs3, :e3]}
]
chord_data = chord_notes.map { |c| c.merge({cutoff: 100, release: 0.1, amp: 0.5}) }
s_chords = gen_score("..x.....x.x.....", chord_data)

# Eerie, "Arabic/Indian" Synth Lead (D Phrygian Dominant).
# Uses :play_fm with a low divisor (2) and depth (3) to create a sharp, 
# buzzy lead. Routed through the tape echo.
lead_notes = [:d5, :c5, :cs5, :d5, :f5, :e5, :cs5, :c5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 3, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# Pitched-down, rhythmic "Grunts" (Granular Synth).
# Pitched DOWN to :d2. High density, tiny size = a dark, percussive vocal hit.
s_vocal = gen_score("....x.......x...", [
  {note: :d2, buffer: :ambi_choir, pos: 0.1, density: 2, size: 0.04, amp: 0.7},
  {note: :c2, buffer: :ambi_choir, pos: 0.2, density: 2, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Beat - Just the syncopated drums and sub-bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Vibe - Add the pizzicato stabs and vocal grunts (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drop - The eerie Phrygian lead melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN SYNCOPATION]
# 
# 1. The Staccato 808: Look at `s_kick`. It completely avoids landing on 
#    the standard 4/4 pulse. By hitting on steps 0, 3, 6, 8, and 11, the 
#    engine creates a highly syncopated, staccato groove that feels like 
#    a human drummer playing a complex funk break. The engine's strict 
#    master clock ensures this complex rhythm lands with absolute precision.
#
# 2. FM as a Pizzicato: Look at `s_chords`. The `:play_fm` synth is given 
#    a high `divisor` (4) and a low `depth` (2), with a microscopic `release` 
#    (0.1). This forces the FM synth to produce a sharp, clean, staccato 
#    "pluck" that perfectly mimics a harp or pizzicato string, locking in 
#    perfectly with the syncopated 808.
#
# 3. The Phrygian Dominant Scale: Look at `s_lead`. The melody uses D, Eb, 
#    F#, G, A, Bb, C#. The augmented 2nd interval between Eb and F# 
#    creates the exotic, "Arabic" sound that defined 2000s Timbaland 
#    productions. The engine's strict 16-step grid ensures this complex, 
#    chromatic melody fires flawlessly over the bouncy rhythm section.
# ==========================================================
