# ==========================================================
# PLAYBOOK: 90s ASIAN UNDERGROUND / TABLA BREAKBEAT
# (Pioneered by Talvin Singh, Nitin Sawhney, and State of Bengal)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Asian Underground.
# We have explored atmospheric jungle and Indian Bhangra, but the Asian 
# Underground (or "Tabla Breakbeat") movement of the late 90s was a highly 
# sophisticated fusion. It blended the frantic, chopped breakbeats of UK 
# drum & bass with the complex, cyclical rhythms of the Indian tabla, deep 
# sub-bass, and lush, exotic, modal melodies. 
#
# This playbook perfectly demonstrates how to fuse a high-speed 170 BPM 
# breakbeat with an exotic scale (D Phrygian Dominant). By routing a piercing 
# FM lead through the global tape echo bus, the engine creates a hypnotic, 
# cinematic, and deeply psychedelic atmosphere.
# ==========================================================

use_bpm 170

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Phrygian Dominant - Exotic, Fast, & Deep)
# ==========================================================

# The "Tabla Breakbeat" Kick. 
# A highly syncopated, chopped pattern. (6 x's, 6 elements)
s_kick = gen_score("x..x..x.x..x....", [
  :c4, {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.8}, 
  {note: :c4, amp: 0.6}, {note: :c4, amp: 0.5}
])

# Heavy, echoing snare on beats 2 and 4, with a frantic roll. (5 x's, 5 elements)
s_snare = gen_score("....x.....x.x.xx", [
  :c4, :c4, :c4, {note: :c4, amp: 0.5}, {note: :c4, amp: 0.7}
])

# Fast, rolling 16th hats to drive the momentum. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# Deep, massive "Sub-Bass" (D Phrygian Dominant).
# Massive release (2.0) and extreme low cutoff (40) create a deep, continuous rumble. 
# (2 x's, 2 elements)
s_bass = gen_score("x.......x.......", [
  {note: :d1, release: 2.0, cutoff: 40, amp: 1.2}, 
  {note: :bb0, release: 2.0, cutoff: 40, amp: 1.0}
])

# Lush, "String Synth" Pad (Dm to Bbm).
# Hit on the downbeats. The slow 1.0-beat attack and massive 3.0-beat release 
# blur the chords together into a continuous, cinematic wave. (2 x's, 2 elements)
s_chords = gen_score("x.......x.......", [
  {note: [:d3, :f3, :a3, :c4], cutoff: 70, attack: 1.0, release: 3.0, amp: 0.4},
  {note: [:bb2, :d3, :f3, :a3], cutoff: 70, attack: 1.0, release: 3.0, amp: 0.4}
])

# Piercing, "Sitar/Flute" Lead (D Phrygian Dominant).
# Uses :play_fm with a low divisor (2) and mid depth (3) to create a sharp, 
# buzzy, exotic tone. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:d5, :f5, :g5, :a5, :bb5, :a5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 3, release: 0.2} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Tabla/Vocal" Drone (Granular Synth).
# Using the built-in :ambi_choir sample.
# Long size (0.4) and low density (1) creates a slow, evolving background texture. 
# (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :d3, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.4, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Raga - Just the sub-bass, sweeping strings, and drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Tala - Add the frantic tabla breakbeat (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Trance - The piercing sitar/flute melody drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN EAST-WEST FUSION]
# 
# 1. The Phrygian Dominant Scale: Look at `s_bass`, `s_chords`, and `s_lead`. 
#    The harmony uses D, Eb, F#, G, A, Bb, C. The augmented 2nd interval 
#    between Eb and F# creates the exotic, "Indian" sound that defines the 
#    genre. The engine's strict 16-step grid ensures this rapid, melodic lead 
#    fires flawlessly over the complex rhythm section.
#
# 2. The Chopped Breakbeat: Look at `s_kick` and `s_snare`. They are densely 
#    packed and completely avoid landing on a standard 4/4 pulse. The engine's 
#    strict master clock ensures these complex, overlapping hits fire with 
#    absolute mathematical precision at 170 BPM, perfectly mimicking the 
#    chopped "Amen" breakbeats of 90s Asian Underground.
#
# 3. Subterranean Weight: Look at `s_bass`. The `:play_sub` synth is given a 
#    massive `release` of `2.0` (two whole beats) and an extreme low `cutoff` 
#    of `40`. This creates a deep, continuous rumble that anchors the erratic, 
#    skittering drums, perfectly mimicking the massive, system-shaking sub-bass 
#    of Talvin Singh and Nitin Sawhney.
# ==========================================================
