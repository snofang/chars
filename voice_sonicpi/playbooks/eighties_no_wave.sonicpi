# ==========================================================
# PLAYBOOK: 80s NO WAVE / DOWNTOWN NYC POST-PUNK
# (Pioneered by James Chance & The Contortions, Lydia Lunch, and DNA)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 80s No Wave.
# We have explored Darkwave and Funk Rock, but No Wave is the sound of 
# late 70s/early 80s downtown New York City. It was an anti-commercial, 
# avant-garde reaction to punk rock. It fuses the aggressive, driving energy 
# of punk with the syncopation of funk and the dissonance of free jazz. 
# It relies on a jerky, syncopated drum beat, a repetitive, aggressive 
# "slap" bass, and harsh, atonal, "skronking" saxophone or guitar stabs.
#
# This playbook perfectly demonstrates how to use a purely electronic 
# engine to simulate a noisy, live, avant-garde jazz-punk band. By using 
# the `:play_fm` synth with extreme `depth` to create dissonant, cluster 
# chords and a piercing, atonal lead, the engine creates a chaotic, 
# abrasive, and deeply funky atmosphere.
# ==========================================================

use_bpm 125

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (E Minor / Dissonant - Jerky, Aggressive, & Noisy)
# ==========================================================

# The "No Wave" Kick. 
# A jerky, syncopated funk-punk march. (5 x's, 5 elements)
s_kick = gen_score("x..x..x.x..x....", [
  :c4, {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.6}, :c4
])

# Heavy, dry snare on beats 2 and 4, with abrasive ghost notes. (3 x's, 3 elements)
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.9}
])

# Clanky, off-beat hats. (4 x's, 4 elements)
s_hats = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, 
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}
])

# The "Slap" Bass (Dissonant).
# Plays continuous, driving 8th notes. High cutoff (100) and short release (0.1) 
# create a punchy, aggressive "thwack". Uses dissonant intervals (min 2nds). 
# (8 x's, 8 elements)
bass_notes = [:e1, :e1, :f1, :e1, :bb1, :bb1, :b1, :bb1]
bass_data = bass_notes.map { |n| {note: n, cutoff: 100, release: 0.1, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# Harsh, "Cluster" Guitar/Synth Stabs (Atonal).
# Uses :play_fm with a low divisor (2) and extreme depth (5) to create a harsh, 
# dissonant hit. Uses cluster chords (adjacent semitones) for maximum skronk. 
# (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:e3, :f3], divisor: 2, depth: 5, release: 0.1, amp: 0.7},
  {note: [:e3, :f3], divisor: 2, depth: 5, release: 0.1, amp: 0.7},
  {note: [:bb2, :b2], divisor: 2, depth: 5, release: 0.1, amp: 0.7},
  {note: [:bb2, :b2], divisor: 2, depth: 5, release: 0.1, amp: 0.7}
])

# Piercing, "Skronking Sax" Lead (Dissonant).
# Uses :play_fm with a high divisor (3) and mid depth (3) to create a harsh, 
# piercing tone. Plays an atonal, repetitive melody. (6 x's, 6 elements)
lead_notes = [:e5, :f5, :e5, :bb5, :b5, :bb5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, divisor: 3, depth: 3, release: 0.15} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Yelping" Vocal (Granular Synth).
# High density, tiny size = a sharp, abrasive vocal skip. (1 x, 1 element)
s_vocal = gen_score("........x.......", [
  {note: :e4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Loft - Just the jerky drums, dissonant bass, and cluster stabs (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_fm, s_chords, 4] ],
  
  # Scene 2: The Vibe - Add the yelping vocals (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Solo - The piercing skronking sax lead drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN AVANT-GARDE FUNK]
# 
# 1. FM as a Skronk Machine: Look at `s_chords` and `s_lead`. The `:play_fm` 
#    synth is given an extreme `depth` (5) and plays cluster chords (adjacent 
#    semitones like :e3 and :f3). This harsh, dissonant harmony perfectly mimics 
#    the abrasive, "skronking" sound of a no-wave guitar or free-jazz saxophone, 
#    pushing the engine into intentionally noisy territory.
#
# 2. The Dissonant Slap Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    every 8th note, mapping out a repetitive, driving line. By using a high 
#    `cutoff` (100) and a short `release` (0.1), the engine turns the detuned 
#    sawtooth into a punchy, aggressive "thwack". The use of minor 2nds 
#    (:e1 to :f1) in the bassline adds to the tense, claustrophobic atmosphere.
#
# 3. The Jerky Syncopation: Look at `s_kick`. It completely avoids landing on 
#    a standard 4/4 pulse. By hitting on syncopated steps (0, 3, 6, 8, 11), the 
#    engine creates a lopsided, "jerky" groove that feels like a live punk-funk 
#    drummer playing in a sweaty downtown loft. The engine's strict master clock 
#    ensures this complex rhythm lands with absolute precision.
# ==========================================================
