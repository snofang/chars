use_bpm 95

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F Major - Bouncy & Laid Back)
# ==========================================================

# "Laid back" kick. Hits on step 0, the 'and' of 2 (step 5), and beat 4 (step 12).
# Notice the slight delays compared to a rigid grid.
s_kick  = (ring :c4, nil, nil, nil, nil, {:note => :c4, :amp => 0.9}, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, nil, nil, nil)

# Heavy clap strictly on beats 2 and 4 (steps 4 and 12)
s_clap  = (ring nil, nil, nil, nil, :c4, nil, nil, nil, nil, nil, nil, nil, :c4, nil, nil, nil)

# Swung, bouncing hats. Notice the triplet-feel emphasis on the off-beats.
s_hats  = (ring {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, 
           {:note => :c4, :amp => 0.4}, nil, nil, {:note => :c4, :amp => 0.2}, 
           {:note => :c4, :amp => 0.3}, nil, {:note => :c4, :amp => 0.2}, nil, 
           {:note => :c4, :amp => 0.4}, nil, {:note => :c4, :amp => 0.2}, nil)

# Deep, melodic Moog-style bass. 
# Plays a bouncy countermelody to the lead.
s_bass  = (ring :f2, nil, nil, :f2, nil, nil, {:note => :a2, :amp => 0.8}, nil, 
           {:note => :c3, :amp => 0.9}, nil, nil, nil, {:note => :bb2, :amp => 0.8}, nil, nil, nil)

# The iconic high-pitched G-Funk Lead (F Minor Pentatonic).
# Routed through the tape echo in the engine for that classic cinematic smear.
s_lead  = (ring nil, nil, nil, nil, {:note => :f5, :amp => 0.7}, nil, nil, nil, 
           {:note => :ab5, :amp => 0.8}, nil, {:note => :c6, :amp => 0.6}, nil, 
           nil, nil, {:note => :bb5, :amp => 0.7}, nil)

# Lush, sustained minor 9th chords for that West Coast lowrider feel.
s_chords= (ring [:f3, :ab3, :c4, :eb4], nil, nil, nil, nil, nil, nil, nil, 
           [:bb3, :db4, :f4, :ab4], nil, nil, nil, nil, nil, nil, nil)

# Distant granular "siren" or vocal wail (using :misc_lori buffer)
s_grain = (ring nil, nil, nil, nil, nil, nil, nil, nil, 
           {:note => :f4, :buffer => :misc_lori, :pos => 0.8, :density => 2, :size => 0.12}, nil, nil, nil, 
           nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the laid-back drums and chords (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_clap, 4], [:play_hats, s_hats, 4], 
    [:play_chords, s_chords, 4] ],
  
  # Scene 2: Add the deep, bouncing bassline (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_chords, s_chords, 8], [:play_sub, s_bass, 8] ],
    
  # Scene 3: The high-pitched G-Funk lead drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], 
    [:play_lead, s_lead, 8], [:play_grain, s_grain, 4] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
