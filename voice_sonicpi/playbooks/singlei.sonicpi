# ==========================================================
# PLAYBOOK: SINGELI
# (Pioneered by Mizinba, Sisso, and Kampala City)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# Singeli is a Tanzanian phenomenon at 180‑200 BPM with manic
# tambourine loops, syncopated "log drum" basslines, and raw
# MC chants. At 190 BPM, the 16‑step grid fires 16th notes at
# breakneck speed, creating a chaotic, celebratory street‑party
# energy.
# ==========================================================

use_bpm 190

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores

# Syncopated kick – hits on 0, 7, 8, 11, 14
s_kick = gen_score("x......xx..x..x.", [
  :c4,
  {note: :c4, amp: 0.7},
  {note: :c4, amp: 1.0},
  {note: :c4, amp: 0.6},
  {note: :c4, amp: 0.8}
])

# Snare on beats 2 and 4 (steps 4, 12)
s_snare = gen_score("....x.......x...", [
  {note: :c4, amp: 0.9},
  {note: :c4, amp: 0.9}
])

# Manic tambourine – every 16th step with alternating dynamics
s_tamb = gen_score("xxxxxxxxxxxxxxxx", [
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.15}
])

# "Log drum" bass – syncopated, very short release
s_bass = gen_score("x..x.x.x.x..x.x.", [
  {note: :a1, release: 0.15},
  {note: :a1, release: 0.15},
  {note: :a1, release: 0.15},
  {note: :g1, release: 0.15},
  {note: :a1, release: 0.15},
  {note: :a1, release: 0.15},
  {note: :g1, release: 0.15}
])

# Dark chord stabs on the downbeats
s_chords = gen_score("x.......x.......", [
  {note: [:a3, :c4, :e4], cutoff: 90, release: 0.2, amp: 0.5},
  {note: [:g3, :bb3, :d4], cutoff: 90, release: 0.2, amp: 0.5}
])

# Frantic marimba melody – every other step
s_fm = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :a5, amp: 0.6, divisor: 3, depth: 2, release: 0.1},
  {note: :c6, amp: 0.5, divisor: 3, depth: 2, release: 0.1},
  {note: :e6, amp: 0.6, divisor: 3, depth: 2, release: 0.1},
  {note: :a5, amp: 0.5, divisor: 3, depth: 2, release: 0.1},
  {note: :g5, amp: 0.6, divisor: 3, depth: 2, release: 0.1},
  {note: :e5, amp: 0.5, divisor: 3, depth: 2, release: 0.1},
  {note: :a5, amp: 0.7, divisor: 3, depth: 2, release: 0.1},
  {note: :c6, amp: 0.5, divisor: 3, depth: 2, release: 0.1}
])

# MC vocal chants – sparse, sharp stutter
s_vocal = gen_score(".....x....x...x.", [
  {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.02, amp: 0.7},
  {note: :c5, buffer: :ambi_choir, pos: 0.3, density: 3, size: 0.02, amp: 0.7},
  {note: :e4, buffer: :ambi_choir, pos: 0.5, density: 3, size: 0.02, amp: 0.7}
])

# Playbook
playbook = (ring
  # Scene 1: The Street – manic tambourine and log drum (4 bars)
  [ [:play_hats, s_tamb, 4], [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Party – add syncopated kick, snare, and chords (8 bars)
  [ [:play_hats, s_tamb, 8], [:play_sub, s_bass, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Climax – marimba melody and MC chants drop (8 bars)
  [ [:play_hats, s_tamb, 8], [:play_sub, s_bass, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_chords, s_chords, 8],
    [:play_lead, s_fm, 8], [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The tambourine plays every 16th step with alternating
#   amplitudes (0.3 vs 0.15), creating a continuous buzz.
# - The bass uses release 0.15 to mimic a sharp, wooden log
#   drum “thwack” that locks with the syncopated rhythm.
# - FM with divisor 3 and depth 2 produces a hollow marimba
#   tone that dances over the relentless percussion at 190 BPM.
# ==========================================================
