# ==========================================================
# PLAYBOOK: BLUEGRASS / APPALACHIAN FOLK
# (Pioneered by Bill Monroe, Flatt & Scruggs, and The Stanley Brothers)
# ==========================================================
# 
# [WHY THIS GENRE?]
# We have explored almost every electronic, metal, and hip-hop extreme. 
# Bluegrass tests the engine's ability to simulate a fast, driving, acoustic 
# "string band." It relies on a blistering 160 BPM "train beat" drum rhythm, 
# a walking upright bass, and continuous, rapid-fire 16th-note acoustic guitar 
# rolls. The `:play_pluck` synth is pushed to its limit to simulate the rolling, 
# staccato strumming of a bluegrass banjo or guitar.
#
# [THE CAREFULLY DESCRIBED DNA]
# 1. Tempo: 160 BPM. Fast, driving, and rolling.
# 2. Harmonic Center: G Major. Bright, rural, and folksy.
# 3. Rhythmic Skeleton: A fast, syncopated "train beat" on the drums, with 
#    continuous 16th-note strums on the acoustic instruments.
# 4. Timbral Palette:
#    - Bass: "Walking" upright bass (mid cutoff, short percussive release).
#    - Chords: Fast, rolling acoustic guitar/banjo arpeggios (`:play_pluck` with low coef).
#    - Lead: Piercing, echoing fiddle/banjo melody (`:play_fm` with high divisor).
# 5. Arrangement: Intro (Bass/Guitar) -> Verse (Drums) -> Chorus (Fiddle).
# ==========================================================

use_bpm 160

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (G Major - Fast, Acoustic, & Driving)
# ==========================================================

# The "Train Beat" Kick. 
# A driving, syncopated march. (4 x's, 4 elements)
s_kick = gen_score("x...x...x.x.x...", [:c4, :c4, :c4, {note: :c4, amp: 0.7}])

# Crisp, organic snare on beats 2 and 4, with a ghost note. (3 x's, 3 elements)
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.9}
])

# Fast, driving 16th hats to simulate the "train" momentum. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.15}
])

# The "Walking" Upright Bass (G Major).
# Plays a driving, root-fifth line. 
# Mid cutoff (80) and short release (0.1) create a warm, percussive "thwack".
# (8 x's, 8 elements)
bass_notes = [:g1, :g1, :d2, :g1, :c2, :c2, :g2, :d2]
bass_data = bass_notes.map { |n| {note: n, cutoff: 80, release: 0.1, amp: 1.0} }
s_bass = gen_score("x.x.x.x.x.x.x.x.", bass_data)

# The "Rolling" Banjo/Guitar (G Major).
# Uses :play_pluck. Plays continuous, rapid 16th notes (a "G-run" arpeggio).
# Microscopic release (0.05) and low coef (0.2) create a sharp, staccato "chuka".
# (16 x's, 16 elements)
guitar_notes = [:g3, :b3, :d4, :g4, :b3, :d4, :g4, :b3, 
                :d4, :g4, :b3, :d4, :g4, :b3, :d4, :g4]
guitar_data = guitar_notes.map { |n| {note: n, amp: 0.6, release: 0.05, coef: 0.2} }
s_guitar = gen_score("xxxxxxxxxxxxxxxx", guitar_data)

# Piercing, "Fiddle/Banjo" Lead (G Major Pentatonic).
# Uses :play_fm with a high divisor (4) and low depth (1) to create a pristine, 
# glassy, piercing tone. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:g5, :a5, :b5, :d6, :c6, :b5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.7, divisor: 4, depth: 1, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Hollar" Vocal Drone (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched UP.
# Long size (0.2) and low density (1) creates a lush, rural background texture. 
# (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :g4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.2, amp: 0.4}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Porch - Just the walking bass, rolling banjo, and drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_pluck, s_guitar, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Drive - Add the fast, driving train beat drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_pluck, s_guitar, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Solo - The piercing fiddle melody drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_pluck, s_guitar, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN ACOUSTIC SIMULATION]
# 
# 1. The Rolling Banjo: Look at `s_guitar`. The `:play_pluck` synth plays on 
#    EVERY single 16th step, mapping out a rapid G-major arpeggio. By using a 
#    microscopic `release` (0.05) and a very low `coef` (0.2), the engine turns 
#    the pluck into a sharp, percussive, staccato "chuka" that perfectly mimics 
#    the rapid, rolling 3-finger roll of a bluegrass banjo.
#
# 2. The Train Beat: Look at `s_kick` and `s_hats`. The kick hits on a 
#    syncopated, driving rhythm, while the hats play continuous 16th notes. 
#    The engine's strict master clock ensures this rigid, mechanical momentum 
#    locks perfectly with the walking bassline, creating the signature "train 
#    beat" groove of bluegrass and country music.
#
# 3. FM as a Fiddle: The `s_lead` sequence uses `divisor: 4` and `depth: 1`. 
#    This gentle harmonic ratio produces a pristine, glassy, sine-like wave 
#    that mimics a fiddle or high-register banjo. Because it's routed through 
#    the global tape echo bus, the rapid notes smear into a soaring, cascading 
#    melody that perfectly anchors the track's high-energy, rural atmosphere.
# ==========================================================
