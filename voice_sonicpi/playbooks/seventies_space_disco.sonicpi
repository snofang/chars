# ==========================================================
# PLAYBOOK: 70s SPACE DISCO / COSMIC DISCO
# (Pioneered by Giorgio Moroder, Cerrone, and Space)
# ==========================================================
# 
# [WHY THIS GENRE?]
# We have explored standard 70s Disco and 80s Italo Disco. Space Disco is the 
# futuristic, sci-fi extension of those genres. It fuses a relentless, driving 
# 4/4 disco beat with massive, sweeping analog string pads, a continuous, 
# octave-jumping 16th-note "Moroder" synth bass, and piercing, echoing FM 
# arpeggios that feel like flying through a neon galaxy.
#
# [THE CAREFULLY DESCRIBED DNA]
# 1. Tempo: 120 BPM. A relentless, driving, and hypnotic pace.
# 2. Harmonic Center: A Minor. Cosmic, lush, and slightly melancholic.
# 3. Rhythmic Skeleton: A standard 4/4 disco beat. Off-beat open hats. The 
#    groove is carried entirely by a continuous 16th-note "galloping" bass.
# 4. Timbral Palette:
#    - Bass: "Moroder" sawtooth, high cutoff, very short release (buzzing churn).
#    - Chords: Lush, slow-attacking "string synth" pads (extreme attack/release).
#    - Lead: Piercing, "cosmic" FM arpeggios (high divisor, mid depth).
#    - Texture: Ethereal, granular "nebula" drone (long grain size, low density).
# 5. Arrangement: Intro (Bass/Pad) -> Verse (Drums) -> Drop (Arpeggios).
# ==========================================================

use_bpm 120

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Cosmic, Lush, & Driving)
# ==========================================================

# Relentless, driving 4/4 disco kick. (4 x's, 1 element)
s_kick = gen_score("x...x...x...x...", [:c4])

# Heavy, organic disco snare strictly on beats 2 and 4. (2 x's, 1 element)
s_snare = gen_score("....x.......x...", [:c4])

# Off-beat open hats to drive the momentum. (4 x's, 4 elements)
s_hats = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}, 
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}
])

# The "Moroder" Bass (A Minor).
# Plays continuous 16th notes, alternating octaves. 
# High cutoff (100) and microscopic release (0.04) create a relentless, 
# buzzing, high-speed churn that drives the track. (16 x's, 16 elements)
bass_notes = [:a1, :a2, :a1, :a2, :a1, :a2, :a1, :a2, 
              :g1, :g2, :g1, :g2, :a1, :a2, :a1, :a2]
bass_data = bass_notes.map { |n| {note: n, cutoff: 100, release: 0.04, amp: 1.0} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Lush, "String Synth" Pad (Am to G).
# Hit on the downbeats. The slow 1.0-beat attack and massive 4.0-beat release 
# blur the chords together into a continuous, cinematic wave. (2 x's, 2 elements)
s_chords = gen_score("x.......x.......", [
  {note: [:a3, :c4, :e4], cutoff: 80, attack: 1.0, release: 4.0, amp: 0.4},
  {note: [:g3, :bb3, :d4], cutoff: 80, attack: 1.0, release: 4.0, amp: 0.4}
])

# Piercing, "Cosmic" FM Arpeggios (A Minor Pentatonic).
# Uses :play_fm with a high divisor (3) and mid depth (3) to create a sharp, 
# glassy, digital tone. Routed through the global tape echo. (6 x's, 6 elements)
lead_notes = [:a5, :e5, :c6, :e5, :g5, :d5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 3, release: 0.2} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# Ethereal, "Nebula" Drone (Granular Synth).
# Using the built-in :ambi_choir sample. Pitched UP.
# Massive size (0.5s) and low density (1) time-stretches the sample into 
# a slow, evolving, celestial background texture. (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :a4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.5, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Orbit - Just the Moroder bass, sweeping strings, and drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Flight - Add the relentless 4/4 disco drums (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Stars - The piercing, cosmic FM arpeggios drop (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN HYPNOTIC MOMENTUM]
# 
# 1. The Moroder Bass: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step, alternating between the low octave (:a1) and the 
#    high octave (:a2). By using a high `cutoff` (100) and a microscopic 
#    `release` (0.04), the engine turns the detuned sawtooth into a relentless, 
#    buzzing churn that perfectly mimics the legendary sequencer basslines of 
#    Giorgio Moroder.
#
# 2. The Cinematic Swell: Look at `s_chords`. The Hashes specify an `attack` 
#    of `1.0` and a `release` of `4.0`. Because the engine reads these 
#    Hashes, the chords don't just hit; they slowly swell into the mix and 
#    fade away over five whole beats, creating a continuous, blurred wave 
#    of warm harmony that perfectly mimics the lush, wide-stereo string pads 
#    of 70s Space Disco.
#
# 3. Echoing Space: The `s_lead` sequence plays a simple A minor pentatonic 
#    melody, but leaves massive gaps (`nil`) between the notes. Because the 
#    engine routes the `:play_fm` synth through the global tape echo bus, 
#    those empty spaces are filled by delay tails, creating a cascading, 
#    shimmering soundscape that feels like looking out over a neon city at 
#    midnight.
# ==========================================================
