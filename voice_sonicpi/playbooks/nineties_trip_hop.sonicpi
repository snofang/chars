# ==========================================================
# PLAYBOOK: 90s TRIP-HOP / BRISTOL SOUND
# Dark, Cinematic, Heavy, Echoing
# ==========================================================
# [WHY THIS GENRE?]
# Trip-Hop (Massive Attack, Portishead) slows the hip‑hop grid
# to 80 BPM, pairing it with massive Reese basslines, dusty
# samples, and haunting vocal fragments. This playbook captures
# that suffocating, cinematic atmosphere – music for empty cities
# at night.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 80 BPM
# Key: A minor (dark, melancholic)
# Rhythm: Laid‑back kick on 1, and of 2, and beat 3; snare on
# 2/4; lazy 16th hats with gaps; sparse bass and chords.
# Timbre: Deep Reese bass (dsaw, long release, low cutoff),
# melancholic chords (blade, long attack/release), Rhodes‑like
# FM melody (divisor 3, depth 1, tape echo), ethereal granular
# vocal drone (ambi_choir, long size), dusty drums.
# Arrangement: Shadows (chords+bass+grain) → Pulse (add drums)
# → Echo (add Rhodes melody).
# ==========================================================

use_bpm 80

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Laid‑back kick: hits on 1, and of 2, and beat 3
s_kick = gen_score("x......x.x......",
  [:c4, {note: :c4, amp: 0.7}, {note: :c4, amp: 1.0}])

# Heavy dusty snare on beats 2 and 4
s_snare = gen_score("....x.......x...", [{note: :c4, amp: 0.8}])

# Lazy echoing hats – sparse, with gaps
s_hats = gen_score("x..x.x..x..x.x..",
  [{note: :c4, amp: 0.2}, {note: :c4, amp: 0.3},
   {note: :c4, amp: 0.2}, {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2}])

# Massive Reese bass – long release, low cutoff
s_bass = gen_score("x.......x.......",
  [{note: :a1, release: 1.5, cutoff: 60},
   {note: :f1, release: 1.5, cutoff: 60}])

# Melancholic sweeping chords – slow attack, long release
s_chords = gen_score("x.......x.......",
  [{note: [:a3, :c4, :e4, :g4], cutoff: 80, release: 2.0, attack: 0.5, amp: 0.6},
   {note: [:f3, :a3, :c4, :e4], cutoff: 80, release: 2.0, attack: 0.5, amp: 0.6}])

# Distant Rhodes‑like melody – routed through tape echo
s_fm = gen_score("....x...x...x...",
  [{note: :e5, amp: 0.5, divisor: 3, depth: 1, release: 1.0},
   {note: :a5, amp: 0.6, divisor: 3, depth: 1, release: 1.0},
   {note: :c5, amp: 0.4, divisor: 3, depth: 1, release: 1.0}])

# Ethereal vocal drone – long grain, low density
s_grain = gen_score("x.......x.......",
  [{note: :a4, buffer: :ambi_choir, pos: 0.4, density: 1, size: 0.3, amp: 0.5},
   {note: :f4, buffer: :ambi_choir, pos: 0.5, density: 1, size: 0.3, amp: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Shadows – Chords, Bass, Grain
  [ [:play_chords, s_chords, 4], [:play_sub, s_bass, 4],
    [:play_grain, s_grain, 4] ],

  # Scene 2: Pulse – Add Drums
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],

  # Scene 3: Echo – Add Rhodes Melody
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_grain, 8], [:play_kick, s_kick, 8],
    [:play_snare, s_snare, 8], [:play_hats, s_hats, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The Reese bass: release 1.5 at 80 BPM creates a booming,
#   suffocating low‑end that carries the melody.
# - Swelling ghosts: attack 0.5 and release 2.0 turn chords
#   into slow, breathing waves of dark harmony.
# - Cavernous space: sparse patterns with gaps let reverb and
#   delay tails ring into the void – the essence of trip‑hop.
# ==========================================================
