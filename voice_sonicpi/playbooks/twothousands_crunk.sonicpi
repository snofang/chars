# ==========================================================
# PLAYBOOK: 2000s CRUNK / SOUTHERN HIP-HOP
# (Pioneered by Lil Jon, Three 6 Mafia, and Ying Yang Twins)
# ==========================================================
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 2000s Crunk. 
# We have explored modern trap and UK drill, but Crunk is the raw, 
# high-energy ancestor of modern Southern hip-hop. Originating in 
# Memphis and Atlanta, it is defined by heavy, half-time 808 kicks, 
# aggressive, rapid synth brass arpeggios, and repetitive, chanting 
# vocal hooks designed to energize a club.
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create that signature "stadium" hip-hop bounce. By using the `:play_fm` 
# synth with extreme depth for brass stabs, and the `:play_sub` for 
# massive, sliding 808 bass, the engine creates a relentless, aggressive 
# atmosphere.
# ==========================================================

use_bpm 105

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (F Minor - Aggressive & Hypnotic)
# ==========================================================

# Heavy, half-time 808 Kick. 
# Hits on step 0, a syncopated hit on the 'a' of 2 (step 7), and beat 3 (step 8).
s_kick  = (ring :c4, nil, nil, nil, nil, nil, nil, {:note => :c4, :amp => 0.8}, {:note => :c4, :amp => 1.2}, nil, nil, nil, nil, nil, nil, nil)

# Sharp, dry clap strictly on beats 2 and 4 (steps 4 and 12).
s_clap  = (ring nil, nil, nil, nil, :c4, nil, nil, nil, nil, nil, nil, nil, :c4, nil, nil, nil)

# Fast, relentless 16th hats with rising amplitudes to simulate a roll.
s_hats  = (ring {:note => :c4, :amp => 0.3}, nil, nil, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.5}, nil, 
           {:note => :c4, :amp => 0.3}, nil, nil, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.4}, {:note => :c4, :amp => 0.5}, nil)

# Massive, sliding 808 Melodic Bass (F Minor).
# Long release (1.0) allows the bass to ring out and carry the hypnotic melody.
s_bass  = (ring {:note => :f2, :release => 1.0}, nil, nil, nil, nil, nil, nil, nil, 
           {:note => :ab2, :release => 1.0}, nil, nil, nil, nil, nil, {:note => :c3, :release => 0.5}, nil)

# Aggressive, rapid Synth Brass Arpeggio (F Minor).
# Uses :play_fm with depth (4) and divisor (2) to create a brassy, buzzing stab.
# Hits on 16th notes to build massive tension.
s_fm    = (ring {:note => :f4, :amp => 0.7, :depth => 4, :divisor => 2, :release => 0.1}, {:note => :ab4, :amp => 0.5, :depth => 4, :divisor => 2, :release => 0.1}, {:note => :c5, :amp => 0.6, :depth => 4, :divisor => 2, :release => 0.1}, {:note => :f5, :amp => 0.7, :depth => 4, :divisor => 2, :release => 0.1}, 
           {:note => :f4, :amp => 0.7, :depth => 4, :divisor => 2, :release => 0.1}, {:note => :ab4, :amp => 0.5, :depth => 4, :divisor => 2, :release => 0.1}, {:note => :eb5, :amp => 0.6, :depth => 4, :divisor => 2, :release => 0.1}, {:note => :c5, :amp => 0.7, :depth => 4, :divisor => 2, :release => 0.1}, 
           {:note => :ab4, :amp => 0.7, :depth => 4, :divisor => 2, :release => 0.1}, {:note => :c5, :amp => 0.5, :depth => 4, :divisor => 2, :release => 0.1}, {:note => :eb5, :amp => 0.6, :depth => 4, :divisor => 2, :release => 0.1}, {:note => :ab5, :amp => 0.7, :depth => 4, :divisor => 2, :release => 0.1}, 
           {:note => :c4, :amp => 0.7, :depth => 4, :divisor => 2, :release => 0.1}, {:note => :eb4, :amp => 0.5, :depth => 4, :divisor => 2, :release => 0.1}, {:note => :g4, :amp => 0.6, :depth => 4, :divisor => 2, :release => 0.1}, {:note => :c5, :amp => 0.7, :depth => 4, :divisor => 2, :release => 0.1})

# Repetitive, pitched-down "Chant" vocal (Granular Synth).
# Medium density, small size = a raw, rhythmic vocal hit.
s_vocal = (ring nil, nil, nil, nil, nil, nil, nil, nil, {:note => :f3, :buffer => :misc_lori, :pos => 0.1, :density => 2, :size => 0.05, :amp => 0.7}, nil, nil, nil, nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Beat - Just the heavy 808s and drums (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_clap, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Tension - Add the rapid synth brass arpeggio (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_fm, 8] ],
    
  # Scene 3: The Anthem - The repetitive vocal chant drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_fm, 8], [:play_grain, s_vocal, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN SOUTHERN ENERGY]
# 
# 1. The 808 Slide: Look at `s_bass`. The `:play_sub` synth is given a 
#    `release` of `1.0` (a whole beat). Because the BPM is 105, that low 
#    F note rings out and decays naturally, creating those massive, 
#    booming low-end melodies that Lil Jon and Three 6 Mafia used to 
#    anchor their tracks.
#
# 2. FM as Brass: The `s_fm` sequence plays on almost every 16th step. 
#    By using `depth: 4` and `divisor: 2`, the FM synth produces a 
#    buzzing, aggressive square wave that perfectly mimics the cheap 
#    rompler brass patches used in 2000s Crunk music. The engine's strict 
#    master clock ensures this rapid arpeggio fires with robotic, 
#    high-energy precision.
#
# 3. The Chant: In Crunk, vocals are rarely melodic; they are percussive. 
#    The `s_vocal` sequence uses the granular engine to chop a vocal into 
#    a raw, repetitive hit. By placing it on beat 3 (step 8) and leaving 
#    the rest of the grid empty, the engine creates the perfect call-and-
#    response structure for a crowd to scream along to.
# ==========================================================
