# ==========================================================
# PLAYBOOK: 90s AMBIENT HOUSE / CHILL OUT ROOM
# (Pioneered by The Orb, The KLF, and Aphex Twin)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Ambient House.
# We have explored high-energy rave genres and minimal techno, but Ambient 
# House is the sound of the 90s "chill out room." It fuses the rhythmic, 
# 4/4 pulse of house music with the lush, evolving textures of ambient music. 
# It relies on a soft, driving beat, deep, round sub-bass, massive, 
# slow-attacking "string synth" chords, and echoing, cosmic FM melodies 
# that feel like floating through a warm, neon nebula.
#
# This playbook perfectly demonstrates the ambient power of the Parameter 
# Hashes. By using massive `attack` and `release` times on the chords, and 
# a massive grain `size` on the granular drone, the engine creates a 
# massive, cinematic, and deeply relaxing atmosphere.
# ==========================================================

use_bpm 100

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Lush, Cosmic, & Deep)
# ==========================================================

# Soft, driving 4/4 kick. (4 x's, 1 element - cycles 4 times)
s_kick = gen_score("x...x...x...x...", [:c4])

# Crisp, organic snare strictly on beats 2 and 4. (2 x's, 1 element - cycles 2 times)
s_snare = gen_score("....x.......x...", [:c4])

# Rigid, driving 8th hats. (8 x's, 2 elements - cycles 4 times)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# Deep, round sub-bass (A Minor).
# Massive release (2.0) and low cutoff (50) create a deep, continuous rumble. (2 x's, 2 elements)
s_bass = gen_score("x.......x.......", [
  {note: :a1, release: 2.0, cutoff: 50, amp: 1.2}, 
  {note: :e1, release: 2.0, cutoff: 50, amp: 1.0}
])

# Massive, "String Synth" Chords (Am9 to Em9).
# Hit on the downbeats. The slow 1.5-beat attack and massive 4.0-beat release 
# blur the chords together into a continuous, cinematic wave. (2 x's, 2 elements)
s_chords = gen_score("x.......x.......", [
  {note: [:a3, :c4, :e4, :g4], cutoff: 80, attack: 1.5, release: 4.0, amp: 0.5},
  {note: [:e3, :g3, :b3, :d4], cutoff: 80, attack: 1.5, release: 4.0, amp: 0.5}
])

# Echoing, "Cosmic" FM Lead (A Minor Pentatonic).
# Uses :play_fm with a high divisor (3) and low depth (2) to create a pristine, 
# glassy tone. Routed through the engine's tape echo. (8 x's, 8 elements)
lead_notes = [:a5, :c6, :e6, :a5, :g5, :e5, :c6, :a5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 3, depth: 2, release: 0.5} }
s_fm = gen_score("x..x..x..x..x..x", lead_data)

# Ethereal, "Nebula" drone (Granular Synth).
# Massive size (0.5s) and low density (1) time-stretches the sample into a 
# slow, evolving background texture that drifts behind the beat. (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :a4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.5, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Orbit - Just the sweeping chords, sub-bass, and nebula drone (4 bars)
  [ [:play_chords, s_chords, 4], [:play_sub, s_bass, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Flight - Add the soft, driving 4/4 drums (8 bars)
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Cosmos - The echoing cosmic FM lead drops (8 bars)
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_fm, s_fm, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN AMBIENT SPACE]
# 
# 1. The Cinematic Swell: Look at `s_chords`. The Hashes specify an `attack` 
#    of `1.5` and a `release` of `4.0`. Because the engine reads these 
#    Hashes, the chords don't just hit; they slowly swell into the mix and 
#    fade away over five whole beats, creating a continuous, blurred wave 
#    of warm harmony that perfectly mimics the lush, wide-stereo string pads 
#    of 90s ambient house.
#
# 2. Ambient Granular Time-Stretching: Look at `s_grain`. The granular engine 
#    is given a massive `size` of `0.5` (500 milliseconds) and a `density` of `1`. 
#    By using sparse, long grains, the engine time-stretches the vocal sample 
#    into a slow, formless drone. It sounds like a distant, melancholic memory 
#    echoing in a massive, warm cavern.
#
# 3. Deep Sub-Weight: Look at `s_bass`. The `:play_sub` synth is given a 
#    massive `release` of `2.0` and a very low `cutoff` of `50`. This creates 
#    a deep, continuous rumble that anchors the erratic, floating textures, 
#    perfectly mimicking the massive, warm sub-bass of The Orb and The KLF.
# ==========================================================
