# ==========================================================
# PLAYBOOK: 90s DREAM TRANCE / MEDITERRANEAN PROGRESSIVE
# (Pioneered by Robert Miles, Gigi D'Agostino, and Mauro Picotto)
# ==========================================================
# 
# [WHY THIS GENRE?]
# Dream Trance relies on a relentless 4/4 beat, off‑beat rolling
# bass, and massive sweeping piano/string chords that wash over
# the grid. This playbook simulates the legendary "Mediterranean
# Piano" sound using high‑cutoff chords that lock with the bass.
# ==========================================================

use_bpm 132

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x...x...x...x...", [:c4])

s_clap  = gen_score("....x.......x...", [:c4])

s_hats  = gen_score("..x...x...x...x.", [
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4}
])

s_bass  = gen_score("..x...x...x...x.", [
  {note: :c2, release: 0.1, cutoff: 90},
  {note: :c2, release: 0.1, cutoff: 90},
  {note: :ab1, release: 0.1, cutoff: 90},
  {note: :g1,  release: 0.1, cutoff: 90}
])

s_chords = gen_score("x..x..x.x..x..x.", [
  {note: [:c3, :eb3, :g3, :c4], cutoff: 110, release: 0.3, amp: 0.6},
  {note: [:c3, :eb3, :g3, :c4], cutoff: 110, release: 0.3, amp: 0.4},
  {note: [:c3, :eb3, :g3, :c4], cutoff: 110, release: 0.3, amp: 0.6},
  {note: [:ab2, :c3, :eb3, :g3], cutoff: 110, release: 0.3, amp: 0.5},
  {note: [:ab2, :c3, :eb3, :g3], cutoff: 110, release: 0.3, amp: 0.4},
  {note: [:g2,  :b2, :d3, :g3], cutoff: 110, release: 0.3, amp: 0.5}
])

s_fm    = gen_score("x...x.x...x..x.x", [
  {note: :c5,  amp: 0.6, divisor: 3, depth: 1, release: 1.0},
  {note: :eb5, amp: 0.5, divisor: 3, depth: 1, release: 1.0},
  {note: :g5,  amp: 0.6, divisor: 3, depth: 1, release: 1.0},
  {note: :ab5, amp: 0.7, divisor: 3, depth: 1, release: 1.0},
  {note: :g5,  amp: 0.5, divisor: 3, depth: 1, release: 1.0},
  {note: :c6,  amp: 0.6, divisor: 3, depth: 1, release: 1.0}
])

s_grain = gen_score("x.......x.......", [
  {note: :c4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.4, amp: 0.5},
  {note: :g3, buffer: :ambi_choir, pos: 0.5, density: 1, size: 0.4, amp: 0.5}
])

# Playbook
playbook = (ring
  # Scene 1: Atmosphere – strings, piano, bass (4 bars)
  [ [:play_grain, s_grain, 4], [:play_chords, s_chords, 4], [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Drive – add relentless 4/4 beat (8 bars)
  [ [:play_grain, s_grain, 8], [:play_chords, s_chords, 8], [:play_sub, s_bass, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8] ],
    
  # Scene 3: The Climax – echoing synth string melody drops (8 bars)
  [ [:play_grain, s_grain, 8], [:play_chords, s_chords, 8], [:play_sub, s_bass, 8],
    [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8],
    [:play_lead, s_fm, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The piano chords use a high cutoff (110) to become bright,
#   emotional stabs that lock with the syncopated off‑beat bass.
# - The bass hits on steps 2,6,10,14 with a short release (0.1)
#   to create a relentless "pump" that drives the track.
# - The granular pad uses long size (0.4) and low density (1)
#   to simulate sweeping string pads that give a cavernous feel.
# ==========================================================
