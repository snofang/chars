# ==========================================================
# PLAYBOOK: 90s BIG BEAT / BREAKBEAT
# (Pioneered by The Chemical Brothers, Fatboy Slim, and The Prodigy)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 90s Big Beat.
# We have explored heavy, rigid 4/4 genres (Techno, Trance) and dark, 
# underground genres (Illbient, IDM). Big Beat is the sound of 90s 
# stadium electronica. It fuses the heavy, syncopated "Amen" breakbeat 
# with massive, distorted analog basslines and aggressive, piercing 
# synth riffs. 
#
# This playbook perfectly demonstrates how to create a massive, swinging 
# rock/dance groove. By pairing a syncopated drum break with a continuous, 
# distorted 16th-note bass and a piercing FM riff, the engine creates a 
# high-energy, chaotic wall of sound that defined 90s festival main stages.
# ==========================================================

use_bpm 125

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (E Minor - Heavy, Distorted, & Swaggering)
# ==========================================================

# The "Big Beat" Kick. 
# Syncopated, hits on step 0, the 'a' of 1 (step 3), the 'and' of 2 (step 6), and beat 3 (step 8).
# (5 x's, 5 elements)
s_kick = gen_score("x..x..x.x..x....", [
  :c4, {note: :c4, amp: 0.8}, :c4, {note: :c4, amp: 1.0}, {note: :c4, amp: 0.6}
])

# Heavy, echoing snare strictly on beats 2 and 4, with a frantic roll on the 'e' and 'and' of 4.
# (4 x's, 4 elements)
s_snare = gen_score("....x.....x.x.xx", [
  :c4, {note: :c4, amp: 0.4}, :c4, {note: :c4, amp: 0.6}
])

# Swung, rolling 16th hats to drive the momentum.
# (8 x's, 2 elements - cycles 4 times)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Distorted Chemical" Bass (E Minor).
# Plays continuous 16th notes, alternating octaves. 
# Extreme cutoff (120) and short release (0.1) create a grinding, distorted churn.
# (16 x's, 16 elements)
bass_cycle = [:e1, :e1, :e2, :e1, :e1, :e1, :e2, :e1, 
              :e1, :e1, :e2, :e1, :g1, :g1, :g2, :g1]
bass_data = bass_cycle.map { |n| {note: n, cutoff: 120, release: 0.1, amp: 1.2} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Stark, "Acid House" chord stabs (Em to G).
# Hit strictly on the off-beats (steps 2, 6, 10, 14). High cutoff (110) 
# and short release (0.2) create a sharp, festival-sized wall of sound.
# (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:e3, :g3, :b3], cutoff: 110, release: 0.2, amp: 0.6},
  {note: [:e3, :g3, :b3], cutoff: 110, release: 0.2, amp: 0.6},
  {note: [:g3, :b3, :d4], cutoff: 110, release: 0.2, amp: 0.6},
  {note: [:g3, :b3, :d4], cutoff: 110, release: 0.2, amp: 0.6}
])

# Piercing, "Prodigy" FM Rave Riff (E Minor Pentatonic).
# Uses :play_fm with a low divisor (2) and extreme depth (5) to create a 
# sharp, buzzy square wave that cuts through the heavy bass and drums.
# (6 x's, 6 elements)
lead_notes = [:e4, :b4, :e5, :d5, :b4, :g4]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 5, release: 0.1} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# Pitched-down, aggressive vocal grunt (Granular Synth).
# Pitched DOWN to :e3. High density, small size = a sharp, percussive vocal hit.
# (1 x, 1 element)
s_vocal = gen_score("........x.......", [
  {note: :e3, buffer: :misc_lori, pos: 0.2, density: 3, size: 0.04, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the breakbeat, distorted bass, and hats (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: The Vibe - Add the acid chord stabs and vocal grunts (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Drop - The piercing rave FM riff drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN AGGRESSION]
# 
# 1. The Distorted Churn: Look at `s_bass`. The `:play_sub` synth plays on 
#    EVERY single 16th step, alternating octaves (:e1, :e2). By using an 
#    extreme `cutoff` (120) and a very short `release` (0.1), the engine 
#    turns the detuned sawtooth into a relentless, grinding, distorted wall 
#    of sound that perfectly mimics the heavy analog basslines of The 
#    Chemical Brothers.
#
# 2. The Syncopated Break: Look at `s_kick` and `s_snare`. They completely 
#    avoid landing on the same beats. The engine's strict master clock ensures 
#    these complex, overlapping hits land with the precision of a sampler 
#    block, creating a heavy, swaggering rock/dance groove that feels massive.
#
# 3. Extreme FM Aggression: The `s_lead` sequence uses `divisor: 2` and an 
#    extreme `depth` of `5`. This harsh harmonic ratio forces the FM synth 
#    to produce a piercing, aggressive square wave that cuts through the 
#    heavy bass and drums, perfectly mimicking the iconic rave riffs of 
#    90s acts like The Prodigy.
# ==========================================================
