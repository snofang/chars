use_bpm 120

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Icy & Driving)
# ==========================================================

# Rigid 4-on-the-floor drum machine kick.
s_kick  = (ring :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil, :c4, nil, nil, nil)

# Stark, dry clap strictly on beats 2 and 4 (steps 4 and 12).
s_clap  = (ring nil, nil, nil, nil, :c4, nil, nil, nil, nil, nil, nil, nil, :c4, nil, nil, nil)

# Rigid 16th-note closed hats.
s_hats  = (ring {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, 
           {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, 
           {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, 
           {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2}, {:note => :c4, :amp => 0.3}, {:note => :c4, :amp => 0.2})

# The "Moroder" Bass. 
# Plays on EVERY 16th step, alternating octaves to create a hypnotic, rolling pulse.
s_bass  = (ring :a2, :a2, :a3, :a2, :a2, :a2, :a3, :a2, 
           :c3, :c3, :c4, :c3, :c3, :c3, :c4, :c3)

# Icy, staccato synth stabs (A Minor).
# Hits on the off-beats (steps 2, 6, 10, 14) to leave room for the bass.
s_chords= (ring nil, nil, [:a3, :c4, :e4], nil, nil, nil, [:a3, :c4, :e4], nil, 
           nil, nil, [:g3, :bb3, :d4], nil, nil, nil, [:g3, :bb3, :d4], nil)

# High-pitched, echoing arpeggio lead (A Minor).
# Routed through the engine's tape echo for that classic space echo smear.
s_lead  = (ring :a5, nil, :e5, :c5, :a5, nil, :e5, :c5, 
           :g5, nil, :d5, :bb4, :g5, nil, :d5, :bb4)

# Pitched-down, robotic vocoder vocal stab (Granular Synth)
s_vocal = (ring nil, nil, nil, nil, nil, nil, nil, nil, 
           {:note => :a3, :buffer => :misc_lori, :pos => 0.1, :density => 3, :size => 0.04, :amp => 0.6}, nil, nil, nil, 
           nil, nil, nil, nil)

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: Just the rigid drums and relentless Moroder bass (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_clap, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4] ],
  
  # Scene 2: Add the icy off-beat chord stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The echoing arpeggio and vocoder vocal drop (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_clap, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], 
    [:play_lead, s_lead, 8], [:play_grain, s_vocal, 4] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
