# ==========================================================
# PLAYBOOK: 16-BIT JRPG SOUNDTRACK / SNES RPG (DRY)
# (Pioneered by Nobuo Uematsu, Yasunori Mitsuda, and Yoko Shimomura)
# ==========================================================

use_bpm 110

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (D Minor - Epic, Nostalgic, & Melodic)
# ==========================================================

# Syncopated orchestral march.
s_kick = gen_score("......x...x.....", [
  {note: :c4, amp: 0.8}, {note: :c4, amp: 1.0}, {note: :c4, amp: 0.6}
])

# Heavy, orchestral snare on beats 2 and 4.
s_snare = gen_score("....x.......x...", [:c4])

# Subtle, ticking 8th hats.
s_hats = gen_score("x.x.x.x.x.x.x.x.", [{note: :c4, amp: 0.2}, {note: :c4, amp: 0.15}])

# The "Acoustic Cello" Bass (D Minor).
# DRY: Array of hashes mapped with default opts.
bass_notes = [:d2, :d2, :a1, :bb1, :a1, :a1]
bass_data = bass_notes.map { |n| {note: n, release: 0.2, cutoff: 80, amp: 0.9} }
s_bass = gen_score("x...x.x...x.x...", bass_data)

# Massive, slow-attacking "String Section" Chords.
s_chords = gen_score("x.......x.......", [
  {note: [:d3, :f3, :a3], cutoff: 100, attack: 0.5, release: 2.0, amp: 0.6},
  {note: [:bb2, :d3, :f3], cutoff: 100, attack: 0.5, release: 2.0, amp: 0.6}
])

# The "Crystal Harp" Arpeggio (D Minor).
# DRY: 16 rapid notes generated and merged with FM default opts.
harp_notes = [:d4, :a4, :d5, :f5, :d5, :a4, :f5, :d5, :bb3, :f4, :bb4, :d5, :bb4, :f4, :d5, :bb4]
harp_data = harp_notes.map { |n| {note: n, amp: 0.5, divisor: 3, depth: 2, release: 0.1} }
s_fm = gen_score("xxxxxxxxxxxxxxxx", harp_data)

# Soaring, "Brass/Horn" Melody (D Minor Pentatonic).
lead_notes = [
  {note: :d5, release: 0.5}, {note: :f5, release: 0.5}, {note: :a5, release: 0.8}, 
  {note: :g5, release: 0.5}, {note: :f5, release: 0.5}
]
lead_data = lead_notes.map { |n| n.merge({amp: 0.6}) }
s_lead = gen_score("x..x..x...x.x...", lead_data)

# Ethereal, "Choir/Angel" pad (Granular Synth).
s_grain = gen_score("x.......x.......", [
  {note: :d4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.3, amp: 0.5},
  {note: :a4, buffer: :ambi_choir, pos: 0.5, density: 1, size: 0.3, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  [ [:play_chords, s_chords, 4], [:play_sub, s_bass, 4], [:play_fm, s_fm, 4], [:play_grain, s_grain, 4] ],
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], [:play_fm, s_fm, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8] ],
  [ [:play_chords, s_chords, 8], [:play_sub, s_bass, 8], [:play_fm, s_fm, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)
