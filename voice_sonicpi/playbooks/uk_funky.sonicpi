# ==========================================================
# PLAYBOOK: UK FUNKY
# Rhythmic, Bouncy, Tribal Syncopation
# ==========================================================
# [WHY THIS GENRE?]
# UK Funky (Crazy Cousinz, Donae'O) fuses the bouncy 4/4 grid
# of house music with heavy syncopation from Soca, Dancehall,
# and West African percussion. This playbook captures that
# vibrant, rhythmic, tribal energy.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 130 BPM
# Key: A minor (rhythmic, vibrant)
# Rhythm: Broken 2‑step kick (1, beat 3, 'a' of 3), syncopated
# FM bongos, bouncing 16th hats, wobble bass on every 16th,
# syncopated vocal chants.
# Timbre: Punchy kick (bd_haus with accents), FM bongos
# (divisor 4, short release), bouncing hats (cymbal_closed
# with velocity layers), wobble bass (dsaw, alternating cutoff
# for LFO sim), granular vocal chants (ambi_choir, short grains).
# Arrangement: Groove (drums+bongos) → Vibe (add wobble bass)
# → Drop (add vocal chants).
# ==========================================================

use_bpm 130

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# Scores

# Funky broken kick: hits on 1, beat 3, and 'a' of 3
s_kick = gen_score("x........x..x...",
  [:c4, {note: :c4, amp: 1.0}, {note: :c4, amp: 0.7}])

# FM bongos – hollow woodblock/conga sound
bongo_data = [
  {note: :e4, amp: 0.6, divisor: 4, depth: 1, release: 0.05},
  {note: :a4, amp: 0.7, divisor: 4, depth: 1, release: 0.05},
  {note: :e4, amp: 0.6, divisor: 4, depth: 1, release: 0.05},
  {note: :a4, amp: 0.5, divisor: 4, depth: 1, release: 0.05},
  {note: :e4, amp: 0.6, divisor: 4, depth: 1, release: 0.05},
  {note: :a4, amp: 0.7, divisor: 4, depth: 1, release: 0.05},
  {note: :e4, amp: 0.6, divisor: 4, depth: 1, release: 0.05},
  {note: :c5, amp: 0.8, divisor: 4, depth: 1, release: 0.05},
  {note: :a4, amp: 0.6, divisor: 4, depth: 1, release: 0.05}
]
s_bongos = gen_score("x.x.x.xx.x.x.xx.x", bongo_data)

# Bouncing syncopated 16th hats
s_hats = gen_score("x.x.x.x.x.x.x.x.",
  [{note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
   {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2}])

# Wobble bass – cutoff alternates 70/120 on every step (LFO sim)
bass_data = [
  {note: :a1, cutoff: 70}, {note: :a1, cutoff: 120},
  {note: :a1, cutoff: 70}, {note: :a1, cutoff: 120},
  {note: :a1, cutoff: 70}, {note: :a1, cutoff: 120},
  {note: :a1, cutoff: 70}, {note: :a1, cutoff: 120},
  {note: :g1, cutoff: 70}, {note: :g1, cutoff: 120},
  {note: :g1, cutoff: 70}, {note: :g1, cutoff: 120},
  {note: :c2, cutoff: 70}, {note: :c2, cutoff: 120},
  {note: :c2, cutoff: 70}, {note: :c2, cutoff: 120}
]
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Syncopated vocal chants – pitched vocal stutters
s_vocal = gen_score("....x.....x...x.",
  [{note: :a4, buffer: :ambi_choir, pos: 0.1, density: 2, size: 0.04, amp: 0.6},
   {note: :c5, buffer: :ambi_choir, pos: 0.3, density: 2, size: 0.04, amp: 0.6},
   {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 2, size: 0.04, amp: 0.6}])

# Playbook
playbook = (ring
  # Scene 1: Groove – Kick, Hats, Bongos
  [ [:play_kick, s_kick, 4], [:play_hats, s_hats, 4],
    [:play_fm, s_bongos, 4] ],

  # Scene 2: Vibe – Add Wobble Bass
  [ [:play_kick, s_kick, 8], [:play_hats, s_hats, 8],
    [:play_fm, s_bongos, 8], [:play_sub, s_bass, 8] ],

  # Scene 3: Drop – Add Vocal Chants
  [ [:play_kick, s_kick, 8], [:play_hats, s_hats, 8],
    [:play_fm, s_bongos, 8], [:play_sub, s_bass, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - FM as bongos: divisor 4 and release 0.05 create a hollow,
#   woody "thwack" – the engine turns FM into organic percussion.
# - Data‑driven LFO wobble: alternating cutoff (70/120) on
#   every 16th step simulates a fast filter wobble without
#   needing a dedicated LFO oscillator.
# - The Funky bounce: kick on steps 0, 8, 11 creates a
#   staggered, syncopated groove that pushes hips rather
#   than jumps – the engine's grid locks it with precision.
# ==========================================================
