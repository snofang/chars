# ==========================================================
# PLAYBOOK: 90s CHICAGO GHETTO HOUSE / JACK TRAX
# (Pioneered by DJ Funk, DJ Deeon, and DJ Slugo)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# Ghetto House is the raw, unpolished sound of 90s Chicago's
# Dance Mania records. It uses syncopated kicks, relentless
# off‑beat bass, and percussive vocal chants to create a
# jacking groove that feels like a dark warehouse party.
# ==========================================================

use_bpm 132

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x..x..x.x..x..x.", [
  :c4,
  {note: :c4, amp: 0.6},
  :c4,
  :c4,
  {note: :c4, amp: 0.6},
  :c4
])

s_clap  = gen_score("....x.......x...", [:c4])

s_hats  = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2}
])

s_bass  = gen_score("..x...x...x...x.", [
  {note: :f1, release: 0.1, cutoff: 100},
  {note: :f1, release: 0.1, cutoff: 100},
  {note: :ab1, release: 0.1, cutoff: 100},
  {note: :c2, release: 0.1, cutoff: 100}
])

s_chords = gen_score("..x...x...x...x.", [
  [:f3, :ab3, :c4],
  [:f3, :ab3, :c4],
  [:ab3, :c4, :eb4],
  [:c3, :eb3, :g3]
])

s_fm    = gen_score("x..x.x..x..x.x..", [
  {note: :f5, amp: 0.6, divisor: 2, depth: 3, release: 0.05},
  {note: :f5, amp: 0.6, divisor: 2, depth: 3, release: 0.05},
  {note: :ab5, amp: 0.5, divisor: 2, depth: 3, release: 0.05},
  {note: :f5, amp: 0.6, divisor: 2, depth: 3, release: 0.05},
  {note: :f5, amp: 0.6, divisor: 2, depth: 3, release: 0.05},
  {note: :g5, amp: 0.5, divisor: 2, depth: 3, release: 0.05}
])

s_vocal = gen_score("x...x...x...x...", [
  {note: :f3, buffer: :ambi_choir, pos: 0.1, density: 2, size: 0.04, amp: 0.7},
  {note: :f3, buffer: :ambi_choir, pos: 0.1, density: 2, size: 0.04, amp: 0.7},
  {note: :ab3, buffer: :ambi_choir, pos: 0.3, density: 2, size: 0.04, amp: 0.7},
  {note: :c4, buffer: :ambi_choir, pos: 0.5, density: 2, size: 0.04, amp: 0.7}
])

# Playbook
playbook = (ring
  # Scene 1: The Jack - kick, off-beat bass, hats (4 bars)
  [ [:play_kick, s_kick, 4], [:play_sub, s_bass, 4], [:play_hats, s_hats, 4] ],
  
  # Scene 2: The Vibe - add claps and chord stabs (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8], 
    [:play_snare, s_clap, 8], [:play_chords, s_chords, 8] ],
    
  # Scene 3: The Drop - repetitive FM blips and vocal chants (8 bars)
  [ [:play_kick, s_kick, 8], [:play_sub, s_bass, 8], [:play_hats, s_hats, 8], 
    [:play_snare, s_clap, 8], [:play_chords, s_chords, 8], 
    [:play_lead, s_fm, 8], [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - The jacking kick syncopation (steps 0,3,6,8,11) creates
#   a lopsided groove that forces the body to move.
# - The bass uses a wide‑open cutoff (100) and short release
#   for a buzzing, aggressive "thwack" that cuts through.
# - The granulated vocal is pitched down and used as a sharp
#   percussive hit, locking perfectly with the off‑beat rhythm.
# ==========================================================
