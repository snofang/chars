# ==========================================================
# PLAYBOOK: GRITTY D MINOR WALKING BASS & PLUCK
# ==========================================================
# [WHY THIS GENRE?]
# Slow, swung groove with a jazzy walking bass and melancholic
# plucked melody. Sparse drums create a dark, atmospheric feel.
# ==========================================================

use_bpm 88

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores
s_kick  = gen_score("x.....x...x.....", [:c4])   # steps 0, 6, 10
s_snare = gen_score("....x.......x...", [:c4])   # steps 4, 12
s_hats  = gen_score("x.x.x.x.x.x.x.xx", [
  :c4, :c4, :c4, :c4, :c4, :c4, :c4, :c4, {note: :c4, amp: 0.5}
])
s_bass  = gen_score("x..x..x...x...x.", [:d2, :f2, :a2, :g2, :f2])
s_pluck = gen_score("x...x...x...x...", [:d4, :f4, :a4, :g4])

# Playbook
playbook = (ring
  # Scene 1: Drums only (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4] ],
  
  # Scene 2: Add bass (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], 
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8] ],
    
  # Scene 3: Add plucked melody (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], 
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8], 
    [:play_pluck, s_pluck, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - Kick on 0, 6, 10; snare on 4, 12 – a classic half‑time hip‑hop grid.
# - Hi‑hats roll steadily with a softened accent on the last 16th.
# - Bass walks D‑F‑A‑G‑F while the pluck echoes the same root notes.
# ==========================================================
