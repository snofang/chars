# ==========================================================
# PLAYBOOK: 2000s RHYTHM GAME / BEMANI ARCADE STYLE
# (Pioneered by Naoki Maeda, DJ Taka, and RevenG)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 2000s Rhythm Game.
# We have explored Arcade Fighting Games and Sci-Fi Racers, but the Bemani 
# rhythm game genre (Dance Dance Revolution, Beatmania) is the absolute 
# pinnacle of 16-step grid precision. These tracks were literally designed 
# to be perfectly quantized so players could step to them on a metal pad. 
# They rely on a frantic 150 BPM tempo, relentless, driving 16th-note bass, 
# massive "happy hardcore" supersaw stabs, and manic, continuous 16th-note 
# FM arpeggios that feel like a blazing fast arrow stream.
#
# This playbook perfectly demonstrates how to push the master clock to a high 
# tempo while maintaining absolute mathematical precision. By locking a 
# continuous 16th-note bassline and lead to a syncopated drum pattern, the 
# engine creates a massive, adrenaline-fueled arcade atmosphere.
# ==========================================================

use_bpm 150

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Frantic, Precise, & High-Energy)
# ==========================================================

# The "DDR" Kick. 
# A syncopated, jumping dance pattern. (9 x's, 9 elements)
s_kick = gen_score("x.x...x.x.x...x.", [
  :c4, {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.6}, :c4, 
  {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.8}, :c4
])

# Heavy, dry snare on beats 2 and 4, with a 16th roll at the end. (4 x's, 4 elements)
s_snare = gen_score("....x.......x.xx", [
  :c4, :c4, {note: :c4, amp: 0.5}, {note: :c4, amp: 0.7}
])

# Relentless, continuous 16th hats to drive the momentum. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}
])

# The "Happy Hardcore" Bass (A Minor).
# Plays continuous 16th notes, alternating octaves. 
# High cutoff (110) and microscopic release (0.08) create a relentless, 
# bouncy, distorted churn.
bass_cycle = [:a1, :a2, :a1, :a2, :a1, :a2, :a1, :a2, 
              :f1, :f2, :f1, :f2, :g1, :g2, :g1, :g2]
bass_data = bass_cycle.map { |n| {note: n, cutoff: 110, release: 0.08, amp: 1.0} }
s_bass = gen_score("xxxxxxxxxxxxxxxx", bass_data)

# Massive, "Supersaw" Chord Stabs (Am to F to G).
# Hit strictly on the off-beats. High cutoff (110) and short release (0.15) 
# create a sharp, piercing wall of sound. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:a3, :c4, :e4], cutoff: 110, release: 0.15, amp: 0.6},
  {note: [:a3, :c4, :e4], cutoff: 110, release: 0.15, amp: 0.6},
  {note: [:f3, :a3, :c4], cutoff: 110, release: 0.15, amp: 0.6},
  {note: [:g3, :bb3, :d4], cutoff: 110, release: 0.15, amp: 0.6}
])

# Manic, "Arrow Stream" FM Lead (A Minor).
# Uses :play_fm with a low divisor (2) and extreme depth (4) to create a 
# piercing, buzzy square wave. Plays a rapid, continuous 16th-note melody.
lead_notes = [:a5, :e5, :c6, :e5, :a5, :e5, :c6, :e5, 
              :f5, :c5, :a5, :c5, :g5, :d5, :b5, :d5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 2, depth: 4, release: 0.06} }
s_lead = gen_score("xxxxxxxxxxxxxxxx", lead_data)

# Pitched-up, "Rave" vocal stutter. (2 x's, 2 elements)
s_vocal = gen_score("....x.......x...", [
  {note: :a4, buffer: :ambi_choir, pos: 0.1, density: 3, size: 0.04, amp: 0.6},
  {note: :c5, buffer: :ambi_choir, pos: 0.3, density: 3, size: 0.04, amp: 0.6}
])

# Ethereal, "Starlight" drone (Granular Synth).
# Long size (0.4) and low density (1) creates a slow, evolving background 
# texture that drifts behind the frantic beat. (1 x, 1 element)
s_grain = gen_score("x...............", [
  {note: :a4, buffer: :ambi_choir, pos: 0.2, density: 1, size: 0.4, amp: 0.5}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Menu - Just the relentless bass, supersaw stabs, and drone (4 bars)
  [ [:play_sub, s_bass, 4], [:play_chords, s_chords, 4], [:play_grain, s_grain, 4] ],
  
  # Scene 2: The Stage - Add the syncopated DDR drums and vocals (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Climax - The manic arrow stream FM lead drops (8 bars)
  [ [:play_sub, s_bass, 8], [:play_chords, s_chords, 8], [:play_grain, s_grain, 8], 
    [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_grain, s_vocal, 8], [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN ARCADE PRECISION]
# 
# 1. The Arrow Stream: Look at `s_lead`. The `:play_fm` synth plays on 
#    EVERY single 16th step, mapping out a rapid, continuous melody. By using 
#    a high `cutoff` (110) and a microscopic `release` (0.06), the engine 
#    creates a relentless, staccato stream of notes that perfectly mimics the 
#    blistering, high-speed synth solos of 2000s rhythm game soundtracks.
#
# 2. Algorithmic Octave Bass: Look at `s_bass`. Instead of typing 16 
#    repetitive Hashes, we define an array `bass_cycle` that alternates 
#    between the low octave (:a1) and the high octave (:a2). We then use 
#    `.map` to inject the default parameters into every step. This creates 
#    the relentless, driving "gallop" that defines the genre.
#
# 3. Syncopated DDR Groove: Look at `s_kick`. It completely avoids landing 
#    on a standard 4/4 pulse. By hitting on syncopated, jumping steps 
#    (0, 2, 6, 8, 10, 14), the engine creates a bouncy, physical groove 
#    that feels like a player's feet stomping on a metal dance pad.
# ==========================================================
