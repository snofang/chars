# ==========================================================
# PLAYBOOK: PURPLE MUSIC / WONKY BASS
# Retro-Futuristic Fusion: 16‑Bit FM Chords + Wobbling Analog Bass
# ==========================================================
# [WHY THIS GENRE?]
# Purple Music (Joker, Gemmy) fuses heavy half‑time dubstep with
# bright Sega Genesis‑style FM chords and deep, LFO‑wobbled bass.
# This playbook captures that retro‑futuristic contrast.
#
# [DNA: Tempo, Key, Rhythm, Timbre, Arrangement]
# Tempo: 85 BPM
# Key: G minor
# Rhythm: Half‑time kick with ghost hits, snare on beat 3,
# syncopated trap hats.
# Timbre: Deep sub‑bass with filter wobble (dsaw, alternating cutoff),
# glassy FM chords (divisor 3, depth 2), buzzy FM lead (divisor 2,
# depth 3), granular vocal stutter.
# Arrangement: Wobble (drums+bass) → 16‑Bit Vibe (add FM chords)
# → Drop (add lead + vocal chops).
# ==========================================================

use_bpm 85

eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi"

# Scores

# Half‑time kick with ghost on the 'a' of 2 and beat 3
s_kick = gen_score("x......x..x.....",
  [{note: :c4, amp: 1.0}, {note: :c4, amp: 0.6}, {note: :c4, amp: 1.0}])

# Snare strictly on beat 3
s_snare = gen_score("..........x.....",
  [{note: :c4, amp: 1.0}])

# Syncopated trap hats with velocity accents
hat_data = [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.2},
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.4},
  {note: :c4, amp: 0.5}, {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.2}, {note: :c4, amp: 0.3},
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.5}
]
s_hats = gen_score("x.x.xxx.x.x.xxx.", hat_data)

# Wobble bass – cutoff alternates between 60 and 130 for LFO effect
bass_data = [
  {note: :g1, cutoff: 60, release: 0.3},
  {note: :g1, cutoff: 130, release: 0.3},
  {note: :bb1, cutoff: 70, release: 0.3},
  {note: :g1, cutoff: 60, release: 0.3},
  {note: :d2, cutoff: 120, release: 0.3},
  {note: :eb1, cutoff: 80, release: 0.3}
]
s_bass = gen_score("x..x..x.x..x..x.", bass_data)

# 16‑Bit FM chords – glassy, retro video game sound
chord_data = [
  {note: [:g3, :bb3, :d4, :f4], amp: 0.6, divisor: 3, depth: 2, release: 0.4},
  {note: [:bb3, :d4, :f4, :a4], amp: 0.6, divisor: 3, depth: 2, release: 0.4}
]
s_chords = gen_score("x.......x.......", chord_data)

# Buzzy square‑wave lead – routed through tape echo
lead_data = [
  {note: :g5, amp: 0.6, divisor: 2, depth: 3, release: 0.2},
  {note: :bb5, amp: 0.5, divisor: 2, depth: 3, release: 0.2},
  {note: :d6, amp: 0.6, divisor: 2, depth: 3, release: 0.2},
  {note: :c6, amp: 0.5, divisor: 2, depth: 3, release: 0.2}
]
s_lead = gen_score("x..x...x....x...", lead_data)

# Sugary vocal stutter – granular chop
s_vocal = gen_score("....x.....x.....",
  [{note: :g4, buffer: :ambi_choir, pos: 0.2, density: 2, size: 0.04, amp: 0.5},
   {note: :bb4, buffer: :ambi_choir, pos: 0.4, density: 2, size: 0.04, amp: 0.5}])

# Playbook
playbook = (ring
  # Scene 1: Wobble – Drums + Bass
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4],
    [:play_hats, s_hats, 4], [:play_sub, s_bass, 4] ],

  # Scene 2: 16‑Bit Vibe – Add FM Chords
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_fm, s_chords, 8] ],

  # Scene 3: Drop – Add Lead and Vocal Chops
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8],
    [:play_hats, s_hats, 8], [:play_sub, s_bass, 8],
    [:play_fm, s_chords, 8], [:play_fm, s_lead, 8],
    [:play_grain, s_vocal, 8] ]
)

start_engine(playbook)

# ==========================================================
# MASTERCLASS INSIGHTS
# ==========================================================
# - FM as a sound chip: divisor 3 and depth 2 on s_chords
#   create the glassy, digital chords of the Sega Genesis.
# - LFO wobble without an LFO: alternating cutoff values
#   (60 ↔ 130) on s_bass simulate a fast filter wobble.
# - Contrast: deep analog sub‑bass vs. bright digital FM
#   chords – the engine locks them together with precision.
# ==========================================================
