# ==========================================================
# PLAYBOOK: 70s SAMBA ROCK / BRAZILIAN FUNK
# (Pioneered by Tim Maia, Jorge Ben, and Banda Black Rio)
# ========================================================== 
# 
# [WHY THIS GENRE?]
# If I were to select the next playbook, I would choose 70s Samba Rock.
# We have explored Disco and Afrobeat, but Samba Rock is the sound of 
# 1970s Rio de Janeiro. It fuses the heavy, syncopated grooves of American 
# funk and soul with the intricate, continuous 16th-note tamborim patterns 
# of Brazilian samba. It relies on a driving, live 4/4 beat, a deep, 
# melodic walking bass, tight, staccato horn stabs, and a continuous, 
# bouncy shaker that feels like a packed Carnival street party.
#
# This playbook perfectly demonstrates how to use the 16-step grid to 
# create a highly syncopated, live-band funk groove. By using the 
# `:play_fm` synth to simulate a brass section and the `:play_sub` synth 
# to create a deep, walking bass, the engine creates a massive, joyful, 
# and deeply infectious Brazilian atmosphere.
# ==========================================================

use_bpm 105

# ==========================================================
# 1. REQUIRE ENGINE
# ==========================================================
eval_file "~/develop/chars/voice_sonicpi/engine.sonicpi" # Update your path!

# ==========================================================
# 2. THE SCORES (A Minor - Funky, Bouncy, & Live)
# ==========================================================

# The "Samba Rock" Kick. 
# A driving, syncopated funk march. (4 x's, 4 elements)
s_kick = gen_score("x..x..x.x..x....", [
  :c4, {note: :c4, amp: 0.7}, :c4, {note: :c4, amp: 0.6}
])

# Crisp, live snare on beats 2 and 4, with a syncopated ghost note. (3 x's, 3 elements)
s_snare = gen_score("....x.....x.x...", [
  :c4, {note: :c4, amp: 0.3}, {note: :c4, amp: 0.9}
])

# The "Tamborim" Shaker.
# Plays continuous 16th notes with heavy amplitude manipulation to simulate 
# the rapid, syncopated shaking of a Brazilian tamborim. (8 x's, 2 elements)
s_hats = gen_score("x.x.x.x.x.x.x.x.", [
  {note: :c4, amp: 0.3}, {note: :c4, amp: 0.15}, 
  {note: :c4, amp: 0.4}, {note: :c4, amp: 0.2}
])

# The "Walking" Bass (A Minor).
# Plays a syncopated, melodic line. Mid cutoff (70) and medium release (0.2) 
# to create a warm, bouncy undercurrent. (4 x's, 4 elements)
s_bass = gen_score("x.....x.x.....x.", [
  {note: :a1, release: 0.2, cutoff: 70, amp: 1.2}, 
  {note: :c2, release: 0.2, cutoff: 70, amp: 1.0}, 
  {note: :e2, release: 0.2, cutoff: 70, amp: 1.0}, 
  {note: :d2, release: 0.2, cutoff: 70, amp: 1.0}
])

# Tight, "Horn Section" Stabs (Am to Dm).
# Uses :play_fm with a low divisor (2) and mid depth (3) to create a warm, 
# brassy staccato hit that mimics a live horn section. (4 x's, 4 elements)
s_chords = gen_score("..x...x...x...x.", [
  {note: [:a3, :c4, :e4], divisor: 2, depth: 3, release: 0.1, amp: 0.6},
  {note: [:a3, :c4, :e4], divisor: 2, depth: 3, release: 0.1, amp: 0.6},
  {note: [:d3, :f3, :a3], divisor: 2, depth: 3, release: 0.1, amp: 0.6},
  {note: [:d3, :f3, :a3], divisor: 2, depth: 3, release: 0.1, amp: 0.6}
])

# Piercing, "Clavinet" Lead (A Minor Pentatonic).
# Uses :play_fm with a high divisor (4) and low depth (2) to create a sharp, 
# clean pluck. Routed through the engine's tape echo. (6 x's, 6 elements)
lead_notes = [:a5, :e5, :c6, :a5, :g5, :e5]
lead_data = lead_notes.map { |n| {note: n, amp: 0.6, divisor: 4, depth: 2, release: 0.15} }
s_lead = gen_score("x..x..x..x..x..x", lead_data)

# "Crowd" Vocal Chant (Granular Synth).
# Long size (0.1) and low density (1) creates a raw, repetitive vocal hit 
# that mimics a crowd singing along. (1 x, 1 element)
s_vocal = gen_score("........x.......", [
  {note: :a3, buffer: :misc_lori, pos: 0.2, density: 1, size: 0.1, amp: 0.7}
])

# ==========================================================
# 3. THE PLAYBOOK
# ==========================================================
playbook = (ring
  # Scene 1: The Groove - Just the syncopated drums, walking bass, and horns (4 bars)
  [ [:play_kick, s_kick, 4], [:play_snare, s_snare, 4], [:play_hats, s_hats, 4], 
    [:play_sub, s_bass, 4], [:play_fm, s_chords, 4] ],
  
  # Scene 2: The Vibe - Add the crowd vocals (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8] ],
    
  # Scene 3: The Solo - The piercing clavinet melody drops (8 bars)
  [ [:play_kick, s_kick, 8], [:play_snare, s_snare, 8], [:play_hats, s_hats, 8], 
    [:play_sub, s_bass, 8], [:play_fm, s_chords, 8], [:play_grain, s_vocal, 8], 
    [:play_lead, s_lead, 8] ]
)

# ==========================================================
# 4. RUN
# ==========================================================
start_engine(playbook)

# ==========================================================
# [WHAT MAKES THIS PLAYBOOK A MASTERCLASS IN BRAZILIAN FUNK]
# 
# 1. FM as a Horn Section: Look at `s_chords`. The `:play_fm` synth is given 
#    a `divisor` of `2` and a `depth` of `3`, with a microscopic `release` 
#    (0.1). This forces the FM synth to produce a warm, brassy, staccato 
#    "hit" that perfectly mimics a live horn section locking in with the 
#    rhythm section on the off-beats.
#
# 2. The Tamborim Illusion: Look at `s_hats`. The hats play continuous 16th 
#    notes, but the amplitudes swing wildly between 0.15, 0.3, and 0.4. By 
#    emphasizing the off-beats, the engine simulates the rapid, syncopated 
#    shaking of a Brazilian tamborim, creating a relentless, bouncy wall of 
#    high-frequency energy that drives the track forward.
#
# 3. The Walking Bass: Look at `s_bass`. The `:play_sub` synth plays a 
#    syncopated, melodic line. By using a mid-range `cutoff` (70) and a 
#    medium `release` (0.2), the engine turns the detuned sawtooth into a 
#    warm, bouncy "thwack" that perfectly mimics a picked electric bass 
#    driving the groove, bridging the gap between American funk and Brazilian samba.
# ==========================================================
